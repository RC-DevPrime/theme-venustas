      <script>
        (function () {
          if (typeof Storage === 'undefined') return;

          var originalSetItem = Storage.prototype.setItem;
          if (!originalSetItem || Storage.prototype._venustasStorageGuardInstalled) return;

          Storage.prototype._venustasStorageGuardInstalled = true;
          Storage.prototype.setItem = function (key, value) {
            try {
              return originalSetItem.call(this, key, value);
            } catch (error) {
              var isQuotaError = error && (
                error.name === 'QuotaExceededError' ||
                error.name === 'NS_ERROR_DOM_QUOTA_REACHED' ||
                error.code === 22 ||
                error.code === 1014
              );

              if (!isQuotaError) throw error;

              if (key === 'EVENTS_MAP' || key === 'beacon') {
                try {
                  this.removeItem(key);
                } catch (removeError) {}
                return null;
              }

              throw error;
            }
          };
        })();
      </script>
      {%- assign odometer_templates = 'page,product' | split: ',' -%}
      {%- assign aos_templates = 'page,product' | split: ',' -%}
      {%- assign load_odometer_assets = false -%}
      {%- assign load_aos_assets = false -%}
      {%- if odometer_templates contains template.name -%}
        {%- assign load_odometer_assets = true -%}
      {%- endif -%}
      {%- if aos_templates contains template.name -%}
        {%- assign load_aos_assets = true -%}
      {%- endif -%}

      <!-- Canonical URL -->
      {% if template.name == 'collection' and collection %}
        {% assign has_active_filters = false %}
        {% for filter in collection.filters %}
          {% if filter.active_values.size > 0 %}
            {% assign has_active_filters = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% if has_active_filters or current_tags.size > 0 %}
          <link rel="canonical" href="{{ shop.url }}{{ collection.url }}">
        {% else %}
          <link rel="canonical" href="{{ canonical_url }}">
        {% endif %}
      {% else %}
        <link rel="canonical" href="{{ canonical_url }}">
      {% endif %}
      <!-- Hreflang -->
      {% assign hreflang_path = request.path | split: '?' | first %}
      {% if hreflang_path == blank %}{% assign hreflang_path = '/' %}{% endif %}
      <link rel="alternate" hreflang="x-default" href="https://venustas.com{{ hreflang_path }}">
      <link rel="alternate" hreflang="en-US" href="https://venustas.com{{ hreflang_path }}">
      <link rel="alternate" hreflang="en-CA" href="https://www.venustas.ca{{ hreflang_path }}">

      <title>
        {{ page_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %} – {{ shop.name }}
      </title>

      {%- comment -%} SEO essentials {%- endcomment -%}
      <link rel="canonical" href="{{ canonical_url }}">

      {%- if page_description and page_description != blank -%}
        <meta name="description" content="{{ page_description | escape }}">
      {%- elsif template.name == 'product' and product and product.description != blank -%}
        <meta name="description" content="{{ product.description | strip_html | strip_newlines | truncate: 160 | escape }}">
      {%- elsif template.name == 'collection' and collection and collection.description != blank -%}
        <meta name="description" content="{{ collection.description | strip_html | strip_newlines | truncate: 160 | escape }}">
      {%- elsif shop.description != blank -%}
        <meta name="description" content="{{ shop.description | strip_html | strip_newlines | truncate: 160 | escape }}">
      {%- endif -%}
