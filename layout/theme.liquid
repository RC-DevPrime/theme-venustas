          <h1 class="d-none">{{ page.title }}</h1>
        {% endif %}
        {% if template.name == 'collection' %}
         <h1 class="d-none">{{ collection.title }}</h1>
        {% endif %}
        {% if template.name == 'article' %}
          <h1 class="d-none">{{ article.title }}</h1>
        {% endif %}

        {{ content_for_layout }}

        {% sections 'footer-group' %}
        

