        <script src="{{ 'bootstrap.bundle.min.js' | asset_url }}" defer></script>

        <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
        <script defer>
          const standardSizesRaw = {{ settings.standard_sizes | json }};
          const tallSizesRaw = {{ settings.tall_sizes | json }};

          const toArray = (str) =>
            str.split(/\r?\n/).map(s => s.trim()).filter(Boolean);

          const standardSizes = toArray(standardSizesRaw);
          const tallSizes = toArray(tallSizesRaw);

        </script>
