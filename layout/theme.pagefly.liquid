<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction }}">
  <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <meta name="google-site-verification" content="6-VIw-j4ylQ3btZXguOnhuY8QcyQWeXxG-bKYFvh338">
      <meta name="msvalidate.01" content="0A2AF29235ED58F48CBA16BF71C229D8">
      <meta name="trustpilot-one-time-domain-verification-id" content="d11e688e-7f3d-4289-9bfe-98313f0ebb5f">

      <!-- Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-P6CFQL5');</script>
      <!-- End Google Tag Manager -->

      <!-- Microsoft Clarity -->
      <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "r4b4llvep5");
      </script>
      <!-- End Microsoft Clarity -->

      <!-- Canonical URL -->
      {% if template.name == 'collection' and collection %}
        {% assign has_active_filters = false %}
        {% for filter in collection.filters %}
          {% if filter.active_values.size > 0 %}
            {% assign has_active_filters = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% if has_active_filters or current_tags.size > 0 %}
          <link rel="canonical" href="{{ shop.url }}{{ collection.url }}">
        {% else %}
          <link rel="canonical" href="{{ canonical_url }}">
        {% endif %}
      {% else %}
        <link rel="canonical" href="{{ canonical_url }}">
      {% endif %}
      <!-- Hreflang -->
      {% assign hreflang_path = request.path | split: '?' | first %}
      {% if hreflang_path == blank %}{% assign hreflang_path = '/' %}{% endif %}
      <link rel="alternate" hreflang="x-default" href="https://venustas.com{{ hreflang_path }}">
      <link rel="alternate" hreflang="en-US" href="https://venustas.com{{ hreflang_path }}">
      <link rel="alternate" hreflang="en-CA" href="https://www.venustas.ca{{ hreflang_path }}">

      <title>
        {{ page_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %} – {{ shop.name }}
      </title>

      {%- comment -%} SEO essentials {%- endcomment -%}
      <link rel="canonical" href="{{ canonical_url }}">

      {%- if page_description and page_description != blank -%}
        <meta name="description" content="{{ page_description | escape }}">
      {%- elsif template.name == 'product' and product and product.description != blank -%}
        <meta name="description" content="{{ product.description | strip_html | strip_newlines | truncate: 160 | escape }}">
      {%- elsif template.name == 'collection' and collection and collection.description != blank -%}
        <meta name="description" content="{{ collection.description | strip_html | strip_newlines | truncate: 160 | escape }}">
      {%- elsif shop.description != blank -%}
        <meta name="description" content="{{ shop.description | strip_html | strip_newlines | truncate: 160 | escape }}">
      {%- endif -%}

      {%- assign noindex_templates = 'cart,search,customers,challenge,checkout' | split: ',' -%}
      {%- if noindex_templates contains template.name -%}
        <meta name="robots" content="noindex,nofollow">
      {%- else -%}
        <meta name="robots" content="index,follow">
      {%- endif -%}

      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">

      {{ content_for_header }}

      <!-- Preconnect to CDNs -->
      <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
      <link rel="preconnect" href="https://unpkg.com" crossorigin>
      <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

      <!-- Vendor CSS -->
      {{ 'bootstrap.min.css' | asset_url | stylesheet_tag }}

      <link rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
            integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer">

      <!-- Fonts -->
      <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

      <!-- Plugins CSS -->
      {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
      {{ 'aos.css' | asset_url | stylesheet_tag }}
      {{ 'odometer-theme-default.min.css' | asset_url | stylesheet_tag }}

      <!-- Theme CSS -->
      {{ 'bootstrap-custom.css' | asset_url | stylesheet_tag }}

      {{ 'style.css' | asset_url | stylesheet_tag }}
      {{ 'mega-menu.css' | asset_url | stylesheet_tag }}
      {{ 'popup-cart.css' | asset_url | stylesheet_tag }}

      {{ 'res-base.css' | asset_url | stylesheet_tag }}
      {{ 'res-font.css' | asset_url | stylesheet_tag }}
      {{ 'res-product-item.css' | asset_url | stylesheet_tag }}
      {{ 'res-popup-cart.css' | asset_url | stylesheet_tag }}

      {% if template.name == 'index' %}
        {{ 'index.css' | asset_url | stylesheet_tag }}
      {% endif %}

      {%- if template.name == 'product' -%}
        {{ 'product.css' | asset_url | stylesheet_tag }}

        <link rel="preload"
              href="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/Proxima-Novacond-ExtraBold.woff2?v=1758608017"
              as="font"
              type="font/woff2"
              crossorigin>

        {% style %}
          @font-face {
            font-family: 'Proxima-Novacond-ExtraBold';
            src: url('https://cdn.shopify.com/s/files/1/0457/1099/9709/files/Proxima-Novacond-ExtraBold.woff2?v=1758608017') format('woff2');
            font-display: swap;
          }
        {% endstyle %}
      {%- endif -%}

      {%- if template.name == 'collection' or template.name == 'search' -%}
        {{ 'collection.css' | asset_url | stylesheet_tag }}
      {%- endif -%}

      {%- if template.name == 'article' -%}
        {{ 'article.css' | asset_url | stylesheet_tag }}
      {%- endif -%}

      {%- if template.name == 'search' -%}
        {{ 'search.css' | asset_url | stylesheet_tag }}
      {%- endif -%}
    {% include 'pagefly-app-header' %}</head>

    <body><div class="pagefly-container">
              {{ content_for_layout }}
            </div></body>
</html>