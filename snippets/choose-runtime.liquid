{%- liquid
  assign show_runtime = false
  assign comparison_group = product.metafields.custom.battery_comparison_group.value
  assign entries = comparison_group.items.value
  assign group_products = comparison_group.products.value
  assign option_count = 0
  assign option_order = '0,1,2' | split: ','
  for entry in entries limit: 3
    assign linked_product = group_products[forloop.index0]
    if linked_product != blank and linked_product.id == product.id
      case forloop.index0
        when 1
          assign option_order = '1,2,0' | split: ','
        when 2
          assign option_order = '2,1,0' | split: ','
      endcase
    endif
    if entry.title.value != blank or entry.data.value != blank or linked_product != blank
      assign option_count = option_count | plus: 1
    endif
  endfor
  if option_count > 0
    assign show_runtime = true
  endif
  for product_tag in product.tags
    assign product_tag_handle = product_tag | handleize
    if product_tag_handle == 'open-box' or product_tag_handle == 'bundle-deal'
      assign show_runtime = false
      break
    endif
  endfor
-%}
{%- if show_runtime -%}
  {%- assign dialog_id = 'RuntimeComparison-' | append: section.id | append: '-' | append: block.id -%}
  {%- assign runtime_instance_id = dialog_id | append: '-cards' -%}
  {%- capture runtime_cards -%}
    {%- render 'product-new-battery-runtime-cards', product: product, comparison_group: comparison_group, display_order: option_order, instance_id: runtime_instance_id -%}
  {%- endcapture -%}
  <product-new-runtime-picker class="product-details choose-runtime" id="ChooseRuntime-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
    <div class="choose-runtime__heading-row">
      <h2 class="choose-runtime__heading">Choose Your Runtime</h2>
      <button class="choose-runtime__help" type="button" aria-label="Open runtime and battery comparison" aria-controls="{{ dialog_id }}" aria-haspopup="dialog">?</button>
    </div>
    <div class="choose-runtime__options" aria-label="Runtime options">
      {%- for option_position in option_order -%}
        {%- liquid
          assign entry_index = option_position | plus: 0
          assign entry = entries[entry_index]
          if entry == blank
            continue
          endif
          assign linked_product = group_products[entry_index]
          assign is_current = false
          if linked_product != blank and linked_product.id == product.id
            assign is_current = true
          endif
        -%}
        {%- if entry.title.value != blank or entry.data.value != blank or linked_product != blank -%}
          {%- liquid
            assign option_title = blank
            assign option_runtime = blank
            assign option_badge = blank
            assign title_lines = entry.title.value | newline_to_br | split: '<br />'
            assign ordinary_line = 0
            for title_line in title_lines
              assign title_line = title_line | strip
              if title_line != blank
                assign title_prefix = title_line | slice: 0, 6
                if title_prefix == 'badge='
                  assign option_badge = title_line | remove_first: 'badge=' | strip
                else
                  assign ordinary_line = ordinary_line | plus: 1
                  if ordinary_line == 1
                    assign option_title = title_line | split: '·' | first | strip
                  elsif ordinary_line == 2
                    assign option_runtime = title_line
                  endif
                endif
              endif
            endfor
          -%}
          {%- if is_current == false and linked_product != blank -%}
            <a class="choose-runtime__option{% if option_badge != blank %} choose-runtime__option--badged{% endif %}" href="{{ linked_product.url | escape }}">
          {%- else -%}
            <div class="choose-runtime__option{% if is_current %} is-selected{% endif %}{% if option_badge != blank %} choose-runtime__option--badged{% endif %}"{% if is_current %} aria-current="true"{% else %} aria-disabled="true"{% endif %}>
          {%- endif -%}
            {%- if option_badge != blank -%}<span class="choose-runtime__badge">{{ option_badge | escape }}</span>{%- endif -%}
            {%- if option_title != blank -%}<strong class="choose-runtime__option-title">{{ option_title | escape }}</strong>{%- endif -%}
            {%- if option_runtime != blank -%}<span class="choose-runtime__option-runtime">{{ option_runtime | escape }}</span>{%- endif -%}
            {%- if is_current -%}
              <strong class="choose-runtime__option-price">Included</strong>
            {%- elsif linked_product != blank -%}
              {%- assign price_difference = linked_product.price | minus: product.price -%}
              <strong class="choose-runtime__option-price">{%- if price_difference < 0 -%}-{%- else -%}+{%- endif -%}{{ price_difference | abs | money_without_trailing_zeros }}</strong>
            {%- endif -%}
          {%- if is_current == false and linked_product != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if runtime_cards != blank -%}
      <dialog class="runtime-comparison" id="{{ dialog_id }}" aria-label="{{ settings.battery_comparison_accessible_label | default: 'Battery comparison' | escape }}">
        <div class="runtime-comparison__content">
          <div class="runtime-comparison__toolbar">
            <button class="runtime-comparison__close" type="button" aria-label="Close comparison"></button>
          </div>
          {{ runtime_cards }}
        </div>
      </dialog>
    {%- endif -%}
  </product-new-runtime-picker>
{%- endif -%}
