{%- style -%}
#shopify-section-{{ section.id }} .product-heating-core-technology{width:100%;background:radial-gradient(ellipse at center 38%,#39020a 0%,#2a0e12 36%,#1a1a1a 72%);color:#fff;font-family:'Montserrat',sans-serif}
#shopify-section-{{ section.id }} .product-heating-core-technology__container{width:min(100% - 40px,1340px);margin:0 auto;padding:56px 0 40px;box-sizing:border-box}
#shopify-section-{{ section.id }} .product-heating-core-technology__header{display:flex;flex-direction:column;gap:24px;align-items:center;margin-bottom:54px;text-align:center}
#shopify-section-{{ section.id }} .product-heating-core-technology__heading-group{display:flex;flex-direction:column;gap:16px;align-items:center}
#shopify-section-{{ section.id }} .product-heating-core-technology__eyebrow{margin:0;color:var(--color-brand,#b93205);font-size:20px;font-weight:500;line-height:1.2;text-transform:capitalize}
#shopify-section-{{ section.id }} .product-heating-core-technology__title{margin:0;color:#fff;font-size:28px;font-weight:700;line-height:1.2;text-transform:uppercase}
#shopify-section-{{ section.id }} .product-heating-core-technology__description{margin:0;max-width:980px;color:rgba(255,255,255,.9);font-size:16px;font-weight:300;line-height:1.45}
#shopify-section-{{ section.id }} .product-heating-core-technology__description p{margin:0}
#shopify-section-{{ section.id }} .product-heating-core-technology__stage{position:relative;display:grid;min-height:613px;grid-template-columns:240px minmax(0,1fr) 240px;gap:48px;align-items:center;margin-bottom:56px;background-image:var(--product-heating-core-stage-bg-desktop);background-repeat:no-repeat;background-position:center;background-size:contain}
#shopify-section-{{ section.id }} .product-heating-core-technology__visual{min-width:0;height:613px;pointer-events:none}
#shopify-section-{{ section.id }} .product-heating-core-technology__zone-list{display:flex;flex-direction:column;gap:80px}
#shopify-section-{{ section.id }} .product-heating-core-technology__zone-list--right{align-items:flex-start}
#shopify-section-{{ section.id }} .product-heating-core-technology__zone{display:flex;flex-direction:column;gap:6px;align-items:flex-start}
#shopify-section-{{ section.id }} .product-heating-core-technology__zone-number{margin:0;color:#e03a14;font-size:18px;font-weight:800;line-height:1.2}
#shopify-section-{{ section.id }} .product-heating-core-technology__zone-title{margin:0;color:#fff;font-size:15px;font-weight:700;line-height:1.25}
#shopify-section-{{ section.id }} .product-heating-core-technology__zone-text{margin:0;color:#fff;font-size:13px;font-weight:400;line-height:1.4}
#shopify-section-{{ section.id }} .product-heating-core-technology__mobile-zones{display:none}
#shopify-section-{{ section.id }} .product-heating-core-technology__features{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;padding:24px 16px;border:1px solid #2a2a2a;border-radius:16px;background:rgba(0,0,0,.3);box-sizing:border-box}
#shopify-section-{{ section.id }} .product-heating-core-technology__feature{display:flex;gap:16px;align-items:center;justify-content:center;min-width:0;padding:12px 16px}
#shopify-section-{{ section.id }} .product-heating-core-technology__feature-icon{display:flex;width:48px;height:48px;flex:0 0 48px;align-items:center;justify-content:center;border:1px solid rgba(224,58,20,.2);border-radius:50%;background:rgba(224,58,20,.06);color:var(--color-brand,#b93205)}
#shopify-section-{{ section.id }} .product-heating-core-technology__feature-icon svg{width:22px;height:22px}
#shopify-section-{{ section.id }} .product-heating-core-technology__feature-title{margin:0;color:#fff;font-size:15px;font-weight:700;line-height:1.2;text-align:center}
@media only screen and (max-width:767px){
#shopify-section-{{ section.id }} .product-heating-core-technology__container{width:100%;padding:48px 20px 40px;box-sizing:border-box}
#shopify-section-{{ section.id }} .product-heating-core-technology__header{gap:12px;margin-bottom:36px}
#shopify-section-{{ section.id }} .product-heating-core-technology__heading-group{gap:12px}
#shopify-section-{{ section.id }} .product-heating-core-technology__eyebrow{font-size:14px;font-weight:700;text-transform:uppercase}
#shopify-section-{{ section.id }} .product-heating-core-technology__title{font-size:24px}
#shopify-section-{{ section.id }} .product-heating-core-technology__description{font-size:16px;line-height:1.35}
#shopify-section-{{ section.id }} .product-heating-core-technology__stage{display:block;min-height:260px;margin-bottom:24px;border-radius:16px;background-image:var(--product-heating-core-stage-bg-mobile,var(--product-heating-core-stage-bg-desktop));background-size:contain}
#shopify-section-{{ section.id }} .product-heating-core-technology__zone-list{display:none}
#shopify-section-{{ section.id }} .product-heating-core-technology__visual{height:260px}
#shopify-section-{{ section.id }} .product-heating-core-technology__mobile-zones{display:flex;flex-direction:column;gap:12px;margin-bottom:30px}
#shopify-section-{{ section.id }} .product-heating-core-technology__mobile-zones .product-heating-core-technology__zone{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 16px;padding:16px;border:1px solid #262628;border-radius:12px;background:#161618}
#shopify-section-{{ section.id }} .product-heating-core-technology__mobile-zones .product-heating-core-technology__zone-number{grid-row:1 / span 2;font-size:20px;align-self:center}
#shopify-section-{{ section.id }} .product-heating-core-technology__mobile-zones .product-heating-core-technology__zone-text{color:#aaa}
#shopify-section-{{ section.id }} .product-heating-core-technology__features{display:flex;flex-wrap:wrap;gap:12px 8px;padding:20px 16px}
#shopify-section-{{ section.id }} .product-heating-core-technology__feature{height:38px;gap:8px;padding:8px 12px;border:1px solid rgba(224,58,20,.2);border-radius:20px;background:rgba(224,58,20,.06);box-sizing:border-box}
#shopify-section-{{ section.id }} .product-heating-core-technology__feature-icon{width:auto;height:auto;flex:0 0 auto;border:0;background:transparent}
#shopify-section-{{ section.id }} .product-heating-core-technology__feature-icon svg{width:14px;height:14px}
#shopify-section-{{ section.id }} .product-heating-core-technology__feature-title{font-size:12px;white-space:nowrap}
}
{%- endstyle -%}
