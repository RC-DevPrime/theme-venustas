{% assign current_variant = product.selected_or_first_available_variant %}
<div class="tab-product-container col-lg-3 col-md-3 col-sm-12">
    <div class="tab-product-item h-100">
        <div class="product-image">
            
            <img src="{{ product.featured_image | img_url: 'master' }}" width="100%" height="100%"> 
        </div>
        <div class="product-details pt-lg-0 pt-md-0 pt-sm-2">
            <h4 class="pp-semibold body-xl f-black l-h-normal d-lg-block d-md-block d-sm-none">{{ product.title }}</h4>
            <h4 class="pp-semibold body f-black l-h-normal d-lg-none d-md-none d-sm-block excerpt-2">{{ product.title }}</h4>
            
            <div class="price-container d-lg-flex d-md-flex d-sm-none">
                <div class="text-sale-price pp-bold body-lg f-main d-flex">
                    {{ product.selected_or_first_available_variant.price | money }}
                </div>
                {% if product.selected_or_first_available_variant.price != product.selected_or_first_available_variant.compare_at_price %}
                    <div class="text-compare-price pp-regular body f-compare-price d-flex">
                        {{ product.selected_or_first_available_variant.compare_at_price | money }}
                    </div>
                {% endif %}
            </div>
            
            <div class="d-flex flex-column gap-lg-2 gap-md-2 gap-sm-1 mt-lg-3 mt-md-3 mt-sm-2">
                <div class="price-container d-lg-none d-md-none d-sm-flex">
                    <div class="text-sale-price pp-bold body-lg f-main d-flex">
                        {{ product.selected_or_first_available_variant.price | money }}
                    </div>
                    {% if product.selected_or_first_available_variant.price != product.selected_or_first_available_variant.compare_at_price %}
                        <div class="text-compare-price pp-regular body f-compare-price d-flex">
                            {{ product.selected_or_first_available_variant.compare_at_price | money }}
                        </div>
                    {% endif %}
                </div>
                <div class="buy-now-and-add">
                    {% if product.has_only_default_variant %}
                        
                        {% assign product_form_id = 'product-form-' | append: product.id %}
                        {% form 'product', product, id: product_form_id, class: 'atc-form form btn-add col-4', novalidate: 'novalidate', data-type: 'add-to-cart-form', action: 'javascript:void(0)' %}
                            <input type="hidden" name="id" class="product-main-id" value="{{ current_variant.id }}">
                            <div class="form-btn">
                                <button
                                    type="submit"
                                    name="add"
                                    class="btn-atc position-relative{% unless current_variant.available %} is-sold-out{% endunless %}"
                                    {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
                                >
                                        
                                        {% if current_variant.available %}
                                            <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/76274_2x_d16fe5a8-ac81-452f-b21a-cba27f596eb7.png?v=1758116435" class="icon-atc" alt="cart-icon">
                                        {% endif %}
                                        <span class="pp-semibold f-white body">
                                            {% unless current_variant.available %}Sold Out{% else %}Add To Cart{% endunless %}
                                        </span>
                                        <div class="atc-overlay">
                                            <div class="atc-spinner"></div>
                                        </div>
                                </button>
                            </div>
                        {% endform %}
                    {% else %}
                        <div class="form-btn popup-atc btn-add ">
                            <button type='submit' name="add" class="btn-atc btn-hover btn-main " data-popup-handle="{{ product.handle }}">
                                    <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/76274_2x_d16fe5a8-ac81-452f-b21a-cba27f596eb7.png?v=1758116435" class="icon-atc">
                                    <span class="pp-semibold f-white body">
                                        Add To Cart
                                    </span>
                                    <div class="atc-overlay">
                                        <div class="atc-spinner"></div>
                                    </div>
                            </button>
                        </div>
                    {% endif %}
                    
                </div>
                <a href="{{ product.url }}" class="learn-more-button">
                    <span class="pp-semibold f-main body">Learn More</span>
                </a>
            </div>


        </div>
    </div>
</div>
