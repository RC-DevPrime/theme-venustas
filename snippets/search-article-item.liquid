<div class="col-12 search-article-item">
    <a href="{{ item.url }}" class="d-flex align-items-center gap-lg-3 gap-md-3 gap-sm-2">
        <div class="article-image flex-auto">
            <img src="{{ item.image | img_url: '1000x1000' }}" width="100%" height="100%">
        </div>
        <div class="article-info flex-1">
            {% if item.tags.size > 0 %}
            <!-- Always FIRST tag in initial render -->
            <p class="pp-regular body-sm article-tag mb-2 d-lg-block d-md-block d-sm-none">{{ item.tags.first }}</p>
            <p class="pp-regular body-xs article-tag mb-1 d-lg-none d-md-none d-sm-block l-h-normal">{{ item.tags.first }}</p>
            {% endif %}
            <div class="pp-semibold f-black">
                <h3 class="body-xl d-lg-block d-md-block d-sm-none">{{ item.title }}</h3>
                <h3 class="body d-lg-none d-md-none d-sm-block l-h-normal">{{ item.title }}</h3>
            </div>
        </div>
    </a>
</div>