{%- liquid
  assign button_label = label
  assign button_url = url | default: '#'
  assign button_class = class | default: ''
  assign button_variant = variant | default: 'primary'
-%}

{%- if button_label != blank -%}
  <a class="heatingP-button heatingP-button--{{ button_variant }} {{ button_class }}" href="{{ button_url }}">
    <span class="heatingP-button__label">{{ button_label }}</span>
    <svg class="heatingP-button__icon" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4.5 9 7.5 6 4.5 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  </a>
{%- endif -%}
