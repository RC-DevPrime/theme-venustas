<details class="display-6-mobile__category" name="{{ group_name }}" data-view-all-url="{{ collection.url | escape }}"{% if open %} open{% endif %}>
  <summary class="pp-regular">
    <span>{{ label | default: title | default: 'Bundle Category' | escape }}</span>
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none">
      <path d="M5.25 10.5 8.75 7 5.25 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </summary>
  <div class="display-6-mobile__category-content">
    {% if collection != blank and collection.products_count > 0 %}
      <div class="display-6-mobile__products" role="list">
        {% for product in collection.products limit: 4 %}
          <div role="listitem">
            {% render 'header-mega-bundle-product-card', product: product, image_source: 'featured' %}
          </div>
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <p class="display-6-mobile__empty pp-regular">Select a collection to display bundle products.</p>
    {% endif %}
  </div>
</details>
