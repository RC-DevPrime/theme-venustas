{% doc %}
  Renders the existing US and Canada store switcher.
  @param {object} section - Header section.
  @param {string} mode - Unique desktop or mobile presentation.
{% enddoc %}
{% assign is_canada = false %}{% if request.host contains 'venustas.ca' %}{% assign is_canada = true %}{% endif %}
<div class="header-new__localization header-new__localization--{{ mode }}" data-header-localization>
<button type="button" data-header-country-toggle aria-expanded="false" aria-controls="HeaderCountry-{{ section.id }}-{{ mode }}" aria-label="Change country, current {% if is_canada %}Canada CAD{% else %}United States USD{% endif %}">
<span class="header-new__flag" aria-hidden="true">{% if is_canada %}{% render 'header-icons', icon: 'flag-ca' %}{% else %}{% render 'header-icons', icon: 'flag-us' %}{% endif %}</span>
<span class="header-new__country-label">{% if is_canada %}Canada <small>CAD</small>{% else %}United States <small>USD</small>{% endif %}</span>
<span class="header-new__country-chevron">{% render 'header-icons', icon: 'chevron-down' %}</span>
</button>
<ul id="HeaderCountry-{{ section.id }}-{{ mode }}" data-header-country-menu hidden>
<li>
<a href="{{ section.settings.country_us_url | default: 'https://venustas.com/' | escape }}"{% unless is_canada %} aria-current="true"{% endunless %}>
<span class="header-new__flag" aria-hidden="true">{% render 'header-icons', icon: 'flag-us' %}</span>United States <small>USD</small>{% unless is_canada %}<span class="header-new__country-check" aria-hidden="true">{% render 'header-icons', icon: 'check' %}</span>{% endunless %}
</a>
</li>
<li>
<a href="{{ section.settings.country_ca_url | default: 'https://venustas.ca/' | escape }}"{% if is_canada %} aria-current="true"{% endif %}>
<span class="header-new__flag" aria-hidden="true">{% render 'header-icons', icon: 'flag-ca' %}</span>Canada <small>CAD</small>{% if is_canada %}<span class="header-new__country-check" aria-hidden="true">{% render 'header-icons', icon: 'check' %}</span>{% endif %}
</a>
</li>
</ul>
</div>