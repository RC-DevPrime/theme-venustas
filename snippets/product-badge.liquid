{%- liquid
  assign product_badge_label = blank
  assign has_hot_tag = false
  assign has_best_seller_tag = false
  assign has_new_tag = false

  for tag in product.tags
    assign tag_handle = tag | strip 
    if tag_handle == 'Hot'
      assign has_hot_tag = true
    elsif tag_handle == 'Best Seller'
      assign has_best_seller_tag = true
    elsif tag_handle == 'New'
      assign has_new_tag = true
    endif
  endfor

  if has_hot_tag
    assign product_badge_label = 'Hot'
  elsif has_best_seller_tag
    assign product_badge_label = 'Best Seller'
  elsif has_new_tag
    assign product_badge_label = 'New'
  endif
-%}

{% if product_badge_label != blank %}
  <span class="badge new-badge" aria-hidden="true">
    {{ product_badge_label }}
  </span>
{% endif %}
