{%- liquid
  assign product_badge_label = blank
  assign has_new_tag = false

  for tag in product.tags
    assign tag_handle = tag | strip | downcase | handle
    if tag_handle == 'new'
      assign has_new_tag = true
    endif
  endfor

  if has_new_tag
    assign product_badge_label = 'New'
  endif
-%}

{% if product_badge_label != blank %}
  <span class="badge new-badge" aria-hidden="true">
    {{ product_badge_label }}
  </span>
{% endif %}
