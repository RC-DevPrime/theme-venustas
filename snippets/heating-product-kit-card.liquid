<article class="heating-product-kit__card{% if mobile %} heating-product-kit__card--mobile{% endif %}"{% if include_attributes %} {{ block.shopify_attributes }}{% endif %}>
  <div class="heating-product-kit__card-main">
    {%- if block.settings.title != blank -%}
      <h3 class="heating-product-kit__card-title">{{ block.settings.title }}</h3>
    {%- endif -%}

    {%- if block.settings.description != blank -%}
      <p class="heating-product-kit__card-description">{{ block.settings.description }}</p>
    {%- endif -%}

    {%- if block.settings.product_image != blank -%}
      <div class="heating-product-kit__media">
        {{
          block.settings.product_image
          | image_url: width: 720
          | image_tag:
            class: 'heating-product-kit__image',
            loading: 'lazy',
            widths: '220,320,420,560,720',
            sizes: '(max-width: 767px) calc(100vw - 80px), (max-width: 1339px) calc((100vw - 88px) / 4), 300px',
            alt: block.settings.product_image.alt | default: block.settings.title
        }}
      </div>
    {%- endif -%}
  </div>

  <div class="heating-product-kit__connect">
    <h4 class="heating-product-kit__connect-title">How It Connects</h4>

    {%- if block.settings.option_a_title != blank -%}
      <p class="heating-product-kit__option-label">{{ block.settings.option_a_title }}</p>
    {%- endif -%}
    <div class="heating-product-kit__option heating-product-kit__option--horizontal">
      {%- if block.settings.option_a_image_1 != blank or block.settings.option_a_label_1 != blank -%}
        <div class="heating-product-kit__step">
          {%- if block.settings.option_a_image_1 != blank -%}
            {{
              block.settings.option_a_image_1
              | image_url: width: 180
              | image_tag:
                class: 'heating-product-kit__step-image',
                loading: 'lazy',
                widths: '80,120,180',
                sizes: '(max-width: 767px) 76px, 82px',
                alt: block.settings.option_a_image_1.alt | default: block.settings.option_a_label_1
            }}
          {%- endif -%}
          {%- if block.settings.option_a_label_1 != blank -%}
            <p class="heating-product-kit__step-label">{{ block.settings.option_a_label_1 }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if block.settings.option_a_image_1 != blank and block.settings.option_a_image_2 != blank -%}
        <span class="heating-product-kit__arrow heating-product-kit__arrow--right" aria-hidden="true">
          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 9H14M10.5 5.5L14 9L10.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      {%- endif -%}

      {%- if block.settings.option_a_image_2 != blank or block.settings.option_a_label_2 != blank -%}
        <div class="heating-product-kit__step">
          {%- if block.settings.option_a_image_2 != blank -%}
            {{
              block.settings.option_a_image_2
              | image_url: width: 180
              | image_tag:
                class: 'heating-product-kit__step-image',
                loading: 'lazy',
                widths: '80,120,180',
                sizes: '(max-width: 767px) 76px, 82px',
                alt: block.settings.option_a_image_2.alt | default: block.settings.option_a_label_2
            }}
          {%- endif -%}
          {%- if block.settings.option_a_label_2 != blank -%}
            <p class="heating-product-kit__step-label">{{ block.settings.option_a_label_2 }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if block.settings.option_a_image_2 != blank and block.settings.option_a_image_3 != blank -%}
        <span class="heating-product-kit__arrow heating-product-kit__arrow--right" aria-hidden="true">
          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 9H14M10.5 5.5L14 9L10.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      {%- endif -%}

      {%- if block.settings.option_a_image_3 != blank or block.settings.option_a_label_3 != blank -%}
        <div class="heating-product-kit__step">
          {%- if block.settings.option_a_image_3 != blank -%}
            {{
              block.settings.option_a_image_3
              | image_url: width: 180
              | image_tag:
                class: 'heating-product-kit__step-image',
                loading: 'lazy',
                widths: '80,120,180',
                sizes: '(max-width: 767px) 76px, 82px',
                alt: block.settings.option_a_image_3.alt | default: block.settings.option_a_label_3
            }}
          {%- endif -%}
          {%- if block.settings.option_a_label_3 != blank -%}
            <p class="heating-product-kit__step-label">{{ block.settings.option_a_label_3 }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if block.settings.option_b_title != blank -%}
      <p class="heating-product-kit__option-label heating-product-kit__option-label--b">{{ block.settings.option_b_title }}</p>
    {%- endif -%}
    <div class="heating-product-kit__option heating-product-kit__option--{{ block.settings.option_b_layout }}">
      {%- if block.settings.option_b_image_1 != blank or block.settings.option_b_label_1 != blank -%}
        <div class="heating-product-kit__step heating-product-kit__step--1">
          {%- if block.settings.option_b_image_1 != blank -%}
            {{
              block.settings.option_b_image_1
              | image_url: width: 180
              | image_tag:
                class: 'heating-product-kit__step-image',
                loading: 'lazy',
                widths: '80,120,180',
                sizes: '(max-width: 767px) 76px, 82px',
                alt: block.settings.option_b_image_1.alt | default: block.settings.option_b_label_1
            }}
          {%- endif -%}
          {%- if block.settings.option_b_label_1 != blank -%}
            <p class="heating-product-kit__step-label">{{ block.settings.option_b_label_1 }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if block.settings.option_b_image_1 != blank and block.settings.option_b_image_2 != blank -%}
        <span class="heating-product-kit__arrow heating-product-kit__arrow--right heating-product-kit__arrow--b1" aria-hidden="true">
          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 9H14M10.5 5.5L14 9L10.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      {%- endif -%}

      {%- if block.settings.option_b_image_2 != blank or block.settings.option_b_label_2 != blank -%}
        <div class="heating-product-kit__step heating-product-kit__step--2">
          {%- if block.settings.option_b_image_2 != blank -%}
            {{
              block.settings.option_b_image_2
              | image_url: width: 180
              | image_tag:
                class: 'heating-product-kit__step-image',
                loading: 'lazy',
                widths: '80,120,180',
                sizes: '(max-width: 767px) 76px, 82px',
                alt: block.settings.option_b_image_2.alt | default: block.settings.option_b_label_2
            }}
          {%- endif -%}
          {%- if block.settings.option_b_label_2 != blank -%}
            <p class="heating-product-kit__step-label">{{ block.settings.option_b_label_2 }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if block.settings.option_b_image_2 != blank and block.settings.option_b_image_3 != blank -%}
        <span class="heating-product-kit__arrow heating-product-kit__arrow--b2" aria-hidden="true">
          <svg class="heating-product-kit__arrow-svg--right" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 9H14M10.5 5.5L14 9L10.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <svg class="heating-product-kit__arrow-svg--split" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 3V15M5.5 11.5L9 15L12.5 11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      {%- endif -%}

      {%- if block.settings.option_b_image_3 != blank or block.settings.option_b_label_3 != blank -%}
        <div class="heating-product-kit__step heating-product-kit__step--3">
          {%- if block.settings.option_b_image_3 != blank -%}
            {{
              block.settings.option_b_image_3
              | image_url: width: 180
              | image_tag:
                class: 'heating-product-kit__step-image',
                loading: 'lazy',
                widths: '80,120,180',
                sizes: '(max-width: 767px) 76px, 82px',
                alt: block.settings.option_b_image_3.alt | default: block.settings.option_b_label_3
            }}
          {%- endif -%}
          {%- if block.settings.option_b_label_3 != blank -%}
            <p class="heating-product-kit__step-label">{{ block.settings.option_b_label_3 }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</article>
