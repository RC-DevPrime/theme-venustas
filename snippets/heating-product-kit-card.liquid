{%- liquid
  assign option_a_count = 0
  for index in (1..5)
    assign image_key = 'option_a_image_' | append: index
    assign label_key = 'option_a_label_' | append: index
    if block.settings[image_key] != blank or block.settings[label_key] != blank
      assign option_a_count = option_a_count | plus: 1
    endif
  endfor
-%}

<article class="heating-product-kit__card{% if mobile %} heating-product-kit__card--mobile{% endif %}"{% if include_attributes %} {{ block.shopify_attributes }}{% endif %}>
  <div class="heating-product-kit__card-main">
    {%- if block.settings.title != blank -%}
      <h3 class="heating-product-kit__card-title">{{ block.settings.title }}</h3>
    {%- endif -%}

    {%- if block.settings.description != blank -%}
      <p class="heating-product-kit__card-description">{{ block.settings.description }}</p>
    {%- endif -%}

    {%- if block.settings.product_image != blank -%}
      <div class="heating-product-kit__media">
        {{
          block.settings.product_image
          | image_url: width: 720
          | image_tag:
            class: 'heating-product-kit__image',
            loading: 'lazy',
            widths: '220,320,420,560,720',
            sizes: '(max-width: 767px) calc(100vw - 80px), (max-width: 1339px) calc((100vw - 88px) / 4), 300px',
            alt: block.settings.product_image.alt | default: block.settings.title
        }}
      </div>
    {%- endif -%}
  </div>

  <div class="heating-product-kit__connect">
    <h4 class="heating-product-kit__connect-title">How It Connects</h4>

    {%- if block.settings.option_a_title != blank -%}
      <p class="heating-product-kit__option-label">{{ block.settings.option_a_title }}</p>
    {%- endif -%}

    <div class="heating-product-kit__option heating-product-kit__option--a heating-product-kit__option--count-{{ option_a_count }}">
      {%- for index in (1..5) -%}
        {%- liquid
          assign image_key = 'option_a_image_' | append: index
          assign label_key = 'option_a_label_' | append: index
          assign image = block.settings[image_key]
          assign label = block.settings[label_key]
        -%}
        {%- if image != blank or label != blank -%}
          <div class="heating-product-kit__step heating-product-kit__step--{{ index }}">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 180
                | image_tag:
                  class: 'heating-product-kit__step-image',
                  loading: 'lazy',
                  widths: '80,120,180',
                  sizes: '(max-width: 767px) 76px, 82px',
                  alt: image.alt | default: label
              }}
            {%- endif -%}
            {%- if label != blank -%}
              <p class="heating-product-kit__step-label">{{ label }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if index < 5 -%}
          {%- assign next_index = index | plus: 1 -%}
          {%- assign next_image_key = 'option_a_image_' | append: next_index -%}
          {%- assign next_label_key = 'option_a_label_' | append: next_index -%}
          {%- if image != blank or label != blank -%}
            {%- if block.settings[next_image_key] != blank or block.settings[next_label_key] != blank -%}
              <span class="heating-product-kit__arrow heating-product-kit__arrow--a heating-product-kit__arrow--a{{ index }}" aria-hidden="true">
                <svg class="heating-product-kit__arrow-svg heating-product-kit__arrow-svg--right" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 9H14M10.5 5.5L14 9L10.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <svg class="heating-product-kit__arrow-svg heating-product-kit__arrow-svg--down" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 3V15M5.5 11.5L9 15L12.5 11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <svg class="heating-product-kit__arrow-svg heating-product-kit__arrow-svg--left" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M14 9H4M7.5 5.5L4 9L7.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if block.settings.show_option_b -%}
      {%- if block.settings.option_b_title != blank -%}
        <p class="heating-product-kit__option-label heating-product-kit__option-label--b">{{ block.settings.option_b_title }}</p>
      {%- endif -%}
      <div class="heating-product-kit__option heating-product-kit__option--b">
        {%- for index in (1..3) -%}
          {%- liquid
            assign image_key = 'option_b_image_' | append: index
            assign label_key = 'option_b_label_' | append: index
            assign image = block.settings[image_key]
            assign label = block.settings[label_key]
          -%}
          {%- if image != blank or label != blank -%}
            <div class="heating-product-kit__step heating-product-kit__step--{{ index }}">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 180
                  | image_tag:
                    class: 'heating-product-kit__step-image',
                    loading: 'lazy',
                    widths: '80,120,180',
                    sizes: '(max-width: 767px) 76px, 82px',
                    alt: image.alt | default: label
                }}
              {%- endif -%}
              {%- if label != blank -%}
                <p class="heating-product-kit__step-label">{{ label }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if index < 3 -%}
            {%- assign next_index = index | plus: 1 -%}
            {%- assign next_image_key = 'option_b_image_' | append: next_index -%}
            {%- assign next_label_key = 'option_b_label_' | append: next_index -%}
            {%- if image != blank or label != blank -%}
              {%- if block.settings[next_image_key] != blank or block.settings[next_label_key] != blank -%}
                <span class="heating-product-kit__arrow heating-product-kit__arrow--b" aria-hidden="true">
                  <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 9H14M10.5 5.5L14 9L10.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</article>
