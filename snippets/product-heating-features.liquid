{%- liquid
  assign heating_power = '38W'
  if template_suffix == 'mv11'
    assign heating_power = '41W'
  endif
  assign features = 'temperature|Ideal for|-40°F to 41°F|-40°C to 5°C;zones|Front and back|6 Heat zones|Up to 144°F;battery|In the box|2*54Wh batteries|+ built-in 12V lead;power|Heating power|4X • POWER|vs our standard vests;shell|Shell|3-layer, windproof|TPU membrane;warranty|Warranty|3 years|on heating elements' | split: ';'
-%}

{{ 'product-heating-features.css' | asset_url | stylesheet_tag }}

<ul class="product-heating-features" role="list" aria-label="Product features">
  {%- for feature in features -%}
    {%- liquid
      assign fields = feature | split: '|'
      assign value = fields[2] | replace: 'POWER', heating_power
    -%}
    <li class="product-heating-features__card">
      <span class="product-heating-features__icon" aria-hidden="true">
        {% render 'product-heating-feature-icon', name: fields[0] %}
      </span>
      <div class="product-heating-features__copy">
        <span class="product-heating-features__label">{{ fields[1] | escape }}</span>
        <div class="product-heating-features__details">
          <strong class="product-heating-features__value">{{ value | escape }}</strong>
          <span class="product-heating-features__description">{{ fields[3] | escape }}</span>
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>
