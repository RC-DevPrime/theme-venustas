<article class="heating-power-options__feature-card">
  <div class="heating-power-options__card-heading">
    <span class="heating-power-options__card-icon" aria-hidden="true">
      <svg  viewBox="0 0 28 28" fill="none">
        <path d="M20.8225 14.0898L19.6557 10.5898M3.32106 8.25651L10.3216 10.5898C10.3216 9.97101 10.5675 9.37751 11.0051 8.93993C11.4427 8.50234 12.0362 8.25651 12.6551 8.25651H14.9887C15.569 8.25679 16.1284 8.47327 16.5577 8.86371C16.987 9.25415 17.2554 9.79053 17.3105 10.3682M9.15486 17.5898H12.6551C12.9646 17.5898 13.2613 17.4669 13.4802 17.2481C13.699 17.0293 13.8219 16.7326 13.8219 16.4232C13.8219 14.5667 14.5595 12.7862 15.8723 11.4734C17.1852 10.1607 18.9658 9.42318 20.8225 9.42318C21.1319 9.42318 21.4287 9.30026 21.6475 9.08147C21.8663 8.86268 21.9892 8.56593 21.9892 8.25651V7.38151C21.7433 5.85885 20.9043 4.49555 19.6557 3.58984M9.15486 17.5898C9.15486 19.5228 7.58773 21.0898 5.65458 21.0898C3.72143 21.0898 2.1543 19.5228 2.1543 17.5898C2.1543 15.6568 3.72143 14.0898 5.65458 14.0898C7.58773 14.0898 9.15486 15.6568 9.15486 17.5898ZM25.4895 17.5898C25.4895 19.5228 23.9224 21.0898 21.9892 21.0898C20.0561 21.0898 18.4889 19.5228 18.4889 17.5898C18.4889 15.6568 20.0561 14.0898 21.9892 14.0898C23.9224 14.0898 25.4895 15.6568 25.4895 17.5898Z" stroke="#B93205" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </span>
    {%- if section_settings.feature_title != blank -%}
      <h3 class="heating-power-options__card-title">{{ section_settings.feature_title }}</h3>
    {%- endif -%}
  </div>

  {%- if section_settings.feature_image != blank -%}
    <div class="heating-power-options__feature-media">
      {{
        section_settings.feature_image
        | image_url: width: 1200
        | image_tag:
          class: 'heating-power-options__feature-image',
          loading: 'lazy',
          widths: '320,480,640,800,1000,1200',
          sizes: '(max-width: 767px) calc(100vw - 72px), (max-width: 1339px) calc((100vw - 88px) / 2), 608px',
          alt: section_settings.feature_image.alt | default: section_settings.feature_title
      }}
    </div>
  {%- endif -%}

  <div class="heating-power-options__feature-copy">
    {%- if section_settings.feature_subtitle != blank -%}
      <h4 class="heating-power-options__feature-subtitle">{{ section_settings.feature_subtitle }}</h4>
    {%- endif -%}

    {%- if section_settings.feature_description != blank -%}
      <div class="heating-power-options__feature-description">
        {{ section_settings.feature_description }}
      </div>
    {%- endif -%}
  </div>

  <ul class="heating-power-options__tag-list" aria-label="{{ section_settings.feature_title | escape }}">
    {%- if section_settings.tag_1 != blank -%}
      <li class="heating-power-options__tag-item">
        <span class="heating-power-options__tag-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 3V13M7 4L5 8L7 12M10 4L12 8L10 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        {{ section_settings.tag_1 }}
      </li>
    {%- endif -%}
    {%- if section_settings.tag_2 != blank -%}
      <li class="heating-power-options__tag-item">
        <span class="heating-power-options__tag-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 10C4.4 7 6.6 6.1 8 8C9.4 9.9 11.6 9 13 6M4 12H12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        {{ section_settings.tag_2 }}
      </li>
    {%- endif -%}
    {%- if section_settings.tag_3 != blank -%}
      <li class="heating-power-options__tag-item">
        <span class="heating-power-options__tag-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 2.5V5M8 11V13.5M2.5 8H5M11 8H13.5M4.1 4.1L5.8 5.8M10.2 10.2L11.9 11.9M11.9 4.1L10.2 5.8M5.8 10.2L4.1 11.9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </span>
        {{ section_settings.tag_3 }}
      </li>
    {%- endif -%}
  </ul>

  <div class="heating-power-options__flow">
    <div class="heating-power-options__flow-item">
      {%- if section_settings.flow_image_1 != blank -%}
        {{
          section_settings.flow_image_1
          | image_url: width: 220
          | image_tag:
            class: 'heating-power-options__flow-image',
            loading: 'lazy',
            widths: '80,120,160,220',
            sizes: '(max-width: 767px) 72px, 92px',
            alt: section_settings.flow_image_1.alt | default: section_settings.flow_label_1
        }}
      {%- endif -%}
      {%- if section_settings.flow_label_1 != blank -%}
        <p class="heating-power-options__flow-label">{{ section_settings.flow_label_1 }}</p>
      {%- endif -%}
    </div>

    <span class="heating-power-options__flow-arrow" aria-hidden="true">-&gt;</span>

    <div class="heating-power-options__flow-item">
      {%- if section_settings.flow_image_2 != blank -%}
        {{
          section_settings.flow_image_2
          | image_url: width: 220
          | image_tag:
            class: 'heating-power-options__flow-image',
            loading: 'lazy',
            widths: '80,120,160,220',
            sizes: '(max-width: 767px) 72px, 92px',
            alt: section_settings.flow_image_2.alt | default: section_settings.flow_label_2
        }}
      {%- endif -%}
      {%- if section_settings.flow_label_2 != blank -%}
        <p class="heating-power-options__flow-label">{{ section_settings.flow_label_2 }}</p>
      {%- endif -%}
    </div>

    <span class="heating-power-options__flow-arrow" aria-hidden="true">-&gt;</span>

    <div class="heating-power-options__flow-item">
      {%- if section_settings.flow_image_3 != blank -%}
        {{
          section_settings.flow_image_3
          | image_url: width: 220
          | image_tag:
            class: 'heating-power-options__flow-image',
            loading: 'lazy',
            widths: '80,120,160,220',
            sizes: '(max-width: 767px) 72px, 92px',
            alt: section_settings.flow_image_3.alt | default: section_settings.flow_label_3
        }}
      {%- endif -%}
      {%- if section_settings.flow_label_3 != blank -%}
        <p class="heating-power-options__flow-label">{{ section_settings.flow_label_3 }}</p>
      {%- endif -%}
    </div>
  </div>
</article>
