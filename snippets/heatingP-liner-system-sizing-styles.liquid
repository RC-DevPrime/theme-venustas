  #shopify-section-{{ section.id }} .heatingp-liner-system__sizing {
    position: relative;
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 4px 0 12px;
    color: #565b63;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .heatingp-liner-system__info {
    position: relative;
    display: inline-flex;
    width: 14px;
    height: 14px;
    align-items: center;
    justify-content: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: #565b63;
    font-size: 10px;
    line-height: 1;
    cursor: help;
  }

  #shopify-section-{{ section.id }} .heatingp-liner-system__tooltip {
    position: absolute;
    z-index: 5;
    top: calc(100% + 12px);
    right: 0;
    display: flex;
    width: 524px;
    max-width: calc(100vw - 40px);
    gap: 12px;
    align-items: flex-start;
    padding: 16px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 4px 83px rgba(0, 0, 0, .06);
    color: #565b63;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity .18s ease, transform .18s ease;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingp-liner-system__info:hover .heatingp-liner-system__tooltip,
  #shopify-section-{{ section.id }} .heatingp-liner-system__info:focus .heatingp-liner-system__tooltip,
  #shopify-section-{{ section.id }} .heatingp-liner-system__info:focus-within .heatingp-liner-system__tooltip {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .heatingp-liner-system__tooltip-icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-brand, #b93205);
    border-radius: 50%;
    color: var(--color-brand, #b93205);
    font-size: 11px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .heatingp-liner-system__tooltip-body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .heatingp-liner-system__tooltip-title,
  #shopify-section-{{ section.id }} .heatingp-liner-system__tooltip-text,
  #shopify-section-{{ section.id }} .heatingp-liner-system__tooltip-note {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heatingp-liner-system__tooltip-title {
    color: var(--venustas-black, #14161a);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .heatingp-liner-system__tooltip-text {
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .heatingp-liner-system__tooltip-note {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
  }

  @media only screen and (max-width: 1000px) {
    #shopify-section-{{ section.id }} .heatingp-liner-system__sizing {
      padding-bottom: 8px;
      font-size: 12px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .heatingp-liner-system__tooltip {
      right: 0;
      width: 350px;
    }
  }
