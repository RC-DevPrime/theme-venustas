{% doc %}
  Renders a collection product within a Header campaign panel.

  @param {product} product - Collection product to display.
{% enddoc %}
{%- if product != blank -%}
  <a class="header-new__campaign-product" href="{{ product.url | escape }}">
    <span class="header-new__campaign-product-media">
      {%- if product.featured_image != blank -%}
        {{ product.featured_image | image_url: width: 708 | image_tag: class: 'header-new__campaign-product-image', widths: '180, 236, 354, 472, 708', sizes: '(max-width: 767px) calc((100vw - 44px) / 2), (max-width: 1100px) calc((100vw - 260px) / 4), 236px', loading: 'lazy' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'header-new__campaign-product-placeholder' }}
      {%- endif -%}
    </span>
    <span class="header-new__campaign-product-title">{{ product.title | escape }}</span>
  </a>
{%- endif -%}
