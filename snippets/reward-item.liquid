<div class="reward-item {{ entries.type.value | handleize }}">
    <div class="upper-content">
        <h4 class="pp-semibold pretitle-lg text-center f-white pb-3 d-lg-block d-md-block d-sm-none">
            VENUSTAS
        </h4>
        <h4 class="pp-semibold body-xl text-center f-white pb-2 d-lg-none d-md-none d-sm-block">
            VENUSTAS
        </h4>
        <h2 class="pp-bold title-md text-center f-white">
            {{ entries.amount.value }}
        </h2>
    </div>
    <div class="bottom-content">
        <div class="divider-content pb-3">
            <h5 class="pp-semibold body-lg f-main d-lg-block d-md-block d-sm-none">{{ entries.sub_title.value }}</h5>
            <h5 class="pp-semibold body-sm f-main pb-1 d-lg-none d-md-none d-sm-block">{{ entries.sub_title.value }}</h5>
            <h5 class="pp-semibold body-lg f-black">{{ entries.title.value }}</h5>
        </div>

        <div class="divider-content pt-lg-5 pt-md-5 pt-sm-2">
            <div class="btn-rules d-flex align-items-center gap-2 f-main pb-3">  
                <span class="pp-regular body text-underline">Rules</span> <i class="body-xs fa-solid fa-chevron-right"></i>
            </div>
            <div class="icon-gift text-center btn-hover btn-main w-100 py-lg-3 py-md-3 py-sm-2">
                <span class="body f-white">Redeem Now</span>
            </div>
        </div>

    </div>
    
    <div class="rules-modal popup-modal">
        <div class="popup-overlay">
        </div>
        <div class="popup-content"> 
            <div class="popup-header">
                <button class="popup-close" type="button">
                    <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/close-btn-popup.png?v=1761207016">
                </button>
            </div>
            
            <div class="popup-container">
                <h5 class="pp-bold body-xl f-black pb-2">Rules:</h5>
                <div class="pp-regular body">
                    {{ entries._rules | metafield_tag  }}
                </div>
            </div>
        </div>
    </div>
</div>
