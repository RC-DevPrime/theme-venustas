{%- style -%}
  #shopify-section-{{ section.id }} .product-heating-specifications {
    width: 100%;
    background: #f5f5f5;
    color: var(--venustas-black, #1a1a1a);
    font-family: 'Montserrat', sans-serif;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__container {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 80px 0 40px;
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
    margin-bottom: 40px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__heading-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__eyebrow {
    margin: 0;
    color: var(--color-brand, #b93205);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.2;
    text-transform: capitalize;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__title {
    margin: 0;
    color: #111827;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__description,
  #shopify-section-{{ section.id }} .product-heating-specifications__muted,
  #shopify-section-{{ section.id }} .product-heating-specifications__card-text {
    margin: 0;
    color: rgba(26, 26, 26, 0.9);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.35;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__description p {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__col {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 24px;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px;
    border-radius: 24px;
    background: #fff;
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__card--heating {
    min-height: 940px;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__card-title {
    margin: 0;
    color: var(--venustas-black, #1a1a1a);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__label {
    margin: 0;
    color: var(--venustas-black, #1a1a1a);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__value-row {
    display: flex;
    gap: 12px;
    align-items: baseline;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__large-value {
    margin: 0;
    color: var(--color-brand, #b93205);
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__value-label {
    margin: 0;
    color: var(--venustas-black, #1a1a1a);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.25;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__vest-images {
    display: flex;
    width: min(100%, 410px);
    height: 240px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 6px;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__vest-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__divider {
    width: 100%;
    height: 1px;
    background: #e5e7eb;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__zone-count {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__zone-number {
    margin: 0;
    color: var(--color-brand, #b93205);
    font-size: 32px;
    font-weight: 800;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__list-item {
    position: relative;
    padding-left: 14px;
    color: var(--venustas-black, #1a1a1a);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__list-item::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand, #b93205);
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__pills {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__pill {
    display: flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(185, 50, 5, 0.26);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__pill:first-child {
    background: var(--color-brand, #b93205);
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__meter {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__meter-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--venustas-black, #1a1a1a);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__track {
    height: 8px;
    overflow: hidden;
    border-radius: 4px;
    background: #e5e7eb;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__track-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #de681a, #b93205);
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__power-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__badge {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    padding: 4px 10px;
    border: 1px solid var(--color-brand, #b93205);
    border-radius: 999px;
    background: rgba(185, 50, 5, 0.2);
    color: var(--color-brand, #b93205);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__kit-image {
    display: block;
    width: 100%;
    height: 341px;
    border-radius: 16px;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__included {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__check-item {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--venustas-black, #1a1a1a);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__check-icon {
    display: inline-flex;
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
    color: var(--color-brand, #b93205);
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__texture-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__texture {
    display: block;
    width: 100%;
    height: 70px;
    border-radius: 12px;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__spec-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__spec-row,
  #shopify-section-{{ section.id }} .product-heating-specifications__compat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__spec-row {
    padding-bottom: 10px;
    border-bottom: 1px solid #e5e7eb;
    color: var(--venustas-black, #1a1a1a);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__spec-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__spec-value {
    color: #515151;
    text-align: right;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__care-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__care-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__care-icon {
    display: flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(185, 50, 5, 0.16);
    color: var(--color-brand, #b93205);
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__care-icon svg {
    width: 24px;
    height: 24px;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__care-label {
    margin: 0;
    color: var(--venustas-black, #1a1a1a);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.15;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__care-note {
    margin: 0;
    color: #515151;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__compat-row {
    padding: 12px;
    border-radius: 12px;
    background: #f3f3f3;
    color: var(--venustas-black, #1a1a1a);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__compat-badge {
    display: inline-flex;
    flex: 0 0 auto;
    padding: 4px 10px;
    border: 1px solid var(--color-brand, #b93205);
    border-radius: 999px;
    background: rgba(185, 50, 5, 0.2);
    color: var(--color-brand, #b93205);
    font-size: 12px;
    font-weight: 400;
  }
  #shopify-section-{{ section.id }} .product-heating-specifications__compat-badge--blue {
    border-color: #0d6efd;
    background: rgba(13, 110, 253, 0.1);
    color: #0d6efd;
  }
  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-heating-specifications__container {
      width: 100%;
      padding: 40px 20px;
      box-sizing: border-box;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__header {
      gap: 12px;
      margin-bottom: 32px;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__heading-group {
      gap: 12px;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__eyebrow {
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__title {
      font-size: 24px;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__grid,
    #shopify-section-{{ section.id }} .product-heating-specifications__col {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__card {
      gap: 20px;
      padding: 24px;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__card--heating {
      min-height: 0;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__card-title {
      font-size: 18px;
      font-weight: 600;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__label {
      font-size: 14px;
      font-weight: 600;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__large-value,
    #shopify-section-{{ section.id }} .product-heating-specifications__zone-number {
      font-size: 24px;
      font-weight: 700;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__vest-images {
      width: min(100%, 350px);
      height: 360px;
      margin: 0 auto;
      border-radius: 12px;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__list-item {
      font-size: 14px;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__pills {
      gap: 8px;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__pill {
      min-height: 34px;
      border-radius: 10px;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__kit-image {
      height: 160px;
      object-fit: cover;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__check-item,
    #shopify-section-{{ section.id }} .product-heating-specifications__care-label {
      font-size: 12px;
      font-weight: 400;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__texture-grid {
      flex-direction: row;
      gap: 8px;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__texture {
      height: 80px;
      min-width: 0;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__care-grid {
      grid-template-columns: repeat(2, minmax(0, 140px));
      justify-content: center;
    }
    #shopify-section-{{ section.id }} .product-heating-specifications__care-note {
      width: 100%;
      font-size: 10px;
      text-align: center;
    }
  }
{%- endstyle -%}
