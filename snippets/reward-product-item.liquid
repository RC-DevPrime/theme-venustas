<div class="reward-item product h-100 d-flex flex-column">
    <div class="product-image mb-2 flex-1">
        <img src="{{ block.settings.product_image | img_url: '1000x1000' }}" width="100%" height="100%">
    </div>
    <div class="reward-content flex-1 d-flex flex-column justify-content-between">
        <h5 class="pp-semibold body-lg f-black pb-2">{{ block.settings.reward_title }}</h5>
        <div class="">
            <div class="btn-rules d-flex align-items-center gap-2 f-main pb-2">  
                <span class="pp-regular body text-underline">Rules</span> <i class="body-xs fa-solid fa-chevron-right"></i>
            </div>
            <div class="d-flex flex-lg-row flex-md-row flex-sm-column align-items-lg-center align-items-md-center align-items-sm-start justify-content-between">
                <h5 class="pp-semibold body-lg f-main d-lg-block d-md-block d-sm-none">{{ block.settings.amount }} {{ block.settings.sub_title }}</h5>
                <h5 class="pp-semibold body f-main d-lg-none d-md-none d-sm-block pb-2">{{ block.settings.amount }} {{ block.settings.sub_title }}</h5>
                <div class="icon-gift btn-hover btn-main px-lg-3 px-md-3 px-sm-2 py-1">
                    <span class="pp-regular body d-lg-block d-md-block d-sm-none">Redeem Now</span>
                    <span class="pp-regular body-sm d-lg-none d-md-none d-sm-block">Redeem Now</span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="rules-modal popup-modal">
        <div class="popup-overlay">
        </div>
        <div class="popup-content"> 
            <div class="popup-header">
                <button class="popup-close" type="button">
                    <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/close-btn-popup.png?v=1761207016">
                </button>
            </div>
            
            <div class="popup-container">
                <h5 class="pp-bold body-xl f-black pb-2">Rules:</h5>
                <div class="pp-regular body">
                    {{ block.settings.rules }}
                </div>
            </div>
        </div>
    </div>
</div>