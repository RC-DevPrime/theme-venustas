{%- comment -%}
  Replace the original "Render variant images" block with this block.
  Only the product featured image is requested on initial render. Variant image URLs
  are kept as JSON text and are applied to the same image after a swatch is clicked.
{%- endcomment -%}

{% if product.featured_image != blank %}
  {% assign card_img_small = product.featured_image | image_url: width: 400 %}
  {% assign card_img_large = product.featured_image | image_url: width: 800 %}
  <img
    class="active js-product-card-image"
    data-default-src="{{ card_img_small }}"
    data-default-srcset="{{ card_img_small }} 400w, {{ card_img_large }} 800w"
    src="{{ card_img_small }}"
    srcset="{{ card_img_small }} 400w, {{ card_img_large }} 800w"
    sizes="(max-width: 768px) 100vw, 50vw"
    alt="{{ product.title | escape }}"
    loading="lazy"
    decoding="async"
  >
{% endif %}

{% if color_option_index > 0 %}
  {% assign option_key = 'option' | append: color_option_index %}
  {% assign color_array_index = color_option_index | minus: 1 %}
  {% assign color_option = product.options_with_values[color_array_index] %}

  <script type="application/json" class="js-product-card-color-images">
    {
      {% assign has_color_image = false %}
      {% for color_value in color_option.values %}
        {% assign matching_variants = product.variants | where: option_key, color_value %}
        {% assign image_variant = blank %}
        {% for variant in matching_variants %}
          {% if variant.image != blank %}
            {% assign image_variant = variant %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if image_variant != blank %}
          {% if has_color_image %},{% endif %}
          {% assign color_img_small = image_variant.image | image_url: width: 400 %}
          {% assign color_img_large = image_variant.image | image_url: width: 800 %}
          {{ color_value | json }}: {
            "variantId": {{ image_variant.id | json }},
            "src": {{ color_img_small | json }},
            "srcset": {{ color_img_small | append: ' 400w, ' | append: color_img_large | append: ' 800w' | json }},
            "alt": {{ product.title | append: ' - ' | append: color_value | json }}
          }
          {% assign has_color_image = true %}
        {% endif %}
      {% endfor %}
    }
  </script>
{% endif %}

{%- comment -%}
  Add data-color-value="{{ value | escape }}" to each clickable swatch in
  snippets/product-variant-colors.liquid. Example:

  <button type="button" class="color-swatch"
    data-color-value="{{ value | escape }}">...</button>

  If the snippet uses a radio input, its existing value="{{ value }}" is also
  supported by this script.

  Include this script once, preferably in the theme JavaScript bundle or directly
  before </body>. Event delegation also supports product cards loaded by AJAX.
{%- endcomment -%}
<script>
  (() => {
    if (window.productCardColorImageLazyLoadReady) return;
    window.productCardColorImageLazyLoadReady = true;

    const swatchSelector = [
      '.block-variant-options [data-color-value]',
      '.block-variant-options input[type="radio"]',
      '.block-variant-options select'
    ].join(',');

    function selectedColor(control) {
      return control.dataset.colorValue || control.value || '';
    }

    function switchCardImage(control) {
      const card = control.closest('.product-item');
      if (!card) return;

      const image = card.querySelector('.js-product-card-image');
      const dataNode = card.querySelector('.js-product-card-color-images');
      if (!image || !dataNode) return;

      let colorImages;
      try {
        colorImages = JSON.parse(dataNode.textContent);
      } catch (error) {
        return;
      }

      const imageData = colorImages[selectedColor(control)];
      if (!imageData) return;

      image.src = imageData.src;
      image.srcset = imageData.srcset;
      image.alt = imageData.alt;
      image.dataset.variant = imageData.variantId;
    }

    document.addEventListener('click', (event) => {
      const control = event.target.closest(swatchSelector);
      if (control && control.matches('[data-color-value]')) {
        switchCardImage(control);
      }
    });

    document.addEventListener('change', (event) => {
      if (event.target.matches(swatchSelector)) {
        switchCardImage(event.target);
      }
    });
  })();
</script>
