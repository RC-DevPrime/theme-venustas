        <div class="col-9">
          <div class="row mega-menu-tab-list-content active" data-tab="{{ block.settings.nav_1 | handleize }}">
            {% render 'mega-menu-d2-product-loop', collection: block.settings.collection_nav_1, products_manual: block.settings.product_nav_1, wrap_in_col: true, sale_badge_type: true, badge_detail: true %}
          </div>
          
          {% if block.settings.nav_2 != blank %}
