{%- assign hash_index = link_title | split: '#' -%}
{% assign clean_title = hash_index[0] | strip %}
  
{% if clean_title == block.settings.menu_tag %}
  {% if block.type == 'dislay_1' %} 
    <!-- DISPLAY 1 -->

      <div class="row display-1">
        <div class="col-7">
            <div class="menu-list-container">

                {% if block.settings.menu_list_1 != blank %}
                  <div class="menu-item">
                      <div class="pp-bold body-lg pb-2" {% if block.settings.Menu_list_label_1 == blank %}style="opacity:0;"{% endif %}>
                        {% if block.settings.Menu_list_label_1 != blank %}
                          {{ block.settings.Menu_list_label_1 }}
                        {% else %}
                          Spaces
                        {% endif %}
                      </div>
                      <div class="menu-list">
                        {% for link in block.settings.menu_list_1.links %}
                          <a href="{{ link.url }}" class="pp-regular body-lg">{{ link.title }}</a>
                        {% endfor %}
                      </div>
                  </div>
                {% endif %}

                {% if block.settings.menu_list_2 != blank %}
                  <div class="menu-item">
                      <div class="pp-bold body-lg pb-2" {% if block.settings.Menu_list_label_2 == blank %}style="opacity:0;"{% endif %}>
                        {% if block.settings.Menu_list_label_2 != blank %}
                          {{ block.settings.Menu_list_label_2 }}
                        {% else %}
                          Spaces
                        {% endif %}
                      </div>
                      <div class="menu-list">
                        {% for link in block.settings.menu_list_2.links %}
                          <a href="{{ link.url }}" class="pp-regular body-lg">{{ link.title }}</a>
                        {% endfor %}
                      </div>
                  </div>
                {% endif %}

                {% if block.settings.menu_list_3 != blank %}
                  <div class="menu-item">
                      <div class="pp-bold body-lg pb-2" {% if block.settings.Menu_list_label_3 == blank %}style="opacity:0;"{% endif %}>
                        {% if block.settings.Menu_list_label_3 != blank %}
                          {{ block.settings.Menu_list_label_3 }}
                        {% else %}
                          Spaces
                        {% endif %}
                      </div>
                      <div class="menu-list">
                        {% for link in block.settings.menu_list_3.links %}
                          <a href="{{ link.url }}" class="pp-regular body-lg">{{ link.title }}</a>
                        {% endfor %}
                      </div>
                  </div>
                {% endif %}
            </div>
        </div>
        <div class="col-5">
            <div class="row product-list">
              {% for product in block.settings.product_list %}
                <div class="col-6">
                  {% render 'product-item-mega-menu', product: product, sale_badge_type: true, badge_detail: true, %}
                </div>
              {% endfor %}
            </div>
        </div>
        
      </div>

