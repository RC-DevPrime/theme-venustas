                  <i class="fa-solid fa-chevron-right body-sm"></i>
                </a>
            </div> {% endcomment %}
            {% render 'mega-menu-d2-product-loop', collection: block.settings.collection_nav_4, products_manual: block.settings.product_nav_4, wrap_in_col: true, sale_badge_type: true, badge_detail: true %}
          </div>
          {% endif %}
          
          {% if block.settings.nav_5 != blank %}
          <div class="row mega-menu-tab-list-content" data-tab="{{ block.settings.nav_5 | handleize }}">
            {% comment %} <div class="col-12 d-flex align-items-center justify-content-end mt-0">
