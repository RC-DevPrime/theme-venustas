                    </svg>
                </span>
                {{ section_settings.selling_point_2 }}
              </li>
            {%- endif -%}
            {%- if section_settings.selling_point_3 != blank -%}
              <li class="heating-power-options__selling-item">
                <span aria-hidden="true">
                  <svg  viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.88025 19.3783C6.90942 18.9636 6.06083 18.3934 5.3345 17.6678C4.60817 16.9421 4.0375 16.0942 3.6225 15.124C3.2075 14.154 3 13.1137 3 12.003C3 10.8922 3.20742 9.85135 3.62225 8.88052C4.03708 7.90968 4.60742 7.0611 5.33325 6.33477C6.05925 5.60843 6.90742 5.03777 7.87775 4.62277C8.84808 4.20777 9.88883 4.00027 11 4.00027C11.35 4.00027 11.6875 4.0211 12.0125 4.06277C12.3375 4.10443 12.6667 4.16693 13 4.25027V5.30027C12.6667 5.20027 12.3375 5.12527 12.0125 5.07527C11.6875 5.02527 11.35 5.00027 11 5.00027C9.059 5.00027 7.40708 5.68168 6.04425 7.04452C4.68142 8.40735 4 10.0593 4 12.0003C4 13.9413 4.68142 15.5932 6.04425 16.956C7.40708 18.3188 9.059 19.0003 11 19.0003C12.941 19.0003 14.5929 18.3188 15.9557 16.956C17.3186 15.5932 18 13.9402 18 11.997C18 11.8158 17.9917 11.631 17.975 11.4425C17.9583 11.254 17.9269 11.0681 17.8807 10.8848H18.8923C18.9256 11.0426 18.9519 11.2221 18.9712 11.4233C18.9904 11.6246 19 11.8169 19 12.0003C19 13.1114 18.7927 14.1522 18.378 15.1225C17.9633 16.0928 17.3932 16.941 16.6675 17.667C15.9418 18.3928 15.0939 18.9632 14.1238 19.378C13.1538 19.7928 12.1134 20.0003 11.0027 20.0003C9.89192 20.0003 8.85108 19.7929 7.88025 19.3783ZM14.1462 15.854L10.5 12.208V7.00027H11.5V11.7925L14.8538 15.1465L14.1462 15.854ZM18 8.88477V5.88477H15V4.88477H18V1.88477H19V4.88477H22V5.88477H19V8.88477H18Z" fill="currentColor"/>
