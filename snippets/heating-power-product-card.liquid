              </li>
            {%- endif -%}
          </ul>
        </div>
        </div>
        {%- if section_settings.cta_label != blank -%}
          <a class="heating-power-options__cta" href="{{ section_settings.cta_link | default: '#' }}">
            {{ section_settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
   </div>

  {%- if section_settings.legal_text != blank -%}
    <p class="heating-power-options__legal">
      <span aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 14C11.3 14 14 11.3 14 8C14 4.7 11.3 2 8 2C4.7 2 2 4.7 2 8C2 11.3 4.7 14 8 14ZM8 6.8V11M8 5.1V5.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
      </span>
      {{ section_settings.legal_text }}
    </p>
  {%- endif -%}
</article>
