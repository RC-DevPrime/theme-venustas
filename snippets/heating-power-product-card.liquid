<article class="heating-power-options__product-card">
  <div class="heating-power-options__card-heading heating-power-options__card-heading--product">
    <span class="heating-power-options__card-icon" aria-hidden="true">
      <svg viewBox="0 0 30 30" fill="none">
        <path d="M25.9978 16.3223V13.1973M7.2448 10.0723H19.7468C20.8976 10.0723 21.8305 10.7718 21.8305 11.6348V17.8848C21.8305 18.7477 20.8976 19.4473 19.7468 19.4473H7.2448C6.09402 19.4473 5.16113 18.7477 5.16113 17.8848V11.6348C5.16113 10.7718 6.09402 10.0723 7.2448 10.0723Z" stroke="#B93205" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </span>
    <div class="heating-power-options__product-heading-copy">
      {%- if section_settings.product_card_title != blank -%}
        <h3 class="heating-power-options__card-title">{{ section_settings.product_card_title }}</h3>
      {%- endif -%}
      {%- if section_settings.product_card_description != blank -%}
        <p class="heating-power-options__card-kicker">{{ section_settings.product_card_description }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="heating-power-options__scenes">
    <div class="heating-power-options__scene">
      {%- if section_settings.scene_image_1 != blank -%}
        {{
          section_settings.scene_image_1
          | image_url: width: 420
          | image_tag:
            class: 'heating-power-options__scene-image',
            loading: 'lazy',
            widths: '160,220,320,420',
            sizes: '(max-width: 767px) calc((100vw - 88px) / 3), 184px',
            alt: section_settings.scene_image_1.alt | default: section_settings.scene_title_1
        }}
      {%- endif -%}
      {%- if section_settings.scene_title_1 != blank -%}
        <h4 class="heating-power-options__scene-title">{{ section_settings.scene_title_1 }}</h4>
      {%- endif -%}
      {%- if section_settings.scene_text_1 != blank -%}
        <p class="heating-power-options__scene-text">{{ section_settings.scene_text_1 }}</p>
      {%- endif -%}
    </div>

    <div class="heating-power-options__scene">
      {%- if section_settings.scene_image_2 != blank -%}
        {{
          section_settings.scene_image_2
          | image_url: width: 420
          | image_tag:
            class: 'heating-power-options__scene-image',
            loading: 'lazy',
            widths: '160,220,320,420',
            sizes: '(max-width: 767px) calc((100vw - 88px) / 3), 184px',
            alt: section_settings.scene_image_2.alt | default: section_settings.scene_title_2
        }}
      {%- endif -%}
      {%- if section_settings.scene_title_2 != blank -%}
        <h4 class="heating-power-options__scene-title">{{ section_settings.scene_title_2 }}</h4>
      {%- endif -%}
      {%- if section_settings.scene_text_2 != blank -%}
        <p class="heating-power-options__scene-text">{{ section_settings.scene_text_2 }}</p>
      {%- endif -%}
    </div>

    <div class="heating-power-options__scene">
      {%- if section_settings.scene_image_3 != blank -%}
        {{
          section_settings.scene_image_3
          | image_url: width: 420
          | image_tag:
            class: 'heating-power-options__scene-image',
            loading: 'lazy',
            widths: '160,220,320,420',
            sizes: '(max-width: 767px) calc((100vw - 88px) / 3), 184px',
            alt: section_settings.scene_image_3.alt | default: section_settings.scene_title_3
        }}
      {%- endif -%}
      {%- if section_settings.scene_title_3 != blank -%}
        <h4 class="heating-power-options__scene-title">{{ section_settings.scene_title_3 }}</h4>
      {%- endif -%}
      {%- if section_settings.scene_text_3 != blank -%}
        <p class="heating-power-options__scene-text">{{ section_settings.scene_text_3 }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="heating-power-options__product-panel">
    {%- if section_settings.option_heading != blank or section_settings.option_heading_accent != blank -%}
      <h4 class="heating-power-options__option-heading">
        {{ section_settings.option_heading }}
        {%- if section_settings.option_heading_accent != blank -%}
          <span>{{ section_settings.option_heading_accent }}</span>
        {%- endif -%}
      </h4>
    {%- endif -%}
    <div class="heating-power-options__product-box-wrapper">
      <div class="heating-power-options__product-box">
        {%- if section_settings.product_image != blank -%}
          <div class="heating-power-options__product-media">
            {{
              section_settings.product_image
              | image_url: width: 360
              | image_tag:
                class: 'heating-power-options__product-image',
                loading: 'lazy',
                widths: '160,220,280,360',
                sizes: '(max-width: 767px) 92px, 140px',
                alt: section_settings.product_image.alt | default: section_settings.product_title
            }}
          </div>
        {%- endif -%}

        <div class="heating-power-options__product-info">
          <div class="heating-power-options__product-line">
            <div>
              {%- if section_settings.product_title != blank -%}
                <h5 class="heating-power-options__product-title">{{ section_settings.product_title }}</h5>
              {%- endif -%}
              {%- if section_settings.product_subtitle != blank -%}
                <p class="heating-power-options__product-subtitle">{{ section_settings.product_subtitle }}</p>
              {%- endif -%}
            </div>
            {%- if section_settings.product_price != blank -%}
              <p class="heating-power-options__product-price">{{ section_settings.product_price }}</p>
            {%- endif -%}
          </div>

          <ul class="heating-power-options__selling-list">
            {%- if section_settings.selling_point_1 != blank -%}
              <li class="heating-power-options__selling-item">
                <span aria-hidden="true">
