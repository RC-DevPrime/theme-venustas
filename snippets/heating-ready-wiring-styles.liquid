{% style %}
  #shopify-section-{{ section_id }} .heating-ready-wiring {
    width: 100%;
    overflow: hidden;
    background: #f0f0f0;
    color: var(--venustas-black, #14161a);
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__inner {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 100px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__header {
    display: grid;
    gap: 14px;
    margin-bottom: 56px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__title,
  #shopify-section-{{ section_id }} .heating-ready-wiring__description {
    margin: 0;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__title {
    font-size: 34px;
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.952px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__description {
    color: #565b63;
    font-size: 16px;
    line-height: 1.72;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__description p {
    margin: 0;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__card {
    min-width: 0;
    overflow: hidden;
    border-radius: 12px;
    background: #f9fafb;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__media {
    position: relative;
    width: 100%;
    height: 408px;
    overflow: hidden;
    background: #dfdfdf;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__placeholder {
    width: 100%;
    height: 100%;
    background: #dfdfdf;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__brand {
    position: absolute;
    bottom: 12px;
    left: 16px;
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    padding: 8px 18px;
    border-radius: 10px;
    background: #515151;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.52px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__brand--accent {
    background: linear-gradient(111deg, #531602 19.62%, var(--color-brand, #b93205) 97.9%);
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram {
    display: flex;
    height: 239px;
    flex-direction: column;
    justify-content: center;
    padding: 22px 34px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram-title {
    margin: 0 0 12px;
    color: #1a1a1a;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__primary {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__primary .heating-ready-wiring__metric {
    margin-left: auto;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__node-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__node {
    display: inline-flex;
    min-height: 29px;
    align-items: center;
    justify-content: center;
    padding: 6px 10px;
    border: 1px solid #1a1a1a;
    border-radius: 6px;
    background: #fff;
    color: #1a1a1a;
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    text-align: center;
    box-sizing: border-box;
    white-space: nowrap;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__node--dark {
    border-color: #1a1a1a;
    background: #1a1a1a;
    color: #fff;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__node--accent {
    border-color: var(--color-brand, #b93205);
    background: var(--color-brand, #b93205);
    color: #fff;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__node--dashed {
    border-style: dashed;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__connector {
    width: 16px;
    height: 1px;
    flex: 0 0 16px;
    margin-top: 14px;
    background: #9ca3af;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__note {
    max-width: 130px;
    color: #1a1a1a;
    font-size: 10px;
    font-weight: 300;
    line-height: 1.2;
    text-align: center;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__metric {
    min-width: 180px;
    text-align: center;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__metric strong {
    display: block;
    color: var(--color-brand, #b93205);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.1;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__metric span {
    display: block;
    margin-top: 2px;
    color: #1a1a1a;
    font-size: 10px;
    font-weight: 300;
    line-height: 1.2;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__secondary-label {
    margin: 12px 0 10px;
    font-size: 10px;
    line-height: 1;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__secondary,
  #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__apparel-pair {
    display: flex;
    width: 130px;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__apparel-pair .heating-ready-wiring__node {
    width: 130px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__plus {
    font-size: 12px;
    line-height: 1;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain {
    margin-top: 8px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other {
    align-items: stretch;
    padding-right: 20px;
    padding-left: 20px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other .heating-ready-wiring__node {
    border-color: #e5e7eb;
    border-radius: 4px;
    font-size: 13px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other .heating-ready-wiring__metric {
    margin: 28px auto 0;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other .heating-ready-wiring__metric strong {
    color: #1a1a1a;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other .heating-ready-wiring__metric span {
    color: #6b7280;
    font-size: 11px;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section_id }} .heating-ready-wiring__inner {
      width: 100%;
      padding: 56px 20px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__header {
      gap: 12px;
      margin-bottom: 32px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__title {
      font-size: 24px;
      line-height: 1.3;
      letter-spacing: 0;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__description {
      font-size: 14px;
      line-height: 1.5;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__grid {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__media {
      height: 216px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__brand {
      top: 12px;
      bottom: auto;
      left: 12px;
      min-height: 32px;
      padding: 7px 12px;
      border-radius: 6px;
      font-size: 12px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__diagram {
      height: auto;
      min-height: 355px;
      padding: 22px 10px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__diagram-title {
      margin-bottom: 16px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__primary {
      flex-wrap: wrap;
      justify-content: center;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__primary .heating-ready-wiring__metric {
      width: 100%;
      margin: 16px 0 0;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__node {
      min-height: 36px;
      padding: 8px 7px;
      border-radius: 4px;
      font-size: 12px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__connector {
      width: 16px;
      flex-basis: 16px;
      margin-top: 18px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__metric strong {
      font-size: 20px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary-label {
      align-self: flex-start;
      margin: 28px 0 12px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary {
      justify-content: center;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__apparel-pair {
      width: 57px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__apparel-pair .heating-ready-wiring__node {
      width: 57px;
      white-space: normal;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary .heating-ready-wiring__node-wrap {
      width: 58px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary .heating-ready-wiring__node {
      width: 100%;
      padding-right: 4px;
      padding-left: 4px;
      white-space: normal;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__note {
      width: 76px;
      font-size: 8px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other {
      min-height: 239px;
      padding: 24px 10px 12px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain {
      display: grid;
      grid-template-columns: 90px 16px 126px 16px 74px;
      grid-template-rows: 36px 16px 36px;
      justify-content: center;
      gap: 0;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__node:nth-child(7) {
      grid-column: 3;
      grid-row: 3;
      width: 101px;
      justify-self: end;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__node:nth-child(9) {
      grid-column: 1;
      grid-row: 3;
      width: 101px;
      justify-self: end;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__connector:nth-child(6),
    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__connector:nth-child(8) {
      display: none;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other .heating-ready-wiring__metric {
      margin-top: 16px;
    }
  }
{% endstyle %}
