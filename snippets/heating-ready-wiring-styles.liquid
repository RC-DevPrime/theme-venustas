{% style %}
  #shopify-section-{{ section_id }} .heating-ready-wiring {
    width: 100%;
    overflow: hidden;
    background: #f0f0f0;
    color: var(--venustas-black, #1A1A1A);
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__inner {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 100px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__header {
    display: grid;
    gap: 14px;
    margin-bottom: 56px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__title,
  #shopify-section-{{ section_id }} .heating-ready-wiring__description {
    margin: 0;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__title {
    font-size: 34px;
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.952px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__description {
    color: #565b63;
    font-size: 16px;
    line-height: 1.72;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__description p {
    margin: 0;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__card {
    min-width: 0;
    overflow: hidden;
    border-radius: 12px;
    background: #f9fafb;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__media {
    position: relative;
    width: 100%;
    height: 408px;
    overflow: hidden;
    background: #dfdfdf;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__placeholder {
    width: 100%;
    height: 100%;
    background: #dfdfdf;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__brand {
    position: absolute;
    bottom: 12px;
    left: 16px;
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    padding: 8px 18px;
    border-radius: 10px;
    background: #515151;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.52px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__brand--accent {
    background: linear-gradient(111deg, #531602 19.62%, var(--color-brand, #b93205) 97.9%);
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram {
    display: flex;
    height: 239px;
    flex-direction: column;
    justify-content: center;
    padding: 22px 34px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram-title {
    margin: 0 0 12px;
    color: #1a1a1a;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__primary {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__primary .heating-ready-wiring__metric {
    margin-left: auto;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__primary .heating-ready-wiring__connector{
    background:#1A1A1A;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__node-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__node {
    display: inline-flex;
    min-height: 29px;
    align-items: center;
    justify-content: center;
    padding: 7px 6px;
    border: 1px solid #1a1a1a;
    border-radius: 6px;
    background: #fff;
    color: #1a1a1a;
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    text-align: center;
    box-sizing: border-box;
    white-space: nowrap;
  }
  #shopify-section-{{ section_id }} .heating-ready-wiring__node.cable{
    padding: 7px 37px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__node.cable110{
    padding: 7px 33px;
  }
  #shopify-section-{{ section_id }} .heating-ready-wiring__node.cable120{
    padding: 7px 29px;
  }
  #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain .heating-ready-wiring__node{
    padding: 10px 16px;
  }
  #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain .heating-ready-wiring__connector{
    margin-top:0;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__node--dark {
    border-color: #1a1a1a;
    background: #1a1a1a;
    color: #fff;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__node--accent {
    border-color: var(--color-brand, #b93205);
    background: var(--color-brand, #b93205);
    color: #fff;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__node--dashed {
    border-style: dashed;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__secondary .heating-ready-wiring__connector{
      margin-top:0px;
      background:#1A1A1A;
      width:25px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__secondary > .heating-ready-wiring__node-wrap {
    transform: translateY(7px);
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__branch { display: block; flex: 0 0 auto; }
  #shopify-section-{{ section_id }} .heating-ready-wiring__branch--mobile { display: none; }

  #shopify-section-{{ section_id }} .heating-ready-wiring__connector {
    width: 16px;
    height: 1px;
    flex: 0 0 16px;
    margin-top: 14px;
    background: #E5E7EB;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__note {
    max-width: 130px;
    color: #1a1a1a;
    font-size: 10px;
    font-weight: 300;
    line-height: 1.2;
    text-align: center;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__metric {
    min-width: 180px;
    text-align: center;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__metric strong {
    display: block;
    color: var(--color-brand, #b93205);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.1;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__metric span {
    display: block;
    margin-top: 2px;
    color: #1a1a1a;
    font-size: 10px;
    font-weight: 300;
    line-height: 1.2;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__secondary-label {
    margin: 12px 0 10px;
    font-size: 10px;
    line-height: 1;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__secondary,
  #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain {
    display: flex;
    align-items: center;
    /* justify-content: space-between; */
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__apparel-pair {
    display: flex;
    width: 130px;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__apparel-pair .heating-ready-wiring__node {
    width: 130px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__plus {
    font-size: 12px;
    line-height: 1;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain {
    margin-top: 8px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other {
    align-items: stretch;
    padding-right: 40px;
    padding-left: 40px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other .heating-ready-wiring__node {
    border-color: #e5e7eb;
    border-radius: 4px;
    font-size: 13px;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other .heating-ready-wiring__metric {
    margin: 28px auto 0;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other .heating-ready-wiring__metric strong {
    color: #1a1a1a;
  }

  #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other .heating-ready-wiring__metric span {
    color: #6b7280;
    font-size: 11px;
  }
  @media only screen and (max-width: 1339px) {
    #shopify-section-{{ section_id }} .heating-ready-wiring__grid {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

  }
  @media only screen and (max-width: 670px) {
    #shopify-section-{{ section_id }} .heating-ready-wiring__inner {
      width: 100%;
      padding: 56px 20px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__header {
      gap: 12px;
      margin-bottom: 32px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__title {
      font-size: 24px;
      line-height: 1.3;
      letter-spacing: 0;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__description {
      font-size: 14px;
      line-height: 1.5;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__grid {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__media {
      height: 216px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__brand {
      top: 12px;
      bottom: auto;
      left: 12px;
      min-height: 32px;
      padding: 7px 12px;
      border-radius: 6px;
      font-size: 12px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__diagram {
      height: auto;
      min-height: 355px;
      padding: 22px 10px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__diagram-title {
      margin-bottom: 16px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__primary {
      flex-wrap: wrap;
      justify-content: center;
    }
   
    #shopify-section-{{ section_id }} .heating-ready-wiring__primary .heating-ready-wiring__metric {
      width: 100%;
      margin: 16px 0 0;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__node {
      min-height: 36px;
      padding: 8px 7px;
      border-radius: 4px;
      font-size: 12px;
    }
   

    #shopify-section-{{ section_id }} .heating-ready-wiring__connector {
      width: 16px;
      flex-basis: 16px;
      margin-top: 18px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__metric strong {
      font-size: 20px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary-label {
      align-self: flex-start;
      margin: 28px 0 12px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary {
      align-items: center;
      width: 360px;
      margin: 0 auto;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary > .heating-ready-wiring__node-wrap {
      transform: translateY(13px);
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__branch--desktop {
      display: none;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__branch--mobile {
      display: block;
      flex: 0 0 7px;
    }
    #shopify-section-{{ section_id }} .heating-ready-wiring__node.cable{
      padding: 7px 19px;
    }
    #shopify-section-{{ section_id }} .heating-ready-wiring__node.cable120{
      padding: 7px 6px;
    }
    #shopify-section-{{ section_id }} .heating-ready-wiring__apparel-pair {
      width: 74px;
      flex: 0 0 74px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__apparel-pair .heating-ready-wiring__node {
      width: 52px;
      min-height: 40px;
      white-space: normal;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary .heating-ready-wiring__node-wrap {
      width: auto;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary .heating-ready-wiring__node-wrap--three-way {
      width: 78px;
      flex: 0 0 78px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary .heating-ready-wiring__node-wrap--y-cable {
      width: 54px;
      flex: 0 0 54px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary .heating-ready-wiring__node {
      width: 100%;
      padding-right: 4px;
      padding-left: 4px;
      font-size: 11px;
      white-space: nowrap;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__note {
      width: 100%;
      font-size: 9px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary .heating-ready-wiring__note {
      min-height: 22px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary > .heating-ready-wiring__connector {
      width: auto;
      min-width: 4px;
      max-width: 16px;
      flex: 1 1 4px;
      margin-top: 0;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__secondary > .heating-ready-wiring__node.cable120 {
      width: 74px;
      flex: 0 0 74px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other {
      min-height: 239px;
      padding: 24px 10px 12px;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain {
      position: relative;
      display: block;
      width: min(100%, 330px);
      height: 90px;
      margin: 8px auto 0;
    }

    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > * { position: absolute; margin: 0; }
    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__node:nth-child(1) { top: 0; left: 1.25%; width: 27.95%; }
    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__connector:nth-child(2) { top: 18px; left: 29.2%; width: 4.97%; }
    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__node:nth-child(3) { top: 0; left: 34.17%; width: 39.13%; }
    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__connector:nth-child(4) { top: 18px; left: 73.3%; width: 4.97%; }
    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__node:nth-child(5) { top: 0; left: 78.27%; width: 22.98%; }
    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__connector:nth-child(6) { top: 36px; left: 86.34%; display: block; width: 3.42%; height: 36px; border-right: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; background: transparent; }
    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__node:nth-child(7) { top: 54px; left: 54.97%; width: 31.37%; }
    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__connector:nth-child(8) { top: 72px; left: 50%; display: block; width: 4.97%; }
    #shopify-section-{{ section_id }} .heating-ready-wiring__other-chain > .heating-ready-wiring__node:nth-child(9) { top: 54px; left: 18.63%; width: 31.37%; }

    #shopify-section-{{ section_id }} .heating-ready-wiring__diagram--other .heating-ready-wiring__metric {
      margin-top: 16px;
    }
  }
{% endstyle %}
