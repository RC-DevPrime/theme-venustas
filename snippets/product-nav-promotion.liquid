{%- comment -%}
  Usage: {% render 'product-nav-promotion', product: product %}
  Reads the product promotion metafield and calculates its discounted price.
  Optional fallback_text is displayed when no valid discount can be calculated.
{%- endcomment -%}
{%- liquid
  assign curSym = ''
  if localization.country.currency.iso_code == 'CAD'
    assign curSym = 'C'
  endif
  assign selected_variant = product.selected_or_first_available_variant
  assign promotion_mf = product.metafields.promo.cart_discount_text
  assign promotion_text = promotion_mf.value | default: promotion_mf | strip_html | strip
  assign promotion_prefix = promotion_text | slice: 0, 5
  assign promotion_discount_type = blank
  assign promotion_discount_value = 0
  assign promotion_discount_price = blank
  if promotion_text != blank and promotion_prefix == 'Extra'
    assign promotion_extra_text = promotion_text | remove_first: 'Extra' | strip
    if promotion_extra_text contains '%'
      assign promotion_discount_value = promotion_extra_text | split: '%' | first | strip | plus: 0
      assign promotion_discount_type = 'percent'
    elsif promotion_extra_text contains '$'
      assign promotion_discount_value = promotion_extra_text | remove_first: '$' | strip | split: ' ' | first | plus: 0 | times: 100 | round
      assign promotion_discount_type = 'amount'
    endif
  endif
  if selected_variant != blank and promotion_discount_type == 'percent' and promotion_discount_value > 0 and promotion_discount_value < 100
    assign promotion_discount_multiplier = 100 | minus: promotion_discount_value
    assign promotion_discounted_price_cents = selected_variant.price | times: promotion_discount_multiplier | divided_by: 100
    assign promotion_discount_price = promotion_discounted_price_cents | money | prepend: curSym
  elsif selected_variant != blank and promotion_discount_type == 'amount' and promotion_discount_value > 0
    assign promotion_discounted_price_cents = selected_variant.price | minus: promotion_discount_value
    if promotion_discounted_price_cents < 0
      assign promotion_discounted_price_cents = 0
    endif
    assign promotion_discount_price = promotion_discounted_price_cents | money | prepend: curSym
  endif
  if promotion_discount_price == blank
    assign promotion_text = fallback_text | default: ''
  endif
-%}
<div class="product-nav-new__panel-promotion" data-nav-promotion{% if promotion_text == blank %} hidden{% endif %}>
  <span class="product-nav-new__panel-promotion-icon" aria-hidden="true">{% render 'heating-icons', icon: 'promotion-tag' %}</span>
  <span data-nav-promotion-text{% if promotion_discount_price == blank %} data-promotion-fallback{% endif %}>{{ promotion_text | escape }}</span>
  {%- if promotion_discount_price != blank -%}<span data-nav-promotion-discount-price>· {{ promotion_discount_price }}</span>{%- endif -%}
</div>
