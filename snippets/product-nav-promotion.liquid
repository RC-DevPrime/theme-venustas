{%- comment -%}
  Usage: {% render 'product-nav-promotion', product: product %}
  Shows the product promotion metafield. Empty metafield outputs nothing.
  Extra... -> promotion tag icon, #FF5F00, discounted price from the selected variant.
  Free...  -> gift icon, #1E7A46.
  Other    -> gift icon, black text.
  Optional price overrides the price basis (product cards pass the price they display).
  Optional uid makes the icon's SVG clipPath id unique when rendered more than once.
{%- endcomment -%}
{%- liquid
  assign curSym = ''
  if localization.country.currency.iso_code == 'CAD'
    assign curSym = 'C'
  endif
  assign selected_variant = product.selected_or_first_available_variant
  assign promotion_base_price = price
  if promotion_base_price == blank
    assign promotion_base_price = selected_variant.price
  endif
  assign promotion_mf = product.metafields.promo.cart_discount_text
  assign promotion_text = promotion_mf.value | default: promotion_mf | strip_html | strip
  assign promotion_extra_prefix = promotion_text | slice: 0, 5
  assign promotion_free_prefix = promotion_text | slice: 0, 4
  assign promotion_icon = 'gift'
  assign promotion_color = '#1a1a1a'
  assign promotion_discount_type = blank
  assign promotion_discount_value = 0
  assign promotion_discount_price = blank
  if promotion_text != blank and promotion_extra_prefix == 'Extra'
    assign promotion_icon = 'promotion-tag'
    assign promotion_color = '#FF5F00'
    assign promotion_extra_text = promotion_text | remove_first: 'Extra' | strip
    if promotion_extra_text contains '%'
      assign promotion_discount_value = promotion_extra_text | split: '%' | first | strip | plus: 0
      assign promotion_discount_type = 'percent'
    elsif promotion_extra_text contains '$'
      assign promotion_discount_value = promotion_extra_text | remove_first: '$' | strip | split: ' ' | first | plus: 0 | times: 100 | round
      assign promotion_discount_type = 'amount'
    endif
  elsif promotion_text != blank and promotion_free_prefix == 'Free'
    assign promotion_color = '#1E7A46'
  endif
  if promotion_base_price != blank and promotion_discount_type == 'percent' and promotion_discount_value > 0 and promotion_discount_value < 100
    assign promotion_discount_multiplier = 100 | minus: promotion_discount_value
    assign promotion_discounted_price_cents = promotion_base_price | times: promotion_discount_multiplier | divided_by: 100
    assign promotion_discount_price = promotion_discounted_price_cents | money | prepend: curSym
  elsif promotion_base_price != blank and promotion_discount_type == 'amount' and promotion_discount_value > 0
    assign promotion_discounted_price_cents = promotion_base_price | minus: promotion_discount_value
    if promotion_discounted_price_cents < 0
      assign promotion_discounted_price_cents = 0
    endif
    assign promotion_discount_price = promotion_discounted_price_cents | money | prepend: curSym
  endif
-%}
{%- if promotion_text != blank -%}
<div class="product-nav-new__panel-promotion" data-nav-promotion style="color: {{ promotion_color }}"{% if promotion_discount_price != blank %} data-promotion-type="{{ promotion_discount_type }}" data-promotion-value="{{ promotion_discount_value }}"{% endif %}>
  <span class="product-nav-new__panel-promotion-label">
    <span class="product-nav-new__panel-promotion-icon" style="color: inherit" aria-hidden="true">{% render 'heating-icons', icon: promotion_icon, uid: uid %}</span>
    <span data-nav-promotion-text style="color: inherit">{{ promotion_text | escape }}</span>
  </span>
  {%- if promotion_discount_price != blank -%}
    <span data-nav-promotion-discount-price style="color: inherit">· {% if product.price_varies %}From {% endif %}{{ promotion_discount_price }}</span>
  {%- endif -%}
</div>
{%- endif -%}
