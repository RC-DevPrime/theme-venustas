{% liquid
    assign variants_available_arr = product.variants | map: 'available'
    assign variants_option1_arr = product.variants | map: 'option1'
    assign variants_option2_arr = product.variants | map: 'option2'
    assign variants_option3_arr = product.variants | map: 'option3'
%}

<div class="variants">
    <variant-radios class="no-js-hidden variants" data-section="{{ product.id }}" data-url="{{ product.url }}">
        {% for option in product.options_with_values %}

            {% assign selected_option_value = product.selected_or_first_available_variant.options[forloop.index0] %}

            {% if option.name != 'Color' %}
                <fieldset class="variant js product-form__input variant-{{ option.name | handleize }}">
                    <legend class="variant-name form__label">
                        {{ option.name }}
                        <span class="variant-info variant--{{ option.name | handleize }}"> : {{ selected_option_value }}</span>
                    </legend>
                    {% render 'product-size-toggle', option: option %}

                    {% for value in option.values %}
                        {% liquid
                            assign option_disabled = true
                            for option_index in (0..variants_option1_arr.size)
                                if option.position == 1
                                    if variants_option1_arr[option_index] == value and variants_available_arr[option_index]
                                        assign option_disabled = false
                                    endif
                                elsif option.position == 2
                                    if variants_option1_arr[option_index] == product.selected_or_first_available_variant.option1
                                        if variants_option2_arr[option_index] == value and variants_available_arr[option_index]
                                            assign option_disabled = false
                                        endif
                                    endif
                                elsif option.position == 3
                                    if variants_option1_arr[option_index] == product.selected_or_first_available_variant.option1
                                        if variants_option2_arr[option_index] == product.selected_or_first_available_variant.option2
                                            if variants_option3_arr[option_index] == value and variants_available_arr[option_index]
                                                assign option_disabled = false
                                            endif
                                        endif
                                    endif
                                endif
                            endfor
                        %}

                        <span class="variants-selector default {% if selected_option_value == value %}selected{% endif %} {% if option_disabled %}disabled{% endif %}" 
                              data-id="{{ product.id }}-{{ option.position }}-{{ forloop.index0 }}">
                            {{ value }}
                        </span>
                        <span class="variants-option">
                            <input type="radio" class="variant-radio {% if option_disabled %}disabled{% endif %}"
                                   id="{{ product.id }}-{{ option.position }}-{{ forloop.index0 }}" 
                                   name="{{ option.name }}" 
                                   value="{{ value | escape }}" 
                                   form="{{ product_form_id }}" 
                                   {% if selected_option_value == value %}checked{% endif %}>
                        </span>
                    {% endfor %}
                </fieldset>

                {% elsif option.name == 'Color' %}
                    {% render 'product-color-picker', product: product, option: option, selected_option_value: selected_option_value, product_form_id: product_form_id %}
                {% endif %}

        {% endfor %}
        <script type="application/json">
            {{ product.variants | json }}
        </script>
    </variant-radios>
</div>
