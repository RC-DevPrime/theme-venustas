{%- liquid
assign current_variant = product.selected_or_first_available_variant
assign sale_badge_type = 'discount'
 
-%}
<div class="product-item">
    <div class="product-image mb-3" data-link="{{ product.url }}">
        {% if current_variant.compare_at_price != current_variant.price %}
            <span class="badge sale-badge " aria-hidden="true">
                {%- if sale_badge_type == 'discount' -%}
                    <span class="body-sm pp-semibold">
                        {%- if badge_detail -%}
                            {% comment %}{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}% OFF{% endcomment %}
                            ${{ current_variant.compare_at_price | minus: current_variant.price | times: 0.01 | round | ceil }} OFF
                        {%- else -%}
                            {% liquid 
                                assign list_compare = product.variants | where: 'compare_at_price'
                                assign compare = 0
                                for variant in list_compare
                                    assign saving = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
                                    if saving > compare
                                        assign compare = saving
                                    endif
                                endfor
                                if compare  < 1
                                    assign compare = product.compare_at_price_min | minus: product.price_min | times: 100.0 | divided_by: product.compare_at_price_min | round
                                endif
                            %}
                            -{{ compare | append: '%'}}
                        {%- endif -%}
                    </span>
                {%- elsif sale_badge_type == 'text_discount' -%}
                    <span class="body-sm pp-semibold">
                        {%- if badge_detail -%}
                            {{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}% OFF
                        {%- else -%}
                            {% liquid 
                                assign list_compare = product.variants | where: 'compare_at_price'
                                assign compare = 0
                                for variant in list_compare
                                    assign saving = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
                                    if saving > compare
                                        assign compare = saving
                                    endif
                                endfor
                                if compare  < 1
                                    assign compare = product.compare_at_price_min | minus: product.price_min | times: 100.0 | divided_by: product.compare_at_price_min | round
                                endif
                            %}
                            {{ compare | append: '%'}} OFF
                        {%- endif -%}
                    </span>
                {%- else -%}
                    <span class="body-sm pp-semibold">
                        {%- if badge_detail -%}
                            {% comment %}{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}% OFF{% endcomment %}
                            ${{ current_variant.compare_at_price | minus: current_variant.price | times: 0.01 | round | ceil }} OFF
                        {%- else -%}
                            {% liquid 
                                assign list_compare = product.variants | where: 'compare_at_price'
                                assign compare = 0
                                for variant in list_compare
                                    assign saving = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
                                    if saving > compare
                                        assign compare = saving
                                    endif
                                endfor
                                if compare  < 1
                                    assign compare = product.compare_at_price_min | minus: product.price_min | times: 100.0 | divided_by: product.compare_at_price_min | round
                                endif
                            %}
                            -{{ compare | append: '%'}}
                        {%- endif -%}
                    </span>
                {%- endif -%}
            </span>
        {% endif %}
        
        {% render 'product-badge', product: product %}
        


        {% if product.variants.size > 1 %}
        {% assign shown_values = "" %}
        {% assign option_index_to_display = 0 %} 

        {% for variant in product.variants %}
            {% assign option_value = variant.options[option_index_to_display] %}

            {% unless shown_values contains option_value %}
           
                {% if forloop.first %}

                    {% if product.metafields.custom.menu_product_image != blank %}
                        <img class="active"  src="{{ product.metafields.custom.menu_product_image | img_url: 'master' }}">
                    {% else %}
                        <img 
                            class="{% if forloop.first %}active{% endif %}" 
                            data-variant="{{ variant.id }}" 
                            src="{{ variant.image | product_img_url: 'master' }}">
                    {% endif %}
                {% else %}
                <img 
                    class="{% if forloop.first %}active{% endif %}" 
                    data-variant="{{ variant.id }}" 
                    src="{{ variant.image | product_img_url: 'master' }}">
                {% endif %}
            {% assign shown_values = shown_values | append: option_value | append: "," %}
            {% endunless %}
        {% endfor %}
        {% else %}
        
                {% if product.metafields.custom.menu_product_image != blank %}
                    <img class="active here" src="{{ product.metafields.custom.menu_product_image | img_url: 'master' }}">
                {% else %}
                    <img class="active here 1" src="{{ product.featured_image | img_url: 'master' }}">
                {% endif %}
        {% endif %}

        {% if product.metafields.custom.product_card_hover_image != blank %}
            <img class="hover-image" src="{{ product.metafields.custom.product_card_hover_image | img_url: 'master' }}">
        {% elsif product.media.size > 1 %}
            <img class="hover-image" src="{{ product.media[1] | img_url: 'master' }}">
        {% endif %}

    </div>
    <div class="product-details">
        <a href="{{ product.url }}" class="product-title d-block body-lg pp-bold pb-2 d-lg-block d-md-block d-sm-none">
            {% if product.metafields.custom.menu_product_name != blank %}
                {{ product.metafields.custom.menu_product_name }}
            {% else %}
                {{ product.title }}
            {% endif %}
        </a>
        <a href="{{ product.url }}" class="product-title d-block body pp-bold pb-2 d-lg-none d-md-none d-sm-block">
            {% if product.metafields.custom.menu_product_name != blank %}
                {{ product.metafields.custom.menu_product_name }}
            {% else %}
                {{ product.title }}
            {% endif %}
        </a>
    </div>
</div>
