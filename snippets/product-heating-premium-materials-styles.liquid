{%- style -%}
  #shopify-section-{{ section.id }} .product-heating-premium-materials {
    width: 100%;
    background: #fff;
    color: var(--venustas-black, #1a1a1a);
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__container {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 80px 0 60px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
    margin-bottom: 64px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__heading-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__eyebrow {
    margin: 0;
    color: var(--color-brand, #b93205);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.2;
    text-transform: capitalize;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__title {
    margin: 0;
    color: #111827;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__description {
    color: rgba(26, 26, 26, 0.9);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__description p,
  #shopify-section-{{ section.id }} .product-heating-premium-materials__spec-description p,
  #shopify-section-{{ section.id }} .product-heating-premium-materials__detail-text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__showcase {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr) 340px;
    gap: 40px;
    align-items: center;
    margin-bottom: 64px;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__visual {
    display: flex;
    min-width: 0;
    height: 500px;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__main-image {
    display: block;
    width: min(100%, 430px);
    height: 440px;
    object-fit: contain;
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__main-image--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__specs {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__specs--left {
    align-items: flex-end;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__spec-block {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__spec-eyebrow {
    margin: 0;
    color: var(--color-brand, #b93205);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__spec-title {
    margin: 0;
    color: var(--venustas-black, #1a1a1a);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__spec-description {
    color: var(--venustas-black, #1a1a1a);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__divider {
    width: 100%;
    height: 1px;
    background: #e5e7eb;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__features {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__feature {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__feature-icon,
  #shopify-section-{{ section.id }} .product-heating-premium-materials__benefit-icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(185, 50, 5, 0.1);
    color: var(--color-brand, #b93205);
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__feature-icon {
    width: 48px;
    height: 48px;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__feature-icon svg {
    width: 24px;
    height: 24px;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__feature-title {
    margin: 0 0 4px;
    color: var(--venustas-black, #1a1a1a);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__feature-text {
    margin: 0;
    color: #555;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 60px;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__detail {
    position: relative;
    display: flex;
    min-height: 280px;
    flex-direction: column;
    gap: 12px;
    overflow: hidden;
    padding: 32px;
    border-radius: 12px;
    color: #fff;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__detail::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(102, 102, 102, 0) 0%, rgba(0, 0, 0, 0.55) 100%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__detail-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__detail-number,
  #shopify-section-{{ section.id }} .product-heating-premium-materials__detail-title,
  #shopify-section-{{ section.id }} .product-heating-premium-materials__detail-copy {
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__detail-number {
    margin: 0;
    color: var(--color-brand, #b93205);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__detail-title {
    margin: 0;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__detail-copy {
    display: flex;
    flex: 1;
    align-items: flex-end;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__detail-text {
    color: #fff;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__benefit {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__benefit-icon {
    width: 56px;
    height: 56px;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__benefit-icon svg {
    width: 28px;
    height: 28px;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__benefit-title {
    margin: 0 0 4px;
    color: var(--venustas-black, #1a1a1a);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .product-heating-premium-materials__benefit-text {
    margin: 0;
    color: #555;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-heating-premium-materials__container {
      width: 100%;
      padding: 40px 20px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__header {
      gap: 16px;
      margin-bottom: 48px;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__heading-group {
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__eyebrow {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__title {
      font-size: 24px;
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__description {
      font-size: 16px;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__showcase {
      display: flex;
      flex-direction: column;
      gap: 48px;
      margin-bottom: 48px;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__visual {
      order: -1;
      width: 100%;
      height: 360px;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__main-image {
      width: 100%;
      height: 360px;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__main-image--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__main-image--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__specs {
      gap: 24px;
      width: 100%;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__spec-block {
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__spec-eyebrow {
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__spec-title {
      font-size: 18px;
      line-height: 1.3;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__features {
      gap: 20px;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__details {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 48px;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__detail {
      width: 100%;
      min-height: 280px;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__benefits {
      display: flex;
      flex-direction: column;
      gap: 12px;
      overflow: visible;
      border: 0;
      border-radius: 0;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__benefit {
      width: 100%;
      padding: 20px;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      background: #fff;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__benefit-icon {
      width: 48px;
      height: 48px;
    }

    #shopify-section-{{ section.id }} .product-heating-premium-materials__benefit-title {
      font-size: 14px;
    }
  }
{%- endstyle -%}
