<article class="product-battery-specs__item" {{ block.shopify_attributes }}>
  <div class="product-battery-specs__item-copy">
    <div class="product-battery-specs__item-heading">
      {%- if block.settings.value != blank -%}
        <p class="product-battery-specs__value">{{ block.settings.value }}</p>
      {%- endif -%}

      {%- if block.settings.title != blank -%}
        <h3 class="product-battery-specs__card-title">{{ block.settings.title }}</h3>
      {%- endif -%}
    </div>

    {%- if block.settings.description != blank -%}
      <p class="product-battery-specs__card-description">{{ block.settings.description }}</p>
    {%- endif -%}
  </div>

  <span class="product-battery-specs__icon" aria-hidden="true">
    {%- case block.settings.icon -%}
      {%- when 'capacity' -%}
        <svg viewBox="0 0 20 20" fill="none" focusable="false">
          <path d="M9.1666 5.83333L6.6664 10H10L7.4998 14.1667M12.3801 5H13.3336C13.7756 5 14.1996 5.17559 14.5122 5.48816C14.8247 5.80072 15.0004 6.22464 15.0004 6.66667V13.3333C15.0004 13.7754 14.8247 14.1993 14.5122 14.5118C14.1996 14.8244 13.7756 15 13.3336 15H10.8875M18.334 11.6667V8.33333M4.28288 15H3.3328C2.89074 15 2.46678 14.8244 2.15419 14.5118C1.84161 14.1993 1.666 13.7754 1.666 13.3333V6.66667C1.666 6.22464 1.84161 5.80072 2.15419 5.48816C2.46678 5.17559 2.89074 5 3.3328 5H5.77966" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
