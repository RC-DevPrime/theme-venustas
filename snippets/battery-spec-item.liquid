        <svg viewBox="0 0 20 20" fill="none" focusable="false">
          <path d="M7.50023 9.99962L9.16673 11.6663L12.4997 8.3329M16.666 10.8334C16.666 15.0002 13.7496 17.0836 10.2833 18.2919C10.1018 18.3534 9.90461 18.3505 9.72501 18.2836C6.25036 17.0836 3.33398 15.0002 3.33398 10.8334V4.99983C3.33398 4.77881 3.42177 4.56684 3.57804 4.41056C3.7343 4.25427 3.94624 4.16647 4.16723 4.16647C5.83373 4.16647 7.91686 3.16644 9.36671 1.89973C9.54324 1.74889 9.7678 1.66602 9.99998 1.66602C10.2322 1.66602 10.4567 1.74889 10.6333 1.89973C12.0914 3.17477 14.1662 4.16647 15.8327 4.16647C16.0537 4.16647 16.2657 4.25427 16.4219 4.41056C16.5782 4.56684 16.666 4.77881 16.666 4.99983V10.8334Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
