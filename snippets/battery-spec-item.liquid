          <path d="M2.88825 11.5392C3.02179 11.623 3.17639 11.6672 3.33407 11.6667H9.16675C9.30153 11.6663 9.4344 11.6985 9.55397 11.7607C9.67354 11.823 9.77624 11.9132 9.85326 12.0239C9.93028 12.1345 9.97931 12.2622 9.99616 12.3959C10.013 12.5297 9.99717 12.6655 9.94999 12.7918L8.35017 17.8087C8.32511 17.8999 8.33177 17.9968 8.36906 18.0837C8.40634 18.1705 8.47204 18.2421 8.55537 18.2867C8.6387 18.3313 8.73471 18.3462 8.82763 18.329C8.92056 18.3118 9.00488 18.2635 9.06676 18.1921L17.3158 9.69159C17.4152 9.56912 17.4777 9.42096 17.4962 9.26435C17.5147 9.10773 17.4884 8.94908 17.4204 8.80682C17.3523 8.66457 17.2453 8.54454 17.1117 8.4607C16.9782 8.37686 16.8236 8.33264 16.6659 8.33317H10.8332C10.6984 8.33361 10.5656 8.30134 10.446 8.23914C10.3264 8.17693 10.2237 8.08664 10.1467 7.97601C10.0697 7.86538 10.0207 7.73772 10.0038 7.60397C9.98696 7.47022 10.0028 7.33438 10.05 7.20811L11.6498 2.19114C11.6749 2.10001 11.6682 2.00306 11.6309 1.91622C11.5936 1.82937 11.5279 1.75778 11.4446 1.7132C11.3613 1.66862 11.2653 1.6537 11.1723 1.67089C11.0794 1.68808 10.9951 1.73635 10.9332 1.80779L2.68414 10.3083C2.5848 10.4308 2.52225 10.5789 2.50374 10.7355C2.48524 10.8921 2.51155 11.0508 2.57961 11.1931C2.64767 11.3353 2.7547 11.4553 2.88825 11.5392Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      {%- when 'output' -%}
        <svg viewBox="0 0 20 20" fill="none" focusable="false">
