                  <path d="M35.81,14.39a3,3,0,1,0,3,3A3,3,0,0,0,35.81,14.39Zm0,4a1,1,0,1,1,1-1A1,1,0,0,1,35.81,18.39Z"/>
                  <path d="M45.81,21.39a3,3,0,1,0,3,3A3,3,0,0,0,45.81,21.39Zm0,4a1,1,0,1,1-1-1A1,1,0,0,1,45.81,25.39Z"/>
