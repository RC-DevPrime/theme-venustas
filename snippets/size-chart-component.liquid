{%- liquid
  assign chart = matched_size_chart
  if chart == blank and size_chart != blank
    assign chart = size_chart
  endif

  assign chart_product = product
  assign title_text = product_title
  if title_text == blank and chart_product != blank
    assign title_text = chart_product.title
  endif

  assign button_text = button_label | default: 'Size Guide'
  assign chart_key = chart.id | default: chart.system.handle | default: 'chart'
  assign component_key = id | default: modal_id | default: section.id | default: chart_key
  assign component_key = component_key | append: '-' | append: chart_key | handleize
  assign modal_key = 'size-chart-component-' | append: component_key
  assign default_unit = chart.default_unit.value | default: 'IN' | upcase
-%}

{%- if chart != blank -%}
  {{ 'size-chart-component.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'size-chart-component.js' | asset_url }}" defer="defer"></script>

  <div class="size-chart-component" data-size-chart-component>
    <button
      class="size-chart-component__button {{ button_class }}"
      type="button"
      data-size-chart-open="{{ modal_key }}"
      aria-haspopup="dialog"
      aria-controls="{{ modal_key }}"
    >
      <img
        class="size-chart-component__button-icon"
        src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/size-chart-icon.png?v=1765009516"
        alt=""
        loading="lazy"
        width="18"
        height="18"
      >
      <span>{{ button_text }}</span>
    </button>

    <div
      class="size-chart-component__modal popup-modal"
      id="{{ modal_key }}"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      tabindex="-1"
      data-size-chart-modal
    >
      <div class="popup-overlay" data-size-chart-close></div>

      <div class="popup-content">
        <div class="popup-header">
          <button class="popup-close" type="button" data-size-chart-close aria-label="Close size guide">
            <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/add_2x_1.png?v=1765010574" alt="" loading="lazy" width="18" height="18">
          </button>
        </div>

        <div class="popup-container">
          <h3 class="size-chart-component__heading">Size Guide</h3>

          <div class="size-chart-component__tabs" role="tablist">
            <button class="size-chart-component__tab is-active" type="button" data-size-chart-tab="size-guide" role="tab" aria-selected="true">
              Size Guide
            </button>
            <button class="size-chart-component__tab" type="button" data-size-chart-tab="measuring-instruction" role="tab" aria-selected="false">
              Measuring Instructions
            </button>
          </div>

          <div class="size-chart-component__panel is-active" data-size-chart-panel="size-guide" role="tabpanel">
            <div class="size-chart-component__topline">
              {%- if title_text != blank -%}
                <div class="size-chart-component__product-title">{{ title_text }}</div>
              {%- endif -%}

              <div class="toggle-size-chart {{ default_unit | downcase }}" data-size-chart-toggle data-unit="{% if default_unit == 'CM' %}cm{% else %}in{% endif %}">
                {%- if default_unit == 'CM' -%}
                  <button class="unit-label left active" type="button" data-size-chart-unit="cm">CM</button>
                  <button class="toggle-box right" type="button" aria-label="Toggle size chart unit"></button>
                  <button class="unit-label right" type="button" data-size-chart-unit="in">IN</button>
                {%- else -%}
                  <button class="unit-label left active" type="button" data-size-chart-unit="in">IN</button>
                  <button class="toggle-box" type="button" aria-label="Toggle size chart unit"></button>
                  <button class="unit-label right" type="button" data-size-chart-unit="cm">CM</button>
                {%- endif -%}
              </div>
            </div>

            {%- if chart.chart_table_1.value != blank -%}
              <div class="scrollable-container">
                {{ chart.chart_table_1.value }}
              </div>
            {%- endif -%}

            {%- if chart.description != blank -%}
              <div class="size-chart-description">
                {{ chart.description | metafield_tag }}
              </div>
            {%- endif -%}
          </div>

          <div class="size-chart-component__panel" data-size-chart-panel="measuring-instruction" role="tabpanel" hidden>
            {%- if chart.section_1_heading.value != blank or chart.section_1_image_1.value != blank or chart.section_1_image_2.value != blank -%}
              {%- assign section_1_image_count = 0 -%}
              {%- if chart.section_1_image_1.value != blank -%}
                {%- assign section_1_image_count = section_1_image_count | plus: 1 -%}
              {%- endif -%}
              {%- if chart.section_1_image_2.value != blank -%}
                {%- assign section_1_image_count = section_1_image_count | plus: 1 -%}
              {%- endif -%}

              <div class="size-chart-component__instruction">
                {%- if chart.section_1_heading.value != blank -%}
                  <h4 class="size-chart-component__instruction-title">{{ chart.section_1_heading.value }}</h4>
                {%- endif -%}

                <div class="size-chart-component__image-grid{% if section_1_image_count == 1 %} size-chart-component__image-grid--single{% endif %}">
                  {%- if chart.section_1_image_1.value != blank -%}
                    {{
                      chart.section_1_image_1.value
                      | image_url: width: 1200
                      | image_tag: class: 'size-chart-component__image', loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(max-width: 767px) 100vw, 50vw', alt: chart.section_1_heading.value
                    }}
                  {%- endif -%}
                  {%- if chart.section_1_image_2.value != blank -%}
                    {{
                      chart.section_1_image_2.value
                      | image_url: width: 1200
                      | image_tag: class: 'size-chart-component__image', loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(max-width: 767px) 100vw, 50vw', alt: chart.section_1_heading.value
                    }}
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            {%- if chart.section_2_heading.value != blank or chart.section_2_image_1.value != blank or chart.section_2_image_2.value != blank -%}
              {%- assign section_2_image_count = 0 -%}
              {%- if chart.section_2_image_1.value != blank -%}
                {%- assign section_2_image_count = section_2_image_count | plus: 1 -%}
              {%- endif -%}
              {%- if chart.section_2_image_2.value != blank -%}
                {%- assign section_2_image_count = section_2_image_count | plus: 1 -%}
              {%- endif -%}

              <div class="size-chart-component__instruction">
                {%- if chart.section_2_heading.value != blank -%}
                  <h4 class="size-chart-component__instruction-title">{{ chart.section_2_heading.value }}</h4>
                {%- endif -%}

                <div class="size-chart-component__image-grid{% if section_2_image_count == 1 %} size-chart-component__image-grid--single{% endif %}">
                  {%- if chart.section_2_image_1.value != blank -%}
                    {{
                      chart.section_2_image_1.value
                      | image_url: width: 1200
                      | image_tag: class: 'size-chart-component__image', loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(max-width: 767px) 100vw, 50vw', alt: chart.section_2_heading.value
                    }}
                  {%- endif -%}
                  {%- if chart.section_2_image_2.value != blank -%}
                    {{
                      chart.section_2_image_2.value
                      | image_url: width: 1200
                      | image_tag: class: 'size-chart-component__image', loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(max-width: 767px) 100vw, 50vw', alt: chart.section_2_heading.value
                    }}
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
