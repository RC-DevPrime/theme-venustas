    "heating_prelaunch_faq_PahXjC": {
      "type": "heating-prelaunch-faq",
      "blocks": {
        "faq_3JBeNU": {
          "type": "faq",
          "settings": {
            "question": "Which size should I choose?",
            "answer": "<p>Volcano™ can work well as a mid-layer, so it should sit close over a base layer without pulling. Check the chart above against your chest measurement; if you're between sizes and plan to wear a thick base layer, take the larger one.&nbsp;</p>"
          }
        },
        "faq_h44V7V": {
          "type": "faq",
          "settings": {
            "question": "How long does it actually run?",
            "answer": "<p>On the two included batteries: about 4 hours on high, 6 on medium, 11 on low. Plugged into a 12V vehicle supply there's no limit.</p>"
          }
        },
        "faq_Fng3CC": {
          "type": "faq",
          "settings": {
            "question": "Can I take the batteries on a plane?",
            "answer": "<p>Yes. Each Volcano™ battery is rated at 54Wh, which is below the FAA’s 100Wh limit for lithium-ion batteries. Two batteries can be carried for personal use. Spare batteries must be packed in your carry-on baggage and protected against short circuits. Airline policies may vary, so we recommend checking with your airline before travel.</p>"
          }
        },
        "faq_8D9wfE": {
          "type": "faq",
          "settings": {
            "question": "What's covered by the warranty?",
            "answer": "<p>Three years on the heating elements and one year on the batteries, from the date of purchase. Founder Pass holders who reserved before launch have lifetime coverage on the heating elements instead.</p>"
          }
        },
        "faq_WgqpEh": {
          "type": "faq",
          "settings": {
            "question": "Do I need the Y cable set?",
            "answer": "<p>To check your own bike: your stator output needs to cover what the bike already uses plus the heated gear. For example, a 300W stator with 140W of stock load leaves 160W to spare — plenty for Volcano™'s 41W. A 154W heated set would fit too, but with almost nothing left over.</p>"
          }
        },
        "faq_dfKUiz": {
          "type": "faq",
          "settings": {
            "question": "How do I wash it?",
            "answer": "<p>Remove the batteries first. Gentle machine wash on low speed in cold water, then hang or tumble dry. No dry cleaning, bleaching, ironing or wringing.</p>"
          }
        }
      },
