    "heating_founder_terms_peLmYD": {
      "type": "heating-founder-terms",
      "name": "Heating Founder Terms",
      "settings": {
        "text": "<p>The Founder Pass is a $10 reservation for the Apex™ heated riding system, fully refundable at any time before launch. At launch it converts to a $50 coupon valid on the Apex™ Heated Jacket Liner and Apex™ Heated Pant Liner only, limited to one use per customer, $50 off your order regardless of quantity. The coupon does not combine with other order-level discounts. Paid value ($10) remains refundable before launch. $50 coupon expires 12 months after launch. The lifetime heating element warranty and the free 3-Way Cable apply to a qualifying order placed with the same email address used to reserve. Limited to 100 passes.</p>"
      }
    }
