      "blocks": {
        "faq_GAFkbR": {
          "type": "faq",
          "settings": {
            "question": "Do I get $100 off if I buy both?",
            "answer": "<p>No. The reservation gives you one $50 launch coupon for a qualifying Apex™ order, whether you buy one piece or both.</p>"
