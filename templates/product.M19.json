    "product_faqs_section_9y4Ffk": {
      "type": "product-faqs-section",
      "blocks": {
        "faq_TQWcGq": {
          "type": "FAQ",
          "settings": {
            "heading": "How long does shipping take and how can I track my package?",
            "body": "<p>Usually delivered within 5-7 business days. You can track your package here: <a href=\"https://venustas.aftership.com/\" target=\"_blank\" title=\"https://venustas.aftership.com/\">https://venustas.aftership.com/</a></p>"
          }
        },
        "faq_rLzrGb": {
          "type": "FAQ",
          "settings": {
            "heading": "Are heated jackets safe?",
            "body": "<p>Yes, our heated jackets are completely safe. However, please ensure the jacket is fully dry before using the heating function. Additionally, if you have a cardiac device, we recommend consulting with your doctor or the pacemaker manufacturer before use.</p>"
          }
        },
        "faq_UnKerq": {
          "type": "FAQ",
          "settings": {
            "heading": "Can I wash the heated jacket?",
            "body": "<p>Yes, they are hand-washable or machine-washable. If machine washing, please use a laundry bag (not included) to protect the internal cables. Please air dry naturally and do not use a dryer.</p>"
          }
        },
        "faq_KJf4tg": {
          "type": "FAQ",
          "settings": {
            "heading": "Can I take a heated jacket on a plane?",
            "body": "<p>Yes, our heated jackets are TSA-friendly. Both the power bank and the jacket can be taken on a plane. However, if you check your jacket in, you must remove the power bank and carry it with you in your carry-on luggage.</p>"
          }
        },
        "faq_RqJg9h": {
          "type": "FAQ",
          "settings": {
            "heading": "How to turn on the heated jacket?",
            "body": "<p>To turn on, press and hold the power button for 3 seconds. The apparel will begin to preheat for 5 minutes (blinking red LED), then automatically adjust to medium heat (white LED). To turn off, press and hold the power button for 3 seconds until the LED turns off. Please unplug the battery if not in use for an extended period.</p>"
          }
        }
      },
