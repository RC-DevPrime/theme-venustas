    "tech_meida_9hABhr": {
      "type": "tech-meida",
      "blocks": {
        "card_EwB7MY": {
          "type": "card",
          "settings": {
            "card_title": "Chrome Angelz RC",
            "card_desc": "My first impression of the Venustas fleece lined heated jacket has been fantastic! It’s incredibly soft, comfortable, fits true to size, and the controls are so easy to use. I love that it has three heat settings, and as a motorcycle rider in New York, staying warm during those colder rides is so important. I can’t wait to put it to the test this riding season and share my experience with fellow riders!",
            "card_logo": "shopify://shop_images/Chrome_Angelz_RC.png",
            "card_link": "https://chromeangelzrc.com"
          }
        },
        "card_VrpGdw": {
          "type": "card",
          "settings": {
            "card_title": "America's Walking Club",
            "card_desc": "I recently had the chance to try out the men’s heated vest from Venustas, and I was genuinely impressed. The quality is excellent, and it has a clean, stylish look. It fits true to size and is lightweight enough to pack easily for trips or outdoor activities. Even without turning on the heating elements, the vest is surprisingly warm — and with the heater on, it’s even better. Overall, a great piece to have for cooler weather.",
            "card_logo": "shopify://shop_images/America_s_Walking_Club.png",
            "card_link": "https://ava.org/"
          }
        },
        "card_P9eKYc": {
          "type": "card",
          "settings": {
            "card_title": "Gear Junkie",
            "card_desc": "If you are always cold or sometimes let frigid temps keep you from heading outside, the Venustas Classic Heated Vest is well worth investing in. It could be used for hiking, walking your dog, worn in hunting blinds, or simply in offices that are too cold.",
            "card_logo": "shopify://shop_images/Gear_Junkie.png",
            "card_link": ""
          }
        },
        "card_kMdNJn": {
          "type": "card",
          "settings": {
            "card_title": "Good Housekeeping",
            "card_desc": "During testing, our Textile Lab pros praised the heated socks for evenly distributed thermals across the toes. As an added bonus, we found that you'll barely feel any wires—just cozy, consistent warmth.",
            "card_logo": "shopify://shop_images/Good_Housekeeping.png",
            "card_link": ""
          }
        },
        "card_KfEGHw": {
          "type": "card",
          "settings": {
            "card_title": "Men's Health",
            "card_desc": "Where many of the vests I tested center the heat on a smaller targeted core area, the zones in this one feel more like large panels, so the heat is nice and even throughout my entire upper body.",
            "card_logo": "shopify://shop_images/Men_s_Health.png",
            "card_link": ""
          }
        },
        "card_rwkfaB": {
          "type": "card",
          "settings": {
            "card_title": "CTV news",
            "card_desc": "One of the reasons for that is the comfort they provide for your feet. With a 5-material blend that offers breathability, great moisture-wicking, and a cozy feel, your feet will be happy before you even turn the heat on. Plus, since the wires are integrated seamlessly into the fabric, you won’t ever feel like you’re stepping on them. Bonus!",
            "card_logo": "shopify://shop_images/CTV_news.png",
            "card_link": ""
          }
        },
        "card_fxktyg": {
          "type": "card",
          "settings": {
            "card_title": "Yahoo!life",
            "card_desc": "the Venustas Heated Gloves are for those who need something super ruggedized and warm, perhaps for those who need to work outside in the cold.",
            "card_logo": "shopify://shop_images/Yahoo_life.png",
            "card_link": ""
          }
        },
        "card_TAK7Jb": {
          "type": "card",
          "settings": {
            "card_title": "Cybernews",
            "card_desc": "Where many of the vests I tested center the heat on a smaller targeted core area, the zones in this one feel more like large panels, so the heat is nice and even throughout my entire upper body.",
            "card_logo": "shopify://shop_images/Cybernews.png",
            "card_link": ""
          }
        },
        "card_ME8gxa": {
          "type": "card",
          "settings": {
            "card_title": "Outdoorlife",
            "card_desc": "The upgraded Venustas vest has a long battery life thanks to a sizable battery. It stayed on for over 5 hours on the highest setting. This quilted vest traps heat and layers well for frontcountry excursions or sitting by the fire.",
            "card_logo": "shopify://shop_images/Outdoorlife.png",
            "card_link": ""
          }
        },
        "card_rMpj7p": {
          "type": "card",
          "settings": {
            "card_title": "The Street",
            "card_desc": "This jacket has a battery-powered dual control heating system that surpasses lesser jackets that we’ve seen before. Each heating zone is 30% larger than those in most other jackets, offering a more complete heating experience.",
            "card_logo": "shopify://shop_images/The_Street.png",
            "card_link": ""
          }
        }
      },
