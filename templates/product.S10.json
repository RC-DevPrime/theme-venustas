    "product_faqs_section_9y4Ffk": {
      "type": "product-faqs-section",
      "blocks": {
        "faq_TQWcGq": {
          "type": "FAQ",
          "settings": {
            "heading": "How long does shipping take and how can I track my package?",
            "body": "<p>Usually delivered within 5-7 business days. You can track your package here: <a href=\"https://venustas.aftership.com/\" target=\"_blank\" title=\"https://venustas.aftership.com/\">https://venustas.aftership.com/</a></p>"
          }
        },
        "faq_rLzrGb": {
          "type": "FAQ",
          "settings": {
            "heading": "Are heated socks safe?",
            "body": "<p>Yes, our heated socks are completely safe. However, please ensure the socks are fully dry before using the heating function. Additionally, if you have a cardiac device, we recommend consulting with your doctor or the pacemaker manufacturer before use.</p>"
          }
        },
        "faq_UnKerq": {
          "type": "FAQ",
          "settings": {
            "heading": "Can I wash the heated socks?",
            "body": "<p>Yes, they are hand-washable or machine-washable. If machine washing, please use a laundry bag (not included) to protect the internal cables. Please air dry naturally and do not use a dryer.</p>"
          }
        },
        "faq_KJf4tg": {
          "type": "FAQ",
          "settings": {
            "heading": "Can I take heated socks on a plane?",
            "body": "<p>Yes, our heated socks are TSA-friendly. Both the batteries and the socks can be taken on a plane. However, if you check your socks in, you must remove the batteries and carry them with you in your carry-on luggage.</p>"
          }
        },
        "faq_RqJg9h": {
          "type": "FAQ",
          "settings": {
            "heading": "How to turn on the heated socks?",
            "body": "<p>To turn on, press and hold the power button for 3 seconds. The socks will begin to preheat for 5 minutes (blinking red LED), then automatically adjust to medium heat (white LED). To turn off, press and hold the power button for 3 seconds until the LED turns off. Please unplug the batteries if not in use for an extended period.</p>"
          }
        }
      },
