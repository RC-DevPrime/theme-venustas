<section class="accounts">
    <div class="container section-content">
        <div class="row">
            <div class="col-lg-5 col-md-8 col-sm-12 mx-auto">
                <div class="customer-container">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12">
                            <h1 class="title-xs mt-bold f-black mb-4 text-center">Reset Account Password</h1>

                            {% form 'reset_customer_password' %}

                                <div class="form-group">
                                    <label for="new-password">New Password</label>
                                    <input type="password" class="form-control form-customer" name="customer[password]" autocomplete="new-password" required>
                                    {% if form.errors contains 'password' %}
                                        <h4 class="body mt-regular f-black mt-2">
                                            <small>
                                                {{ form.errors.translated_fields['password'] | capitalize }} {{ form.errors.messages['password'] }}
                                            </small>
                                        </h4>
                                    {% endif %}
                                </div>

                                <div class="form-group">
                                    <label for="password">Confirm Password</label>
                                    <input type="password" class="form-control form-customer" name="customer[password_confirmation]" autocomplete="new-password" required>
                                    {% if form.errors contains 'password_confirmation' %}
                                        <h4 class="body mt-regular f-black mt-2">
                                            <small>
                                                {{ form.errors.translated_fields['password_confirmation'] | capitalize }} {{ form.errors.messages['password_confirmation'] }}
                                            </small>
                                        </h4>
                                    {% endif %}
                                </div>

                                <div class="form-group text-center mt-lg-5 mt-md-4 mt-sm-4">
                                    <button class="btn btn-green">
                                        RESET PASSWORD
                                    </button>
                                </div>

                                {% if form.errors %}
                                    <ul class="body-lg f-yellow mt-light">
                                        {%- for field in form.errors -%}
                                            <li>
                                            {%- if field == 'form' -%}
                                                {{ form.errors.messages[field] }}
                                            {%- else -%}
                                                <a class="body mt-regular f-black" href="#{{ field }}">
                                                {{ form.errors.translated_fields[field] | capitalize }}
                                                {{ form.errors.messages[field] }}
                                                </a>
                                            {%- endif -%}
                                            </li>
                                        {%- endfor -%}
                                    </ul>
                                {% endif %}
                            {% endform %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>