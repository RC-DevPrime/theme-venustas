<section class="accounts">
    <div class="container section-content">
        <div class="row">
            <div class="col-lg-10 col-md-12 col-sm-12 mx-auto">
                <div class="customer-container">
                    <div class="row">
                        <div class="col-lg-3 col-md-12 col-sm-12 mb-4">
                            <h2 class="pretitle mt-bold f-black mb-4">Account Details</h2>
                            <div class="body mt-regular f-black mb-3">
                                {{ customer.default_address | format_address }}
                            </div>
                            <a class="body mt-regular f-black mb-3" href="{{ routes.account_addresses_url }}">
                                View Addresses ({{ customer.addresses_count }})
                            </a>
                            <a class="body mt-regular f-black" href="/account/logout">
                                Logout
                            </a>
                        </div>
                        <div class="col-lg-9 col-md-12 col-sm-12">
                            <h2 class="pretitle mt-bold f-black mb-4">Order History</h2>

                            {% paginate customer.orders by 20 %}
                                {% if customer.orders.size > 0 %}

                                    <div class="table-wrapper">
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th>Order</th>
                                                    <th>Date</th>
                                                    <th>Payment Status</th>
                                                    <th>Fulfillment Status</th>
                                                    <th class="text-end">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for order in customer.orders %}
                                                    <tr>
                                                        <td>
                                                            <a href="{{ order.customer_url }}" aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}">
                                                                {{ order.name }}
                                                            </a>
                                                        </td>
                                                        <td>
                                                            {{ order.created_at | time_tag: format: 'date' }}
                                                        </td>
                                                        <td>
                                                            {{ order.financial_status_label }}
                                                        </td>
                                                        <td>
                                                            {{ order.fulfillment_status_label }}
                                                        </td>
                                                        <td class="text-end">
                                                            {{ order.total_price | money_with_currency }}
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>

                                    {% if customer.orders.size > 20 %}
                                        <div class="paginate">

                                            {% if paginate.previous %}
                                                <a class="page" href="{{ paginate.previous.url }}">
                                                    <i class="fa-solid fa-chevron-left"></i>
                                                </a>
                                            {% else %}
                                                <a class="page disable" href="javascript:void(0)">
                                                    <i class="fa-solid fa-chevron-left"></i>
                                                </a>
                                            {% endif %}

                                            {% for part in paginate.parts %}
                                                {% if part.is_link %}
                                                    <a class="page" href="{{ part.url }}">{{ part.title }}</a>
                                                {% else %}
                                                    {% if part.title == paginate.current_page %}
                                                        <a class="page active" href="javascript:void(0)">{{ part.title }}</a>
                                                    {% else %}
                                                        <a class="page disable" href="javascript:void(0)">{{ part.title }}</a>
                                                    {% endif %}
                                                {% endif %}
                                            {% endfor %}

                                            {% if paginate.next %}
                                                <a class="page" href="{{ paginate.next.url }}">
                                                    <i class="fa-solid fa-chevron-right"></i>
                                                </a>
                                            {% else %}
                                                <a class="page disable" href="javascript:void(0)">
                                                    <i class="fa-solid fa-chevron-right"></i>
                                                </a>
                                            {% endif %}

                                        </div>
                                    {% endif %}

                                {% else %}
                                    <p class="body mt-regular f-black">
                                        You haven't placed any orders yet.
                                    </p>
                                {% endif %}
                            {% endpaginate %}

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>