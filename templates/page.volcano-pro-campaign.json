    "heating_v_dual_battery_QKk7e4": {
      "type": "heatingV-dual-battery",
      "name": "HeatingV Dual Battery",
      "settings": {
        "title": "The First Venustas Vest That Runs Both Batteries at Once",
        "description": "<p>Both 7.5K cells work on their own or together. Carry one when you want the vest light, both when you're out all day — and when they're both in, they run at the same time instead of one waiting its turn. It can heat up up to 11 hours, which covers a dawn-to-dark day on the ice, a full shift outside, or a long ride — without rationing the heat or hunting for an outlet.</p>",
        "image_1": "shopify://shop_images/heatingV-vest.webp",
        "image_1_mobile": "shopify://shop_images/heatingV-vest-mobile.webp",
        "image_2": "shopify://shop_images/heatingV-vest2.webp",
