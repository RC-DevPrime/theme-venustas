    "heating_v_heat_zones_RDceHQ": {
      "type": "heatingV-heat-zones",
      "name": "HeatingV Heat Zones",
      "settings": {
        "title": "The Largest Heating Area We've Ever Built Into a Vest",
        "description": "<p>85% of Your Upper-Body Core, Front and Back. Heat runs from the collar, down both sides of the chest, across the upper back on both sides, and all the way over the lower back — the areas that go cold first once you stop moving, and the areas a smaller panel layout leaves out.</p>",
        "jacket_image": "shopify://shop_images/heatingV-detail-men.webp",
        "pants_image": "shopify://shop_images/heatingV-detail-women.webp"
      }
    },
    "heating_v_battery_sides_mKxARD": {
      "type": "heatingV-battery-sides",
      "name": "HeatingV Battery Sides",
      "settings": {
        "item_1_title": "Batteries on Your Sides, Never Your Back",
        "item_1_description": "<p>One Battery Left. One Right. Balanced Across the Body. Sitting on a sled, riding a lift, leaning against a truck seat — the two places a battery pack usually digs in. Volcano™ keeps both off your back and off your spine.</p>",
        "item_1_desktop_image": "shopify://shop_images/heatingV-vest.webp",
        "item_2_title": "Near a 12v Outlet, It Never Runs Down",
        "item_2_description": "<p>The DC lead is already built into the left hand pocket. Add the Y cable set (sold separately, reserve for free) and Volcano™ series runs straight off a snowmobile, a motorcycle or an ATV's 12V power — no battery to watch, no ceiling on the day.</p>",
        "item_2_desktop_image": "shopify://shop_images/heatingV-12v-outlet.webp"
      }
    },
