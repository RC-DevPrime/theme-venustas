    "heating_v_power_kKbLGC": {
      "type": "heatingV-power",
      "name": "HeatingV Power",
      "settings": {
        "eyebrow": "How Volcano™ Started",
        "title": "You Asked More Heat. So We Built Volcano™",
        "description": "<p>Year after year, the riders, anglers and crews who stayed out longest told us the same two things: more heat when it really gets cold, and more time before the battery gives out. Volcano™ is our answer.</p>",
        "video": "shopify://files/videos/heatingW-video.mp4"
      }
    },
