    "product_faqs_section_9y4Ffk": {
      "type": "product-faqs-section",
      "blocks": {
        "faq_TQWcGq": {
          "type": "FAQ",
          "settings": {
            "heading": "How long does shipping take and how can I track my package?",
            "body": "<p>Usually delivered within 5-7 business days. You can track your package here: <a href=\"https://venustas.aftership.com/\" target=\"_blank\" title=\"https://venustas.aftership.com/\">https://venustas.aftership.com/</a></p>"
          }
        },
        "faq_rLzrGb": {
          "type": "FAQ",
          "settings": {
            "heading": "Is the jacket true to size? How should I choose my size?",
            "body": "<p>Our jackets are designed with a [Standard/Slim] fit. We recommend choosing your usual size for a tailored look, or sizing up if you plan to wear thick layers underneath. Please refer to our size chart for detailed measurements.</p>"
          }
        },
        "faq_KJf4tg": {
          "type": "FAQ",
          "settings": {
            "heading": "What temperature is this jacket suitable for?",
            "body": "<p>This jacket is a versatile mid-weight layer, ideal for temperatures between [0°C to 15°C]. Its breathable lining provides warmth without overheating, making it perfect for daily commuting and outdoor activities.</p>"
          }
        },
        "faq_RqJg9h": {
          "type": "FAQ",
          "settings": {
            "heading": "Is this jacket waterproof? How does it handle rain and snow?",
            "body": "<p>This long puffer is built for maximum protection. It features a <strong>non-PFC DWR finish</strong> and a <strong>laminated membrane</strong> to provide reliable waterproofing against rain, wind, and snow. For added versatility, it comes with a <strong>removable hood</strong>, allowing you to easily adapt to changing weather conditions while staying dry and comfortable.</p>"
          }
        },
        "faq_UnKerq": {
          "type": "FAQ",
          "settings": {
            "heading": "Can I machine wash the jacket?",
            "body": "<p>Yes, our jackets are easy to care for. You can machine wash it in cold water on a gentle cycle. To maintain the fabric's quality, we recommend air drying and avoiding bleach or high-heat ironing.</p>"
          }
        }
      },
