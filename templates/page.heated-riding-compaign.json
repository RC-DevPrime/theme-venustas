    "heating_faq_accordion_E8fzxp": {
      "type": "heating-faq-accordion",
      "blocks": {
        "faq_cqgTJ7": {
          "type": "faq",
          "settings": {
            "question": "Can I use the heated vest without my motorcycle?",
            "answer": "Yes. MV11 and WV12 include battery power for portable warmth."
          }
        },
        "faq_DQA6j6": {
          "type": "faq",
          "settings": {
            "question": "Can I connect the vest to my motorcycle?",
            "answer": "Yes. The vest can also connect through a compatible Y-cable for motorcycle power."
          }
        },
        "faq_eXELKj": {
          "type": "faq",
          "settings": {
            "question": "Do I need to buy the complete heated system?",
            "answer": "No. You can start with the heated gear you need most.\nThe Venustas Heated Riding System is modular. Start with a heated jacket for upper-body warmth, add heated pants for more coverage, and expand with additional accessories as your riding needs change."
          }
        },
        "faq_DHecGn": {
          "type": "faq",
          "settings": {
            "question": "Can I use the heated jacket or pants separately?",
            "answer": "Yes. Each heated layer is designed to work independently.\nThe heated jacket and heated pants can each connect directly to your motorcycle’s 12V power system using their dedicated connection cable."
          }
        },
        "faq_jacket_pants_together": {
          "type": "faq",
          "settings": {
            "question": "Can I connect the heated jacket and pants together?",
            "answer": "Yes. The jacket and pants can be combined into a complete heated setup using the compatible 3-way connection cable.\nThis allows both pieces to be powered together from your motorcycle."
          }
        },
        "faq_power_options": {
          "type": "faq",
          "settings": {
            "question": "How does the heated gear get power?",
            "answer": "You have two power options depending on how you ride.\nFor motorcycle riding, connect your heated gear directly to your motorcycle’s 12V power system for continuous warmth.\nFor portable warmth beyond the bike, compatible Venustas batteries allow you to use your heated gear in more situations."
          }
        },
        "faq_protective_gear": {
          "type": "faq",
          "settings": {
            "question": "Is this a replacement for motorcycle protective gear?",
            "answer": "No. Venustas heated gear is designed to be worn as a warming layer under your protective riding gear.\nYour outer riding gear provides protection from impact, abrasion, and weather. Venustas provides active warmth."
          }
        },
        "faq_bulk": {
          "type": "faq",
          "settings": {
            "question": "Will heated gear feel bulky under my riding gear?",
            "answer": "No. Venustas heated layers are designed to provide warmth without adding unnecessary bulk.\nThe slim profile allows riders to layer comfortably while maintaining mobility and riding freedom."
          }
        },
        "faq_when_to_use": {
          "type": "faq",
          "settings": {
            "question": "When should I use heated motorcycle gear?",
            "answer": "Heated gear is designed for rides when temperatures drop, including cold mornings, long-distance touring, changing weather, and extended time outdoors.\nIt helps riders stay comfortable when traditional layers are no longer enough."
          }
        },
        "faq_more_accessories": {
          "type": "faq",
          "settings": {
            "question": "Can I add more heated accessories later?",
            "answer": "Yes. The Venustas heated system is designed to expand with your needs.\nAdditional heated accessories such as gloves and socks can help provide more complete warmth when conditions become colder."
          }
        },
        "faq_only_motorcycles": {
          "type": "faq",
          "settings": {
            "question": "Is the heated gear only for motorcycles?",
            "answer": "No. While designed with riders in mind, compatible Venustas heated gear can also be used for other cold-weather activities.\nExamples include outdoor work, camping, and winter activities."
          }
        }
      },
