    "heating_founder_terms_qta9Lp": {
      "type": "heating-founder-terms",
      "name": "Heating Founder Terms",
      "settings": {
        "text": "<p>Heat levels measured at the inner lining under controlled conditions; actual warmth varies with ambient temperature, riding speed and layering. Apex™ liners are mid-layers and provide no abrasion or impact protection. A 12V DC vehicle supply is required for unlimited runtime; the 7.5K battery is sold separately. Always wear over a base layer rather than against bare skin, and do not run the heat while the engine is off. The Founder Pass discount is a one-time $50 discount code valid on the Apex™Heated Jacket Liner and Apex Heated Pant Liner only, limited to one use per customer, $50 off the order regardless of quantity, and does not combine with other order-level discounts.</p>"
      }
    }
