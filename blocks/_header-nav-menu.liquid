{%- liquid
  assign use_menu = false
  assign item_count = 4
  if block.settings.menu.links != blank
    assign use_menu = true
    assign item_count = block.settings.menu.links.size
  endif
-%}
{%- capture menu_items -%}
  {%- for item_index in (1..item_count) -%}
    {%- liquid
      assign item_description = blank
      assign item_current = false
      if use_menu
        assign item_link = block.settings.menu.links[forloop.index0]
        assign item_title = item_link.title
        assign item_url = item_link.url
        assign item_current = item_link.current
      else
        assign title_key = 'title_' | append: item_index
        assign url_key = 'url_' | append: item_index
        assign description_key = 'description_' | append: item_index
        assign item_title = block.settings[title_key]
        assign item_url = block.settings[url_key]
        assign item_description = block.settings[description_key]
      endif
      assign item_url = item_url | append: ''
      assign item_title = item_title | append: ''
      assign item_badge = blank
      if item_title contains '#'
        assign item_badge = item_title | split: '#' | last | strip
        assign item_title = item_title | split: '#' | first | strip
      elsif item_url contains '#'
        assign item_badge = item_url | split: '#' | last | strip
        assign item_url = item_url | split: '#' | first
      endif
      if item_badge != blank
        assign item_badge_lower = item_badge | downcase
        if item_badge_lower == item_badge
          assign item_badge = item_badge | capitalize
        endif
      endif
    -%}
    {%- if item_title != blank -%}
      <li>
        {%- if item_url != blank -%}<a href="{{ item_url | escape }}"{% if item_current %} aria-current="page"{% endif %}>{%- else -%}<span class="header-new__menu-label">{%- endif -%}
          <span>{{ item_title | escape }}{% if item_badge != blank %}<span class="header-new__badge">{{ item_badge | escape }}</span>{% endif %}</span>
          {%- if item_description != blank -%}<span class="header-new__menu-description">{{ item_description | escape | newline_to_br }}</span>{%- endif -%}
        {%- if item_url != blank -%}</a>{%- else -%}</span>{%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign menu_items = menu_items | strip -%}
{%- if menu_items != blank -%}
  <ul class="header-new__menu" {{ block.shopify_attributes }}>{{ menu_items }}</ul>
{%- endif -%}

