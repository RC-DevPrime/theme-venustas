
<div {{ block.shopify_attributes }} class="position-relative h-100">
    {% if block.settings.image != blank %}
    <img
        src="{{ block.settings.image | image_url: width: 1600 }}"
        srcset="
        {{ block.settings.image | image_url: width: 360 }} 360w,
        {{ block.settings.image | image_url: width: 540 }} 540w,
        {{ block.settings.image | image_url: width: 720 }} 720w,
        {{ block.settings.image | image_url: width: 900 }} 900w,
        {{ block.settings.image | image_url: width: 1080 }} 1080w,
        {{ block.settings.image | image_url: width: 1440 }} 1440w,
        {{ block.settings.image | image_url: width: 1600 }} 1600w
        "
        sizes="(min-width: 990px) 50vw, 100vw"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        decoding="async"
    >
    {% endif %}

    {%  content_for 'blocks' %}
</div>

{% schema %}
{
    "class": "swiper-slide",
    "name": "Featured Image Item",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        }
    ],
    "blocks": [
        {
            "type":"product-hotspot-item"
        },

    ],
    "presets": [
        {
            "name": "Featured Image Item"
        }
    ]

}
{% endschema %}