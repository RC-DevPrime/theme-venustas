<div class="header-new__column header-new__column--{{ block.settings.role }}" data-header-column data-column-role="{{ block.settings.role }}" data-mobile-default-open="{{ block.settings.mobile_default_open }}" {{ block.shopify_attributes }}>
  {%- if block.settings.title != blank -%}
    <h2 class="header-new__column-heading">{{ block.settings.title | escape }}</h2>
    <button class="header-new__column-toggle" type="button" data-header-column-toggle aria-expanded="false" aria-controls="HeaderColumn-{{ section.id }}-{{ block.id }}">
      {{ block.settings.title | escape }}
      <span class="header-new__icon">{% render 'header-icons', icon: 'chevron-right' %}</span>
    </button>
  {%- endif -%}
  <div class="header-new__column-content" id="HeaderColumn-{{ section.id }}-{{ block.id }}" data-header-column-content>
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Navigation column",
  "tag": null,
  "settings": [
    { "type": "text", "id": "title", "label": "Column title", "default": "Navigation" },
    { "type": "select", "id": "role", "label": "Column role", "options": [
      { "value": "group", "label": "Collapsible group" },
      { "value": "category", "label": "Shop by Category" }
    ], "default": "group" },
    { "type": "checkbox", "id": "mobile_default_open", "label": "Open by default on mobile", "info": "When no column in the panel enables this, the first column opens by default.", "default": false }
  ],
  "blocks": [
    { "type": "_header-nav-featured" },
    { "type": "_header-nav-image-menu" },
    { "type": "_header-nav-menu" },
    { "type": "_header-nav-feature" }
  ],
  "presets": [{ "name": "Navigation column" }]
}
{% endschema %}
