{%- liquid
  assign use_menu = false
  assign item_count = 8
  if block.settings.menu.links != blank
    assign use_menu = true
    assign item_count = block.settings.menu.links.size
  endif
-%}
{%- capture menu_items -%}
  {%- for item_index in (1..item_count) -%}
    {%- liquid
      assign item_image = blank
      assign item_badge = blank
      assign item_title_mobile = blank
      assign item_current = false
      if use_menu
        assign item_link = block.settings.menu.links[forloop.index0]
        assign item_title = item_link.title
        assign item_url = item_link.url
        assign item_current = item_link.current
        assign match_url = item_url | append: '' | strip | replace: '://www.', '://' | remove: shop.url | split: '#' | first | strip
        assign match_path = match_url | split: '?' | first
        assign match_query = blank
        if match_url contains '?'
          assign match_query = match_url | split: '?' | last | replace: '%20', '+'
        endif
        assign match_params = match_query | split: '&'
        assign best_score = -1
        assign best_index = 0
        for image_index in (1..8)
          assign url_key = 'url_' | append: image_index
          assign setting_url = block.settings[url_key] | append: '' | strip | replace: '://www.', '://'
          if setting_url contains 'shopify://'
            assign setting_url = setting_url | remove: 'shopify://'
            assign setting_url = '/' | append: setting_url
          endif
          assign setting_url = setting_url | remove: shop.url | split: '#' | first | strip
          assign setting_path = setting_url | split: '?' | first
          assign setting_matched = false
          assign setting_score = 0
          if setting_path != blank and setting_path == match_path
            assign setting_matched = true
            if setting_url contains '?'
              assign setting_params = setting_url | split: '?' | last | replace: '%20', '+' | split: '&'
              for setting_param in setting_params
                assign param_found = false
                for match_param in match_params
                  if match_param == setting_param
                    assign param_found = true
                    break
                  endif
                endfor
                unless param_found
                  assign setting_matched = false
                  break
                endunless
              endfor
              assign setting_score = setting_params.size
            endif
          endif
          if setting_matched and setting_score > best_score
            assign best_score = setting_score
            assign best_index = image_index
          endif
        endfor
        if best_index > 0
          assign image_key = 'image_' | append: best_index
          assign badge_key = 'badge_' | append: best_index
          assign title_key = 'title_' | append: best_index
          assign item_image = block.settings[image_key]
          assign item_badge = block.settings[badge_key]
          assign item_title_mobile = block.settings[title_key]
        endif
      else
        assign title_key = 'title_' | append: item_index
        assign url_key = 'url_' | append: item_index
        assign image_key = 'image_' | append: item_index
        assign badge_key = 'badge_' | append: item_index
        assign item_title = block.settings[title_key]
        assign item_title_mobile = item_title
        assign item_url = block.settings[url_key]
        assign item_image = block.settings[image_key]
        assign item_badge = block.settings[badge_key]
      endif
      assign item_title_mobile = item_title_mobile | default: item_title
      assign image_alt = item_image.alt | default: item_title_mobile
    -%}
    {%- if item_title != blank -%}
      <li class="header-new__image-menu-item">
        {%- if item_url != blank -%}<a class="header-new__image-menu-link" href="{{ item_url | escape }}"{% if item_current %} aria-current="page"{% endif %}>{%- else -%}<span class="header-new__image-menu-link">{%- endif -%}
          <span class="header-new__image-menu-media">
            {%- if item_image != blank -%}
              {{ item_image | image_url: width: 360 | image_tag: class: 'header-new__image-menu-image', widths: '120, 180, 240, 360', sizes: '(max-width: 1280px) calc((min(89vw, 100vw - 40px, 600px) - 72px) / 3), 1px', alt: image_alt, loading: 'lazy' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'header-new__image-menu-placeholder' }}
            {%- endif -%}
          </span>
          <span class="header-new__image-menu-title header-new__image-menu-title--desktop">{{ item_title | escape }}{% if item_badge != blank %}<span class="header-new__badge">{{ item_badge | escape }}</span>{% endif %}</span>
          <span class="header-new__image-menu-title header-new__image-menu-title--mobile">{{ item_title_mobile | escape }}{% if item_badge != blank %}<span class="header-new__badge">{{ item_badge | escape }}</span>{% endif %}</span>
        {%- if item_url != blank -%}</a>{%- else -%}</span>{%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign menu_items = menu_items | strip -%}
{%- if menu_items != blank -%}
  <ul class="header-new__image-menu" {{ block.shopify_attributes }}>{{ menu_items }}</ul>
{%- endif -%}

