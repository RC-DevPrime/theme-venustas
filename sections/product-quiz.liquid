        document.getElementById('quizResult').style.display = 'none';
        document.getElementById('quizQuestionsContainer').style.display = 'block';

        document.querySelectorAll('.quiz-answer').forEach(a => a.classList.remove('selected'));

        showQuestion(0);
    }

    function hydrateQuizProducts() {
        document.querySelectorAll('.quiz-product-wrapper').forEach(wrapper => {
            const handle = wrapper.dataset.handle;
            const template = document.querySelector(`#quiz-card-${handle}`);

            if (template) {
                wrapper.innerHTML = template.innerHTML;
            }
        });
    }

    buildQuizHTML();
    bindAnswerEvents();
    showQuestion(0);

    if (quizTargetsTrigger) {
        quizTargetsTrigger.addEventListener('click', openTargetsModal);
    }

    if (quizTargetsClose) {
        quizTargetsClose.addEventListener('click', closeTargetsModal);
    }

    if (quizTargetsModal) {
        quizTargetsModal.addEventListener('click', event => {
            if (event.target === quizTargetsModal) {
                closeTargetsModal();
            }
        });
    }

    if (quizTargetsSearch) {
        quizTargetsSearch.addEventListener('input', buildTargetsProductList);
    }

    if (quizTargetsCopy) {
        quizTargetsCopy.addEventListener('click', async () => {
            if (!quizTargetsExport) return;

            try {
                await navigator.clipboard.writeText(quizTargetsExport.value || '');
                quizTargetsCopy.textContent = 'Copied';
                setTimeout(() => {
                    quizTargetsCopy.textContent = 'Copy Debug Data';
                }, 1200);
            } catch (error) {
                console.error('Failed to copy quiz targets debug export:', error);
                quizTargetsExport.focus();
                quizTargetsExport.select();
            }
        });
    }

    document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && quizTargetsModal && quizTargetsModal.classList.contains('open')) {
            closeTargetsModal();
        }
    });

    document.getElementById('quizReset').addEventListener('click', resetQuiz);
    document.getElementById('mobilequizReset').addEventListener('click', resetQuiz);

    quizPicks.addEventListener('mousedown', e => {
        isDown = true;
        isDragging = false;
        startX = e.pageX - quizPicks.offsetLeft;
        scrollLeft = quizPicks.scrollLeft;
    });

    quizPicks.addEventListener('mouseleave', () => {
        isDown = false;
    });

    quizPicks.addEventListener('mouseup', () => {
        isDown = false;
        setTimeout(() => {
            isDragging = false;
        }, 50);
    });

    quizPicks.addEventListener('mousemove', e => {
        if (!isDown) return;
        e.preventDefault();
        isDragging = true;
        const x = e.pageX - quizPicks.offsetLeft;
        const walk = (x - startX) * 1;
        quizPicks.scrollLeft = scrollLeft - walk;
    });

    quizPicks.addEventListener('touchstart', e => {
        isDown = true;
        isDragging = false;
        startX = e.touches[0].pageX - quizPicks.offsetLeft;
        scrollLeft = quizPicks.scrollLeft;
    });

    quizPicks.addEventListener('touchend', () => {
        isDown = false;
    });

    quizPicks.addEventListener('touchmove', e => {
        if (!isDown) return;
        isDragging = true;
        const x = e.touches[0].pageX - quizPicks.offsetLeft;
        const walk = (x - startX) * 1;
        quizPicks.scrollLeft = scrollLeft - walk;
    });

    quizPicks.addEventListener('wheel', function (e) {
        if (e.deltaY !== 0) {
            e.preventDefault();
            quizPicks.scrollLeft += e.deltaY;
        }
    }, { passive: false });
});
</script>

