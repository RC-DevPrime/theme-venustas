                {% assign product = all_products[handle] %}
                {
                    "handle": {{ handle.handle | json }},
                    "title": {{ handle.title | json }},
                    "image": {{ handle.featured_image | img_url: '600x600' | json }}
                }{% unless forloop.last %},{% endunless %}
            {% endfor %}
        ],
        "auto_tag_match": {{ q.auto_tag_match.value }},
        "collection_filter": {% if q.collection_filter.value != blank %}{{ q.collection_filter.value.handle | json }}{% elsif q.collection_filter != blank and q.collection_filter.handle %}{{ q.collection_filter.handle | json }}{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
