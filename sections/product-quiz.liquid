    function closeTargetsModal() {
        if (!quizTargetsModal) return;
        quizTargetsModal.classList.remove('open');
        quizTargetsModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
    }

    function productMatchesAnswerMetafields(product, answer) {
        if (!configuredMetafields.length || !product.metafields) return false;

        return configuredMetafields.some(metafieldKey => {
            const rawValue = product.metafields[metafieldKey];
            const metafieldValues = normalizeMetafieldValues(rawValue);

            return metafieldValues.some(value => valuesMatch(value, answer));
        });
    }

    function productMatchesAnswer(product, answer) {
        return productMatchesAnswerTag(product, answer)
            || productMatchesAnswerType(product, answer)
            || productMatchesAnswerMetafields(product, answer);
    }

    function buildQuizHTML() {
        container.innerHTML = '';

        quizData.forEach((q, index) => {
            const questionDiv = document.createElement('div');
            questionDiv.className = 'quiz-question';
            questionDiv.dataset.qid = index;
