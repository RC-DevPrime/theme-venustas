<script>
document.addEventListener('DOMContentLoaded', () => {
    const quizData = JSON.parse(document.getElementById('quizDATA').textContent);
    const quizProductIndex = JSON.parse(document.getElementById('quizProductIndex').textContent);
    const quizTargetsProductIndex = JSON.parse(document.getElementById('quizTargetsProductIndex').textContent);
    const quizCollectionProductIndex = JSON.parse(document.getElementById('quizCollectionProductIndex').textContent);
    const quizTargetCollectionMeta = JSON.parse(document.getElementById('quizTargetCollectionMeta').textContent);
    const configuredMetafields = `{{ settings.quiz_matching_metafields | default: '' }}`
        .split(/\r?\n/)
        .map(value => value.trim())
        .filter(Boolean)
        .map(value => value.includes('.') ? value.toLowerCase() : `custom.${value.toLowerCase()}`);

    window.quizData = quizData;
    window.quizProductIndex = quizProductIndex;
    window.quizTargetsProductIndex = quizTargetsProductIndex;
    window.quizCollectionProductIndex = quizCollectionProductIndex;
    window.quizTargetCollectionMeta = quizTargetCollectionMeta;

    const container = document.getElementById('quizQuestionsContainer');
    const picksBar = document.getElementById('quizPicks');
    const quizPicks = document.querySelector('.quiz-picks');
    const quizTargetsTrigger = document.getElementById('quizTargetsTrigger');
    const quizTargetsModal = document.getElementById('quizTargetsModal');
    const quizTargetsClose = document.getElementById('quizTargetsClose');
    const quizTargetsSearch = document.getElementById('quizTargetsSearch');
    const quizTargetsCopy = document.getElementById('quizTargetsCopy');
    const quizTargetsExport = document.getElementById('quizTargetsExport');
    const quizTargetsList = document.getElementById('quizTargetsList');

    let answers = {};
    let history = [];
    let currentQuestion = 0;

    let isDown = false;
    let startX;
    let scrollLeft;
    let isDragging = false;
    let allProductsState = Array.isArray(quizProductIndex) ? quizProductIndex.slice() : [];
    let allProductsLoaded = false;
    let allProductsLoadingPromise = null;
    const collectionProductsCache = new Map();
    const collectionProductsLoadingPromises = new Map();
    let collectionProductsState = Array.isArray(quizCollectionProductIndex) ? quizCollectionProductIndex.slice() : [];

    if (quizTargetCollectionMeta.handle) {
        collectionProductsCache.set(quizTargetCollectionMeta.handle, collectionProductsState.slice());
    }

    function normalizeValue(value) {
        return String(value || '').trim().toLowerCase();
    }

    function slugifyValue(value) {
        return normalizeValue(value)
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
    }

    function resolveCollectionHandle(filter) {
        if (!filter) return '';

        if (typeof filter === 'string') return filter;

        if (typeof filter === 'object') {
            if (filter.handle) return filter.handle;
            if (filter.value && filter.value.handle) return filter.value.handle;
        }

        return '';
    }

    function getComparableValues(value) {
        const normalized = normalizeValue(value);
        const slug = slugifyValue(value);
        const values = new Set([normalized, slug]);

        [normalized, slug].forEach(item => {
            if (!item) return;

            if (item.endsWith('s') && item.length > 1) {
                values.add(item.slice(0, -1));
            } else {
                values.add(item + 's');
            }
        });

        return Array.from(values).filter(Boolean);
    }

    function valuesMatch(left, right) {
        const leftValue = normalizeValue(left);
        const rightValue = normalizeValue(right);

        if (!leftValue || !rightValue) return false;

        return leftValue === rightValue;
    }

    function productMatchesAnswerTag(product, answer) {
        const searchableValues = []
            .concat(product.tags || []);

        return searchableValues.some(value => valuesMatch(value, answer));
    }

    function productMatchesAnswerType(product, answer) {
        return valuesMatch(product.product_type, answer);
    }

    function normalizeMetafieldValues(value) {
        if (Array.isArray(value)) {
            return value.flatMap(item => normalizeMetafieldValues(item));
        }

        if (value == null || value === '') return [];

        if (typeof value === 'object') {
            if (Array.isArray(value.value)) {
                return normalizeMetafieldValues(value.value);
            }

            if (typeof value.value === 'string' || typeof value.value === 'number') {
                return [String(value.value)];
            }

            return Object.values(value).flatMap(item => normalizeMetafieldValues(item));
        }

        return [String(value)];
    }

    function escapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function getDisplayMetafieldLabel(metafieldKey) {
        return metafieldKey.replace(/^custom\./, '');
    }

    function normalizeFetchedCollectionProduct(product) {
        const normalizedTags = Array.isArray(product.tags)
            ? product.tags
            : String(product.tags || '')
                .split(',')
                .map(tag => tag.trim())
                .filter(Boolean);

        return {
            handle: product.handle || '',
            title: product.title || '',
            product_type: product.product_type || '',
            tags: normalizedTags,
            metafields: product.metafields || {},
            collections: Array.isArray(product.collections) ? product.collections : (quizTargetCollectionMeta.handle ? [quizTargetCollectionMeta.handle] : [])
        };
    }

    function mergeCollectionProducts(handle, products) {
        const mergedMap = new Map();

        products.forEach(product => {
            if (!product || !product.handle) return;
            mergedMap.set(product.handle, Object.assign({}, product));
        });

        const existingProducts = collectionProductsCache.get(handle) || [];

        existingProducts.forEach(product => {
            if (!product || !product.handle) return;

            const existing = mergedMap.get(product.handle) || {};
            mergedMap.set(product.handle, Object.assign({}, existing, product, {
                tags: (product.tags && product.tags.length) ? product.tags : (existing.tags || []),
                metafields: (product.metafields && Object.keys(product.metafields).length) ? product.metafields : (existing.metafields || {}),
                collections: (product.collections && product.collections.length) ? product.collections : (existing.collections || [])
            }));
        });

        const mergedProducts = Array.from(mergedMap.values());
        collectionProductsCache.set(handle, mergedProducts);

        if (quizTargetCollectionMeta.handle === handle) {
            collectionProductsState = mergedProducts.slice();
        }
    }

    async function ensureAllProductsLoaded() {
        if (allProductsLoaded) return allProductsState;
        if (allProductsLoadingPromise) return allProductsLoadingPromise;

        allProductsLoadingPromise = (async () => {
            const fetchedProducts = [];
            let nextUrl = '/collections/all?view=quiz-targets-json';

            while (nextUrl) {
                const response = await fetch(nextUrl);
                if (!response.ok) {
                    throw new Error(`Failed to load all products from ${nextUrl}`);
                }

                const payload = await response.json();
                const batch = Array.isArray(payload.products) ? payload.products : [];

                fetchedProducts.push(...batch.map(normalizeFetchedCollectionProduct));
                nextUrl = payload.next_url || null;
            }

            const mergedMap = new Map();

            allProductsState.forEach(product => {
                if (!product || !product.handle) return;
                mergedMap.set(product.handle, Object.assign({}, product));
            });

            fetchedProducts.forEach(product => {
                if (!product || !product.handle) return;

                const existing = mergedMap.get(product.handle) || {};
                mergedMap.set(product.handle, Object.assign({}, existing, product, {
                    tags: (product.tags && product.tags.length) ? product.tags : (existing.tags || []),
                    metafields: (product.metafields && Object.keys(product.metafields).length) ? product.metafields : (existing.metafields || {}),
                    collections: (product.collections && product.collections.length) ? product.collections : (existing.collections || [])
                }));
            });

            allProductsState = Array.from(mergedMap.values());
            allProductsLoaded = true;
            return allProductsState;
        })();

        try {
            return await allProductsLoadingPromise;
        } finally {
            allProductsLoadingPromise = null;
        }
    }

    function getProductsForCollectionHandle(handle) {
        if (!handle) return allProductsState.length ? allProductsState : quizProductIndex;
        const sourceProducts = allProductsState.length ? allProductsState : quizProductIndex;
        return sourceProducts.filter(product => (product.collections || []).includes(handle));
    }

    async function ensureCollectionProductsLoaded(handle) {
        if (!handle) return [];
        if (collectionProductsLoadingPromises.has(handle)) {
            return collectionProductsLoadingPromises.get(handle);
        }

        const cachedProducts = collectionProductsCache.get(handle);
        const targetCount = handle === quizTargetCollectionMeta.handle
            ? Number(quizTargetCollectionMeta.products_count || 0)
            : 0;

        if (cachedProducts && cachedProducts.length && (!targetCount || cachedProducts.length >= targetCount)) {
            return cachedProducts;
        }

        const loadingPromise = (async () => {
            const fetchedProducts = [];
            let page = 1;
            let hasMore = true;

            while (hasMore) {
                const response = await fetch(`/collections/${handle}/products.json?limit=250&page=${page}`);
                if (!response.ok) {
                    throw new Error(`Failed to load collection "${handle}" products.json page ${page}`);
                }

                const payload = await response.json();
                const batch = Array.isArray(payload.products) ? payload.products : [];

                fetchedProducts.push(...batch.map(product => {
                    const normalizedProduct = normalizeFetchedCollectionProduct(product);
                    normalizedProduct.collections = [handle];
                    return normalizedProduct;
                }));

                hasMore = batch.length === 250;
                page += 1;
            }

            try {
                let nextUrl = `/collections/${handle}?view=quiz-targets-json`;

                while (nextUrl) {
                    const response = await fetch(nextUrl);
                    if (!response.ok) break;

                    const payload = await response.json();
                    const batch = Array.isArray(payload.products) ? payload.products : [];

                    fetchedProducts.push(...batch.map(normalizeFetchedCollectionProduct));
                    nextUrl = payload.next_url || null;
                }
            } catch (error) {
                console.warn(`Quiz targets metafield enrichment failed for collection "${handle}"`, error);
            }

            mergeCollectionProducts(handle, fetchedProducts);
            return collectionProductsCache.get(handle) || [];
        })();

        try {
            collectionProductsLoadingPromises.set(handle, loadingPromise);
            return await loadingPromise;
        } finally {
            collectionProductsLoadingPromises.delete(handle);
        }
    }

    function renderTargetValuePills(values) {
        if (!values.length) {
            return '<p class="quiz-target-empty pp-regular body">No values found</p>';
        }

        return `
            <div class="quiz-target-pills">
                ${values.map(value => `<span class="quiz-target-pill pp-regular body">${escapeHtml(value)}</span>`).join('')}
            </div>
        `;
    }

    function getProductSearchText(product) {
        const metafieldValues = configuredMetafields.flatMap(metafieldKey => {
            return normalizeMetafieldValues(product.metafields ? product.metafields[metafieldKey] : []);
        });

        return [
            product.title || '',
            product.handle || '',
            product.product_type || '',
            ...(product.tags || []),
            ...metafieldValues
        ]
            .map(value => String(value || '').toLowerCase())
            .join(' ');
    }

    function filterProducts(products, query) {
        const normalizedQuery = String(query || '').trim().toLowerCase();
        if (!normalizedQuery) return products;

        return products.filter(product => getProductSearchText(product).includes(normalizedQuery));
    }

    function renderProductCards(products, emptyMessage) {
        if (!products.length) {
            return `<p class="quiz-target-empty pp-regular body">${escapeHtml(emptyMessage || 'No products found.')}</p>`;
        }

        return products.map(product => {
            const tagValues = (product.tags || []).map(value => String(value)).filter(Boolean);
            const metafieldGroups = configuredMetafields.map(metafieldKey => {
                const values = normalizeMetafieldValues(product.metafields ? product.metafields[metafieldKey] : [])
                    .map(value => String(value))
                    .filter(Boolean);

                return `
                    <div class="quiz-target-group">
                        <p class="pp-semibold body f-black">${escapeHtml(getDisplayMetafieldLabel(metafieldKey))}</p>
                        ${renderTargetValuePills(values)}
                    </div>
                `;
            }).join('');

            return `
                <div class="quiz-target-card">
                    <div class="quiz-target-card-header">
                        <div>
                            <h4 class="pp-bold body-xl f-black">${escapeHtml(product.title || product.handle || 'Untitled product')}</h4>
                            <p class="quiz-target-handle pp-regular body">${escapeHtml(product.handle || '')}</p>
                        </div>
                    </div>
                    <div class="quiz-target-groups">
                        <div class="quiz-target-group">
                            <p class="pp-semibold body f-black">Tags</p>
                            ${renderTargetValuePills(tagValues)}
                        </div>
                        ${metafieldGroups}
                    </div>
                </div>
            `;
        }).join('');
    }

    function buildProductDebugText(sectionLabel, products) {
        const lines = [`[${sectionLabel}] count=${products.length}`];

        products.forEach(product => {
            lines.push(`handle: ${product.handle || ''}`);
            lines.push(`title: ${product.title || ''}`);
            lines.push(`product_type: ${product.product_type || ''}`);
            lines.push(`tags: ${(product.tags || []).join(' | ') || 'none'}`);

            configuredMetafields.forEach(metafieldKey => {
                const values = normalizeMetafieldValues(product.metafields ? product.metafields[metafieldKey] : [])
                    .map(value => String(value))
                    .filter(Boolean);
                lines.push(`${metafieldKey}: ${values.join(' | ') || 'No values found'}`);
            });

            lines.push('');
        });

        return lines.join('\n');
    }

    function updateTargetsExport(targetProducts, collectionProducts) {
        if (!quizTargetsExport) return;

        const exportChunks = [
            `search_query: ${quizTargetsSearch ? (quizTargetsSearch.value || '') : ''}`,
            buildProductDebugText('Target Products', targetProducts),
            buildProductDebugText('Collection Products', collectionProducts)
        ];

        quizTargetsExport.value = exportChunks.join('\n\n');
    }

    function buildTargetsProductList() {
        if (!quizTargetsList) return;

        const searchQuery = quizTargetsSearch ? quizTargetsSearch.value : '';
        const targetProducts = quizTargetsProductIndex.length ? quizTargetsProductIndex : quizProductIndex;
        const collectionProducts = quizTargetCollectionMeta.handle
            ? getProductsForCollectionHandle(quizTargetCollectionMeta.handle)
            : [];
        const filteredTargetProducts = filterProducts(targetProducts, searchQuery);
        const filteredCollectionProducts = filterProducts(collectionProducts, searchQuery);

        updateTargetsExport(filteredTargetProducts, filteredCollectionProducts);

        quizTargetsList.innerHTML = `
            <details class="quiz-targets-section" open>
                <summary class="quiz-targets-summary">
                    <div>
                        <p class="pp-bold body-xl f-black">Target Products</p>
                        <p class="pp-regular body f-gray">Products selected in the section Target Product List setting.</p>
                    </div>
                </summary>
                <div class="quiz-targets-section-body">
                    ${renderProductCards(filteredTargetProducts, 'No matching products found in Target Products.')}
                </div>
            </details>
            <details class="quiz-targets-section">
                <summary class="quiz-targets-summary">
                    <div>
                        <p class="pp-bold body-xl f-black">Collection Products</p>
                        <p class="pp-regular body f-gray">All products from the selected Target Collection setting.</p>
                    </div>
                </summary>
                <div class="quiz-targets-section-body">
                    ${renderProductCards(filteredCollectionProducts, 'No matching products found in Collection Products.')}
                </div>
            </details>
        `;
    }

    async function openTargetsModal() {
        if (!quizTargetsModal) return;
        if (quizTargetsSearch) {
            quizTargetsSearch.value = '';
        }
        buildTargetsProductList();
        quizTargetsModal.classList.add('open');
        quizTargetsModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        if (quizTargetsSearch) {
            quizTargetsSearch.focus();
        }

        try {
            await ensureAllProductsLoaded();
            buildTargetsProductList();
        } catch (error) {
            console.error('Failed to load full all-products index for quiz targets popup:', error);
        }
