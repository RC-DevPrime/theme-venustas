    function restoreSelections(qid) {
        document.querySelectorAll('.quiz-answer[data-qid="' + qid + '"]')
            .forEach(btn => btn.classList.remove('selected'));

        const selected = answers[qid] || [];

        document.querySelectorAll('.quiz-answer[data-qid="' + qid + '"]')
            .forEach(btn => {
                if (selected.includes(btn.dataset.answer)) {
                    btn.classList.add('selected');
                }
            });
    }

    function showQuestion(idx) {
        document.getElementById('quizResult').style.display = 'none';
        document.querySelectorAll('.quiz-question').forEach(q => q.classList.remove('active'));

        const el = document.querySelector(`.quiz-question[data-qid="${idx}"]`);
        if (!el) return;

        el.classList.add('active');
        container.style.display = 'block';
        document.getElementById('quizMainNav').style.display = 'flex';
        document.getElementById('quizSubscribe').style.display = 'none';

        currentQuestion = idx;
        restoreSelections(idx);

        setTimeout(() => {
            document.querySelectorAll(`.quiz-question[data-qid="${idx}"] .quiz-answer`).forEach((item, i) => {
                item.classList.remove('quiz-answer-animate');
                void item.offsetWidth;
                setTimeout(() => {
                    item.classList.add('quiz-answer-animate');
                }, i * 70);
            });
        }, 10);
    }

    function bindAnswerEvents() {
        document.querySelectorAll('.quiz-answer').forEach(btn => {
            btn.addEventListener('click', e => {
                if (isDragging) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    return false;
                }

                const qid = parseInt(btn.dataset.qid, 10);
                const isMulti = btn.dataset.multi === 'true';

                if (!answers[qid]) answers[qid] = [];

                if (!isMulti) {
                    answers[qid] = [];
                    document.querySelectorAll(`.quiz-answer[data-qid="${qid}"]`)
                        .forEach(a => a.classList.remove('selected'));
                }

                btn.classList.toggle('selected');

                const value = btn.dataset.answer;

                if (btn.classList.contains('selected')) {
                    if (!answers[qid].includes(value)) answers[qid].push(value);
                } else {
                    answers[qid] = answers[qid].filter(v => v !== value);
                }

                updatePicks();
            });
        });
    }

    function jumpBackTo(qid) {
        qid = parseInt(qid, 10);

        Object.keys(answers).forEach(key => {
            if (parseInt(key, 10) > qid) {
                delete answers[key];
            }
        });

        history = history.filter(h => h <= qid);

        currentQuestion = qid;
        showQuestion(qid);
        updatePicks();
    }

    function updatePicks() {
        picksBar.innerHTML = '';

        Object.keys(answers).forEach(qid => {
            const q = quizData[qid];

            answers[qid].forEach(ans => {
                const index = q.answers.indexOf(ans);
                const img = q.answer_images[index];

                const div = document.createElement('div');
                div.className = 'quiz-pick';

                div.innerHTML = `
                    ${img ? `<img src="${img}" class="pick-img">` : ''}
                    <span>${ans}</span>
                `;

                div.addEventListener('click', () => jumpBackTo(qid));
                picksBar.appendChild(div);
            });
        });

        renderAnswerList();
    }

    function renderAnswerList() {
        const answerList = document.getElementById('answerList');
        if (!answerList) return;

        answerList.innerHTML = '';

        Object.keys(answers).forEach(qid => {
            (answers[qid] || []).forEach(ans => {
                const div = document.createElement('div');
                div.className = 'answer-item';
                div.innerHTML = `<p class="pp-regular body">${ans}</p>`;
                answerList.appendChild(div);
            });
        });
