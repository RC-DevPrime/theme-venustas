{% style %}
    #ProductQuizSection {
    }
    .quiz-picks{
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
        flex-wrap: nowrap;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        width:100%;
        
        user-select: none;
        -webkit-user-select: none;
        -ms-user-select: none;
    }
    .quiz-picks:active {
        cursor: grabbing;
    }
    .quiz-pick{
        background: #eee;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
        flex-wrap: wrap;
        height: 60px;
        width: 160px;
        border-radius: 8px;
        overflow: hidden;
        position: relative;
        padding: 0 1rem;
        flex: 0 0 auto;
        white-space: nowrap;
        
        user-select: none;
        -webkit-user-select: none;
        -ms-user-select: none;
    }
    .quiz-pick:before{
        content: "";
        width: 100%;
        height: 100%;
        position: absolute;
        left: 0;
        top: 0;
        background: #ffffff38;
        z-index: 1;
    }
    .quiz-pick img{
        width:100%;
        height:100%;
        object-fit:cover;
        position:absolute;
        top:0;
        left:0;
    }
    .quiz-pick span{
        color:#FFF;
        text-align:left;
        font-size:16px;
        font-weight:600;
        position:relative;
    }

    .quiz-question {
        display: none;
        opacity: 0;
        transition: .3s;
        margin-top:50px;
    }
    .quiz-question.active {
        display: block;
        opacity: 1;
    }
    .quiz-question .row{
        --bs-gutter-x: 1.5rem;
        --bs-gutter-y: 2rem;
    }
    .top-quiz-header{
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 30px;
        display: grid;
        grid-template-columns: 93% 6%;
    }
    .quiz-testing-tools{
        display:flex;
        justify-content:flex-end;
        margin-bottom:24px;
    }
    .quiz-targets-trigger{
        border:1px solid #B93205;
        background:#fff7f3;
        color:#B93205;
        border-radius:999px;
        padding:10px 18px;
        transition:all .2s ease;
    }
    .quiz-targets-trigger:hover{
        background:#B93205;
        color:#fff;
    }
    .quiz-answer {
        border: 1px solid #ccc;
        border-radius: 16px;
        padding: 10px;
        margin-bottom: 12px;
        cursor: pointer;
        display: flex;
        gap: 12px;
        align-items: center;
        height:260px;
        position:relative;
        overflow:hidden;
        opacity:0;
    }
    .quiz-answer .circle{
        width: 30px;
        height: 30px;
        position: absolute;
        bottom: 0.8rem;
        right: 1rem;
        background: #FFF;
        border:none;
        opacity: 0.8;
        border-radius: 50%;
    }
    .quiz-answer.selected .circle{
        background: #B93205;
        border: 1px solid #B93205;
        opacity: 1;
        background-image: url(https://cdn.shopify.com/s/files/1/0457/1099/9709/files/check-circle.png?v=1764085341);
        background-size: 50%;
        background-position: center center;
        background-repeat: no-repeat;
    }
    .quiz-answer.selected {
        background: #f4f4f4;
    }

    .quiz-answer .answer-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 8px;
        position:absolute;
        top:0;
        left:0;
        transition: all 0.3s ease;
    }
    .quiz-answer:hover .answer-img{
        scale:1.1;
    }

    .quiz-nav {
        margin-top: 40px;
        display: flex;
        justify-content: space-between;
    }
    .btn-quiz-back { 
        background: #ddd; 
        padding: 8px 18px; 
        border-radius: 8px; 
        border:none;
        display:flex;
        align-items:center;
        gap:10px;
        transition: all 0.2s ease;
    }
    .btn-quiz-next { 
        background: #B93205;
        color: #fff; 
        padding: 8px 1.5rem; 
        border-radius: 8px;
        border:none;
        display:flex;
        align-items:center;
        gap:10px;
        transition: all 0.2s ease;
    }
    .btn-quiz-next:hover,
    .btn-quiz-back:hover{
        background: #161616;
    }
    .btn-quiz-next svg,
    .btn-quiz-back svg{
        width:18px;
        height:18px;
    }

    .quiz-result { display: none; margin-top: 30px; }
    .quiz-product-list {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    }
    .quiz-product-card img {
        width: 100%;
        border-radius: 8px;
    }

    .quiz-subscribe {
        display: none;
    }

    #quizSubscribeForm .container-form{
        display:flex;
        align-items:center;
        gap:10px;
    }
    #quizSubscribeForm input{
        flex:1;
        background: #F0F0F0;
        border-radius:8px;
        padding:1rem 1rem;
        border:none;
    }
    #quizSubscribeForm button{
        background: #B93205;
        border-radius: 8px;
        border: none;
        height: 100%;
        width: fit-content;
        padding: 1rem 2rem;
        font-weight:600;
        font-size:18px;
        color:#FFF;
    }

    .btn-reset{
        display:flex;
        align-items:center;
        gap:6px;
        cursor:pointer;
    }
    .btn-reset svg{
        margin-top:-3px;
    }
    #quizProducts.row{
        --bs-gutter-x: 16px;
        --bs-gutter-y: 2rem;
    }
    .heading-pick{
        width: fit-content;
        white-space: nowrap;
    }

    .answer-list-container{
        display:inline-block;
    }
    .answer-list-container .answer-item{
        display:inline-block;
        border-radius: 6px;
        border: 1px solid #B93205;
        padding:5px 16px;
        margin-right:12px;
        margin-bottom:6px;
    }
    .answer-list-container .answer-item p{
        color:#B93205;
    }
    .quiz-recommendation-section{
        padding-top:40px;
    }
    .quiz-product-wrapper{
        height:100%;
    }
    .quiz-recommendation-slider .float-nav button{
        background:#f1eadd;
    }
    .quiz-recommendation-slider .float-nav button i{
        color:#B93205;
    }
    .quiz-targets-modal{
        position:fixed;
        inset:0;
        background:rgba(22,22,22,.55);
        display:none;
        align-items:center;
        justify-content:center;
        padding:24px;
        z-index:99;
    }
    .quiz-targets-modal.open{
        display:flex;
    }
    .quiz-targets-dialog{
        width:min(1100px, 100%);
        max-height:min(85vh, 900px);
        background:#fff;
        border-radius:24px;
        overflow:hidden;
        box-shadow:0 20px 60px rgba(0,0,0,.18);
        display:flex;
        flex-direction:column;
    }
    .quiz-targets-header{
        display:flex;
        align-items:flex-start;
        justify-content:space-between;
        gap:16px;
        padding:24px 24px 18px;
        border-bottom:1px solid #eee;
    }
    .quiz-targets-close{
        border:none;
        background:#f4f4f4;
        width:42px;
        height:42px;
        border-radius:50%;
        color:#4f4f4f;
        flex:0 0 auto;
    }
    .quiz-targets-close:hover{
        background:#161616;
        color:#fff;
    }
    .quiz-targets-body{
        overflow:auto;
        padding:20px 24px 24px;
    }
    .quiz-targets-search{
        margin-bottom:16px;
    }
    .quiz-targets-search input{
        width:100%;
        border:1px solid #e2ddd6;
        border-radius:12px;
        padding:14px 16px;
        background:#fff;
        color:#161616;
    }
    .quiz-targets-search input::placeholder{
        color:#8b8b8b;
    }
    .quiz-targets-export{
        display:grid;
        gap:10px;
        margin-bottom:16px;
    }
    .quiz-targets-export-header{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:12px;
        flex-wrap:wrap;
    }
    .quiz-targets-copy{
        border:1px solid #B93205;
        background:#fff;
        color:#B93205;
        border-radius:999px;
        padding:8px 14px;
    }
    .quiz-targets-copy:hover{
        background:#B93205;
        color:#fff;
    }
    .quiz-targets-export textarea{
        width:100%;
        min-height:180px;
        border:1px solid #e2ddd6;
        border-radius:12px;
        padding:14px 16px;
        background:#fff;
        color:#161616;
        resize:vertical;
    }
    .quiz-targets-list{
        display:grid;
        gap:16px;
    }
    .quiz-targets-section{
        border:1px solid #ece4d8;
        border-radius:18px;
        background:#fcfaf7;
        overflow:hidden;
    }
    .quiz-targets-section[open]{
        background:#fcfaf7;
    }
    .quiz-targets-summary{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
        padding:18px 20px;
        cursor:pointer;
        list-style:none;
    }
    .quiz-targets-summary::-webkit-details-marker{
        display:none;
    }
    .quiz-targets-summary:after{
        content:'+';
        font-size:24px;
        line-height:1;
        color:#B93205;
        flex:0 0 auto;
    }
    .quiz-targets-section[open] .quiz-targets-summary:after{
        content:'-';
    }
    .quiz-targets-section-body{
        padding:0 20px 20px;
        display:grid;
        gap:16px;
    }
    .quiz-target-card{
        border:1px solid #ece4d8;
        border-radius:18px;
        padding:20px;
        background:#fff;
    }
    .quiz-target-card-header{
        display:flex;
        align-items:flex-start;
        justify-content:space-between;
        gap:12px;
        margin-bottom:14px;
    }
    .quiz-target-handle{
        color:#8b8b8b;
    }
    .quiz-target-groups{
        display:grid;
        gap:14px;
    }
    .quiz-target-group{
        display:grid;
        gap:8px;
    }
    .quiz-target-pills{
        display:flex;
        flex-wrap:wrap;
        gap:8px;
    }
    .quiz-target-pill{
        display:inline-flex;
        align-items:center;
        border-radius:999px;
        padding:6px 12px;
        background:#fff;
        border:1px solid #eadfce;
        color:#4f4f4f;
    }
    .quiz-target-empty{
        color:#8b8b8b;
        font-style:italic;
    }
    .quiz-recommendation-slider .float-nav button:hover{
        background:#B93205;
    }
    .quiz-recommendation-slider .float-nav button:hover i{
        color:#FFF;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .quiz-recommendation-section{
            padding-top:30px;
        }
        .quiz-question{
            margin-top:0px;
        }
        .quiz-question .row {
            --bs-gutter-x: 12px;
            --bs-gutter-y: 1rem;
        }
        .quiz-answer{
            margin-bottom:8px;
            border-radius:8px;
        }
        .quiz-answer .circle{
            width: 20px;
            height: 20px;
            bottom: 10px;
            right: 10px;
        }
        .quiz-question .row p {
            font-size:14px;
        }
        .top-quiz-header{
            display:flex;
            flex-direction:column;
        }
        .quiz-pick{
            width:100px;
            height:40px;
            border-radius:4px;
            padding: 0px 10px;
        }
        .quiz-pick span{
            font-size:14px;
        }
        .btn-quiz-next svg, .btn-quiz-back svg{
            width:15px;
            height:15px;
        }
        .btn-quiz-next,
        .btn-quiz-back{
            padding:8px 1rem;
            gap:6px;
        }
        .btn-quiz-next span,
        .btn-quiz-back span{
            font-size:14px;
        }
        .btn-reset svg{
            width:18px;
            height:18px;
        }
        .heading-pick{
            font-size:14px;
        }
        #quizSubscribeForm{
            gap:6px;
        }
        #quizSubscribeForm button{
            font-size:12px;
            padding:0.7rem;
            border-radius:6px;
        }
        #quizSubscribeForm input{
            font-size:14px;
            padding:0.7rem;
            border-radius:6px;
        }
        .quiz-result{
            margin-top:0;
        }
        .answer-list-container .answer-item{
            padding:4px 12px;
            margin-right:8px;
            margin-bottom:6px;
        }
        .quiz-testing-tools{
            justify-content:flex-start;
            margin-bottom:18px;
        }
        .quiz-targets-modal{
            padding:12px;
        }
        .quiz-targets-header,
        .quiz-targets-body{
            padding-left:16px;
            padding-right:16px;
        }
        .quiz-targets-summary,
        .quiz-targets-section-body{
            padding-left:16px;
            padding-right:16px;
        }
        .quiz-target-card{
            padding:16px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

    /* MOBILES ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 0px) {
        .quiz-answer{
            height:140px;
        }
    }
    @media only screen and (min-width: 375px) {
        .quiz-answer{
            height:140px;
        }
    }
    @media only screen and (min-width: 390px) {
        .quiz-answer{
            height:140px;
        }
    }
    @media only screen and (min-width: 414px) {
        .quiz-answer{
            height:140px;
        }
    }
    @media only screen and (min-width: 428px) {
        .quiz-answer{
            height:150px;
        }
    }
    @media only screen and (min-width: 480px) {
        .quiz-answer{
            height:150px;
        }
    }

    /* TABLETS ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 768px) {
        .quiz-answer{
            height:200px;
        }
    }


    /* LAPTOPS --------------------------------------------------------------------------------- */

    @media only screen and (min-width: 1280px) {
        .quiz-answer{
            height:240px;
        }
    }
    @media only screen and (min-width: 1366px) {
        .quiz-answer{
            height:240px;
        }
    }
    @media only screen and (min-width: 1440px) {
        .quiz-answer{
            height:240px;
        }
    }
    @media only screen and (min-width: 1536px) {
        .quiz-answer{
            height:240px;
        }
    }
    @media only screen and (min-width: 1600px) {
        .quiz-answer{
            height:250px;
        }
    }

    /* COMPUTERS --------------------------------------------------------------------------------- */
    @media only screen and (min-width: 1920px) {
        .quiz-answer{
            height:260px;
        }
    }
    @media only screen and (min-width: 2560px) {
        .quiz-answer{
            height:260px;
        }
    }

    #ProductQuizSection .quiz_validation_checkbox_label{
        display: flex;
        gap: 6px;
        flex-direction: row-reverse;
        align-items: flex-start;
        justify-content: flex-end;
    }
    #ProductQuizSection #quiz_validation_input{
        display:none;
    }
    #ProductQuizSection .checkmark{
        position: relative;
        display: block;
        top: 2px;
        left: 0;
        width: 18px;
        height: 18px;
        background-color: transparent;
        border: 1px solid #66666640;
        border-radius: 50px;
        flex: initial;
        margin-top:2px;
    }
    #ProductQuizSection .checkmark:after{
        content: "";
        position: absolute;
        display: none;
        left: 5px;
        top: 2px;
        width: 5px;
        height: 9px;
        border: solid white;
        border-width: 0 2px 2px 0;
        -webkit-transform: rotate(45deg);
        -ms-transform: rotate(45deg);
        transform: rotate(45deg);
    }
    #ProductQuizSection #quiz_validation_input:checked~.checkmark{
        background: #B93205;
    }
    #ProductQuizSection #quiz_validation_input:checked~.checkmark:after{
        display: block;
    }

    .quiz-answer-animate {
        opacity: 0;
        transform: translateY(20px);
        animation: quizFadeUp 0.4s ease-out forwards;
    }

    @keyframes quizFadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    #quizSkip.is-loading {
        opacity: 0.8;
        pointer-events: none;
    }

    #quizSkip .quiz-btn-loader {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.35);
        border-top-color: #fff;
        border-radius: 50%;
        display: inline-block;
        animation: quizSpin 0.7s linear infinite;
        margin-left: 8px;
        vertical-align: middle;
    }

    @keyframes quizSpin {
        to {
            transform: rotate(360deg);
        }
    }
{% endstyle %}
<div class="container section-content" id="ProductQuizSection">

  <div class="top-quiz-header">
    <div class="d-flex flex-lg-row flex-md-row flex-sm-column align-items-lg-center align-items-md-center align-items-sm-start gap-lg-3 gap-md-3 gap-sm-2 flex-1 w-100">
        <div class="d-flex align-items-center justify-content-between w-100 flex-1">
            
            <p class="heading-pick pp-regular body-lg">Your Picks:</p>
            <div class="btn-reset d-lg-none d-md-none d-sm-block" id="mobilequizReset">
                <span class="pp-regular body f-gray">Restart</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="24.146" height="24.146" viewBox="0 0 24.146 24.146">
                    <g fill="#b7b7b7">
                        <path d="M21.551 13.414a9.47 9.47 0 0 0-1.6-5.272.755.755 0 0 0-1.258.835 7.971 7.971 0 1 1-6.62-3.541 9.2 9.2 0 0 1 2.686.392.759.759 0 0 0 .443-1.451 10.9 10.9 0 0 0-3.129-.463 9.487 9.487 0 1 0 9.477 9.5Z"/>
                        <path d="M16.721 5.925a.753.753 0 0 0 .081-1.066l-2.908-3.34a.75.75 0 0 0-1.066-.071.76.76 0 0 0-.07 1.066l2.908 3.33a.75.75 0 0 0 1.056.08Z"/>
                        <path d="m13.28 8.441 3.4-2.485a.756.756 0 0 0-.894-1.217l-3.391 2.475a.754.754 0 0 0-.161 1.056.71.71 0 0 0 .6.312.8.8 0 0 0 .446-.141"/>
                    </g>
                </svg>
            </div>
        </div>

        <div class="quiz-picks" id="quizPicks"></div>
    </div>

    <div class="btn-reset d-lg-flex d-md-flex d-sm-none" id="quizReset">
        <span class="pp-regular body f-gray">Restart</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="24.146" height="24.146" viewBox="0 0 24.146 24.146">
            <g fill="#b7b7b7">
                <path d="M21.551 13.414a9.47 9.47 0 0 0-1.6-5.272.755.755 0 0 0-1.258.835 7.971 7.971 0 1 1-6.62-3.541 9.2 9.2 0 0 1 2.686.392.759.759 0 0 0 .443-1.451 10.9 10.9 0 0 0-3.129-.463 9.487 9.487 0 1 0 9.477 9.5Z"/>
                <path d="M16.721 5.925a.753.753 0 0 0 .081-1.066l-2.908-3.34a.75.75 0 0 0-1.066-.071.76.76 0 0 0-.07 1.066l2.908 3.33a.75.75 0 0 0 1.056.08Z"/>
                <path d="m13.28 8.441 3.4-2.485a.756.756 0 0 0-.894-1.217l-3.391 2.475a.754.754 0 0 0-.161 1.056.71.71 0 0 0 .6.312.8.8 0 0 0 .446-.141"/>
            </g>
        </svg>
    </div>
  </div>

  {% if section.settings.enable_testing_mode %}
    <div class="quiz-testing-tools">
      <button type="button" class="quiz-targets-trigger pp-semibold body" id="quizTargetsTrigger">Show Targets Product List</button>
    </div>
  {% endif %}

  <div id="quizQuestionsContainer"></div>

  {% if section.settings.enable_testing_mode %}
    <div class="quiz-targets-modal" id="quizTargetsModal" aria-hidden="true">
      <div class="quiz-targets-dialog">
        <div class="quiz-targets-header">
          <div>
            <h3 class="pp-bold title-sm f-black pb-lg-1 pb-md-1 pb-sm-1">Targets Product List</h3>
            <p class="pp-regular body f-gray">Review each product's tags and the metafields included in Quiz Matching Metafields.</p>
          </div>
          <button type="button" class="quiz-targets-close" id="quizTargetsClose" aria-label="Close targets product list">×</button>
        </div>
        <div class="quiz-targets-body">
          <div class="quiz-targets-search">
            <input type="search" id="quizTargetsSearch" class="pp-regular body" placeholder="Search by product title, handle, tags, or metafields">
          </div>
          <div class="quiz-targets-export">
            <div class="quiz-targets-export-header">
              <p class="pp-semibold body f-black">Copy-Friendly Debug Export</p>
              <button type="button" class="quiz-targets-copy pp-semibold body" id="quizTargetsCopy">Copy Debug Data</button>
            </div>
            <textarea id="quizTargetsExport" class="pp-regular body" readonly placeholder="Debug export will appear here."></textarea>
          </div>
          <div id="quizTargetsList" class="quiz-targets-list"></div>
        </div>
      </div>
    </div>
  {% endif %}

  <div class="pt-lg-5 pt-md-5 pt-sm-3" id="quizSubscribe" style="display:none;">
    <div class="col-lg-6 col-md-7 col-sm-12 mx-auto pb-lg-5 pb-md-5 pb-sm-4">
        <div class="col-10 mx-auto">
            <h2 class="pp-bold title-sm text-center f-black pb-lg-3 pb-md-3 pb-sm-2">
                Almost there!
            </h2>
            <p class="pp-regular f-gray text-center body-lg pb-lg-4 pb-md-4 pb-sm-3">
                Subscribe now to unlock exclusive offers and special updates.
            </p>
        </div>

        {% form 'customer', id: 'quizSubscribeForm' %}
            <div class="container-form">
                <input type="email"
                    name="contact[email]"
                    id="quizEmail"
                    placeholder="Enter your email to get exclusive offers"
                    required />

                <button type="button" id="quizSubmitNow">Submit Now</button>
            </div>

