            questionDiv.innerHTML = `
                <h3 class="pp-bold title-sm f-black text-center pb-lg-3 pb-md-3 pb-sm-2">${q.question_text}</h3>
                <p class="pp-regular body-lg f-gray text-center">${helperText}</p>
                <div class="row mt-3"></div>
            `;

            const row = questionDiv.querySelector('.row');

            q.answers.forEach((ans, i) => {
