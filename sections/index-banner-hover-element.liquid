{% style %}
    .banner-hover-section{
        height:100vh;
        position:relative;
        overflow:hidden;
    }
    .banner-hover-section .bg-container{
        width:100%;
        height:100%;
    }
    .banner-hover-section .bg-container img{
        width:100%;
        height:100%;
        object-fit:cover;
    }

    /* overlay container */
    .banner-hover-section .element-container{
        position: absolute;
        bottom: -5px;
        left: 0;
        right: 0;
    }

    .banner-hover-section .img-element,
    .banner-hover-section .text-heading{
        will-change: transform;
        transform: translate3d(0,0,0);
    }

    .banner-hover-section .img-element{
        width:100%;
        height:85vh;
        object-fit:contain;
    }

    .banner-hover-section .element-text-container{
        position:absolute;
        inset:0;
        margin:auto;
        height:fit-content;
        pointer-events:none;
    }
    .banner-hover-section .element-text-container .text-heading{
        font-size:150px;
    }

    .banner-hover-section.is-leaving .img-element,
    .banner-hover-section.is-leaving .text-heading{
        transition: transform 250ms ease;
    }

  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
    .banner-hover-section{
        height:50vh;
    }
    .banner-hover-section .img-element {
        height: 45vh;
        margin-left: 17%;
    }
    .banner-hover-section .element-text-container{
        margin:0;
        padding-left:20px;
    }
    .banner-hover-section .element-text-container .text-heading{
        text-align:left !important;
    }
    .banner-hover-section .element-container{
        height:100%;
    }
    .banner-hover-section .element-container .position-relative{    
        height: 100%;
        display: flex;
        align-items: flex-end;
    }
  }

