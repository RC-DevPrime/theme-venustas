<script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>

<div class="predictive-search">
    <div class="overlay"></div>
    <div class="wrapper">
        <div class="container">
            
            <div class="col-2 d-lg-block d-md-none d-sm-none">
              <div class="logo">
                  <a href="/">
                    <img src="{{ settings.logo | img_url: 'master' }}">
                  </a>
              </div>
            </div>
            <div class="col-lg-8 col-md-6 col-sm-12">
                <div class="search-box-container">
                    <predictive-search>
                        <form action="{{ routes.search_url }}" method="get" role="search">
                            <div class="input-group">
                                <button type="submit">
                                    <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/search-icon.png?v=1763560283" class="icon" >
                                </button>
                                <input  id="Search" 
                                        type="text" 
                                        name="q" 
                                        value="{{ search.terms | escape }}" 
                                        aria-expanded="false"
                                        aria-owns="predictive-search-results"
                                        aria-controls="predictive-search-results"
                                        aria-haspopup="listbox"
                                        aria-autocomplete="list" placeholder="Search">
                                
                                <img src="https://cdn.shopify.com/s/files/1/0474/8365/0202/files/add_2x_bc131609-e92a-49f1-886a-390385879bcf.png" class="icon icon-close">
                            </div>
                        </form>
                    </predictive-search>
                </div>
            </div>
            <div class="col-lg-2 d-lg-flex d-md-flex d-sm-none justify-content-end">
              
            </div>
          
        </div>
    </div>
  {% if section.blocks.size > 0 %}
    <div id="predictive-search" tabindex="-1">
        <div class="inner-content">
        </div>
        {% render 'search-recommendations', 'block': block %}
    </div>
  {% endif %}
</div>

{% schema %}
{
    "name": "Search Recommendation",
    "blocks": [
        {
            "type": "Link",
            "name": "Link",
            "settings": [
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                }
            ]
        },
        {
            "type": "Product",
            "name": "Product",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                }
            ]
        }
    ]
}
{% endschema %}