<script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>

<div class="predictive-search">
    <div class="overlay"></div>
    <div class="wrapper">
        <div class="predictive-search__bar">
            <a class="predictive-search__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
                {%- if settings.logo != blank -%}
                    {{ settings.logo | image_url: width: 462 | image_tag: widths: '154, 308, 462', sizes: '154px', alt: shop.name, loading: 'eager' }}
                {%- else -%}
                    {{ shop.name | escape }}
                {%- endif -%}
            </a>
            <predictive-search class="predictive-search__box">
                <form class="predictive-search__field" action="{{ routes.search_url }}" method="get" role="search">
                    <button type="submit" aria-label="Search">
                        <span class="icon">{% render 'header-icons', icon: 'search' %}</span>
                    </button>
                    <input  id="Search" 
                            type="text" 
                            name="q" 
                            value="{{ search.terms | escape }}" 
                            aria-expanded="false"
                            aria-owns="predictive-search-results"
                            aria-controls="predictive-search-results"
                            aria-haspopup="listbox"
                            aria-autocomplete="list" placeholder="Search">
                    <span class="icon icon-close" role="button" tabindex="0" aria-label="Close search">{% render 'header-icons', icon: 'close' %}</span>
                </form>
            </predictive-search>
        </div>
    </div>
  {% if section.blocks.size > 0 %}
    <div id="predictive-search" class="predictive-search__results" tabindex="-1">
        <div class="inner-content">
        </div>
        {% render 'search-recommendations' %}
    </div>
  {% endif %}
</div>

{% render 'header-new-search-mobile', section: section %}

{% schema %}
{
    "name": "Search Recommendation",
    "blocks": [
        {
            "type": "Link",
            "name": "Link",
            "settings": [
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                }
            ]
        },
        {
            "type": "Product",
            "name": "Product",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                }
            ]
        }
    ]
}
{% endschema %}{%- comment -%}

