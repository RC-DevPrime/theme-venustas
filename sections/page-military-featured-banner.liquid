{% style %}
    .military-featured-banner-section .featured-banner-content{
        display:flex;
        flex-direction:column;
        align-items: flex-start;
        gap:15px;
    }
    .military-featured-banner-section .featured-banner{
        background: #F9F6EF;
        overflow:hidden;
        border-radius:16px;
    }   
{% endstyle %}
<div class="container section-content">
    <div class="featured-banner" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="100" data-aos-duration="500">
        <div class="row flex-lg-row flex-md-row flex-sm-column-reverse">
            <div class="col-lg-7 col-md-7 col-sm-12 d-flex flex-column justify-content-center align-items-start">
                <div class="featured-banner-content col-lg-10 col-md-10 col-sm-12 mx-auto px-lg-0 px-md-0 px-sm-3 pt-lg-0 pt-md-0 pt-sm-3 pb-lg-0 pb-md-0 pb-sm-5">
                    <h2 class="pp-bold f-main title-sm d-lg-block d-md-block d-sm-none"> 
                        {{ section.settings.heading }}
                    </h2>
                    <h2 class="pp-bold f-main pretitle-lg d-lg-none d-md-none d-sm-block"> 
                        {{ section.settings.heading }}
                    </h2>
                    <p class="pp-regular body-xl f-black col-lg-10 col-md-10 col-sm-12 d-lg-block d-md-block d-sm-none">
                        {{ section.settings.description }}
                    </p>
                    <p class="pp-regular body f-black col-lg-10 col-md-10 col-sm-12 d-lg-none d-md-none d-sm-block">
                        {{ section.settings.description }}
                    </p>
                    <a href="{{ section.settings.btn_link }}" class="btn-hover btn-main py-2 mt-lg-0 mt-md-0 mt-sm-4">
                        <span class="pp-regular body-lg text-center f-white">
                            {{ section.settings.btn_label }}
                        </span>
                    </a>
                </div>
            </div>
            <div class="col-lg-5 col-md-5 col-sm-12">
                <div class="featured-banner-image-container">
                    <img
                        src="{{ section.settings.banner_image | image_url: width: 1600 }}"
                        srcset="{{ section.settings.banner_image | image_url: width: 800 }} 800w,
                                {{ section.settings.banner_image | image_url: width: 1200 }} 1200w,
                                {{ section.settings.banner_image | image_url: width: 1600 }} 1600w"
                        sizes="100vw"
                        alt="{{ section.settings.banner_image.alt | escape }}"
                        loading="lazy"
                        decoding="async"
                        width="100%"
                        height="100%">
                </div>
            </div>
        </div>
    </div>
</div>
{% schema %}
    {
        "class": "military-featured-banner-section",
        "name": "Military Featured Banner",
        "templates": ["page"],
        "limit": 1, 
        "settings": [
            {
                "type": "image_picker",
                "id": "banner_image",
                "label": "Banner Image "
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Military members enjoy 25% off"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description",
                "default": "<p>To thank the soldiers for their dedication and show our lofty respect. This is the mission of Venustas.</p>"
            },
            {
                "type": "text",
                "id": "btn_label",
                "label": "Button Label",
                "default": "Get 25% OFF"
            },
            {
                "type": "url",
                "id": "btn_link",
                "label": "Button Link"
            }
        ],
        "presets" :[{
            "name" : "Military Featured Banner"
        }]
    }
{% endschema %} 