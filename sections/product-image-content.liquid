            </div>
        </div>
    </div>
</div>
{% schema %}
{
    "class": "product-image-content-section",
    "name": "Image Content",
    "templates": ["product"],
    "settings": [
        {
            "type": "checkbox",
            "id": "enabled_section_child_scroll",
            "label": "Enabled Section Child Scroll"
        },
        {
            "type": "text",
            "id": "section_scroll_nav",
            "label": "Section Scroll Nav",
            "info": "Need to Enabled first Section Scroll"
        },
        {
            "type": "text",
            "id": "nav_title",
            "label": "Navigation Title"
        },
        {
            "type": "image_picker",
            "id": "background_image",
            "label": "Background Image"
        },
        {
            "type": "text",
            "id": "counter_number",
            "label": "Counter Number",
            "info": "This counter number is only available in Style - 2"
        },
        {
            "type": "select",
            "id": "style_design",
            "label": "Style Design",
            "options": [
                {
                    "label": "Style - 1",
                    "value": "style_1"
                },
                {
                    "label": "Style - 2",
                    "value": "style_2"
                }
            ],
            "default": "style_1"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Venustas-Warm™ Heating Technology"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Advanced carbon fiber heating elements quickly warm up with the included 5K battery.</p>"
        },
        {
            "type": "text",
