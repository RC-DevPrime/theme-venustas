                {% endif %}
            </div>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="col-lg-11 col-md-11 col-sm-12 mx-auto h-100">
                <div class="content-container">
                    <div class="section-heading pp-bold title-sm f-white l-h-normal pb-lg-4 pb-md-4 pb-sm-3 text-lg-start text-md-start d-lg-block d-md-block d-sm-none text-sm-center">
