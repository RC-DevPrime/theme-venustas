                                </a>
                            </div>
                        </div>
                    {% endfor %}

                </div>
                
            </div>

        </div>


    </div>

</div>

{% schema %}
{
    "name": "Popup Cart",
    "settings": [
        {
            "type": "text",
            "id": "promotion_text",
            "label": "Promotion Text"
        },
        {
            "type": "text",
            "id": "membership_intro_text",
            "label": "Membership Intro Text",
            "default": "Join"
        },
        {
            "type": "text",
            "id": "membership_link_text",
            "label": "Membership Link Text",
            "default": "Venustas Heatwave Club"
        },
        {
            "type": "url",
            "id": "membership_link_url",
            "label": "Membership Link URL"
        },
        {
            "type": "text",
            "id": "membership_points_text",
            "label": "Membership Points Text",
            "info": "Use [points] where the dynamic points total should appear.",
            "default": "and earn [points] points on this order now!"
        },
        {
            "type": "number",
            "id": "membership_points_rate",
            "label": "Points per $1 of subtotal",
            "default": 1
        },
        {
            "type": "product_list",
            "id": "ymal_product",
            "label": "You May Also Like Product"
        }
    ],
    "blocks": [
        {
            "type": "banner_link",
            "name": "Banner Link",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                }
            ]
        }
    ]
}
{% endschema %}
