                <img
                    class="pb-lg-3 pb-md-3 pb-sm-2"
                    src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/48156_2x_dd4158c1-259a-4d89-87d4-d07cbe9e6944.png?v=1759925194"
                    srcset="
                        https://cdn.shopify.com/s/files/1/0457/1099/9709/files/48156_2x_dd4158c1-259a-4d89-87d4-d07cbe9e6944.png?v=1759925194 600w,
