{% include 'global-vars' %}

{% assign membership_points_rate = section.settings.membership_points_rate | default: 1 %}
{% assign membership_points = cart.items_subtotal_price | times: membership_points_rate | divided_by: 100 %}
{% assign membership_points_text = section.settings.membership_points_text | default: 'and earn [points] points on this order now!' %}
{% assign membership_points_rendered = membership_points_text | replace: '[points]', membership_points %}

<div id="popup-cart">

    <div class="overlay"></div>

    <div class="cart">

        <div class="el-overlay">
            <div class="el-spinner"></div>
        </div>

        <div class="cart-header">
            <div class="cart-header-con">
                <p class="cart-header-title pretitle pp-bold f-black d-lg-block d-md-block d-sm-none">
                    Shopping Cart {% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}
                </p>
                <p class="cart-header-title pretitle pp-semibold f-black d-lg-none d-md-none d-sm-block">
                    Shopping Cart {% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}
                </p>
                <button class="cart-close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24.771" height="24.771" viewBox="0 0 24.771 24.771">
                        <path d="M0 0h24.771v24.771H0Z" style="fill:transparent"/>
                        <path d="m171.66 158.039.057.052 7.013 7.014 6.755-6.755a1.032 1.032 0 0 1 1.512 1.4l-.052.057-6.756 6.754 6.756 6.755a1.032 1.032 0 0 1-1.4 1.513l-.057-.053-6.755-6.755-7.013 7.014a1.032 1.032 0 0 1-1.512-1.4l.052-.057 7.014-7.014-7.013-7.013a1.032 1.032 0 0 1 1.4-1.512Z" transform="translate(-165.843 -153.975)" style="fill:#111"/>
                    </svg>
                </button>
            </div>
            {% render 'free-shipping-progress',
                enable: settings.enable_calculator_free_shipping,
                threshold: settings.total_price,
                text_color: settings.text_color,
                background_color: settings.background_color,
                bg_30: settings.bg_30,
                bg_60: settings.bg_60,
                bg_100: settings.bg_100,
                enable_animation_progress_bar: settings.enable_animation_progress_bar
            %}
        </div>
        {% if section.settings.promotion_text != blank %}
            <div class="cart-promotion" {% if cart.item_count == 0 %} style="display:none" {% endif %}>
                {% comment %} <p class="body-sm pp-semibold f-black">
                    {{ section.settings.promotion_text }}
                </p> {% endcomment %}
            </div>
        {% endif %}

        <div class="cart-content-scroll">
            
            <div class="cart-body" {% if cart.item_count == 0 %} style="display:none" {% endif %}>

                {% assign totalLess = 0 %}
                {% assign totalDiscount = 0 %}

                {% if cart.item_count > 0 %}
                    {% for item in cart.items %}

                        <div class="product-cart"  class="product-cart" 
                            data-product-id="{{ item.product_id }}"
                            data-product-title="{{ item.product.title }}"
                            data-key="{{ item.key }}"
                        >
                            <a href="{{ item.url }}">
                                <div class="product-image">
                                    {% if item.variant.image %}
                                        <img src="{{ item.variant.image | img_url: 'master' }}">
                                    {% else %}
                                        <img src="{{ item.image | img_url: 'master' }}">
                                    {% endif %}
                                </div>
                            </a>
                            <div class="product-details">
                                <div class="d-flex flex-column h-100 position-relative">
                                    <div class="f-layer d-flex pb-1">
                                        <a href="{{ item.product.url }}" class="product-title pp-semibold f-black pe-4">
                                            {{ item.product.title }}
                                        </a>

                                        <div class="wishlist-button">
                                            <!-- Swym Wishlist Plus EPI Button with default first variant -->
                                            <button
                                                aria-label="Add to Wishlist"
                                                data-with-epi="true"
                                                class="swym-button swym-add-to-wishlist-view-product product_{{ item.product.id }}"
                                                data-swaction="addToWishlist"
                                                data-product-id="{{ item.product.id | json }}"
                                                data-variant-id="{{ item.product.variants[0].id | json }}"
                                                data-product-url="{{ shop.url }}{{ item.product.url }}">
                                            </button>

                                        </div>
                                    </div>
                                    <div class="s-layer d-flex flex-column position-relative flex-auto h-100 justify-content-between">
                                        <div class="d-flex justify-content-between">
                                            
                                            {% if item.variant.title != "Default Title" %}
                                                <div class="product-variant flex items-center">
                                                    <span>
                                                        {{ item.options_with_values | map: 'value' | join: ' / ' }}
                                                    </span>

                                                    <!-- icon svg -->
                                                    <div class="update-btn">
                                                        <svg  xmlns="http://www.w3.org/2000/svg" width="12.218" height="12.218" viewBox="0 0 12.218 12.218">
                                                            <path d="M118.062 106.808a.482.482 0 1 1 .682.682l-6.82 6.82a.482.482 0 0 1-.682-.682zm-.141 5a.482.482 0 1 1 .965 0v5.305a1.77 1.77 0 0 1-1.768 1.768h-8.681a1.77 1.77 0 0 1-1.768-1.768v-8.681a1.77 1.77 0 0 1 1.768-1.768h5.144a.482.482 0 1 1 0 .965h-5.144a.8.8 0 0 0-.8.8v8.681a.8.8 0 0 0 .8.8h8.681a.8.8 0 0 0 .8-.8v-5.305Z" transform="translate(-106.667 -106.667)" />
                                                        </svg>
                                                    </div>
                                                    
                                                    <div class="product-update popup-modal" 
                                                        data-cart-id="main-cart-{{ item.id }}"
                                                        data-line-key="{{ item.key }}"
                                                    >
                                                        {% render 'product-update-popup', product: item.product, selected_variant: item.variant, item: item %}
                                                    </div>
                                                </div>
                                            {% endif %}
                                            
                                            {%- assign max_qty = blank -%}
                                            {%- if item.variant.inventory_management and item.variant.inventory_policy == 'deny' -%}
                                            {%- assign max_qty = item.variant.inventory_quantity -%}
                                            {%- endif -%}

                                            {%- assign is_at_max = false -%}
                                            {%- if max_qty != blank and item.quantity >= max_qty -%}
                                            {%- assign is_at_max = true -%}
                                            {%- endif -%}

                                            {%- assign is_at_min = false -%}
                                            {%- if item.quantity <= 0 -%}
                                            {%- assign is_at_min = true -%}
                                            {%- endif -%}

                                            <div class="product-quantity"
                                            data-key="{{ item.key }}"
                                            data-max="{{ max_qty }}"
                                            data-available="{{ item.variant.available }}">

                                                <button
                                                    name="minus"
                                                    type="button"
                                                    class="less_qty{% if is_at_min %} disabled{% endif %}"
                                                    data-key="{{ item.key }}"
                                                    {% if is_at_min %}disabled{% endif %}
                                                    style="margin-right: 5px;">-</button>

                                                <input class="qty quantity__input"
                                                    type="number"
                                                    name="quantity"
                                                    min="0"
                                                    max="{{ max_qty }}"
                                                    readonly
                                                    value="{{ item.quantity }}"
                                                    data-key="{{ item.key }}"
                                                >

                                                <button
                                                    name="plus"
                                                    type="button"
                                                    class="add_qty{% if is_at_max or item.variant.available == false %} disabled{% endif %}"
                                                    data-key="{{ item.key }}"
                                                    data-max="{{ max_qty }}"
                                                    data-available="{{ item.variant.available }}"
                                                    {% if is_at_max or item.variant.available == false %}disabled{% endif %}
                                                    style="margin-left: 5px;">+</button>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div class="product-price">
                                                    {% if item.final_line_price > 0 %}
                                                        {% assign final_compare = item.quantity | times: item.variant.compare_at_price  %}
                                                        <span class="final pp-semibold f-main body-lg">
                                                            {{ item.final_line_price | money | prepend: curSym }}
                                                        </span>

                                                        {% if final_compare > 0 %}
                                                            <span class="original">
                                                                {{ final_compare | money | prepend: curSym }}
                                                            </span>

                                                            {% assign totalLess = totalLess | plus: final_compare %}
                                                        {% else %}
                                                            {% assign totalLess = totalLess | plus: item.final_line_price %}
                                                        {% endif %}
                                                
                                                            {% assign totalSavings = 0 %}
                                        
                                                            {% assign compare_price = item.variant.compare_at_price %}
                                                            {% assign original_price = item.variant.price %}
                                                            {% assign final_price = item.final_price %}
                                                            {% assign quantity = item.quantity %}
                                                            
                                                            {% if compare_price > original_price %}
                                                                {% assign price_saving = compare_price | minus: original_price %}
                                                            {% else %}
                                                                {% assign price_saving = 0 %}
                                                            {% endif %}
                                                            
                                                            {% assign additional_discount = original_price | minus: final_price %}
                                                            
                                                            {% assign savings_per_item = price_saving | plus: additional_discount %}
                                                            {% assign savings_total = savings_per_item | times: quantity %}
                                                            {% assign totalSavings = totalSavings | plus: savings_total %}
                                                            
                                                            {% comment %} {% if totalSavings > 0 %}
                                                            <span class="discounted">
                                                                Save {{ totalSavings | money_without_trailing_zeros | prepend: curSym }}
                                                            </span>
                                                            {% endif %} {% endcomment %}

                                                        {% if final_compare > 0 and discounted_price > 0 %}
                                                            {% assign totalLess = totalLess | minus: discounted_price %}
                                                        {% endif %}

                                                    {% else %}
                                                        <p class="body-sm pp-regular f-main">
                                                            Free
                                                        </p>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <a href="{{ item.url_to_remove }}" class="product-remove">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16.003" height="15.615" viewBox="0 0 16.003 15.615">
                                                    <path d="M12.49 26.265a.976.976 0 0 1-.975.975H4.488a.976.976 0 0 1-.975-.975V15.913h8.977Zm-7.026-12.1a.2.2 0 0 1 .2-.2h4.688a.2.2 0 0 1 .2.2v.588H5.463Zm9.952.588h-3.7v-.588a1.366 1.366 0 0 0-1.364-1.365H5.663A1.366 1.366 0 0 0 4.3 14.163v.588H.588a.588.588 0 0 0 0 1.175h1.75v10.339a2.15 2.15 0 0 0 2.15 2.15h7.026a2.15 2.15 0 0 0 2.15-2.15V15.913h1.75a.587.587 0 0 0 .586-.588.576.576 0 0 0-.585-.575ZM8 25.477a.587.587 0 0 0 .588-.588v-6.25a.588.588 0 1 0-1.175 0v6.251a.587.587 0 0 0 .587.587m-2.738 0a.587.587 0 0 0 .588-.588v-6.25a.588.588 0 1 0-1.175 0v6.251a.6.6 0 0 0 .588.588m5.476 0a.587.587 0 0 0 .588-.588v-6.251a.588.588 0 1 0-1.175 0v6.251a.587.587 0 0 0 .588.588" transform="translate(0 -12.8)"/>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    {% endfor %}
                {% else %}
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <p class="subtitle pp-regular f-light">
                            There's no item in your cart.
                        </p>
                    </div>
                {% endif %}
            </div>

            {% if section.settings.ymal_product != blank %}
                <div class="yml-container" {% if cart.item_count == 0 %} style="display:none" {% endif %}>
                    <div class="cart-ymal">
                        <div class="d-flex justify-content-between mb-2">
                            
                            <p class="body pp-semibold f-black">
                                You May Also Like
                            </p>
                            <div class="arrows-container">
                                <span class="slide-prev d-flex">
                                    <i class="fa-solid fa-chevron-left"></i>
                                </span>
                                <span class="slide-next d-flex">
                                    <i class="fa-solid fa-chevron-right"></i>
                                </span>
                            </div>
                        </div>
                        <div class="slider">
                            <div class="swiper cart-ymal-swiper">
                                <div class="swiper-wrapper">
                                    {% for ymal in section.settings.ymal_product %}
                                        {% if ymal.available %}
                                            <div class="swiper-slide item">
                                                <div class="ymal">
                                                    <div class="details">
                                                        <div class="free-image">
                                                            <img src="{{ ymal.featured_image | img_url: 'master' }}" alt="ymal-product-image">
                                                        </div>
                                                        <div class="free-text">
                                                            <a href="{{ ymal.url }}" class="product-title body-sm pp-semibold f-black mb-lg-4 mb-md-4 mb-sm-3 truncate-2-text">
                                                                {{ ymal.title }}
                                                            </a>
                                                            
                                                            <div class="wishlist-button">
                                                                <!-- Swym Wishlist Plus EPI Button with default first variant -->
                                                                <button aria-label="Add to Wishlist" data-with-epi="true" class="swym-button swym-add-to-wishlist-view-product product_{{ymal.id}}" data-swaction="addToWishlist" data-product-id="{{ymal.id | json}}" data-variant-id="{{ymal.variants[0].id}}" data-product-url="{{ shop.url }}{{ ymal.url }}">
                                                                </button>

                                                            </div>

                                                            <div class="price-atc-container">
                                                                <p class="body pp-semibold f-main">
                                                                    {{ ymal.selected_or_first_available_variant.price | money | prepend: curSym }}
                                                                    {% if ymal.selected_or_first_available_variant.compare_at_price %}
                                                                        <small class="pp-regular f-gray body-sm">
                                                                            {{ ymal.selected_or_first_available_variant.compare_at_price | money | prepend: curSym }}
                                                                        </small>
                                                                    {% endif %}
                                                                </p>

                                                            {% if ymal.has_only_default_variant %}
                                                                {% form 'product', ymal, id: ymal.id, class: 'ymal-form form', novalidate: 'novalidate', data-type: 'add-to-cart-form', action: 'javascript:void(0)' %}
                                                                    <input type="hidden" name="id" value="{{ ymal.selected_or_first_available_variant.id }}">
                                                                    <div class="form-btn">
                                                                        <button type='submit' name="add" class="btn-atc btn-hover btn-main" {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
                                                                            <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/76274_2x_d16fe5a8-ac81-452f-b21a-cba27f596eb7.png?v=1758116435" class="icon-atc" alt="cart-icon">
                                                                    
                                                                            <div class="position-relative">
                                                                                <span class="body-sm pp-semibold f-white">
                                                                                    {% if ymal.selected_or_first_available_variant.available == false %}Sold{% else %}Add{% endif %}
                                                                                </span>
                                                                                <div class="atc-overlay">
                                                                                    <div class="atc-spinner"></div>
                                                                                </div>
                                                                            </div>
                                                                        </button>
                                                                    </div>
                                                                {% endform %}
                                                            {% else %}
                                                                <div class="form-btn popup-atc">
                                                                    <button class="btn-atc btn-hover btn-main" data-popup-handle="{{ ymal.handle }}">
                                                                        <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/76274_2x_d16fe5a8-ac81-452f-b21a-cba27f596eb7.png?v=1758116435" class="icon-atc" alt="cart-icon">
                                                                
                                                                        <div class="position-relative">
                                                                            <span class="body-sm pp-semibold f-white">
                                                                                {% if ymal.selected_or_first_available_variant.available == false %}Sold{% else %}Add{% endif %}
                                                                            </span>
                                                                            <div class="atc-overlay">
                                                                                <div class="atc-spinner"></div>
                                                                            </div>
                                                                        </div>
                                                                    </button>
                                                                </div>
                                                            {% endif %}

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="cart-footer" {% if cart.item_count == 0 %} style="display:none" {% endif %}>
                <div class="text-lg-center text-md-center text-sm-left d-lg-block d-md-block d-sm-flex pb-lg-3 pb-md-3 pb-sm-2">
                    <svg class="d-inline" xmlns="http://www.w3.org/2000/svg" width="17.625" height="21.231" viewBox="0 0 17.625 21.231">
                        <path d="M146.816 86.025s-7.1-1.051-7.1-7.1S149 72.3 146.945 64.794c0 0 6.952 2.176 5.254 8.949a5.8 5.8 0 0 0 1.622-1.73s3.52 2.719 3.52 6.856-4.878 7.18-7.19 7.152c0 0 2.495-3.367.226-5.538-3.221-3.082-1.848-5.059-1.848-5.059s-7.848 3.839-1.713 10.6" transform="translate(-139.716 -64.794)" style="fill:#B93205"/>
                    </svg>
                    <p
                        class="pp-regular body-sm f-black d-inline ms-2 cart-membership-message"
                        data-membership-points-message
                        data-points-rate="{{ membership_points_rate }}"
                        data-points-template="{{ membership_points_text | escape }}"
                    >
                        {{ section.settings.membership_intro_text }}
                        <a href="#" class="icon-gift pp-regular body-sm f-main text-underline" onclick="return false;">
                            {{ section.settings.membership_link_text }}
                        </a>
                        <span data-membership-points-copy>{{ membership_points_rendered }}</span>
                    </p>

                </div>

                <div class="discount-wrapper">
                    <small>
                        Discount Code
                    </small>
                    <div class="discount-form">
                        <input type="text" name="discount-input" placeholder="Enter a coupon">
                        <button type="button">
                            Apply
                        </button>
                    </div>
                    <div class="discount-code-wrapper">
                        {% assign unique_discounts = "" %}
                            {% for item in cart.items %}
                                {% for discount in item.discounts %}
                                    {% if unique_discounts contains discount.title %}
                                        {% continue %}
                                    {% else %}

                                        <div class="discount-code">
                                            <i class="fa-solid fa-tags"></i> 
                                                {{ discount.title }} 
                                            <i class="fa-solid fa-xmark remove-discount" data-code="{{ discount.title }}"></i>
                                        </div>

                                        {% assign unique_discounts = unique_discounts | append: discount.title | append: "," %}
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}

                            {% assign unique_discounts_2 = "" %}
                            {% for discount in cart.cart_level_discount_applications %}
                                {% if unique_discounts_2 contains discount.title %}
                                    {% continue %}
                                {% else %}

                                    <div class="discount-code">
                                        <i class="fa-solid fa-tags"></i> 
                                            {{ discount.title }} 
                                        <i class="fa-solid fa-xmark remove-discount" data-code="{{ discount.title }}"></i>
                                    </div>

                                    {% assign unique_discounts_2 = unique_discounts_2 | append: discount.title | append: "," %}
                                {% endif %}
                            {% endfor %}
                    </div>
                    <p class="discount-message">
                        Please enter a valid code.
                    </p>
                </div>
                <div class="d-flex justify-content-between align-items-center pb-lg-2 pb-md-2 pb-sm-1">
                    <p class="body pp-medium f-gray">
                        Subtotal
                    </p>
                    <p class="body-lg pp-medium f-gray cart-total-price">
                        <span class="cart-total-less">
                            {{ cart.items_subtotal_price  | money | prepend: curSym }}
                        </span>
                    </p>
                </div>
                <div class="d-flex justify-content-between align-items-center pb-lg-2 pb-md-2 pb-sm-1">
                    <p class="body pp-medium f-gray">
                        Discount
                    </p>
                    <p class="body pp-semibold f-gray discount-applied">
                        -{{ cart.total_discount | money | prepend: curSym }}
                    </p>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <p class="body pp-bold f-black">
                        TOTAL
                    </p>
                    <p class="total-price body-lg pp-semibold f-main">
                        <span>
                            {{ cart.total_price | money | prepend: curSym }}
                        </span>
                    </p>
                </div>
                <p class="body-sm pp-medium f-black text-center mt-1 mb-1">
                    {% assign saving = totalLess | minus: cart.total_price %}
                    You're Saving <span class="total-save f-main">{{ saving | money | prepend: curSym }}</span>
                </p>
                <small class="text-center d-block pp-regular f-gray body-xs">
                    Shipping and Taxes calculated at checkout.
                </small>
            </div>
        </div>

        <div class='cart-checkout' {% if cart.item_count == 0 %} style="display:none" {% endif %}>
            {% if cart.item_count > 0 %}
                <a href="/checkout">
                    Check Out
                </a>
            {% else %}
                <a href="/checkout" class="disabled">
                    Check Out
                </a>
            {% endif %}

            <div class="d-flex justify-content-center pt-3">
                <ul class="list list-payment" role="list">
                    <li class="list-payment__item visa"><svg class="icon icon--full-color" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" width="38" height="24" aria-labelledby="pi-visa">
                            <title id="pi-visa">Visa</title>
