                    sizes="100vw"
                    width="100%"
                    height="100%"
                    alt="empty-bg-icon"
                    loading="lazy"
                    decoding="async"
                />

                <p class="pretitle pp-bold f-black text-center pt-lg-4 pt-md-4 pt-sm-3">
                    Your cart is empty
                </p>
            </div>
            <div class="banner-link-list">
                <div class="row">
                    {% for block in section.blocks %}
                        <div class="col-12">
