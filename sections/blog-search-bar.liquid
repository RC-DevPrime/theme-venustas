{% style %}
    .blog-search-bar-section .blog-search-container .input-search-container{
        background: #F5F5F5;
        border-radius: 8px 8px 8px 8px;
        overflow:hidden;
        padding:10px 20px;
        display:flex;
        align-items:center;
        gap:10px;
    }
    .blog-search-bar-section .blog-search-container .input-search-container input{
        border:none;
        background:transparent;
        width:100%;
        font-size:16px;
        font-family: 'Montserrat';
        font-weight: 400 !important;
    }
    .blog-search-bar-section .blog-search-container .input-search-container svg.search-icon{
        width:20px;
        height:20px;
        cursor:pointer;
    }
    .blog-search-bar-section .blog-search-container .input-search-container img{
        width:20px;
        height:20px;
        object-fit:contain;
        filter: brightness(0);
        cursor:pointer;
    }
{% endstyle %}
<div class="mid-container section-content pb-lg-0 pb-md-0 pb-sm-0">
    <div class="blog-search-container">
        <div class="input-search-container col-lg-10 col-md-10 col-sm-12 mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="20.2" height="20.2" viewBox="0 0 20.2 20.2" class="search-icon">
                <path d="m84.486 82.79-3.4-3.635a9.255 9.255 0 1 0-3.3 2.528.712.712 0 1 0-.59-1.295 7.838 7.838 0 1 1 4.6-7.137 8 8 0 0 1-1.091 3.99 7.4 7.4 0 0 1-1.094 1.438.713.713 0 0 0 .019 1.007c.023.019.05.027.073.046s.031.061.054.088l3.688 3.942a.7.7 0 0 0 .521.226.72.72 0 0 0 .487-.192.71.71 0 0 0 .033-1.006Z" transform="translate(-64.577 -63.889)" style="stroke:#000;stroke-width:.2px"/>
            </svg>
            <input type="text" class="search-input" placeholder="">
            <img class="delete-btn" src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/close-nav-mobile.png?v=1761785925" width="100%" height="100%">
        </div>
    </div>
    <div class="result-info pp-bold text-center pt-lg-5 pt-md-5 pt-sm-4 pretitle-xl" style="display:none;">
    </div>
</div>
{% schema %}
    {
        "class": "blog-search-bar-section",
        "name": "Blog Search Bar",
        "templates": ["blog"],
        "limit": 1, 
        "presets" :[{
            "name" : "Blog Search Bar"
        }]
    }
  {% endschema %} 