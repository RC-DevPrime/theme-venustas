{% style %}
  #shopify-section-{{ section.id }} {
    background-color: #ffffff;
  }

  #shopify-section-{{ section.id }} .product-batter-protections {
    width: min(100% - 40px, 1240px);
    margin: 0 auto;
    padding: 72px 0;
  }

  #shopify-section-{{ section.id }} .product-batter-protections__heading {
    margin: 0 0 48px;
    color: #1c1c1c;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .product-batter-protections__heading-line {
    display: block;
  }

  #shopify-section-{{ section.id }} .product-batter-protections__heading-accent {
    color: #b93205;
  }

  #shopify-section-{{ section.id }} .product-batter-protections__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .product-batter-protections__image-wrap {
    width: 100%;
    aspect-ratio: 604 / 380;
    overflow: hidden;
    border-radius: 12px;
    background-color: #ffffff;
    color: var(--venustas-black);
  }

  #shopify-section-{{ section.id }} .product-batter-protections__image,
  #shopify-section-{{ section.id }} .product-batter-protections__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .product-batter-protections__title {
    margin: 16px 0 16px;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .product-batter-protections__description {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .product-batter-protections__description p {
    margin: 0;
  }

  @media screen and (max-width: 1279px) and (min-width: 750px) {
    #shopify-section-{{ section.id }} .product-batter-protections {
      width: calc(100% - 40px);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .product-batter-protections {
      width: 100%;
      padding: 40px 20px;
    }

    #shopify-section-{{ section.id }} .product-batter-protections__heading {
      margin-bottom: 24px;
      font-size: 24px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .product-batter-protections__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .product-batter-protections__title {
      margin-top: 16px;
      margin-bottom:8px;
      font-size: 18px;
    }
  }
{% endstyle %}

<section class="product-batter-protections">
  {% if section.settings.heading != blank or section.settings.heading_accent != blank %}
    <h2 class="product-batter-protections__heading">
      {% if section.settings.heading != blank %}
        <span class="product-batter-protections__heading-line">{{ section.settings.heading | escape }}</span>
      {% endif %}
      {% if section.settings.heading_accent != blank %}
        <span class="product-batter-protections__heading-line product-batter-protections__heading-accent">
          {{ section.settings.heading_accent | escape }}
        </span>
      {% endif %}
    </h2>
  {% endif %}

  <div class="product-batter-protections__grid">
    {% for block in section.blocks %}
      <article class="product-batter-protections__item" {{ block.shopify_attributes }}>
        <div class="product-batter-protections__image-wrap">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1208
              | image_tag:
                class: 'product-batter-protections__image',
                widths: '360, 480, 604, 800, 1000, 1208',
                sizes: '(min-width: 1280px) 604px, (min-width: 750px) calc((100vw - 72px) / 2), calc(100vw - 40px)',
                loading: 'lazy',
                alt: block.settings.image.alt
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'product-batter-protections__placeholder' }}
          {% endif %}
        </div>

        {% if block.settings.title != blank %}
          <h3 class="product-batter-protections__title">{{ block.settings.title | escape }}</h3>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="product-batter-protections__description">{{ block.settings.description }}</div>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Battery Protections",
  "class": "product-batter-protections-section",
  "templates": ["product"],
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Black heading",
      "default": "BUILT WITH MULTIPLE"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Red heading",
      "default": "SAFETY PROTECTIONS"
    }
  ],
  "blocks": [
    {
      "type": "protection",
      "name": "Protection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended size: 604 × 380 px. The same image is used on desktop and mobile."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Temperature Monitoring"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Smart NTC sensor monitors battery temperature in real-time, instantly adjusting performance parameters to ensure completely safe operation.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Battery Protections",
      "blocks": [
        {
          "type": "protection"
        },
        {
          "type": "protection",
          "settings": {
            "title": "Stable Power Output",
            "description": "<p>BMS (Battery Management System) regulates stable constant voltage output for continuous optimal performance of your apparel's heating elements.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
