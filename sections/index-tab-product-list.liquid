{% endstyle %}

{% javascript %}
    const tabsContainer = document.getElementById('tabs-container');
    const tabs = tabsContainer.querySelectorAll('.tab');
    const radios = tabsContainer.querySelectorAll('input[type=radio]');
    const glider = tabsContainer.querySelector('.glider');
    const tabItems = document.querySelectorAll('.tab-container-item');

    function moveGlider() {
        const selectedIndex = Array.from(radios).findIndex(r => r.checked);
        const activeTab = tabs[selectedIndex];
        const width = activeTab.offsetWidth;
        const x = activeTab.offsetLeft;

        glider.style.setProperty('--glider-width', width + 'px');
        glider.style.setProperty('--glider-x', x + 'px');
    }

    function updateArrowPosition(tabItem) {
        if (!tabItem || getComputedStyle(tabItem).display === 'none') return;

        const productImage = tabItem.querySelector('.product-image');
        const floatNav = tabItem.querySelector('.float-nav');
        const arrow = floatNav?.querySelector('.owl-prev, .owl-next');
        if (!productImage || !floatNav || !arrow || getComputedStyle(arrow).display === 'none') return;

        // Reset first so every recalculation is based on the global float-nav
        // position rather than accumulating the previous correction.
        floatNav.style.setProperty('--product-image-nav-offset', '0px');

        const imageRect = productImage.getBoundingClientRect();
        const arrowRect = arrow.getBoundingClientRect();
        const imageCenter = imageRect.top + (imageRect.height / 2);
        const arrowCenter = arrowRect.top + (arrowRect.height / 2);
        const verticalOffset = imageCenter - arrowCenter;

        floatNav.style.setProperty('--product-image-nav-offset', `${verticalOffset}px`);
    }

    function updateArrowPositions() {
        tabItems.forEach(updateArrowPosition);
    }

    function switchTabs() {
        const selectedRadio = this;
        const tabId = selectedRadio.dataset.tabId;

        // First hide all tabs completely
        tabItems.forEach(item => {
            item.style.display = "none";
            item.style.opacity = 0;
            item.style.transition = "none"; // reset to avoid unwanted animation
        });

        // Then show the selected tab and fade it in
        const selectedItem = Array.from(tabItems).find(
            item => item.dataset.tabId === tabId
        );

        if (selectedItem) {
            selectedItem.style.display = "block";
            selectedItem.style.transition = "opacity 0.3s ease 0.1s";
            requestAnimationFrame(() => {
                updateArrowPosition(selectedItem);
                selectedItem.style.opacity = 1;
            });
        }

        moveGlider();
    }

    moveGlider();
    updateArrowPositions();


    radios.forEach(radio => {
        radio.addEventListener('change', switchTabs);
    });

    // Initialize on load
    window.addEventListener('load', () => {
        moveGlider();
        updateArrowPositions();
    });
    window.addEventListener('resize', () => {
        moveGlider();
        updateArrowPositions();
    });

    if ('ResizeObserver' in window) {
        const arrowPositionObserver = new ResizeObserver(entries => {
            entries.forEach(entry => {
                updateArrowPosition(entry.target.closest('.tab-container-item'));
            });
        });

        tabItems.forEach(item => {
            const productImage = item.querySelector('.product-image');
            if (productImage) arrowPositionObserver.observe(productImage);
        });
    }
{% endjavascript %}

{% schema %}
{
    "class": "tab-product-list-section position-relative",
    "name": "Tab Product List",
    "limit": 1,
    "templates": ["index"],
    "settings": [
        {
            "type": "select",
            "id": "sale_badge_type",
            "label": "Sale Badge Type",
            "options": [
                {
                    "label": "Percentage",
                    "value": "discount"
                },
                {
                    "label": "Text Discount",
                    "value": "text_discount"
                }
            ],
            "default": "discount"
        }
    ],
    "max_blocks": 2,
    "blocks": [
        {
            "type": "tab",
            "name": "Tab",
            "settings": [
                {
                    "type": "text",
                    "id": "tab_label",
                    "label": "Tab Label"
                },
                {
                    "type": "collection",
                    "id":"collection",
                    "label": "Collection List",
                },
                {
                    "type": "number",
                    "id": "maximum_number_product_display",
                    "label": "Maximum Number Product Display",
                    "default": 20
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Tab Product List"
        }
    ]
}
{% endschema %}
