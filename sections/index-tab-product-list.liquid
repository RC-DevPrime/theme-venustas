{% javascript %}
    const sectionRoot = document.querySelector('.tab-product-list-section');
    if (!sectionRoot) return;

    const tabsContainer = sectionRoot.querySelector('#tabs-container');
    const tabs = tabsContainer ? tabsContainer.querySelectorAll('.tab') : [];
    const radios = tabsContainer ? tabsContainer.querySelectorAll('input[type=radio]') : [];
    const glider = tabsContainer ? tabsContainer.querySelector('.glider') : null;
    const tabItems = sectionRoot.querySelectorAll('.tab-container-item');
    const sectionUrl = sectionRoot.querySelector('.section-content')?.dataset.sectionUrl || window.location.pathname;
    const loadedTabs = new Set();

    if (radios[0]) loadedTabs.add(radios[0].dataset.tabId || 'tabs-1');

    function moveGlider() {
        if (!tabsContainer || !glider || !radios.length) return;
        const selectedIndex = Array.from(radios).findIndex(r => r.checked);
        const activeTab = tabs[selectedIndex];
        if (!activeTab) return;
        const width = activeTab.offsetWidth;
        const x = activeTab.offsetLeft;

        glider.style.setProperty('--glider-width', width + 'px');
        glider.style.setProperty('--glider-x', x + 'px');
    }

    async function loadTabContent(tabId) {
        if (loadedTabs.has(tabId)) return;
        const targetItem = sectionRoot.querySelector(`.tab-container-item[data-tab-id="${tabId}"]`);
        if (!targetItem) return;

        const tabIndex = tabId.replace('tabs-', '');
        targetItem.innerHTML = '<div class="tab-product-list-placeholder" aria-hidden="true"></div>';

        const url = `${sectionUrl}?section_id={{ section.id }}&tab_index=${encodeURIComponent(tabIndex)}`;
        const response = await fetch(url, { credentials: 'same-origin' });
        if (!response.ok) return;

        const html = await response.text();
        const wrapper = document.createElement('div');
        wrapper.innerHTML = html;

        const incomingSection = wrapper.querySelector('.tab-product-list-section .tab-container-item[data-tab-id="' + tabId + '"]');
        if (!incomingSection) return;

        targetItem.innerHTML = incomingSection.innerHTML;
        loadedTabs.add(tabId);

        if (window.initSwiper) {
            window.initSwiper(targetItem);
        }

        const productImages = targetItem.querySelectorAll('.product-main-image');
        productImages.forEach((img) => {
            const card = img.closest('.product-item');
            if (!card) return;
            card.querySelectorAll('.variant-color-item').forEach((swatch) => {
                swatch.addEventListener('click', () => {
                    const small = swatch.dataset.productImgSmall;
                    const large = swatch.dataset.productImg;
                    const alt = swatch.dataset.productAlt || img.alt;
                    if (small) img.src = small;
                    if (small && large) img.srcset = `${small} 400w, ${large} 800w`;
                    if (alt) img.alt = alt;
                    card.querySelectorAll('.variant-color-item').forEach((item) => item.classList.remove('active'));
                    swatch.classList.add('active');
                });
            });
        });
    }

    function bindCardEvents(scope) {
        scope.querySelectorAll('.product-item').forEach((card) => {
            const mainImage = card.querySelector('.product-main-image');
            const hoverImage = card.querySelector('.hover-image');
            if (!mainImage || card.dataset.cardBound === 'true') return;
            card.dataset.cardBound = 'true';

            if (hoverImage && hoverImage.dataset.hoverSrc && !hoverImage.getAttribute('src')) {
                const loadHoverImage = () => {
                    hoverImage.src = hoverImage.dataset.hoverSrc;
                    if (hoverImage.dataset.hoverSrcset) hoverImage.srcset = hoverImage.dataset.hoverSrcset;
                    if (hoverImage.dataset.hoverAlt) hoverImage.alt = hoverImage.dataset.hoverAlt;
                };

                card.addEventListener('mouseenter', loadHoverImage, { once: true });
                card.addEventListener('touchstart', loadHoverImage, { once: true, passive: true });
            }

            card.addEventListener('click', (event) => {
                const swatch = event.target.closest('.variant-color-item');
                if (!swatch || !card.contains(swatch)) return;

                const small = swatch.dataset.productImgSmall;
                const large = swatch.dataset.productImg;
                const alt = swatch.dataset.productAlt || mainImage.alt;

                if (small) mainImage.src = small;
                if (small && large) mainImage.srcset = `${small} 400w, ${large} 800w`;
                if (alt) mainImage.alt = alt;

                card.querySelectorAll('.variant-color-item').forEach((item) => item.classList.remove('active'));
                swatch.classList.add('active');
            });
        });
    }

    async function switchTabs() {
        const selectedRadio = this;
        const tabId = selectedRadio.dataset.tabId;

        tabItems.forEach(item => {
            item.style.display = 'none';
        });

        const selectedItem = Array.from(tabItems).find(item => item.dataset.tabId === tabId);
        if (selectedItem) {
            selectedItem.style.display = 'block';
            await loadTabContent(tabId);
            bindSwatchEvents(selectedItem);
        }

        moveGlider();
    }

    moveGlider();
    bindCardEvents(sectionRoot);

    radios.forEach(radio => {
        radio.addEventListener('change', switchTabs);
    });

    window.addEventListener('load', moveGlider);
    window.addEventListener('resize', moveGlider);
{% endjavascript %}

{% schema %}
{
    "class": "tab-product-list-section position-relative",
    "name": "Tab Product List",
    "limit": 1,
    "templates": ["index"],
    "settings": [
        {
            "type": "select",
            "id": "sale_badge_type",
            "label": "Sale Badge Type",
            "options": [
                {
                    "label": "Percentage",
                    "value": "discount"
                },
                {
                    "label": "Text Discount",
                    "value": "text_discount"
                }
            ],
            "default": "discount"
        }
    ],
    "max_blocks": 2,
    "blocks": [
        {
            "type": "tab",
            "name": "Tab",
            "settings": [
                {
                    "type": "text",
                    "id": "tab_label",
                    "label": "Tab Label"
                },
                {
                    "type": "collection",
                    "id":"collection",
                    "label": "Collection List",
                },
                {
                    "type": "number",
                    "id": "maximum_number_product_display",
                    "label": "Maximum Number Product Display",
                    "default": 20
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Tab Product List"
        }
    ]
}
{% endschema %}