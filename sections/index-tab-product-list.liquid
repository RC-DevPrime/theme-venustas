<div class="section-content">
    <div class="container">
        <div class="tabs mb-lg-5 mb-md-5 mb-sm-3" id="tabs-container">
            {% for block in section.blocks %}
                <input type="radio" name="tabs" id="tabs-{{ forloop.index }}" {% if forloop.index == 1 %}checked{% endif %} data-tab-id="tabs-{{ forloop.index }}">
                <label for="tabs-{{ forloop.index }}" class="tab">
                    <span class="pp-semibold body-lg d-lg-block d-md-block d-sm-none">
                        {{ block.settings.tab_label }}
                    </span>
                    <span class="pp-semibold body d-lg-none d-md-none d-sm-block">
                        {{ block.settings.tab_label }}
                    </span>
                </label>
            {% endfor %}
            <span class="glider"></span>
        </div>
    </div>

    {% for product in section.blocks %}
    <div class="tab-container-item" data-tab-id="tabs-{{ forloop.index }}" {% if forloop.index != 1 %} style="display:none" {% endif %} >
        <div class="container px-0">
            <div class="tab-product-list-slider position-relative overflow-hidden">
                <div class="swiper-wrapper">
                    {% for product in product.settings.collection.products limit: section.settings.maximum_number_product_display %}
                        <div class="swiper-slide">
                            {% render 'product-item', product: product, sale_badge_type: section.settings.sale_badge_type, badge_detail: true, section: section %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="primary-pagination swiper-pagination d-md-none"></div>
            <div class="float-nav d-lg-block d-md-block d-sm-none">
                <button type="button" class="owl-prev" disabled>
                    <i class="fa-solid fa-chevron-left f-white"></i>
                </button>
                <button type="button" class="owl-next" disabled>
                    <i class="fa-solid fa-chevron-right f-white"></i>
                </button>
            </div>
        </div>
    </div>
    {% endfor %}    
</div>
{% style %}
    .tab-product-list-section{
        /* opacity:0; */
    }
    .tab-product-list-section .tabs {
        display: flex;
        align-items: stretch;
        position: relative;
        padding: 0px;
        border-radius: 10px;
        background-color: #FFF;
        width: fit-content;
        max-width: 100%;
        margin: auto;
        border:1px solid #B93205;
        overflow:hidden;
    }

    .tab-product-list-section .tabs * {
        z-index: 2;
    }

    .tab-product-list-section input[type=radio] {
        display: none;
    }

    .tab-product-list-section input[type=radio]:checked + label {
        color: #F5F3F1;
    }

    .tab-product-list-section .tab {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: 1 1 auto;
        box-sizing: border-box;
        min-width:140px;
        min-height: 50px;
        padding: 0 25px;
        border-radius: 0;
        cursor: pointer;
        transition: color 0.15s ease-in;
        color:#B93205;
        text-align: center;
        overflow-wrap: anywhere;
    }

    .tab-product-list-section .glider {
        position: absolute;
        top: 0;
        display: flex;
        height: 100%;
        background-color:#B93205;
        z-index: 1;
        border-radius: 8px;
        transition: 0.25s ease-out;
        width: var(--glider-width, 0px);
        transform: translateX(var(--glider-x, 0px));
    }

    .tab-product-list-section .tab-container-item {
        position: relative;
    }

    .tab-product-list-section .tab-container-item > .container {
        position: relative;
    }

    .tab-product-list-section .variant-option-block {
        --card-swatch-size: 25px;
        --card-swatch-gap: 12px;
        --card-swatch-columns: 4;
    }

    .tab-product-list-section .variant-option-block .variant-colors {
        display: grid;
        grid-template-columns: repeat(var(--card-swatch-columns), var(--card-swatch-size));
        gap: var(--card-swatch-gap);
        align-items: center;
        width: fit-content;
    }

    .tab-product-list-section .variant-option-block .variant-colors.variant-colors-dropdown {
        width: auto;
    }

    .tab-product-list-section .variant-option-block .variant-colors.variant-colors-dropdown[style*="display: flex"] {
        display: grid !important;
    }

    .tab-product-list-section .variant-option-block .variant-color-item,
    .tab-product-list-section .variant-option-block .view-all-options-btn {
        width: var(--card-swatch-size);
        height: var(--card-swatch-size);
    }

    .tab-product-list-section .variant-option-block .view-all-options-btn {
        justify-content: center;
    }

    .tab-product-list-section .variant-option-block .variant-color-box {
        box-sizing: border-box;
        width: var(--card-swatch-size);
        height: var(--card-swatch-size);
        border: 1px solid rgba(255,255,255,.75);
        outline: 0;
        box-shadow: 0 0 0 1px rgba(0,0,0,.28), 1px 1px 5px #0003;
    }

    .tab-product-list-section .variant-option-block .on .variant-color-box {
        outline: 0;
        box-shadow: 0 0 0 2px #161616, inset 0 0 0 1px rgba(255,255,255,.65);
    }

    /*
     * Use the product-list container as the horizontal positioning boundary,
     * then compensate the global vertical centering against the image center.
     */
    .tab-product-list-section .tab-container-item > .container > .float-nav {
        transform:
            translate(-50%, -50%)
            translateY(var(--product-image-nav-offset, 0px));
    }

    .tab-product-list-section .tab-container-item > .container > .float-nav .owl-prev {
        left: 0;
        right: auto;
        transform: translate(-50%, -50%);
    }

    .tab-product-list-section .tab-container-item > .container > .float-nav .owl-next {
        right: 0;
        left: auto;
        transform: translate(50%, -50%);
    }

    .tab-product-list-section .float-nav button{
        background: #F1EADD;
    }
    .tab-product-list-section .float-nav button:hover{
        background: #B93205;
    }
    .tab-product-list-section .float-nav button:hover .fa-chevron-left:before,
    .tab-product-list-section .float-nav button:hover .fa-chevron-right:before{
        color: #FFF;
    }
    .tab-product-list-section .float-nav .fa-chevron-left:before,
    .tab-product-list-section .float-nav .fa-chevron-right:before{
        color: #B93205;
    }
      /* Prevent FOUC: match Swiper's final layout (width + spaceBetween) before JS initializes */
    .tab-product-list-section .tab-product-list-slider .swiper-wrapper {
        display: flex;
        flex-wrap: nowrap;
    }
    .tab-product-list-section .tab-product-list-slider .swiper-slide {
        height: auto;
        flex-shrink: 0;
        width: calc(25% - 11.25px); /* (100% - 3*15px) / 4 = 4 slides on desktop */
        margin-right: 15px; /* matches spaceBetween: 15 */
    }

    @media only screen and (max-width: 1023px) {
        .tab-product-list-section .tab-product-list-slider .swiper-slide {
          width: calc(50% - 7.5px); /* (100% - 1*15px) / 2 = 2 slides on tablet/mobile */
        }
    }

    @media only screen and (max-width: 767px) {
        .tab-product-list-section .variant-option-block {
            --card-swatch-size: 18px;
            --card-swatch-gap: 8px;
        }
    }

    @media only screen and (min-width: 768px) {
        .tab-product-list-section .variant-option-block {
            --card-swatch-size: 20px;
            --card-swatch-gap: 6px;
        }
    }

    @media only screen and (min-width: 1366px) {
        .tab-product-list-section .variant-option-block {
            --card-swatch-size: 22px;
            --card-swatch-gap: 8px;
        }
    }

    @media only screen and (min-width: 1536px) {
        .tab-product-list-section .variant-option-block {
            --card-swatch-size: 23px;
            --card-swatch-gap: 10px;
        }
    }

    @media only screen and (min-width: 1920px) {
        .tab-product-list-section .variant-option-block {
            --card-swatch-size: 25px;
            --card-swatch-gap: 12px;
        }
    }


    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .tab-product-list-section .tabs{
            border-radius:6px;
        }
        .tab-product-list-section .tab{
            min-width:105px;
            min-height:35px;
            padding:0px 16px;
        }
        .tab-product-list-section .glider{
            border-radius:6px;
        }
    }

