{% comment %}
  Section:Tech Intro Text
  File: sections/venustas-intro.liquid
  Design: Centered orange-red heading + dark body text on white background
{% endcomment %}

<section id="venustas-intro-{{ section.id }}" class="venustas-intro">
  <div class="venustas-intro__inner">

    {% if section.settings.heading != blank %}
      <h2 class="venustas-intro__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.body_text != blank %}
      <p class="venustas-intro__body">{{ section.settings.body_text }}</p>
    {% endif %}

  </div>
</section>

<style>
  #venustas-intro-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px;
  }

  #venustas-intro-{{ section.id }} .venustas-intro__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    text-align: center;
  }

  #venustas-intro-{{ section.id }} .venustas-intro__heading {
    font-size: clamp(24px, 3.5vw, 46px);
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    line-height: 1.15;
    margin: 0 0 {{ section.settings.heading_gap }}px;
    letter-spacing: -0.01em;
  }

  #venustas-intro-{{ section.id }} .venustas-intro__body {
    font-size: clamp(14px, 1.4vw, 18px);
    font-weight: 400;
    color: {{ section.settings.body_color }};
    line-height: 1.7;
    margin: 0;
    letter-spacing: 0.01em;
  }

  @media (max-width: 768px) {
    #venustas-intro-{{ section.id }} {
      padding: {{ section.settings.section_padding_top | times: 0.7 | round }}px 24px {{ section.settings.section_padding_bottom | times: 0.7 | round }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Tech Intro",
  "tag": "section",
  "class": "venustas-intro-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 480,
      "max": 1200,
      "step": 40,
      "default": 880,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "We Define Heated Apparel"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#CC3300"
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Gap between heading and body",
      "min": 8,
      "max": 60,
      "step": 4,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "With a vision to become the expert in heated apparel, we focus on delivering warmth in the simplest and most direct way — so you can feel it instantly, naturally, and comfortably."
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#1a1a1a"
    }
  ],
  "presets": [
    {
      "name": "Tech Intro",
      "settings": {
        "heading": "We Define Heated Apparel",
        "heading_color": "#CC3300",
        "body_text": "With a vision to become the expert in heated apparel, we focus on delivering warmth in the simplest and most direct way — so you can feel it instantly, naturally, and comfortably.",
        "body_color": "#1a1a1a",
        "bg_color": "#ffffff",
        "section_padding_top": 72,
        "section_padding_bottom": 72,
        "content_max_width": 880
      }
    }
  ]
}
{% endschema %}
