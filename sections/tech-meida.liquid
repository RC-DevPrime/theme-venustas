{% assign section_anchor = section.settings.anchor_id | default: 'tech-media-recommendations' | strip %}
<section id="{{ section_anchor | escape }}" class="venustas-tech-media-reco">
  <div class="venustas-tech-media-reco__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="venustas-tech-media-reco__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="venustas-tech-media-reco__slider" id="tech-media-reco-slider-{{ section.id }}">
      <button class="venustas-tech-media-reco__arrow venustas-tech-media-reco__arrow--prev" aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="venustas-tech-media-reco__viewport">
        <div class="venustas-tech-media-reco__track">
          {% for block in section.blocks %}
            {% assign card_title = block.settings.card_title | strip %}
            {% assign card_desc = block.settings.card_desc | strip %}
            {% assign card_logo = block.settings.card_logo %}
            {% assign card_link = block.settings.card_link %}
            {% if card_title != blank or card_desc != blank or card_logo != blank %}
              <article class="venustas-tech-media-reco__card" {{ block.shopify_attributes }}>
                {% if card_link != blank %}
                  <a href="{{ card_link }}" class="venustas-tech-media-reco__card-body" target="_blank" rel="noopener noreferrer">
                {% else %}
                  <div class="venustas-tech-media-reco__card-body">
                {% endif %}
                  {% if card_title != blank %}
                    <h3 class="venustas-tech-media-reco__card-title">{{ card_title }}</h3>
                  {% endif %}

                  {% if card_desc != blank %}
                    <p class="venustas-tech-media-reco__card-desc">{{ card_desc }}</p>
                  {% endif %}

                  <div class="venustas-tech-media-reco__card-footer">
                    {% if card_logo != blank %}
                      <img
                        class="venustas-tech-media-reco__card-logo"
                        src="{{ card_logo | image_url: width: 360 }}"
                        srcset="
                          {{ card_logo | image_url: width: 180 }} 180w,
                          {{ card_logo | image_url: width: 260 }} 260w,
                          {{ card_logo | image_url: width: 360 }} 360w
                        "
                        sizes="(max-width: 768px) 45vw, 220px"
                        alt="{{ card_title | escape }}"
                        loading="lazy"
                      >
                    {% endif %}
                  </div>
                {% if card_link != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <button class="venustas-tech-media-reco__arrow venustas-tech-media-reco__arrow--next" aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  #{{ section_anchor | escape }} {
    --bg-color: {{ section.settings.bg_color }};
    --heading-color: {{ section.settings.heading_color }};
    --card-bg: {{ section.settings.card_bg_color }};
    --title-color: {{ section.settings.card_title_color }};
    --desc-color: {{ section.settings.card_desc_color }};
    --arrow-bg: {{ section.settings.arrow_bg_color }};
    --arrow-color: {{ section.settings.arrow_color }};
    --arrow-hover-bg: {{ section.settings.arrow_hover_bg_color }};
    --arrow-hover-color: {{ section.settings.arrow_hover_color }};

    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --content-width: {{ section.settings.content_width_percent }}%;
    --heading-size: {{ section.settings.heading_size }}px;
    --title-size: {{ section.settings.card_title_size }}px;
    --desc-size: {{ section.settings.card_desc_size }}px;
    --card-radius: {{ section.settings.card_radius }}px;
    --card-gap: {{ section.settings.card_gap }}px;
    --card-min-height: {{ section.settings.card_min_height }}px;
    --desktop-card-width: {{ section.settings.desktop_card_width_percent }}%;
    --logo-bottom-offset: {{ section.settings.logo_bottom_offset }}px;
    --logo-area-height: 38px;
  }

  #{{ section_anchor | escape }} {
    background: var(--bg-color);
    padding: var(--pt) 0 var(--pb);
    overflow: hidden;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__inner {
    width: var(--content-width);
    max-width: 1600px;
    margin: 0 auto;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__heading {
    margin: 0 0 30px;
    text-align: center;
    color: var(--heading-color);
    font-size: var(--heading-size);
    line-height: 1.18;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__slider {
    position: relative;
    padding: 4px 0;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__viewport {
    overflow: hidden;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__track {
    display: flex;
    gap: var(--card-gap);
    padding-left: calc((100% - var(--desktop-card-width)) / 2);
    padding-right: calc((100% - var(--desktop-card-width)) / 2);
    transition: transform .45s ease;
    will-change: transform;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__card {
    flex: 0 0 var(--desktop-card-width);
    min-width: 0;
    border-radius: var(--card-radius);
    background: var(--card-bg);
    position: relative;
    box-sizing: border-box;
    text-align: center;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__card-body {
    min-height: var(--card-min-height);
    padding: 30px 24px calc(var(--logo-area-height) + var(--logo-bottom-offset) + 10px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    border-radius: inherit;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    font-style: inherit;
    line-height: inherit;
  }

  #{{ section_anchor | escape }} a.venustas-tech-media-reco__card-body {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    font-style: inherit;
    line-height: inherit;
  }

  #{{ section_anchor | escape }} a.venustas-tech-media-reco__card-body:focus-visible {
    outline: 2px solid var(--title-color);
    outline-offset: 3px;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__card-title {
    margin: 0 0 16px;
    color: var(--title-color);
    font-family: inherit;
    font-size: var(--title-size);
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__card-desc {
    margin: 0;
    color: var(--desc-color);
    font-family: inherit;
    font-size: var(--desc-size);
    line-height: 1.35;
    letter-spacing:-0.01em;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__card-footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--logo-bottom-offset);
    min-height: var(--logo-area-height);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 14px;
    box-sizing: border-box;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__card-logo {
    max-width: 80%;
    max-height: 36px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 0;
    background: var(--arrow-bg);
    color: var(--arrow-color);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    padding: 0;
    transition: background-color .25s ease, color .25s ease;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__arrow svg {
    width: 22px;
    height: 22px;
    transition: color .25s ease;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__arrow:hover:not(:disabled) {
    background: var(--arrow-hover-bg);
    color: var(--arrow-hover-color);
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__arrow:disabled {
    opacity: .45;
    cursor: not-allowed;
  }

  #{{ section_anchor | escape }} .venustas-tech-media-reco__arrow--prev { left: -28px; }
  #{{ section_anchor | escape }} .venustas-tech-media-reco__arrow--next { right: -28px; }

  @media (max-width: 1100px) {
    #{{ section_anchor | escape }} {
      --desktop-card-width: {{ section.settings.tablet_card_width_percent }}%;
    }

    #{{ section_anchor | escape }} .venustas-tech-media-reco__card {
      flex-basis: var(--desktop-card-width);
    }
  }

  @media (max-width: 768px) {
    #{{ section_anchor | escape }} {
      --pt: {{ section.settings.mobile_padding_top }}px;
      --pb: {{ section.settings.mobile_padding_bottom }}px;
      --content-width: {{ section.settings.mobile_content_width_percent }}%;
      --heading-size: {{ section.settings.mobile_heading_size }}px;
      --title-size: {{ section.settings.mobile_card_title_size }}px;
      --desc-size: {{ section.settings.mobile_card_desc_size }}px;
      --card-gap: {{ section.settings.mobile_card_gap }}px;
      --card-min-height: {{ section.settings.mobile_card_min_height }}px;
      --logo-bottom-offset: {{ section.settings.mobile_logo_bottom_offset }}px;
    }

    #{{ section_anchor | escape }} .venustas-tech-media-reco__heading {
      margin-bottom: 18px;
    }

    #{{ section_anchor | escape }} .venustas-tech-media-reco__card {
      flex-basis: 100%;
      border-radius: 10px;
    }

    #{{ section_anchor | escape }} .venustas-tech-media-reco__card-body {
      padding: 20px 16px 14px;
    }

    #{{ section_anchor | escape }} .venustas-tech-media-reco__track {
      padding-left: 0;
      padding-right: 0;
    }

    #{{ section_anchor | escape }} .venustas-tech-media-reco__arrow {
      width: 42px;
      height: 42px;
    }

    #{{ section_anchor | escape }} .venustas-tech-media-reco__arrow--prev { left: 6px; }
    #{{ section_anchor | escape }} .venustas-tech-media-reco__arrow--next { right: 6px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('tech-media-reco-slider-{{ section.id }}');
    if (!root) return;

    var track = root.querySelector('.venustas-tech-media-reco__track');
    var viewport = root.querySelector('.venustas-tech-media-reco__viewport');
    var prev = root.querySelector('.venustas-tech-media-reco__arrow--prev');
    var next = root.querySelector('.venustas-tech-media-reco__arrow--next');
    if (!track || !viewport || !prev || !next) return;

    var index = 0;
    var timer = null;
    var INTERVAL = {{ section.settings.autoplay_interval }} * 1000;
    var cloned = false;
    var transitioning = false;

    function cards() {
      return Array.prototype.slice.call(track.querySelectorAll('.venustas-tech-media-reco__card'));
    }

    function realCards() {
      return cards().filter(function (card) {
        return !card.classList.contains('venustas-tech-media-reco__card--clone');
      });
    }

    function maxIndex() {
      return cards().length - 1;
    }

    function setupInfinite() {
      if (cloned) return;
      var original = cards();
      if (original.length <= 1) return;
      var firstClone = original[0].cloneNode(true);
      var lastClone = original[original.length - 1].cloneNode(true);
      firstClone.classList.add('venustas-tech-media-reco__card--clone');
      lastClone.classList.add('venustas-tech-media-reco__card--clone');
      track.insertBefore(lastClone, original[0]);
      track.appendChild(firstClone);
      cloned = true;
    }

    function translateFor(i) {
      var list = cards();
      if (!list.length) return 0;
      var current = list[i];
      if (!current) return 0;
      var cardWidth = current.getBoundingClientRect().width;
      var viewportWidth = viewport.getBoundingClientRect().width;
      return current.offsetLeft - ((viewportWidth - cardWidth) / 2);
    }

    function setPosition(i, noTransition) {
      if (noTransition) {
        track.style.transition = 'none';
      } else {
        track.style.transition = 'transform .45s ease';
      }
      track.style.transform = 'translateX(-' + translateFor(i) + 'px)';
      if (noTransition) {
        track.offsetHeight;
        track.style.transition = 'transform .45s ease';
      }
    }

    function update() {
      var real = realCards();
      if (!real.length) {
        prev.style.display = 'none';
        next.style.display = 'none';
        return;
      }

      var hide = real.length <= 1;
      prev.style.display = hide ? 'none' : 'inline-flex';
      next.style.display = hide ? 'none' : 'inline-flex';
      prev.disabled = hide;
      next.disabled = hide;

      if (hide) {
        index = 0;
        setPosition(index, true);
        return;
      }

      if (!cloned) {
        setupInfinite();
        index = 1;
        setPosition(index, true);
      } else {
        var max = maxIndex();
        if (index < 0) index = 0;
        if (index > max) index = max;
        setPosition(index, true);
      }
    }

    function nextSlide() {
      if (transitioning || realCards().length <= 1) return;
      transitioning = true;
      index += 1;
      setPosition(index, false);
    }

    function stopAuto() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function startAuto() {
      stopAuto();
      if (!{{ section.settings.enable_autoplay | json }}) return;
      timer = setInterval(nextSlide, INTERVAL);
    }

    prev.addEventListener('click', function () {
      if (transitioning || realCards().length <= 1) return;
      transitioning = true;
      index -= 1;
      setPosition(index, false);
      startAuto();
    });

    next.addEventListener('click', function () {
      nextSlide();
      startAuto();
    });

    track.addEventListener('transitionend', function () {
      if (!cloned) {
        transitioning = false;
        return;
      }
      var list = cards();
      var lastRealIndex = list.length - 2;
      if (index === list.length - 1) {
        index = 1;
        setPosition(index, true);
      } else if (index === 0) {
        index = lastRealIndex;
        setPosition(index, true);
      }
      transitioning = false;
    });

    root.addEventListener('mouseenter', stopAuto);
    root.addEventListener('mouseleave', startAuto);
    window.addEventListener('resize', function () {
      update();
      startAuto();
    });

    update();
    startAuto();
  })();
</script>

