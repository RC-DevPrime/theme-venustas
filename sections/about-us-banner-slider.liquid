{% style %}
.about-us-banner-slider-section {
  position: relative;
  width: 100%;
  height: calc(100vh * {{ section.blocks.size }}); /* keep this as is */
}

.about-us-banner-slider-section .sticky-slider {
  position: sticky;
  top: 0;
  height: 100vh; /* will be updated by JS */
  overflow: hidden;
}

.about-us-banner-slider-section .main-banner-slider-container {
  width: 100%;
  height: 100%;
}

.about-us-banner-slider-section .main-banner-slider-container .banner-item {
  height: 100vh; /* will be updated by JS */
  position:relative;
}
.about-us-banner-slider-section .main-banner-slider-container .banner-item .banner-content{
    position:absolute;
    top:0;
    height:100%;
    width:100%;
}

.about-us-banner-slider-section .main-banner-slider-container .banner-item .bg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.about-us-banner-slider-section .main-banner-slider-container .banner-item .block-content-container{
    transform: translateY(12vh);
    transition: all 0.3s linear 0.2s;
    opacity:0.3;
}
.about-us-banner-slider-section .main-banner-slider-container .banner-item.swiper-slide-active .block-content-container{
    transform: translateY(0);
    opacity:1;
}
{% endstyle %}

<div class="sticky-slider">
  <div class="swiper main-banner-slider-container">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="banner-item swiper-slide
          
          {% if block.settings.nav_title != blank %} about-us-section-scroll
          {% else %}
            {% if block.settings.enabled_section_child_scroll %} about-us-section-scroll
            {% endif -%}
          {% endif %}" 

          {% if block.settings.nav_title != blank %}
              data-scroll="{{ block.settings.nav_title | handleize }}"
          {% endif %} 
          {% if block.settings.enabled_section_child_scroll %}
              data-child-scroll="{{ block.settings.section_scroll_nav | handleize }}"
          {% endif %}>

          <img
            src="{{ block.settings.background_image | img_url: 'master' }}"
            alt="{{ block.settings.background_image.alt }}"
            class="bg-image d-lg-block d-md-block d-sm-none"
            width="100%"
            height="100%"
          >
          <img
            src="{{ block.settings.background_image_mobile | img_url: 'master' }}"
            alt="{{ block.settings.background_image_mobile.alt }}"
            class="bg-image d-lg-none d-md-none d-sm-block"
            width="100%"
            height="100%"
          >

          <div class="banner-content">
              <div class="container section-content h-100">
                  <div class="d-flex flex-column h-100 justify-content-lg-center justify-content-md-center justify-content-sm-start pt-lg-0 pt-md-0 pt-sm-2">
                      <div class="overflow-hidden col-lg-6 col-md-6 col-sm-12 py-lg-5 py-md-5 py-sm-4">
                          <div class="block-content-container">
                              <div class="block-heading pp-bold f-white pb-lg-3 pb-md-3 pb-sm-2">
                                <span class="title-md d-lg-block d-md-block d-sm-none">
                                  {{ block.settings.heading }}
                                </span>
                                <span class="title-sm d-lg-none d-md-none d-sm-block text-center">
                                  {{ block.settings.heading }}
                                </span>
                              </div>
                              <div class="block-description pp-regular f-white">
                                <span class="body-xl fd-lg-block d-md-block d-sm-none">
                                  {{ block.settings.description }}
                                </span>
                                <span class="body d-lg-none d-md-none d-sm-block text-center col-11 mx-auto">
                                  {{ block.settings.description }}
                                </span>
                              </div>
                          </div>
                      </div>
                  </div>
              </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}
    {
        "class": "about-us-banner-slider-section",
        "name": "Banner Slider",
        "templates": ["page"],
        "limit": 1, 
        "max_blocks": 7,
        "blocks": [
            {
              "type": "Banner",
              "name":"Banner",
              "settings": [
                    {
                        "type": "checkbox",
                        "id": "enabled_section_child_scroll",
                        "label": "Enabled Section Child Scroll"
                    },
                    {
                        "type": "text",
                        "id": "section_scroll_nav",
                        "label": "Section Scroll Nav",
                        "info": "Need to Enabled first Section Scroll"
                    },
                    {
                        "type": "text",
                        "id": "nav_title",
                        "label": "Navigation Title"
                    },
                    {
                        "type": "image_picker",
                        "id": "background_image",
                        "label": "Background Image"
                    },
                    {
                        "type": "image_picker",
                        "id": "background_image_mobile",
                        "label": "Background Image - Mobile"
                    },
                    {
                        "type": "text",
                        "id": "heading",
                        "label": "Heading"
                    },
                    {
                        "type": "richtext",
                        "id": "description",
                        "label": "Description"
                    }
              ]
            }
        ],
        "presets" :[{
            "name" : "Banner Slider"
        }]
    }
  {% endschema %} 