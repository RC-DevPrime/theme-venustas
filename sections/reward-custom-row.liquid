{% style %}
    .reward-custom-row-section{
    }
    .reward-custom-row-section .block-description ul{
        padding:0px 25px;
    }
    .reward-custom-row-section .block-description ul li{
        margin-bottom:1rem;
    }
    .reward-custom-row-section .row{
        --bs-gutter-x: 70px;
    }
    .reward-custom-row-section .row-layout-item:not(:last-child) {
        padding-bottom:80px;
    }
    .reward-custom-row-section .image-container{
        height:450px;
        border-radius:16px;
        overflow:hidden;
    }
    .reward-custom-row-section .image-container img{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .reward-custom-row-section .icon-col-1{
        width:55%;
    }
    .reward-custom-row-section .icon-col-2{
        width:45%;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .reward-custom-row-section .row{
            --bs-gutter-x: 0px;
        }
        .reward-custom-row-section .block-description ul{
            padding:0px 20px;
        }
        .reward-custom-row-section .block-description ul li::marker {
            color: #B93205;
        }
        .row-layout-item:not(:last-child) {
            padding-bottom:30px;
        }
        .reward-custom-row-section .icon-col-1,
        .reward-custom-row-section .icon-col-2{
            width:100%;
        }
        .reward-custom-row-section .image-container{
            height:250px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content">
    {% for block in section.blocks %}
        {% if block.type == 'right_content' %}
            <div class="row-layout-item" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="{{ forloop.index }}50" data-aos-duration="500">
                <div class="row justify-content-center align-items-center">
                    <div class="icon-col-1">
                        <h4 class="block-heading pp-bold title-sm f-black pb-4 text-center d-lg-none d-md-none d-sm-block px-lg-0 px-md-0 px-sm-4">
                            {{ block.settings.heading }}
                        </h4>
                        <div class="image-container">
                            <img src="{{ block.settings.image | img_url: 'master' }}" width="100%" height="100%">
                        </div>
                    </div>
                    <div class="icon-col-2">
                        <div class="content-container col-lg-11 col-md-11 col-sm-12 mx-auto d-lg-flex d-md-flex d-sm-flex flex-column align-items-lg-start align-items-md-start align-items-sm-center">
                            <h4 class="block-heading pp-bold title-sm f-black pb-3 d-lg-block d-md-block d-sm-none">
                                {{ block.settings.heading }}
                            </h4>
                            <div class="block-description pp-regular f-black-gray body-xl mt-lg-0 mt-md-0 mt-sm-3">
                                <div class="body-xl d-lg-block d-md-block d-sm-none">
                                    {{ block.settings.description }}
                                </div>
                                <div class="body d-lg-none d-md-none d-sm-block">
                                    {{ block.settings.description }}
                                </div>
                            </div>
                            {% if block.settings.btn_label != blank %}
                                <a href="javascript:void(0)" class="icon-gift btn-hover btn-main mt-lg-3 mt-md-3 mt-sm-2 d-lg-block d-md-block d-sm-none">
                                    <span class="pp-regular body f-white">
                                        {{ block.settings.btn_label }}
                                    </span>
                                </a>
                            {% endif %}
                            {% if block.settings.btn_label != blank %}
                                <a href="javascript:void(0)" class="icon-gift btn-hover btn-main mt-lg-3 mt-md-3 mt-sm-2 d-lg-none d-md-none d-sm-block py-2 px-3">
                                    <span class="pp-regular body f-white">
                                        {{ block.settings.btn_label }}
                                    </span>
                                </a>
                            {% endif %}
                        </div>
                    </div>

                </div>
            </div>
        {% else %}
            <div class="row-layout-item" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="{{ forloop.index }}50" data-aos-duration="500">
                <div class="row justify-content-center align-items-center">
                    <div class="icon-col-2">
                        <div class="col-lg-10 col-md-10 col-sm-12">
                            <div class="content-container col-lg-11 col-md-11 col-sm-12 mx-auto d-lg-flex d-md-flex d-sm-flex flex-column align-items-lg-start align-items-md-start align-items-sm-center">
                                <div class="block-heading pp-bold title-sm f-black pb-3 text-lg-start text-md-start text-sm-center">
                                    <span class="title-sm ">
                                        {{ block.settings.heading }}
                                    </span>
                                </div>
                                <div class="block-description pp-regular f-black-gray text-lg-start text-md-start text-sm-center pb-lg-0 pb-md-0 pb-sm-4  d-lg-block d-md-block d-sm-none">
                                    <span class="body-lg">
                                        {{ block.settings.description }}
                                    </span>
                                </div>
                                {% if block.settings.btn_label != blank %}
                                    <a href="javascript:void(0)" class="icon-gift btn-hover btn-main mt-lg-3 mt-md-3 mt-sm-2  d-lg-block d-md-block d-sm-none">
                                        <span class="pp-regular body f-white">
                                            {{ block.settings.btn_label }}
                                        </span>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="icon-col-1">
                        <div class="image-container mb-lg-0 mb-md-0 mb-sm-3">
                            <img src="{{ block.settings.image | img_url: 'master' }}" width="100%" height="100%">
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <div class="block-description pp-regular f-black-gray text-lg-start text-md-start text-sm-center pb-2 d-lg-none d-md-none d-sm-block">
                                <span class="body">
                                    {{ block.settings.description }}
                                </span>
                            </div>
                            {% if block.settings.btn_label != blank %}
                                <a href="javascript:void(0)" class="icon-gift btn-hover btn-main d-lg-none d-md-none d-sm-block py-1 px-3">
                                    <span class="pp-regular body f-white">
                                        {{ block.settings.btn_label }}
                                    </span>
                                </a>
                            {% endif %}
                        </div>
                    </div>

                </div>
            </div>
        {% endif %}
    {% endfor %}
</div>
{% schema %}
{
    "class": "reward-custom-row-section",
    "name": "Reward Custom Row",
    "limit": 1,
    "templates": ["page"],
    "blocks": [
        {
            "type": "right_content",
            "name": "Right Content",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "richtext",
                    "id": "description",
                    "label": "Description"
                },
                {
                    "type": "text",
                    "id": "btn_label",
                    "label": "Button Label",
                    "default": "Ways To Earn"
                },
                {
                    "type": "url",
                    "id": "btn_link",
                    "label": "Button Link"
                }
            ]   
        },
        {
            "type": "left_content",
            "name": "Left Content",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "richtext",
                    "id": "description",
                    "label": "Description"
                },
                {
                    "type": "text",
                    "id": "btn_label",
                    "label": "Button Label",
                    "default": "Ways To Redeem"
                },
                {
                    "type": "url",
                    "id": "btn_link",
                    "label": "Button Link"
                }
            ]   
        }
    ],
    "presets": [
        {
            "name": "Reward Custom Row"
        }
    ]
}
{% endschema %}