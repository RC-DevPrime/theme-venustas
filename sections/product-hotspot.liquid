{% style %}
    .product-hotspot-section{
        background-color: #1C1C1C;
        background-image:url({{ section.settings.background_image | img_url: 'master' }});
        background-size:cover;
    }
    .product-hotspot-section .hotspot-element{
        height:fit-content;
        width: fit-content;
        margin: auto;
        position:relative;
        z-index:1;
    }
    .product-hotspot-section .hotspot-element img{
        width:100%;
        height:600px;
        object-fit:contain;
    }
    .product-hotspot-section .hotspot-element .inner-container{
        position:relative;
    }
    .product-hotspot-section .hotspot-element .spot{
        position: absolute;
        background: #FFF;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        overflow: visible;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor:pointer;
        z-index: 7;
    }
    .product-hotspot-section .hotspot-element .spot.is-active{
        z-index: 10;
    }
    .product-hotspot-section .hotspot-element .spot::after{
        content: "";
        position: absolute;
        inset: 0;
        background: transparent;
        border-radius: 50%;
        z-index: 0;
    }
    .product-hotspot-section .hotspot-element .spot:before{
        content: "";
        position: absolute;
        width: 18px;
        height: 18px;
        border: 4px solid #FFF;
        border-radius: 50%;
        opacity: .5;
        animation: pulse-wave 1.5s infinite;
        z-index: 1;
    }
    @keyframes pulse-wave {
        0% {
            transform: scale(1);
            opacity: 0.8;
        }
        100% {
            transform: scale(1.8);
            opacity: 0.5;
        }
    }
    .product-hotspot-section .bottom-content-container{
        position:relative;
        top:-50px;
        width:100%;
        opacity:0;
        transform: translateY(50%);
        transition: opacity 0.4s ease 0.4s, transform 0.7s ease 0.4s;
    }
    .product-hotspot-section.animate .bottom-content-container{
        opacity:1;
        transform: translateY(0);
    }
    .product-hotspot-section .bottom-content-container.show{
        opacity:1;
        transform: translateY(0);
    }
    
    .product-hotspot-section .hotspot-video-image-slider,
    .product-hotspot-section .hotspot-content-slider{
        height:300px;
        overflow:hidden;
    }
    .product-hotspot-section .hotspot-video-image-slider video,
    .product-hotspot-section .hotspot-video-image-slider img{
        height:100%;
        width:100%;
        object-fit:contain;
    }
    .product-hotspot-section .sub-pagination{
        background: #262626;
        border-radius:2px;
        padding:5px 1.5rem;
        width:fit-content;
        color:#FFF;
    }
    .product-hotspot-section .content-item-hotspot{
        position: absolute;
        width: 320px;
        max-width: calc(100vw - 32px);
        background: #111;
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 14px;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        box-shadow: 0 18px 40px rgba(0,0,0,.32);
        z-index: 8;
        transition: opacity 0.25s ease, visibility 0.25s ease;
    }
    .product-hotspot-section .content-item-hotspot.is-open{
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }
    .product-hotspot-section .content-item-hotspot.popup-bottom::before,
    .product-hotspot-section .content-item-hotspot.popup-top::before,
    .product-hotspot-section .content-item-hotspot.popup-left::before,
    .product-hotspot-section .content-item-hotspot.popup-right::before{
        content: "";
        position: absolute;
        width: 16px;
        height: 16px;
        background: #111;
        z-index: 1;
    }
    .product-hotspot-section .content-item-hotspot.popup-bottom::before{
        top: -8px;
        left: 50%;
        border-top: 1px solid rgba(255,255,255,.14);
        border-left: 1px solid rgba(255,255,255,.14);
        transform: translateX(-50%) rotate(45deg);
    }
    .product-hotspot-section .content-item-hotspot.popup-top::before{
        bottom: -8px;
        left: 50%;
        border-right: 1px solid rgba(255,255,255,.14);
        border-bottom: 1px solid rgba(255,255,255,.14);
        transform: translateX(-50%) rotate(45deg);
    }
    .product-hotspot-section .content-item-hotspot.popup-left::before{
        right: -8px;
        top: 50%;
        border-top: 1px solid rgba(255,255,255,.14);
        border-right: 1px solid rgba(255,255,255,.14);
        transform: translateY(-50%) rotate(45deg);
    }
    .product-hotspot-section .content-item-hotspot.popup-right::before{
        left: -8px;
        top: 50%;
        border-left: 1px solid rgba(255,255,255,.14);
        border-bottom: 1px solid rgba(255,255,255,.14);
        transform: translateY(-50%) rotate(45deg);
    }
    .product-hotspot-section .content-item-hotspot .hotspot-media{
        width: 100%;
        height: 220px;
        background: #000;
        position: relative;
        z-index: 2;
    }
    .product-hotspot-section .content-item-hotspot .hotspot-media img,
    .product-hotspot-section .content-item-hotspot .hotspot-media video{
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }
    .product-hotspot-section .content-item-hotspot .hotspot-copy{
        padding: 18px 18px 20px;
        background: #111;
        position: relative;
        z-index: 2;
    }
    .product-hotspot-section .content-item-hotspot .hotspot-copy .block-heading{
        margin-bottom: 10px;
    }
    .product-hotspot-section .hotspot-popup-close{
        position: absolute;
        top: 10px;
        right: 10px;
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 50%;
        background: rgba(17,17,17,.78);
        color: #FFF;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        line-height: 1;
        cursor: pointer;
        padding: 0;
        z-index: 3;
    }
    .product-hotspot-section .hotspot-popup-templates{
        display:none !important;
    }
    .product-hotspot-section.popup-mode .bottom-content-container{
        display:none;
    }
    @media only screen and (min-width: 992px) {
        .product-hotspot-section .hotspot-element .spot{
            width: 20px;
            height: 20px;
            margin-left: 0;
            margin-top: 0;
        }
        .product-hotspot-section .hotspot-element .spot::after{
            width: 50px;
            height: 50px;
            inset: 50% auto auto 50%;
            transform: translate(-50%, -50%);
        }
        .product-hotspot-section .hotspot-element .spot::before{
            width: 18px;
            height: 18px;
            inset: 50% auto auto 50%;
            transform: translate(-50%, -50%);
        }
        @keyframes pulse-wave {
            0% {
                transform: translate(-50%, -50%) scale(1);
                opacity: 0.8;
            }
            100% {
                transform: translate(-50%, -50%) scale(1.8);
                opacity: 0.5;
            }
        }
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 991px) {
        .product-hotspot-section .hotspot-element .inner-container,
        .product-hotspot-section .hotspot-element img{
            height:400px;
        }
        .product-hotspot-section{
            height:fit-content;
            max-height:fit-content;
        }
        .product-hotspot-section .bottom-content-container{
            position:unset;
            opacity: 1;
            transform: unset;
        }
        .product-hotspot-section .hotspot-video-image-slider, .product-hotspot-section .hotspot-content-slider{
            height:250px;
        }
        .product-hotspot-section .hotspot-element{
            margin:0;
        }
        .product-hotspot-section .hotspot-content-slider{
            touch-action:unset;
        }
        .product-hotspot-section .content-item-hotspot{
            width: min(320px, calc(100vw - 32px));
            max-width: calc(100vw - 32px);
        }
        .product-hotspot-section .content-item-hotspot .hotspot-media{
            height: min(42vw, 210px);
        }
        .product-hotspot-section .content-item-hotspot .hotspot-copy{
            padding: 12px 12px 14px;
        }
        .product-hotspot-section .content-item-hotspot .hotspot-copy .block-heading{
            margin-bottom: 8px;
            font-size: 20px;
            line-height: 1.2;
        }
        .product-hotspot-section .content-item-hotspot .hotspot-copy .block-description{
            font-size: 14px;
            line-height: 1.45;
        }
    }

