{% schema %}
{
  "name": "Rider Advantage",
  "tag": "section",
  "class": "motorheating-rider-advantage-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_desktop",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "bg_mobile",
      "label": "Mobile background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Main title",
      "default": "OUR ADVANTAGE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Subtitle",
      "default": "WHY VENUSTAS BUILT FOR MODERN RIDERS"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Venustas started with a simple mission: keep people warm. Today, we bring years of heated apparel expertise to motorcycle riders with gear engineered for the ride, not just the cold.</p>"
    }
  ],
  "presets": [
    {
      "name": "Rider Advantage"
    }
  ]
}
{% endschema %}
