{% style %}
  #shopify-section-{{ section.id }} .motorheating-rider-advantage {
    position: relative;
    width: 100%;
    aspect-ratio: 1440 / 548;
    min-height: 520px;
    overflow: hidden;
    background: #191919;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__bg--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__inner {
    position: relative;
    z-index: 1;
    width: min(100% - 40px, 1200px);
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__eyebrow {
    margin: 0 0 14px;
    color: var(--color-brand);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__title {
    margin: 0;
    max-width: 500px;
    color: #fff;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__description {
    margin: 36px 0 34px;
    max-width: 600px;
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__cards {
    display: grid;
    grid-template-columns: repeat(4, 282px);
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__card {
    width: 282px;
    height: 220px;
    padding: 21px 14px 20px;
    box-sizing: border-box;
    border-radius: 8px;
    background: rgba(217, 217, 217, 0.08);
    color: var(--color-brand);
    text-align: left;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__icon {
    width: 1em;
    height: 1em;
    margin: 0 0 18px 0;
    color: inherit;
    font-size: 48px;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__card-title {
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    height:40px;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-rider-advantage__card-text {
    margin: 0;
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: 0;
  }

  @media only screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .motorheating-rider-advantage {
      aspect-ratio: 390 / 764;
      max-height: 764px;
    }

    #shopify-section-{{ section.id }} .motorheating-rider-advantage__bg--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .motorheating-rider-advantage__bg--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .motorheating-rider-advantage__inner {
      width: 100%;
      padding: 54px 20px 20px;
      box-sizing: border-box;
      justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .motorheating-rider-advantage__eyebrow {
      margin-bottom: 10px;
      font-size: 12px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .motorheating-rider-advantage__title {
      max-width: 320px;
      font-size: 24px;
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .motorheating-rider-advantage__description {
      margin: 14px 0 64px;
      max-width: 320px;
      font-size: 16px;
      line-height: 1.22;
    }

    #shopify-section-{{ section.id }} .motorheating-rider-advantage__cards {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .motorheating-rider-advantage__card {
      width: auto;
      min-height: 140px;
      height: auto;
      padding: 18px 8px 16px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .motorheating-rider-advantage__icon {
      margin:0 auto 16px;
      font-size: 48px;
    }

    #shopify-section-{{ section.id }} .motorheating-rider-advantage__card-title {
      margin-bottom: 8px;
      font-size: 17px;
      line-height: 1.12;
    }

    #shopify-section-{{ section.id }} .motorheating-rider-advantage__card-text {
      font-size: 12px;
      line-height: 1.18;
    }
  }
{% endstyle %}

<section class="motorheating-rider-advantage">
  {%- if section.settings.bg_desktop != blank -%}
    {{
      section.settings.bg_desktop
      | image_url: width: 2880
      | image_tag:
        class: 'motorheating-rider-advantage__bg motorheating-rider-advantage__bg--desktop',
        loading: 'lazy',
        widths: '720,960,1200,1440,1800,2400,2880',
        sizes: '100vw',
        alt: section.settings.bg_desktop.alt | default: section.settings.title
    }}
  {%- endif -%}

  {%- if section.settings.bg_mobile != blank -%}
    {{
      section.settings.bg_mobile
      | image_url: width: 900
      | image_tag:
        class: 'motorheating-rider-advantage__bg motorheating-rider-advantage__bg--mobile',
        loading: 'lazy',
        widths: '390,600,780,900',
        sizes: '100vw',
        alt: section.settings.bg_mobile.alt | default: section.settings.title
    }}
  {%- elsif section.settings.bg_desktop != blank -%}
    {{
      section.settings.bg_desktop
      | image_url: width: 900
      | image_tag:
        class: 'motorheating-rider-advantage__bg motorheating-rider-advantage__bg--mobile',
        loading: 'lazy',
        widths: '390,600,780,900',
        sizes: '100vw',
        alt: section.settings.bg_desktop.alt | default: section.settings.title
    }}
  {%- endif -%}

  <div class="motorheating-rider-advantage__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="motorheating-rider-advantage__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="motorheating-rider-advantage__title">{{ section.settings.title }}</h2>
