{% style %}
    
    .product-recommendation-section {
        position:relative;
    }
    /* The arrows are measured against this box, so it has to be their containing
       block instead of the full-bleed section. */
    .product-recommendation-section .product-recommendations {
        position:relative;
    }
    .product-recommendation-section .float-nav button{
        background: #F1EADD;
    }
    .product-recommendation-section .float-nav button:hover{
        background: #B93205;
    }
    .product-recommendation-section .float-nav button:hover .fa-chevron-left:before,
    .product-recommendation-section .float-nav button:hover .fa-chevron-right:before{
        color: #FFF;
    }
    .product-recommendation-section .float-nav .fa-chevron-left:before,
    .product-recommendation-section .float-nav .fa-chevron-right:before{
        color: #B93205;
    }

    /*
     * Pin the arrows to the slider's left/right edges and ride the product
     * image's vertical centre, which the script measures into
     * --product-image-nav-offset. Same approach as index-tab-product-list.
     */
    .product-recommendation-section .product-recommendations > .float-nav {
        transform: translate(-50%, -50%) translateY(var(--product-image-nav-offset, 0px));
    }
    .product-recommendation-section .product-recommendations > .float-nav .owl-prev {
        left: 0;
        right: auto;
        transform: translate(-50%, -50%);
    }
    .product-recommendation-section .product-recommendations > .float-nav .owl-next {
        right: 0;
        left: auto;
        transform: translate(50%, -50%);
    }
    /* Every product already fits the viewport, so there is nothing to page to. */
    .product-recommendation-section .product-recommendations > .float-nav.is-nav-hidden {
        display: none;
    }

    .product-recommendation-section .tab-product-list-slider .swiper-slide{
        height:auto;
    }
    .product-recommendation-section .swiper-slide{
        height:auto;
    }
    
