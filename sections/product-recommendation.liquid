{% style %}
    
    .product-recommendation-section {
        position:relative;
    }
    .product-recommendation-section .float-nav button{
        background: #F1EADD;
    }
    .product-recommendation-section .float-nav button:hover{
        background: #B93205;
    }
    .product-recommendation-section .float-nav button:hover .fa-chevron-left:before,
    .product-recommendation-section .float-nav button:hover .fa-chevron-right:before{
        color: #FFF;
    }
    .product-recommendation-section .float-nav .fa-chevron-left:before,
    .product-recommendation-section .float-nav .fa-chevron-right:before{
        color: #B93205;
    }
    .product-recommendation-section .tab-product-list-slider .swiper-slide{
        height:auto;
    }
    .product-recommendation-section .swiper-slide{
        height:auto;
    }
    
