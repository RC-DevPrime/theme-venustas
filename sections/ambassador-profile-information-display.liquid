    .ambassador-profile-information-display-section .mansonry-slider.popup-modal .ambassador-gallery-modal-slider .gallery-item img,
    .ambassador-profile-information-display-section .mansonry-slider.popup-modal .ambassador-gallery-modal-slider .gallery-item video{
