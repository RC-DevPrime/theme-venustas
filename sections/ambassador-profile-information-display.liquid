    .ambassador-profile-information-display-section .gallery-mobile-slider .swiper-slide .gallery-item{
        height:420px;
        position:relative;
        overflow:hidden;
        border-radius: 8px;
    }
    .ambassador-profile-information-display-section .gallery-mobile-slider .swiper-slide .gallery-item img{
