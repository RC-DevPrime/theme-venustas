{% style %}
    .ambassador-profile-information-display-section .aside-profile-container{
        background: #F9F6EF;
        border-radius:24px;
        height:100%;
    }
    .ambassador-profile-information-display-section .aside-profile-container .top-header{
        border-bottom:1px solid #E2E2E2 ;
    }
    .ambassador-profile-information-display-section .aside-profile-container .body-content{
    }
    .ambassador-profile-information-display-section .profile-container{
        display:flex;
        gap:18px;
        align-items:center;
    }
    .ambassador-profile-information-display-section .profile-container .profile-image{
        height:110px;
        width:110px;
    }
    .ambassador-profile-information-display-section .profile-container .profile-image img{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .ambassador-profile-information-display-section .role-title{
        color:#2A2A2A ;
    }

    .ambassador-profile-information-display-section .ambassador-tags .tags-container{
        display: inline-block;
    }
    .ambassador-profile-information-display-section .ambassador-tags .tag-item{
        background: #B93205;
        border-radius: 4px;
        padding: 5px 10px;
        color: #FFF;
        margin-right: 8px;
        margin-bottom: 6px;
        width: fit-content;
        display: inline-block;
    }

    .ambassador-profile-information-display-section .social-item .social-icon{
        width:30px;
        height:30px;
        object-fit:contain;
    }
    .ambassador-profile-information-display-section .social-item .social-icon:hover{
        filter: brightness(0);
    }

    .ambassador-profile-information-display-section .country-flag{
        height:22px;
    }
    .ambassador-profile-information-display-section .country-flag img{
        width:100%;
        height:100%;
        object-fit:contain;
    }


    /* MASONRY SLIDER */
    .masonry-grid {
        display: grid;
        gap: 10px;
        height: 650px;
        grid-template-columns: repeat(8, 1fr);
        grid-template-rows: repeat(8, 1fr);
    }
    .masonry-item img,
    .masonry-item video{
        width:100%;
        height:100%;
        object-fit:cover;
        object-position: center;
    }
    .masonry-grid .masonry-item{
        border-radius:8px;
        overflow:hidden;
        position:relative;
        cursor:pointer;
    }

    .ambassador-profile-information-display-section .play-video-icon{
        position:absolute;
        top: 8px;
        right: 10px;
    }
    .ambassador-profile-information-display-section .play-video-icon img{
        width: 26px;
        height: 26px;
        object-fit:contain;
    }
    .ambassador-profile-information-display-section .media-link{
        display:block;
        width:100%;
        height:100%;
        position:relative;
    }
    .masonry-grid[data-item="5"] {
        grid-template-columns: repeat(9, 1fr);
        grid-template-rows: repeat(9, 1fr);
    }

    /* BLOCK ITEM - 1 ---------------------------------------- */
    .masonry-grid[data-item="1"] .masonry-item.item-1 {
        grid-area: 1 / 1 / 9 / 9;
    }

    /* BLOCK ITEM - 2 ---------------------------------------- */
    .masonry-grid[data-item="2"] .masonry-item.item-1 {
        grid-area: 1 / 1 / 9 / 5;
    }
    .masonry-grid[data-item="2"] .masonry-item.item-2 {
        grid-area: 1 / 5 / 9 / 9;
    }

    /* BLOCK ITEM - 3 ---------------------------------------- */
    .masonry-grid[data-item="3"] .masonry-item.item-1 {
        grid-area: 1 / 1 / 9 / 5;
    }
    .masonry-grid[data-item="3"] .masonry-item.item-2 {
        grid-area: 1 / 5 / 4 / 9;
    }
    .masonry-grid[data-item="3"] .masonry-item.item-3 {
        grid-area: 4 / 5 / 9 / 9;
    }

    /* BLOCK ITEM - 4 ---------------------------------------- */
    .masonry-grid[data-item="4"] .masonry-item.item-1 {
        grid-area: 1 / 1 / 6 / 5;
    }
    .masonry-grid[data-item="4"] .masonry-item.item-2 {
        grid-area: 6 / 1 / 9 / 5;
    }
    .masonry-grid[data-item="4"] .masonry-item.item-3 {
        grid-area: 1 / 5 / 4 / 9;
    }
    .masonry-grid[data-item="4"] .masonry-item.item-4 {
        grid-area: 4 / 5 / 9 / 9;
    }

    /* BLOCK ITEM - 5 ---------------------------------------- */
    .masonry-grid[data-item="5"] .masonry-item.item-1 {
        grid-area: 1 / 1 / 7 / 7;
    }
    .masonry-grid[data-item="5"] .masonry-item.item-2 {
        grid-area: 7 / 1 / 10 / 4;
    }
    .masonry-grid[data-item="5"] .masonry-item.item-3 {
        grid-area: 7 / 4 / 10 / 7;
    }
    .masonry-grid[data-item="5"] .masonry-item.item-4 {
        grid-area: 1 / 7 / 7 / 10;
    }
    .masonry-grid[data-item="5"] .masonry-item.item-5 {
        grid-area: 7 / 7 / 10 / 10;
    }

    /* BLOCK ITEM - 6 ---------------------------------------- */
    .masonry-grid[data-item="6"] .masonry-item.item-1 {
        grid-area: 1 / 1 / 6 / 5;
    }
    .masonry-grid[data-item="6"] .masonry-item.item-2 {
        grid-area: 1 / 5 / 4 / 7
    }
    .masonry-grid[data-item="6"] .masonry-item.item-3 {
        grid-area: 1 / 7 / 4 / 9;
    }
    .masonry-grid[data-item="6"] .masonry-item.item-4 {
        grid-area: 6 / 1 / 9 / 3;
    }
    .masonry-grid[data-item="6"] .masonry-item.item-5 {
        grid-area: 6 / 3 / 9 / 5;
    }
    .masonry-grid[data-item="6"] .masonry-item.item-6 {
        grid-area: 9 / 5 / 4 / 9;
    }

    .ambassador-profile-information-display-section .mansonry-slider.popup-modal .overlay{
        background: #000000ad;
    }
    .ambassador-profile-information-display-section .mansonry-slider.popup-modal .float-nav{
