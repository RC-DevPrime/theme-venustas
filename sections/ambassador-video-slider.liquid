{% style %}
    .ambassador-video-slider-section{

    }
    .ambassador-video-slider-section .section-heading{
        display:flex;
        align-items:center;
        justify-content:center;
        gap:10px;
    }
    .ambassador-video-slider-section .heading-element{
        height:40px;
        width:fit-content;
        object-fit:contain;
    }

    
    .ambassador-video-slider-section .ambassador-item{
        height:600px;
        border-radius:10px;
        background-color:#cfcfcf;
        overflow:hidden;
        position:relative;
    }

    .ambassador-video-slider-section .ambassador-item video{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .ambassador-video-slider-section .float-nav{
        top:55%;
    }
    .ambassador-video-slider-section .float-nav button{
        background: #6b6b6bab;
    }
    .ambassador-video-slider-section .float-nav button i{
        color:#FFF;
    }
    .ambassador-video-slider-section .float-nav button:hover{
        background:#B93205;
    }

    .play-button-icon{
        width:60px;
        height:60px;
        position:absolute;
        top:0;
        bottom:0;
        right:0;
        left:0;
        margin:auto;
    }
    .play-button-icon img{
        width:100%;
        height:100%;
        object-fit:contain;
    }


    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .play-button-icon{
            width:40px;
            height:40px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

    /* MOBILES ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 0px) {
        .ambassador-video-slider-section .ambassador-item{
            height:400px;
        }
    }
    @media only screen and (min-width: 375px) {
        .ambassador-video-slider-section .ambassador-item{
            height:400px;
        }
    }
    @media only screen and (min-width: 390px) {
        .ambassador-video-slider-section .ambassador-item{
            height:400px;
        }
    }
    @media only screen and (min-width: 414px) {
        .ambassador-video-slider-section .ambassador-item{
            height:400px;
        }
    }
    @media only screen and (min-width: 428px) {
        .ambassador-video-slider-section .ambassador-item{
            height:450px;
        }
    }
    @media only screen and (min-width: 480px) {
        .ambassador-video-slider-section .ambassador-item{
            height:450px;
        }
    }

    /* TABLETS ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 768px) {
        .ambassador-video-slider-section .ambassador-item{
            height:450px;
        }
    }


    /* LAPTOPS --------------------------------------------------------------------------------- */

    @media only screen and (min-width: 1280px) {
        .ambassador-video-slider-section .ambassador-item{
            height:450px;
        }
    }
    @media only screen and (min-width: 1366px) {
        .ambassador-video-slider-section .ambassador-item{
            height:480px;
        }
    }
    @media only screen and (min-width: 1440px) {
        .ambassador-video-slider-section .ambassador-item{
            height:500px;
        }
    }
    @media only screen and (min-width: 1536px) {
        .ambassador-video-slider-section .ambassador-item{
            height:530px;
        }
    }
    @media only screen and (min-width: 1600px) {
        .ambassador-video-slider-section .ambassador-item{
            height:550px;
        }
    }

    /* COMPUTERS --------------------------------------------------------------------------------- */
    @media only screen and (min-width: 1920px) {
        .ambassador-video-slider-section .ambassador-item{
            height:600px;
        }
    }
    @media only screen and (min-width: 2560px) {
        .ambassador-video-slider-section .ambassador-item{
            height:600px;
        }
    }
{% endstyle %}
<div class="container section-content px-lg-5 px-md-5 px-sm-0">
    <div class="section-heading pb-lg-5 pb-md-5 pb-sm-4">
        <h2 class="pp-bold f-black title-sm text-center">
            {{ section.settings.heading }}
        </h2>
    </div>

    <div class="ambassador-video-slider overflow-hidden">
        <div class="swiper-wrapper">
            {% for block in section.blocks %}
                <div class="swiper-slide">
                    <div class="ambassador-item">
                        
                            {% assign large_poster = block.settings.video.preview_image | image_url: width: 2000 %}

                            {{ block.settings.video | video_tag: 
                                autoplay: false, 
                                loop: true, 
                                muted: true, 
                                playsinline: true, 
                                poster: large_poster 
                            }}
                            <div class="play-button-icon">
                                <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/51350_2x_1e0b70df-8116-4e94-b617-3a0a00121842.png?v=1761197011">
                            </div>
                    </div>
                </div>
            {% endfor %}

        </div>
        <div class="float-nav d-lg-block d-md-block d-sm-block">
            <button type="button" class="owl-prev" disabled>
                <i class="fa-solid fa-chevron-left f-main"></i>
            </button>
            <button type="button" class="owl-next" disabled>
                <i class="fa-solid fa-chevron-right f-main"></i>
            </button>
        </div>
        <div class="swiper-pagination d-lg-none d-md-none d-sm-block"></div>
    </div>
    
</div>
{% schema %}
    {
        "class": "ambassador-video-slider-section position-relative",
        "name": "Ambassador Video Slider",
        "templates": ["page"],
        "limit": 1, 
        "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "See What Our Ambassadors Are Sharing"
            }
        ],
        "blocks": [
            {
                "type": "video",
                "name": "video",
                "settings": [
                    {
                        "type": "video",
                        "id": "video",
                        "label": "Video"
                    }
                ]
            }
        ],
        "presets" :[{
            "name" : "Ambassador Video Slider"
        }]
    }
  {% endschema %} 