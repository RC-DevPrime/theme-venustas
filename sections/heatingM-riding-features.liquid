{%- style -%}
  #shopify-section-{{ section.id }} .heatingM-riding {
    overflow: hidden;
    background: #fff;
    color: #1a1a1a;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .heatingM-riding__inner {
    width: min(calc(100% - 40px), 1340px);
    margin: 0 auto;
    padding: 100px 0 12px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingM-riding__title {
    margin: 0 0 44px;
    font-size: 34px;
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -.952px;
  }

  #shopify-section-{{ section.id }} .heatingM-riding__track {
    display: flex;
    width: 100%;
    gap: 20px;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  #shopify-section-{{ section.id }} .heatingM-riding__card {
    display: flex;
    flex: 0 0 calc((100% - 60px) / 4);
    min-width: 0;
    height: auto;
    flex-direction: column;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 0 23.1px rgba(0, 0, 0, .08);
  }

  #shopify-section-{{ section.id }} .heatingM-riding__media {
    position: relative;
    height: var(--heatingM-riding-image-height);
    min-height: 0;
    overflow: hidden;
    background: #f9f9f8;
  }

  #shopify-section-{{ section.id }} .heatingM-riding__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .heatingM-riding__mobile-image { display: none; }

  #shopify-section-{{ section.id }} .heatingM-riding__placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: #565b63;
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .heatingM-riding__copy {
    display: flex;
    height: 184px;
    padding: 28px;
    flex-direction: column;
    gap: 12px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingM-riding__card-title,
  #shopify-section-{{ section.id }} .heatingM-riding__card-description { margin: 0; }

  #shopify-section-{{ section.id }} .heatingM-riding__card-title {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .heatingM-riding__card-description {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
  }

  @media only screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .heatingM-riding__inner {
      width: 100%;
      padding: 48px 20px;
    }

    #shopify-section-{{ section.id }} .heatingM-riding__title {
      margin-bottom: 28px;
      font-size: 28px;
      line-height: 1.22;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heatingM-riding__track {
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .heatingM-riding__card {
      flex-basis: calc((100% - 32px) / 3.2);
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .heatingM-riding__media { height: var(--heatingM-riding-image-height); }
    #shopify-section-{{ section.id }} .heatingM-riding__desktop-image { display: none; }
    #shopify-section-{{ section.id }} .heatingM-riding__mobile-image { display: block; }
  }

  @media only screen and (min-width: 501px) and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingM-riding__track {
      overflow-x: auto;
    }

    #shopify-section-{{ section.id }} .heatingM-riding__card {
      flex-basis: calc((100% - 19.2px) / 2.2);
    }
  }

  @media only screen and (max-width: 500px) {
    #shopify-section-{{ section.id }} .heatingM-riding__card {
      flex-basis: calc((100% - 16px) / 1.2);
    }
  }
{%- endstyle -%}

<section class="heatingM-riding" style="--heatingM-riding-image-height: {{ section.settings.image_height }}px;" aria-label="{{ section.settings.title | escape }}">
  <div class="heatingM-riding__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="heatingM-riding__title">{{ section.settings.title | newline_to_br }}</h2>
    {%- endif -%}

    <div class="heatingM-riding__track">
      {%- for block in section.blocks -%}
        <article class="heatingM-riding__card" {{ block.shopify_attributes }}>
          <div class="heatingM-riding__media">
            {%- if block.settings.desktop_image != blank -%}
              {{ block.settings.desktop_image | image_url: width: 1200 | image_tag: class: 'heatingM-riding__image heatingM-riding__desktop-image', widths: '400, 700, 1000, 1200', sizes: '(max-width: 500px) 300px, (max-width: 767px) 25vw, 320px', loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              <div class="heatingM-riding__placeholder heatingM-riding__desktop-image">请上传桌面端图片</div>
            {%- endif -%}
            {%- if block.settings.mobile_image != blank -%}
              {{ block.settings.mobile_image | image_url: width: 1000 | image_tag: class: 'heatingM-riding__image heatingM-riding__mobile-image', widths: '400, 700, 1000', sizes: '300px', loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              <div class="heatingM-riding__placeholder heatingM-riding__mobile-image">请上传移动端图片</div>
            {%- endif -%}
          </div>
          <div class="heatingM-riding__copy">
            <h3 class="heatingM-riding__card-title">{{ block.settings.title }}</h3>
            <p class="heatingM-riding__card-description">{{ block.settings.description }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HeatingM riding",
  "settings": [
    {
      "type": "paragraph",
      "content": "请至少保留 3 个卡片；默认 4 个，最多 5 个。"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 320,
      "max": 360,
      "step": 1,
      "unit": "px",
      "default": 340
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Built Around the Riding Position"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "text", "id": "title", "label": "Card title", "default": "Packs into its own pocket" },
        { "type": "textarea", "id": "description", "label": "Card description", "default": "Stuff it in the tail bag when the afternoon warms up." }
      ]
    }
  ],
  "presets": [
    {
      "name": "HeatingM riding",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}
