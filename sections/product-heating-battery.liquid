{% style %}
  #shopify-section-{{ section.id }} .product-heating-battery {
    width: 100%;
    background: #f5f5f5;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__inner {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 80px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__header {
    max-width: 820px;
    margin: 0 auto 56px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__eyebrow {
    margin: 0 0 16px;
    color: var(--color-brand);
    font-size: 20px;
    font-weight: 500;
    text-transform: capitalize;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__heading {
    margin: 0 0 24px;
    color: #111827;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__description {
    margin: 0;
    color: var(--venustas-black);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cards-wrap {
    margin-bottom: 56px;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__dots {
    display: none;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 56px;
    padding: 20px 32px;
    border-radius: 12px;
    background: var(--color-brand);
    color: #fff;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta-left {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta-icon {
    flex: none;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fff;
    color: var(--color-brand);
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta-heading {
    margin: 0 0 4px;
    color: #fff;
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta-text {
    margin: 0;
    color: #fff;
    font-size: 16px;
    font-weight: 300;
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta-price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta-price-old {
    font-size: 14px;
    font-weight: 400;
    color: #dfb1a1;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta-price-new {
    font-size: 22px;
    font-weight: 800;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    padding: 0 24px;
    border-radius: 8px;
    background: #fff;
    color: var(--color-brand);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta-cart {
    width: 16px;
    height: 16px;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .product-heating-battery__cta-cart svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-heating-battery__inner {
      width: 100%;
      padding: 56px 20px 40px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__header {
      margin-bottom: 40px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__eyebrow {
      margin-bottom: 12px;
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__heading {
      margin-bottom: 12px;
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__description {
      font-size: 14px;
      line-height: 1.4;
      opacity: 0.8;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cards-wrap {
      margin-bottom: 48px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cards {
      display: flex;
      flex-wrap: nowrap;
      gap: 20px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cards::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cards .product-heating-power-card {
      flex: 0 0 100%;
      scroll-snap-align: center;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 10px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #515151;
      opacity: 0.3;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__dot.is-active {
      background: var(--color-brand);
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cta {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      margin-top: 48px;
      padding: 20px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cta-left {
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cta-icon {
      width: 28px;
      height: 28px;
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cta-heading {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cta-text {
      font-size: 11px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cta-right {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cta-price {
      flex-direction: row;
      align-items: baseline;
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cta-price-old {
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cta-price-new {
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .product-heating-battery__cta-button {
      height: auto;
      padding: 10px 16px;
      font-size: 12px;
      font-weight: 700;
    }
  }
{% endstyle %}

<section class="product-heating-battery">
  <div class="product-heating-battery__inner">
    <div class="product-heating-battery__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="product-heating-battery__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="product-heating-battery__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="product-heating-battery__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- assign power_cards = section.blocks | where: 'type', 'power_card' -%}
    <div class="product-heating-battery__cards-wrap">
      <div class="product-heating-battery__cards" data-power-scroll>
        {%- for block in power_cards -%}
          {%- render 'product-heating-power-card', section_id: section.id, block: block -%}
        {%- endfor -%}
      </div>
      {%- if power_cards.size > 1 -%}
        <div class="product-heating-battery__dots">
          {%- for block in power_cards -%}
            <span class="product-heating-battery__dot{% if forloop.first %} is-active{% endif %}" data-power-dot></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
    {%- if benefit_blocks.size > 0 -%}
      {%- render 'heating-icon-benefits',
        section_id: section.id,
        blocks: benefit_blocks,
        section_background: 'transparent',
        panel_background: '#FFFFFF',
        panel_border_color: 'transparent',
        title_color: '#1A1A1A',
        text_color: '#1A1A1A',
        use_product_icons: true,
        inner_padding: '0',
        mobile_inner_padding: '0',
        panel_padding: '16px 0',
        mobile_panel_padding: '0',
        panel_gap: '52px',
        mobile_panel_gap: '12px',
        mobile_columns: 2,
        mobile_card: true
      -%}
    {%- endif -%}

    {%- if section.settings.cta_heading != blank or section.settings.cta_button_text != blank -%}
      <div class="product-heating-battery__cta">
        <div class="product-heating-battery__cta-left">
          <span class="product-heating-battery__cta-icon" aria-hidden="true">!</span>
          <div class="product-heating-battery__cta-copy">
            {%- if section.settings.cta_heading != blank -%}
              <p class="product-heating-battery__cta-heading">{{ section.settings.cta_heading }}</p>
            {%- endif -%}
            {%- if section.settings.cta_text != blank -%}
              <p class="product-heating-battery__cta-text">{{ section.settings.cta_text }}</p>
            {%- endif -%}
          </div>
        </div>

        <div class="product-heating-battery__cta-right">
          <div class="product-heating-battery__cta-price">
            {%- if section.settings.cta_price_old != blank -%}
              <span class="product-heating-battery__cta-price-old">{{ section.settings.cta_price_old }}</span>
            {%- endif -%}
            {%- if section.settings.cta_price != blank -%}
              <span class="product-heating-battery__cta-price-new">{{ section.settings.cta_price }}</span>
            {%- endif -%}
          </div>
          {%- if section.settings.cta_button_text != blank -%}
            <a class="product-heating-battery__cta-button" href="{{ section.settings.cta_button_link | default: '#' }}">
              <span class="product-heating-battery__cta-cart" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 2.5h1.8l1.4 8h7.4l1.6-6H4.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="6.5" cy="13.5" r="1.2" stroke="currentColor" stroke-width="1.2"/>
                  <circle cx="11.5" cy="13.5" r="1.2" stroke="currentColor" stroke-width="1.2"/>
                </svg>
              </span>
              {{ section.settings.cta_button_text }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const init = () => {
      const section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;
      const track = section.querySelector('[data-power-scroll]');
      const dots = section.querySelectorAll('[data-power-dot]');
      if (!track || !dots.length || track.dataset.bound) return;
      track.dataset.bound = '1';
      const update = () => dots.forEach((dot, i) => dot.classList.toggle('is-active', i === Math.round(track.scrollLeft / track.clientWidth)));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      dots.forEach((dot, i) => dot.addEventListener('click', () => track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' })));
      update();
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('shopify:section:load', (event) => { if (event.detail && event.detail.sectionId === '{{ section.id }}') init(); });
  })();
</script>

