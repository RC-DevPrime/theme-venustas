{%- comment -%}
  Product How It Works
  A row of steps, each with a GIF/video/image, an auto step number, title and text.
  Built for 5 GIFs (media can be left blank until the assets are ready — a
  numbered placeholder shows in the meantime).
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    --hw-accent: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .container {
    padding-left: 40px;
    padding-right: 40px;
  }
  #shopify-section-{{ section.id }} .hw {
    padding: 64px 0;
  }
  #shopify-section-{{ section.id }} .hw__heading {
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    text-align: center;
    margin-bottom: {% if section.settings.subheading == blank %}40px{% else %}8px{% endif %};
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .hw__subheading {
    text-align: center;
    color: #777;
    font-size: 15px;
    margin: 0 auto 40px;
    max-width: 680px;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .hw__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    gap: 18px;
  }
  #shopify-section-{{ section.id }} .hw__step {
    text-align: center;
  }
  #shopify-section-{{ section.id }} .hw__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.media_ratio }};
    border-radius: 14px;
    overflow: hidden;
    background: #e9edf0;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .hw__media img,
  #shopify-section-{{ section.id }} .hw__media video {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  #shopify-section-{{ section.id }} .hw__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #b6bec3;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }
  #shopify-section-{{ section.id }} .hw__num {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--hw-accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 14px;
    z-index: 2;
  }
  #shopify-section-{{ section.id }} .hw__title {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 6px;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .hw__desc {
    font-size: 13px;
    color: #777;
    line-height: 1.6;
    margin: 0;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .container { padding-left: 20px; padding-right: 20px; }
    #shopify-section-{{ section.id }} .hw { padding: 44px 0; }
    #shopify-section-{{ section.id }} .hw__grid {
      grid-auto-flow: column;
      grid-auto-columns: 64%;
      grid-template-columns: none;
      gap: 14px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      padding-bottom: 6px;
    }
    #shopify-section-{{ section.id }} .hw__step { scroll-snap-align: start; }
  }
{% endstyle %}

<div class="hw">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="hw__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="hw__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="hw__grid">
      {% for block in section.blocks %}
        <div class="hw__step" {{ block.shopify_attributes }}>
          <div class="hw__media">
            {% if section.settings.show_numbers %}<span class="hw__num">{{ forloop.index }}</span>{% endif %}
            {% if block.settings.video != blank %}
              <video src="{{ block.settings.video.sources[1].url | default: block.settings.video.sources[0].url }}" autoplay muted loop playsinline></video>
            {% elsif block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% else %}
              <span class="hw__placeholder">GIF coming soon</span>
            {% endif %}
          </div>
          {% if block.settings.title != blank %}<p class="hw__title">{{ block.settings.title }}</p>{% endif %}
          {% if block.settings.description != blank %}<p class="hw__desc">{{ block.settings.description }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How It Works",
  "class": "product-how-it-works-section",
  "settings": [
    { "type": "checkbox", "id": "enabled_section_child_scroll", "label": "Enable scroll nav anchor", "default": false },
    { "type": "text", "id": "section_scroll_nav", "label": "Scroll Nav Group" },
    { "type": "text", "id": "nav_title", "label": "Nav Title" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#17A6C2" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It Works" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "show_numbers", "label": "Show step numbers", "default": true },
    {
      "type": "select", "id": "media_ratio", "label": "Media Ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ], "default": "1 / 1"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "video", "id": "video", "label": "GIF / Video", "info": "Upload your GIF as a video, or use the image field below." },
        { "type": "image_picker", "id": "image", "label": "Image (fallback)" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        { "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
