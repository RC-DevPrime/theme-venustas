{% style %}
    .campaign-tab-product-list-section{
        background-color:#000;
    }
    .campaign-tab-product-list-section .tab-list-container{
        display:flex;
        justify-content:center;
        gap:1.2rem;
    }
    .campaign-tab-product-list-section .tab-list-container button{
        flex:0 1 auto;
        min-width:150px;
        padding:0 24px;
        border:0;
        color:#fff;
        background: #353231;
        border-radius: 16px 16px 16px 16px;
        height:55px;
        display:flex;
        align-items:center;
        justify-content:center;
        transition: all 0.3s ease;
        cursor:pointer;
    }
    .campaign-tab-product-list-section .tab-list-container button:hover,
    
    .campaign-tab-product-list-section .tab-list-container button.active{
        background: #B93205;
    }
    .campaign-tab-product-list-section .tab-content-list-container{
        margin-top:30px;
    }
    .campaign-tab-product-list-section .tab-content-list-container .product-item{
        background: #FFFFFF;
        border-radius: 16px;
    }
    .campaign-tab-product-list-section .tab-content-list-container .row{
        --bs-gutter-x: 15px;
        --bs-gutter-y: 25px;
    }
    .campaign-tab-product-list-section .campaign-product-column{
        flex:0 0 auto;
        width:25%;
    }

    .campaign-tab-product-list-section .product-details{
        padding:0 10px 10px;
    }
    .campaign-tab-product-list-section .product-details .wishlist-button{
        right:10px;
    }


    .campaign-tab-product-list-section .section-heading {
        margin-left:-30px;
        position:relative;
    }
    .campaign-tab-product-list-section .section-heading:before{
        content:"";
        display:inline-block;
        height:35px;
        width:35px;
        top:5px;
        position:relative;
        background-image:url({{ section.settings.heading_element | img_url: 'master' }});
        background-size:contain;
        background-repeat:no-repeat;
    }

    @media (min-width: 768px) and (max-width: 1199px) {
        .campaign-tab-product-list-section .campaign-product-column{ width:33.333333%; }
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 767px) {
        
        .campaign-tab-product-list-section .campaign-product-column{ width:50%; }
                
        .campaign-tab-product-list-section .section-heading{
            margin-left:-25px;
        }
        .campaign-tab-product-list-section .section-heading:before{
            height:30px;
            width:30px;
        }
        .campaign-tab-product-list-section .tab-content-list-container .product-item{
            border-radius:8px;
        }
        .campaign-tab-product-list-section .tab-content-list-container .row{
            --bs-gutter-x: 10px;
            --bs-gutter-y: 20px;
        }
        .campaign-tab-product-list-section .tab-list-container{
            display: flex;
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: none;
            gap:8px;
        }
        .campaign-tab-product-list-section .tab-list-container button{
            flex: 0 0 auto;
            white-space: nowrap;
            min-width: 150px;
            height: 38px;
            border-radius: 8px 8px 8px 8px;
            padding: 5px 20px;
        }
    }
    @media only screen and (max-width: 410px) {
        .campaign-tab-product-list-section .product-details .wishlist-button{
            right:2px;
        }
    }

{% endstyle %}
<div class="container section-content position-relative 
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}> 

    <div class="pb-lg-5 pb-md-5 pb-sm-4">
        <h2 class="section-heading pp-semibold f-white title-sm text-center">
            {{ section.settings.heading }}
        </h2>
    </div>
    <div class="tab-list-container col-lg-10 col-md-11 col-sm-12 mx-auto" role="tablist">
        {% for block in section.blocks %}
            <button type="button" id="campaign-tab-{{ section.id }}-{{ block.id }}" class="pp-semibold f-white body-xl {% if forloop.first %}active{% endif %}" role="tab" aria-controls="campaign-panel-{{ section.id }}-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.tab | default: block.settings.collection.title | escape }}
            </button>
        {% endfor %}
    </div>
    <div class="tab-content-list-container">
        {% for block in section.blocks %}
            <div id="campaign-panel-{{ section.id }}-{{ block.id }}" class="tab-content-item {% if forloop.first %}open{% endif %}" role="tabpanel" aria-labelledby="campaign-tab-{{ section.id }}-{{ block.id }}" data-block-id="{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
                <div class="row">
                    {% assign product_limit = block.settings.maximum_number_product_display | default: 8 %}
                    {% for product in block.settings.collection.products limit: product_limit %}
                        <div class="campaign-product-column">
                            {% render 'product-item', product: product %}
                        </div>
                    {% else %}
                        <p class="f-white">No products found.</p>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

{% schema %}
    {
        "class": "campaign-tab-product-list-section",
        "name": "Campaign Tab Product List",
        "templates": ["page"],
        "limit": 1, 
        "max_blocks": 5,
        "settings": [
            {
                "type": "checkbox",
                "id": "enabled_section_child_scroll",
                "label": "Enabled Section Child Scroll"
            },
            {
                "type": "text",
                "id": "section_scroll_nav",
                "label": "Section Scroll Nav",
                "info": "Need to Enabled first Section Scroll"
            },
            {
                "type": "text",
                "id": "nav_title",
                "label": "Navigation Title"
            },
            {
                "type": "image_picker",
                "id": "heading_element",
                "label": "Heading Element"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Add-Ons & Accessories"
            }
        ],
        "blocks": [
            {
                "type": "tab",
                "name": "Tab",
                "settings": [
                    {
                        "type": "text",
                        "id": "tab",
                        "label": "Tab",
                        "default": "Collection"
                    },
                    { "type": "collection", "id": "collection", "label": "Collection" },
                    { "type": "range", "id": "maximum_number_product_display", "label": "Maximum products", "min": 1, "max": 50, "step": 1, "default": 8 }
                ]
            }
        ],
        "presets" :[{
            "name" : "Campaign Tab Product List",
            "blocks": [
                { "type": "tab", "settings": { "tab": "All" } },
                { "type": "tab", "settings": { "tab": "Battery & Charger" } },
                { "type": "tab", "settings": { "tab": "Heated Gloves" } },
                { "type": "tab", "settings": { "tab": "Other" } }
            ]
        }]
    }
  {% endschema %} 
