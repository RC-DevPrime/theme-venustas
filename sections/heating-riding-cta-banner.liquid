{% style %}
  #shopify-section-{{ section.id }} .heating-riding-cta-banner {
    width: 100%;
    min-height: 180px;
    background-color: #111;
    {%- if section.settings.desktop_background != blank -%}
      background-image: url({{ section.settings.desktop_background | image_url: width: 2000 }});
    {%- endif -%}
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .heating-riding-cta-banner__inner {
    width: min(100% - 40px, 1340px);
    min-height: 180px;
    margin: 0 auto;
    padding: 42px 0 30px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-riding-cta-banner__heading {
    margin: 0 0 8px;
    max-width: 720px;
    color: #fff;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-cta-banner__description {
    margin: 0;
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-cta-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 24px;
  }

  #shopify-section-{{ section.id }} .heating-riding-cta-banner__button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    border-radius: 6px;
    background: var(--color-brand, #B93205);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-cta-banner__note {
    margin: 56px 0 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heating-riding-cta-banner {
      min-height: 317px;
      {%- if section.settings.mobile_background != blank -%}
        background-image: url({{ section.settings.mobile_background | image_url: width: 900 }});
      {%- elsif section.settings.desktop_background != blank -%}
        background-image: url({{ section.settings.desktop_background | image_url: width: 900 }});
      {%- endif -%}
      background-position: center top;
    }

    #shopify-section-{{ section.id }} .heating-riding-cta-banner__inner {
      width: 100%;
      min-height: 317px;
      padding: 42px 24px 30px;
    }

    #shopify-section-{{ section.id }} .heating-riding-cta-banner__heading {
      margin-bottom: 8px;
      font-size: 22px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .heating-riding-cta-banner__description {
      font-size: 16px;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .heating-riding-cta-banner__buttons {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 20px;
    }

    #shopify-section-{{ section.id }} .heating-riding-cta-banner__button {
      width: 100%;
      min-height: 48px;
      padding: 0;
      box-sizing: border-box;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .heating-riding-cta-banner__button:nth-child(3) {
      grid-column: 1 / -1;
    }

    #shopify-section-{{ section.id }} .heating-riding-cta-banner__note {
      margin-top: 20px;
      font-size: 12px;
    }
  }
{% endstyle %}

<section class="heating-riding-cta-banner">
  <div class="heating-riding-cta-banner__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="heating-riding-cta-banner__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="heating-riding-cta-banner__description">{{ section.settings.description }}</p>
    {%- endif -%}

    <div class="heating-riding-cta-banner__buttons">
      {%- for block in section.blocks -%}
        {%- if block.settings.label != blank -%}
          <a
            class="heating-riding-cta-banner__button"
            href="{{ block.settings.link | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="heating-riding-cta-banner__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Heating Riding CTA Banner",
  "tag": "section",
  "class": "heating-riding-cta-banner-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_background",
      "label": "Desktop background"
    },
    {
      "type": "image_picker",
      "id": "mobile_background",
      "label": "Mobile background"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "READY TO RIDE BEYOND THE COLD?"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Build your heated setup for colder rides."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Bottom note",
      "default": "3-Year Warranty on Heating Elements | Free Shipping"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop Heated Jacket"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heating Riding CTA Banner",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "label": "Explore Heated Jacket"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Explore Heated Pants"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Shop Motorcycle Heated Gear"
          }
        }
      ]
    }
  ]
}
{% endschema %}
