{% style %}
  #shopify-section-{{ section.id }} .giftG-cat {
    padding: 40px 0;
    background: #f9f2e8;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .giftG-cat__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 24px 52px;
    width: min(calc(100% - 40px), 1340px);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .giftG-cat__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .giftG-cat__media {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #efe6d8;
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .giftG-cat__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  #shopify-section-{{ section.id }} .giftG-cat__link:hover .giftG-cat__media img {
    transform: scale(1.06);
  }

  #shopify-section-{{ section.id }} .giftG-cat__label {
    display: block;
    margin-top: 15px;
    color: #0b4c20;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    transition: color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .giftG-cat__link:hover .giftG-cat__label {
    color: #b93205;
  }

  #shopify-section-{{ section.id }} .giftG-cat__bar {
    position: fixed;
    top: var(--headerHeight, 0px);
    left: 0;
    right: 0;
    z-index: 8999;
    background: #b93205;
    transform: translateY(-100%);
    visibility: hidden;
    transition: transform 0.3s ease, visibility 0s linear 0.3s;
  }

  #shopify-section-{{ section.id }} .giftG-cat__bar--shown {
    transform: translateY(0);
    visibility: visible;
    transition: transform 0.3s ease, visibility 0s;
  }

  #shopify-section-{{ section.id }} .giftG-cat__bar-list {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(calc(100% - 40px), 1340px);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .giftG-cat__bar-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.68;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .giftG-cat__bar-link:hover {
    color: #fff;
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .giftG-cat__media img,
    #shopify-section-{{ section.id }} .giftG-cat__label,
    #shopify-section-{{ section.id }} .giftG-cat__bar {
      transition: none;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .giftG-cat {
      padding: 24px 0;
    }

    #shopify-section-{{ section.id }} .giftG-cat__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px 16px;
    }

    #shopify-section-{{ section.id }} .giftG-cat__media {
      width: 85%;
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .giftG-cat__label {
      margin-top: 12px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .giftG-cat__bar-list {
      justify-content: flex-start;
      gap: 24px;
      overflow-x: auto;
      padding: 0 20px;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .giftG-cat__bar-list::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .giftG-cat__bar-list li {
      flex: 0 0 auto;
    }

    #shopify-section-{{ section.id }} .giftG-cat__bar-link {
      min-height: 48px;
      padding: 0;
      font-size: 13px;
      white-space: nowrap;
    }
  }
{% endstyle %}

{%- if section.blocks.size > 0 -%}
  <section class="giftG-cat">
    <nav class="giftG-cat__nav" aria-label="Gift guide categories">
      <ul class="giftG-cat__list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_label = block.settings.label
            assign item_link = block.settings.link | default: '#'
            assign item_image = block.settings.image
            assign item_alt = item_image.alt | default: item_label
          -%}
          <li class="giftG-cat__item" {{ block.shopify_attributes }}>
            <a class="giftG-cat__link" href="{{ item_link }}">
              <span class="giftG-cat__media">
                {%- if item_image != blank -%}
                  {{ item_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '180, 260, 360, 400', sizes: '(max-width: 767px) 30vw, 180px', alt: item_alt }}
                {%- endif -%}
              </span>
              {%- if item_label != blank -%}
                <span class="giftG-cat__label">{{ item_label | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="giftG-cat__bar">
      <nav aria-label="Gift guide categories">
        <ul class="giftG-cat__bar-list">
          {%- for block in section.blocks -%}
            {%- if block.settings.label != blank -%}
              <li>
                <a class="giftG-cat__bar-link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    </div>
  </section>

  <script>
    (function () {
      var section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;
      var nav = section.querySelector('.giftG-cat__nav');
      var bar = section.querySelector('.giftG-cat__bar');
      if (!nav || !bar) return;

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      var observer = new IntersectionObserver(function (entries) {
        var entry = entries[0];
        bar.classList.toggle('giftG-cat__bar--shown', entry.boundingClientRect.bottom <= 0);
      });
      observer.observe(nav);

      section.addEventListener('click', function (event) {
        var link = event.target.closest('.giftG-cat__link, .giftG-cat__bar-link');
        if (!link) return;
        var href = link.getAttribute('href') || '';
        if (href.charAt(0) !== '#' || href.length < 2) return;
        var target = document.getElementById(href.slice(1));
        if (!target) return;
        event.preventDefault();
        var barTop = parseFloat(window.getComputedStyle(bar).top) || 0;
        var offset = bar.offsetHeight + barTop;
        var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
        window.scrollTo({
          top: Math.max(top, 0),
          behavior: reduceMotion.matches ? 'auto' : 'smooth'
        });
      });

      section.addEventListener('shopify:section:unload', function () {
        observer.disconnect();
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Gift Guide Categories",
  "tag": "section",
  "class": "giftG-cat-section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Anchor link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Categories",
      "blocks": [
        { "type": "category", "settings": { "label": "Gifts for Her" } },
        { "type": "category", "settings": { "label": "Gifts for Him" } },
        { "type": "category", "settings": { "label": "Gifts for Kits" } },
        { "type": "category", "settings": { "label": "Gifts by Activity" } },
        { "type": "category", "settings": { "label": "New Arrivals" } },
        { "type": "category", "settings": { "label": "Gift Card" } }
      ]
    }
  ]
}
{% endschema %}
