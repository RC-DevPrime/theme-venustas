{% style %}
  #shopify-section-{{ section.id }} .xmas-flagship-gifts {
    position: relative;
    padding: 98px 0 80px;
    background: #f8f1e6;
    color: #0b4c20;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__decoration { position: absolute; top: 22px; left: 0; width: 100%; pointer-events: none; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__decoration img { display: block; width: 100%; height: auto; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__inner { width: min(calc(100% - 40px), 1340px); margin: 0 auto; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__title { margin: 0 0 40px; color: inherit; font-size: 40px; font-weight: 800; line-height: 1.2; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__group { --gift-accent: #b93205; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px 20px; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__group--gold { --gift-accent: #bc8d00; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__group + .xmas-flagship-gifts__group { margin-top: 40px; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__heading { margin: 0; color: inherit; font-size: 16px; font-weight: 700; line-height: 1.45; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__collection { align-self: center; color: var(--gift-accent); font-size: 14px; font-weight: 600; line-height: 1.45; text-align: right; text-decoration: underline; text-underline-offset: 2px; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; grid-column: 1 / -1; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__card { display: flex; align-items: flex-start; gap: 22px; padding: 24px; border-top: 4px solid var(--gift-accent); border-radius: 12px; background: #fffdf9; min-width: 0; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__media { display: block; flex: 0 0 120px; width: 120px; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__image { display: block; width: 100%; height: auto; border-radius: 4px; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__details { display: flex; flex: 1; flex-direction: column; gap: 4px; min-width: 0; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__eyebrow { margin: 0; color: var(--gift-accent); font-size: 14px; font-weight: 700; line-height: 20px; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__product-title { margin: 0; color: inherit; font-size: 18px; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__product-title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__description { margin: 0; font-size: 14px; font-weight: 400; line-height: 20px; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__prices { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__price { color: var(--gift-accent); font-size: 24px; font-weight: 700; line-height: 1.45; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__compare { font-size: 16px; font-weight: 500; line-height: 24px; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__actions { margin: 8px 0 0; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 170px;
    max-width: 100%;
    min-height: 44px;
    padding: 8px 12px;
    border: 0;
    border-radius: 6px;
    background: var(--gift-accent);
    color: #fff;
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
    text-align: center;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__button:disabled { opacity: .6; cursor: default; }
  #shopify-section-{{ section.id }} .xmas-flagship-gifts a:focus-visible,
  #shopify-section-{{ section.id }} .xmas-flagship-gifts__button:focus-visible { outline: 2px solid var(--gift-accent, #0b4c20); outline-offset: 3px; }
  @media (min-width: 768px) and (max-width: 999px) {
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__card { gap: 14px; padding: 20px 16px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__media { flex-basis: 90px; width: 90px; }
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .xmas-flagship-gifts { padding: 54px 0 32px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__decoration { top: 12px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__title { font-size: 24px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__group { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__heading { font-size: 18px; font-weight: 600; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__collection { order: 1; font-size: 16px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__cards { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__card { gap: 14px; padding: 16px 12px; border-top-width: 3px; border-radius: 8px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__media { flex-basis: 90px; width: 90px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__eyebrow { font-size: 12px; letter-spacing: .48px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__product-title { font-size: 16px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__description { font-weight: 500; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__price { font-size: 20px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__compare { font-size: 14px; line-height: 20px; }
    #shopify-section-{{ section.id }} .xmas-flagship-gifts__button { width: 100%; }
  }
{% endstyle %}

{% liquid
  assign decoration = section.settings.decoration
  assign mobile_decoration = section.settings.mobile_decoration | default: decoration
%}
<section class="xmas-flagship-gifts"{% if section.settings.title != blank %} aria-labelledby="xmas-gifts-title-{{ section.id }}"{% endif %}>
  {% if decoration != blank or mobile_decoration != blank %}
    <picture class="xmas-flagship-gifts__decoration">
      {% if mobile_decoration != blank %}<source media="(max-width: 767px)" srcset="{{ mobile_decoration | image_url: width: 900 }}">{% endif %}
      {% assign decoration_fallback = decoration | default: mobile_decoration %}
      {{ decoration_fallback | image_url: width: 2400 | image_tag: widths: '900, 1340, 1920, 2400', sizes: '100vw', alt: '', loading: 'lazy' }}
    </picture>
  {% endif %}
  <div class="xmas-flagship-gifts__inner">
    {% if section.settings.title != blank %}<h2 class="xmas-flagship-gifts__title" id="xmas-gifts-title-{{ section.id }}">{{ section.settings.title | escape }}</h2>{% endif %}
    {% for block in section.blocks %}
      {% if block.settings.product_1 != blank or block.settings.product_2 != blank %}
        <div class="xmas-flagship-gifts__group xmas-flagship-gifts__group--{{ block.settings.color }}" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}<h3 class="xmas-flagship-gifts__heading">{{ block.settings.heading | escape }}</h3>{% endif %}
          {% if block.settings.link != blank and block.settings.link_label != blank %}<a class="xmas-flagship-gifts__collection" href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}
          <div class="xmas-flagship-gifts__cards">
            {% for index in (1..2) %}
              {% liquid
                assign product_key = 'product_' | append: index
                assign title_key = 'title_' | append: index
                assign eyebrow_key = 'eyebrow_' | append: index
                assign description_key = 'description_' | append: index
                assign gift_product = block.settings[product_key]
                assign gift_title = block.settings[title_key] | default: gift_product.title
                assign gift_variant = gift_product.selected_or_first_available_variant
                assign form_id = 'xmas-gift-' | append: section.id | append: '-' | append: block.id | append: '-' | append: index
              %}
              {% if gift_product != blank %}
                <article class="xmas-flagship-gifts__card">
                  {% if gift_product.featured_image != blank %}
                    <a class="xmas-flagship-gifts__media" href="{{ gift_product.url | escape }}" aria-label="{{ gift_title | escape }}">
                      {% assign gift_alt = gift_product.featured_image.alt | default: gift_title %}
                      {{ gift_product.featured_image | image_url: width: 360 | image_tag: widths: '90, 120, 180, 240, 360', sizes: '(max-width: 999px) 90px, 120px', class: 'xmas-flagship-gifts__image', alt: gift_alt, loading: 'lazy' }}
                    </a>
                  {% endif %}
                  <div class="xmas-flagship-gifts__details">
                    {% if block.settings[eyebrow_key] != blank %}<p class="xmas-flagship-gifts__eyebrow">{{ block.settings[eyebrow_key] | escape }}</p>{% endif %}
                    <h4 class="xmas-flagship-gifts__product-title"><a href="{{ gift_product.url | escape }}">{{ gift_title | escape }}</a></h4>
                    {% if block.settings[description_key] != blank %}<p class="xmas-flagship-gifts__description">{{ block.settings[description_key] | escape }}</p>{% endif %}
                    <div class="xmas-flagship-gifts__prices">
                      <span class="xmas-flagship-gifts__price">{{ gift_variant.price | money }}</span>
                      {% if gift_variant.compare_at_price > gift_variant.price %}<s class="xmas-flagship-gifts__compare">{{ gift_variant.compare_at_price | money }}</s>{% endif %}
                    </div>
                    {% if gift_product.has_only_default_variant %}
                      {% form 'product', gift_product, id: form_id, class: 'atc-form xmas-flagship-gifts__actions' %}
                        <input type="hidden" name="id" value="{{ gift_variant.id }}">
                        <button type="submit" name="add" class="btn-atc xmas-flagship-gifts__button"{% unless gift_variant.available %} disabled{% endunless %}>
                          <div class="position-relative"><span>{% if gift_variant.available %}{{ section.settings.button_label | escape }}{% else %}{{ section.settings.sold_out_label | escape }}{% endif %}</span><div class="atc-overlay"><div class="atc-spinner"></div></div></div>
                        </button>
                      {% endform %}
                    {% else %}
                      <div class="form-btn popup-atc xmas-flagship-gifts__actions">
                        <button type="button" class="btn-atc xmas-flagship-gifts__button" data-popup-handle="{{ gift_product.handle | escape }}"{% unless gift_product.available %} disabled{% endunless %}>
                          <div class="position-relative"><span>{% if gift_product.available %}{{ section.settings.button_label | escape }}{% else %}{{ section.settings.sold_out_label | escape }}{% endif %}</span><div class="atc-overlay"><div class="atc-spinner"></div></div></div>
                        </button>
                      </div>
                    {% endif %}
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "xmas Flagship Gifts",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Our flagships reach $300 on their own" },
    { "type": "image_picker", "id": "decoration", "label": "Desktop light decoration" },
    { "type": "image_picker", "id": "mobile_decoration", "label": "Mobile light decoration" },
    { "type": "text", "id": "button_label", "label": "Add to cart label", "default": "Add to Cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold Out" }
  ],
  "blocks": [
    {
      "type": "product_group",
      "name": "Product group",
      "settings": [
        { "type": "select", "id": "color", "label": "Color", "default": "red", "options": [{ "value": "red", "label": "Red" }, { "value": "gold", "label": "Gold" }] },
        { "type": "text", "id": "heading", "label": "Group heading", "default": "Heated vests & jackets" },
        { "type": "text", "id": "link_label", "label": "Collection link text", "default": "Shop the full collection" },
        { "type": "url", "id": "link", "label": "Collection link" },
        { "type": "header", "content": "Product 1" },
        { "type": "product", "id": "product_1", "label": "Product" },
        { "type": "text", "id": "title_1", "label": "Title override", "info": "Leave empty to use the product title." },
        { "type": "text", "id": "eyebrow_1", "label": "Text above title" },
        { "type": "text", "id": "description_1", "label": "Text below title" },
        { "type": "header", "content": "Product 2" },
        { "type": "product", "id": "product_2", "label": "Product" },
        { "type": "text", "id": "title_2", "label": "Title override", "info": "Leave empty to use the product title." },
        { "type": "text", "id": "eyebrow_2", "label": "Text above title" },
        { "type": "text", "id": "description_2", "label": "Text below title" }
      ]
    }
  ],
  "presets": [
    {
      "name": "xmas Flagship Gifts",
      "blocks": [
        { "type": "product_group", "settings": { "color": "red", "heading": "Heated vests & jackets", "eyebrow_1": "Built for -40°F", "description_1": "Two batteries in the box.", "eyebrow_2": "Runs on your bike's 12V", "description_2": "Jacket $199.99 · Pants $179.99" } },
        { "type": "product_group", "settings": { "color": "gold", "heading": "Heated gloves & socks", "eyebrow_1": "Gift pick", "description_1": "Warm fingertips for 6 hours.", "eyebrow_2": "Stocking stuffer", "description_2": "Rechargeable, machine washable." } }
      ]
    }
  ]
}
{% endschema %}
