{% style %}
  #shopify-section-{{ section.id }} .heating-ride-setup {
    width: 100%;
    overflow: hidden;
    background: #f5f5f5;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__inner {
    width: min(100% - 40px, 1340px);
    margin-left: auto;
    margin-right: auto;
    padding: 56px 0 56px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__header {
    max-width: 820px;
    margin: 0 auto 48px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__eyebrow {
    margin: 0 0 16px;
    color: var(--color-brand);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__heading {
    margin: 0 0 24px;
    color: #191919;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__description {
    margin: 0;
    color: #696969;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 20px;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    background: #fff;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__card-title {
    margin: 0 0 4px;
    color: var(--color-brand);
    font-size: 20px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__card-subtitle {
    margin: 0 0 16px;
    color: #191919;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__media {
    position: relative;
    width: 100%;
    height: 283px;
    margin-bottom: 16px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center bottom;
    transition: opacity 220ms ease;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__image--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__image--secondary,
  #shopify-section-{{ section.id }} .heating-ride-setup__image--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__included {
    margin: 0 0 16px;
    color: var(--color-brand);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__features {
    display: grid;
    gap: 10px;
    margin: 0 0 24px;
    padding: 16px 0 0;
    border-top: 1px solid #e4e4e4;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__feature {
    position: relative;
    margin: 0;
    padding-left: 20px;
    color: #191919;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__feature::before {
    content: '';
    position: absolute;
    top: 0.25em;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(185, 50, 5, 0.30);
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__actions {
    display: grid;
    gap: 8px;
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 43px;
    padding: 12px 18px;
    border-radius: 4px;
    background: var(--color-brand);
    color: #fff;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
    transition: background 180ms ease, opacity 180ms ease;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__button:hover {
    opacity: 0.88;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__button-icon {
    width: 1em;
    height: 1em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 10px;
    color: currentColor;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .heating-ride-setup__button-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media only screen and (min-width: 1340px) {
    #shopify-section-{{ section.id }} .heating-ride-setup__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media only screen and (min-width: 768px) and (max-width: 1339px) {
    #shopify-section-{{ section.id }} .heating-ride-setup__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media only screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .heating-ride-setup__card:has(.heating-ride-setup__image--hover):hover .heating-ride-setup__image--main {
      opacity: 0;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__card:has(.heating-ride-setup__image--hover):hover .heating-ride-setup__image--hover {
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__card:has(.heating-ride-setup__button--secondary:hover) .heating-ride-setup__image--main,
    #shopify-section-{{ section.id }} .heating-ride-setup__card:has(.heating-ride-setup__button--secondary:hover) .heating-ride-setup__image--hover {
      opacity: 0;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__card:has(.heating-ride-setup__button--secondary:hover) .heating-ride-setup__image--secondary {
      opacity: 1;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heating-ride-setup__inner {
      width: 100%;
      padding: 12px 20px 28px;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__header {
      max-width: none;
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__eyebrow {
      margin-bottom: 8px;
      font-size: 18px;
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__heading {
      margin-bottom: 24px;
      font-size: 24px;
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__description {
      font-size: 16px;
      line-height: 1.35;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__card {
      padding: 20px;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__media {
      width: 100%;
      max-width: 318px;
      height: 396px;
      margin: 0 auto 16px;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__image--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__image--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__card--has-secondary .heating-ride-setup__media:hover .heating-ride-setup__image--main,
    #shopify-section-{{ section.id }} .heating-ride-setup__card--has-secondary .heating-ride-setup__media:active .heating-ride-setup__image--main {
      opacity: 0;
    }

    #shopify-section-{{ section.id }} .heating-ride-setup__card--has-secondary .heating-ride-setup__media:hover .heating-ride-setup__image--secondary,
    #shopify-section-{{ section.id }} .heating-ride-setup__card--has-secondary .heating-ride-setup__media:active .heating-ride-setup__image--secondary {
      opacity: 1;
    }
  }
{% endstyle %}

<section class="heating-ride-setup">
  <div class="heating-ride-setup__inner">
    <div class="heating-ride-setup__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="heating-ride-setup__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="heating-ride-setup__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="heating-ride-setup__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="heating-ride-setup__grid">
      {%- for block in section.blocks -%}
        {%- assign button_1_link = block.settings.button_1_link | default: '#' -%}
        {%- assign button_2_link = block.settings.button_2_link | default: '#' -%}
        {%- liquid
          assign mobile_main_image = block.settings.mobile_main_image | default: block.settings.main_image
          assign mobile_secondary_image = block.settings.mobile_secondary_image | default: block.settings.secondary_image
          assign mobile_hover_image = block.settings.mobile_hover_image | default: block.settings.hover_image
          assign has_secondary_image = false
          if block.settings.secondary_image != blank or block.settings.mobile_secondary_image != blank
            assign has_secondary_image = true
          endif
        -%}
        <article
          class="heating-ride-setup__card{% if has_secondary_image %} heating-ride-setup__card--has-secondary{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.title != blank -%}
            <h3 class="heating-ride-setup__card-title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.subtitle != blank -%}
            <p class="heating-ride-setup__card-subtitle">{{ block.settings.subtitle }}</p>
          {%- endif -%}

          <div class="heating-ride-setup__media">
            {%- if block.settings.main_image != blank -%}
              {{
                block.settings.main_image
                | image_url: width: 720
                | image_tag:
                  class: 'heating-ride-setup__image heating-ride-setup__image--main heating-ride-setup__image--desktop',
                  loading: 'lazy',
                  widths: '240,320,420,560,720',
                  sizes: '(max-width: 767px) 0px, (max-width: 1339px) calc((100vw - 72px) / 2), 300px',
                  alt: block.settings.main_image.alt | default: block.settings.title
              }}
            {%- endif -%}

            {%- if mobile_main_image != blank -%}
              {{
                mobile_main_image
                | image_url: width: 636
                | image_tag:
                  class: 'heating-ride-setup__image heating-ride-setup__image--main heating-ride-setup__image--mobile',
                  loading: 'lazy',
                  widths: '318,480,636',
                  sizes: '(max-width: 767px) 318px, 0px',
                  alt: mobile_main_image.alt | default: block.settings.title
              }}
            {%- endif -%}

            {%- if block.settings.secondary_image != blank -%}
              {{
                block.settings.secondary_image
                | image_url: width: 720
                | image_tag:
                  class: 'heating-ride-setup__image heating-ride-setup__image--secondary heating-ride-setup__image--desktop',
                  loading: 'lazy',
                  widths: '240,320,420,560,720',
                  sizes: '(max-width: 767px) 0px, (max-width: 1339px) calc((100vw - 72px) / 2), 300px',
                  alt: block.settings.secondary_image.alt | default: block.settings.title
              }}
            {%- endif -%}

            {%- if mobile_secondary_image != blank -%}
              {{
                mobile_secondary_image
                | image_url: width: 636
                | image_tag:
                  class: 'heating-ride-setup__image heating-ride-setup__image--secondary heating-ride-setup__image--mobile',
                  loading: 'lazy',
                  widths: '318,480,636',
                  sizes: '(max-width: 767px) 318px, 0px',
                  alt: mobile_secondary_image.alt | default: block.settings.title
              }}
            {%- endif -%}

            {%- if block.settings.hover_image != blank -%}
              {{
                block.settings.hover_image
                | image_url: width: 720
                | image_tag:
                  class: 'heating-ride-setup__image heating-ride-setup__image--hover heating-ride-setup__image--desktop',
                  loading: 'lazy',
                  widths: '240,320,420,560,720',
                  sizes: '(max-width: 767px) 0px, (max-width: 1339px) calc((100vw - 72px) / 2), 300px',
                  alt: block.settings.hover_image.alt | default: block.settings.title
              }}
            {%- endif -%}

            {%- if mobile_hover_image != blank -%}
              {{
                mobile_hover_image
                | image_url: width: 636
                | image_tag:
                  class: 'heating-ride-setup__image heating-ride-setup__image--hover heating-ride-setup__image--mobile',
                  loading: 'lazy',
                  widths: '318,480,636',
                  sizes: '(max-width: 767px) 318px, 0px',
                  alt: mobile_hover_image.alt | default: block.settings.title
              }}
            {%- endif -%}
          </div>

          {%- if block.settings.included_text != blank -%}
            <p class="heating-ride-setup__included">{{ block.settings.included_text }}</p>
          {%- endif -%}

          <ul class="heating-ride-setup__features">
            {%- if block.settings.feature_1 != blank -%}
              <li class="heating-ride-setup__feature">{{ block.settings.feature_1 }}</li>
            {%- endif -%}
            {%- if block.settings.feature_2 != blank -%}
              <li class="heating-ride-setup__feature">{{ block.settings.feature_2 }}</li>
            {%- endif -%}
            {%- if block.settings.feature_3 != blank -%}
              <li class="heating-ride-setup__feature">{{ block.settings.feature_3 }}</li>
            {%- endif -%}
          </ul>

          <div class="heating-ride-setup__actions">
            {%- if block.settings.button_1_label != blank -%}
              <a class="heating-ride-setup__button heating-ride-setup__button--primary" href="{{ button_1_link }}">
                {{ block.settings.button_1_label }}
                <span class="heating-ride-setup__button-icon" aria-hidden="true">
                  <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.5 9L7.5 6L4.5 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  </svg>
                </span>
              </a>
            {%- endif -%}
            {%- if block.settings.button_2_label != blank -%}
              <a class="heating-ride-setup__button heating-ride-setup__button--secondary" href="{{ button_2_link }}">
                {{ block.settings.button_2_label }}
                <span class="heating-ride-setup__button-icon" aria-hidden="true">
                  <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.5 9L7.5 6L4.5 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  </svg>
                </span>
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Heating Ride Setup",
  "tag": "section",
  "class": "heating-ride-setup-section",
  "settings": [
    {
      "type": "text",
