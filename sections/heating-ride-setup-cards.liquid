        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Button 2 link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heating Ride Setup",
      "blocks": [
        {
          "type": "setup_card",
          "settings": {
            "title": "Everyday Rider",
            "subtitle": "Simple warmth wherever you go.",
