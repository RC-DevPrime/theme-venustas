{% style %}
  #shopify-section-{{ section.id }} .xmas-ways-to-save {
    padding: 80px 0;
    background: #f8f1e6;
    color: #0b4c20;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__inner {
    width: min(calc(100% - 40px), 1340px);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 80px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__holiday {
    display: block;
    width: 30px;
    height: auto;
    flex: 0 0 30px;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__title {
    margin: 0;
    color: inherit;
    font-size: 40px;
    font-weight: 800;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__intro {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__grid {
    display: grid;
    grid-template-columns: minmax(0, 400fr) 30px minmax(0, 433.34fr) 30px minmax(0, 433.34fr);
    gap: 3.33px;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    padding: 40px 36px 36px;
    border-top: 4px solid currentColor;
    border-radius: 12px;
    background: #fffdf9;
    color: #0b4c20;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__card--2 { color: #b93205; }
  #shopify-section-{{ section.id }} .xmas-ways-to-save__card--3 { color: #bc8d00; }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
    box-shadow: 0 8px 28px rgba(95, 73, 35, .12);
  }

  @media (min-width: 768px) and (hover: hover) and (pointer: fine) {
    #shopify-section-{{ section.id }} .xmas-ways-to-save__card:hover {
      box-shadow: 0 8px 28px rgba(95, 73, 35, .12);
    }
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__ribbon {
    position: absolute;
    top: -28px;
    right: 36px;
    display: block;
    width: 105px;
    height: auto;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    color: inherit;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -.55px;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    border-radius: 50%;
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__number span {
    color: #fffdf9;
    font-weight: 800;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__offer {
    margin: 0;
    font-size: 34px;
    font-weight: 800;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__description {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__link {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__link-text {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__arrow {
    display: block;
    width: 16px;
    height: auto;
    flex: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__separator {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(185, 50, 5, .12);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .xmas-ways-to-save__separator--plus {
    font-size: 24px;
    font-weight: 400;
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .xmas-ways-to-save__card { padding: 32px 20px; }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__label { font-size: 18px; }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__offer { font-size: 28px; }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .xmas-ways-to-save { padding: 24px 0 32px; }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__header {
      gap: 20px;
      margin-bottom: 20px;
      text-align: left;
    }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__holiday {
      width: 20px;
      flex-basis: auto;
    }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__holiday--end { display: none; }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__title { font-size: 24px; }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__title-line { display: block; }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__card {
      gap: 12px;
      padding: 22px 20px;
      border-top-width: 3px;
      border-radius: 10px;
      box-shadow: 0 8px 28px rgba(95, 73, 35, .12);
    }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__ribbon {
      top: -17px;
      right: 8px;
      width: 62px;
    }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__label {
      gap: 10px;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: 0;
    }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__number {
      width: 28px;
      height: 28px;
      flex-basis: 28px;
      font-size: 15.4px;
    }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__offer { font-size: 24px; }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__description { line-height: 1.45; }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__link { gap: 8px; font-size: 16px; }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__arrow { width: 20px; flex-basis: 20px; }
    #shopify-section-{{ section.id }} .xmas-ways-to-save__separator { justify-self: center; }
  }
{% endstyle %}

<section class="xmas-ways-to-save" aria-labelledby="xmas-ways-title-{{ section.id }}">
  <div class="xmas-ways-to-save__inner">
    <header class="xmas-ways-to-save__header">
      <div class="xmas-ways-to-save__heading">
        {% if section.settings.holiday_icon != blank %}
          {{ section.settings.holiday_icon | image_url: width: 90 | image_tag: class: 'xmas-ways-to-save__holiday', alt: '', loading: 'lazy' }}
        {% endif %}
        <h2 class="xmas-ways-to-save__title" id="xmas-ways-title-{{ section.id }}">3 Ways to Save. <span class="xmas-ways-to-save__title-line">All Applied in Cart.</span></h2>
        {% if section.settings.holiday_icon != blank %}
          {{ section.settings.holiday_icon | image_url: width: 90 | image_tag: class: 'xmas-ways-to-save__holiday xmas-ways-to-save__holiday--end', alt: '', loading: 'lazy' }}
        {% endif %}
      </div>
      <p class="xmas-ways-to-save__intro">Every product is tagged with the deal it gets. An item gets ① or ②, never both. ③ works on top of everything in your cart</p>
    </header>
    <div class="xmas-ways-to-save__grid">
      {% for index in (1..3) %}
        {% liquid
          assign link_key = 'link_' | append: index
          assign ribbon_key = 'ribbon_' | append: index
          assign arrow_key = 'arrow_' | append: index
          assign card_link = section.settings[link_key]
          assign ribbon = section.settings[ribbon_key]
          assign arrow = section.settings[arrow_key]
          case index
            when 1
              assign label = 'Buy More, Save More'
              assign description = 'On select heated apparel. Mix and match any styles tagged ①.'
              assign link_text = 'Shop ① styles'
            when 2
              assign label = 'Weekly Deals'
              assign description = 'Save on featured styles. See each discount on its product tag.'
              assign link_text = 'Shop ② deals'
            when 3
              assign label = 'Spend $300+'
              assign description = 'Stacks on ① and ②. Volcano, Apex, batteries and accessories count.'
              assign link_text = 'See how it adds up'
          endcase
        %}
        {% if index == 2 %}<span class="xmas-ways-to-save__separator">OR</span>{% elsif index == 3 %}<span class="xmas-ways-to-save__separator xmas-ways-to-save__separator--plus">+</span>{% endif %}
        {% if card_link != blank %}
          <a class="xmas-ways-to-save__card xmas-ways-to-save__card--{{ index }}" href="{{ card_link | escape }}">
        {% else %}
          <div class="xmas-ways-to-save__card xmas-ways-to-save__card--{{ index }}">
        {% endif %}
          {% if ribbon != blank %}
            {{ ribbon | image_url: width: 315 | image_tag: class: 'xmas-ways-to-save__ribbon', alt: '', loading: 'lazy' }}
          {% endif %}
          <h3 class="xmas-ways-to-save__label"><span class="xmas-ways-to-save__number"><span>{{ index }}</span></span>{{ label }}</h3>
          <p class="xmas-ways-to-save__offer">
            {% case index %}
              {% when 1 %}$20 off 1 PC<br>$50 off 2+ PCS
              {% when 2 %}This week’s picks, for less
              {% when 3 %}Extra $30 off sitewide
            {% endcase %}
          </p>
          <p class="xmas-ways-to-save__description">{{ description }}</p>
          {% if card_link != blank %}
            <span class="xmas-ways-to-save__link">
              <span class="xmas-ways-to-save__link-text">{{ link_text }}</span>
              {% if arrow != blank %}
                {{ arrow | image_url: width: 60 | image_tag: class: 'xmas-ways-to-save__arrow', alt: '', loading: 'lazy' }}
              {% endif %}
            </span>
          {% endif %}
        {% if card_link != blank %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "xmas Ways to Save",
  "settings": [
    { "type": "image_picker", "id": "holiday_icon", "label": "Christmas tree icon" },
    { "type": "header", "content": "1. Buy More, Save More" },
    { "type": "url", "id": "link_1", "label": "Card and text link" },
    { "type": "image_picker", "id": "ribbon_1", "label": "Green ribbon" },
    { "type": "image_picker", "id": "arrow_1", "label": "Green arrow icon" },
    { "type": "header", "content": "2. Weekly Deals" },
    { "type": "url", "id": "link_2", "label": "Card and text link" },
    { "type": "image_picker", "id": "ribbon_2", "label": "Red ribbon" },
    { "type": "image_picker", "id": "arrow_2", "label": "Red arrow icon" },
    { "type": "header", "content": "3. Spend $300+" },
    { "type": "url", "id": "link_3", "label": "Card and text link" },
    { "type": "image_picker", "id": "ribbon_3", "label": "Gold ribbon" },
    { "type": "image_picker", "id": "arrow_3", "label": "Gold arrow icon" }
  ],
  "presets": [{ "name": "xmas Ways to Save" }]
}
{% endschema %}
