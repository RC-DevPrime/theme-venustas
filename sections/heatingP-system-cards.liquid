  "tag": "section",
  "class": "heatingP-system-cards-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "One System. Multiple Ways To Ride Warmer." },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Our modular system lets you build your ideal setup. Start simple or go full system - the choice is yours." }
