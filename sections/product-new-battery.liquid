{%- capture certificate_icons -%}
  {%- for index in (1..7) -%}
    {%- assign setting_key = 'show_certificate_' | append: index -%}
    {%- if section.settings[setting_key] -%}
      {%- assign icon_name = 'certificate' | append: index -%}
      {%- capture icon_markup -%}{%- render 'product-certified-icons', icon: icon_name -%}{%- endcapture -%}
      {%- assign icon_markup = icon_markup | strip -%}
      {%- if icon_markup != blank -%}<span class="product-new-battery__certificate" aria-hidden="true">{{ icon_markup }}</span>{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{% style %}
  #shopify-section-{{ section.id }} .product-new-battery {
    padding: 80px 0;
    background: #1a1a1a;
    color: #fff;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .product-new-battery__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 556px);
    gap: 56px;
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .product-new-battery__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-new-battery__header,
  #shopify-section-{{ section.id }} .product-new-battery__certification {
    display: grid;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .product-new-battery p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .product-new-battery__eyebrow {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.68;
    letter-spacing: 1.21px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .product-new-battery__heading {
    color: inherit;
    font-size: 34px;
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -.9px;
  }

  #shopify-section-{{ section.id }} .product-new-battery__heading strong {
    font-size: 48px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .product-new-battery__text {
    font-size: 16px;
    line-height: 24px;
  }

  #shopify-section-{{ section.id }} .product-new-battery__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .product-new-battery__metric {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4px;
    min-width: 0;
    min-height: 111px;
    padding: 20px 16px;
    box-sizing: border-box;
    border: 1px solid rgba(150, 180, 255, .5);
    border-radius: 12px;
  }

  #shopify-section-{{ section.id }} .product-new-battery__metric-value {
    font-size: 30px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -.9px;
  }

  #shopify-section-{{ section.id }} .product-new-battery__small {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  #shopify-section-{{ section.id }} .product-new-battery__safety {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .product-new-battery__shield {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .product-new-battery__certificates {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }

  #shopify-section-{{ section.id }} .product-new-battery__certificate {
    flex: 0 0 60px;
    width: 60px;
    height: 60px;
    color: #47d5fb;
  }

  #shopify-section-{{ section.id }} .product-new-battery__shield svg,
  #shopify-section-{{ section.id }} .product-new-battery__certificate svg,
  #shopify-section-{{ section.id }} .product-new-battery__lightning svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .product-new-battery__card {
    min-width: 0;
    padding: 24px 28px 28px;
    border: 1px solid rgba(150, 180, 255, .5);
    border-radius: 12px;
    box-shadow: 0 0 40px rgba(255, 159, 135, .16);
  }

  #shopify-section-{{ section.id }} .product-new-battery__media {
    background: radial-gradient(ellipse, rgba(2, 43, 157, .6), rgba(14, 35, 92, .8) 50%, rgba(20, 30, 59, .9) 75%, #1a1a1a);
  }

  #shopify-section-{{ section.id }} .product-new-battery__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 498 / 412;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .product-new-battery__progress {
    position: relative;
    height: 30px;
    margin-top: 20px;
    overflow: hidden;
    box-sizing: border-box;
    border: 1.5px solid #3a4060;
    border-radius: 999px;
    background: #1b2036;
  }

  #shopify-section-{{ section.id }} .product-new-battery__fill {
    height: 100%;
    background: linear-gradient(to right, #1fbf6a, #7be495);
    animation: product-new-battery-charge-{{ section.id }} 4.010837s linear infinite;
  }

  #shopify-section-{{ section.id }} .product-new-battery__lightning {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 22px;
    color: #fff;
    transform: translate(-50%, -50%);
  }

  #shopify-section-{{ section.id }} .product-new-battery__charging {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .product-new-battery__full {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .product-new-battery__dimensions {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid #333;
  }

  @keyframes product-new-battery-charge-{{ section.id }} {
    0% { width: 0; }
    74.35%, 100% { width: 100%; }
  }

  @keyframes product-new-battery-charge-mobile-{{ section.id }} {
    from { width: 0; }
    to { width: 100%; }
  }

  @media only screen and (min-width: 768px) and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .product-new-battery__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-new-battery__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    #shopify-section-{{ section.id }} .product-new-battery__heading {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .product-new-battery__heading strong {
      font-size: 32px;
    }

    #shopify-section-{{ section.id }} .product-new-battery__metrics {
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .product-new-battery__metric {
      justify-content: flex-start;
      min-height: 130px;
      padding: 16px;
    }

    #shopify-section-{{ section.id }} .product-new-battery__metric:nth-child(2) {
      order: 3;
      min-height: 150px;
    }

    #shopify-section-{{ section.id }} .product-new-battery__metric:nth-child(3) {
      order: 2;
    }

    #shopify-section-{{ section.id }} .product-new-battery__metric:nth-child(4) {
      order: 4;
      min-height: 150px;
    }

    #shopify-section-{{ section.id }} .product-new-battery__certification {
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .product-new-battery__certificates {
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .product-new-battery__certificate {
      flex-basis: 38px;
      width: 38px;
      height: 39px;
    }

    #shopify-section-{{ section.id }} .product-new-battery__card {
      padding-right: 12px;
      padding-left: 12px;
    }

    #shopify-section-{{ section.id }} .product-new-battery__image {
      aspect-ratio: 324 / 379;
    }

    #shopify-section-{{ section.id }} .product-new-battery__fill {
      animation-name: product-new-battery-charge-mobile-{{ section.id }};
      animation-duration: 2s;
    }

    #shopify-section-{{ section.id }} .product-new-battery__charging {
      margin-top: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .product-new-battery__fill {
      width: 100%;
      animation: none;
    }
  }
{% endstyle %}

<section class="product-new-battery">
  <div class="product-new-battery__inner">
    <div class="product-new-battery__content">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
        <div class="product-new-battery__header">
          {%- if section.settings.eyebrow != blank -%}<p class="product-new-battery__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<div class="product-new-battery__heading" role="heading" aria-level="2">{{ section.settings.heading }}</div>{%- endif -%}
          {%- if section.settings.description != blank -%}<p class="product-new-battery__text">{{ section.settings.description | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      {%- capture metrics -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.value != blank or block.settings.description != blank -%}
            <div class="product-new-battery__metric" {{ block.shopify_attributes }}>
              {%- if block.settings.value != blank -%}<p class="product-new-battery__metric-value">{{ block.settings.value | escape }}</p>{%- endif -%}
              {%- if block.settings.description != blank -%}<p class="product-new-battery__small">{{ block.settings.description | escape }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if metrics != blank -%}<div class="product-new-battery__metrics">{{ metrics }}</div>{%- endif -%}
      {%- if section.settings.safety_heading != blank or certificate_icons != blank or section.settings.safety_note != blank -%}
        <div class="product-new-battery__certification">
          {%- if section.settings.safety_heading != blank -%}<div class="product-new-battery__safety"><span class="product-new-battery__shield">{% render 'heating-icons', icon: 'shield-check' %}</span><p>{{ section.settings.safety_heading | escape }}</p></div>{%- endif -%}
          {%- if certificate_icons != blank -%}<div class="product-new-battery__certificates">{{ certificate_icons }}</div>{%- endif -%}
          {%- if section.settings.safety_note != blank -%}<p class="product-new-battery__small">{{ section.settings.safety_note | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="product-new-battery__card">
      {%- if section.settings.image != blank -%}<div class="product-new-battery__media">{{ section.settings.image | image_url: width: 1200 | image_tag: class: 'product-new-battery__image', loading: 'lazy', widths: '350, 500, 750, 1000, 1200', sizes: '(max-width: 767px) calc(100vw - 66px), (max-width: 1199px) 50vw, 498px' }}</div>{%- endif -%}
      <div class="product-new-battery__progress" aria-hidden="true"><div class="product-new-battery__fill"></div><span class="product-new-battery__lightning">{% render 'heating-icons', icon: 'lightning' %}</span></div>
      {%- if section.settings.charging_label != blank or section.settings.full_label != blank -%}
        <div class="product-new-battery__charging">
          {%- if section.settings.charging_label != blank -%}<p class="product-new-battery__text">{{ section.settings.charging_label | escape }}</p>{%- endif -%}
          {%- if section.settings.full_label != blank -%}<p class="product-new-battery__full">{{ section.settings.full_label | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.dimensions != blank -%}<div class="product-new-battery__dimensions"><p class="product-new-battery__text">{{ section.settings.dimensions | escape }}</p></div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "productN Battery",
  "tag": "section",
  "class": "product-new-battery-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PowerCore™ battery" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p><strong>5K</strong> battery · <strong>36</strong>Wh</p>" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Standard, Pro and Max share the same vest, six zones and temperatures. The battery is the only difference — and it decides the runtime." },
    { "type": "text", "id": "safety_heading", "label": "Certification heading", "default": "Safety certified" },
    { "type": "checkbox", "id": "show_certificate_1", "label": "Show certificate1", "default": true },
    { "type": "checkbox", "id": "show_certificate_2", "label": "Show certificate2", "default": true },
    { "type": "checkbox", "id": "show_certificate_3", "label": "Show certificate3", "default": true },
    { "type": "checkbox", "id": "show_certificate_4", "label": "Show certificate4", "default": true },
    { "type": "checkbox", "id": "show_certificate_5", "label": "Show certificate5", "default": true },
    { "type": "checkbox", "id": "show_certificate_6", "label": "Show certificate6", "default": true },
    { "type": "checkbox", "id": "show_certificate_7", "label": "Show certificate7", "default": true },
    { "type": "textarea", "id": "safety_note", "label": "Certification note", "default": "UN38.3 is the UN transport test for lithium batteries — the battery is TSA-friendly in your carry-on." },
    { "type": "image_picker", "id": "image", "label": "Battery image" },
    { "type": "text", "id": "charging_label", "label": "Charging label", "default": "Charging over USB-C" },
    { "type": "text", "id": "full_label", "label": "Full-charge label", "default": "Full in 2.5 h" },
    { "type": "text", "id": "dimensions", "label": "Dimensions and weight", "default": "3.15 × 2.60 × 1.02 in · 6.56 oz" }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Battery metric",
      "settings": [
        { "type": "text", "id": "value", "label": "Value" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "productN Battery",
      "blocks": [
        { "type": "metric", "settings": { "value": "36Wh", "description": "5000mAh @ 7.2V (36Wh)" } },
        { "type": "metric", "settings": { "value": "2.5 h", "description": "with a 20W USB-C charger (not included)" } },
        { "type": "metric", "settings": { "value": "1,000", "description": "charge cycles" } },
        { "type": "metric", "settings": { "value": "3 ports", "description": "DC to the vest · USB-A and USB-C to charge your phone" } }
      ]
    }
  ]
}
{% endschema %}
