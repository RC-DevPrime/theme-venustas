{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .container {
    padding-left: 40px;
    padding-right: 40px;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .container {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
  #shopify-section-{{ section.id }} .for-her-pf {
    padding: 80px 0;
  }
  #shopify-section-{{ section.id }} .for-her-pf__header {
    text-align: center;
    margin-bottom: 40px;
  }
  #shopify-section-{{ section.id }} .for-her-pf__heading {
    font-size: clamp(22px, 2.6vw, 40px);
    font-weight: 800;
    color: {{ section.settings.accent_color }};
    margin-bottom: 16px;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .for-her-pf__desc {
    color: #888;
    font-size: 15px;
    line-height: 1.75;
    max-width: 760px;
    margin: 0 auto;
  }
  /* Feature row (icon + text) */
  #shopify-section-{{ section.id }} .for-her-pf__features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }
  #shopify-section-{{ section.id }} .for-her-pf__feat {
    text-align: center;
  }
  #shopify-section-{{ section.id }} .for-her-pf__feat-icon {
    width: 60px;
    height: 60px;
    margin: 0 auto 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .for-her-pf__feat-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  #shopify-section-{{ section.id }} .for-her-pf__feat-icon svg {
    width: 100%;
    height: 100%;
    stroke: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .for-her-pf__feat-text {
    font-size: 13px;
    color: #777;
    line-height: 1.6;
    max-width: 180px;
    margin: 0 auto;
  }
  /* Gallery row */
  #shopify-section-{{ section.id }} .for-her-pf__gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .for-her-pf__photo {
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #f2f2f2;
  }
  #shopify-section-{{ section.id }} .for-her-pf__photo img,
  #shopify-section-{{ section.id }} .for-her-pf__photo svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .for-her-pf {
      padding: 50px 0;
    }
    #shopify-section-{{ section.id }} .for-her-pf__features {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 16px;
    }
    #shopify-section-{{ section.id }} .for-her-pf__gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
{% endstyle %}

<div class="for-her-pf">
  <div class="container">
    <div class="for-her-pf__header">
      {% if section.settings.heading != blank %}
        <h2 class="for-her-pf__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="for-her-pf__desc">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    {% assign has_features = false %}
    {% for block in section.blocks %}
      {% if block.type == 'feature' %}{% assign has_features = true %}{% endif %}
    {% endfor %}

    {% if has_features %}
      <div class="for-her-pf__features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="for-her-pf__feat" {{ block.shopify_attributes }}>
              <div class="for-her-pf__feat-icon">
                {% if block.settings.icon != blank %}
                  <img src="{{ block.settings.icon | img_url: 'master' }}" alt="{{ block.settings.text | strip_html | truncate: 40 }}">
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v10M7 12h10"></path></svg>
                {% endif %}
              </div>
              {% if block.settings.text != blank %}
                <p class="for-her-pf__feat-text">{{ block.settings.text }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="for-her-pf__gallery">
      {% for block in section.blocks %}
        {% if block.type == 'gallery' %}
          <div class="for-her-pf__photo" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ section.settings.heading }}" loading="lazy">
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "For Her - Product Feature",
  "class": "for-her-product-feature-section",
  "templates": ["page"],
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Heading & Icon Color",
      "default": "#B93205"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Quilted Heated Down Coat | W62"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional)",
          "info": "Leave blank to use a default circle icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "Built-in heating zones"
        }
      ]
    },
    {
      "type": "gallery",
      "name": "Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [{
    "name": "For Her - Product Feature",
    "blocks": [
      { "type": "feature" },
      { "type": "feature" },
      { "type": "feature" },
      { "type": "feature" },
      { "type": "gallery" },
      { "type": "gallery" },
      { "type": "gallery" },
      { "type": "gallery" }
    ]
  }]
}
{% endschema %}