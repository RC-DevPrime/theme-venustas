{%- comment -%}
  Product Kit Options
  Two (or more) purchase-option cards, e.g. "Cooling Vest Kit" vs "Vest Only".
  Each card: badge, title, image, included list. In the list textarea, prefix a
  line with "-" to show it as NOT included (greyed, no check).
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    --ko-accent: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .container {
    padding-left: 40px;
    padding-right: 40px;
  }
  #shopify-section-{{ section.id }} .ko {
    padding: 64px 0;
  }
  #shopify-section-{{ section.id }} .ko__heading {
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    text-align: center;
    margin-bottom: 40px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .ko__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    gap: 22px;
    align-items: stretch;        /* equal-height cards */
  }
  #shopify-section-{{ section.id }} .ko__card {
    position: relative;
    background: {{ section.settings.card_bg }};
    border: 1.5px solid #e6eaec;
    border-radius: 18px;
    overflow: visible;           /* let the ribbon pill stick up */
    display: flex;
    flex-direction: column;
  }
  #shopify-section-{{ section.id }} .ko__card.is-featured {
    border-color: var(--ko-accent);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
  }
  /* Centered pill tab on the top edge (not a full-width bar) */
  #shopify-section-{{ section.id }} .ko__ribbon {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--ko-accent);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 8px 26px;
    border-radius: 999px;
    white-space: nowrap;
    z-index: 3;
    box-shadow: 0 5px 14px rgba(28,128,254,0.30);
  }
  #shopify-section-{{ section.id }} .ko__body {
    padding: 32px 24px 26px;     /* uniform top padding → titles align across cards */
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  #shopify-section-{{ section.id }} .ko__title {
    text-align: center;
    font-size: 18px;
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    text-transform: uppercase;
    line-height: 1.25;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .ko__title-accent { color: var(--ko-accent); display: block; }
  #shopify-section-{{ section.id }} .ko__title-main { color: {{ section.settings.heading_color }}; display: block; }
  #shopify-section-{{ section.id }} .ko__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #eef1f3;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 18px;
  }
  #shopify-section-{{ section.id }} .ko__img img,
  #shopify-section-{{ section.id }} .ko__img svg {
    width: 100%; height: 100%; object-fit: contain; display: block;
  }
  #shopify-section-{{ section.id }} .ko__list { list-style: none; margin: 0; padding: 0; }
  #shopify-section-{{ section.id }} .ko__li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 0;
    font-size: 14px;
    line-height: 1.5;
    color: #333;
  }
  #shopify-section-{{ section.id }} .ko__li.is-off { color: #aeb4b8; }
  #shopify-section-{{ section.id }} .ko__ico { flex: none; width: 18px; height: 18px; margin-top: 1px; color: var(--ko-accent); }
  #shopify-section-{{ section.id }} .ko__li.is-off .ko__ico { color: #ccd1d4; }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .container { padding-left: 20px; padding-right: 20px; }
    #shopify-section-{{ section.id }} .ko { padding: 44px 0; }
    {% if section.settings.mobile_scroll %}
      /* Horizontal swipe row */
      #shopify-section-{{ section.id }} .ko__grid {
        display: flex;
        grid-template-columns: none;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
        gap: 14px;
        padding-top: 22px;       /* 给凸出的 "Most Recommended" 角标留出空间 */
        padding-bottom: 6px;
        margin-left: -20px;
        margin-right: -20px;
        padding-left: 20px;
        padding-right: 20px;
      }
      #shopify-section-{{ section.id }} .ko__grid::-webkit-scrollbar { display: none; }
      #shopify-section-{{ section.id }} .ko__card {
        flex: 0 0 84%;
        scroll-snap-align: center;
      }
    {% else %}
      #shopify-section-{{ section.id }} .ko__grid { grid-template-columns: 1fr; gap: 16px; }
    {% endif %}
  }
{% endstyle %}

<div class="ko">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="ko__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="ko__grid">
      {% for block in section.blocks %}
        <div class="ko__card {% if block.settings.featured %}is-featured{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.ribbon != blank %}
            <div class="ko__ribbon">{{ block.settings.ribbon }}</div>
          {% endif %}
          <div class="ko__body">
            {% if block.settings.title != blank %}
              {% assign tparts = block.settings.title | split: '—' %}
              <div class="ko__title">
                {% if tparts.size > 1 %}
                  <span class="ko__title-accent">{{ tparts[0] | strip }} —</span>
                  <span class="ko__title-main">{{ tparts[1] | strip }}</span>
                {% else %}
                  {{ block.settings.title }}
                {% endif %}
              </div>
            {% endif %}
            <div class="ko__img">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            {% if block.settings.items != blank %}
              <ul class="ko__list">
                {% assign lines = block.settings.items | newline_to_br | split: '<br />' %}
                {% for line in lines %}
                  {% assign clean = line | strip %}
                  {% assign first_char = clean | slice: 0 %}
                  {% if clean != blank %}
                    {% if first_char == '-' %}
                      {% assign txt = clean | remove_first: '-' | strip %}
                      <li class="ko__li is-off">
                        <svg class="ko__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        <span>{{ txt }}</span>
                      </li>
                    {% else %}
                      <li class="ko__li">
                        <svg class="ko__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>{{ clean }}</span>
                      </li>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kit Options",
  "class": "product-kit-options-section",
  "settings": [
    { "type": "checkbox", "id": "enabled_section_child_scroll", "label": "Enable scroll nav anchor", "default": false },
    { "type": "text", "id": "section_scroll_nav", "label": "Scroll Nav Group" },
    { "type": "text", "id": "nav_title", "label": "Nav Title" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#17A6C2" },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Mobile: horizontal swipe", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose Your Setup" }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Option Card",
      "settings": [
        { "type": "checkbox", "id": "featured", "label": "Highlight (recommended)", "default": false },
        { "type": "text", "id": "ribbon", "label": "Ribbon Label", "info": "e.g. Most Recommended. Leave blank for none." },
        { "type": "text", "id": "title", "label": "Title", "default": "Cooling Vest Kit" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "textarea", "id": "items", "label": "Included Items", "info": "One per line. Start a line with '-' to show it as NOT included (greyed out)." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kit Options",
      "blocks": [
        { "type": "option", "settings": { "featured": true, "ribbon": "Most Recommended", "title": "Cooling Vest Kit — Everything Included", "items": "Cooling Vest\nRechargeable Battery\n2 Reusable Ice Packs" } },
        { "type": "option", "settings": { "title": "Vest Only — Use Your Own Power Bank", "items": "Cooling Vest\n-Rechargeable Battery\n-Ice Packs" } }
      ]
    }
  ]
}
{% endschema %}