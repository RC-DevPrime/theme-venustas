{% style %}
  #shopify-section-{{ section.id }} .heatingv-power {
    width: 100%;
    overflow: hidden;
    background: #14161a;
    color: #fff;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .heatingv-power__inner {
    display: flex;
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 100px 0;
    box-sizing: border-box;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  #shopify-section-{{ section.id }} .heatingv-power__header {
    display: flex;
    width: min(100%, 1340px);
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .heatingv-power__eyebrow-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .heatingv-power__eyebrow,
  #shopify-section-{{ section.id }} .heatingv-power__title,
  #shopify-section-{{ section.id }} .heatingv-power__description {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heatingv-power__eyebrow {
    color: #c03000;
    font-size: 16px;
    font-weight: 600;
    line-height: 18.48px;
    letter-spacing: 4px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .heatingv-power__title {
    color: #fff;
    font-size: 34px;
    font-weight: 700;
    line-height: 39.44px;
    letter-spacing: -0.952px;
    text-transform: uppercase;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heatingv-power__description {
    max-width: 1040px;
    color: #d0d0d0;
    font-size: 16px;
    font-weight: 400;
    line-height: 27.52px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heatingv-power__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heatingv-power__media {
    position: relative;
    width: min(100%, 1340px);
    aspect-ratio: 1340 / 728;
    overflow: hidden;
    border-radius: 12px;
    background: #000;
  }

  #shopify-section-{{ section.id }} .heatingv-power__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .heatingv-power__close-button {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, .72);
    color: #fff;
    cursor: pointer;
    font-size: 28px;
    line-height: 40px;
  }

  #shopify-section-{{ section.id }} .heatingv-power__media.is-video-fullscreen {
    position: fixed;
    z-index: 2147483647;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    border-radius: 0;
    background: #000;
  }

  #shopify-section-{{ section.id }} .heatingv-power__placeholder {
    width: 100%;
    height: 100%;
    background: #1c1f24;
  }
  @media only screen and (min-width: 1280px) and (max-width: 1600px) {
    #shopify-section-{{ section.id }} .heatingv-power__media{
      max-width: 1000px;
      max-height:500px;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingv-power{
      background: #f0f0f0;
    }
    #shopify-section-{{ section.id }} .heatingv-power__title,
    #shopify-section-{{ section.id }} .heatingv-power__description {
      text-align: left;
      color: #14161a;
    }
    #shopify-section-{{ section.id }} .heatingv-power__inner {
      width: 100%;
      padding: 56px 20px;
      gap: 32px;
    }

    #shopify-section-{{ section.id }} .heatingv-power__header {
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .heatingv-power__eyebrow-wrap {
      gap: 4px;
      align-items: flex-start;
    }

    #shopify-section-{{ section.id }} .heatingv-power__eyebrow {
      font-size: 13px;
      line-height: 1.2;
      letter-spacing: 2px;
      white-space: normal;
    }

    #shopify-section-{{ section.id }} .heatingv-power__title {
      font-size: 24px;
      line-height: 1.3;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heatingv-power__description {
      font-size: 14px;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .heatingv-power__media {
      border-radius: 8px;
    }
  }
{% endstyle %}

<section class="heatingv-power" id="heatingv-origin">
  <div class="heatingv-power__inner">
    <header class="heatingv-power__header">
      <div class="heatingv-power__eyebrow-wrap">
        {%- if section.settings.eyebrow != blank -%}
          <p class="heatingv-power__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="heatingv-power__title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.description != blank -%}
        <div class="heatingv-power__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </header>

    <div class="heatingv-power__media">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            class: 'heatingv-power__video js-autoplay-in-view',
            loop: true,
            muted: true,
            playsinline: true,
            controls: true,
            preload: 'none',
            image_size: '1400x'
        }}
        <button type="button" class="heatingv-power__close-button" data-video-fullscreen-toggle aria-label="Open video fullscreen">⛶</button>
      {%- else -%}
        <div class="heatingv-power__placeholder"></div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionRoot || sectionRoot.dataset.inViewVideoReady === 'true') return;

    const videos = sectionRoot.querySelectorAll('.js-autoplay-in-view');
    if (!videos.length) return;
    sectionRoot.dataset.inViewVideoReady = 'true';

    videos.forEach((video) => {
      video.setAttribute('controlslist', 'nofullscreen noremoteplayback');
      video.setAttribute('disablepictureinpicture', '');
      const media = video.closest('.heatingv-power__media');
      const button = media?.querySelector('[data-video-fullscreen-toggle]');
      if (!media || !button) return;

      button.addEventListener('click', () => {
        if (media.classList.contains('is-video-fullscreen')) {
          if (document.fullscreenElement === media && document.exitFullscreen) document.exitFullscreen().catch(() => {});
          media.classList.remove('is-video-fullscreen');
          button.textContent = '⛶';
          button.setAttribute('aria-label', 'Open video fullscreen');
          return;
        }

        media.classList.add('is-video-fullscreen');
        button.textContent = '×';
        button.setAttribute('aria-label', 'Close video fullscreen');
        if (media.requestFullscreen) media.requestFullscreen().catch(() => {});
      });
    });

    document.addEventListener('fullscreenchange', () => {
      sectionRoot.querySelectorAll('.heatingv-power__media.is-video-fullscreen').forEach((media) => {
        if (document.fullscreenElement === media) return;
        media.classList.remove('is-video-fullscreen');
        const button = media.querySelector('[data-video-fullscreen-toggle]');
        if (button) {
          button.textContent = '⛶';
          button.setAttribute('aria-label', 'Open video fullscreen');
        }
      });
    });

    const playVideo = (video) => {
      const playPromise = video.play();
      if (playPromise) playPromise.catch(() => {});
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) playVideo(entry.target);
          else entry.target.pause();
        });
      }, { threshold: 0.15 });

      videos.forEach((video) => observer.observe(video));
      sectionRoot.inViewVideoObserver = observer;

      document.addEventListener('shopify:section:unload', function unload(event) {
        if (event.detail.sectionId !== '{{ section.id }}') return;
        observer.disconnect();
        document.removeEventListener('shopify:section:unload', unload);
      });
    } else {
      videos.forEach(playVideo);
    }
  })();
</script>

{% schema %}
{
  "name": "HeatingV Power",
  "tag": "section",
  "class": "heatingv-power-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How Volcano™ Started"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "You Asked More Heat. So We Built Volcano™"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Year after year, the riders, anglers and crews who stayed out longest told us the same two things: more heat when it really gets cold, and more time before the battery gives out. Volcano is our answer.</p>"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (MP4 recommended)"
    }
  ],
  "presets": [
    {
      "name": "HeatingV Power"
    }
  ]
}
{% endschema %}
