{% style %}
  #shopify-section-{{ section.id }} .product-battery-systems {
    width: 100%;
    background: #10171F;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__inner {
    position: relative;
    width: min(100% - 40px, 1240px);
    margin: 0 auto;
    padding: 72px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__stage {
    position: relative;
    min-height: 575px;
    overflow: hidden;
    background: #1a2532;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__image--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__content {
    position: relative;
    z-index: 1;
    min-height: 575px;
    padding: 46px 32px 50px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__heading {
    margin: 0;
    color: #fff;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__heading-accent {
    color: var(--color-brand, #B93205);
  }

  #shopify-section-{{ section.id }} .product-battery-systems__list {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__item {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
    white-space: nowrap;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__item:nth-child(1) {
    left: 28px;
    top: 235px;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__item:nth-child(2) {
    left: 28px;
    top: 306px;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__item:nth-child(3) {
    left: 28px;
    top: 376px;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__item:nth-child(n + 4) {
    flex-direction: row-reverse;
    right: 28px;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__item:nth-child(4) {
    top: 235px;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__item:nth-child(5) {
    top: 306px;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__item:nth-child(6) {
    top: 376px;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__icon {
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    color: #fff;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .product-battery-systems__label {
    display: block;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-battery-systems__inner {
      width: 100%;
      padding: 40px 20px;
    }

    #shopify-section-{{ section.id }} .product-battery-systems__stage {
      min-height: 0;
      aspect-ratio: 350 / 608;
    }

    #shopify-section-{{ section.id }} .product-battery-systems__image--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .product-battery-systems__image--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .product-battery-systems__content {
      min-height: 0;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 32px 0 18px;
    }

    #shopify-section-{{ section.id }} .product-battery-systems__heading {
      padding: 0 10px;
      font-size: 18px;
      line-height: 1.35;
    }

    #shopify-section-{{ section.id }} .product-battery-systems__list {
      position: relative;
      inset: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px 4px;
      padding: 0 0 0;
      pointer-events: auto;
    }

    #shopify-section-{{ section.id }} .product-battery-systems__item,
    #shopify-section-{{ section.id }} .product-battery-systems__item:nth-child(n) {
      position: static;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      min-width: 0;
      color: #fff;
      font-size: 10px;
      line-height: 1.1;
      text-align: center;
      white-space: normal;
    }

    #shopify-section-{{ section.id }} .product-battery-systems__icon {
      width: 32px;
      height: 32px;
      flex-basis: 32px;
    }
  }
{% endstyle %}

<section class="product-battery-systems">
  <div class="product-battery-systems__inner">
    <div class="product-battery-systems__stage">
      {%- if section.settings.image_desktop != blank -%}
        {{
          section.settings.image_desktop
          | image_url: width: 2480
          | image_tag:
            class: 'product-battery-systems__image product-battery-systems__image--desktop',
            loading: 'lazy',
            widths: '750,1000,1240,1600,2000,2480',
            sizes: '(max-width: 767px) 0px, min(100vw - 40px, 1240px)',
            alt: section.settings.image_desktop.alt | default: section.settings.heading
        }}
      {%- endif -%}

      {%- if section.settings.image_mobile != blank -%}
        {{
          section.settings.image_mobile
          | image_url: width: 900
          | image_tag:
            class: 'product-battery-systems__image product-battery-systems__image--mobile',
            loading: 'lazy',
            widths: '350,500,700,900',
            sizes: 'calc(100vw - 40px)',
            alt: section.settings.image_mobile.alt | default: section.settings.heading
        }}
      {%- elsif section.settings.image_desktop != blank -%}
        {{
          section.settings.image_desktop
          | image_url: width: 900
          | image_tag:
            class: 'product-battery-systems__image product-battery-systems__image--mobile',
            loading: 'lazy',
            widths: '350,500,700,900',
            sizes: 'calc(100vw - 40px)',
            alt: section.settings.image_desktop.alt | default: section.settings.heading
        }}
      {%- endif -%}

      <div class="product-battery-systems__content">
        <h2 class="product-battery-systems__heading">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- endif -%}
          {%- if section.settings.heading_accent != blank -%}
            <span class="product-battery-systems__heading-accent">{{ section.settings.heading_accent }}</span>
          {%- endif -%}
        </h2>

        {%- if section.blocks.size > 0 -%}
          <ul class="product-battery-systems__list">
            {%- for block in section.blocks -%}
              {%- if block.settings.label != blank -%}
                <li class="product-battery-systems__item" {{ block.shopify_attributes }}>
                  <span class="product-battery-systems__icon" aria-hidden="true">
                    {%- render 'battery-icons', name: block.settings.icon -%}
                  </span>
                  <span class="product-battery-systems__label">{{ block.settings.label }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Battery Systems",
  "tag": "section",
  "class": "product-battery-systems-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MULTIPLE"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "PROTECTION SYSTEMS"
    }
  ],
  "blocks": [
    {
      "type": "protection",
      "name": "Protection item",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "protection",
          "options": [
            {
              "value": "protection",
              "label": "Protection"
            },
            {
              "value": "current",
              "label": "Current"
            },
            {
              "value": "temperature",
              "label": "Temperature"
            },
            {
              "value": "discharge",
              "label": "Discharge"
            },
            {
              "value": "voltage",
              "label": "Voltage"
            },
            {
              "value": "circuit",
              "label": "Circuit"
            }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Over-Charge Protection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Battery Systems",
      "blocks": [
        {
          "type": "protection",
          "settings": {
            "icon": "protection",
            "label": "Over-Charge Protection"
          }
        },
        {
          "type": "protection",
          "settings": {
            "icon": "current",
            "label": "Over-Current Protection"
          }
        },
        {
          "type": "protection",
          "settings": {
            "icon": "temperature",
            "label": "Over-Temperature Protection"
          }
        },
        {
          "type": "protection",
          "settings": {
            "icon": "discharge",
            "label": "Over-Discharge Protection"
          }
        },
        {
          "type": "protection",
          "settings": {
            "icon": "voltage",
            "label": "Over-Voltage Protection"
          }
        },
        {
          "type": "protection",
          "settings": {
            "icon": "circuit",
            "label": "Short-Circuit Protection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
