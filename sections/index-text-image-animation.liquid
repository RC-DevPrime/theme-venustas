{% style %}
    .text-image-animation-section{
        height:100vh;
    }
    .text-image-animation-section .inner-section{
        display:flex;
        flex-direction:column;
        align-items:center;
        justify-content:center;
        height:100%;
    }
    .text-image-animation-section .text-heading{
        font-size:100px;
    }
    .text-image-animation-section .text-description{
        width: 400px;
        position: absolute;
        transform: translateX(120%);
    }
    .text-image-animation-section .image-container-animation{
        position:relative;
        display:flex;
        align-items:center;
        justify-content:center;
        transition: all 0.3s ease 1s;
        overflow:hidden;
        height:0px;
        width:100%;
    }
    .text-image-animation-section.animate .image-container-animation{
        height:400px;
    }
    .text-image-animation-section .image-container-animation .image-container img{
        height:400px;
        width:fit-content;
        object-fit:contain;
        transition: all 0.3s ease;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .text-image-animation-section.animate .image-container-animation{
            margin:10px 0px;
        }
        .text-image-animation-section .text-description{
            transform: none;
            right:0;
            font-size:12px;
            width:170px;
            background:#FFF;
            padding:5px;
            border-radius:5px;
        }
        .text-image-animation-section .image-container{
            width: 280px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            position:relative;
            left:-20px;
            border-radius:8px;
            overflow:hidden;
        }
    }

