<div class="container section-content h-100">
    <div class="inner-section">
        <div class="text-heading pp-bold f-main">
            {{ section.settings.heading_1 }}
        </div>
        <div class="image-container-animation">
            <div class="image-container">
                
                {{ section.settings.image
                    | image_url: width: 1600
                    | image_tag:
                    widths: '360,540,720,900,1080,1440,1600',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    loading: 'lazy',
                    decoding: 'async',
                    alt: section.settings.image.alt | escape
                }}

            </div>
            <div class="text-description body-lg pp-regular f-black">
                {{ section.settings.description }}
            </div>
        </div>
        <div class="text-heading pp-bold f-main">
            {{ section.settings.heading_2 }}
        </div>
    </div>
</div>
{% schema %}
{
    "class": "text-image-animation-section section-animation",
    "name": "Text + Image Animation",
    "limit": 1,
    "templates": ["index"],
    "settings": [
        {
            "type": "text",
            "id": "heading_1",
            "label": "Heading - 1",
            "default": "Venustas Making"
        },
        {
            "type": "text",
            "id": "heading_2",
            "label": "Heading - 2",
            "default": "Warmth Within Easy Reach"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Let's explore the new sensory revolution brought by Venustas"
        }
    ],
    "presets": [
        {
            "name": "Text + Image Animation"
        }
    ]
}
{% endschema %}