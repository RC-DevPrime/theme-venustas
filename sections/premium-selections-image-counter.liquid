<div class="container section-content">
    <div class="counter-list-container col-lg-10 col-md-10 col-sm-12 mx-auto mb-lg-5 mb-md-5 mb-sm-4 pb-2">
        <div class="row">
            {% for block in section.blocks %}
                <div class="col-4" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="{{ forloop.index }}00" data-aos-duration="500">
                    <div class="counter-item" >
                        <div class="d-flex flex-column w-fit-content">
                            <div class="d-flex align-items-center gap-1">
                                <span class="counter-number odometer pp-bold f-main" data-count="{{ block.settings.counter }}">
                                    0
                                </span>
                                <span class="pp-semibold pretitle-lg f-main mt-2">
                                    {{ block.settings.unit }}
                                </span>
                            </div>
                            <div class="counter-label"> 
                                <p class="pp-semibold body-lg d-lg-block d-md-block d-sm-none">
                                    {{ block.settings.label }}
                                </p>
                                <p class="pp-semibold body-xs d-lg-none d-md-none d-sm-block">
                                    {{ block.settings.label }}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="featured-image-container" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="100" data-aos-duration="500">
        <img src="{{ section.settings.background_image | img_url: '1400x1400' }}" width="100%" height="100%">
    </div>
</div>
{% schema %}
    {
        "class": "premium-selections-image-counter-section",
        "name": "Premium Image Counter",
        "limit": 1,
        "templates": ["page"],
        "settings": [
            {
                "type": "image_picker",
                "id": "background_image",
                "label": "Background Image"
            },
        ],
        "max_blocks": 3,
        "blocks": [
            {
                "type": "counter",
                "name": "Counter",
                "settings": [
                    {
                        "type": "text",
                        "id": "counter",
                        "label": "Counter",
                        "default": "999"
                    },
                    {
                        "type": "text",
                        "id": "unit",
                        "label": "Unit",
                        "default": "+"
                    },
                    {
                        "type": "text",
                        "id": "label",
                        "label": "Label",
                        "default": "Label"
                    }
                ]
            }
        ],
        "presets" :[{
            "name" : "Premium Image Counter"
        }]
    }
  {% endschema %} 