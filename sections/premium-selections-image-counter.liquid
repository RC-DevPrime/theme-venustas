{% style %}
    .premium-selections-image-counter-section{

    }
    .premium-selections-image-counter-section .featured-image-container{
        height:700px;
        width:100%;
        border-radius:16px;
        overflow:hidden;
    }
    .premium-selections-image-counter-section .featured-image-container img{
        width:100%;
        height:100%;
        object-fit:cover;
    }

    
    
    .premium-selections-image-counter-section .counter-list-container .row{
        --bs-gutter-x: 0;
        --bs-gutter-y: 1.5rem;
    }
    .premium-selections-image-counter-section .counter-list-container .counter-item{
        display:flex;
        justify-content: center;
        border-right: 1px solid #E8E8E8;
    }
    .premium-selections-image-counter-section .counter-list-container .col-4:last-child .counter-item{
        border:none;
    }
    .premium-selections-image-counter-section .counter-number{
        font-size:56px;
        line-height:56px;
    }
    .premium-selections-image-counter-section .w-fit-content{
        width:fit-content;
    }

    
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .premium-selections-image-counter-section .featured-image-container{
            height: 200px;
            border-radius:8px;
        }
        .premium-selections-image-counter-section .counter-list-container .col-4:nth-child(1) .counter-item{
            justify-content: flex-start;
        }
        .premium-selections-image-counter-section .counter-list-container .col-4:nth-child(3) .counter-item{
            justify-content: flex-end;
        }
    }

