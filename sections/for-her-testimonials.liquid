{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .container {
    padding-left: 40px;
    padding-right: 40px;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .container {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
  #shopify-section-{{ section.id }} .for-her-testimonials {
    padding: 80px 0;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__heading {
    font-size: clamp(24px, 2.8vw, 42px);
    font-weight: 800;
    color: {{ section.settings.accent_color }};
    text-align: center;
    margin-bottom: 48px;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__swiper {
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__slide {
    display: flex;
    align-items: center;
    gap: 56px;
  }
  /* Left = text, Right = image */
  #shopify-section-{{ section.id }} .for-her-testimonials__content {
    flex: 1 1 0;
    min-width: 0;
    order: 1;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__img-wrap {
    flex: 0 0 46%;
    order: 2;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #eee;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__quote {
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.5;
    color: #1a1a1a;
    font-weight: 700;
    margin-bottom: 18px;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__handle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: {{ section.settings.accent_color }};
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 18px;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__handle svg {
    width: 17px;
    height: 17px;
    flex: none;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__bio {
    color: #888;
    font-size: 14px;
    line-height: 1.85;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__bio p {
    margin: 0 0 14px;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__bio p:last-child {
    margin-bottom: 0;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 40px;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__nav {
    display: none;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__nav:hover {
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__nav svg {
    width: 18px;
    height: 18px;
    stroke: #fff;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__nav.swiper-button-disabled {
    opacity: 0.35;
    cursor: default;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__pagination {
    text-align: center;
    width: auto;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__pagination .swiper-pagination-bullet {
    width: 9px;
    height: 9px;
    background: #d9b8ac;
    opacity: 1;
    margin: 0 5px;
  }
  #shopify-section-{{ section.id }} .for-her-testimonials__pagination .swiper-pagination-bullet-active {
    background: {{ section.settings.accent_color }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .for-her-testimonials {
      padding: 50px 0;
    }
    #shopify-section-{{ section.id }} .for-her-testimonials__slide {
      flex-direction: column;
      gap: 18px;
    }
    #shopify-section-{{ section.id }} .for-her-testimonials__content,
    #shopify-section-{{ section.id }} .for-her-testimonials__img-wrap {
      flex: none;
      width: 100%;
    }
    #shopify-section-{{ section.id }} .for-her-testimonials__img-wrap {
      order: 1;
      aspect-ratio: 4 / 3;
    }
    #shopify-section-{{ section.id }} .for-her-testimonials__content {
      order: 2;
    }
    #shopify-section-{{ section.id }} .for-her-testimonials__quote {
      font-size: 16px;
      line-height: 1.45;
      margin-bottom: 12px;
    }
    #shopify-section-{{ section.id }} .for-her-testimonials__handle {
      font-size: 14px;
      margin-bottom: 12px;
    }
    #shopify-section-{{ section.id }} .for-her-testimonials__bio {
      font-size: 13px;
      line-height: 1.65;
      max-height: 220px;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    #shopify-section-{{ section.id }} .for-her-testimonials__bio p {
      margin: 0 0 10px;
    }
    #shopify-section-{{ section.id }} .for-her-testimonials__controls {
      margin-top: 20px;
    }
    #shopify-section-{{ section.id }} .for-her-testimonials__nav {
      display: none;
    }
  }
{% endstyle %}

<div class="for-her-testimonials">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="for-her-testimonials__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="for-her-testimonials__swiper swiper" id="for-her-testimonials-{{ section.id }}">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide for-her-testimonials__slide" {{ block.shopify_attributes }}>
            <div class="for-her-testimonials__content">
              {% if block.settings.quote != blank %}
                <p class="for-her-testimonials__quote">"{{ block.settings.quote }}"</p>
              {% endif %}
              {% if block.settings.handle != blank %}
                {% assign handle_clean = block.settings.handle | remove: '@' %}
                <a class="for-her-testimonials__handle"
                   {% if block.settings.handle_link != blank %}href="{{ block.settings.handle_link }}" target="_blank" rel="noopener"{% else %}href="https://instagram.com/{{ handle_clean }}" target="_blank" rel="noopener"{% endif %}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.accent_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                  {{ block.settings.handle }}
                </a>
              {% endif %}
              {% if block.settings.bio != blank %}
                <div class="for-her-testimonials__bio">{{ block.settings.bio }}</div>
              {% endif %}
            </div>
            <div class="for-her-testimonials__img-wrap">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.handle }}" loading="lazy">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="for-her-testimonials__controls">
      <button type="button" class="for-her-testimonials__nav" id="for-her-test-prev-{{ section.id }}" aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <div class="for-her-testimonials__pagination" id="for-her-test-pag-{{ section.id }}"></div>
      <button type="button" class="for-her-testimonials__nav" id="for-her-test-next-{{ section.id }}" aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('#for-her-testimonials-{{ section.id }}', {
      slidesPerView: 1,
      spaceBetween: 40,
      loop: true,
      {% if section.settings.autoplay %}
      autoplay: {
        delay: {{ section.settings.autoplay_speed | times: 1000 }},
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      {% endif %}
      navigation: {
        prevEl: '#for-her-test-prev-{{ section.id }}',
        nextEl: '#for-her-test-next-{{ section.id }}',
      },
      pagination: {
        el: '#for-her-test-pag-{{ section.id }}',
        clickable: true,
      }
    });
  });
</script>

{% schema %}
{
  "name": "For Her - Testimonials",
  "class": "for-her-testimonials-section",
  "templates": ["page"],
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Heading, Handle & Dots)",
      "default": "#B93205"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Her Voice, Her Story"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-rotate speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Quotation marks are added automatically"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Social Handle",
          "info": "e.g. sheriskocdopole"
        },
        {
          "type": "url",
          "id": "handle_link",
          "label": "Handle Link (optional)",
          "info": "Defaults to instagram.com/<handle> if left blank"
        },
        {
          "type": "richtext",
          "id": "bio",
          "label": "Bio / Intro"
        }
      ]
    }
  ],
  "presets": [{
    "name": "For Her - Testimonials",
    "blocks": [
      { "type": "testimonial" },
      { "type": "testimonial" },
      { "type": "testimonial" }
    ]
  }]
}
{% endschema %}