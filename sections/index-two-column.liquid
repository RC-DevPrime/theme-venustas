{% style %}
    .two-column-section{
        content-visibility:auto;
        contain-intrinsic-size: 1px 760px;
    }
    .two-column-section{
    }
    .two-column-section .two-column-item{
        position:relative;
        overflow:hidden;
        border-radius: 16px 16px 16px 16px;
        height:330px;
    }
    .two-column-section .two-column-item img.background-image{
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: all 0.3s ease;
    }
    .two-column-section .two-column-item:hover img.background-image{
        transform:scale(1.1);
    }
    .two-column-section .two-column-item .two-column-content{
        display: flex;
        flex-direction: column;
        position: relative;
        justify-content: space-between;
        height: 100%;
        padding:30px 40px;
    }
    .two-column-section .two-column-item .two-column-content .block-btn {
        display:flex;
        align-items: center;
        gap:6px;
        width:fit-content;
    }
    .two-column-section .two-column-item .two-column-content .block-btn .btn-icon{
        width:20px;
        height:20px;
        object-fit:contain;
        position:relative;
        z-index:1;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .two-column-section .row{
            --bs-gutter-x: 0;
            --bs-gutter-y: 10px;
        }
        .two-column-section .two-column-item .two-column-content{
            padding: 10px 15px 13px;
        }
        .two-column-section .two-column-item{
            border-radius:8px;
            height: 200px;
        }
        .two-column-section .block-btn{
            padding: 6px 10px !important;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content">
    <div class="row">
        {% for block in section.blocks %}
            <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="two-column-item">
                    <img
                        class="background-image"
                        src="{{ block.settings.background | image_url: width: 960 }}"
                        srcset="
                            {{ block.settings.background | image_url: width: 480 }} 480w,
                            {{ block.settings.background | image_url: width: 768 }} 768w,
                            {{ block.settings.background | image_url: width: 960 }} 960w,
                            {{ block.settings.background | image_url: width: 1200 }} 1200w
                        "
                        sizes="(max-width: 768px) 100vw, 50vw"
                        width="{{ block.settings.background.width }}"
                        height="{{ block.settings.background.height }}"
                        alt="{{ block.settings.background.alt | escape }}"
                        loading="lazy"
                        fetchpriority="auto"
                        decoding="async"
                    />

                    <div class="two-column-content col-lg-7 col-md-7 col-sm-12">
                        <div class="top-content">
                            <div class="block-heading pp-bold title-sm f-white l-h-normal d-lg-block d-md-block d-sm-none">
                                {{ block.settings.heading }}
                            </div>
                            <div class="block-heading pp-bold pretitle f-white l-h-normal d-lg-none d-md-none d-sm-block">
                                {{ block.settings.heading }}
                            </div>
                            <div class="block-description pp-regular body f-white col-lg-12 col-md-12 col-sm-8">
                                {{ block.settings.description }}
                            </div>
                        </div>
                        <div class="bottom-content">
                            <a href="{{ block.settings.link }}" class="block-btn btn-hover btn-main btn-no-animation px-lg-3 px-md-3 px-sm-2 py-lg-3 py-md-3 py-sm-2">
                                <span class="pp-regular body l-h-normal px-1">
                                    {{ block.settings.btn_label }}
                                    <!-- Visually hidden text for accessibility -->
                                    <span class="visually-hidden"> about {{ block.settings.heading }}</span>
                                </span>
                                <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/47420_2x_bf9f4027-13f9-4344-a883-453f60bc5d25.png?v=1758125303" width="100%" height="100%" class="btn-icon" alt="three-arrow-icon">
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% schema %}
{
    "class": "two-column-section",
    "name": "Two Column",
    "limit": 1,
    "templates": ["index"],
    "blocks": [
        {
            "type": "item",
            "name": "item",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "background",
                    "label": "background",
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "richtext",
                    "id": "description",
                    "label": "Description"
                },
                {
                    "type": "text",
                    "id": "btn_label",
                    "label": "Button Label",
                    "default": "Learn More"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Two Column"
        }
    ]
}
{% endschema %}
