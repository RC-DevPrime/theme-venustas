{% style %}
  #shopify-section-{{ section.id }} .heatingV-volcano-chart {
    --chat-font: 17px; /* SVG user units */
    width: 100%;
    overflow: hidden;
    background: #f0f0f0;
    color: #1a1a1a;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart *,
  #shopify-section-{{ section.id }} .heatingV-volcano-chart *::before,
  #shopify-section-{{ section.id }} .heatingV-volcano-chart *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__inner {
    display: flex;
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 0 0 100px;
    gap: 32px;
    align-items: flex-start;
  }

  /* ---------- Card ---------- */
  #shopify-section-{{ section.id }} .heatingV-volcano-chart__card {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    gap: 16px;
    padding: 28px 40px 28px 24px;
    border-radius: 20px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__title {
    margin: 0 0 28px;
    color: #1a1a1a;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
  }

  /* ---------- Chart frame ---------- */
  #shopify-section-{{ section.id }} .heatingV-volcano-chart__plot {
    display: flex;
    width: 100%;
    gap: 18px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__y-axis {
    display: flex;
    flex: none;
    align-self: stretch;
    width: 15px;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__y-label {
    color: #1a1a1a;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 1.44px;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__area {
    flex: 1 1 auto;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__svg-text {
    fill: #1a1a1a;
    font-family: inherit;
    font-size: var(--chat-font);
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__svg-text--band {
    fill: #515151;
  }

  /* ---------- Animated lines ---------- */
  #shopify-section-{{ section.id }} .heatingV-volcano-chart__line {
    fill: none;
    stroke-width: 3;
    /* butt caps guarantee nothing renders at dashoffset: 1 (round caps would
       leak a half-circle of stroke-width/2 past the path start) */
    stroke-linecap: butt;
    stroke-linejoin: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__line--volcano {
    stroke: #b93205;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__line--standard {
    stroke: #6c757d;
    transition-delay: 0.25s;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__dot {
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__dot--volcano {
    fill: #b93205;
    transition-delay: 1.85s;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__dot--standard {
    fill: #6c757d;
    transition-delay: 2.1s;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__dot-ring {
    fill: none;
    stroke: #fff;
    stroke-width: 2;
  }

  /* ---------- In-view state (plays once) ---------- */
  #shopify-section-{{ section.id }} .heatingV-volcano-chart__card.is-in-view .heatingV-volcano-chart__line {
    stroke-dashoffset: 0;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__card.is-in-view .heatingV-volcano-chart__dot {
    opacity: 1;
  }

  /* ---------- Legend ---------- */
  #shopify-section-{{ section.id }} .heatingV-volcano-chart__legend {
    display: flex;
    padding-top: 12px;
    gap: 32px;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__legend-item {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__legend-mark {
    flex: none;
    width: 24px;
    height: 4px;
    border-radius: 2px;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__legend-mark--volcano {
    background: #b93205;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__legend-mark--standard {
    background: #6c757d;
  }

  #shopify-section-{{ section.id }} .heatingV-volcano-chart__legend-text {
    margin: 0;
    color: #1a1a1a;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.25;
    white-space: nowrap;
  }

  /* ---------- Mobile ---------- */
  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingV-volcano-chart {
      --chat-font: 36px;
    }

    #shopify-section-{{ section.id }} .heatingV-volcano-chart__inner {
      width: 100%;
      padding: 0 20px 56px;
      flex-direction: column;
      gap: 24px;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .heatingV-volcano-chart__card {
      flex: none;
      width: 100%;
      padding: 20px;
      border-radius: 16px;
    }

    #shopify-section-{{ section.id }} .heatingV-volcano-chart__title {
      margin-bottom: 20px;
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .heatingV-volcano-chart__plot {
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .heatingV-volcano-chart__legend {
      gap: 20px;
      flex-wrap: wrap;
    }

    #shopify-section-{{ section.id }} .heatingV-volcano-chart__legend-text {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .heatingV-volcano-chart__line {
      stroke-dashoffset: 0;
      transition: none;
    }

    #shopify-section-{{ section.id }} .heatingV-volcano-chart__dot {
      opacity: 1;
      transition: none;
    }
  }
{% endstyle %}

<section class="heatingV-volcano-chart">
  <div class="heatingV-volcano-chart__inner">

    {%- comment -%} ---------- Card 1: Mild Cold ---------- {%- endcomment -%}
    <article class="heatingV-volcano-chart__card">
      <h3 class="heatingV-volcano-chart__title">Mild Cold</h3>

      <div class="heatingV-volcano-chart__plot">
        <div class="heatingV-volcano-chart__y-axis">
          <span class="heatingV-volcano-chart__y-label">How warm you feel</span>
        </div>

        <div class="heatingV-volcano-chart__area">
          <svg
            class="heatingV-volcano-chart__svg"
            viewBox="0 0 800 350"
            role="img"
            aria-label="Mild cold: Volcano heated liner keeps warmth steady over six hours while a standard heated vest drops off"
            preserveAspectRatio="xMidYMid meet"
          >
            <defs>
              <linearGradient id="chatBand1-{{ section.id }}" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#fdf5f2" />
                <stop offset="1" stop-color="#f8e4db" />
              </linearGradient>
            </defs>

            {%- comment -%} Comfortable band {%- endcomment -%}
            <rect x="80" y="60" width="680" height="125" fill="url(#chatBand1-{{ section.id }})" />

            {%- comment -%} Grid {%- endcomment -%}
            <line x1="306.67" y1="60" x2="306.67" y2="300" stroke="#ececec" stroke-width="1" />
            <line x1="533.33" y1="60" x2="533.33" y2="300" stroke="#ececec" stroke-width="1" />
            <line x1="80" y1="300" x2="760" y2="300" stroke="#d8d8d8" stroke-width="1" />

            {%- comment -%} Band labels {%- endcomment -%}
            <text class="heatingV-volcano-chart__svg-text heatingV-volcano-chart__svg-text--band" x="752" y="90" text-anchor="end">Comfortable</text>
            <text class="heatingV-volcano-chart__svg-text heatingV-volcano-chart__svg-text--band" x="752" y="200" text-anchor="end">You start noticing</text>

            {%- comment -%} Lines {%- endcomment -%}
            <path class="heatingV-volcano-chart__line heatingV-volcano-chart__line--standard" d="M 80 105 L 400 140 L 760 170" pathLength="1" />
            <path class="heatingV-volcano-chart__line heatingV-volcano-chart__line--volcano" d="M 80 100 L 760 110" pathLength="1" />

            {%- comment -%} Endpoint markers {%- endcomment -%}
            <g class="heatingV-volcano-chart__dot heatingV-volcano-chart__dot--volcano">
              <circle class="heatingV-volcano-chart__dot-ring" cx="80" cy="100" r="7" />
              <circle cx="80" cy="100" r="5" />
              <circle class="heatingV-volcano-chart__dot-ring" cx="760" cy="110" r="7" />
              <circle cx="760" cy="110" r="5" />
            </g>
            <g class="heatingV-volcano-chart__dot heatingV-volcano-chart__dot--standard">
              <circle class="heatingV-volcano-chart__dot-ring" cx="80" cy="105" r="7" />
              <circle cx="80" cy="105" r="5" />
              <circle class="heatingV-volcano-chart__dot-ring" cx="760" cy="170" r="7" />
              <circle cx="760" cy="170" r="5" />
            </g>

            {%- comment -%} X axis labels {%- endcomment -%}
            <text class="heatingV-volcano-chart__svg-text" x="80" y="330" text-anchor="start">0h (Start)</text>
            <text class="heatingV-volcano-chart__svg-text" x="306.67" y="330" text-anchor="middle">2h</text>
            <text class="heatingV-volcano-chart__svg-text" x="533.33" y="330" text-anchor="middle">4h</text>
            <text class="heatingV-volcano-chart__svg-text" x="760" y="330" text-anchor="end">6h (Hour out)</text>
          </svg>
        </div>
      </div>

      <div class="heatingV-volcano-chart__legend">
        <div class="heatingV-volcano-chart__legend-item">
          <span class="heatingV-volcano-chart__legend-mark heatingV-volcano-chart__legend-mark--volcano"></span>
          <p class="heatingV-volcano-chart__legend-text">Volcano&trade;</p>
        </div>
        <div class="heatingV-volcano-chart__legend-item">
          <span class="heatingV-volcano-chart__legend-mark heatingV-volcano-chart__legend-mark--standard"></span>
          <p class="heatingV-volcano-chart__legend-text">Standard Heated Vest</p>
        </div>
      </div>
    </article>

    {%- comment -%} ---------- Card 2: Extreme Cold ---------- {%- endcomment -%}
    <article class="heatingV-volcano-chart__card">
      <h3 class="heatingV-volcano-chart__title">Extreme Cold, Wind, No Movement</h3>

      <div class="heatingV-volcano-chart__plot">
        <div class="heatingV-volcano-chart__y-axis">
          <span class="heatingV-volcano-chart__y-label">How warm you feel</span>
        </div>

        <div class="heatingV-volcano-chart__area">
          <svg
            class="heatingV-volcano-chart__svg"
            viewBox="0 0 800 350"
            role="img"
            aria-label="Extreme cold, wind and no movement: Volcano heated liner holds heat while a standard heated vest drops sharply"
            preserveAspectRatio="xMidYMid meet"
          >
            <defs>
              <linearGradient id="chatBand2-{{ section.id }}" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#fdf5f2" />
                <stop offset="1" stop-color="#f8e4db" />
              </linearGradient>
            </defs>

            {%- comment -%} Comfortable band {%- endcomment -%}
            <rect x="80" y="60" width="680" height="125" fill="url(#chatBand2-{{ section.id }})" />

            {%- comment -%} Grid {%- endcomment -%}
            <line x1="306.67" y1="60" x2="306.67" y2="300" stroke="#ececec" stroke-width="1" />
            <line x1="533.33" y1="60" x2="533.33" y2="300" stroke="#ececec" stroke-width="1" />
            <line x1="80" y1="300" x2="760" y2="300" stroke="#d8d8d8" stroke-width="1" />

            {%- comment -%} Band labels {%- endcomment -%}
            <text class="heatingV-volcano-chart__svg-text heatingV-volcano-chart__svg-text--band" x="752" y="90" text-anchor="end">Comfortable</text>
            <text class="heatingV-volcano-chart__svg-text heatingV-volcano-chart__svg-text--band" x="752" y="200" text-anchor="end">You start noticing</text>

            {%- comment -%} Lines {%- endcomment -%}
            <path class="heatingV-volcano-chart__line heatingV-volcano-chart__line--standard" d="M 80 120 L 760 277" pathLength="1" />
            <path class="heatingV-volcano-chart__line heatingV-volcano-chart__line--volcano" d="M 80 103 L 760 171" pathLength="1" />

            {%- comment -%} Endpoint markers {%- endcomment -%}
            <g class="heatingV-volcano-chart__dot heatingV-volcano-chart__dot--volcano">
              <circle class="heatingV-volcano-chart__dot-ring" cx="80" cy="103" r="7" />
              <circle cx="80" cy="103" r="5" />
              <circle class="heatingV-volcano-chart__dot-ring" cx="760" cy="171" r="7" />
              <circle cx="760" cy="171" r="5" />
            </g>
            <g class="heatingV-volcano-chart__dot heatingV-volcano-chart__dot--standard">
              <circle class="heatingV-volcano-chart__dot-ring" cx="80" cy="120" r="7" />
              <circle cx="80" cy="120" r="5" />
              <circle class="heatingV-volcano-chart__dot-ring" cx="760" cy="277" r="7" />
              <circle cx="760" cy="277" r="5" />
            </g>

            {%- comment -%} X axis labels {%- endcomment -%}
            <text class="heatingV-volcano-chart__svg-text" x="80" y="330" text-anchor="start">0h (Start)</text>
            <text class="heatingV-volcano-chart__svg-text" x="306.67" y="330" text-anchor="middle">2h</text>
            <text class="heatingV-volcano-chart__svg-text" x="533.33" y="330" text-anchor="middle">4h</text>
            <text class="heatingV-volcano-chart__svg-text" x="760" y="330" text-anchor="end">6h (Hour out)</text>
          </svg>
        </div>
      </div>

      <div class="heatingV-volcano-chart__legend">
        <div class="heatingV-volcano-chart__legend-item">
          <span class="heatingV-volcano-chart__legend-mark heatingV-volcano-chart__legend-mark--volcano"></span>
          <p class="heatingV-volcano-chart__legend-text">Volcano&trade;</p>
        </div>
        <div class="heatingV-volcano-chart__legend-item">
          <span class="heatingV-volcano-chart__legend-mark heatingV-volcano-chart__legend-mark--standard"></span>
          <p class="heatingV-volcano-chart__legend-text">Standard Heated Vest</p>
        </div>
      </div>
    </article>

  </div>
</section>

<script>
  (() => {
    const sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionRoot || sectionRoot.dataset.heatingVVolcanoChartReady === 'true') return;
    sectionRoot.dataset.heatingVVolcanoChartReady = 'true';

    const cards = sectionRoot.querySelectorAll('.heatingV-volcano-chart__card');
    if (!cards.length) return;

    const reveal = (card) => card.classList.add('is-in-view');

    // No observer support: show the finished state immediately.
    if (!('IntersectionObserver' in window)) {
      cards.forEach(reveal);
      return;
    }

    // Fires once, when 50% of the chart card is visible. Never replays.
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.intersectionRatio < 0.5) return;
        reveal(entry.target);
        observer.unobserve(entry.target);
      });
    }, { threshold: [0, 0.5, 1] });

    cards.forEach((card) => observer.observe(card));

    document.addEventListener('shopify:section:unload', function unload(event) {
      if (event.detail.sectionId !== '{{ section.id }}') return;
      observer.disconnect();
      document.removeEventListener('shopify:section:unload', unload);
    });
  })();
</script>

{% schema %}
{
  "name": "HeatingV Volcano Chart",
  "settings": [],
  "presets": [
    {
      "name": "HeatingV Volcano Chart"
    }
  ]
}
{% endschema %}
