{% style %}
    .about-us-banner-with-content-container-list-slider{
        position: relative;
        width: 100%;
    }
    .about-us-banner-with-content-container-list-slider .sticky-slider{
        position: sticky;
        top: 0;
        height: 100vh;
        overflow: hidden;
    }
    .about-us-banner-with-content-container-list-slider .banner-slider-container,
    .about-us-banner-with-content-container-list-slider .swiper-wrapper {
        height: 100%;
    }
    .about-us-banner-with-content-container-list-slider .about-us-banner-with-content-slider-section {
        height: 100vh; /* will be updated by JS */
        position:relative;
    }
    .about-us-banner-with-content-container-list-slider .about-us-banner-with-content-slider-section .bg-image{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .about-us-banner-with-content-container-list-slider .banner-with-content-slider-item{
        height:100%;
        width:100%;
        position:relative;
    }
    .about-us-banner-with-content-container-list-slider .banner-with-content-slider-item .banner-with-content-container{
        position:absolute;
        top:0;
        width:100%;
        height:100%;
    }

    .content-slider-modal{
        position:fixed;
        top:0;
        height:100%;
        width:100%;
        background-color: rgb(255 255 255 / 30%);
        backdrop-filter: blur(10px);
        z-index:999998;
        display:none;
    }
    .content-slider-modal.open{
        display:block;
    }
    .content-slider-modal .content-item{
        overflow:hidden;
        border-radius:16px;
        padding:40px 35px;
        background-color:#282828;
        flex: 0 0 50%; /* make each slide 50% width */
        width: 50% !important; /* ensure consistent width calculation */
        box-sizing: border-box;
        height:auto;
    }
    .content-slider-modal .content-item.two-image{
        flex: 0 0 85%; /* make each slide 50% width */
        width: 85% !important; /* ensure consistent width calculation */
    }

    .content-slider-modal .content-item .block-heading{
        color:#FFF;
    }
    .content-slider-modal .content-item .block-heading strong{
        font-weight:unset;
        color:#B93205;
    }
    .content-slider-modal .float-nav{
        position:unset;
        transform:unset;
        max-width:unset;
        width:fit-content;
    }
    .content-slider-modal .float-nav button{
        position:unset;
        transform:unset;
        background-color:#282828;
        opacity:1;
        transition: all 0.3s ease;
    }
    .content-slider-modal .btn-close-content-modal{
        width:55px;
        height:55px;
        border-radius: 50%;
        background-color:#282828;
        cursor:pointer;
        background-image: url(https://cdn.shopify.com/s/files/1/0457/1099/9709/files/close-nav-mobile.png?v=1761785925);
        background-size: 30px;
        background-position: center center;
        background-repeat: no-repeat;
        transition: all 0.3s ease;
    }
    .content-slider-modal .float-nav button.swiper-button-disabled{
        opacity:0.8;
    }
    .content-slider-modal .btn-close-content-modal:hover,
    .content-slider-modal .float-nav button:hover{
        background-color: #B93205;
    }
    .content-slider-modal .two-image-container{
        display:flex;
        gap:20px;
    }
    .content-slider-dynamic .image-container,
    .content-slider-dynamic .video-container{
        height:400px;
        width:100%;
        overflow:hidden;
        border-radius:16px;
    }
    .content-slider-dynamic .image-container img,
    .content-slider-dynamic .video-container video{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .content-slider-dynamic .media-link{
        display:block;
        text-decoration:none;
        color:inherit;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .content-slider-modal .content-item{
            flex: 0 0 95%;
            width: 95% !important;
            padding: 20px;
            border-radius:8px;
        }
        .content-slider-modal .btn-close-content-modal{
            width:40px;
            height:40px;
        }
        .content-slider-dynamic .image-container,
        .content-slider-dynamic .video-container{
            height:180px;
            border-radius:6px;
        }
        .content-slider-modal .two-image-container{
            flex-direction:column;
            gap:15px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="banner-with-content-slider-item 
          
    {% if section.settings.nav_title != blank %} about-us-section-scroll
    {% else %}
    {% if section.settings.enabled_section_child_scroll %} about-us-section-scroll
    {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}>
    
    <img
    src="{{ section.settings.background_image | img_url: 'master' }}"
    alt="{{ section.settings.background_image.alt }}"
    class="bg-image d-lg-block d-md-block d-sm-none"
    width="100%"
    height="100%"
    >
    <img
    src="{{ section.settings.background_image_mobile | img_url: 'master' }}"
    alt="{{ section.settings.background_image_mobile.alt }}"
    class="bg-image d-lg-none d-md-none d-sm-block"
    width="100%"
    height="100%"
    >
    <div class="banner-with-content-container">

        <div class="container section-content h-100">
            <div class="d-flex flex-column h-100 justify-content-lg-center justify-content-md-center justify-content-sm-start">
                <div class="overflow-hidden col-lg-7 col-md-7 col-sm-12 py-lg-5 py-md-5 py-sm-4 pe-lg-4 pe-md-4 pe-sm-3">
                    <div class="section-content-container d-flex flex-column align-items-lg-start align-items-md-start align-items-sm-center" >
                        <div class="section-heading pp-bold title-md f-white pb-lg-3 pb-md-3 pb-sm-2">
                            <span class="title-md d-lg-block d-md-block d-sm-none">
                                {{ section.settings.heading }}
                            </span>
                            <span class="title d-lg-none d-md-none d-sm-block text-center">
                                {{ section.settings.heading }}
                            </span>
                        </div>
                        <div class="section-description pp-regular body-xl f-white pb-lg-3 pb-md-3 pb-sm-2">
                            <span class="body-xl d-lg-block d-md-block d-sm-none">
                                {{ section.settings.description }}
                            </span>
                            <span class="body d-lg-none d-md-none d-sm-block text-center">
                                {{ section.settings.description }}
                            </span>
                        </div>
                        {% if section.settings.enabled_content_popup %}
                            {% if section.blocks.size > 0 %}
                                <div class="btn-learn-more btn-hover btn-main py-2" data-tab-modal="modal-content-{{ section.id }}">
                                    <span class="f-white body pp-medium">
                                        {{ section.settings.btn_label }}
                                    </span>
                                </div>
                            {% endif %}
                        {% else %}
                            <a href="{{ section.settings.btn_link }}" class="btn-hover btn-main py-2" >
                                <span class="f-white body pp-medium">
                                    {{ section.settings.btn_label }}
                                </span>
                            </a>
                        {% endif %}

                    </div>
                </div>
            </div>
        </div>

    </div>
    {% if section.settings.enabled_content_popup %}
        {% if section.blocks.size > 0 %}
            <div class="content-slider-modal" data-tab-modal="modal-content-{{ section.id }}">
                <div class="container section-content h-100">
                    <div class="top-navigation pb-lg-4 pb-md-4 pb-sm-3">
                        <div class="row">
                            <div class="col">
                                <div class="btn-close-content-modal">

                                </div>
                            </div>
                            <div class="col d-flex justify-content-end">
                                <div class="float-nav d-lg-flex d-md-flex d-sm-flex gap-lg-3 gap-md-3 gap-sm-2">
                                    <button type="button" class="owl-prev" disabled>
                                        <i class="fa-solid fa-chevron-left f-white"></i>
                                    </button>
                                    <button type="button" class="owl-next" disabled>
                                        <i class="fa-solid fa-chevron-right f-white"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="content-slider-dynamic">
                        <div class="swiper-wrapper">

                            {% for block in section.blocks %}
                                {% if block.type == 'image' %}
                                    <div class="content-item swiper-slide">
                                        <div class="d-flex flex-column gap-lg-3 gap-md-3 gap-sm-2">
                                            <div class="block-heading pp-semibold ">
                                                <span class="pretitle-xl d-lg-block d-md-block d-sm-none">
                                                    {{ block.settings.heading }}
                                                </span>
                                                <span class="pretitle d-lg-none d-md-none d-sm-block">
                                                    {{ block.settings.heading }}
                                                </span>
                                            </div>
                                            {% if block.settings.link != blank %}
                                                <a href="{{ block.settings.link }}" class="media-link">
                                            {% endif %}
                                                <div class="image-container">
                                                    <img src="{{ block.settings.image | img_url: 'master' }}" width="100%" height="100%">
                                                </div>
                                            {% if block.settings.link != blank %}
                                                </a>
                                            {% endif %}
                                            <div class="block-description pp-medium body-lg f-white">
                                                <span class="body-lg d-lg-block d-md-block d-sm-none">
                                                    {{ block.settings.description }}
                                                </span>
                                                <span class="body d-lg-none d-md-none d-sm-block">
                                                    {{ block.settings.description }}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                {% elsif block.type == 'video' %}
                                    <div class="content-item swiper-slide">
                                        <div class="d-flex flex-column gap-lg-3 gap-md-3 gap-sm-2">
                                            <div class="block-heading pp-semibold ">
                                                <span class="pretitle-xl d-lg-block d-md-block d-sm-none">
                                                    {{ block.settings.heading }}
                                                </span>
                                                <span class="pretitle d-lg-none d-md-none d-sm-block">
                                                    {{ block.settings.heading }}
                                                </span>
                                            </div>
                                            {% if block.settings.link != blank %}
                                                <a href="{{ block.settings.link }}" class="media-link">
                                            {% endif %}
                                                <div class="video-container">
                                                    {% assign large_poster = block.settings.video.preview_image | image_url: width: 1500 %}
                                                    {{ block.settings.video | video_tag: 
                                                        autoplay: true, 
                                                        loop: true, 
                                                        muted: true, 
                                                        playsinline: true, 
                                                        poster: large_poster 
                                                    }}
                                                </div>
                                            {% if block.settings.link != blank %}
                                                </a>
                                            {% endif %}
                                            <div class="block-description pp-medium body-lg f-white">
                                                <span class="body-lg d-lg-block d-md-block d-sm-none">
                                                    {{ block.settings.description }}
                                                </span>
                                                <span class="body d-lg-none d-md-none d-sm-block">
                                                    {{ block.settings.description }}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="content-item two-image swiper-slide">
                                        <div class="d-flex flex-column gap-lg-3 gap-md-3 gap-sm-2">
                                            <div class="block-heading pp-semibold ">
                                                <span class="pretitle-xl d-lg-block d-md-block d-sm-none">
                                                    {{ block.settings.heading }}
                                                </span>
                                                <span class="pretitle d-lg-none d-md-none d-sm-block">
                                                    {{ block.settings.heading }}
                                                </span>
                                            </div>
                                            {% if block.settings.link != blank %}
                                                <a href="{{ block.settings.link }}" class="media-link">
                                            {% endif %}
                                                <div class="two-image-container">
                                                    <div class="image-container-div">
                                                        <div class="image-container">
                                                            <img src="{{ block.settings.image_1 | img_url: 'master' }}" width="100%" height="100%">
                                                        </div>
                                                        <p class="pp-medium body-lg f-white-gray pt-2 d-lg-block d-md-block d-sm-none">
                                                            {{ block.settings.heading_1 }}
                                                        </p>
                                                        <p class="pp-medium body f-white-gray pt-2 d-lg-none d-md-none d-sm-block">
                                                            {{ block.settings.heading_1 }}
                                                        </p>
                                                    </div> 
                                                    <div class="image-container-div">
                                                        <div class="image-container">
                                                            <img src="{{ block.settings.image_2 | img_url: 'master' }}" width="100%" height="100%">
                                                        </div>
                                                        <p class="pp-medium body-lg f-white-gray pt-2 d-lg-block d-md-block d-sm-none">
                                                            {{ block.settings.heading_2 }}
                                                        </p>
                                                        <p class="pp-medium body f-white-gray pt-2 d-lg-none d-md-none d-sm-block">
                                                            {{ block.settings.heading_2 }}
                                                        </p>
                                                    </div> 
                                                </div>
                                            {% if block.settings.link != blank %}
                                                </a>
                                            {% endif %}
                                            <div class="block-description pp-medium body-lg f-white">
                                                <span class="body-lg d-lg-block d-md-block d-sm-none">
                                                    {{ block.settings.description }}
                                                </span>
                                                <span class="body d-lg-none d-md-none d-sm-block">
                                                    {{ block.settings.description }}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}

                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endif %}

</div>
{% schema %}
    {
        "class": "about-us-banner-with-content-slider-section swiper-slide",
        "name": "Banner + Content Slider",
        "templates": ["page"],
        "settings": [
            {
                "type": "checkbox",
                "id": "enabled_section_child_scroll",
                "label": "Enabled Section Child Scroll"
            },
            {
                "type": "text",
                "id": "section_scroll_nav",
                "label": "Section Scroll Nav",
                "info": "Need to Enabled first Section Scroll"
            },
            {
                "type": "text",
                "id": "nav_title",
                "label": "Navigation Title"
            },
            {
                "type": "image_picker",
                "id": "background_image",
                "label": "Background Image"
            },
            {
                "type": "image_picker",
                "id": "background_image_mobile",
                "label": "Background Image - Mobile"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description"
            },
            {
                "type": "text",
                "id": "btn_label",
                "label": "Button Label",
                "default": "Explore"
            },
            {
                "type": "checkbox",
                "label": "Enabled Content Popup",
                "id": "enabled_content_popup",
                "default": true,
            },
            {
                "type": "url",
                "id": "btn_link",
                "label": "Button Link"
            }
        ],
        "blocks": [
            {
                "type": "image",
                "name":"Image",
                "settings": [
                    {
                        "type": "richtext",
                        "id": "heading",
                        "label": "Heading"
                    },
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    },
                    {
                        "type": "url",
                        "id": "link",
                        "label": "Link"
                    },
                    {
                        "type": "richtext",
                        "id": "description",
                        "label": "Description"
                    }
                ]
            },
            {
                "type": "video",
                "name":"Video",
                "settings": [
                    {
                        "type": "richtext",
                        "id": "heading",
                        "label": "Heading"
                    },
                    {
                        "type": "video",
                        "id": "video",
                        "label": "Video"
                    },
                    {
                        "type": "url",
                        "id": "link",
                        "label": "Link"
                    },
                    {
                        "type": "richtext",
                        "id": "description",
                        "label": "Description"
                    }
                ]
            },
            {
                "type": "two_image",
                "name":"Two Image",
                "settings": [
                    {
                        "type": "richtext",
                        "id": "heading",
                        "label": "Heading"
                    },
                    {
                        "type": "image_picker",
                        "id": "image_1",
                        "label": "Image - 1"
                    },
                    {
                        "type": "text",
                        "id": "heading_1",
                        "label": "Heading - 1"
                    },
                    {
                        "type": "image_picker",
                        "id": "image_2",
                        "label": "Image - 2"
                    },
                    {
                        "type": "text",
                        "id": "heading_2",
                        "label": "Heading - 2"
                    },
                    {
                        "type": "url",
                        "id": "link",
                        "label": "Link"
                    },
                    {
                        "type": "richtext",
                        "id": "description",
                        "label": "Description"
                    }
                ]
            },
        ],
        "presets" :[{
            "name" : "Banner + Content Slider"
        }]
    }
  {% endschema %} 
