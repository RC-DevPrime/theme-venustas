{% style %}
    .military-discount-content-section .image-container{
        overflow:hidden;
        border-radius:16px;
    }
    .military-discount-content-section .image-container:after{
        content:"";
        display:none;
        width:80%;
        height:100%;
        position:absolute;
        top:0;
    }
    .military-discount-content-section .content-container .row{
        --bs-gutter-x: 80px;
        --bs-gutter-y: 20px;
    }
    .military-discount-content-section .discount-list-container{
        display:flex;
        flex-direction: column;
        gap:20px;
    }
    .military-discount-content-section .discount-list-container .discount-content-item{
        background: #F9F6EF;
        border-radius: 16px 16px 16px 16px;
        padding:20px 30px;
        display:flex;
        align-items:center;
        gap:20px;
    }
    .military-discount-content-section .discount-list-container .discount-content-item .discount-icon{
        width:40px;
        height:40px;
    }
    
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .military-discount-content-section .content-container .row{
            --bs-gutter-x: 0px;
        }
        .military-discount-content-section .discount-list-container{
            gap:10px;
        }
        .military-discount-content-section .discount-list-container .discount-content-item{
            border-radius: 8px;
            padding:15px 20px;
        }
    }
        
{% endstyle %}
<div class="container section-content">
    <div class="content-heading pb-lg-5 pb-md-5 pb-sm-4"> 
        <h2 class="pp-bold title-md text-center f-main pb-lg-4 pb-md-4 pb-sm-3 d-lg-block d-md-block d-sm-none" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="100" data-aos-duration="500">
            {{ section.settings.heading }}
        </h2>
        <h2 class="pp-bold title text-center f-main pb-lg-4 pb-md-4 pb-sm-3 d-lg-none d-md-none d-sm-block" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="100" data-aos-duration="500">
            {{ section.settings.heading }}
        </h2>
        <p class="pp-regular pretitle text-center col-lg-10 col-md-10 col-sm-12 mx-auto d-lg-block d-md-block d-sm-none" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="150" data-aos-duration="500">
            {{ section.settings.description }}
        </p>
        <p class="pp-regular body-lg text-center col-lg-10 col-md-10 col-sm-12 mx-auto d-lg-none d-md-none d-sm-block" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="150" data-aos-duration="500">
            {{ section.settings.description }}
        </p>
    </div>
    <div class="content-container pt-lg-4 pb-md-4 pb-sm-3">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="image-container animate-section" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="170" data-aos-duration="500">
                    <h4 class="pp-bold title f-black pb-lg-5 pb-md-5 pb-sm-4 text-lg-start text-md-start text-sm-center d-lg-none d-md-none d-sm-block">
                        {{ section.settings.discount_heading }}
                    </h4>
                    <img
                        src="{{ section.settings.background_image | image_url: width: 1600 }}"
                        srcset="{{ section.settings.background_image | image_url: width: 800 }} 800w,
                                {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
                                {{ section.settings.background_image | image_url: width: 1600 }} 1600w"
                        sizes="100vw"
                        alt="{{ section.settings.background_image.alt | escape }}"
                        loading="lazy"
                        decoding="async"
                        width="100%"
                        height="100%">
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12 d-flex justify-content-center flex-column" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="250" data-aos-duration="500">
                <div class="discount-conetent">
                    <h4 class="pp-bold title-xs f-black pb-lg-5 pb-md-5 pb-sm-4 text-lg-start text-md-start text-sm-center d-lg-block d-md-block d-sm-none" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="250" data-aos-duration="500">
                        {{ section.settings.discount_heading }}
                    </h4>
                    <div class="discount-list-container" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="300" data-aos-duration="500">
                        {% for block in section.blocks %}
                            <div class="discount-content-item">
                                <img src="{{ block.settings.icon | img_url: 'master' }}" class="discount-icon" width="50px" height="50px">
                                <span class="pp-regular f-black body-lg d-lg-block d-md-block d-sm-none">
                                    {{ block.settings.heading }}
                                </span>
                                <span class="pp-regular f-black body d-lg-none d-md-none d-sm-block">
                                    {{ block.settings.heading }}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% schema %}
    {
        "class": "military-discount-content-section",
        "name": "Military Discount Content",
        "templates": ["page"],
        "limit": 1, 
        "settings": [
            {
                "type": "image_picker",
                "id": "background_image",
                "label": "Background Image"
            },
            {
                "type": "text", 
                "id": "heading",
                "label": "Heading",
                "default": "Who can Get the Offer?"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description",
                "default": "<p>To develop accessible products that do not limit us to any environment, we believe that the world is your oyster. Ready to be explored in any condition to uncover the beautiful wonders of life. This is the mission of Venustas. To thank the soldiers for their dedication and show our lofty respect, We offer a 25% off discount to military members.</p>"
            },
            {
                "type": "text",
                "id": "discount_heading",
                "label": "Discount - Heading",
                "default": "Who can Get the Offer?"
            }
        ],
        "blocks": [
            {
                "type": "discount_item",
                "name": "Discount Item",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "icon",
                        "label": "Icon"
                    },
                    {
                        "type": "text",
                        "id": "heading",
                        "label": "Heading"
                    }
                ]
            }
        ],
        "presets" :[{
            "name" : "Military Discount Content"
        }]
    }
{% endschema %} 