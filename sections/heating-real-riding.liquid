<section class="heating-real-riding" heating-real-riding>
<div class="built-for-real-riding" style="background-color: {{ section.settings.section_background | default: '#1A1A1A' }};">
  <div class="built-for-real-riding__container">
    {# 标题区 #}
    <div class="built-for-real-riding__header">
      <h2 class="built-for-real-riding__title">{{ section.settings.title | default: 'BUILT FOR REAL RIDING' }}</h2>
      <p class="built-for-real-riding__description">{{ section.settings.description | default: 'From city streets to mountain passes, our heated gear is tested by riders in real conditions—so you can ride longer, in more comfort.' }}</p>
    </div>

    {# 场景卡片列表 #}
      {%- render 'heating-icon-benefits',
        section_id: section.id,
        blocks: section.blocks,
        section_background: section.settings.section_background,
        panel_background: section.settings.panel_background
      -%}
  </div>
</div>
</section>
{% schema %}
{
  "name": "Heating Real Riding",
  "tag": "section",
  "class": "built-for-real-riding-section",
  "settings": [
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#161615"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "BUILT FOR REAL RIDING"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From city streets to mountain passes, our heated gear is tested by riders in real conditions—so you can ride longer, in more comfort."
    }
  ],
  "blocks": [
    {
      "type": "scenario",
      "name": "Scenario",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "icon-mountain",
          "options": [
            { "value": "icon-warmth", "label": "Warmth" },
            { "value": "icon-protection", "label": "Protection" },
            { "value": "icon-comfort", "label": "Comfort" },
            { "value": "icon-rider", "label": "Rider" },
            { "value": "icon-thermometer", "label": "Thermometer" },
            { "value": "icon-mobility", "label": "Mobility" },
            { "value": "icon-duration", "label": "Duration" },
            { "value": "icon-mountain", "label": "Mountain" },
            { "value": "icon-highway", "label": "Highway" },
            { "value": "icon-urban", "label": "Urban" },
            { "value": "icon-weather", "label": "Weather" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Mountain Roads"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Cold wind. Steep climbs."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heating Real Riding",
      "blocks": [
        {
          "type": "scenario",
          "settings": {
            "icon": "icon-mountain",
            "title": "Mountain Roads",
            "text": "Cold wind. Steep climbs."
          }
        },
        {
          "type": "scenario",
          "settings": {
            "icon": "icon-highway",
            "title": "Highway Cruising",
            "text": "Sustained speed. Constant wind."
          }
        },
        {
          "type": "scenario",
          "settings": {
            "icon": "icon-urban",
            "title": "Urban Commuting",
            "text": "Stop and go. All-day comfort."
          }
        },
        {
          "type": "scenario",
          "settings": {
            "icon": "icon-weather",
            "title": "All Weather",
            "text": "Rain, snow, or shine. Stay warm."
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.built-for-real-riding {
  padding: 96px 0;
}

.built-for-real-riding__container {
  max-width: 1340px;
  margin: 0 auto;
}

.built-for-real-riding__title {
  font-size: 28px;
  font-weight: 700;
  letter-spacing: 2px;
  color: #FFFFFF;
  margin-bottom: 20px;
  text-transform: uppercase;
}

.built-for-real-riding__description {
  font-size: 16px;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.7);
}



{% endstyle %}