{%- liquid
  assign review_count = 0
  assign image_count = 0
  for block in section.blocks
    if block.type == 'review'
      if block.settings.source != blank or block.settings.rating != blank or block.settings.quote != blank or block.settings.note != blank or block.settings.button_label != blank
        assign review_count = review_count | plus: 1
      endif
    elsif block.settings.image != blank
      assign image_count = image_count | plus: 1
    endif
  endfor
-%}

{% style %}
  #shopify-section-{{ section.id }} .product-new-tested-worn {
    display: grid;
    gap: 56px;
    padding: 80px 0;
    background: #f6f6f6;
    color: #1a1a1a;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__inner {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn p,
  #shopify-section-{{ section.id }} .product-new-tested-worn h2 {
    margin: 0;
    color: inherit;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__header {
    display: grid;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__eyebrow {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.68;
    letter-spacing: 1.21px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__heading {
    font-size: 34px;
    font-weight: 700;
    line-height: 1.22;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__reviews {
    display: grid;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__review {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    min-width: 0;
    padding: 32px 28px;
    border-radius: 12px;
    background: #efded9;
    visibility: hidden;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__review.is-active {
    visibility: visible;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__review-copy {
    display: grid;
    gap: 20px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__source {
    letter-spacing: 1.68px;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn .product-new-tested-worn__rating,
  #shopify-section-{{ section.id }} .product-new-tested-worn .product-new-tested-worn__quote {
    color: #b93205;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__quote {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.22;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__note {
    font-size: 14px;
    line-height: 21px;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__quote + .product-new-tested-worn__note {
    margin-top: 8px;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 20px;
    box-sizing: border-box;
    border: 1.6px solid rgba(0, 0, 0, .07);
    border-radius: 33px;
    color: #b93205;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__gallery {
    position: relative;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__track {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__track::-webkit-scrollbar {
    display: none;
  }

  @media only screen and (min-width: 768px) and (hover: hover) {
    #shopify-section-{{ section.id }} .product-new-tested-worn__track {
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
    }
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__image-item {
    flex: 0 0 260px;
    min-width: 0;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 260 / 346.664;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__arrows {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    justify-content: space-between;
    width: min(100% - 40px, 1340px);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, .6);
    color: #1a1a1a;
    cursor: pointer;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__arrow:disabled {
    opacity: .35;
    cursor: default;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__icon {
    width: 16px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__icon--previous {
    transform: rotate(180deg);
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__scrollbar {
    display: none;
    position: relative;
    height: 4px;
    margin-top: 20px;
    background: #d8d8d8;
    border-radius: 2px;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__thumb {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: inherit;
    background: #141414;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn__caption {
    font-size: 12px;
    line-height: 1.4;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn button:focus-visible,
  #shopify-section-{{ section.id }} .product-new-tested-worn a:focus-visible,
  #shopify-section-{{ section.id }} .product-new-tested-worn__track:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .product-new-tested-worn [hidden] {
    display: none;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-new-tested-worn__heading {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .product-new-tested-worn__review {
      grid-template-columns: minmax(0, 1fr);
      padding: 32px 16px;
    }

    #shopify-section-{{ section.id }} .product-new-tested-worn__meta {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .product-new-tested-worn__quote {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .product-new-tested-worn__gallery {
      width: calc(100% - 40px);
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .product-new-tested-worn__arrows {
      display: none;
    }

    #shopify-section-{{ section.id }} .product-new-tested-worn__scrollbar {
      display: block;
    }
  }
{% endstyle %}

<product-new-tested-worn{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | strip | remove_first: '#' | escape }}"{% endif %} class="product-new-tested-worn">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="product-new-tested-worn__header product-new-tested-worn__inner">
      {%- if section.settings.eyebrow != blank -%}<p class="product-new-tested-worn__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="product-new-tested-worn__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </div>
  {%- endif -%}
  {%- if review_count > 0 -%}
    <div class="product-new-tested-worn__reviews product-new-tested-worn__inner" data-reviews>
      {%- assign review_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          {%- if block.settings.source != blank or block.settings.rating != blank or block.settings.quote != blank or block.settings.note != blank or block.settings.button_label != blank -%}
            <div class="product-new-tested-worn__review{% if review_index == 0 %} is-active{% endif %}" data-review data-block-id="{{ block.id }}" aria-hidden="{% if review_index == 0 %}false{% else %}true{% endif %}"{% unless review_index == 0 %} inert{% endunless %} {{ block.shopify_attributes }}>
              <div class="product-new-tested-worn__review-copy">
                {%- if block.settings.source != blank or block.settings.rating != blank -%}
                  <div class="product-new-tested-worn__meta">
                    {%- if block.settings.source != blank -%}<p class="product-new-tested-worn__source">{{ block.settings.source | escape }}</p>{%- endif -%}
                    {%- if block.settings.rating != blank -%}<p class="product-new-tested-worn__rating">{{ block.settings.rating | escape }}</p>{%- endif -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.quote != blank or block.settings.note != blank -%}
                  <div>
                    {%- if block.settings.quote != blank -%}<p class="product-new-tested-worn__quote">{{ block.settings.quote | escape }}</p>{%- endif -%}
                    {%- if block.settings.note != blank -%}<p class="product-new-tested-worn__note">{{ block.settings.note | escape }}</p>{%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              {%- if block.settings.button_label != blank -%}<a class="product-new-tested-worn__button" href="{{ block.settings.button_link | default: '#' | escape }}">{{ block.settings.button_label | escape }}</a>{%- endif -%}
            </div>
            {%- assign review_index = review_index | plus: 1 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if image_count > 0 -%}
    <div class="product-new-tested-worn__gallery">
      <ul class="product-new-tested-worn__track" data-track tabindex="0" role="list" aria-label="{{ section.settings.heading | default: 'Customer photos' | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'image' and block.settings.image != blank -%}
            <li class="product-new-tested-worn__image-item" data-gallery-image data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
              {{ block.settings.image | image_url: width: 780 | image_tag: class: 'product-new-tested-worn__image', loading: 'lazy', widths: '260, 520, 780', sizes: '260px' }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="product-new-tested-worn__arrows" data-arrows>
        <button class="product-new-tested-worn__arrow" type="button" data-direction="-1" aria-label="Previous photos"><span class="product-new-tested-worn__icon product-new-tested-worn__icon--previous">{% render 'heating-icons', icon: 'arrow-right' %}</span></button>
        <button class="product-new-tested-worn__arrow" type="button" data-direction="1" aria-label="Next photos"><span class="product-new-tested-worn__icon">{% render 'heating-icons', icon: 'arrow-right' %}</span></button>
      </div>
      <div class="product-new-tested-worn__scrollbar" data-scrollbar aria-hidden="true"><span class="product-new-tested-worn__thumb" data-thumb></span></div>
    </div>
  {%- endif -%}
  {%- if section.settings.caption != blank -%}<div class="product-new-tested-worn__caption product-new-tested-worn__inner">{{ section.settings.caption }}</div>{%- endif -%}
</product-new-tested-worn>

<script>
  if (!customElements.get('product-new-tested-worn')) {
    customElements.define('product-new-tested-worn', class extends HTMLElement {
      connectedCallback() {
        this.abort?.abort();
        this.abort = new AbortController();
        const initialize = () => {
          this.initFrame = requestAnimationFrame(() => { if (this.isConnected) this.initialize(); });
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialize, { once: true, signal: this.abort.signal });
        else initialize();
      }

      initialize() {
        const options = { signal: this.abort.signal };
        this.reviews = [...this.querySelectorAll('[data-review]')];
        this.reviewArea = this.querySelector('[data-reviews]');
        this.index = 0;
        this.editorSelected = false;
        this.track = this.querySelector('[data-track]');
        this.bar = this.querySelector('[data-scrollbar]');
        this.thumb = this.querySelector('[data-thumb]');
        this.arrows = this.querySelector('[data-arrows]');
        this.addEventListener('click', (event) => {
          const button = event.target.closest('[data-direction]');
          if (button && this.track) this.track.scrollBy({ left: Number(button.dataset.direction) * 268, behavior: this.scrollBehavior() });
        }, options);
        this.reviewArea?.addEventListener('focusin', () => this.schedule(), options);
        this.reviewArea?.addEventListener('focusout', () => queueMicrotask(() => this.schedule()), options);
        document.addEventListener('visibilitychange', () => this.schedule(), options);
        this.track?.addEventListener('scroll', () => this.queueUpdate(), { ...options, passive: true });
        this.track?.addEventListener('load', () => this.queueUpdate(), { ...options, capture: true });
        this.track?.addEventListener('dragstart', (event) => {
          if (window.matchMedia('(min-width: 768px)').matches) event.preventDefault();
        }, options);
        this.track?.addEventListener('pointerdown', (event) => {
          if (event.pointerType !== 'mouse' || event.button !== 0 || !window.matchMedia('(min-width: 768px)').matches || this.track.scrollWidth <= this.track.clientWidth) return;
          this.drag = { pointer: event.pointerId, x: event.clientX, scroll: this.track.scrollLeft };
          this.track.setPointerCapture(event.pointerId);
        }, options);
        this.track?.addEventListener('pointermove', (event) => {
          if (!this.drag || event.pointerId !== this.drag.pointer) return;
          const distance = event.clientX - this.drag.x;
          if (Math.abs(distance) < 4 && !this.track.classList.contains('is-dragging')) return;
          this.track.classList.add('is-dragging');
          event.preventDefault();
          this.track.scrollLeft = this.drag.scroll - distance;
        }, options);
        ['pointerup', 'pointercancel', 'lostpointercapture'].forEach((name) => {
          this.track?.addEventListener(name, (event) => {
            if (this.drag?.pointer === event.pointerId) this.finishDrag();
          }, options);
        });
        this.addEventListener('shopify:block:select', (event) => {
          const index = this.reviews.findIndex((review) => review.dataset.blockId === event.detail.blockId);
          if (index >= 0) { this.editorSelected = true; this.selectReview(index); }
          const image = [...this.querySelectorAll('[data-gallery-image]')].find((item) => item.dataset.blockId === event.detail.blockId);
          if (image && this.track) this.track.scrollTo({ left: this.track.scrollLeft + image.getBoundingClientRect().left - this.track.getBoundingClientRect().left, behavior: 'auto' });
        }, options);
        this.addEventListener('shopify:block:deselect', () => { this.editorSelected = false; this.schedule(); }, options);
        this.observer = new ResizeObserver(() => this.queueUpdate());
        if (this.track) this.observer.observe(this.track);
        if (this.bar) this.observer.observe(this.bar);
        this.updateGallery();
        this.schedule();
      }

      scrollBehavior() {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      }

      finishDrag() {
        if (!this.drag) return;
        const pointer = this.drag.pointer;
        this.drag = null;
        this.track.classList.remove('is-dragging');
        if (this.track.hasPointerCapture(pointer)) this.track.releasePointerCapture(pointer);
      }

      selectReview(index) {
        this.index = index;
        this.reviews.forEach((review, reviewIndex) => {
          const active = reviewIndex === index;
          review.classList.toggle('is-active', active);
          review.setAttribute('aria-hidden', String(!active));
          review.inert = !active;
        });
        this.schedule();
      }

      schedule() {
        clearTimeout(this.timer);
        if (!this.isConnected || this.reviews.length < 2 || document.hidden || this.editorSelected || this.reviewArea?.contains(document.activeElement)) return;
        this.timer = setTimeout(() => this.selectReview((this.index + 1) % this.reviews.length), 2000);
      }

      queueUpdate() {
        cancelAnimationFrame(this.frame);
        this.frame = requestAnimationFrame(() => this.updateGallery());
      }

      updateGallery() {
        if (!this.track) return;
        const maximum = Math.max(0, this.track.scrollWidth - this.track.clientWidth);
        const position = Math.max(0, Math.min(maximum, this.track.scrollLeft));
        this.arrows.hidden = maximum <= 1;
        this.querySelector('[data-direction="-1"]').disabled = position <= 1;
        this.querySelector('[data-direction="1"]').disabled = position >= maximum - 1;
        this.bar.hidden = maximum <= 1;
        const width = this.bar.clientWidth * Math.min(1, this.track.clientWidth / this.track.scrollWidth);
        this.thumb.style.width = `${width}px`;
        this.thumb.style.transform = `translateX(${maximum ? position / maximum * (this.bar.clientWidth - width) : 0}px)`;
      }

      disconnectedCallback() {
        this.finishDrag();
        clearTimeout(this.timer);
        cancelAnimationFrame(this.initFrame);
        cancelAnimationFrame(this.frame);
        this.abort?.abort();
        this.observer?.disconnect();
      }
    });
  }
</script>

{% schema %}
{
  "name": "productN Tested Worn",
  "tag": "section",
  "class": "product-new-tested-worn-section",
  "max_blocks": 15,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tested & Worn" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Field-tested. Winter-worn." },
    { "type": "richtext", "id": "caption", "label": "Gallery caption", "default": "<p>Real customers wearing the Classic Heated Vest. Tag <strong>#VenustasExplorer</strong> for a chance to be featured.</p>" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "source", "label": "Source", "default": "GEARJUNKIE · FIELD TEST" },
        { "type": "text", "id": "rating", "label": "Rating", "default": "★ 4.5 / 5 · Recommended" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "\"Reliable warmth across a wide range of daily and outdoor activities.\"" },
        { "type": "textarea", "id": "note", "label": "Review note", "default": "Their one complaint: the battery adds some bulk and the button is visible. Tested on the women's version." },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Read the review" },
        { "type": "url", "id": "button_link", "label": "Review link" }
      ]
    },
    {
      "type": "image",
      "name": "Customer photo",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "productN Tested Worn",
      "blocks": [
        { "type": "review" },
        { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
