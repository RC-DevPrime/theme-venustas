{% style %}
  #shopify-section-{{ section.id }} .product-battery-certification {
    position: relative;
    width: 100%;
    min-height: 765px;
    overflow: hidden;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__bg,
  #shopify-section-{{ section.id }} .product-battery-certification__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__bg {
    z-index: 0;
    background:
      radial-gradient(circle at 72% 50%, rgba(126, 176, 255, 0.44) 0, rgba(21, 26, 34, 0) 34%),
      {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .product-battery-certification__bg-image {
    display: block;
    object-fit: cover;
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__bg-image--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__container {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100% - 100px, 1240px);
    min-height: 765px;
    margin: 0 auto;
    padding: 72px 0;
    align-items: center;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__content {
    display: flex;
    width: 526px;
    max-width: 100%;
    flex-direction: column;
    gap: 100px;
    align-items: flex-start;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__title {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 28px;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__title--accent {
    color: var(--color-brand, #B93205);
  }

  #shopify-section-{{ section.id }} .product-battery-certification__bottom {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 56px;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__cert-group {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__cert-title {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__certificates {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__certificate {
    display: flex;
    width: 60px;
    height: 42px;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__certificate img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__warranty {
    display: grid;
    width: 100%;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
    padding: 24px;
    border: 1px solid #86DAFF;
    border-radius: 12px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__warranty-icon {
    display: block;
    width: 56px;
    height: 56px;
    color: {{ section.settings.text_color }};
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__warranty-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__warranty-title {
    margin: 0 0 4px;
    color: {{ section.settings.text_color }};
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__description {
    color: {{ section.settings.text_color }};
    font-size: 16px;
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-certification__description p {
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-battery-certification {
      min-height: 643px;
    }

    #shopify-section-{{ section.id }} .product-battery-certification__bg {
      background:
        radial-gradient(circle at 50% 40%, rgba(110, 178, 255, 0.44) 0, rgba(21, 26, 34, 0) 45%),
        {{ section.settings.background_color }};
    }

    #shopify-section-{{ section.id }} .product-battery-certification__bg-image--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .product-battery-certification__bg-image--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .product-battery-certification__container {
      width: 100%;
      min-height: 643px;
      padding: 40px 20px;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .product-battery-certification__content {
      width: 100%;
      justify-content: space-between;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .product-battery-certification__title {
      font-size: 24px;
      line-height: 1.18;
    }

    #shopify-section-{{ section.id }} .product-battery-certification__bottom {
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .product-battery-certification__cert-group {
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .product-battery-certification__cert-title {
      font-size: 18px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .product-battery-certification__certificates {
      width: 100%;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .product-battery-certification__warranty {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 16px;
      padding: 20px;
    }

    #shopify-section-{{ section.id }} .product-battery-certification__description {
      font-size: 14px;
      line-height: 1.25;
    }
  }
{% endstyle %}

<section class="product-battery-certification">
  <div class="product-battery-certification__bg" aria-hidden="true">
    {% if section.settings.image_desktop != blank %}
      {{
        section.settings.image_desktop
        | image_url: width: 2880
        | image_tag:
          class: 'product-battery-certification__bg-image product-battery-certification__bg-image--desktop',
          loading: 'lazy',
          widths: '750, 1000, 1340, 1600, 2000, 2400, 2880',
          sizes: '100vw',
          alt: ''
      }}
    {% endif %}

    {% if section.settings.image_mobile != blank %}
      {{
        section.settings.image_mobile
        | image_url: width: 900
        | image_tag:
          class: 'product-battery-certification__bg-image product-battery-certification__bg-image--mobile',
          loading: 'lazy',
          widths: '375, 550, 750, 900',
          sizes: '100vw',
          alt: ''
      }}
    {% elsif section.settings.image_desktop != blank %}
      {{
        section.settings.image_desktop
        | image_url: width: 900
        | image_tag:
          class: 'product-battery-certification__bg-image product-battery-certification__bg-image--mobile',
          loading: 'lazy',
          widths: '375, 550, 750, 900',
          sizes: '100vw',
          alt: ''
      }}
    {% endif %}
  </div>

  <div class="product-battery-certification__container">
    <div class="product-battery-certification__content">
      <div class="product-battery-certification__title-block">
        {% if section.settings.title != blank %}
          <h2 class="product-battery-certification__title product-battery-certification__title--accent">
            {{ section.settings.title }}
          </h2>
        {% endif %}

        {% if section.settings.title_second != blank %}
          <h2 class="product-battery-certification__title">
            {{ section.settings.title_second }}
          </h2>
        {% endif %}
      </div>

      <div class="product-battery-certification__bottom">
        <div class="product-battery-certification__cert-group">
          {% if section.settings.cert_title != blank %}
            <h3 class="product-battery-certification__cert-title">
              {{ section.settings.cert_title }}
            </h3>
          {% endif %}

          <div class="product-battery-certification__certificates">
            {% for block in section.blocks %}
              {% if block.settings.icon != blank %}
                <div class="product-battery-certification__certificate" {{ block.shopify_attributes }}>
                  {{
                    block.settings.icon
                    | image_url: width: 160
                    | image_tag:
                      loading: 'lazy',
                      widths: '60, 90, 120, 160',
                      sizes: '60px',
                      alt: block.settings.icon.alt
                  }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        {% if section.settings.warranty_title != blank or section.settings.description != blank %}
          <div class="product-battery-certification__warranty">
            <span class="product-battery-certification__warranty-icon" aria-hidden="true">
              <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M28 6L47 13.125V27.32C47 39.3 38.925 47.9 28 50.856C17.075 47.9 9 39.3 9 27.32V13.125L28 6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M24.2 31.9C24.2 31.9 25.783 29.789 28 29.789C30.217 29.789 31.8 31.9 31.8 31.9M25.044 22.922H25.065M30.956 22.922H30.977M38.556 26.722C38.556 32.551 33.829 37.278 28 37.278C22.171 37.278 17.444 32.551 17.444 26.722C17.444 20.893 22.171 16.167 28 16.167C33.829 16.167 38.556 20.893 38.556 26.722Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>

            <div class="product-battery-certification__warranty-copy">
              {% if section.settings.warranty_title != blank %}
                <h4 class="product-battery-certification__warranty-title">
                  {{ section.settings.warranty_title }}
                </h4>
              {% endif %}

              {% if section.settings.description != blank %}
                <div class="product-battery-certification__description">
                  {{ section.settings.description }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Battery Cert",
  "tag": "section",
  "class": "product-battery-certification-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#151A22"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile background image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Accent title",
      "default": "TESTED FOR SAFETY."
    },
    {
      "type": "text",
      "id": "title_second",
      "label": "Second title",
      "default": "BUILT TO LAST."
    },
    {
      "type": "text",
      "id": "cert_title",
      "label": "Certification title",
      "default": "7 Safety Certifications"
    },
    {
      "type": "text",
      "id": "warranty_title",
      "label": "Warranty title",
      "default": "1-Year Battery Warranty"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Warranty description",
      "default": "<p>Reliable support for your Venustas heated apparel power system.</p>"
    }
  ],
  "blocks": [
    {
      "type": "certificate",
      "name": "Certificate icon",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Certificate icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Battery Cert",
      "blocks": [
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        }
      ]
    }
  ]
}
{% endschema %}
