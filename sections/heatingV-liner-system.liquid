{% style %}
  #shopify-section-{{ section.id }} .heatingv-liner-system {
    width: 100%;
    overflow: hidden;
    background: #f0f0f0;
    color: var(--venustas-black, #14161a);
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__inner {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 100px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 46px;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__title {
    margin: 0;
    color: var(--venustas-black, #14161a);
    font-size: 34px;
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.952px;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__description {
    margin: 0;
    color: #565b63;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.72;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__content {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__row {
    display: grid;
    grid-template-columns: 652px minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__media {
    position: relative;
    height: 600px;
    overflow: hidden;
    border-radius: 12px;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__picture,
  #shopify-section-{{ section.id }} .heatingv-liner-system__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__image {
    object-fit: contain;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__placeholder {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 24px;
    color: #565b63;
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__details {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__product {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__meta {
    margin: 0 0 5px;
    color: var(--color-brand, #B93205);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.68;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__product-title {
    margin: 0;
    color: var(--venustas-black, #14161a);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.68;
    letter-spacing: -0.44px;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__price {
    margin: 0;
    color: var(--venustas-black, #14161a);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.4px;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__item {
    padding: 12px 0;
    border-top: 1px solid #e3e4e0;
    color: #565b63;
    font-size: 14.5px;
    font-weight: 400;
    line-height: 1.68;
  }

  #shopify-section-{{ section.id }} .heatingv-liner-system__item strong {
    color: var(--venustas-black, #14161a);
    font-weight: 700;
  }

  @media only screen and (max-width: 1000px) {
    #shopify-section-{{ section.id }} .heatingv-liner-system__image {
      object-fit: cover;
      object-position: center;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__inner {
      width: 100%;
      padding: 56px 20px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__header {
      gap: 12px;
      margin-bottom: 32px;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__title {
      font-size: 24px;
      line-height: 1.3;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__description {
      font-size: 14px;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__content {
      gap: 40px;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__row {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__media {
      width: 100%;
      height: 464px;
      border-radius: 12px;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__details {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__product {
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__meta {
      margin: 0 0 4px;
      font-size: 12px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__product-title {
      font-size: 18px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__price {
      font-size: 16px;
      line-height: 1.2;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heatingv-liner-system__item {
      padding: 12px 0;
      border-top: 0;
      border-bottom: 1px solid #e3e4e0;
      font-size: 14px;
      line-height: 1.5;
    }
  }
{% endstyle %}

{%- liquid
  assign mens_mobile = section.settings.mens_mobile_image | default: section.settings.mens_desktop_image
  assign mens_image = section.settings.mens_desktop_image | default: mens_mobile
  assign womens_mobile = section.settings.womens_mobile_image | default: section.settings.womens_desktop_image
  assign womens_image = section.settings.womens_desktop_image | default: womens_mobile
-%}

<section class="heatingv-liner-system" id="heatingv-volcano-series">
  <div class="heatingv-liner-system__inner">
    <div class="heatingv-liner-system__header">
      {%- if section.settings.title != blank -%}
        <h2 class="heatingv-liner-system__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="heatingv-liner-system__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="heatingv-liner-system__content">
      <div class="heatingv-liner-system__row">
        <div class="heatingv-liner-system__media">
          {%- if mens_image != blank -%}
            <picture class="heatingv-liner-system__picture">
              {%- if mens_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ mens_mobile | image_url: width: 700 }} 700w, {{ mens_mobile | image_url: width: 1000 }} 1000w" sizes="calc(100vw - 40px)">
              {%- endif -%}
              {{
                mens_image
                | image_url: width: 1500
                | image_tag:
                  class: 'heatingv-liner-system__image',
                  loading: 'lazy',
                  widths: '350, 700, 1000, 1200, 1500',
                  sizes: '(max-width: 767px) calc(100vw - 40px), 658px',
                  alt: mens_image.alt | default: "Volcano Pro Dual-Battery Heated Vest, Men's"
              }}
            </picture>
          {%- else -%}
            <div class="heatingv-liner-system__placeholder">Upload the men's image.</div>
          {%- endif -%}
        </div>

        <div class="heatingv-liner-system__details">
          <div class="heatingv-liner-system__product">
            <div>
              <p class="heatingv-liner-system__meta">MV11 Men's</p>
              <h3 class="heatingv-liner-system__product-title">Volcano™ Pro Dual-Battery Heated Vest</h3>
              <p class="heatingv-liner-system__price">$339.99</p>
            </div>
            <ul class="heatingv-liner-system__list">
              <li class="heatingv-liner-system__item"><strong>41W</strong> across six zones</li>
              <li class="heatingv-liner-system__item"><strong>144°F/130°F/112°F</strong> — three levels</li>
              <li class="heatingv-liner-system__item"><strong>Two 7.5K batteries</strong> included. 10.8Wh</li>
              <li class="heatingv-liner-system__item"><strong>12V ready</strong> — DC lead built into the left pocket</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="heatingv-liner-system__row">
        <div class="heatingv-liner-system__media">
          {%- if womens_image != blank -%}
            <picture class="heatingv-liner-system__picture">
              {%- if womens_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ womens_mobile | image_url: width: 700 }} 700w, {{ womens_mobile | image_url: width: 1000 }} 1000w" sizes="calc(100vw - 40px)">
              {%- endif -%}
              {{
                womens_image
                | image_url: width: 1500
                | image_tag:
                  class: 'heatingv-liner-system__image',
                  loading: 'lazy',
                  widths: '350, 700, 1000, 1200, 1500',
                  sizes: '(max-width: 767px) calc(100vw - 40px), 658px',
                  alt: womens_image.alt | default: "Volcano Pro Dual-Battery Heated Vest, Women's"
              }}
            </picture>
          {%- else -%}
            <div class="heatingv-liner-system__placeholder">Upload the women's image.</div>
          {%- endif -%}
        </div>

        <div class="heatingv-liner-system__details">
          <div class="heatingv-liner-system__product">
            <div>
              <p class="heatingv-liner-system__meta">WV12 Women's</p>
              <h3 class="heatingv-liner-system__product-title">Volcano™ Pro Dual-Battery Heated Vest</h3>
              <p class="heatingv-liner-system__price">$339.99</p>
            </div>
            <ul class="heatingv-liner-system__list">
              <li class="heatingv-liner-system__item"><strong>38W</strong> across six zones</li>
              <li class="heatingv-liner-system__item"><strong>144°F/130°F/112°F</strong> — three levels</li>
              <li class="heatingv-liner-system__item"><strong>Two 7.5K batteries</strong> included. 10.8Wh</li>
              <li class="heatingv-liner-system__item"><strong>12V ready</strong> — DC lead built into the left pocket</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "HeatingV Liner System",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "ProductH title",
      "default": "Engineered for Him. Engineered for Her."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "ProductH description",
      "default": "<p>Both carry 6 heating zones, two 7.5K batteries and a 12V lead. Each is shaped to sit close without pulling, so a mid-layer stays a mid-layer under a shell.</p>"
    },
    {
      "type": "header",
      "content": "Men's image"
    },
    {
      "type": "image_picker",
      "id": "mens_desktop_image",
      "label": "Men's desktop image"
    },
    {
      "type": "image_picker",
      "id": "mens_mobile_image",
      "label": "Men's mobile image"
    },
    {
      "type": "header",
      "content": "Women's image"
    },
    {
      "type": "image_picker",
      "id": "womens_desktop_image",
      "label": "Women's desktop image"
    },
    {
      "type": "image_picker",
      "id": "womens_mobile_image",
      "label": "Women's mobile image"
    }
  ],
  "presets": [
    {
      "name": "HeatingV Liner System"
    }
  ]
}
{% endschema %}
