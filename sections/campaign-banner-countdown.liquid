        "class": "campaign-banner-countdown-main-section",
        "name": "Campaign Banner Countdown",
        "templates": ["page"],
        "limit": 1, 
        "settings": [
            {
                "type": "image_picker",
                "id": "background_image",
                "label": "Background Image"
            },
            {
                "type": "image_picker",
                "id": "background_image_mobile",
                "label": "Background Image - Mobile"
            },
            {
              "type": "text",
              "id": "target_datetime",
              "label": "Target Date & Time",
              "placeholder": "2026-3-31T23:59:59",
              "default": "2026-3-31T23:59:59",
              "info": "Enter the date and time in ISO 8601 format: YYYY-MM-DDTHH:MM:SS (example: 2026-12-31T23:59:59). Use 24-hour time."
            }

        ],
        "presets" :[{
            "name" : "Campaign Banner Countdown"
        }]
    }
  {% endschema %} 