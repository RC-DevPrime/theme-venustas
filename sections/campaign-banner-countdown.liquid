{% style %}
.campaign-banner-countdown-main-section{
  position:relative;
  z-index: 9;
}
.campaign-banner-countdown-section {
    position:relative;
    display: flex;
    justify-content: center;
    align-items: center;
    background:#000;
}
.campaign-banner-countdown-section .bg-image{
    width:100%;
    height:100%;
    object-fit:contain;
}
.campaign-banner-countdown-section .banner-content{
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:100%;
}
.newsletter__message.newsletter__message--success{
  color:#FFF;
  margin-top:10px;
}
/* Countdown container */
.campaign-banner-countdown-section .countdown {
    display: flex;
    gap: 2rem;
    text-align: center;
    align-items: center;
}

/* Time box */
.campaign-banner-countdown-section .time-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #F9F6EF;
    padding: 15px 7px 7px;
    width: 85px;
    border-radius: 4px 4px 4px 4px;
    position:relative;
}
.campaign-banner-countdown-section .time-box:after{
  content:":";    
  position: absolute;
  right: -20%;
  top: 30%;
  color: #FFF;
  font-weight:500;

}
.campaign-banner-countdown-section .time-box:last-child:after{
  display:none;
}

/* Number layout */
.campaign-banner-countdown-section .number {
  --size: 34px;
  display: inline-flex;
  align-items: center;
  gap: 0.15em;
  font-size: var(--size);
  font-weight: 700;
  line-height: 1;
  height: 1em;
  overflow: hidden;
  font-variant-numeric: tabular-nums;
}

/* Digit wrapper */
.campaign-banner-countdown-section .digit {
  position: relative;
  width: 1ch;
  height: 1em;
  overflow: hidden;
}

/* Each moving digit */
.campaign-banner-countdown-section .digit span {
    position: absolute;
    color: #B93205;
    left: 0;
    right: 0;
    text-align: center;
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
    will-change: transform, opacity;
    backface-visibility: hidden;
    font-weight: 700 !important;
}

/* old number goes up */
.campaign-banner-countdown-section .digit span.to-up {
  transform: translateY(-100%);
  opacity: 0;
}

/* new number starts below and rises */
.campaign-banner-countdown-section .digit span.below {
  transform: translateY(100%);
  opacity: 0;
}
.campaign-banner-countdown-section .digit span.below.rise {
  transform: translateY(0);
  opacity: 1;
}

/* Label */
.campaign-banner-countdown-section .label {
  font-size: 16px;
  margin-top: 10px;
  line-height:normal;
}

@media (prefers-reduced-motion: reduce) {
  .campaign-banner-countdown-section .digit span {
    transition: none;
  }
}

.campaign-banner-countdown-section .fill-heading{
    background: #B93205;
    padding:6px 30px;
    width:fit-content;
    border-radius:10px;
    position:relative;
}
.campaign-banner-countdown-section .fill-heading .element-img{
    position: absolute;
    width: 60px;
    right: -11%;
    bottom: -40%;
}
.campaign-banner-countdown-section .fill-heading span{
    font-size:94px;
    line-height: 105px;
}
.campaign-banner-countdown-section .outline-heading{
    width:fit-content;
    transform: rotate(353deg) translateY(20%) translateX(2%);
    position: relative;
    z-index: 1;
}
.campaign-banner-countdown-section .outline-heading span{
    font-size:100px;
    color: #000000;
    -webkit-text-stroke: 1px #ffffff;
}
.campaign-banner-countdown-section .form-subscription-container .form-container-newsletter{
    display:flex;
    gap:8px;
    width:35%;
    margin-top:30px;
}
.campaign-banner-countdown-section .form-subscription-container input{
    flex:1;
    background: #343434;
    border:none;
    border-radius: 12px 12px 12px 12px;
    padding:10px;
    color:#FFF;
}
.campaign-banner-countdown-section .form-subscription-container button{
    border:none;
    padding:10px 35px;
    background: #B93205;
    border-radius: 12px 12px 12px 12px;
    transition: all .5s ease;
}
.campaign-banner-countdown-section .form-subscription-container button:hover{
    background: #161616;
}
.newsletter__message--error {
    color: #cc0023;
    font-weight: 500;
    font-size: 16px;
    margin-top: 12px;
}

/* FOR MOBILE PHONE */
@media only screen and (max-width: 768px) {
  .campaign-banner-countdown-section .time-box{
    width:60px;
  }
  .campaign-banner-countdown-section .countdown{
    justify-content:center;
  }
  .campaign-banner-countdown-section .form-subscription-container{
    width:100%;
  }
}

