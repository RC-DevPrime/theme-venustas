{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign card_blocks = section.blocks | where: 'type', 'card'
-%}

{% style %}
  #shopify-section-{{ section.id }} .heating-riding-position {
    padding:22px 0;
    width: 100%;
    overflow: hidden;
    background-color: #0F1110;
    {%- if section.settings.desktop_background != blank -%}
      background-image: url({{ section.settings.desktop_background | image_url: width: 2000 }});
    {%- endif -%}
    background-position: center top;
    background-repeat: no-repeat;
    background-size: cover;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .heating-riding-position__inner {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding-top: 96px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-riding-position__header {
    max-width: 900px;
    margin-bottom: 56px;
  }

  #shopify-section-{{ section.id }} .heating-riding-position__eyebrow {
    margin: 0 0 8px;
    color: var(--color-brand, #B93205);
    font-size: 24px;
    font-weight: 800;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-position__heading {
    margin: 0 0 32px;
    color: #fff;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.12;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-position__description {
    max-width: 1080px;
    margin: 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-position__features {
    margin-bottom: 56px;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .heating-riding-position__features.heating-icon-benefits .heating-icon-benefits__inner {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .heating-riding-position__features .heating-icon-benefits__panel {
    backdrop-filter: blur(10px);
  }

  #shopify-section-{{ section.id }} .heating-riding-position__cards {
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .heating-riding-position__cards .swiper-wrapper {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .heating-riding-position__cards .swiper-slide {
    width: auto;
    height: auto;
  }

  #shopify-section-{{ section.id }} .heating-riding-position-card {
    height: 100%;
    overflow: hidden;
    border: 1px solid #2A2A28;
    border-radius: 8px;
    background: #161615;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .heating-riding-position-card__media {
    padding: 24px 24px 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-position-card__image,
  #shopify-section-{{ section.id }} .heating-riding-position-card__placeholder {
    width: 100%;
    /* aspect-ratio: 394 / 226; */
    max-height: 240px;
    display: block;
    border-radius: 6px;
    object-fit: cover;
    background: #242424;
  }

  #shopify-section-{{ section.id }} .heating-riding-position-card__body {
    padding: 20px 24px 24px;
  }

  #shopify-section-{{ section.id }} .heating-riding-position-card__title {
    margin: 0 0 12px;
    color: #fff;
    font-size: 24px;
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-position-card__description {
    margin: 0 0 20px;
    color: rgba(255, 255, 255, 0.84);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.38;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-position-card__list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 20px 0 0;
    border-top: 1px solid #2A2A28;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .heating-riding-position-card__item {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    color: #fff;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-position-card__item-icon {
    width: 24px;
    height: 24px;
    color: var(--color-brand, #B93205);
  }

  #shopify-section-{{ section.id }} .heating-riding-position-card__item-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .heating-riding-position__pagination {
    display: none;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heating-riding-position {
      {%- if section.settings.mobile_background != blank -%}
        background-image: url({{ section.settings.mobile_background | image_url: width: 900 }});
      {%- elsif section.settings.desktop_background != blank -%}
        background-image: url({{ section.settings.desktop_background | image_url: width: 900 }});
      {%- endif -%}
      background-position: center top;
      padding:0 20px;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__inner {
      width: 100%;
      padding-top: 28px;
      padding-bottom:28px;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__header {
      margin-bottom: 36px;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__eyebrow {
      margin-bottom: 6px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__heading {
      margin-bottom: 8px;
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__description {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__features {
      margin-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__features .heating-icon-benefits__title,
    #shopify-section-{{ section.id }} .heating-riding-position__features .heating-icon-benefits__text {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__cards {
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__cards .swiper-wrapper {
      display: flex;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__cards .swiper-slide {
      width: 100%;
      flex-shrink: 0;
    }


    #shopify-section-{{ section.id }} .heating-riding-position-card__list {
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__pagination {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin-top: 18px;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__pagination .swiper-pagination-bullet {
      width: 6px;
      height: 6px;
      margin: 0 !important;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.24);
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .heating-riding-position__pagination .swiper-pagination-bullet-active {
      background: var(--color-brand, #B93205);
    }
  }
{% endstyle %}

<section class="heating-riding-position">
  <div class="heating-riding-position__inner">
    <div class="heating-riding-position__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="heating-riding-position__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="heating-riding-position__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="heating-riding-position__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if feature_blocks.size > 0 -%}
      {%- render 'heating-icon-benefits',
        section_id: section.id,
        blocks: feature_blocks,
        root_class: 'heating-riding-position__features',
        section_background: 'transparent',
        panel_background: 'rgba(22, 22, 21, 0.40)',
        inner_padding: '0',
        mobile_inner_padding: '0',
        panel_padding: '24px 42px',
        mobile_panel_padding: '16px',
        panel_gap: '38px',
        mobile_panel_gap: '32px'
      -%}
    {%- endif -%}

    {%- if card_blocks.size > 0 -%}
      <div class="heating-riding-position__cards swiper" id="heating-riding-position-cards-{{ section.id }}">
        <div class="swiper-wrapper">
          {%- for block in card_blocks -%}
            <div class="swiper-slide">
              {%- render 'heating-riding-position-card', block: block -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="heating-riding-position__pagination" id="heating-riding-position-pagination-{{ section.id }}"></div>
    {%- endif -%}
  </div>
</section>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var swiper = null;

    function init() {
      var slider = document.getElementById('heating-riding-position-cards-' + sectionId);
      if (!slider || typeof Swiper === 'undefined') return;

      if (window.matchMedia('(min-width: 768px)').matches) {
        if (swiper) {
          swiper.destroy(true, true);
          swiper = null;
        }
        return;
      }

      if (swiper || slider.swiper) return;

      swiper = new Swiper(slider, {
        slidesPerView: 1,
        spaceBetween: 16,
        pagination: {
          el: '#heating-riding-position-pagination-' + sectionId,
          clickable: true
        }
      });
    }

    document.addEventListener('DOMContentLoaded', init);
    window.addEventListener('load', init);
    window.addEventListener('resize', init);
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === sectionId) init();
    });
  })();
</script>

