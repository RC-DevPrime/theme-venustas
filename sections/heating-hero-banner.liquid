{% style %}
  #shopify-section-{{ section.id }} .heating-hero-banner {
    position: relative;
    width: 100%;
    height: 670px;
    overflow: hidden;
    background: #1a1a1a;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .heating-hero-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .heating-hero-banner__image--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .heating-hero-banner__inner {
    position: relative;
    z-index: 1;
    width: min(100% - 40px, 1340px);
    height: 100%;
    margin-left: auto;
    margin-right: auto;
    padding-top: 42px;
    box-sizing: border-box;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-hero-banner__eyebrow {
    margin: 0 0 16px;
    color: var(--color-brand);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-hero-banner__title {
    margin: 0;
    color: #fff;
    font-size: 48px;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .heating-hero-banner__description {
    margin: 22px auto 0;
    max-width: 760px;
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-hero-banner__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heating-hero-banner__buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 40px;
  }

  #shopify-section-{{ section.id }} .heating-hero-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    border-radius: 6px;
    background: var(--color-brand);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    text-align: center;
    text-decoration: none;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heating-hero-banner {
      height: 543px;
    }

    #shopify-section-{{ section.id }} .heating-hero-banner__image--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .heating-hero-banner__image--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .heating-hero-banner__inner {
      width: 100%;
      padding: 0 20px 24px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .heating-hero-banner__eyebrow {
      margin-bottom: 8px;
      font-size: 16px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .heating-hero-banner__title {
      font-size: 36px;
      line-height: 1.02;
    }

    #shopify-section-{{ section.id }} .heating-hero-banner__description {
      margin: 14px 0 0;
      max-width: none;
      font-size: 16px;
      line-height: 1.28;
    }

    #shopify-section-{{ section.id }} .heating-hero-banner__buttons {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      margin-top: 18px;
    }

    #shopify-section-{{ section.id }} .heating-hero-banner__button {
      width: 100%;
      padding: 16px;
      box-sizing: border-box;
    }
  }
{% endstyle %}

<section class="heating-hero-banner">
  {%- if section.settings.image_desktop != blank -%}
    {{
      section.settings.image_desktop
      | image_url: width: 2680
      | image_tag:
        class: 'heating-hero-banner__image heating-hero-banner__image--desktop',
        loading: 'eager',
        widths: '750,1000,1340,1600,2000,2680',
        sizes: '100vw',
        alt: section.settings.image_desktop.alt | default: section.settings.title
    }}
  {%- endif -%}

  {%- if section.settings.image_mobile != blank -%}
    {{
      section.settings.image_mobile
      | image_url: width: 900
      | image_tag:
        class: 'heating-hero-banner__image heating-hero-banner__image--mobile',
        loading: 'eager',
        widths: '390,600,780,900',
        sizes: '100vw',
        alt: section.settings.image_mobile.alt | default: section.settings.title
    }}
  {%- elsif section.settings.image_desktop != blank -%}
    {{
      section.settings.image_desktop
      | image_url: width: 900
      | image_tag:
        class: 'heating-hero-banner__image heating-hero-banner__image--mobile',
        loading: 'eager',
        widths: '390,600,780,900',
        sizes: '100vw',
        alt: section.settings.image_desktop.alt | default: section.settings.title
    }}
  {%- endif -%}

  <div class="heating-hero-banner__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="heating-hero-banner__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="heating-hero-banner__title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="heating-hero-banner__description">{{ section.settings.description }}</div>
    {%- endif -%}

    <div class="heating-hero-banner__buttons">
      {%- if section.settings.primary_button_text != blank -%}
        <a class="heating-hero-banner__button" href="{{ section.settings.primary_button_link | default: '#' }}">
          {{ section.settings.primary_button_text }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_button_text != blank -%}
        <a class="heating-hero-banner__button" href="{{ section.settings.secondary_button_link | default: '#' }}">
          {{ section.settings.secondary_button_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Heating Hero Banner",
  "tag": "section",
  "class": "heating-hero-banner-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small title",
      "default": "Venustas Heated Riding System"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "RIDE BEYOND THE COLD"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Heated gear built for modern riders - from everyday commutes to long-distance adventures.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary button text",
      "default": "Explore Heated Gear"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary button text",
      "default": "Build Your Heated Setup"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Heating Hero Banner"
    }
  ]
}
{% endschema %}
