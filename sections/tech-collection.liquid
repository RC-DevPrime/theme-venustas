    {
      "type": "range",
      "id": "mobile_content_width_percent",
      "label": "Mobile content width (%)",
      "min": 88,
      "max": 100,
      "step": 1,
      "default": 94,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 20,
      "max": 180,
      "step": 2,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 20,
      "max": 180,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
