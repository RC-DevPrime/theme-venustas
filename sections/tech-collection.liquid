{% assign section_anchor = section.settings.anchor_id | default: 'tech-shop-categories' | strip %}
<section id="venustas-tech-shop-categories-{{ section.id }}" class="venustas-tech-shop-categories">
  {% if section_anchor != blank %}
    <span id="{{ section_anchor | escape }}" aria-hidden="true"></span>
  {% endif %}

  <div class="venustas-tech-shop-categories__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="venustas-tech-shop-categories__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="venustas-tech-shop-categories__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="venustas-tech-shop-categories__slider" id="tech-shop-categories-slider-{{ section.id }}">
      <button class="venustas-tech-shop-categories__arrow venustas-tech-shop-categories__arrow--prev" aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="venustas-tech-shop-categories__viewport">
        <div class="venustas-tech-shop-categories__track">
          {% for block in section.blocks limit: 8 %}
            {% assign card_image = block.settings.image %}
            {% assign card_title = block.settings.title | strip %}
            {% assign card_link = block.settings.link %}
            {% if card_image != blank or card_title != blank %}
              <article class="venustas-tech-shop-categories__card" {{ block.shopify_attributes }}>
                {% if card_link != blank %}
                  <a class="venustas-tech-shop-categories__card-link" href="{{ card_link }}" target="_blank" rel="noopener noreferrer">
                {% else %}
                  <div class="venustas-tech-shop-categories__card-link">
                {% endif %}
                    <div class="venustas-tech-shop-categories__media">
                      {% if card_image != blank %}
                        <img
                          class="venustas-tech-shop-categories__image"
                          src="{{ card_image | image_url: width: 1200 }}"
                          srcset="
                            {{ card_image | image_url: width: 640 }} 640w,
                            {{ card_image | image_url: width: 900 }} 900w,
                            {{ card_image | image_url: width: 1200 }} 1200w
                          "
                          sizes="(max-width: 768px) 92vw, (max-width: 1100px) 45vw, 32vw"
                          alt="{{ card_title | escape }}"
                          loading="lazy"
                        >
                      {% else %}
                        <div class="venustas-tech-shop-categories__placeholder">Add image</div>
                      {% endif %}
                      <div class="venustas-tech-shop-categories__overlay"></div>
                      {% if card_title != blank %}
                        <h3 class="venustas-tech-shop-categories__card-title">{{ card_title }}</h3>
                      {% endif %}
                    </div>
                {% if card_link != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <button class="venustas-tech-shop-categories__arrow venustas-tech-shop-categories__arrow--next" aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  #venustas-tech-shop-categories-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --heading-color: {{ section.settings.heading_color }};
    --subheading-color: {{ section.settings.subheading_color }};
    --card-title-color: {{ section.settings.card_title_color }};
    --card-title-hover-color: {{ section.settings.card_title_hover_color }};
    --overlay-start: {{ section.settings.overlay_start_color }};
    --overlay-end: {{ section.settings.overlay_end_color }};
    --arrow-bg: {{ section.settings.arrow_bg_color }};
    --arrow-color: {{ section.settings.arrow_color }};
    --arrow-hover-bg: {{ section.settings.arrow_hover_bg_color }};
    --arrow-hover-color: {{ section.settings.arrow_hover_color }};

    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --content-width: {{ section.settings.content_width_percent }}%;
    --heading-size: {{ section.settings.heading_size }}px;
    --subheading-size: {{ section.settings.subheading_size }}px;
    --card-title-size: {{ section.settings.card_title_size }}px;
    --card-gap: {{ section.settings.card_gap }}px;
    --card-radius: {{ section.settings.card_radius }}px;
    /* Desktop/tablet: proportional box — ratio stays constant when viewport or column count changes */
    --card-aspect-w: {{ section.settings.card_aspect_ratio_w | default: 432 }};
    --card-aspect-h: {{ section.settings.card_aspect_ratio_h | default: 464 }};
  }

  #venustas-tech-shop-categories-{{ section.id }} {
    background: var(--bg);
    padding: var(--pt) 0 var(--pb);
    overflow: hidden;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__inner {
    width: var(--content-width);
    max-width: 1600px;
    margin: 0 auto;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__heading {
    margin: 0;
    text-align: center;
    color: var(--heading-color);
    font-size: var(--heading-size);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__subheading {
    margin: 8px 0 28px;
    text-align: center;
    color: var(--subheading-color);
    font-size: var(--subheading-size);
    line-height: 1.25;
    font-weight: 700;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__slider {
    position: relative;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__viewport {
    overflow: hidden;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__track {
    display: flex;
    gap: var(--card-gap);
    transition: transform .4s ease;
    will-change: transform;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__card {
    flex: 0 0 calc((100% - (var(--card-gap) * 2)) / 3);
    min-width: 0;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__card-link {
    display: block;
    position: relative;
    border-radius: var(--card-radius);
    overflow: hidden;
    text-decoration: none;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__media {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: var(--card-aspect-w) / var(--card-aspect-h);
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__image,
  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__image {
    object-fit: cover;
    display: block;
    transition: transform .45s ease;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__placeholder {
    background: #cfcfcf;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    font-size: 14px;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--overlay-start) 0%, var(--overlay-end) 100%);
    transition: opacity .35s ease;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__card-title {
    position: absolute;
    inset: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--card-title-color);
    font-size: var(--card-title-size);
    line-height: 1.2;
    font-weight: 700;
    text-align: center;
    padding: 0 20px;
    transition: transform .35s ease, opacity .35s ease;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__card-link:hover .venustas-tech-shop-categories__image {
    transform: scale(1.07);
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__card-link:hover .venustas-tech-shop-categories__overlay {
    opacity: .75;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__card-link:hover .venustas-tech-shop-categories__card-title {
    color: var(--card-title-hover-color);
    transform: translateY(-4px);
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 0;
    background: var(--arrow-bg);
    color: var(--arrow-color);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    padding: 0;
    transition: background-color .25s ease, color .25s ease;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__arrow svg {
    width: 22px;
    height: 22px;
    transition: color .25s ease;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__arrow:hover:not(:disabled) {
    background: var(--arrow-hover-bg);
    color: var(--arrow-hover-color);
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__arrow:disabled {
    opacity: .45;
    cursor: not-allowed;
  }

  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__arrow--prev { left: -26px; }
  #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__arrow--next { right: -26px; }

  @media (max-width: 1100px) {
    #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__card {
      flex-basis: calc((100% - var(--card-gap)) / 2);
    }
  }

  @media (max-width: 768px) {
    #venustas-tech-shop-categories-{{ section.id }} {
      --pt: {{ section.settings.mobile_padding_top }}px;
      --pb: {{ section.settings.mobile_padding_bottom }}px;
      --content-width: {{ section.settings.mobile_content_width_percent }}%;
      --heading-size: {{ section.settings.mobile_heading_size }}px;
      --subheading-size: {{ section.settings.mobile_subheading_size }}px;
      --card-title-size: {{ section.settings.mobile_card_title_size }}px;
      --card-gap: {{ section.settings.mobile_card_gap }}px;
      --card-height: {{ section.settings.mobile_card_height }}px;
    }

    #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__media {
      aspect-ratio: auto;
      height: var(--card-height);
    }

    #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__subheading {
      margin-bottom: 20px;
    }

    #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__card {
      flex-basis: 100%;
    }

    #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__arrow {
      width: 42px;
      height: 42px;
    }

    #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__arrow--prev { left: 8px; }
    #venustas-tech-shop-categories-{{ section.id }} .venustas-tech-shop-categories__arrow--next { right: 8px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('tech-shop-categories-slider-{{ section.id }}');
    if (!root) return;

    var track = root.querySelector('.venustas-tech-shop-categories__track');
    var prev = root.querySelector('.venustas-tech-shop-categories__arrow--prev');
    var next = root.querySelector('.venustas-tech-shop-categories__arrow--next');
    if (!track || !prev || !next) return;

    var index = 0;
    var timer = null;
    var interval = {{ section.settings.autoplay_interval }} * 1000;

    function slides() {
      return Array.prototype.slice.call(track.querySelectorAll('.venustas-tech-shop-categories__card'));
    }

    function perView() {
      if (window.innerWidth <= 768) return 1;
      if (window.innerWidth <= 1100) return 2;
      return 3;
    }

    function maxIndex() {
      return Math.max(0, slides().length - perView());
    }

    function stepWidth() {
      var list = slides();
      if (!list.length) return 0;
      var width = list[0].getBoundingClientRect().width;
      var gap = parseFloat(window.getComputedStyle(track).gap || 0);
      return width + gap;
    }

    function update() {
      var list = slides();
      if (!list.length) {
        prev.style.display = 'none';
        next.style.display = 'none';
        return;
      }
      var max = maxIndex();
      if (index > max) index = max;
      track.style.transform = 'translateX(-' + (index * stepWidth()) + 'px)';
      var hide = max <= 0;
      prev.style.display = hide ? 'none' : 'inline-flex';
      next.style.display = hide ? 'none' : 'inline-flex';
      prev.disabled = hide;
      next.disabled = hide;
    }

    function nextSlide() {
      var max = maxIndex();
      if (max <= 0) return;
      index = index >= max ? 0 : index + 1;
      update();
    }

    function stopAuto() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function startAuto() {
      stopAuto();
      if (!{{ section.settings.enable_autoplay | json }}) return;
      timer = setInterval(nextSlide, interval);
    }

    prev.addEventListener('click', function () {
      var max = maxIndex();
      if (max <= 0) return;
      index = index <= 0 ? max : index - 1;
      update();
      startAuto();
    });

    next.addEventListener('click', function () {
      nextSlide();
      startAuto();
    });

    root.addEventListener('mouseenter', stopAuto);
    root.addEventListener('mouseleave', startAuto);
    window.addEventListener('resize', function () {
      update();
      startAuto();
    });

    update();
    startAuto();
  })();
</script>

{% schema %}
{
  "name": "Tech Shop Categories",
  "tag": "section",
  "class": "venustas-tech-shop-categories-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section Anchor ID",
      "default": "tech-shop-categories"
