{%- comment -%}
  Product In The Field
  Lifestyle image carousel: a row of portrait photos of the product in use,
  swipeable, with a bar-style pagination underneath. Cooling-vest only (no
  preset) so it can't be added to other pages.
{%- endcomment -%}

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .itf {
    padding: 56px 0 64px;
  }
  #shopify-section-{{ section.id }} .itf__heading {
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    text-align: center;
    text-transform: {{ section.settings.heading_transform }};
    margin: 0 0 {% if section.settings.subheading == blank %}40px{% else %}8px{% endif %};
  }
  #shopify-section-{{ section.id }} .itf__subheading {
    text-align: center;
    color: #5a6470;
    font-size: 15px;
    max-width: 720px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .itf__swiper {
    overflow: hidden;
    padding: 0 40px;
    position: relative;
  }
  /* Prev / next arrow buttons (desktop) */
  #shopify-section-{{ section.id }} .itf__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #e0e6ee;
    box-shadow: 0 5px 16px rgba(11,30,60,0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: {{ section.settings.heading_color }};
    transition: background .2s ease, color .2s ease, opacity .2s ease;
  }
  #shopify-section-{{ section.id }} .itf__nav:hover {
    background: {{ section.settings.active_dot_color }};
    color: #fff;
  }
  #shopify-section-{{ section.id }} .itf__nav svg { width: 20px; height: 20px; }
  #shopify-section-{{ section.id }} .itf__nav--prev { left: 0; }
  #shopify-section-{{ section.id }} .itf__nav--next { right: 0; }
  #shopify-section-{{ section.id }} .itf__nav.swiper-button-disabled {
    opacity: .35;
    cursor: default;
  }
  #shopify-section-{{ section.id }} .itf__slide {
    border-radius: 16px;
    overflow: hidden;
    background: #dfe7f0;
    aspect-ratio: {{ section.settings.image_ratio }};
  }
  #shopify-section-{{ section.id }} .itf__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .itf__slide .itf__ph {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9aa7b4;
    font-size: 13px;
  }
  /* Bar pagination */
  #shopify-section-{{ section.id }} .itf__pag {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
  }
  #shopify-section-{{ section.id }} .itf__pag .swiper-pagination-bullet {
    width: 26px;
    height: 5px;
    border-radius: 3px;
    background: {{ section.settings.dot_color }};
    opacity: 1;
    margin: 0 !important;
    transition: width .25s ease, background .25s ease;
  }
  #shopify-section-{{ section.id }} .itf__pag .swiper-pagination-bullet-active {
    width: 40px;
    background: {{ section.settings.active_dot_color }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .itf { padding: 40px 0 48px; }
    #shopify-section-{{ section.id }} .itf__swiper { padding: 0 20px; }
    #shopify-section-{{ section.id }} .itf__nav { display: none; }
  }
{% endstyle %}

<div class="itf">
  {% if section.settings.heading != blank %}
    <h2 class="itf__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.subheading != blank %}
    <p class="itf__subheading">{{ section.settings.subheading }}</p>
  {% endif %}

  <div class="itf__swiper swiper" id="itf-swiper-{{ section.id }}">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide itf__slide" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.alt | escape }}" loading="lazy">
          {% else %}
            <div class="itf__ph">Lifestyle image</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <button type="button" class="itf__nav itf__nav--prev" id="itf-prev-{{ section.id }}" aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button type="button" class="itf__nav itf__nav--next" id="itf-next-{{ section.id }}" aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
  <div class="itf__pag" id="itf-pag-{{ section.id }}"></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('#itf-swiper-{{ section.id }}', {
      slidesPerView: 1.25,
      spaceBetween: 16,
      pagination: { el: '#itf-pag-{{ section.id }}', clickable: true },
      navigation: { prevEl: '#itf-prev-{{ section.id }}', nextEl: '#itf-next-{{ section.id }}' },
      breakpoints: {
        600:  { slidesPerView: 2.2, spaceBetween: 18 },
        769:  { slidesPerView: 3, spaceBetween: 22 },
        990:  { slidesPerView: {{ section.settings.columns_desktop }}, spaceBetween: 24 }
      }
    });
  });
</script>

{% schema %}
{
  "name": "In The Field",
  "class": "product-in-the-field-section",
  "templates": ["product"],
  "max_blocks": 12,
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#E3EBF4" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#01132F" },
    { "type": "color", "id": "dot_color", "label": "Pagination Bar", "default": "#C2CFDD" },
    { "type": "color", "id": "active_dot_color", "label": "Active Pagination Bar", "default": "#01132F" },
    { "type": "text", "id": "heading", "label": "Section Title", "default": "In the Field" },
    {
      "type": "select", "id": "heading_transform", "label": "Heading Case",
      "options": [
        { "value": "none", "label": "As typed" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize" }
      ], "default": "uppercase"
    },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    {
      "type": "select", "id": "image_ratio", "label": "Image Ratio",
      "options": [
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ], "default": "3 / 4"
    },
    { "type": "range", "id": "columns_desktop", "label": "Columns (Desktop)", "min": 3, "max": 5, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ]
}
{% endschema %}
