{% assign has_video_media = false %}
{% for media in product.media %}
  {% if media.media_type == 'video' or media.media_type == 'external_video' %}
    {% assign has_video_media = true %}
    {% break %}
  {% endif %}
{% endfor %}

{% if has_video_media %}
  <div id='product-video-modal-{{ section.id }}' class='product-video-modal'>
    <div class='product-video-modal__overlay'></div>

    <div class='product-video-modal__inner'>
      <button type='button' class='product-video-modal__close' aria-label='Close video modal'>
        &times;
      </button>

      <div class='product-video-modal__content'>
        <div class='swiper position-relative product-video-main-slider product-video-main-slider-{{ section.id }}'>
            <div class='swiper-wrapper'>
                {% for media in product.media %}
                {% if media.media_type == 'video' %}
                    <div class='swiper-slide' data-media-id='{{ media.id }}'>
                    <div class='video-slide-inner'>
                        {{
                        media
                        | media_tag:
                            image_size: '1200x',
                            autoplay: false,
                            controls: true,
                            loop: false,
                            muted: false,
                            playsinline: true,
                            class: 'product-popup-video'
                        }}
                    </div>
                    </div>
                {% endif %}
                {% endfor %}

                {% for media in product.media %}
                {% if media.media_type == 'external_video' %}
                    <div class='swiper-slide' data-media-id='{{ media.id }}'>
                    <div class='video-slide-inner external-video-wrapper'>
                        {{ media | external_video_tag }}
                    </div>
                    </div>
                {% endif %}
                {% endfor %}
            </div>
            <div class='product-video-nav float-nav'>
                <button class='product-video-button-prev product-video-button-prev-{{ section.id }}'>
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button class='product-video-button-next product-video-button-next-{{ section.id }}'>
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </div>

        <div class='swiper product-video-thumb-slider product-video-thumb-slider-{{ section.id }}'>
          <div class='swiper-wrapper'>
            {% for media in product.media %}
              {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                <div class='swiper-slide'>
                  <div class='video-thumb-item'>
                    {% if media.preview_image != blank %}
                      {% assign thumb_alt = media.alt | escape %}
                      {{
                        media.preview_image
                        | image_url: width: 300
                        | image_tag:
                          alt: thumb_alt,
                          class: 'video-thumb-image',
                          loading: 'lazy',
                          widths: '220,280,340,400',
                          sizes: '(max-width: 768px) 35vw, 220px'
                      }}
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

      </div>
    </div>
  </div>
{% endif %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionId = '{{ section.id }}';
    const modal = document.querySelector('#product-video-modal-' + sectionId);

    if (!modal || typeof Swiper === 'undefined') return;

    const closeBtn = modal.querySelector('.product-video-modal__close');
    const overlay = modal.querySelector('.product-video-modal__overlay');

    const thumbSliderEl = modal.querySelector('.product-video-thumb-slider-' + sectionId);
    const mainSliderEl = modal.querySelector('.product-video-main-slider-' + sectionId);
    const paginationEl = modal.querySelector('.product-video-swiper-pagination-' + sectionId);
    const nextEl = modal.querySelector('.product-video-button-next-' + sectionId);
    const prevEl = modal.querySelector('.product-video-button-prev-' + sectionId);

    if (!thumbSliderEl || !mainSliderEl) return;

    let activeTabWrapper = null;
    let activeVideoBtn = null;

    const thumbSwiper = new Swiper(thumbSliderEl, {
      slidesPerView: 4,
      spaceBetween: 10,
      watchSlidesProgress: true,
      freeMode: false,
      breakpoints: {
        0: {
          slidesPerView: 3,
          spaceBetween: 8
        },
        768: {
          slidesPerView: 4,
          spaceBetween: 10
        }
      }
    });

    const mainSwiper = new Swiper(mainSliderEl, {
      slidesPerView: 1,
      spaceBetween: 0,
      speed: 600,
      autoHeight: true,
      allowTouchMove: true,
      simulateTouch: true,
      grabCursor: true,
      watchOverflow: true,
      observer: true,
      observeParents: true,
      nested: true,
      pagination: {
        el: paginationEl,
        clickable: true
      },
      navigation: {
        nextEl: nextEl,
        prevEl: prevEl
      },
      thumbs: {
        swiper: thumbSwiper
      },
      on: {
        init: function () {
          pauseAllVideos();
        },
        slideChangeTransitionStart: function () {
          pauseAllVideos();
        },
        slideChangeTransitionEnd: function () {
          playActiveVideo();
        }
      }
    });

    function openModal() {
      modal.classList.add('active');
      document.body.classList.add('video-modal-open');

      setTimeout(function () {
        mainSwiper.updateSize();
        mainSwiper.updateSlides();
        mainSwiper.update();
        thumbSwiper.updateSize();
        thumbSwiper.updateSlides();
        thumbSwiper.update();
        playActiveVideo();
      }, 150);
    }

    function closeModal() {
      modal.classList.remove('active');
      document.body.classList.remove('video-modal-open');
      pauseAllVideos();

      if (activeTabWrapper) {
        const imageBtn = activeTabWrapper.querySelector('.media-tab-btn.btn-image');
        const videoBtn = activeTabWrapper.querySelector('.media-tab-btn.btn-video');

        if (videoBtn) {
          videoBtn.classList.remove('active');
        }

        if (imageBtn) {
          imageBtn.classList.add('active');
        }
      }
    }

    function pauseAllVideos() {
      const videos = modal.querySelectorAll('video');
      videos.forEach(function (video) {
        video.pause();
        video.currentTime = 0;
      });

      const iframes = modal.querySelectorAll('iframe');
      iframes.forEach(function (iframe) {
        const src = iframe.getAttribute('src');
        if (src) {
          iframe.setAttribute('src', src);
        }
      });
    }

    function playActiveVideo() {
      pauseAllVideos();

      const activeSlide = modal.querySelector('.product-video-main-slider-' + sectionId + ' .swiper-slide-active');
      if (!activeSlide) return;

      const activeVideo = activeSlide.querySelector('video');
      if (activeVideo) {
        activeVideo.muted = true;
        activeVideo.setAttribute('muted', 'muted');
        activeVideo.setAttribute('playsinline', 'playsinline');

        const playPromise = activeVideo.play();
        if (playPromise !== undefined) {
          playPromise.catch(function (error) {
            console.log('Autoplay blocked:', error);
          });
        }
        return;
      }

      const activeIframe = activeSlide.querySelector('iframe');
      if (activeIframe) {
        let src = activeIframe.getAttribute('src') || '';

        if ((src.includes('youtube.com') || src.includes('youtu.be')) && !src.includes('autoplay=1')) {
          src += (src.includes('?') ? '&' : '?') + 'autoplay=1&mute=1&playsinline=1';
          activeIframe.setAttribute('src', src);
        }

        if (src.includes('vimeo.com') && !src.includes('autoplay=1')) {
          src += (src.includes('?') ? '&' : '?') + 'autoplay=1&muted=1';
          activeIframe.setAttribute('src', src);
        }
      }
    }

    const openBtns = document.querySelectorAll('.product-media-tab .media-tab-btn.btn-video');

    openBtns.forEach(function (openBtn) {
      openBtn.addEventListener('click', function () {
        const tabWrapper = openBtn.closest('.product-media-tab');
        if (!tabWrapper) return;

        activeTabWrapper = tabWrapper;
        activeVideoBtn = openBtn;

        const currentActive = tabWrapper.querySelector('.media-tab-btn.active');
        if (currentActive) {
          currentActive.classList.remove('active');
        }

        openBtn.classList.add('active');
        openModal();
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    if (overlay) {
      overlay.addEventListener('click', closeModal);
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  });
</script>
