{% include 'global-vars' %}

{% assign product_form_id = 'product-form-' | append: product.id %}


{%- liquid
assign current_variant = product.selected_or_first_available_variant
 
assign new_badge_type = settings.new_badge_type | default: 'auto' 
  assign matched_size_chart = blank


  assign new_badge = false
  assign new_badge_limit = 30
  assign date_difference = 'now' | date: '%s' | minus: product.published_at | date: '%s' | divided_by: 86400
  if date_difference <= new_badge_limit
    assign new_badge = true
  else
    for tag in product.tags
      assign tag_handle = tag | handle
      if tag_handle == 'new'
        assign new_badge = true
      endif
    endfor
  endif

  paginate shop.metaobjects.size_chart.values by 250
    for chart in shop.metaobjects.size_chart.values
      assign target_product_ids = chart.target_products.value | map: 'id'

      if target_product_ids != blank and target_product_ids contains product.id
        assign matched_size_chart = chart
        break
      endif
    endfor
  endpaginate

-%}

<section class="product default aos-section-animate">
    <div class="container section-content">
        <div class="breadcrumbs mb-lg-3 mb-md-3 mb-sm-2 col-lg-6 col-md-12 col-sm-12">
            <a href="/" class="pp-regular body f-gray">Home ></a>

            {% if collection %}
                <a href="{{ collection.url }}" class="pp-regular body f-gray">
                {{ collection.title }} >
                </a>
            {% elsif product.collections.size > 0 %}
                {%- assign bc_collection = product.collections.first -%}
                <a href="{{ bc_collection.url }}" class="pp-regular body f-gray">
                {{ bc_collection.title }} >
                </a>
            {% endif %}

            <span class="pp-regular body f-black">{{ product.title }}</span>
        </div>

        <div class="row products-row">
            
            <div class="col-lg-6 col-md-12 col-sm-12">
                <div class="sticky-top">
                    {% render 'product-media', product: product, new_badge: new_badge %}
                </div>
            </div>
            <div class="col-lg-6 col-md-12 col-sm-12 overflow-hidden">
                {%- for block in section.blocks -%}
                    {%- case block.type -%}
                        {%- when 'tags' %}
                            <div class="product-details">
                                <div class="d-flex align-items-center justify-content-between">
                                    {%- liquid
                                        assign product_label = product.metafields.custom.custom_tag.value
                                        if product_label == blank
                                            assign product_label = product.metafields.custom.custom_tag
                                        endif
                                        assign product_label = product_label | strip_html | strip
                                        if product_label == blank
                                            assign product_label = 'FASHION | CONVENIENT'
                                        endif
                                    -%}
                                    <div class="custom-label">
                                        <span class="pp-semibold body">
                                            {{ product_label }}
                                        </span>
                                    </div>

                                    <div class="wishlist-button">
                                        <button aria-label="Add to Wishlist" data-with-epi="true" class="swym-button swym-add-to-wishlist-view-product product_{{product.id}}" 
                                            data-swaction="addToWishlist" 
                                            data-product-id="{{product.id | json}}" 
                                            data-variant-id="{{product.variants[0].id}}" 
                                            data-product-url="{{ shop.url }}{{ product.url }}">
                                        </button>
                                    </div>
                                </div>
                            </div>
                        {%- when 'title' %}
                            <div class="product-details">
                                <h1 class="product-title ">
                                    <span class="d-lg-block d-md-block d-sm-none title-sm">
                                        {{ product.title }}
                                    </span>
                                    <span class="d-lg-none d-md-none d-sm-block pretitle-xl">
                                        {{ product.title }}
                                    </span>
                                </h1>
                            </div>
                        {%- when 'review' %}
                            {% if product.metafields.proviews.totalReviewCount != 0 %}
                                <div class="product-details">
                                    <p tabindex="0" 
                                        class="prorw_preview_badge_setup" 
                                        id="prorw_preview_badge_id_{{ product.id }}" 
                                        data-product-id="{{ product.id }}" 
                                        data-average-ratings="{% if product.metafields.proviews.averageRatings != blank %}{{product.metafields.proviews.averageRatings}}{% else %}0{% endif %}" 
                                        data-count="{% if product.metafields.proviews.totalReviewCount != blank %}{{product.metafields.proviews.totalReviewCount}}{% else %}0{% endif %}"> 
                                    </p>
                                </div>
                            {% endif %}
                        {%- when 'price' %}
                            <div class="product-details">
                                <div class="product-price">
                                    <div class="price">
                                        <span class="price-regular price-item--regular">
                                            {{ product.selected_or_first_available_variant.price | money | prepend: curSym }}
                                        </span>
                                        {% if product.selected_or_first_available_variant.price != product.selected_or_first_available_variant.compare_at_price %}
                                            <span class="product-compare-price price-item--sale">
                                                {{ product.selected_or_first_available_variant.compare_at_price | money | prepend: curSym }}
                                            </span>
                                        {% endif %}
                                        
                                        
                                    </div>
                                
                                    {%- assign saved_amount = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price -%}

                                    {% if product.selected_or_first_available_variant.compare_at_price != blank %}
                                        {% if saved_amount != 0 %}
                                            <span data-save-price class="product__price-savings">
                                                Save {{ saved_amount | money }}
                                            </span>
                                        {% endif %}
                                    {% endif %}

                                
                                    {%- liquid
                                        assign promotion_mf = product.metafields.promo.cart_discount_text
                                    -%}
                                    {% if promotion_mf != blank %}
                                        <div class="promotion rte">
                                            {% if promotion_mf.type contains 'rich_text' %}
                                                {{ promotion_mf | metafield_tag }}
                                            {% else %}
                                                {{ promotion_mf.value | default: promotion_mf }}
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {%- when 'payment_installment' %}
                            <div class="product-details">
                                <div class="shop-pay-container pb-2">
                                    {% assign quarter_price = product.selected_or_first_available_variant.price | times: 0.25 %}
                                    <p class="pp-semibold f-black body-xl d-lg-block d-md-block d-sm-none">
                                        Pay in 4 interest-free installments of <span class="pp-bold">{{ quarter_price | money | prepend: curSym }}</span> with 
                                        <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/45661_2x_7a6071bd-7096-4132-b066-66e804ca4273.png?v=1761060214" class="shop-pay-icon" alt="shop-pay-icon">
                                        <a href="" class="pp-semibold body-xs text-underline">Learn More</a>
                                    </p>
                                    <p class="pp-semibold f-black body-sm d-lg-none d-md-none d-sm-block">
                                        Pay in 4 interest-free installments of <span class="pp-bold">{{ quarter_price | money | prepend: curSym }}</span> with 
                                        <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/45661_2x_7a6071bd-7096-4132-b066-66e804ca4273.png?v=1761060214" class="shop-pay-icon" alt="shop-pay-icon">
                                        <a href="" class="pp-semibold body-sm text-underline">Learn More</a>
                                    </p>
                                </div>
                            </div>
                        {%- when 'discount_banner' %}
                            <div class="product-details">
                                    {% assign banner_discount_amount = block.settings.discount_amount %}
                                    {% assign banner_description = block.settings.description %}
                                    {% assign banner_description_2 = block.settings.description_2 %}
                                    {% assign banner_link = block.settings.link %}

                                    {% assign custom_banner_headings = product.metafields.custom.discount_banner_headings.value | default: custom.discount_banner_headings %}
                                    {% comment %}
                                    discount_banner_link (URL): store e.g. https://venustas.com/#smile-home — href uses only the hash (#smile-home) so it jumps on the current page.
                                    {% endcomment %}
                                    {% assign custom_banner_link = product.metafields.custom.discount_banner_link.value | default: custom.discount_banner_link | strip %}

                                    {% if custom_banner_headings != blank %}
                                    {% assign normalized_banner_headings = custom_banner_headings | strip | newline_to_br | split: '<br />' %}

                                    {% if normalized_banner_headings.size > 0 %}
                                        {% assign line_1 = normalized_banner_headings[0] | strip %}
                                        {% if line_1 != blank %}
                                        {% assign banner_discount_amount = line_1 %}
                                        {% endif %}
                                    {% endif %}

                                    {% if normalized_banner_headings.size > 1 %}
                                        {% assign line_2 = normalized_banner_headings[1] | strip %}
                                        {% if line_2 != blank %}
                                        {% assign banner_description = line_2 %}
                                        {% endif %}
                                    {% endif %}

                                    {% if normalized_banner_headings.size > 2 %}
                                        {% assign line_3 = normalized_banner_headings[2] | strip %}
                                        {% if line_3 != blank %}
                                        {% assign banner_description_2 = line_3 %}
                                        {% endif %}
                                    {% endif %}
                                    {% endif %}

                                    {% if custom_banner_link != blank %}
                                    {% assign banner_link = custom_banner_link %}
                                    {% endif %}
                                    {% assign banner_link = banner_link | strip %}
                                    {% if banner_link contains '#' %}
                                    {% assign _hash_suffix = banner_link | split: '#' | last %}
                                    {% assign banner_link = '#' | append: _hash_suffix %}
                                    {% endif %}

                                    <div class="product-block discount-banner">
                                    <img
                                        src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/42442_2x_b705720d-eac0-481b-81bf-63ec15e3639d.png?v=1758607571"
                                        class="d-lg-block d-md-block d-sm-none"
                                        alt="discount-banner-bg-desktop"
                                        style="width:100%; height:auto; display:block; max-width:100%;"
                                    >

                                    <img
                                        src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/42442_2x_1.png?v=1762359219"
                                        class="d-lg-none d-md-none d-sm-block"
                                        alt="discount-banner-bg-mobile"
                                        style="width:100%; height:auto; display:block; max-width:100%;"
                                    >

                                    <div class="discount-banner-content">
                                        <div class="f-column ps-lg-2 ps-md-2 ps-sm-2">
                                        <div class="discount-percentage f-white d-lg-flex d-md-flex d-sm-flex gap-1">
                                            {{ banner_discount_amount }}
                                            {% if block.settings.show_percent_off %}
                                            <div class="d-flex flex-column justify-content-center">
                                                <span class="body pp-bold">%</span>
                                                <span class="body-xl off">OFF</span>
                                            </div>
                                            {% endif %}
                                        </div>
                                        </div>

                                        <div class="s-column ps-lg-4 ps-md-4 ps-sm-3">
                                        <div class="body pp-semibold d-lg-block d-md-block d-sm-none f-black">
                                            {{ banner_description }}
                                        </div>

                                        <div class="body-sm pp-semibold d-lg-none d-md-none d-sm-block f-black">
                                            {{ banner_description }}
                                        </div>

                                        <a class="body pp-regular text-underline f-gray l-h-normal d-lg-block d-md-block d-sm-none" href="{{ banner_link }}">
                                            {{ banner_description_2 }}
                                        </a>

                                        <a class="body-xs pp-regular text-underline f-gray l-h-normal d-lg-none d-md-none d-sm-block" href="{{ banner_link }}">
                                            {{ banner_description_2 }}
                                        </a>
                                        </div>
                                    </div>
                                    </div>
                            </div>
                        {%- when 'variant_option' %}
                            {% unless product.has_only_default_variant %}
                                <div class="product-details">
                                    {% render 'product-variant', product: product %}
                                </div>
                            {% endunless %}
                        {%- when 'hightlights' %}
                            <div class="product-details"> 
                                <div class="highlights-accordion">
                                    <div class="accrodion-heading">
                                        <span class="body-lg pp-bold d-lg-block d-md-block d-sm-none">{{ block.settings.heading }}</span>
                                        <span class="body pp-bold f-main d-lg-none d-md-none d-sm-block">{{ block.settings.heading }}</span>
                                        <i class="fa-solid fa-chevron-up f-black"></i>
                                    </div>
                                    <div class="accordion-content">
                                        {{ block.settings.description  }}
                                    </div>
                                </div>
                            </div>
                            <script>
                                document.addEventListener('DOMContentLoaded', function () {
                                document.querySelectorAll('.accordion-content .metafield-multi_line_text_field').forEach(function (el) {
                                    var rawHtml = el.innerHTML
                                    .replace(/<br\s*\/?>/gi, '\n');

                                    var textarea = document.createElement('textarea');
                                    textarea.innerHTML = rawHtml;

                                    var decodedHtml = textarea.value.trim();

                                    if (decodedHtml) {
                                    el.parentElement.innerHTML = decodedHtml;
                                    }
                                });
                                });
                            </script>
                        {%- when 'availability' %}
                            <div class="product-details"> 
                                <div class="availability-section">
                                    <div class="heading-content">
                                        <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M1.791 2.253l-.597 3.583A1 1 0 002.18 7h.893a1.5 1.5 0 001.342-.83L5 5l.585 1.17A1.5 1.5 0 006.927 7h1.146a1.5 1.5 0 001.342-.83L10 5l.585 1.17a1.5 1.5 0 001.342.83h1.146a1.5 1.5 0 001.342-.83L15 5l.585 1.17a1.5 1.5 0 001.342.83h.893a1 1 0 00.986-1.164l-.597-3.583A1.5 1.5 0 0016.729 1H3.271a1.5 1.5 0 00-1.48 1.253z" fill="#5C5F62"></path>
                                            <path d="M18 9H2v8.5A1.5 1.5 0 003.5 19H7v-7h6v7h3.5a1.5 1.5 0 001.5-1.5V9z" fill="#5C5F62"></path>
                                        </svg>
                                        <span class="body-lg pp-bold d-lg-block d-md-block d-sm-none">Availability</span>
                                        <span class="body pp-bold d-lg-none d-md-none d-sm-block">Availability</span>
                                    </div>
                                </div>

                                <div class="size-chart-injector form__label">
                                    <script>
                                        document.addEventListener("DOMContentLoaded", function () {
                                            var inventoryInfo = document.querySelector("#inventory-info-app");
                                            var availabilitySection = document.querySelector(".availability-section");

                                            if (inventoryInfo && availabilitySection) {
                                                availabilitySection.appendChild(inventoryInfo);
                                                inventoryInfo.style.display = "block";
                                                console.log("✅ inventory-info-app moved inside availability-section");
                                            } else {
                                                console.warn("⚠️ Either #inventory-info-app or .availability-section not found.");
                                            }
                                        });
                                    </script>
                                </div>

                            </div>
                        {%- when 'quantity_atc' %}
                            <div class="product-details main-product-form">
                                <div class="d-flex gap-lg-3 gap-md-3 gap-sm-2">
                                    
                                    <div class="quantity-container flex-1">
                                        <!-- Screen reader label for quantity input -->
                                        <label for="Quantity-{{ product.id }}" class="sr-only">Quantity</label>

                                        <quantity-input class="quantity">
                                            <!-- Minus button with accessible label -->
                                            <button type="button" 
                                                    name="minus" 
                                                    class="less_qty" 
                                                    aria-label="Decrease quantity">
                                                -
                                            </button>

                                            <!-- Quantity input -->
                                            <input class="qty quantity__input"
                                                type="number"
                                                name="quantity"
                                                id="Quantity-{{ product.id }}"
                                                min="1"
                                                value="1"
                                                readonly
                                                form="{{ product_form_id }}"
                                                aria-live="polite"
                                                aria-label="Quantity"
                                            >

                                            <!-- Plus button with accessible label -->
                                            <button type="button" 
                                                    name="plus" 
                                                    class="add_qty" 
                                                    aria-label="Increase quantity">
                                                +
                                            </button>
                                        </quantity-input>
                                    </div>


                                    <div class="product-form">
                                        <product-form class="h-100 d-block">
                                            {% form 'product', product, id: product_form_id, class: 'product-atc-form form h-100 d-block', novalidate: 'novalidate', data-type: 'add-to-cart-form', action: 'javascript:void(0)', data-gpo-product-form: 'true' %}
                                                
                                                {% assign free_ac = 0 %}
                                                {% for accessory in product.metafields.custom.free_accessories.value %}
                                                    {% if accessory.available %}
                                                        <input type="hidden" name="id[]" value="{{ accessory.selected_or_first_available_variant.id }}">
                                                        {%  assign free_ac = free_ac | plus: 1 %}
                                                    {% endif %}
                                                {% endfor %}
                
                                                {% if free_ac > 0 or compo_ac > 0  %}
                                                    <input type="hidden" name="id[]" id="main-product-id" class="main-product-main-id" value="{{ product.selected_or_first_available_variant.id }}">
                                                {% else %}
                                                    <input type="hidden" name="id" id="main-product-id"  class="main-product-main-id" value="{{ product.selected_or_first_available_variant.id }}">
                                                {% endif %}
                                                
                                                <div class="form-btn d-block h-100">
                                                    <button type='submit' name="add" class="btn btn-atc productAtc" {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
                                                        <span>
                                                            {% if product.selected_or_first_available_variant.available %}
                                                                Add To Cart
                                                            {% else %}
                                                                Out Of Stock
                                                            {% endif %}
                                                        </span>
                                                        <div class="atc-overlay">
                                                            <div class="atc-spinner"></div>
                                                        </div>
                                                    </button>
                                                </div>
                                            {% endform %}
                                        </product-form>
                                    </div>

                                </div>
                                <div class="main-product-error mt-2" style="display:none;">
                                    <p class="pp-regular f-main body" >
                                    </p>
                                </div>
                            </div>
                        {%- when 'support_product' %}
                            <div class="product-details">
                                <div class="support-product-container">

                                    {% assign heading_1 = product.metafields.custom.support_icon_list_heading_1 %}
                                    {% assign heading_2 = product.metafields.custom.support_icon_list_heading_2 %}
                                    {% assign heading_3 = product.metafields.custom.support_icon_list_heading_3 %}
                                    {% assign heading_4 = product.metafields.custom.support_icon_list_heading_4 %}

                                    {% assign image_1 = product.metafields.custom.support_icon_list_image_1 | default: block.settings.icon_1 %}
                                    {% assign image_2 = product.metafields.custom.support_icon_list_image_2 | default: block.settings.icon_2 %}
                                    {% assign image_3 = product.metafields.custom.support_icon_list_image_3 | default: block.settings.icon_3 %}
                                    {% assign image_4 = product.metafields.custom.support_icon_list_image_4 | default: block.settings.icon_4 %}

                                    <div class="row d-lg-flex d-md-flex d-sm-none">
                                        {% if heading_1 != blank or block.settings.heading_1 != blank %}
                                            <div class="col">
                                                <div class="support-product-item">
                                                    {% if image_1 != blank %}
                                                        <img src="{{ image_1 | image_url: width: 500 }}" width="100%" height="100%" class="icon-support" alt="icon-support">
                                                    {% endif %}
                                                    <div class="body-sm pp-semibold text-center l-h-normal">
                                                        {% if heading_1 != blank %}
                                                            {{ heading_1 | metafield_tag }}
                                                        {% else %}
                                                            {{ block.settings.heading_1 }}
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}

                                        {% if heading_2 != blank or block.settings.heading_2 != blank %}
                                            <div class="col">
                                                <div class="support-product-item">
                                                    {% if image_2 != blank %}
                                                        <img src="{{ image_2 | image_url: width: 500 }}" width="100%" height="100%" class="icon-support" alt="icon-support">
                                                    {% endif %}
                                                    <div class="body-sm pp-semibold text-center l-h-normal">
                                                        {% if heading_2 != blank %}
                                                            {{ heading_2 | metafield_tag }}
                                                        {% else %}
                                                            {{ block.settings.heading_2 }}
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}

                                        {% if heading_3 != blank or block.settings.heading_3 != blank %}
                                            <div class="col">
                                                <div class="support-product-item">
                                                    {% if image_3 != blank %}
                                                        <img src="{{ image_3 | image_url: width: 500 }}" width="100%" height="100%" class="icon-support" alt="icon-support">
                                                    {% endif %}
                                                    <div class="body-sm pp-semibold text-center l-h-normal">
                                                        {% if heading_3 != blank %}
                                                            {{ heading_3 | metafield_tag }}
                                                        {% else %}
                                                            {{ block.settings.heading_3 }}
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}

                                        {% if heading_4 != blank or block.settings.heading_4 != blank %}
                                            <div class="col">
                                                <div class="support-product-item">
                                                    {% if image_4 != blank %}
                                                        <img src="{{ image_4 | image_url: width: 500 }}" width="100%" height="100%" class="icon-support" alt="icon-support">
                                                    {% endif %}
                                                    <div class="body-sm pp-semibold text-center l-h-normal">
                                                        {% if heading_4 != blank %}
                                                            {{ heading_4 | metafield_tag }}
                                                        {% else %}
                                                            {{ block.settings.heading_4 }}
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>

                                    <div class="row d-lg-none d-md-none d-sm-flex" style="--bs-gutter-x: 2.5rem; --bs-gutter-y: 1.5rem;">
                                        {% if heading_1 != blank or block.settings.heading_1 != blank %}
                                            <div class="col-6">
                                                <div class="support-product-item">
                                                    {% if image_1 != blank %}
                                                        <img src="{{ image_1 | image_url: width: 500 }}" width="100%" height="100%" class="icon-support" alt="icon-support">
                                                    {% endif %}
                                                    <div class="body-sm pp-semibold text-center l-h-normal">
                                                        {% if heading_1 != blank %}
                                                            {{ heading_1 | metafield_tag }}
                                                        {% else %}
                                                            {{ block.settings.heading_1 }}
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}

                                        {% if heading_2 != blank or block.settings.heading_2 != blank %}
                                            <div class="col-6">
                                                <div class="support-product-item">
                                                    {% if image_2 != blank %}
                                                        <img src="{{ image_2 | image_url: width: 500 }}" width="100%" height="100%" class="icon-support" alt="icon-support">
                                                    {% endif %}
                                                    <div class="body-sm pp-semibold text-center l-h-normal">
                                                        {% if heading_2 != blank %}
                                                            {{ heading_2 | metafield_tag }}
                                                        {% else %}
                                                            {{ block.settings.heading_2 }}
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}

                                        {% if heading_3 != blank or block.settings.heading_3 != blank %}
                                            <div class="col-6">
                                                <div class="support-product-item">
                                                    {% if image_3 != blank %}
                                                        <img src="{{ image_3 | image_url: width: 500 }}" width="100%" height="100%" class="icon-support" alt="icon-support">
                                                    {% endif %}
                                                    <div class="body-sm pp-semibold text-center l-h-normal">
                                                        {% if heading_3 != blank %}
                                                            {{ heading_3 | metafield_tag }}
                                                        {% else %}
                                                            {{ block.settings.heading_3 }}
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}

                                        {% if heading_4 != blank or block.settings.heading_4 != blank %}
                                            <div class="col-6">
                                                <div class="support-product-item">
                                                    {% if image_4 != blank %}
                                                        <img src="{{ image_4 | image_url: width: 500 }}" width="100%" height="100%" class="icon-support" alt="icon-support">
                                                    {% endif %}
                                                    <div class="body-sm pp-semibold text-center l-h-normal">
                                                        {% if heading_4 != blank %}
                                                            {{ heading_4 | metafield_tag }}
                                                        {% else %}
                                                            {{ block.settings.heading_4 }}
