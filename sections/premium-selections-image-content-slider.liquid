{% schema %}
    {
        "class": "premium-selections-image-content-slider-section overflow-lg-unset overflow-md-unset overflow-sm-hidden",
        "name": "Premium Content Slider",
        "templates": ["page"],
        "settings": [
            {
                "type": "select",
                "id": "layout",
                "label": "Layout",
                "options": [
                    {
                        "label": "Left Content",
                        "value": "left-content"
                    },
                    {
                        "label": "Right Content",
                        "value": "right-content"
                    }
                    
                ],
                "default": "left-content"
            },
            {
                "type": "header",
                "content": "Content"
            },
            {
                "type": "text", 
                "id": "heading",
                "label": "Heading",
                "default": "Graphene Textile"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description",
                "default": "<p>Graphene Textile Lining, Renowned For Its High Electrical And Conductivity Resistance, Is Revolutionizing The Textile Industry With The Production Of Next-generation Clothing.</p>"
            },
            {
                "type": "header",
                "content": "List Icons"
            }, 
            {
                "type": "image_picker",
                "id": "icon_1",
                "label": "Icon - 1"
            }, 
            {
                "type": "text",
                "id": "icon_label_1",
                "label": "Icon Label - 1"
            },
            {
                "type": "image_picker",
                "id": "icon_2",
                "label": "Icon - 2"
            }, 
            {
                "type": "text",
                "id": "icon_label_2",
                "label": "Icon Label - 2"
            },
            {
                "type": "image_picker",
                "id": "icon_3",
                "label": "Icon - 3"
            }, 
            {
                "type": "text",
                "id": "icon_label_3",
                "label": "Icon Label - 3"
            },
            {
                "type": "image_picker",
                "id": "icon_4",
                "label": "Icon - 4"
            }, 
            {
                "type": "text",
                "id": "icon_label_4",
                "label": "Icon Label - 4"
            },
            {
                "type": "text",
                "id": "btn_label",
                "label": "Button Label",
                "default": "Shop Now"
            },
            {
                "type": "url",
                "id": "btn_link",
                "label": "Button Link",
            },

        ],
        "blocks": [
            {
                "type": "image",
                "name": "Image",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    }
                ]
            }
        ],
        "presets" :[{
            "name" : "Premium Content Slider"
        }]
    }
  {% endschema %} 