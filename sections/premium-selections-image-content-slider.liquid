{% style %}
    .premium-selections-image-content-slider-section {

    }
    .premium-selections-image-content-slider-section .main-row{
        --bs-gutter-x: 80px;
        --bs-gutter-y: 30px;
    }
    .premium-selections-image-content-slider-section .icon-list-container{
        display:flex;
        gap:10px;
    }
    .premium-selections-image-content-slider-section .icon-list-container .icon-list-item{
        flex:auto;
        background: #F9F9F9;
        border-radius:4px;
        display:flex;
        flex-direction:column;
        align-items:center;
        justify-content:center;
        gap:8px;
        text-align:center;
        padding:1rem 0.8rem;
        max-width: 200px;
    }
    .premium-selections-image-content-slider-section .icon-list-container .icon-list-item img{
        width:25px;
        height:25px;
        object-fit:contain;
    }
    .premium-selections-image-content-slider-section .icon-list-container .icon-list-item p{
        color: #515151;
    }
    .premium-selections-image-content-slider-section .section-btn img{
        width: 20px;
        height: 20px;
        object-fit: contain;
        position: relative;
        z-index: 1;
    }
    .premium-selections-image-content-slider-section .w-fit-content{
        width:fit-content;
    }
    .premium-selections-image-content-slider-section .gradient-text{
        color: transparent;
        background-image: linear-gradient(108deg, #B93205, #ef7e00 29%, #d94e0f 62%, #B93205);
        background-size: 200% 200%;
        background-clip: text;
        -webkit-background-clip: text;
    }
    
    .premium-selections-image-content-slider-section .premium-selections-image-slider{
    }
    
    .premium-selections-image-content-slider-section .premium-selections-image-slider .premium-image-item{
        overflow:hidden;
        border-radius:12px;
        height:700px;
    }
    .premium-selections-image-content-slider-section .premium-selections-image-slider .premium-image-item img{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .premium-selections-image-content-slider-section .swiper-pagination{
        position: unset;
        transform: unset;
        width:fit-content;
        margin-top: 0;
    }
    .premium-selections-image-content-slider-section .float-nav{
        position: unset;
        transform: unset;
        width:fit-content;
    }
    .premium-selections-image-content-slider-section .float-nav button{
        position: unset;
        transform: unset;
        width:45px;
        height:45px;
        background-color:#f1eadd;
    }
    .premium-selections-image-content-slider-section .float-nav button:first-child{
        margin-right:10px;
    }
    .premium-selections-image-content-slider-section .float-nav button i{
        color:#B93205;
    }
    .premium-selections-image-content-slider-section .float-nav button:hover{
        background:#B93205;
    }
    .premium-selections-image-content-slider-section .float-nav button:hover i{
        color:#FFF;
    }
    .premium-selections-image-content-slider-section .swiper-pagination .swiper-pagination-bullet{
        transition: all 0.3s ease;
        scale: 1;
        margin:0 6px;
    }
    .premium-selections-image-content-slider-section .swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active{
        scale: 1.4;
    }
    

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .premium-selections-image-content-slider-section .premium-selections-image-slider{
            padding:0px 20px;
        }
        .premium-selections-image-content-slider-section .premium-selections-image-slider .premium-image-item{
            border-radius:8px;
        }
        .premium-selections-image-content-slider-section .float-nav button{
            width:35px;
            height:35px;
        }
        .premium-selections-image-content-slider-section .icon-list-container{
            flex-direction:column;
            gap:8px;
        }
        .premium-selections-image-content-slider-section .icon-list-container .icon-list-item{
            flex-direction:row;
            justify-content: flex-start;
            border-radius:12px;
            padding:1.5rem 2.5rem;
            width:100%;
            max-width:100%;
        }
        .premium-selections-image-content-slider-section .float-nav{
            position: absolute;
            transform: translate(-50%, -50%);
            width:100%;
        }
        .premium-selections-image-content-slider-section .float-nav button{
            position: absolute;
            transform: translateY(-50%);
            --btn-pos: 0;
        }
        .premium-selections-image-content-slider-section .float-nav button:first-child{
            margin-right:0;
        }    
        .premium-selections-image-content-slider-section .swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active{
            scale: 1;
        }
    }

