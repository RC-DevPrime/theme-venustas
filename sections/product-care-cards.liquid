{%- comment -%}
  Product Care Cards
  Light section: heading + 4 white cards (icon on top, title, description),
  plus a disclaimer line with a warning icon. Mobile can be a swipe row.
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .container { padding-left: 40px; padding-right: 40px; }
  #shopify-section-{{ section.id }} .cc { padding: 64px 0; }
  #shopify-section-{{ section.id }} .cc__heading {
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    text-align: center;
    text-transform: uppercase;
    margin: 0 0 {% if section.settings.subheading == blank %}40px{% else %}8px{% endif %};
  }
  #shopify-section-{{ section.id }} .cc__subheading {
    text-align: center;
    color: {{ section.settings.subheading_color }};
    font-size: 15px;
    max-width: 760px;
    margin: 0 auto 44px;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .cc__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  #shopify-section-{{ section.id }} .cc__card {
    background: {{ section.settings.card_bg }};
    border-radius: 18px;
    padding: 36px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 6px 20px rgba(11,30,60,0.05);
  }
  #shopify-section-{{ section.id }} .cc__icon {
    width: 60px;
    height: 60px;
    object-fit: contain;
    margin-bottom: 22px;
  }
  #shopify-section-{{ section.id }} .cc__title {
    font-size: 19px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    text-transform: uppercase;
    line-height: 1.2;
    margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .cc__desc {
    font-size: 14px;
    color: {{ section.settings.desc_color }};
    line-height: 1.6;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .cc__disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 32px;
    color: {{ section.settings.desc_color }};
    font-size: 13.5px;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .cc__disclaimer svg {
    flex: none;
    width: 34px;
    height: 34px;
    color: {{ section.settings.accent_color }};
    margin-top: 2px;
  }
  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .cc__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .container { padding-left: 20px; padding-right: 20px; }
    #shopify-section-{{ section.id }} .cc { padding: 44px 0; }
    {% if section.settings.mobile_scroll %}
      #shopify-section-{{ section.id }} .cc__grid {
        display: flex;
        grid-template-columns: none;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
        gap: 12px;
        padding-bottom: 6px;
      }
      #shopify-section-{{ section.id }} .cc__grid::-webkit-scrollbar { display: none; }
      #shopify-section-{{ section.id }} .cc__card { flex: 0 0 72%; scroll-snap-align: start; }
    {% else %}
      #shopify-section-{{ section.id }} .cc__grid { grid-template-columns: 1fr; }
    {% endif %}
  }
{% endstyle %}

<div class="cc">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="cc__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="cc__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="cc__grid">
      {% for block in section.blocks %}
        <div class="cc__card" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <img class="cc__icon" src="{{ block.settings.icon | image_url: width: 160 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'cc__icon placeholder-svg' }}
          {% endif %}
          {% if block.settings.title != blank %}<h3 class="cc__title">{{ block.settings.title }}</h3>{% endif %}
          {% if block.settings.description != blank %}<p class="cc__desc">{{ block.settings.description }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.disclaimer != blank %}
      <div class="cc__disclaimer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span>{{ section.settings.disclaimer }}</span>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Care Cards",
  "class": "product-care-cards-section",
  "templates": ["product"],
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#D9E6F4" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#01132F" },
    { "type": "color", "id": "subheading_color", "label": "Subheading Color", "default": "#46566a" },
    { "type": "color", "id": "title_color", "label": "Card Title Color", "default": "#01132F" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#5a6470" },
    { "type": "color", "id": "accent_color", "label": "Accent (warning icon)", "default": "#1C80FE" },
    { "type": "text", "id": "heading", "label": "Section Title", "default": "Care" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Mobile: horizontal swipe", "default": true },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer (with warning icon)" }
  ],
  "blocks": [
    {
      "type": "care_card",
      "name": "Care Card",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "Blue line icon works best" },
        { "type": "text", "id": "title", "label": "Title", "default": "Easy to Maintain" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Care Cards",
      "blocks": [ { "type": "care_card" }, { "type": "care_card" }, { "type": "care_card" }, { "type": "care_card" } ]
    }
  ]
}
{% endschema %}
