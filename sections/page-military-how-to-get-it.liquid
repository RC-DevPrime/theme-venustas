{% style %}
    .military-how-to-get-it-section{

    }
    .military-how-to-get-it-section .discount-list-container .discount-item{
        border-radius: 16px 16px 16px 16px;
        border: 1px solid #E3E3E3;
        padding:60px 25px;
    }
    .military-how-to-get-it-section .discount-list-container .row{
        --bs-gutter-y: 10px;
    }
    .military-how-to-get-it-section .discount-list-container .discount-item .icon-img{
        width:90px;
        height:70px;
        object-fit:contain;
    }
    .military-how-to-get-it-section .discount-list-container .discount-item .block-heading strong{
        font-weight:600;
        color: #B93205; 
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .military-how-to-get-it-section .discount-list-container .discount-item .icon-img{
            width:50px;
            height:fit-content;
        }
        .military-how-to-get-it-section .discount-list-container .discount-item{
            padding:30px 20px;
            border-radius: 10px 10px 10px 10px;
        }
    }

{% endstyle %}
<div class="container section-content">
    <h2 class="pp-bold title-md text-center f-main pb-lg-5 pb-md-5 pb-sm-4 d-lg-block d-md-block d-sm-none" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="100" data-aos-duration="500">
        {{ section.settings.heading }}
    </h2>
    <h2 class="pp-bold title text-center f-black pb-lg-5 pb-md-5 pb-sm-4 d-lg-none d-md-none d-sm-block" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="100" data-aos-duration="500">
        {{ section.settings.heading }}
    </h2>
    <div class="discount-list-container">
        <div class="row">
            {% for block in section.blocks %}
                <div class="col-lg-3 col-md-6 col-sm-12" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="{{ forloop.index }}00" data-aos-duration="500">
                    <div class="discount-item d-flex flex-lg-column flex-md-column flex-sm-row align-items-center gap-lg-3 gap-md-3 gap-sm-4">
                        <img src="{{ block.settings.icon | img_url: 'master' }}" width="100px" height="80px;" class="icon-img">
                        <div class="block-heading pp-regular body-xl f-black text-lg-center text-md-center text-sm-start d-lg-block d-md-block d-sm-none">
                            {{ block.settings.heading }}
                        </div>
                        <div class="block-heading pp-regular body f-black text-lg-center text-md-center text-sm-start d-lg-none d-md-none d-sm-block">
                            {{ block.settings.heading }}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    <p class="pp-regular f-main body-xl pt-lg-4 pt-md-4 pt-sm-3 d-lg-block d-md-block d-sm-none">
        {{ section.settings.note }}
    </p>
    <p class="pp-regular f-main body pt-lg-4 pt-md-4 pt-sm-3 d-lg-none d-md-none d-sm-block">
        {{ section.settings.note }}
    </p> 
</div>
{% schema %}
    {
        "class": "military-how-to-get-it-section",
        "name": "Military How To Get It",
        "templates": ["page"],
        "limit": 1, 
        "settings": [
            {
                "type": "text", 
                "id": "heading",
                "label": "Heading",
                "default": "How To Get it? "
            },
            {
                "type": "textarea",
                "id": "note",
                "label": "Note",
                "default": "Note: All discounts can not be combined. The open-box items, final sale and accessories are excluded."
            }
        ],
        "blocks": [
            {
                "type": "discount_item",
                "name": "Discount Item",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "icon",
                        "label": "Icon"
                    },
                    {
                        "type": "richtext",
                        "id": "heading",
                        "label": "Heading"
                    }
                ]
            }
        ],
        "presets" :[{
            "name" : "Military How To Get It"
        }]
    }
{% endschema %} 