{%- liquid
  assign gift_collection = section.settings.collection
  assign products_limit = section.settings.products_limit | plus: 0
  if products_limit <= 0
    assign products_limit = 50
  endif
  assign section_anchor = section.settings.anchor_id | strip
-%}

{%- if gift_collection != blank and gift_collection.products_count > 0 -%}
  {% style %}
    #shopify-section-{{ section.id }} .giftG-new {
      padding: 80px 0;
      background: #f9f2e8;
      color: #0b4c20;
      font-family: var(--font-primary, 'Montserrat', sans-serif);
    }

    #shopify-section-{{ section.id }} .giftG-new__inner {
      width: min(calc(100% - 40px), 1340px);
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .giftG-new__header {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 26px;
    }

    #shopify-section-{{ section.id }} .giftG-new__mark {
      flex: 0 0 auto;
      width: 30px;
      height: 38px;
    }

    #shopify-section-{{ section.id }} .giftG-new__mark img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .giftG-new__heading {
      margin: 0;
      color: #0b4c20;
      font-size: 34px;
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .giftG-new__carousel {
      position: relative;
      margin-top: 38px;
      padding: 0 112px;
    }

    #shopify-section-{{ section.id }} .giftG-new__track {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .giftG-new__track::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .giftG-new__card {
      display: flex;
      flex: 0 0 calc((100% - 48px) / 4);
      flex-direction: column;
      box-sizing: border-box;
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 3px 6px rgba(119, 107, 86, 0.14);
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .giftG-new__media {
      display: block;
      overflow: hidden;
      aspect-ratio: 618 / 800;
    }

    #shopify-section-{{ section.id }} .giftG-new__media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .giftG-new__info {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 12px;
    }

    #shopify-section-{{ section.id }} .giftG-new__title {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
      min-height: 2.5em;
      color: #0b4c20;
      font-size: 18px;
      font-weight: 600;
      line-height: 1.25;
      overflow-wrap: anywhere;
      text-decoration: none;
      text-overflow: ellipsis;
    }

    #shopify-section-{{ section.id }} .giftG-new__title:hover {
      text-decoration: underline;
    }

    #shopify-section-{{ section.id }} .giftG-new__rating {
      margin-top: 4px;
      min-height: 22px;
      padding: 0 12px;
    }

    #shopify-section-{{ section.id }} .giftG-new__price {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .giftG-new__price-now {
      color: #0b4c20;
      font-size: 28px;
      font-weight: 700;
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .giftG-new__price-was {
      color: #777;
      font-size: 16px;
      font-weight: 400;
      line-height: 24px;
      text-decoration: line-through;
    }

    #shopify-section-{{ section.id }} .giftG-new__controls {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 40px;
      margin-top: 15px;
    }

    #shopify-section-{{ section.id }} .giftG-new__dots {
      position: absolute;
      top: 50%;
      left: 50%;
      display: flex;
      align-items: center;
      gap: 8px;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
      transform: translate(-50%, -50%);
    }

    #shopify-section-{{ section.id }} .giftG-new__dots::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .giftG-new__dot {
      flex: 0 0 auto;
      width: 8px;
      height: 8px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: #e5e7eb;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    #shopify-section-{{ section.id }} .giftG-new__dot--active {
      background: #b93205;
    }

    #shopify-section-{{ section.id }} .giftG-new__arrows {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 55px;
      left: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .giftG-new__arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: #b93205;
      color: #fff;
      cursor: pointer;
      pointer-events: auto;
      transition: background-color 0.2s ease, opacity 0.2s ease;
    }

    #shopify-section-{{ section.id }} .giftG-new__arrow:hover:not(:disabled) {
      background: #981d1a;
    }

    #shopify-section-{{ section.id }} .giftG-new__arrow:disabled {
      opacity: 0.35;
      cursor: default;
    }

    #shopify-section-{{ section.id }} .giftG-new__arrow svg {
      width: 16px;
      height: 16px;
    }

    #shopify-section-{{ section.id }} .giftG-new__arrow--prev svg {
      transform: rotate(180deg);
    }

    @media only screen and (min-width: 768px) and (max-width: 1199px) {
      #shopify-section-{{ section.id }} .giftG-new__carousel {
        padding: 0 56px;
      }

      #shopify-section-{{ section.id }} .giftG-new__track {
        gap: 20px;
      }

      #shopify-section-{{ section.id }} .giftG-new__card {
        flex-basis: calc((100% - 40px) / 3);
      }

      #shopify-section-{{ section.id }} .giftG-new__title {
        font-size: 16px;
      }

      #shopify-section-{{ section.id }} .giftG-new__price-now {
        font-size: 22px;
      }
    }

    @media only screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} .giftG-new {
        padding: 24px 0;
      }

      #shopify-section-{{ section.id }} .giftG-new__header {
        gap: 0;
      }

      #shopify-section-{{ section.id }} .giftG-new__mark {
        display: none;
      }

      #shopify-section-{{ section.id }} .giftG-new__heading {
        font-size: 24px;
      }

      #shopify-section-{{ section.id }} .giftG-new__carousel {
        margin-top: 16px;
        padding: 0;
      }

      #shopify-section-{{ section.id }} .giftG-new__track {
        gap: 16px;
      }

      #shopify-section-{{ section.id }} .giftG-new__card {
        flex-basis: calc((100% - 16px) / 2);
        padding: 0 0 12px;
        border-radius: 10px;
      }

      #shopify-section-{{ section.id }} .giftG-new__info {
        padding: 12px;
      }

      #shopify-section-{{ section.id }} .giftG-new__title {
        font-size: 16px;
        line-height: 1.25;
      }

      #shopify-section-{{ section.id }} .giftG-new__rating {
        padding: 0 12px;
      }

      #shopify-section-{{ section.id }} .giftG-new__price-now {
        font-size: 16px;
      }

      #shopify-section-{{ section.id }} .giftG-new__price-was {
        font-size: 12px;
        line-height: 1.3;
      }

      #shopify-section-{{ section.id }} .giftG-new__controls {
        min-height: 24px;
        margin-top: 16px;
      }

      #shopify-section-{{ section.id }} .giftG-new__dots {
        gap: 6px;
      }

      #shopify-section-{{ section.id }} .giftG-new__arrows {
        display: none;
      }
    }
  {% endstyle %}

  <section class="giftG-new"{% if section_anchor != blank %} id="{{ section_anchor | escape }}"{% endif %}>
    <div class="giftG-new__inner">
      <div class="giftG-new__header">
        {%- if section.settings.heading_mark != blank -%}
          <span class="giftG-new__mark">
            {{ section.settings.heading_mark | image_url: width: 90 | image_tag: loading: 'lazy', widths: '30, 60, 90', sizes: '30px', alt: '' }}
          </span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="giftG-new__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.heading_mark != blank -%}
          <span class="giftG-new__mark">
            {{ section.settings.heading_mark | image_url: width: 90 | image_tag: loading: 'lazy', widths: '30, 60, 90', sizes: '30px', alt: '' }}
          </span>
        {%- endif -%}
      </div>

      <div class="giftG-new__carousel">
        <div class="giftG-new__track" data-giftG-new-track>
          {%- for product in gift_collection.products limit: products_limit -%}
            {%- assign card_alt = product.featured_image.alt | default: product.title -%}
            <article class="giftG-new__card">
              {%- if product.featured_image != blank -%}
                <a class="giftG-new__media" href="{{ product.url }}">
                  {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '180, 300, 420, 600', sizes: '(max-width: 767px) 45vw, (max-width: 1199px) 25vw, 20vw', alt: card_alt }}
                </a>
              {%- endif -%}

              <div class="giftG-new__info">
                <a class="giftG-new__title" href="{{ product.url }}">{{ product.title | escape }}</a>
                <p class="giftG-new__price">
                  <span class="giftG-new__price-now">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="giftG-new__price-was">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                </p>
              </div>

              <div class="giftG-new__rating">
                {%- render 'okendo-reviews-product-rating-summary', product: product -%}
              </div>
            </article>
          {%- endfor -%}
        </div>

        <div class="giftG-new__controls">
          <div class="giftG-new__dots" data-giftG-new-dots></div>
        </div>

        <div class="giftG-new__arrows">
          <button class="giftG-new__arrow giftG-new__arrow--prev" type="button" aria-label="Previous" data-giftG-new-prev>
            {%- render 'heating-icons', icon: 'chevron-right' -%}
          </button>
          <button class="giftG-new__arrow giftG-new__arrow--next" type="button" aria-label="Next" data-giftG-new-next>
            {%- render 'heating-icons', icon: 'chevron-right' -%}
          </button>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      var section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;
      var track = section.querySelector('[data-giftG-new-track]');
      var dots = section.querySelector('[data-giftG-new-dots]');
      var prevBtn = section.querySelector('[data-giftG-new-prev]');
      var nextBtn = section.querySelector('[data-giftG-new-next]');
      if (!track || !dots) return;

      // Nothing rendered (e.g. the collection has no available products):
      // hide the empty carousel controls instead of showing a lone dot.
      if (!track.children.length) {
        var emptyControls = section.querySelector('.giftG-new__controls');
        if (emptyControls) emptyControls.style.display = 'none';
        var emptyArrows = section.querySelector('.giftG-new__arrows');
        if (emptyArrows) emptyArrows.style.display = 'none';
        return;
      }

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      var cards = Array.prototype.slice.call(track.children);
      var pages = 1;
      var clones = [];
      var settleTimer = null;
      var resizeTimer = null;

      function gapWidth() {
        return parseFloat(window.getComputedStyle(track).columnGap) || 0;
      }

      function cardWidth() {
        return cards[0] ? cards[0].getBoundingClientRect().width : track.clientWidth;
      }

      function unit() {
        return cardWidth() + gapWidth();
      }

      function perView() {
        var gap = gapWidth();
        var width = cardWidth();
        if (!width) return 1;
        return Math.max(1, Math.round((track.clientWidth + gap) / (width + gap)));
      }

      function cloneCount() {
        return Math.min(perView(), cards.length);
      }

      // A cloned page sits before and after the real cards, so the first real
      // card starts at this offset and the track can always scroll both ways.
      function realOffset() {
        return clones.length ? cloneCount() * unit() : 0;
      }

      function loopWidth() {
        return cards.length * unit();
      }

      function maxScroll() {
        return Math.max(track.scrollWidth - track.clientWidth, 0);
      }

      // Pages are one screen wide; the last page is end-aligned so it always
      // shows the final cards (it may overlap the previous page).
      function pageStart(page) {
        var perPage = cloneCount();
        var index = Math.min(page * perPage, Math.max(cards.length - perPage, 0));
        return realOffset() + index * unit();
      }

      function pageCount() {
        return Math.max(1, Math.ceil(cards.length / cloneCount()));
      }

      function currentPage() {
        if (!unit()) return 0;
        var max = maxScroll();
        if (clones.length && track.scrollLeft < realOffset() - 1) return pages - 1;
        if (max && track.scrollLeft >= max - 1) return 0;
        var index = Math.round((track.scrollLeft - realOffset()) / unit());
        index = Math.min(Math.max(index, 0), cards.length - 1);
        if (index >= cards.length - cloneCount()) return pages - 1;
        return Math.min(Math.floor(index / cloneCount()), pages - 1);
      }

      function scrollToLeft(left) {
        track.scrollTo({
          left: Math.max(0, Math.min(left, maxScroll())),
          behavior: reduceMotion.matches ? 'auto' : 'smooth'
        });
      }

      function goTo(page) {
        if (!unit()) return;
        scrollToLeft(pageStart(page));
      }

      // Cloned pages before/after the real cards make the loop seamless: once a
      // clone page is reached the track is shifted by one whole loop, so the
      // same cards stay on screen and nothing ever rewinds visibly.
      function clearClones() {
        for (var i = 0; i < clones.length; i++) {
          if (clones[i].parentNode) clones[i].parentNode.removeChild(clones[i]);
        }
        clones = [];
      }

      function makeClone(card) {
        var clone = card.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        clone.setAttribute('inert', '');
        clone.setAttribute('data-giftG-new-clone', '');
        var focusables = clone.querySelectorAll('a, button, input, select, textarea');
        for (var i = 0; i < focusables.length; i++) {
          focusables[i].setAttribute('tabindex', '-1');
        }
        return clone;
      }

      function buildClones() {
        clearClones();
        var count = cloneCount();
        if (cards.length <= count || !unit()) return;
        var first = cards[0];
        var i;
        for (i = 0; i < count; i++) {
          var tail = makeClone(cards[i]);
          track.appendChild(tail);
          clones.push(tail);
        }
        for (i = cards.length - count; i < cards.length; i++) {
          var head = makeClone(cards[i]);
          track.insertBefore(head, first);
          clones.push(head);
        }
        track.scrollLeft = realOffset();
      }

      function checkWrap() {
        if (!clones.length || !unit()) return;
        if (track.scrollLeft < realOffset() - 1) {
          // Entered the leading clone page: shift forward by one full loop.
          track.scrollLeft += loopWidth();
          updateState();
          return;
        }
        var max = maxScroll();
        if (max && track.scrollLeft >= max - 1) {
          // Entered the trailing clone page: shift back by one full loop.
          track.scrollLeft = Math.max(track.scrollLeft - loopWidth(), 0);
          updateState();
        }
      }

      function goNext() {
        if (pages <= 1) return;
        var page = currentPage();
        scrollToLeft(page >= pages - 1 ? maxScroll() : pageStart(page + 1));
      }

      function goPrev() {
        if (pages <= 1) return;
        var page = currentPage();
        scrollToLeft(page <= 0 ? 0 : pageStart(page - 1));
      }

      // Keeps the active dot reachable when the dot strip overflows on mobile.
      function keepActiveDotVisible() {
        var active = dots.querySelector('.giftG-new__dot--active');
        if (!active || dots.scrollWidth <= dots.clientWidth) return;
        var dotsRect = dots.getBoundingClientRect();
        var activeRect = active.getBoundingClientRect();
        if (activeRect.left >= dotsRect.left && activeRect.right <= dotsRect.right) return;
        var left = dots.scrollLeft + (activeRect.left - dotsRect.left) - (dotsRect.width - activeRect.width) / 2;
        dots.scrollTo({ left: Math.max(left, 0), behavior: 'auto' });
      }

      function updateState() {
        var page = currentPage();
        var items = dots.children;
        for (var i = 0; i < items.length; i++) {
          items[i].classList.toggle('giftG-new__dot--active', i === page);
        }
        keepActiveDotVisible();
      }

      function renderDots() {
        pages = pageCount();
        if (prevBtn) prevBtn.disabled = pages <= 1;
        if (nextBtn) nextBtn.disabled = pages <= 1;
        dots.innerHTML = '';
        for (var i = 0; i < pages; i++) {
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'giftG-new__dot';
          dot.setAttribute('aria-label', 'Go to page ' + (i + 1));
          dot.addEventListener('click', (function (index) {
            return function () {
              goTo(index);
            };
          })(i));
          dots.appendChild(dot);
        }
        updateState();
      }

      var ticking = false;
      function onScroll() {
        window.clearTimeout(settleTimer);
        settleTimer = window.setTimeout(checkWrap, 160);
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () {
          ticking = false;
          updateState();
        });
      }

      function onResize() {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(function () {
          track.scrollLeft = 0;
          buildClones();
          renderDots();
        }, 150);
      }

      track.addEventListener('scroll', onScroll, { passive: true });
      if (prevBtn) prevBtn.addEventListener('click', goPrev);
      if (nextBtn) nextBtn.addEventListener('click', goNext);
      window.addEventListener('resize', onResize);
      section.addEventListener('shopify:section:unload', function () {
        window.removeEventListener('resize', onResize);
        window.clearTimeout(settleTimer);
        window.clearTimeout(resizeTimer);
      });

      buildClones();
      renderDots();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Gift Guide New",
  "tag": "section",
  "class": "giftG-new-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "info": "Used by the gift guide category links, e.g. new-arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "image_picker", "id": "heading_mark", "label": "Heading icon (both sides)" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "number",
      "id": "products_limit",
      "label": "Maximum products to show",
      "default": 20,
      "info": "Leave blank to show all products in the collection."
    }
  ],
  "presets": [
    { "name": "Gift Guide New" }
  ]
}
{% endschema %}
