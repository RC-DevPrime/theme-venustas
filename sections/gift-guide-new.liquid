{% style %}
  #shopify-section-{{ section.id }} .giftG-new {
    padding: 80px 0;
    background: #f9f2e8;
    color: #0b4c20;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .giftG-new__inner {
    width: min(calc(100% - 40px), 1340px);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .giftG-new__header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 26px;
  }

  #shopify-section-{{ section.id }} .giftG-new__mark {
    flex: 0 0 auto;
    width: 30px;
    height: 38px;
  }

  #shopify-section-{{ section.id }} .giftG-new__mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .giftG-new__heading {
    margin: 0;
    color: #0b4c20;
    font-size: 34px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .giftG-new__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    margin-top: 38px;
  }

  #shopify-section-{{ section.id }} .giftG-new__card {
    display: flex;
    flex-direction: column;
    padding: 12px 12px 24px;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 3px 6px rgba(119, 107, 86, 0.14);
  }

  #shopify-section-{{ section.id }} .giftG-new__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 233 / 241;
  }

  #shopify-section-{{ section.id }} .giftG-new__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .giftG-new__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 0;
  }

  #shopify-section-{{ section.id }} .giftG-new__title {
    color: #0b4c20;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .giftG-new__title:hover {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .giftG-new__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .giftG-new__price-now {
    color: #0b4c20;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .giftG-new__price-was {
    color: #777;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    text-decoration: line-through;
  }

  @media only screen and (min-width: 768px) and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .giftG-new__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    #shopify-section-{{ section.id }} .giftG-new__title {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .giftG-new__price-now {
      font-size: 22px;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .giftG-new {
      padding: 24px 0;
    }

    #shopify-section-{{ section.id }} .giftG-new__header {
      gap: 0;
    }

    #shopify-section-{{ section.id }} .giftG-new__mark {
      display: none;
    }

    #shopify-section-{{ section.id }} .giftG-new__heading {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .giftG-new__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-top: 16px;
    }

    #shopify-section-{{ section.id }} .giftG-new__card {
      padding: 0 0 12px;
      border-radius: 10px;
    }

    #shopify-section-{{ section.id }} .giftG-new__media {
      aspect-ratio: 167 / 170;
    }

    #shopify-section-{{ section.id }} .giftG-new__info {
      padding: 12px;
    }

    #shopify-section-{{ section.id }} .giftG-new__title {
      min-height: 40px;
      font-size: 16px;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .giftG-new__price-now {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .giftG-new__price-was {
      font-size: 12px;
      line-height: 1.3;
    }
  }
{% endstyle %}

<section class="giftG-new">
  <div class="giftG-new__inner">
    <div class="giftG-new__header">
      {%- if section.settings.heading_mark != blank -%}
        <span class="giftG-new__mark">
          {{ section.settings.heading_mark | image_url: width: 90 | image_tag: loading: 'lazy', widths: '30, 60, 90', sizes: '30px', alt: '' }}
        </span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="giftG-new__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.heading_mark != blank -%}
        <span class="giftG-new__mark">
          {{ section.settings.heading_mark | image_url: width: 90 | image_tag: loading: 'lazy', widths: '30, 60, 90', sizes: '30px', alt: '' }}
        </span>
      {%- endif -%}
    </div>

    <div class="giftG-new__grid">
      {%- for block in section.blocks -%}
        {%- assign card_product = block.settings.product -%}
        {%- if card_product != blank -%}
        {%- assign card_image = block.settings.image | default: card_product.featured_image -%}
        {%- assign card_title = block.settings.title | default: card_product.title -%}
        {%- assign card_alt = card_image.alt | default: card_title -%}
        <article class="giftG-new__card" {{ block.shopify_attributes }}>
          {%- if card_image != blank -%}
            <a class="giftG-new__media" href="{{ card_product.url }}">
              {{ card_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '180, 300, 420, 600', sizes: '(max-width: 767px) 45vw, 233px', alt: card_alt }}
            </a>
          {%- endif -%}

          <div class="giftG-new__info">
            <a class="giftG-new__title" href="{{ card_product.url }}">{{ card_title | escape }}</a>
            <p class="giftG-new__price">
              <span class="giftG-new__price-now">{{ card_product.price | money }}</span>
              {%- if card_product.compare_at_price > card_product.price -%}
                <span class="giftG-new__price-was">{{ card_product.compare_at_price | money }}</span>
              {%- endif -%}
            </p>
          </div>

          <div class="giftG-new__rating">
            {%- render 'okendo-reviews-product-rating-summary', product: card_product -%}
          </div>
        </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift Guide New",
  "tag": "section",
  "class": "giftG-new-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "image_picker", "id": "heading_mark", "label": "Heading icon (both sides)" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift Guide New",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
