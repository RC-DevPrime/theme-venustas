{%- comment -%}
  Product Cooling Modes
  Cards for each cooling mode with High/Low runtime stats + an image.
  e.g. Dual Cooling, Fans Only, Water-cooling.
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    --cm-accent: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .container {
    padding-left: 40px;
    padding-right: 40px;
  }
  #shopify-section-{{ section.id }} .cm {
    padding: 64px 0;
  }
  #shopify-section-{{ section.id }} .cm__heading {
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    text-align: center;
    margin-bottom: {% if section.settings.subheading == blank %}40px{% else %}8px{% endif %};
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .cm__subheading {
    text-align: center;
    color: #777;
    font-size: 15px;
    margin: 0 auto 40px;
    max-width: 680px;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .cm__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    gap: 20px;
  }
  #shopify-section-{{ section.id }} .cm__card {
    background: {{ section.settings.card_bg }};
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 6px 20px rgba(11,30,60,0.05);
  }
  #shopify-section-{{ section.id }} .cm__card-top {
    display: flex;
    align-items: stretch;          /* 让图标与文字块等高 */
    gap: 16px;
    padding: 24px 22px 20px;
  }
  #shopify-section-{{ section.id }} .cm__icon {
    flex: none;
    align-self: stretch;           /* 图标高度 = 右侧文字块高度 */
    width: auto;
    height: auto;
    max-width: 96px;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .cm__text { flex: 1 1 auto; min-width: 0; text-align: left; }
  #shopify-section-{{ section.id }} .cm__card-title {
    font-size: 20px;
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    line-height: 1.15;
    margin: 0 0 2px;
  }
  #shopify-section-{{ section.id }} .cm__subtitle {
    font-size: 13.5px;
    color: #5a6470;
    line-height: 1.3;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .cm__stats {
    display: flex;
    margin-top: 14px;
  }
  #shopify-section-{{ section.id }} .cm__stat {
    text-align: left;
    padding-right: 22px;
  }
  #shopify-section-{{ section.id }} .cm__stat + .cm__stat {
    padding-right: 0;
    padding-left: 22px;
    border-left: 1px solid #dfe4e8;
  }
  #shopify-section-{{ section.id }} .cm__stat-label {
    font-size: 13px;
    font-weight: 600;
    color: #5a6470;
    margin-bottom: 3px;
  }
  #shopify-section-{{ section.id }} .cm__stat-value {
    font-size: 26px;
    font-weight: 800;
    color: var(--cm-accent);
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .cm__img {
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    margin-top: auto;
    background: {{ section.settings.card_bg }};
  }
  #shopify-section-{{ section.id }} .cm__img img,
  #shopify-section-{{ section.id }} .cm__img svg {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .container { padding-left: 20px; padding-right: 20px; }
    #shopify-section-{{ section.id }} .cm { padding: 44px 0; }
    #shopify-section-{{ section.id }} .cm__grid {
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      grid-template-columns: none;
      gap: 14px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      padding-bottom: 6px;
    }
    #shopify-section-{{ section.id }} .cm__card { scroll-snap-align: start; }

    /* 手机端：卡片顶部改为竖向居中（图标在上，文字整行展开），避免文字挤压/截断 */
    #shopify-section-{{ section.id }} .cm__card-top {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
      padding: 22px 18px 14px;
    }
    #shopify-section-{{ section.id }} .cm__icon {
      align-self: center;
      width: auto;
      height: auto;
      max-width: 64px;
      max-height: 64px;
    }
    #shopify-section-{{ section.id }} .cm__text { text-align: center; width: 100%; }
    #shopify-section-{{ section.id }} .cm__card-title { font-size: 19px; }
    #shopify-section-{{ section.id }} .cm__stats { justify-content: center; }
  }
{% endstyle %}

<div class="cm">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="cm__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="cm__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="cm__grid">
      {% for block in section.blocks %}
        <div class="cm__card" {{ block.shopify_attributes }}>
          <div class="cm__card-top">
            {% if block.settings.icon != blank %}
              <img class="cm__icon" src="{{ block.settings.icon | image_url: width: 180 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'cm__icon placeholder-svg' }}
            {% endif %}
            <div class="cm__text">
              <div class="cm__card-title">{{ block.settings.title }}</div>
              {% if block.settings.subtitle != blank %}
                <div class="cm__subtitle">{{ block.settings.subtitle }}</div>
              {% endif %}
              <div class="cm__stats">
                {% if block.settings.stat1_value != blank %}
                  <div class="cm__stat">
                    <div class="cm__stat-label">{{ block.settings.stat1_label }}</div>
                    <div class="cm__stat-value">{{ block.settings.stat1_value }}</div>
                  </div>
                {% endif %}
                {% if block.settings.stat2_value != blank %}
                  <div class="cm__stat">
                    <div class="cm__stat-label">{{ block.settings.stat2_label }}</div>
                    <div class="cm__stat-value">{{ block.settings.stat2_value }}</div>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="cm__img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cooling Modes",
  "class": "product-cooling-modes-section",
  "settings": [
    { "type": "checkbox", "id": "enabled_section_child_scroll", "label": "Enable scroll nav anchor", "default": false },
    { "type": "text", "id": "section_scroll_nav", "label": "Scroll Nav Group" },
    { "type": "text", "id": "nav_title", "label": "Nav Title" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#EDF2F9" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#01132F" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#1C80FE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cooling Modes & Runtime" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    {
      "type": "select", "id": "image_ratio", "label": "Card Image Ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ], "default": "4 / 5"
    }
  ],
  "blocks": [
    {
      "type": "mode",
      "name": "Mode Card",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Control Icon (top-left)", "info": "The mode button/icon image" },
        { "type": "text", "id": "title", "label": "Mode Name", "default": "Dual Cooling" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "e.g. (Ice-water + Fans)" },
        { "type": "text", "id": "stat1_label", "label": "Stat 1 Label", "default": "High" },
        { "type": "text", "id": "stat1_value", "label": "Stat 1 Value", "default": "5H" },
        { "type": "text", "id": "stat2_label", "label": "Stat 2 Label", "default": "Low" },
        { "type": "text", "id": "stat2_value", "label": "Stat 2 Value", "default": "6H" },
        { "type": "image_picker", "id": "image", "label": "Product Image (below)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cooling Modes",
      "blocks": [
        { "type": "mode", "settings": { "title": "Dual Cooling", "stat1_value": "5H", "stat2_value": "6H" } },
        { "type": "mode", "settings": { "title": "Fans Only", "stat1_value": "5H", "stat2_value": "6H" } },
        { "type": "mode", "settings": { "title": "Water-cooling", "stat1_value": "23H", "stat2_value": "29H" } }
      ]
    }
  ]
}
{% endschema %}