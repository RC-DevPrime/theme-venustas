      "default": "Warmth That Fits Daily Life"
    },
    {
      "type": "text",
      "id": "pf_13f761da_value",
      "label": "Text — Value",
      "default": "She needs warmth that is lightweight, elegant, and effortless for commuting, walking, traveling, and everyday outdoor moments."
