{%- assign heatingM_is_pants = false -%}
{%- if section.settings.product_type == 'pants' -%}
  {%- assign heatingM_is_pants = true -%}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .heatingM-specs {
    overflow: hidden;
    background: #f7f8fa;
    color: #1a1a1a;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .heatingM-specs__inner {
    width: min(calc(100% - 40px), 1340px);
    margin: 0 auto;
    padding: 80px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__eyebrow,
  #shopify-section-{{ section.id }} .heatingM-specs__title,
  #shopify-section-{{ section.id }} .heatingM-specs__card-title,
  #shopify-section-{{ section.id }} .heatingM-specs__row,
  #shopify-section-{{ section.id }} .heatingM-specs__row-label,
  #shopify-section-{{ section.id }} .heatingM-specs__row-value,
  #shopify-section-{{ section.id }} .heatingM-specs__card-note { margin: 0; }

  #shopify-section-{{ section.id }} .heatingM-specs__eyebrow {
    color: #b93205;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: .2px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__title {
    color: #111827;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__grid {
    display: grid;
    margin-top: 48px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__card {
    display: flex;
    min-width: 0;
    min-height: 556px;
    padding: 32px;
    flex-direction: column;
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 0 20px rgba(0, 0, 0, .12);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__card-title {
    color: #1a1a1a;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__spec-list {
    display: flex;
    margin-top: 28px;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__row {
    display: flex;
    min-height: 44px;
    padding: 12px 0;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid #dfe3e8;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__row:last-child { border-bottom: 0; }

  #shopify-section-{{ section.id }} .heatingM-specs__row-label {
    flex: 0 0 40%;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__row-value {
    flex: 1 1 auto;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__kit-visual {
    display: grid;
    height: 220px;
    margin-top: 28px;
    padding: 16px;
    grid-template-columns: 1.25fr .9fr .7fr;
    align-items: center;
    justify-items: center;
    gap: 12px;
    overflow: hidden;
    border-radius: 16px;
    background: #f9fafb;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__kit-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__kit-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: #565b63;
    font-size: 12px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__included-list,
  #shopify-section-{{ section.id }} .heatingM-specs__care-list {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__included-list {
    margin-top: 28px;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__included-item,
  #shopify-section-{{ section.id }} .heatingM-specs__care-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__check,
  #shopify-section-{{ section.id }} .heatingM-specs__care-icon {
    display: grid;
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    place-items: center;
    border-radius: 50%;
    color: #b93205;
    background: rgba(185, 50, 5, .1);
    font-size: 16px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__included-item span:last-child {
    font-size: 16px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__card-divider {
    width: 100%;
    height: 1px;
    margin-top: auto;
    background: #dfe3e8;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__card-note {
    margin-top: 16px;
    color: #515151;
    font-size: 12px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__care-list {
    margin-top: 32px;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .heatingM-specs__care-item { align-items: flex-start; }
  #shopify-section-{{ section.id }} .heatingM-specs__care-icon { width: 48px; height: 48px; flex-basis: 48px; font-size: 22px; background: rgba(185, 50, 5, .16); }
  #shopify-section-{{ section.id }} .heatingM-specs__care-item h4 { margin: 0 0 4px; font-size: 13px; font-weight: 700; line-height: 1.3; }
  #shopify-section-{{ section.id }} .heatingM-specs__care-item p { margin: 0; color: #515151; font-size: 12px; line-height: 1.45; }

  @media only screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .heatingM-specs__inner { padding: 72px 0; }
    #shopify-section-{{ section.id }} .heatingM-specs__grid { gap: 16px; }
    #shopify-section-{{ section.id }} .heatingM-specs__card { padding: 24px; border-radius: 20px; }
    #shopify-section-{{ section.id }} .heatingM-specs__card-title { font-size: 20px; }
    #shopify-section-{{ section.id }} .heatingM-specs__row { align-items: flex-start; }
    #shopify-section-{{ section.id }} .heatingM-specs__row-label,
    #shopify-section-{{ section.id }} .heatingM-specs__row-value { font-size: 12px; }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingM-specs__inner { width: 100%; padding: 48px 20px; }
    #shopify-section-{{ section.id }} .heatingM-specs__header { align-items: flex-start; gap: 12px; text-align: left; }
    #shopify-section-{{ section.id }} .heatingM-specs__eyebrow { font-size: 16px; }
    #shopify-section-{{ section.id }} .heatingM-specs__title { font-size: 28px; line-height: 1.2; }
    #shopify-section-{{ section.id }} .heatingM-specs__grid { display: flex; margin-top: 32px; flex-direction: column; gap: 16px; }
    #shopify-section-{{ section.id }} .heatingM-specs__card { min-height: 0; padding: 20px; border-radius: 20px; }
    #shopify-section-{{ section.id }} .heatingM-specs__card-title { font-size: 18px; }
    #shopify-section-{{ section.id }} .heatingM-specs__spec-list { margin-top: 20px; }
    #shopify-section-{{ section.id }} .heatingM-specs__row { min-height: 48px; padding: 14px 0; }
    #shopify-section-{{ section.id }} .heatingM-specs__row-label,
    #shopify-section-{{ section.id }} .heatingM-specs__row-value { font-size: 13px; }
    #shopify-section-{{ section.id }} .heatingM-specs__row-label { flex-basis: 38%; }
    #shopify-section-{{ section.id }} .heatingM-specs__kit-visual { height: 160px; margin-top: 20px; padding: 8px; gap: 8px; }
    #shopify-section-{{ section.id }} .heatingM-specs__included-list { margin-top: 20px; gap: 12px; }
    #shopify-section-{{ section.id }} .heatingM-specs__included-item span:last-child { font-size: 14px; }
    #shopify-section-{{ section.id }} .heatingM-specs__care-list { margin-top: 24px; gap: 24px; }
    #shopify-section-{{ section.id }} .heatingM-specs__care-icon { width: 40px; height: 40px; flex-basis: 40px; font-size: 18px; }
  }
{%- endstyle -%}

<section class="heatingM-specs" aria-label="{{ section.settings.title | escape }}">
  <div class="heatingM-specs__inner">
    <header class="heatingM-specs__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="heatingM-specs__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="heatingM-specs__title">{{ section.settings.title | escape | newline_to_br }}</h2>
      {%- endif -%}
    </header>

    <div class="heatingM-specs__grid">
      <div class="heatingM-specs__card">
        <h3 class="heatingM-specs__card-title">Specifications</h3>
        <div class="heatingM-specs__spec-list">
          <div class="heatingM-specs__row"><p class="heatingM-specs__row-label">Product Type</p><p class="heatingM-specs__row-value">12V Heated {% if heatingM_is_pants %}Pants{% else %}Jacket{% endif %} Liner</p></div>
          <div class="heatingM-specs__row"><p class="heatingM-specs__row-label">Heating Power</p><p class="heatingM-specs__row-value">{% if heatingM_is_pants %}38W{% else %}42W{% endif %}</p></div>
          <div class="heatingM-specs__row"><p class="heatingM-specs__row-label">Heating Zones</p><p class="heatingM-specs__row-value">{% if heatingM_is_pants %}2 Zones: Full Leg (L/R){% else %}6 Zones: Collar, Chest (L/R), Sleeves (L/R), Back{% endif %}</p></div>
          <div class="heatingM-specs__row"><p class="heatingM-specs__row-label">Heating Levels</p><p class="heatingM-specs__row-value">High: 144°F / Medium: 130ºF / Low: 112°F</p></div>
          <div class="heatingM-specs__row"><p class="heatingM-specs__row-label">Primary Power</p><p class="heatingM-specs__row-value">12V Motorcycle Power</p></div>
          <div class="heatingM-specs__row"><p class="heatingM-specs__row-label">Battery Compatibility</p><p class="heatingM-specs__row-value">Venustas High Power 7.5K</p></div>
          <div class="heatingM-specs__row"><p class="heatingM-specs__row-label">Connection</p><p class="heatingM-specs__row-value">Y-Cable Included</p></div>
          <div class="heatingM-specs__row"><p class="heatingM-specs__row-label">Fit</p><p class="heatingM-specs__row-value">Unisex Mid-Layer Fit</p></div>
          <div class="heatingM-specs__row"><p class="heatingM-specs__row-label">Warranty</p><p class="heatingM-specs__row-value">3-Year Heating Element Warranty</p></div>
        </div>
      </div>

      <div class="heatingM-specs__card">
        <h3 class="heatingM-specs__card-title">What's Included</h3>
        <div class="heatingM-specs__kit-visual">
          {%- if section.settings.image_1 != blank -%}
            {{ section.settings.image_1 | image_url: width: 500 | image_tag: class: 'heatingM-specs__kit-image', widths: '160, 300, 500', sizes: '(max-width: 767px) 100px, 145px', loading: 'lazy', alt: 'Included product' }}
          {%- else -%}<div class="heatingM-specs__kit-placeholder">请上传图片</div>{%- endif -%}
          {%- if section.settings.image_2 != blank -%}
            {{ section.settings.image_2 | image_url: width: 400 | image_tag: class: 'heatingM-specs__kit-image', widths: '140, 240, 400', sizes: '(max-width: 767px) 80px, 99px', loading: 'lazy', alt: 'Included cable' }}
          {%- else -%}<div class="heatingM-specs__kit-placeholder">请上传图片</div>{%- endif -%}
          {%- if section.settings.image_3 != blank -%}
            {{ section.settings.image_3 | image_url: width: 320 | image_tag: class: 'heatingM-specs__kit-image', widths: '120, 220, 320', sizes: '(max-width: 767px) 60px, 80px', loading: 'lazy', alt: 'Included manual' }}
          {%- else -%}<div class="heatingM-specs__kit-placeholder">请上传图片</div>{%- endif -%}
        </div>
        <div class="heatingM-specs__included-list">
          <div class="heatingM-specs__included-item"><span class="heatingM-specs__check" aria-hidden="true">✓</span><span>{% if heatingM_is_pants %}Apex™ pants liner{% else %}Apex™ jacket liner{% endif %}</span></div>
          <div class="heatingM-specs__included-item"><span class="heatingM-specs__check" aria-hidden="true">✓</span><span>Y cable set (fuse already inside)</span></div>
          <div class="heatingM-specs__included-item"><span class="heatingM-specs__check" aria-hidden="true">✓</span><span>User Manual</span></div>
        </div>
        <div class="heatingM-specs__card-divider"></div>
        <p class="heatingM-specs__card-note">* High Power 7.5K batteries sold separately</p>
      </div>

      {%- render 'heatingM-care-instructions' -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Heating M specs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small title", "default": "Technical Specifications" },
    { "type": "textarea", "id": "title", "label": "Large title", "default": "Everything You Need to Know About Apex™ Heated Jacket." },
    { "type": "select", "id": "product_type", "label": "Product type", "options": [{ "value": "jacket", "label": "Jacket" }, { "value": "pants", "label": "Pants" }], "default": "jacket" },
    { "type": "image_picker", "id": "image_1", "label": "Included image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Included image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Included image 3" }
  ],
  "presets": [
    { "name": "Heating M specs" }
  ]
}
{% endschema %}
