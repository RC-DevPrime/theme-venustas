{% style %}
  #shopify-section-{{ section.id }} .heating-riding-system-builder {
    width: 100%;
    overflow: hidden;
    background: #f5f5f5;
    color: var(--venustas-black);
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__inner {
    width: min(100% - 40px, 1340px);
    margin-left: auto;
    margin-right: auto;
    padding: 96px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__header {
    max-width: 860px;
    margin: 0 auto 64px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__heading {
    margin: 0 0 12px;
    color: var(--venustas-black);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__heading-accent {
    color: var(--color-brand);
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__description {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__track {
    display: flex;
    align-items: stretch;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__slider {
    flex: 1 1 auto;
    display: flex;
    gap: 18px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__dots {
    display: none;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__intro,
  #shopify-section-{{ section.id }} .heating-riding-system-builder__card {
    height: 316px;
    border-radius: 6px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .heating-riding-system-builder__card:last-child .heating-riding-system-builder__caption{
    background: #8A8A8A;
    color:#ffffff;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__intro {
    position: relative;
    flex: 0 0 253px;
    display: flex;
    align-items: center;
    padding: 32px 28px;
    box-sizing: border-box;
    background: var(--color-brand);
    color: #fff;
    transition: flex-basis 420ms ease, padding 420ms ease, opacity 260ms ease;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__intro-hit {
    position: absolute;
    inset: 0 auto 0 0;
    width: 253px;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__intro-text {
    margin: 0;
    color: #fff;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    white-space: pre-line;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__card {
    position: relative;
    flex: 0 0 253px;
    background: #fff;
    transition: flex-basis 420ms ease;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__image,
  #shopify-section-{{ section.id }} .heating-riding-system-builder__hover-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center center;
    transition: opacity 220ms ease;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__hover-image,
  #shopify-section-{{ section.id }} .heating-riding-system-builder__caption {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__hover-image {
    inset:0;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__caption {
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 76px;
    padding: 12px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-brand);
    color: #fff;
    text-align: center;
    transition: opacity 220ms ease;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__caption-title {
    margin: 0 0 4px;
    color: #fff;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__caption-text {
    margin: 0;
    color: #fff;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__icons {
    margin-top: 64px;
    border-radius: 12px;
    border: 1px solid rgba(157, 157, 157, 0.10);
    background: rgba(217, 217, 217, 0.10);
  }

  #shopify-section-{{ section.id }} .heating-system-icons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding: 30px 96px;
  }

  #shopify-section-{{ section.id }} .heating-system-icons__item {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .heating-system-icons__icon {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    color: var(--color-brand);
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .heating-system-icons__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .heating-system-icons__title {
    margin: 0 0 6px;
    color: var(--color-brand);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-system-icons__text {
    margin: 0;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
  }

  @media only screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .heating-riding-system-builder__track:has(.heating-riding-system-builder__intro-hit:hover) .heating-riding-system-builder__intro {
      flex-basis: 506px;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__track:has(.heating-riding-system-builder__intro-hit:hover) .heating-riding-system-builder__card {
      flex-basis: 190px;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__card:hover .heating-riding-system-builder__image {
      opacity: 0;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__card:hover .heating-riding-system-builder__hover-image,
    #shopify-section-{{ section.id }} .heating-riding-system-builder__card:hover .heating-riding-system-builder__caption {
      opacity: 1;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heating-riding-system-builder__inner {
      width: 100%;
      padding: 32px 20px;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__header {
      max-width: none;
      margin-bottom: 28px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__heading {
      font-size: 24px;
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__description {
      font-size: 16px;
      line-height: 1.28;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__track {
      display: block;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__intro {
      width: 100%;
      height: auto;
      margin-bottom: 28px;
      padding: 22px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__intro-text {
      font-size: 16px;
      line-height: 1.18;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__intro-hit {
      display: none;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__slider {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__slider::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 16px;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__dot {
      width: 6px;
      height: 6px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(31, 31, 31, 0.22);
      cursor: pointer;
      transition: background 160ms ease, transform 160ms ease;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__dot.is-active {
      background: var(--color-brand);
      transform: scale(1.08);
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__card {
      flex: 0 0 100%;
      width: 100%;
      height: 420px;
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__image {
      display: none;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__hover-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 1;
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      opacity: 1;
      pointer-events: auto;
      min-height: 76px;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__icons {
      margin-top: 24px;
      background: #fff;
    }

    #shopify-section-{{ section.id }} .heating-system-icons {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 16px;
    }

    #shopify-section-{{ section.id }} .heating-system-icons__item {
      align-items: center;
    }
  }
{% endstyle %}

<section class="heating-riding-system-builder" id="venustas-riding-system">
  <div class="heating-riding-system-builder__inner">
    <div class="heating-riding-system-builder__header">
      <h2 class="heating-riding-system-builder__heading">
        Introducing <span class="heating-riding-system-builder__heading-accent">Venustas Heated Riding System</span>
      </h2>
      <p class="heating-riding-system-builder__description">
        A modular system that lets riders choose the warmth they need - from upper body comfort to full-body coverage. Start with what you need. Expand when your ride demands more.
      </p>
    </div>

    <div class="heating-riding-system-builder__track">
      <div class="heating-riding-system-builder__intro">
        <span class="heating-riding-system-builder__intro-hit" aria-hidden="true"></span>
        {%- if section.settings.intro_text != blank -%}
          <h2 class="heating-riding-system-builder__intro-text">{{ section.settings.intro_text }}</h2>
        {%- endif -%}
      </div>

      <div class="heating-riding-system-builder__slider">
        {%- for block in section.blocks -%}
          <div class="heating-riding-system-builder__card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag:
                  class: 'heating-riding-system-builder__image',
                  loading: 'lazy',
                  widths: '253,380,506,700',
                  sizes: '(max-width: 767px) 0px, 253px',
                  alt: block.settings.image.alt | default: block.settings.hover_title
              }}
            {%- endif -%}

            {%- if block.settings.hover_image != blank -%}
              {{
                block.settings.hover_image
                | image_url: width: 1100
                | image_tag:
                  class: 'heating-riding-system-builder__hover-image',
                  loading: 'lazy',
                  widths: '253,420,560,840,1100',
                  sizes: '(max-width: 767px) calc(100vw - 40px), 560px',
                  alt: block.settings.hover_image.alt | default: block.settings.hover_title
              }}
            {%- endif -%}

            <div class="heating-riding-system-builder__caption">
              {%- if block.settings.hover_title != blank -%}
                <h3 class="heating-riding-system-builder__caption-title">{{ block.settings.hover_title }}</h3>
              {%- endif -%}
              {%- if block.settings.hover_text != blank -%}
                <p class="heating-riding-system-builder__caption-text">{{ block.settings.hover_text }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="heating-riding-system-builder__dots" aria-label="System item carousel pagination">
          {%- for block in section.blocks -%}
            <button
              class="heating-riding-system-builder__dot{% if forloop.first %} is-active{% endif %}"
              type="button"
              aria-label="Go to slide {{ forloop.index }}"
              data-heating-riding-system-dot="{{ forloop.index0 }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="heating-riding-system-builder__icons">
      {%- render 'heating-system-icons',
        title_1: section.settings.icon_title_1,
        text_1: section.settings.icon_text_1,
        title_2: section.settings.icon_title_2,
        text_2: section.settings.icon_text_2,
        title_3: section.settings.icon_title_3,
        text_3: section.settings.icon_text_3
      -%}
    </div>
  </div>
</section>

<script>
  (function() {
    var root = document.querySelector('#shopify-section-{{ section.id }} .heating-riding-system-builder');
    if (!root) return;

    var slider = root.querySelector('.heating-riding-system-builder__slider');
    var cards = Array.prototype.slice.call(root.querySelectorAll('.heating-riding-system-builder__card'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('.heating-riding-system-builder__dot'));

    if (!slider || cards.length < 2 || dots.length < 2) return;

    var ticking = false;

    function setActiveDot(index) {
      dots.forEach(function(dot, dotIndex) {
        dot.classList.toggle('is-active', dotIndex === index);
      });
    }

    function getActiveIndex() {
      var sliderLeft = slider.getBoundingClientRect().left;
      var closestIndex = 0;
      var closestDistance = Infinity;

      cards.forEach(function(card, index) {
        var distance = Math.abs(card.getBoundingClientRect().left - sliderLeft);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    }

    slider.addEventListener('scroll', function() {
      if (ticking) return;
      ticking = true;

      window.requestAnimationFrame(function() {
        setActiveDot(getActiveIndex());
        ticking = false;
      });
    }, { passive: true });

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var index = Number(dot.getAttribute('data-heating-riding-system-dot'));
        var target = cards[index];

        if (!target) return;
        slider.scrollTo({
          left: target.offsetLeft - slider.offsetLeft,
          behavior: 'smooth'
        });
        setActiveDot(index);
      });
    });
  })();
</script>

