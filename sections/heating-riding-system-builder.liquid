{% style %}
  #shopify-section-{{ section.id }} .heating-riding-system-builder {
    width: 100%;
    overflow: hidden;
    background: #f2f2f2;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__inner {
    width: min(100% - 40px, 1340px);
    margin-left: auto;
    margin-right: auto;
    padding: 52px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__header {
    max-width: 860px;
    margin: 0 auto 28px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__heading {
    margin: 0 0 16px;
    color: #191919;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__heading-accent {
    color: var(--color-brand);
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__description {
    margin: 0;
    color: #191919;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__track {
    display: flex;
    align-items: stretch;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__slider {
    flex: 1 1 auto;
    display: flex;
    gap: 18px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__intro,
  #shopify-section-{{ section.id }} .heating-riding-system-builder__card {
    height: 316px;
    border-radius: 6px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__intro {
    position: relative;
    flex: 0 0 253px;
    display: flex;
    align-items: center;
    padding: 32px 34px;
    box-sizing: border-box;
    background: var(--color-brand);
    color: #fff;
    transition: flex-basis 420ms ease, padding 420ms ease, opacity 260ms ease;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__intro-hit {
    position: absolute;
    inset: 0 auto 0 0;
    width: 253px;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__intro-text {
    margin: 0;
    color: #fff;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    white-space: pre-line;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__card {
    position: relative;
    flex: 0 0 253px;
    background: #fff;
    transition: flex-basis 420ms ease;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__image,
  #shopify-section-{{ section.id }} .heating-riding-system-builder__hover-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center center;
    transition: opacity 220ms ease, height 220ms ease;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__hover-image,
  #shopify-section-{{ section.id }} .heating-riding-system-builder__caption {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__hover-image {
    inset: 0;
    height: calc(100% - 52px);
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__caption {
    left: 0;
    right: 0;
    bottom: 0;
    height: 52px;
    padding: 8px 12px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-brand);
    color: #fff;
    text-align: center;
    transition: opacity 220ms ease;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__caption-title {
    margin: 0 0 4px;
    color: #fff;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__caption-text {
    margin: 0;
    color: #fff;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-riding-system-builder__icons {
    margin-top: 56px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.28);
  }

  #shopify-section-{{ section.id }} .heating-system-icons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding: 28px 96px;
  }

  #shopify-section-{{ section.id }} .heating-system-icons__item {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .heating-system-icons__icon {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    color: var(--color-brand);
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .heating-system-icons__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .heating-system-icons__title {
    margin: 0 0 6px;
    color: var(--color-brand);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-system-icons__text {
    margin: 0;
    color: #191919;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
  }

  @media only screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .heating-riding-system-builder__track:has(.heating-riding-system-builder__intro-hit:hover) .heating-riding-system-builder__intro {
      flex-basis: 506px;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__track:has(.heating-riding-system-builder__intro-hit:hover) .heating-riding-system-builder__card {
      flex-basis: 190px;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__track:has(.heating-riding-system-builder__card:hover) .heating-riding-system-builder__card {
      flex-basis: 154px;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__track .heating-riding-system-builder__card:hover {
      flex-basis: 506px;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__card:hover .heating-riding-system-builder__image {
      opacity: 0;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__card:hover .heating-riding-system-builder__hover-image,
    #shopify-section-{{ section.id }} .heating-riding-system-builder__card:hover .heating-riding-system-builder__caption {
      opacity: 1;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heating-riding-system-builder__inner {
      width: 100%;
      padding: 32px 20px;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__header {
      max-width: none;
      margin-bottom: 24px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__heading {
      font-size: 24px;
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__description {
      font-size: 16px;
      line-height: 1.28;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__track {
      display: block;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__intro {
      width: 100%;
      height: auto;
      min-height: 150px;
      margin-bottom: 16px;
      padding: 28px 24px;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__intro-text {
      font-size: 24px;
      line-height: 1.18;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__intro-hit {
      display: none;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__slider {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__slider::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__card {
      flex: 0 0 100%;
      width: 100%;
      height: 420px;
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__image {
      display: none;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__hover-image {
      position: static;
      width: 100%;
      height: calc(100% - 52px);
      opacity: 1;
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__caption {
      position: static;
      opacity: 1;
      pointer-events: auto;
    }

    #shopify-section-{{ section.id }} .heating-riding-system-builder__icons {
      margin-top: 24px;
      background: #fff;
    }

    #shopify-section-{{ section.id }} .heating-system-icons {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 18px 14px;
    }

    #shopify-section-{{ section.id }} .heating-system-icons__item {
      align-items: flex-start;
    }
  }
{% endstyle %}

<section class="heating-riding-system-builder">
  <div class="heating-riding-system-builder__inner">
    <div class="heating-riding-system-builder__header">
      <h2 class="heating-riding-system-builder__heading">
        Introducing <span class="heating-riding-system-builder__heading-accent">Venustas Heated Riding System</span>
      </h2>
      <p class="heating-riding-system-builder__description">
        A modular system that lets riders choose the warmth they need - from upper body comfort to full-body coverage. Start with what you need. Expand when your ride demands more.
      </p>
    </div>

    <div class="heating-riding-system-builder__track">
      <div class="heating-riding-system-builder__intro">
        <span class="heating-riding-system-builder__intro-hit" aria-hidden="true"></span>
        {%- if section.settings.intro_text != blank -%}
          <h2 class="heating-riding-system-builder__intro-text">{{ section.settings.intro_text }}</h2>
        {%- endif -%}
      </div>

      <div class="heating-riding-system-builder__slider">
        {%- for block in section.blocks -%}
          <div class="heating-riding-system-builder__card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag:
                  class: 'heating-riding-system-builder__image',
                  loading: 'lazy',
                  widths: '253,380,506,700',
                  sizes: '(max-width: 767px) 0px, 253px',
                  alt: block.settings.image.alt | default: block.settings.hover_title
              }}
            {%- endif -%}

            {%- if block.settings.hover_image != blank -%}
              {{
                block.settings.hover_image
                | image_url: width: 1100
                | image_tag:
                  class: 'heating-riding-system-builder__hover-image',
                  loading: 'lazy',
                  widths: '253,420,560,840,1100',
                  sizes: '(max-width: 767px) calc(100vw - 40px), 560px',
                  alt: block.settings.hover_image.alt | default: block.settings.hover_title
              }}
            {%- endif -%}

            <div class="heating-riding-system-builder__caption">
              {%- if block.settings.hover_title != blank -%}
                <h3 class="heating-riding-system-builder__caption-title">{{ block.settings.hover_title }}</h3>
              {%- endif -%}
              {%- if block.settings.hover_text != blank -%}
                <p class="heating-riding-system-builder__caption-text">{{ block.settings.hover_text }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="heating-riding-system-builder__icons">
      {%- render 'heating-system-icons',
        title_1: section.settings.icon_title_1,
        text_1: section.settings.icon_text_1,
        title_2: section.settings.icon_title_2,
        text_2: section.settings.icon_text_2,
        title_3: section.settings.icon_title_3,
        text_3: section.settings.icon_text_3
      -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Heating Riding System",
  "tag": "section",
  "class": "heating-riding-system-builder-section",
  "settings": [
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro text",
      "default": "Venustas Riding System.\nOne System, Multiple Ways to Stay Warm."
    },
    {
      "type": "text",
      "id": "icon_title_1",
      "label": "Icon 1 title",
      "default": "Modular"
    },
    {
      "type": "text",
      "id": "icon_text_1",
      "label": "Icon 1 text",
      "default": "Add what you need when you need it."
    },
    {
      "type": "text",
      "id": "icon_title_2",
      "label": "Icon 2 title",
      "default": "Compatible"
    },
    {
      "type": "text",
      "id": "icon_text_2",
      "label": "Icon 2 text",
      "default": "Works together seamlessly for total comfort."
    },
    {
      "type": "text",
      "id": "icon_title_3",
      "label": "Icon 3 title",
      "default": "Powered Warmth"
    },
    {
      "type": "text",
      "id": "icon_text_3",
      "label": "Icon 3 text",
      "default": "Active heat where riders need it most."
    }
  ],
  "blocks": [
    {
      "type": "system_item",
      "name": "System item",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover image"
        },
        {
          "type": "text",
          "id": "hover_title",
          "label": "Hover title",
          "default": "Heated Vest"
        },
        {
          "type": "text",
          "id": "hover_text",
          "label": "Hover text",
          "default": "Built for everyday warmth."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heating Riding System",
      "blocks": [
        {
          "type": "system_item",
          "settings": {
            "hover_title": "Heated Vest",
            "hover_text": "Built for everyday warmth."
          }
        },
        {
          "type": "system_item",
          "settings": {
            "hover_title": "Heated Jacket Liner",
            "hover_text": "Core warmth for your upper body."
          }
        },
        {
          "type": "system_item",
          "settings": {
            "hover_title": "Heated Pants Liner",
            "hover_text": "Essential warmth for your lower body."
          }
        },
        {
          "type": "system_item",
          "settings": {
            "hover_title": "More To Come",
            "hover_text": "Designed to expand with your needs."
          }
        }
      ]
    }
  ]
}
{% endschema %}
