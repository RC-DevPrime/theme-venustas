{% style %}
  #shopify-section-{{ section.id }} .heatingv-battery-sides {
    width: 100%;
    overflow: hidden;
    background: #f0f0f0;
    color: var(--venustas-black, #14161a);
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__inner {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 100px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__rows {
    display: flex;
    flex-direction: column;
    gap: 100px;
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__row {
    display: grid;
    grid-template-columns: 652px minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__row--text-first {
    grid-template-columns: minmax(0, 1fr) 652px;
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__media {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    aspect-ratio: 8 / 5;
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__picture,
  #shopify-section-{{ section.id }} .heatingv-battery-sides__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__image {
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__placeholder {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 24px;
    color: #565b63;
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__title {
    margin: 0;
    color: var(--venustas-black, #14161a);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.6px;
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__text {
    margin: 0;
    color: #565b63;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.72;
  }

  #shopify-section-{{ section.id }} .heatingv-battery-sides__text p {
    margin: 0;
  }

  @media only screen and (max-width: 1000px) {
    #shopify-section-{{ section.id }} .heatingv-battery-sides__inner {
      width: 100%;
      padding: 56px 20px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .heatingv-battery-sides__rows {
      gap: 56px;
    }

    #shopify-section-{{ section.id }} .heatingv-battery-sides__row,
    #shopify-section-{{ section.id }} .heatingv-battery-sides__row--text-first {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .heatingv-battery-sides__row--text-first .heatingv-battery-sides__media {
      order: -1;
    }

    #shopify-section-{{ section.id }} .heatingv-battery-sides__media {
      width: 100%;
      border-radius: 8px;
    }

    #shopify-section-{{ section.id }} .heatingv-battery-sides__copy {
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .heatingv-battery-sides__title {
      font-size: 20px;
      line-height: 1.3;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heatingv-battery-sides__text {
      font-size: 14px;
      line-height: 1.6;
    }
  }
{% endstyle %}

{%- liquid
  assign item_1_mobile = section.settings.item_1_mobile_image | default: section.settings.item_1_desktop_image
  assign item_1_image = section.settings.item_1_desktop_image | default: item_1_mobile
  assign item_2_mobile = section.settings.item_2_mobile_image | default: section.settings.item_2_desktop_image
  assign item_2_image = section.settings.item_2_desktop_image | default: item_2_mobile
-%}

<section class="heatingv-battery-sides" id="heatingv-power-packs">
  <div class="heatingv-battery-sides__inner">
    <div class="heatingv-battery-sides__rows">
      <div class="heatingv-battery-sides__row heatingv-battery-sides__row--text-first">
        <div class="heatingv-battery-sides__copy">
          {%- if section.settings.item_1_title != blank -%}
            <h2 class="heatingv-battery-sides__title">{{ section.settings.item_1_title }}</h2>
          {%- endif -%}
          {%- if section.settings.item_1_description != blank -%}
            <div class="heatingv-battery-sides__text">{{ section.settings.item_1_description }}</div>
          {%- endif -%}
        </div>

        <div class="heatingv-battery-sides__media">
          {%- if item_1_image != blank -%}
            <picture class="heatingv-battery-sides__picture">
              {%- if item_1_mobile != blank -%}
                <source media="(max-width: 1000px)" srcset="{{ item_1_mobile | image_url: width: 700 }} 700w, {{ item_1_mobile | image_url: width: 1000 }} 1000w" sizes="calc(100vw - 40px)">
              {%- endif -%}
              {{
                item_1_image
                | image_url: width: 1260
                | image_tag:
                  class: 'heatingv-battery-sides__image',
                  loading: 'lazy',
                  widths: '350, 700, 1000, 1260',
                  sizes: '(max-width: 1000px) calc(100vw - 40px), 652px',
                  alt: item_1_image.alt | default: section.settings.item_1_title
              }}
            </picture>
          {%- else -%}
            <div class="heatingv-battery-sides__placeholder">Upload the item 1 image.</div>
          {%- endif -%}
        </div>
      </div>

      <div class="heatingv-battery-sides__row">
        <div class="heatingv-battery-sides__media">
          {%- if item_2_image != blank -%}
            <picture class="heatingv-battery-sides__picture">
              {%- if item_2_mobile != blank -%}
                <source media="(max-width: 1000px)" srcset="{{ item_2_mobile | image_url: width: 700 }} 700w, {{ item_2_mobile | image_url: width: 1000 }} 1000w" sizes="calc(100vw - 40px)">
              {%- endif -%}
              {{
                item_2_image
                | image_url: width: 1260
                | image_tag:
                  class: 'heatingv-battery-sides__image',
                  loading: 'lazy',
                  widths: '350, 700, 1000, 1260',
                  sizes: '(max-width: 1000px) calc(100vw - 40px), 652px',
                  alt: item_2_image.alt | default: section.settings.item_2_title
              }}
            </picture>
          {%- else -%}
            <div class="heatingv-battery-sides__placeholder">Upload the item 2 image.</div>
          {%- endif -%}
        </div>

        <div class="heatingv-battery-sides__copy">
          {%- if section.settings.item_2_title != blank -%}
            <h2 class="heatingv-battery-sides__title">{{ section.settings.item_2_title }}</h2>
          {%- endif -%}
          {%- if section.settings.item_2_description != blank -%}
            <div class="heatingv-battery-sides__text">{{ section.settings.item_2_description }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HeatingV Battery Sides",
  "settings": [
    {
      "type": "header",
      "content": "ProductH item 1 (text left, image right)"
    },
    {
      "type": "text",
      "id": "item_1_title",
      "label": "ProductH item 1 title",
      "default": "Batteries on Your Sides, Never Your Back"
    },
    {
      "type": "richtext",
      "id": "item_1_description",
      "label": "ProductH item 1 description",
      "default": "<p>One Battery Left. One Right. Balanced Across the Body. Sitting on a sled, riding a lift, leaning against a truck seat — the two places a battery pack usually digs in. Volcano™ keeps both off your back and off your spine.</p>"
    },
    {
      "type": "image_picker",
      "id": "item_1_desktop_image",
      "label": "ProductH item 1 desktop image"
    },
    {
      "type": "image_picker",
      "id": "item_1_mobile_image",
      "label": "ProductH item 1 mobile image"
    },
    {
      "type": "header",
      "content": "ProductH item 2 (image left, text right)"
    },
    {
      "type": "text",
      "id": "item_2_title",
      "label": "ProductH item 2 title",
      "default": "Near a 12v Outlet, It Never Runs Down"
    },
    {
      "type": "richtext",
      "id": "item_2_description",
      "label": "ProductH item 2 description",
      "default": "<p>The DC lead is already built into the left hand pocket. Add the Y cable set (sold separately, reserve for free) and Volcano™ series runs straight off a snowmobile, a motorcycle or an ATV's 12V power — no battery to watch, no ceiling on the day.</p>"
    },
    {
      "type": "image_picker",
      "id": "item_2_desktop_image",
      "label": "ProductH item 2 desktop image"
    },
    {
      "type": "image_picker",
      "id": "item_2_mobile_image",
      "label": "ProductH item 2 mobile image"
    }
  ],
  "presets": [
    {
      "name": "HeatingV Battery Sides"
    }
  ]
}
{% endschema %}
