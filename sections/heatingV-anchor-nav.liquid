{% style %}
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 98px;
    z-index: 20;
  }

  #shopify-section-{{ section.id }} .heating-anchor-nav {
    position: relative;
    width: 100%;
    z-index: 20;
    background: {{ section.settings.section_background }};
    font-family: var(--font-primary);
    border-bottom: 0.731px solid #E5E7EB;
  }

  #shopify-section-{{ section.id }} .heating-anchor-nav__sticky-wrap {
    position: relative;
    width: 100%;
    padding: 0 20px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-anchor-nav__bar {
    width: min(100%, 1340px);
    min-width: 0;
    margin: 0 auto;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .heating-anchor-nav__list {
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: center;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .heating-anchor-nav__list::-webkit-scrollbar {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ section.id }} .heating-anchor-nav__list {
      cursor: grab;
      user-select: none;
    }
    #shopify-section-{{ section.id }} .heating-anchor-nav__list.is-dragging {
      cursor: grabbing;
    }
    #shopify-section-{{ section.id }} .heating-anchor-nav__link {
      cursor: inherit;
    }
  }

  #shopify-section-{{ section.id }} .heating-anchor-nav__link {
    position: relative;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding-right: 44px;
    color: #14161a;
    font-size: 16px;
    font-weight: 500;
    line-height: 21.84px;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-anchor-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 48px;
    bottom: 0;
    height: 3px;
    border-radius: 2px 2px 0 0;
    background: var(--color-brand, #B93205);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  #shopify-section-{{ section.id }} .heating-anchor-nav__link.is-active {
    font-weight: 700;
    color: #14161a;
  }

  #shopify-section-{{ section.id }} .heating-anchor-nav__link.is-active::after {
    transform: scaleX(1);
  }

  @media only screen and (min-width: 768px) and (max-width: 1279px) {
    #shopify-section-{{ section.id }} {
      top: 96px;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      top: var(--headerHeight, 77px);
    }
    #shopify-section-{{ section.id }} .heating-anchor-nav__link:last-child {
      padding-right: 0;
    }
    #shopify-section-{{ section.id }} .heating-anchor-nav__link:last-child::after {
      right: 0;
    }
  }
{% endstyle %}

<section class="heating-anchor-nav" data-heating-anchor-nav>
  <div class="heating-anchor-nav__sticky-wrap">
    <nav class="heating-anchor-nav__bar" aria-label="{{ section.settings.aria_label | escape }}">
      <div class="heating-anchor-nav__list">
        {%- for block in section.blocks -%}
          {%- assign target_id = block.settings.target_id | strip | remove_first: '#' -%}
          {%- if block.settings.label != blank and target_id != blank -%}
            <a
              class="heating-anchor-nav__link{% if forloop.first %} is-active{% endif %}"
              href="#{{ target_id | escape }}"
              data-anchor-target="{{ target_id | escape }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </nav>
  </div>

</section>

<script>
  (function() {
    function initialize() {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-heating-anchor-nav]');
    if (!root) return;
    if (root.anchorNavCleanup) root.anchorNavCleanup();
    var controller = new AbortController();
    var frame = 0;
    var clickTimer;
    var pendingTargetId;

    // Breathing room between the pinned nav and the top of the target section.
    var SCROLL_GAP = 16;
    // Only used if the header/nav can't be measured.
    var FALLBACK_OFFSET = 159;
    var links = Array.prototype.slice.call(root.querySelectorAll('.heating-anchor-nav__link'));
    var list = root.querySelector('.heating-anchor-nav__list');
    var drag = null;
    var suppressClick = false;
    var activeTargetId;
    var mobile = window.matchMedia('(max-width: 767px)');
    var scrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    list.addEventListener('pointerdown', function(event) {
      suppressClick = false;
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      if (list.scrollWidth <= list.clientWidth) return;
      drag = { id: event.pointerId, x: event.clientX, scrollLeft: list.scrollLeft, moved: false };
    }, { signal: controller.signal });
    window.addEventListener('pointermove', function(event) {
      if (!drag || event.pointerId !== drag.id) return;
      if (!(event.buttons & 1)) { stopDrag(); return; }
      var distance = event.clientX - drag.x;
      if (!drag.moved && Math.abs(distance) < 5) return;
      if (!drag.moved) {
        drag.moved = true;
        suppressClick = true;
        list.classList.add('is-dragging');
        list.setPointerCapture(event.pointerId);
      }
      event.preventDefault();
      list.scrollLeft = drag.scrollLeft - distance;
    }, { signal: controller.signal });
    function stopDrag(event) {
      if (!drag || (event && event.pointerId !== drag.id)) return;
      var pointerId = drag.id;
      drag = null;
      list.classList.remove('is-dragging');
      if (list.hasPointerCapture(pointerId)) list.releasePointerCapture(pointerId);
    }
    window.addEventListener('pointerup', stopDrag, { signal: controller.signal });
    window.addEventListener('pointercancel', stopDrag, { signal: controller.signal });
    window.addEventListener('blur', function() { stopDrag(); }, { signal: controller.signal });
    list.addEventListener('lostpointercapture', stopDrag, { signal: controller.signal });
    list.addEventListener('dragstart', function(event) { event.preventDefault(); }, { signal: controller.signal });
    list.addEventListener('click', function(event) {
      if (!suppressClick || event.detail === 0) return;
      suppressClick = false;
      event.preventDefault();
      event.stopImmediatePropagation();
    }, { capture: true, signal: controller.signal });

    function measureHeight(element) {
      return element ? element.getBoundingClientRect().height : 0;
    }

    function getScrollOffset() {
      // Queried live: the theme editor swaps these nodes out between renders.
      var navSection = document.getElementById('shopify-section-{{ section.id }}');
      var headerEl = document.querySelector('.header');
      var headerHeight = measureHeight(headerEl);
      var occluded = headerHeight;

      var navHeight = measureHeight(navSection);
      if (navHeight) {
        // Include the pinned navigation on both desktop and mobile.
        var pinnedTop = parseFloat(window.getComputedStyle(navSection).top) || 0;
        occluded = Math.max(headerHeight, pinnedTop) + navHeight;
      }

      return (occluded || FALLBACK_OFFSET) + SCROLL_GAP;
    }

    function setActive(targetId, reveal) {
      if (activeTargetId === targetId && !reveal) return;
      activeTargetId = targetId;
      links.forEach(function(link) {
        var active = link.getAttribute('data-anchor-target') === targetId;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });

      var activeLink = links.find(function(link) {
        return link.getAttribute('data-anchor-target') === targetId;
      });

      if (activeLink && list) {
        var linkRect = activeLink.getBoundingClientRect();
        var listRect = list.getBoundingClientRect();
        if (mobile.matches || linkRect.left < listRect.left || linkRect.right > listRect.right) {
          var left = list.scrollLeft + linkRect.left - listRect.left - (mobile.matches ? 0 : (list.clientWidth - linkRect.width) / 2);
          list.scrollTo({
            left: Math.max(0, Math.min(left, list.scrollWidth - list.clientWidth)),
            behavior: scrollBehavior
          });
        }
      }
    }

    links.forEach(function(link) {
      link.addEventListener('click', function(event) {
        var targetId = link.getAttribute('data-anchor-target');
        var target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;

        event.preventDefault();
        var scrollOffset = getScrollOffset();
        target.style.scrollMarginTop = scrollOffset + 'px';

        var top = target.getBoundingClientRect().top + window.pageYOffset - scrollOffset;
        pendingTargetId = targetId;
        window.clearTimeout(clickTimer);
        clickTimer = window.setTimeout(cancelPendingScroll, 1500);
        setActive(targetId, true);
        window.scrollTo({ top: top, behavior: scrollBehavior });
        scheduleHighlight();
      }, { signal: controller.signal });
    });

    var targets = links
      .map(function(link) {
        return document.getElementById(link.getAttribute('data-anchor-target'));
      })
      .filter(Boolean);

    function syncTargetOffsets() {
      var scrollOffset = getScrollOffset();
      targets.forEach(function(target) {
        target.style.scrollMarginTop = scrollOffset + 'px';
      });
    }

    function updateHighlight() {
      frame = 0;
      var offset = getScrollOffset();
      if (pendingTargetId) {
        var pendingTarget = document.getElementById(pendingTargetId);
        if (pendingTarget) {
          var destination = pendingTarget.getBoundingClientRect().top + window.pageYOffset - offset;
          var maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
          destination = Math.max(0, Math.min(destination, maxScroll));
          if (Math.abs(window.pageYOffset - destination) > 2) return;
        }
        pendingTargetId = null;
        window.clearTimeout(clickTimer);
      }
      var current = null;
      var currentTop = -Infinity;
      var first = null;
      var firstTop = Infinity;
      var atBottom = window.pageYOffset + window.innerHeight >= document.documentElement.scrollHeight - 2;
      targets.forEach(function(target) {
        if (!target.getClientRects().length) return;
        var top = target.getBoundingClientRect().top;
        if (top < firstTop) { first = target; firstTop = top; }
        if ((top <= offset + 2 || (atBottom && top < window.innerHeight)) && top > currentTop) { current = target; currentTop = top; }
      });
      if (current || first) setActive((current || first).id, false);
    }

    function scheduleHighlight() {
      if (!frame) frame = window.requestAnimationFrame(updateHighlight);
    }

    function cancelPendingScroll() {
      pendingTargetId = null;
      window.clearTimeout(clickTimer);
      scheduleHighlight();
    }

    function onResize() {
      syncTargetOffsets();
      if (activeTargetId) setActive(activeTargetId, true);
      scheduleHighlight();
    }

    window.addEventListener('scroll', scheduleHighlight, { passive: true, signal: controller.signal });
    window.addEventListener('resize', onResize, { signal: controller.signal });
    window.addEventListener('wheel', cancelPendingScroll, { passive: true, signal: controller.signal });
    window.addEventListener('touchstart', cancelPendingScroll, { passive: true, signal: controller.signal });
    window.addEventListener('keydown', function(event) {
      if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].indexOf(event.key) !== -1) cancelPendingScroll();
    }, { signal: controller.signal });
    root.anchorNavCleanup = function() {
      stopDrag();
      controller.abort();
      window.cancelAnimationFrame(frame);
      window.clearTimeout(clickTimer);
    };
    document.addEventListener('shopify:section:unload', function(event) {
      if (event.target.contains(root)) root.anchorNavCleanup();
    }, { signal: controller.signal });
    syncTargetOffsets();
    scheduleHighlight();

    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true });
    } else {
      initialize();
    }
  })();
</script>

{% schema %}
{
  "name": "Heating Anchor Nav",
  "tag": "section",
  "class": "heating-anchor-nav-section",
  "settings": [
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "nav_background",
      "label": "Navigation background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1F1F1F"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Navigation aria label",
      "default": "Page navigation"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigation item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Why Heated Gear"
        },
        {
          "type": "text",
          "id": "target_id",
          "label": "Anchor target ID",
          "info": "Enter the section ID without #, for example: why-heated-gear",
          "default": "why-heated-gear"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heating Anchor Nav",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "Why Heated Gear",
            "target_id": "why-heated-gear"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Venustas Riding System",
            "target_id": "venustas-riding-system"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Setup Options",
            "target_id": "setup-options"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "How It Works",
            "target_id": "how-it-works"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Riding Guild",
            "target_id": "riding-guild"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "FAQ",
            "target_id": "faq"
          }
        }
      ]
    }
  ]
}
{% endschema %}
