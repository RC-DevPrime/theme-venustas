{% render 'v-talents-base-css', section: section %}
{% render 'v-talents-layout-css', section: section %}

<style>
  #shopify-section-{{ section.id }} .v-talents-share__grid {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .v-talents-share__image {
      order: -1;
    }
    #shopify-section-{{ section.id }} .v-talents-share__socials {
      justify-content: space-between;
  }
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .v-talents-share__grid {
      flex-direction: row;
      align-items: center;
      gap: 5%;
    }

    #shopify-section-{{ section.id }} .v-talents-share__content {
      flex: 0 0 58%;
      order: 1;
    }

    #shopify-section-{{ section.id }} .v-talents-share__image {
      flex: 0 0 37%;
      order: 2;
    }
  }

  #shopify-section-{{ section.id }} .v-talents-share__heading {
    font-size: clamp(26px, 2.8vw, 40px);
    font-weight: 700;
    margin: 0 0 24px;
    color: var(--v-brand);
  }

  #shopify-section-{{ section.id }} .v-talents-share__list {
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    counter-reset: v-share;
  }

  #shopify-section-{{ section.id }} .v-talents-share__list li {
    counter-increment: v-share;
    position: relative;
    padding-left: 24px;
    margin-bottom: 14px;
    font-size: 14px;
    line-height: 1.65;
    color: #444;
  }

  #shopify-section-{{ section.id }} .v-talents-share__list li::before {
    content: counter(v-share) ".";
    position: absolute;
    left: 0;
    font-weight: 700;
    color: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .v-talents-share__social-label {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .v-talents-share__socials {
    display: flex;
    flex-wrap: nowrap;
  }

  #shopify-section-{{ section.id }} .v-talents-share__social-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    flex: 0 0 calc((80% - 96px) / 5);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .v-talents-share__social-item:hover .v-talents-share__social-handle {
    color: var(--v-brand);
  }

  #shopify-section-{{ section.id }} .v-talents-share__social-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 8px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .v-talents-share__social-handle {
    font-size: 12px;
    line-height: 1.3;
    color: #555;
    word-break: normal;
  }
</style>

<div class="v-talents">
  <div class="v-talents-master-container">
    <div class="v-talents-share__grid">
      <div class="v-talents-share__content">
        {%- if section.settings.share_heading != blank -%}
          <h2 class="v-talents-share__heading">{{ section.settings.share_heading }}</h2>
        {%- endif -%}
        <ol class="v-talents-share__list">
          {%- for i in (1..4) -%}
            {%- assign key = 'share_step_' | append: i -%}
            {%- assign step_text = section.settings[key] -%}
            {%- if step_text != blank -%}
              <li>{{ step_text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
        {%- if section.settings.share_social_label != blank -%}
          <p class="v-talents-share__social-label">{{ section.settings.share_social_label }}</p>
        {%- endif -%}
        <div class="v-talents-share__socials">
          {%- for i in (1..5) -%}
            {%- assign icon_key = 'social_' | append: i | append: '_icon' -%}
            {%- assign url_key = 'social_' | append: i | append: '_url' -%}
            {%- assign handle_key = 'social_' | append: i | append: '_handle' -%}
            {%- assign social_icon = section.settings[icon_key] -%}
            {%- assign social_url = section.settings[url_key] -%}
            {%- assign social_handle = section.settings[handle_key] -%}
            {%- if social_icon != blank or social_handle != blank -%}
              <a
                class="v-talents-share__social-item"
                href="{{ social_url | default: '#' }}"
                {% if social_url == blank %}tabindex="-1"{% endif %}
                target="_blank"
                rel="noopener noreferrer"
              >
                {%- if social_icon != blank -%}
                  {{ social_icon | image_url: width: 80 | image_tag: class: 'v-talents-share__social-icon', loading: 'lazy', alt: social_handle }}
                {%- endif -%}
                {%- if social_handle != blank -%}
                  <span class="v-talents-share__social-handle">{{ social_handle }}</span>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="v-talents-share__image">
        {%- if section.settings.share_image != blank -%}
          <div class="v-talents__rounded-img">
            {{
              section.settings.share_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400,600,800,1000,1200',
                sizes: '(min-width: 768px) 45vw, 95vw',
                alt: section.settings.share_image.alt | default: section.settings.share_heading
            }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Talents — Share UGC",
  "tag": "section",
  "class": "venustas-talents-share-section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "brand_color", "label": "Brand color", "default": "#B93205" },
    { "type": "range", "id": "container_width_desktop", "min": 70, "max": 100, "step": 5, "unit": "%", "label": "Desktop container width", "default": 90 },
    { "type": "range", "id": "container_width_mobile", "min": 80, "max": 100, "step": 5, "unit": "%", "label": "Mobile container width", "default": 95 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Desktop padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Desktop padding bottom", "default": 40 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile padding top", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile padding bottom", "default": 24 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "share_heading", "label": "Heading", "default": "How to Share Your UGC?" },
    { "type": "textarea", "id": "share_step_1", "label": "Step 1", "default": "Create authentic content featuring your Venustas product in real outdoor settings." },
    { "type": "textarea", "id": "share_step_2", "label": "Step 2", "default": "Tag @venustas and use our official hashtags in your post caption." },
    { "type": "textarea", "id": "share_step_3", "label": "Step 3", "default": "Submit your post link through the Talent dashboard after publishing." },
    { "type": "textarea", "id": "share_step_4", "label": "Step 4", "default": "Engage with our community posts to boost visibility and earn bonus rewards." },
    { "type": "text", "id": "share_social_label", "label": "Social accounts intro", "default": "Here are our official social media accounts:" },
    { "type": "image_picker", "id": "share_image", "label": "Side image" },
    { "type": "header", "content": "Social account 1" },
    { "type": "image_picker", "id": "social_1_icon", "label": "Icon" },
    { "type": "url", "id": "social_1_url", "label": "Link" },
    { "type": "text", "id": "social_1_handle", "label": "Handle", "default": "@venustas" },
    { "type": "header", "content": "Social account 2" },
    { "type": "image_picker", "id": "social_2_icon", "label": "Icon" },
    { "type": "url", "id": "social_2_url", "label": "Link" },
    { "type": "text", "id": "social_2_handle", "label": "Handle" },
    { "type": "header", "content": "Social account 3" },
    { "type": "image_picker", "id": "social_3_icon", "label": "Icon" },
    { "type": "url", "id": "social_3_url", "label": "Link" },
    { "type": "text", "id": "social_3_handle", "label": "Handle" },
    { "type": "header", "content": "Social account 4" },
    { "type": "image_picker", "id": "social_4_icon", "label": "Icon" },
    { "type": "url", "id": "social_4_url", "label": "Link" },
    { "type": "text", "id": "social_4_handle", "label": "Handle" },
    { "type": "header", "content": "Social account 5" },
    { "type": "image_picker", "id": "social_5_icon", "label": "Icon" },
    { "type": "url", "id": "social_5_url", "label": "Link" },
    { "type": "text", "id": "social_5_handle", "label": "Handle" }
  ],
  "presets": [{ "name": "Talents — Share UGC", "category": "Venustas Talents" }]
}
{% endschema %}
