{% style %}
    .campaign-faqs-section {
        background: #181818;
    }
    .campaign-faqs-section .faqs-inner-section{
        background: #2C2C2C;
        border-radius: 8px 8px 8px 8px;
        padding:2.5rem 1.5rem;
    }
    .campaign-faqs-section .loadMoreFaqbtn {
        cursor:pointer;
        width:fit-content;
        margin:auto;
    }
    .campaign-faqs-section .loadMoreFaqbtn:hover{
        color: #B93205;
    }
    .campaign-faqs-section .accordion-button{
        color:#FFF;
    }
    .campaign-faqs-section .accordion-body{
        color:#A7A7A7 ;
    }
    .campaign-faqs-section .accordion-button:after{
        filter: brightness(0);
    }
    .campaign-faqs-section .accordion-item{
        border-color:#3C3C3C;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .campaign-faqs-section .faqs-inner-section{
            padding: 20px 10px;
        }
        .campaign-faqs-section .accordion-button{
            padding:10px 0px;
        }
        .campaign-faqs-section .accordion-body{
            padding-left:0px;
            padding-right:15px;
            padding-bottom:1rem;
        }
        .campaign-faqs-section .accordion-body{
            font-size:14px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content  
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}>

    <div class="faqs-inner-section">
        <h2 class="pp-bold f-white title-sm text-center pb-lg-5 pb-md-5 pb-sm-3">
            {{ section.settings.heading }}
        </h2>

        <div class="accordion" id="faqAccordion">
        {% for block in section.blocks %}
            {% assign index = forloop.index %}
            <div class="accordion-item {% if forloop.index > 4 %}d-none{% endif %}">
            <h2 class="accordion-header" id="heading-{{ section.id }}-{{ index }}">
                <button 
                class="accordion-button f-white {% unless forloop.first %}collapsed{% endunless %} pp-bold body-lg l-h-normal" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#collapse-{{ section.id }}-{{ index }}" 
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" 
                aria-controls="collapse-{{ section.id }}-{{ index }}">
                {{ block.settings.heading }}
                </button>
            </h2>
            <div 
                id="collapse-{{ section.id }}-{{ index }}" 
                class="accordion-collapse collapse {% if forloop.first %}show{% endif %}" 
                aria-labelledby="heading-{{ section.id }}-{{ index }}" 
                data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    {{ block.settings.body }}
                </div>
            </div>
            </div>
        {% endfor %}
        </div>

        {% if section.blocks.size > 4 %}
        <div class="text-center mt-4">
            <p class="loadMoreFaqbtn pp-regular text-underline f-white">Load More></p>
        </div>
        {% endif %}

    </div>
</div>
{% schema %}
{
    "class": "campaign-faqs-section",
    "name": "Campaign FAQs Section",
    "limit": 1,
    "templates": ["page"],
    "settings": [
        {
            "type": "checkbox",
            "id": "enabled_section_child_scroll",
            "label": "Enabled Section Child Scroll"
        },
        {
            "type": "text",
            "id": "section_scroll_nav",
            "label": "Section Scroll Nav",
            "info": "Need to Enabled first Section Scroll"
        },
        {
            "type": "text",
            "id": "nav_title",
            "label": "Navigation Title"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Frequently asked questions"
        }
    ],
    "blocks": [
        {
            "type": "FAQ",
            "name": "FAQ",
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "richtext",
                    "id": "body",
                    "label": "Body"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Campaign FAQs Section"
        }
    ]
}
{% endschema %}