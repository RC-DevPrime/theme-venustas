<script>
  window.SwymCallbacks = window.SwymCallbacks || [];
  window.SwymCallbacks.push(function(swat) {
    document.querySelectorAll('[data-swym-wishlist-trigger]').forEach(function(trigger) {
      if (trigger.dataset.swymWishlistBound === 'true') return;

      trigger.dataset.swymWishlistBound = 'true';
      trigger.addEventListener('click', function() {
        swat.ui.open();
      });
    });
  });
</script>


