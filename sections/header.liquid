
{% assign announcement_bar_count = 0 %}
{% assign current_timestamp = 'now' | date: '%s' | plus: 0 %}
{% if section.settings.announcement_bar %}
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'announcement_bar' %}
        {% if block.settings.announcement_content != blank %}
          {% assign announcement_bar_count = announcement_bar_count | plus: 1 %}
        {% endif %}
      {% when 'announcement_countdown' %}
        {% assign countdown_timestamp = block.settings.date_time | date: '%s' | plus: 0 %}
        {% if block.settings.date_time != blank and countdown_timestamp > current_timestamp %}
          {% assign announcement_bar_count = announcement_bar_count | plus: 1 %}
        {% endif %}
    {% endcase %}
  {% endfor %}
{% endif %}

<style>
  :root {
    --announcement-height: 37px;
    --announcement-current-height: {% if announcement_bar_count > 0 %}37px{% else %}0px{% endif %};
    --header-nav-height: 40px;
    --headerHeight: calc(var(--header-nav-height) + var(--announcement-current-height));
  }
  @media only screen and (min-width: 768px) and (max-width: 1279px) {
    :root { --header-nav-height: 54.7px; }
  }
  @media only screen and (min-width: 1280px) {
    :root { --header-nav-height: 61.2px; }
  }
</style>

<nav class="header{% if announcement_bar_count > 0 %} has-announcement{% endif %}">
    {% if announcement_bar_count > 0 %}
      <div
        class="announcement-bar"
        style="background:{{ section.settings.background_color }}; --announcement-underline-color: {{ section.settings.underline_text_color }};"
      >
          <div class="container">

              <div class="announcement-bar-layout{% if announcement_bar_count > 1 %} has-navigation{% endif %}">
                  {% if announcement_bar_count > 1 %}
                    <button type="button" class="announcement-nav announcement-prev" style="color:{{ section.settings.text_color }};" aria-label="Previous announcement">
                      <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                    </button>
                  {% endif %}

                  <div class="announcement-bar-slider">
                  <div
                    class="swiper announcement-swiper"
                    data-autoplay-enabled="{{ section.settings.autoplay_enabled }}"
                    data-autoplay="{{ section.settings.autoplay }}"
                  >
                      <div class="swiper-wrapper">

                          {% for block in section.blocks %}
                              {% case block.type %}

                              {% when 'announcement_bar' %}
                                {% if block.settings.announcement_content != blank %}
                                  <div class="swiper-slide">
                                      <div class="announcement-content" style="color:{{ section.settings.text_color }};">
                                        {% if block.settings.link != blank %}
                                          <a href="{{ block.settings.link }}" class="content-link">
                                        {% else %}
                                          <span class="content-link">
                                        {% endif %}
                                          <span class="announcement-marquee-viewport">
                                            <span class="announcement-marquee-track">
                                              <span class="announcement-marquee-item">
                                                {{ block.settings.announcement_content
                                                  | replace: '<p>', ''
                                                  | replace: '</p>', ''
                                                  | replace: '[u]', '<span class="announcement-underline">'
                                                  | replace: '[/u]', '</span>'
                                                  | replace: '【u】', '<span class="announcement-underline">'
                                                  | replace: '【/u】', '</span>'
                                                }}
                                                <span class="arrow-icon">
                                                  <svg width="20" height="14" viewBox="0 0 20 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M1 7H17M17 7L13 3.5M17 7L13 10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                                                  </svg>
                                                </span>
                                              </span>
                                            </span>
                                          </span>
                                        {% if block.settings.link != blank %}
                                          </a>
                                        {% else %}
                                          </span>
                                        {% endif %}
                                      </div>
                                  </div>
                                {% endif %}


                              {% when 'announcement_countdown' %}
                                  {% assign countdown_timestamp = block.settings.date_time | date: '%s' | plus: 0 %}
                                  {% if block.settings.date_time != blank and countdown_timestamp > current_timestamp %}
                                      <div class="swiper-slide countdown-bar" data-set-date="{{ block.settings.date_time }}">
                                          <div class="announcement-content" style="color:{{ section.settings.text_color }};">

                                              <div class="d-flex align-items-center justify-content-center flex-lg-row flex-md-row flex-sm-column gap-lg-4 gap-md-2 gap-sm-2">
                                                  {{ block.settings.announcement_content }}

                                                  <div class="d-flex gap-1">
                                                      <div class="date-time-container d-flex flex-lg-column flex-md-column flex-sm-row gap-lg-0 gap-md-0 gap-sm-1 align-items-center">
                                                          <span class="data-day">00</span> Days
                                                      </div>
                                                      <div class="date-time-container d-flex flex-lg-column flex-md-column flex-sm-row gap-lg-0 gap-md-0 gap-sm-1 align-items-center">
                                                          <span class="data-hours">00</span> Hrs
                                                      </div>
                                                      <div class="date-time-container d-flex flex-lg-column flex-md-column flex-sm-row gap-lg-0 gap-md-0 gap-sm-1 align-items-center">
                                                          <span class="data-minutes">00</span> Mins
                                                      </div>
                                                      <div class="date-time-container d-flex flex-lg-column flex-md-column flex-sm-row gap-lg-0 gap-md-0 gap-sm-1 align-items-center">
                                                          <span class="data-seconds">00</span> Secs
                                                      </div>
                                                  </div>
                                              </div>

                                          </div>
                                      </div>
                                  {% endif %}

                              {% endcase %}
                          {% endfor %}

                      </div> <!-- .swiper-wrapper -->
                  </div> <!-- .announcement-swiper -->
                  </div>

              {% if announcement_bar_count > 1 %}
                    <button type="button" class="announcement-nav announcement-next" style="color:{{ section.settings.text_color }};" aria-label="Next announcement">
                       <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                    </button>
              {% endif %}
              </div>

          </div>

          <button type="button" class="announcement-close d-lg-block d-md-block d-sm-block" aria-label="Close announcement">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
      </div>
    {% endif %}

    <div class="header-wrapper">
      <div class="container d-lg-flex d-md-none d-sm-none justify-content-between">
          <div class="d-flex align-items-center gap-lg-5 gap-md-4"> 
            <div class="logo">
                <a href="/">
                    <img
                        src="{{ section.settings.logo | img_url: 'master' }}"
                        alt="website-logo"
                        width="100%"
                        height="100%"
                        decoding="async"
                        fetchpriority="high"
                    >
                </a>
            </div>
            
            <div class="nav-items">
                {% assign current_path = request.path %}
                {% assign current_full = request.fullpath %}

                {% for link in section.settings.main_menu.links %}
                  {% assign href = link.url %}
                  {% if href contains '#mm' %}
                    {% assign newHref = href | remove: '#mm' %}
                  {% else %}
                    {% assign newHref = link.url %}
                  {% endif %}

                  {%- assign hash_index = link.title | split: '#' -%}
                  {% assign clean_title = hash_index[0] | strip %}
                  {% assign link_tag = '#' | append: hash_index[1] | remove: '#' %}

                  {%- comment -%}
                    🔍 Find the corresponding block link if the menu uses #mm
                  {%- endcomment -%}
                  {% assign block_link = '' %}
                  {% assign has_mega_menu = false %}
                  {% for block in section.blocks %}
                    {% if clean_title == block.settings.menu_tag %}
                      {% assign has_mega_menu = true %}
                      {% assign block_link = block.settings.main_link %}
                    {% endif %}
                  {% endfor %}

                  {%- assign final_link = block_link | default: newHref -%}

                  <a
                    class="nav-item
                      {% if link.active
                        or final_link == current_path
                        or final_link == current_full
                      %}
                        active
                      {% endif %}
                    "
                    href="{{ final_link }}"
                    {% if has_mega_menu or link.links != blank %}
                      data-drop="{{ link.handle }}"
                    {% endif %}
                  >
                    {{ clean_title }}
                    <div class="underline"></div>
                  </a>
                {% endfor %}
            </div>

          </div>
  
          <div class="nav-icons">
              <div class="icon-local d-lg-none d-md-none d-sm-none">
                  {% assign currency_iso = localization.country.currency.iso_code %}
                  {% render 'icon_currency', currency_iso: currency_iso %}
                  <span>
                      {{ localization.country.iso_code }}
                  </span>
  
                  <div class="switcher">
                      <div class="country {% unless request.host contains 'venustas.ca' %}active{% endunless %}" data-href="https://venustas.com/">
                          {% render 'icon_currency', currency_iso: 'USD' %}
                          US
                      </div>
                      <div class="country {% if request.host contains 'venustas.ca' %}active{% endif %}" data-href="https://venustas.ca/">
                          {% render 'icon_currency', currency_iso: 'CAD' %}
                          CA
                      </div>
                  </div>
              </div>
              
              <button type="button" class="nav-icon icon-search" aria-label="Open search">
                <img
                  src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/search-icon.png?v=1763560283"
                  alt="search-icon"
                  loading="lazy"
                  width="24"
                  height="24"
                >
                <span class="pp-regular body-sm">Search</span>
              </button>

              <button type="button" class="nav-icon icon-wishlist" aria-label="Wishlist" data-swym-wishlist-trigger>
                <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8.49634 14.3348C8.24993 14.4218 7.84409 14.4218 7.59768 14.3348C5.49599 13.6173 0.799805 10.6242 0.799805 5.55119C0.799805 3.3118 2.60436 1.5 4.82925 1.5C6.14824 1.5 7.31504 2.13775 8.04701 3.12337C8.77898 2.13775 9.95303 1.5 11.2648 1.5C13.4897 1.5 15.2942 3.3118 15.2942 5.55119C15.2942 10.6242 10.598 13.6173 8.49634 14.3348Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <a href="{{ routes.account_url }}" class="nav-icon icon-user {% if request.path == '/account' %}active{% endif %}" aria-label="Account">
                <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="5" y="1" width="6" height="6" rx="3" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M14.6213 13.0483C15.0325 14.0735 14.1055 15 13.001 15C11.7304 15 9.95919 15 8 15C6.04081 15 4.26961 15 2.99902 15C1.89445 15 0.967456 14.0735 1.37867 13.0483C2.32353 10.6927 4.93114 9 8 9C11.0689 9 13.6765 10.6927 14.6213 13.0483Z" stroke="currentColor" stroke-width="1.2"/>
                </svg>
              </a>

              <button type="button" class="nav-icon icon-cart  {% if request.path == '/cart' %}active{% endif %}" aria-label="Open cart">
                <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2.76874 1.981L14.4155 3.12748C14.9609 3.18117 15.3615 3.66387 15.3137 4.20983L15.1056 6.58788C15.0663 7.03689 14.7315 7.40412 14.2881 7.48464L4.71495 9.22277M0.746094 0.600098L1.9143 0.842866C2.30099 0.923224 2.60415 1.22365 2.68803 1.60959L4.90459 11.8092C5.00449 12.2689 5.41133 12.5969 5.88178 12.5969H15.1783" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  <circle cx="4.85026" cy="14.9645" r="0.6" fill="currentColor" stroke="currentColor" stroke-width="0.852078"/>
                  <circle cx="12.4269" cy="14.9645" r="0.6" fill="currentColor" stroke="currentColor" stroke-width="0.852078"/>
                </svg>
                <span
                  class="dot"
                  {% if cart.item_count == 0 %}
                    style="display:none"
                  {% else %}
                    style="display:flex;"
                  {% endif %}
                >
                  {{ cart.item_count }}
                </span>

              </button>

              
              <div class="language-selector-container">
                  <div class="language-selector">
                      <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/47418_2x_79fee34e-897e-40a2-ae59-9fbf71aa792f.png?v=1758130779" alt="flag-icon">
                      <span class="pp-regular body f-black">
                          US
                      </span>
                      <i class="fa-solid fa-chevron-down f-black"></i>
                  </div>
                  <div class="language-dropdown" style="display:none;">
                    <div class="language-item active">
                      <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/47418_2x_79fee34e-897e-40a2-ae59-9fbf71aa792f.png?v=1758130779"  alt="flag-icon">
                      <span class="pp-regular body f-black">
                          US
                      </span>
                    </div>

                    <a href="https://venustas.ca/" class="language-item">
                      <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/47457_2x_8d8e549f-d9b8-4385-9446-8560729eacaf.png?v=1758463194"  alt="flag-icon">
                      <span class="pp-regular body f-black">
                          CA
                      </span>
                    </a>

                  </div>

              </div>

          </div>
  
      </div>
    </div>

    <div class="header-wrapper-mobile">
      <div class="container d-lg-none d-md-flex d-sm-flex justify-content-between ">
        <div class="h-auto d-flex align-items-center gap-3 flex-1">
            <!-- Hamburger Menu Button -->
            <button
                type="button"
                class="nav-toggle"
                aria-label="Open menu"
                aria-controls="accordion-menu"
                aria-expanded="false"
            >
                <img
                    src="https://cdn.shopify.com/s/files/1/0474/8365/0202/files/humber-icon.png?v=1752557121"
                    class="humburger-icon"
                    alt="Menu"
                    decoding="async"
                    fetchpriority="high"
                    style="width: 24px; height: auto; object-fit: contain;"
                >
            </button>


        </div>
        
        <!-- Logo -->
        <div class="logo">
            <a href="/">
                <img
                    src="{{ section.settings.logo | img_url: 'master' }}"
                    alt="website-logo"
                    width="100%"
                    height="100%"
                    decoding="async"
                    fetchpriority="high"
                >
            </a>
        </div>
        <div class="nav-icons  flex-1">
            <button
              type="button"
              class="nav-icon icon-gift d-lg-none d-md-flex d-sm-flex"
              aria-label="Open gift"
            >
              <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M16.6665 9.99984V18.3332H3.33317V9.99984M9.99984 18.3332V5.83317M9.99984 5.83317H6.24984C5.6973 5.83317 5.1674 5.61368 4.7767 5.22298C4.386 4.83228 4.1665 4.30237 4.1665 3.74984C4.1665 3.1973 4.386 2.6674 4.7767 2.2767C5.1674 1.886 5.6973 1.6665 6.24984 1.6665C9.1665 1.6665 9.99984 5.83317 9.99984 5.83317ZM9.99984 5.83317H13.7498C14.3024 5.83317 14.8323 5.61368 15.223 5.22298C15.6137 4.83228 15.8332 4.30237 15.8332 3.74984C15.8332 3.1973 15.6137 2.6674 15.223 2.2767C14.8323 1.886 14.3024 1.6665 13.7498 1.6665C10.8332 1.6665 9.99984 5.83317 9.99984 5.83317ZM1.6665 5.83317H18.3332V9.99984H1.6665V5.83317Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <button type="button" class="nav-icon icon-wishlist" aria-label="Wishlist" data-swym-wishlist-trigger>
              <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8.49634 14.3348C8.24993 14.4218 7.84409 14.4218 7.59768 14.3348C5.49599 13.6173 0.799805 10.6242 0.799805 5.55119C0.799805 3.3118 2.60436 1.5 4.82925 1.5C6.14824 1.5 7.31504 2.13775 8.04701 3.12337C8.77898 2.13775 9.95303 1.5 11.2648 1.5C13.4897 1.5 15.2942 3.3118 15.2942 5.55119C15.2942 10.6242 10.598 13.6173 8.49634 14.3348Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <button type="button" class="nav-icon icon-cart" aria-label="Open cart">
                <svg aria-hidden="true" focusable="false" width="1em" height="1em" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2.76874 1.981L14.4155 3.12748C14.9609 3.18117 15.3615 3.66387 15.3137 4.20983L15.1056 6.58788C15.0663 7.03689 14.7315 7.40412 14.2881 7.48464L4.71495 9.22277M0.746094 0.600098L1.9143 0.842866C2.30099 0.923224 2.60415 1.22365 2.68803 1.60959L4.90459 11.8092C5.00449 12.2689 5.41133 12.5969 5.88178 12.5969H15.1783" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  <circle cx="4.85026" cy="14.9645" r="0.6" fill="currentColor" stroke="currentColor" stroke-width="0.852078"/>
                  <circle cx="12.4269" cy="14.9645" r="0.6" fill="currentColor" stroke="currentColor" stroke-width="0.852078"/>
                </svg>
              <span
                class="dot"
                {% if cart.item_count == 0 %}
                  style="display:none"
                {% else %}
                  style="display:flex;"
                {% endif %}
              >
                {{ cart.item_count }}
              </span>
            </button>

        </div>
      </div>
    </div>


    <div class="drops">
        {% for link in section.settings.main_menu.links %}
            {%- assign hash_index = link.title | split: '#' -%}
            {% assign clean_title = hash_index[0] | strip %}
            {% assign has_mega_menu = false %}
            {% for block in section.blocks %}
                {% if clean_title == block.settings.menu_tag %}
                    {% assign has_mega_menu = true %}
                {% endif %}
            {% endfor %}

            {% if link.links != blank %}
                <div class="drop drop1 dropdown-menu" data-drop="{{ link.handle }}">
                    {% for item in link.links %}
                        <div class="menu-item">
                            <a class="item" href="{{ item.url }}" {% if item.links != blank %}data-drop="{{ item.handle }}"{% endif %}>
                                <span class="body pp-medium">
                                    {{ item.title }}
                                </span>
                                {% if item.links != blank %}
                                    <i class="fa-solid fa-chevron-right"></i>
                                {% endif %}
                            </a>
                            {% if item.links != blank %}
                                <div class="drop drop2" data-drop="{{ item.handle }}">
                                    {% for sub_item in item.links %}
                                        <a class="item" href="{{ sub_item.url }}">
                                            <span class="body pp-medium">
                                                {{ sub_item.title }}
                                            </span>
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if has_mega_menu %}
              
                <div class="mega-menu drop drop1" data-drop="{{ link.handle }}">
                    <div class="overlay">
                    </div>
                    <div class="inner-mega-menu">
                        <div class="container">
                              {% for block in section.blocks %}
    
                                {% render 'mega-menu', link_title: link.title, block: block %}
                              
                              {% endfor %}
                        </div>
                    </div>
                </div>
      
            {% endif %}

        {% endfor %}
    </div>

  
    <div class="nav-mobile">
      <div class="nav-overlay"></div>
      <div class="main-nav-content">
        <div class="btn-mav-close">
            <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/close-nav-mobile.png?v=1761785925" width="100%" height="100%">
        </div>
        <div class="inner-nav-content">
          <div class="h-100">
          <div class="wrapper">
              <div class="nav-search-bar-container">
                
                  <form action="{{ routes.search_url }}" method="get" role="search" class="w-100">
                      <div class="input-group w-100 position-relative">
                          <button type="submit">
                              <img src="https://cdn.shopify.com/s/files/1/0474/8365/0202/files/search-icon.png?v=1747637649" class="icon" style="filter: invert(1);">
                          </button>
                          <input  id="Search" 
                                  type="search" 
                                  name="q" 
                                  value="{{ search.terms | escape }}" 
                                  aria-expanded="false"
                                  aria-owns="predictive-search-results"
                                  aria-controls="predictive-search-results"
                                  aria-haspopup="listbox"
                                  aria-autocomplete="list" placeholder="Search"
                                  class="w-100">
                      </div>
                  </form>
              </div>
              {% comment %} <div class="d-flex justify-content-end pb-3">
                <a href="#" class="pp-semibold body f-main">
                  View All >
                </a>
              </div> {% endcomment %}
              
              <div class="accordion" id="accordion-menu">
                  {% for link in section.settings.main_menu.links %}

                      {% assign href = link.url %}
                      {% if href contains '#mm' %}
                          {% assign newHref = href | remove: '#mm' %}
                      {% else %}
                          {% assign newHref = link.url %}
                      {% endif %}

                

                      {%- assign hash_index = link.title | split: '#' -%}
                      {% assign clean_title = hash_index[0] | strip %}
                      {% assign link_tag = '#' | append: hash_index[1] | remove: '#' %}
                      {% assign has_mega_menu = false %}
                      {% assign mega_menu_block_type = '' %}
                      {% for block in section.blocks %}
                        {% if clean_title == block.settings.menu_tag %}
                          {% assign has_mega_menu = true %}
                          {% assign mega_menu_block_type = block.type %}
                        {% endif %}
                      {% endfor %}
      
                      <div class="accordion-item">
                          {% if has_mega_menu %}
                            {% for block in section.blocks %}
                                {% if clean_title == block.settings.menu_tag %}
                                  {% if block.type == 'dislay_1' or block.type == 'dislay_2' or block.type == 'dislay_3' or block.type == 'dislay_4' or block.type == 'dislay_5'  %} 
                                    <span class="f-layer">
                                      <button data-mega="{{ clean_title | handleize }}">
                                          <span class="d-flex align-items-center gap-1">
                                              {{ clean_title }}
                                              {% if link_tag != blank %}
                                                  <span class="link-tag">{{ link_tag }}</span>
                                                {% endif %}
                                          </span>
                                          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M4.5 9L7.5 6L4.5 3" stroke-width="2" stroke-linecap="round" stroke="#989898"/>
                                          </svg>
                                      </button>
                                    </span>
                                  {% else %}
                                    <h2 class="accordion-header" id="heading-menu-{{ clean_title | handleize }}">
