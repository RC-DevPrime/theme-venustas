{% style %}
    .collection-faqs-section .faqs-inner-section{
        background: #F9F9F9;
        border-radius: 8px 8px 8px 8px;
        padding:2.5rem 1.5rem;
    }
    .collection-faqs-section .loadMoreFaqbtn {
        cursor:pointer;
        width:fit-content;
        margin:auto;
    }
    .collection-faqs-section .loadMoreFaqbtn:hover{
        color: #B93205;
    }
    
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .collection-faqs-section .faqs-inner-section{
            padding: 20px 10px;
        }
        .collection-faqs-section .accordion-button{
            padding:10px 0px;
        }
        .collection-faqs-section .accordion-body{
            padding-left:0px;
            padding-right:15px;
            padding-bottom:1rem;
        }
        .collection-faqs-section .accordion-body{
            font-size:14px;
        }
    }
{% endstyle %}
<div class="container section-content">
    <div class="faqs-inner-section">
        <h2 class="pp-bold title-sm text-center pb-lg-5 pb-md-5 pb-sm-3">
            {{ section.settings.heading }}
        </h2>

        <div class="accordion" id="faqAccordion">
        {% for block in section.blocks %}
            {% assign index = forloop.index %}
            <div class="accordion-item {% if forloop.index > 4 %}d-none{% endif %}">
            <h2 class="accordion-header" id="heading-{{ section.id }}-{{ index }}">
                <button 
                class="accordion-button {% unless forloop.first %}collapsed{% endunless %} pp-bold body-lg l-h-normal" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#collapse-{{ section.id }}-{{ index }}" 
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" 
                aria-controls="collapse-{{ section.id }}-{{ index }}">
                {{ block.settings.heading }}
                </button>
            </h2>
            <div 
                id="collapse-{{ section.id }}-{{ index }}" 
                class="accordion-collapse collapse {% if forloop.first %}show{% endif %}" 
                aria-labelledby="heading-{{ section.id }}-{{ index }}" 
                data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                {{ block.settings.body }}
                </div>
            </div>
            </div>
        {% endfor %}
        </div>

        {% if section.blocks.size > 4 %}
        <div class="text-center mt-4">
            <p class="loadMoreFaqbtn pp-regular text-underline">Load More></p>
        </div>
        {% endif %}

    </div>
</div>
{% schema %}
{
    "class": "collection-faqs-section",
    "name": "FAQs Section",
    "limit": 1,
    "templates": ["collection"],
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Frequently asked questions"
        }
    ],
    "blocks": [
        {
            "type": "FAQ",
            "name": "FAQ",
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "richtext",
                    "id": "body",
                    "label": "Body"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "FAQs Section"
        }
    ]
}
{% endschema %}