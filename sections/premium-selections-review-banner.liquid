{% style %}
    .premium-selections-event-banner-section .reward-event-item{
        border-radius:16px;
        overflow:hidden;
    }
{% endstyle %}
<div class="container section-content">

    <div class="reward-event-item" style="background-color: {{ section.settings.backgroung_color }}"  data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="150" data-aos-duration="500">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="featured-image">
                    <img src="{{ section.settings.image | img_url: '1400x1400' }}" width="100%" height="100%">
                </div>    
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="h-100 d-flex align-items-center col-lg-10 col-md-10 col-sm-12 mx-auto">
                    <div class="content-container px-lg-0 px-md-0 px-sm-3 py-lg-0 py-md-0 py-sm-5">
                        <h3 class="block-heading pp-bold title-sm pb-3 d-lg-block d-md-block d-sm-none" style="color:{{ section.settings.heading_color }}">
                            {{ section.settings.heading }}
                        </h3>
                        <h3 class="block-heading pp-bold body-xl pb-2 d-lg-none d-md-none d-sm-block" style="color:{{ section.settings.heading_color }}">
                            {{ section.settings.heading }}
                        </h3>
                        <div class="block-description pp-regular body-lg  {% if section.settings.btn_label != blank %} pb-3{% endif %} d-lg-block d-md-block d-sm-none" style="color:{{ section.settings.description_color }}">
                            {{ section.settings.desceription }}
                        </div>
                        <div class="block-description pp-regular body  {% if section.settings.btn_label != blank %} pb-3{% endif %} d-lg-none d-md-none d-sm-block" style="color:{{ section.settings.description_color }}">
                            {{ section.settings.desceription }}
                        </div>
                        {% if section.settings.btn_label != blank %}
                            <a href="{{ section.settings.btn_link }}" class="btn-hover btn-black py-lg-2 py-md-2 py-sm-1 px-lg-4 px-md-4 px-sm-3"> 
                                <span class="pp-regular body">
                                    {{ section.settings.btn_label }}
                                </span>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{% schema %}
    {
        "class": "premium-selections-event-banner-section",
        "name": "Premium Event Banner",
        "templates": ["page"],
        "settings": [
            {
                "type": "color",
                "id": "backgroung_color",
                "label": "Background Color",
                "default": "#F9F6EF"
            },
            {
                "type": "image_picker",
                "id": "image",
                "label": "Image"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Heading"
            },
            {
                "type": "color",
                "id": "heading_color",
                "label": "Heading Color",
                "default": "#000000"
            },
            {
                "type": "richtext",
                "id": "desceription",
                "label": "Description",
                "default": "<p>Description</p>"
            },
            {
                "type": "color",
                "id": "description_color",
                "label": "Description Color",
                "default": "#000000"
            },
            {
                "type": "text",
                "id": "btn_label",
                "label": "Button Label",
                "default": "Learn More"
            },
            {
                "type": "url",
                "id": "btn_link",
                "label": "Button Link"
            },
        ],
        "presets" :[{
            "name" : "Premium Event Banner"
        }]
    }
  {% endschema %} 