{% style %}
  #shopify-section-{{ section.id }} .motorheating-launch-signup {
    position: relative;
    width: 100%;
    aspect-ratio: 1440 / 220;
    min-height: 180px;
    overflow: hidden;
    background: var(--venustas-black);
    color: #fff;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .motorheating-launch-signup__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .motorheating-launch-signup__bg--mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .motorheating-launch-signup__inner {
    position: relative;
    z-index: 1;
    width: min(100% - 40px, 1340px);
    height: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 275px) minmax(0, 360px) minmax(0, 530px);
    align-items: center;
    gap: 0;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .motorheating-launch-signup__copy {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-launch-signup__logo {
    width: auto;
    max-width: 150px;
    max-height: 32px;
    display: block;
    margin-bottom: 32px;
    object-fit: contain;
    object-position: left center;
  }

  #shopify-section-{{ section.id }} .motorheating-launch-signup__title {
    margin: 0;
    color: #fff;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .motorheating-launch-signup__description {
    max-width: 330px;
    padding-left: 24px;
    border-left: 1px solid rgba(255, 255, 255, 0.72);
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-launch-signup__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-launch-signup__form {
    min-width: 0;
    padding-left: 18px;
  }

  #shopify-section-{{ section.id }} .motorheating-launch-signup__form .klaviyo-form-UkBhX6 {
    width: 100%;
  }

  @media only screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .klaviyo-form-UkBhX6 form[data-testid="klaviyo-form-UkBhX6"] > div {
      width: auto !important;
      flex-direction: row !important;
      align-items: center !important;
      gap: 8px !important;
    }

    #shopify-section-{{ section.id }} .klaviyo-form-UkBhX6 [data-testid="form-row"],
    #shopify-section-{{ section.id }} .klaviyo-form-UkBhX6 [data-testid="form-component"] {
      width: auto !important;
      flex: 0 0 auto !important;
    }

    #shopify-section-{{ section.id }} .klaviyo-form-UkBhX6 .klaviyo-emailinput,
    #shopify-section-{{ section.id }} .klaviyo-form-UkBhX6 input[type="email"] {
      width: 256px !important;
    }

    #shopify-section-{{ section.id }} .klaviyo-form-UkBhX6 input[type="email"],
    #shopify-section-{{ section.id }} .klaviyo-form-UkBhX6 .klaviyo-form-button {
      height: 48px !important;
      box-sizing: border-box !important;
    }

    #shopify-section-{{ section.id }} .klaviyo-form-UkBhX6 .klaviyo-form-button {
      width: 230px !important;
      min-width: 230px !important;
    }
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .motorheating-launch-signup {
      aspect-ratio: 390 / 322;
      min-height: 322px;
    }

    #shopify-section-{{ section.id }} .motorheating-launch-signup__bg--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .motorheating-launch-signup__bg--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .motorheating-launch-signup__inner {
      width: 100%;
      padding: 28px 20px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .motorheating-launch-signup__logo {
      max-width: 150px;
      max-height: 30px;
      margin-bottom: 22px;
    }

    #shopify-section-{{ section.id }} .motorheating-launch-signup__title {
      font-size: 24px;
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .motorheating-launch-signup__description {
      max-width: none;
      margin: 16px 0 12px;
      padding-left: 0;
      border-left: 0;
      font-size: 16px;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .motorheating-launch-signup__form {
      width: 100%;
      padding-left: 0;
    }
  }
{% endstyle %}

<section class="motorheating-launch-signup">
  {%- if section.settings.bg_desktop != blank -%}
    {{
      section.settings.bg_desktop
      | image_url: width: 2880
      | image_tag:
        class: 'motorheating-launch-signup__bg motorheating-launch-signup__bg--desktop',
        loading: 'lazy',
        widths: '720,960,1200,1440,1800,2400,2880',
        sizes: '100vw',
        alt: section.settings.bg_desktop.alt | default: section.settings.title
    }}
  {%- endif -%}

  {%- if section.settings.bg_mobile != blank -%}
    {{
      section.settings.bg_mobile
      | image_url: width: 900
      | image_tag:
        class: 'motorheating-launch-signup__bg motorheating-launch-signup__bg--mobile',
        loading: 'lazy',
        widths: '390,600,780,900',
        sizes: '100vw',
        alt: section.settings.bg_mobile.alt | default: section.settings.title
    }}
  {%- elsif section.settings.bg_desktop != blank -%}
    {{
      section.settings.bg_desktop
      | image_url: width: 900
      | image_tag:
        class: 'motorheating-launch-signup__bg motorheating-launch-signup__bg--mobile',
        loading: 'lazy',
        widths: '390,600,780,900',
        sizes: '100vw',
        alt: section.settings.bg_desktop.alt | default: section.settings.title
    }}
  {%- endif -%}

  <div class="motorheating-launch-signup__inner">
    <div class="motorheating-launch-signup__copy">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 300
          | image_tag:
            class: 'motorheating-launch-signup__logo',
            loading: 'lazy',
            widths: '120,180,240,300',
            sizes: '150px',
            alt: section.settings.logo.alt | default: 'Venustas'
        }}
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="motorheating-launch-signup__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    {%- if section.settings.description != blank -%}
      <div class="motorheating-launch-signup__description">{{ section.settings.description }}</div>
    {%- endif -%}

    <div class="motorheating-launch-signup__form">
      <div class="klaviyo-form-UkBhX6"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Launch Signup",
  "tag": "section",
  "class": "motorheating-launch-signup-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Venustas logo"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "BE THE FIRST TO RIDE WARMER"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Join the launch list and get early access, exclusive offers, and launch bonuses.</p>"
    },
    {
      "type": "image_picker",
      "id": "bg_desktop",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "bg_mobile",
      "label": "Mobile background image"
    }
  ],
  "presets": [
    {
      "name": "Launch Signup"
    }
  ]
}
{% endschema %}
