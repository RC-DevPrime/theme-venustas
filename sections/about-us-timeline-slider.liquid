{% style %}
.about-us-timeline-slider-section {
    position: relative;
    width: 100%;
    height: calc(100vh * {{ section.blocks.size }}); /* keep this as is */
}

.about-us-timeline-slider-section .sticky-slider {
    position: sticky;
    top: 0;
    height: 100vh; /* will be updated by JS */
    overflow: hidden;
}

.about-us-timeline-slider-section .timeline-slider-container {
    width: 100%;
    height: 100%;
}

.about-us-timeline-slider-section .timeline-slider-container .banner-item {
    height: 100vh; /* will be updated by JS */
    position:relative;
}

.about-us-timeline-slider-section .timeline-slider-container .banner-item .banner-content-container{
    position:absolute;
    width:100%;
    height:100%;
    top:0;
}
.about-us-timeline-slider-section .timeline-slider-container .banner-item .banner-content-container .row{
    --bs-gutter-x: 80px;
}
.about-us-timeline-slider-section .timeline-slider-container .banner-item .banner-content{
    position:absolute;
    top:0;
    height:100%;
    width:100%;
}

.about-us-timeline-slider-section .timeline-slider-container .banner-item .banner-content .element-image{
    height:380px;
    overflow:hidden;
    border-radius:6px;
}
.about-us-timeline-slider-section .timeline-slider-container .banner-item .banner-content .element-image img{
    height:100%;
    width:100%;
    object-fit:cover;
}
.about-us-timeline-slider-section .timeline-slider-container .banner-item .bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.about-us-timeline-slider-section .timeline-slider-container .banner-item .block-content-container{
    transform: translateY(12vh);
    transition: all 0.3s linear 0.2s;
    opacity:0.3;
}
.about-us-timeline-slider-section .timeline-slider-container .banner-item.swiper-slide-active .block-content-container{
    transform: translateY(0);
    opacity:1;
}
.about-us-timeline-slider-section .swiper-pagination-timeline{
    position: fixed;
    top: 18%;
    left: 16%;
    height: 70vh;
    z-index: 1;
}
.about-us-timeline-slider-section .swiper-pagination-timeline img{
    object-fit:contain;
    height:100%;
    width:100%;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination{
    position: absolute;
    top: 0;
    transform: unset;
    padding: 0;
    margin: 0;
    height: 100%;
    width:100%;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination span{
    margin: 0;
    padding: 0;
    background: transparent;
    width: 18px;
    height: 18px;
    outline: 1px solid #fff;
    position:absolute;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination span:nth-child(1){
    top:3%;
    left: 49%;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination span:nth-child(2){
    top: 17%;
    left: 11%;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination span:nth-child(3){
    top: 32%;
    left: 60%;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination span:nth-child(4){
    top: 50%;
    left: 86%;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination span:nth-child(5){
    top: 64%;
    left: 19%;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination span:nth-child(6){
    top: 79%;
    left: 4%;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination span:nth-child(7){
    top: 93%;
    left: 57%;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination span.swiper-pagination-bullet-active{
    background:#FFF;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination span .year-tag{
    position: absolute;
    top: -15%;
    left: 100%;
    margin-left: 15px;
    white-space: nowrap;
}
.about-us-timeline-slider-section .swiper-pagination-timeline .swiper-pagination span.swiper-pagination-bullet-active .year-tag{
    font-weight:bold !important;
}
.about-us-timeline-slider-section .swiper-pagination-timeline{
    opacity: 0;
    pointer-events: none;
    transition:.3s ease;
}

.about-us-timeline-slider-section .swiper-pagination-timeline.visible-pagination-timeline{
    opacity: 1;
    pointer-events: auto;
}

.banner-content-container .block-description p{
    margin-bottom:10px;
}


.timeline-content-container {
    opacity: 0;
    transform: translateY(150px);
    transition: opacity 0.6s ease, transform 0.6s ease;
}
.timeline-content-container .content-timeline{
    position:relative;
    overflow-y:auto;
    -webkit-overflow-scrolling:touch;
    padding-right:8px;
    padding-bottom:36px;
    scrollbar-width:none;
    -ms-overflow-style:none;
}
.timeline-content-container .content-timeline::-webkit-scrollbar{
    display:none;
}
.timeline-content-container .content-timeline.has-overflow::after{
    content:"";
    position:absolute;
    left:0;
    right:8px;
    bottom:0;
    height:64px;
    background:linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.06) 55%, rgba(255, 255, 255, 0.14) 100%);
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
    mask-image:linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.75) 45%, #000 100%);
    -webkit-mask-image:linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.75) 45%, #000 100%);
    border-radius:0 0 6px 6px;
    pointer-events:none;
    opacity:1;
    transition:opacity 0.25s ease;
}
.timeline-content-container .content-timeline.has-overflow::before{
    content:"More below";
    position:absolute;
    left:0;
    right:8px;
    bottom:12px;
    font-size:12px;
    line-height:1;
    letter-spacing:0.16em;
    text-transform:uppercase;
    color:rgba(255, 255, 255, 0.96);
    font-weight:600;
    text-align:center;
    text-shadow:0 2px 12px rgba(0, 0, 0, 0.42);
    pointer-events:none;
    opacity:1;
    animation:timeline-scroll-hint 1.6s ease-in-out infinite;
    transition:opacity 0.25s ease;
    z-index:2;
}
.timeline-content-container .content-timeline.is-scrolled::before{
    animation:none;
    opacity:0;
}
.timeline-content-container .content-timeline.is-scrolled::after{
    opacity:0;
}
.timeline-content-container .content-timeline.is-at-bottom::before{
    animation:none;
}
.timeline-content-container .content-timeline.is-at-bottom::before,
.timeline-content-container .content-timeline.is-at-bottom::after{
    opacity:0;
}
@keyframes timeline-scroll-hint {
    0% {
        transform:translateY(0);
        opacity:0.68;
    }
    50% {
        transform:translateY(-8px);
        opacity:1;
    }
    100% {
        transform:translateY(0);
        opacity:0.68;
    }
}
.timeline-content-container.fade-in {
    opacity: 1;
    transform: translateY(0);
}

