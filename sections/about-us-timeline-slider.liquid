{% endstyle %}
<div class="about-us-timeline-slider-section 
    {% if section.settings.nav_title != blank %} about-us-section-scroll
    {% else %}
    {% if section.settings.enabled_section_child_scroll %} about-us-section-scroll
    {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}>
    <div class="swiper-pagination-timeline">
        <div class="position-relative h-100">
            <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/timeline-line.png?v=1762382204" width="100%" height="100%" class="timeline-line d-lg-block d-md-block d-sm-none">
            <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/77614_2x_b7eec1b5-2df1-44a2-9699-3d1252329f5a.png?v=1762385382" width="100%" height="100%" class="timeline-line d-lg-none d-md-none d-sm-block">
            <div class="swiper-pagination"> 

            </div>
        </div>

    </div>
    <div class="sticky-slider">
        <div class="timeline-slider-container">
            <div class="swiper-wrapper">
                {% for block in section.blocks %}
                    {% assign is_odd = forloop.index0 | modulo: 2 %}
                    <div class="banner-item swiper-slide
                        {% if block.settings.nav_title != blank %} about-us-section-scroll
                        {% elsif block.settings.enabled_section_child_scroll %} about-us-section-scroll
                        {% endif %}"
                        {% if block.settings.nav_title != blank %}
                        data-scroll="{{ block.settings.nav_title | handleize }}"
                        {% endif %}
                        {% if block.settings.enabled_section_child_scroll %}
                        data-child-scroll="{{ block.settings.section_scroll_nav | handleize }}"
                        {% endif %} timeline-year="{{ block.settings.year }}">

                        <img
                        src="{{ block.settings.background_image | img_url: 'master' }}"
                        alt="{{ block.settings.background_image.alt }}"
                        class="bg-image d-lg-block d-md-block d-sm-none"
                        width="100%" height="100%">
                        <img
                        src="{{ block.settings.background_image_mobile | img_url: 'master' }}"
                        alt="{{ block.settings.background_image_mobile.alt }}"
                        class="bg-image d-lg-none d-md-none d-sm-block"
                        width="100%" height="100%">

                        <div class="banner-content-container">
                            <div class="container section-content h-100">
                                <!-- width wrapper instead of putting col-* on .row -->
                                <div class="mx-auto col-12 col-sm-12 col-md-10 col-lg-10 h-100" >
                                    <div class="timeline-content-container row h-100 align-items-center">
                                        <!-- Text column -->
                                        <div class="
                                        col-lg-8 col-md-8 col-sm-12
                                        {% if is_odd == 1 %} order-md-2 order-lg-2{% endif %}
                                        ">
                                        
                                            <div class="element-image d-lg-none d-md-none d-sm-flex">
                                                <img
                                                src="{{ block.settings.image | img_url: 'master' }}"
                                                alt="{{ block.settings.image.alt }}"
                                                class="bg-image {% if block.settings.image_mobile %}d-lg-block d-md-block d-sm-none{% endif %}"
                                                width="100%" height="100%">
                                                
                                                {% if block.settings.image_mobile %}
                                                    <img
                                                    src="{{ block.settings.image_mobile | img_url: 'master' }}"
                                                    alt="{{ block.settings.image_mobile.alt }}"
                                                    class="bg-image d-lg-none d-md-none d-sm-block"
                                                    width="100%" height="100%">
                                                {% endif %}

                                            </div>
                                            <div class="content-timeline">
                                                <div class="block-heading pp-bold f-white pb-lg-3 pb-md-3 pb-sm-2 mt-lg-0 mt-md-0 mt-sm-4">
                                                    <span class="title-md d-lg-block d-md-block d-sm-none">
                                                        {{ block.settings.heading }}
                                                    </span>
                                                    <span class="title-sm d-lg-none d-md-none d-sm-block">
                                                        {{ block.settings.heading }}
                                                    </span>
                                                </div>
                                                <div class="block-description pp-regular f-white">
                                                    <span class="body-lg d-lg-block d-md-block d-sm-none">
                                                        {{ block.settings.description }}
                                                    </span>
                                                    <span class="body d-lg-none d-md-none d-sm-block">
                                                        {{ block.settings.description }}
                                                    </span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Image column -->
                                        <div class="
                                            col-lg-4 col-md-4 col-sm-12
                                            {% if is_odd == 1 %} order-md-1 order-lg-1{% endif %}
                                            ">
                                            <div class="element-image d-lg-block d-md-block d-sm-none">
                                                <img
                                                src="{{ block.settings.image | img_url: 'master' }}"
                                                alt="{{ block.settings.image.alt }}"
                                                class="bg-image {% if block.settings.image_mobile %}d-lg-block d-md-block d-sm-none{% endif %}"
                                                width="100%" height="100%">

                                                {% if block.settings.image_mobile %}
                                                    <img
                                                    src="{{ block.settings.image_mobile | img_url: 'master' }}"
                                                    alt="{{ block.settings.image_mobile.alt }}"
                                                    class="bg-image d-lg-none d-md-none d-sm-block"
                                                    width="100%" height="100%">
                                                {% endif %}

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}

            </div>
        </div>
    </div>
</div>
{% schema %}
    {
        "name": "Timeline Slider",
        "templates": ["page"],
        "limit": 1, 
        "max_blocks": 7,
        "settings": [
            {
                "type": "checkbox",
                "id": "enabled_section_child_scroll",
                "label": "Enabled Section Child Scroll"
            },
            {
                "type": "text",
                "id": "section_scroll_nav",
                "label": "Section Scroll Nav",
                "info": "Need to Enabled first Section Scroll"
            },
            {
                "type": "text",
                "id": "nav_title",
                "label": "Navigation Title"
            },
        ],
        "blocks": [
            {
              "type": "Banner",
              "name":"Banner",
              "settings": [
                    {
                        "type": "text",
                        "id": "year",
                        "label": "Year"
                    },
                    {
                        "type": "image_picker",
                        "id": "background_image",
                        "label": "Background Image"
                    },
                    {
                        "type": "image_picker",
                        "id": "background_image_mobile",
                        "label": "Background Image - Mobile"
                    },
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    },
                    {
                        "type": "image_picker",
                        "id": "image_mobile",
                        "label": "Image - Mobile"
                    },
                    {
                        "type": "text",
                        "id": "heading",
                        "label": "Heading"
                    },
                    {
                        "type": "richtext",
                        "id": "description",
                        "label": "Description"
                    }
              ]
            }
        ],
        "presets" :[{
            "name" : "Timeline Slider"
        }]
    }
  {% endschema %} 
