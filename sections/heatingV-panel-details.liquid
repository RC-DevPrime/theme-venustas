{% style %}
  #shopify-section-{{ section.id }} .heatingv-panel-details {
    width: 100%;
    overflow: hidden;
    background: #fff;
    color: var(--venustas-black, #14161a);
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__inner {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 100px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 44px;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__title {
    margin: 0;
    color: var(--venustas-black, #14161a);
    font-size: 34px;
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.952px;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__description {
    margin: 0;
    color: #565b63;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.72;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__media {
    position: relative;
    height: 360px;
    overflow: hidden;
    border-radius: 6px;
    background: #f0f0f0;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__picture,
  #shopify-section-{{ section.id }} .heatingv-panel-details__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__image {
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    color: #565b63;
    font-size: 12px;
    line-height: 1.4;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__item-title {
    margin: 0;
    color: var(--venustas-black, #14161a);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.68;
    letter-spacing: -0.15px;
  }

  #shopify-section-{{ section.id }} .heatingv-panel-details__item-text {
    margin: 0;
    color: #565b63;
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.68;
  }

  @media only screen and (max-width: 998px) {
    #shopify-section-{{ section.id }} .heatingv-panel-details {
      background: #f0f0f0;
    }

    #shopify-section-{{ section.id }} .heatingv-panel-details__inner {
      width: 100%;
      padding: 56px 20px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .heatingv-panel-details__header {
      gap: 12px;
      margin-bottom: 32px;
    }

    #shopify-section-{{ section.id }} .heatingv-panel-details__title {
      font-size: 24px;
      line-height: 1.3;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heatingv-panel-details__description {
      font-size: 14px;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .heatingv-panel-details__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 16px;
    }

    #shopify-section-{{ section.id }} .heatingv-panel-details__card {
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .heatingv-panel-details__card--wide {
      grid-column: 1 / -1;
    }

    #shopify-section-{{ section.id }} .heatingv-panel-details__media {
      height: 230px;
      border-radius: 6px;
    }

    #shopify-section-{{ section.id }} .heatingv-panel-details__item-title {
      font-size: 14px;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heatingv-panel-details__item-text {
      font-size: 12px;
      line-height: 1.2;
    }
  }
{% endstyle %}

{%- liquid
  assign image_1_mobile = section.settings.image_1_mobile | default: section.settings.image_1
  assign image_2_mobile = section.settings.image_2_mobile | default: section.settings.image_2
  assign image_3_mobile = section.settings.image_3_mobile | default: section.settings.image_3
  assign image_4_mobile = section.settings.image_4_mobile | default: section.settings.image_4
  assign image_5_mobile = section.settings.image_5_mobile | default: section.settings.image_5
-%}

<section class="heatingv-panel-details" id="heating-detail">
  <div class="heatingv-panel-details__inner">
    <div class="heatingv-panel-details__header">
      {%- if section.settings.title != blank -%}
        <h2 class="heatingv-panel-details__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="heatingv-panel-details__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="heatingv-panel-details__grid">
      <article class="heatingv-panel-details__card">
        <div class="heatingv-panel-details__media">
          {%- render 'heating-panel-details-image', desktop_image: section.settings.image_1, mobile_image: image_1_mobile, title: '75D shell TPU fleece' -%}
        </div>
        <div class="heatingv-panel-details__copy">
          <h3 class="heatingv-panel-details__item-title">75D shell TPU fleece</h3>
          <p class="heatingv-panel-details__item-text">Windproof and waterproof, bonded to a fleece backing. Stretches, resists tearing.</p>
        </div>
      </article>

      <article class="heatingv-panel-details__card">
        <div class="heatingv-panel-details__media">
          {%- render 'heating-panel-details-image', desktop_image: section.settings.image_2, mobile_image: image_2_mobile, title: 'Twin-zip back pocket' -%}
        </div>
        <div class="heatingv-panel-details__copy">
          <h3 class="heatingv-panel-details__item-title">Twin-zip back pocket</h3>
          <p class="heating-panel-details__item-text">Wide enough for a pair of gloves, opening from either hand. The weight sits behind you instead of crowding your chest, and a pack doesn't press it into you.
          </p>
        </div>
      </article>

      <article class="heatingv-panel-details__card">
        <div class="heatingv-panel-details__media">
          {%- render 'heating-panel-details-image', desktop_image: section.settings.image_3, mobile_image: image_3_mobile, title: 'Graphene lining' -%}
        </div>
        <div class="heatingv-panel-details__copy">
          <h3 class="heatingv-panel-details__item-title">Graphene lining</h3>
          <p class="heatingv-panel-details__item-text">96% polyester, 4% spandex. Spreads heat evenly and adds far-infrared warmth of its own.</p>
        </div>
      </article>

      <article class="heatingv-panel-details__card">
        <div class="heatingv-panel-details__media">
          {%- render 'heating-panel-details-image', desktop_image: section.settings.image_4, mobile_image: image_4_mobile, title: 'Stretch athletic cut' -%}
        </div>
        <div class="heatingv-panel-details__copy">
          <h3 class="heatingv-panel-details__item-title">Stretch athletic cut</h3>
          <p class="heatingv-panel-details__item-text">A mid-layer that moves with you and still fits under a ski shell or riding jacket.</p>
        </div>
      </article>

      <article class="heatingv-panel-details__card heatingv-panel-details__card--wide">
        <div class="heatingv-panel-details__media">
          {%- render 'heating-panel-details-image', desktop_image: section.settings.image_5, mobile_image: image_5_mobile, title: 'Button at the side hem' -%}
        </div>
        <div class="heatingv-panel-details__copy">
          <h3 class="heatingv-panel-details__item-title">Button at the side hem</h3>
          <p class="heatingv-panel-details__item-text">Moved off the chest and down to the hem, where a gloved hand finds it through a shell jacket. Nothing lit up on your front, and nothing to unzip to reach it.</p>
        </div>
      </article>
    </div>
  </div>
</section>

