{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} .heating-product-kit {
    width: 100%;
    overflow: hidden;
    background: #f5f5f5;
    font-family: 'Montserrat', sans-serif;
    color: var(--venustas-black);
  }

  #shopify-section-{{ section.id }} .heating-product-kit__inner {
    width: min(100% - 40px, 1340px);
    margin-left: auto;
    margin-right: auto;
    padding: 56px 0 56px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__header {
    max-width: 980px;
    margin: 0 auto 64px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__heading {
    margin: 0 0 24px;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__subheading {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__subheading p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__desktop {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__card {
    height: 100%;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__card-main {
    padding: 28px 16px 16px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__card-title {
    margin: 0 0 6px;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__card-description {
    min-height: 42px;
    margin: 0 0 28px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.32;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__media {
    width: 100%;
    height: 292px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__connect {
    position: relative;
    padding: 20px;
    border-top: 1px solid #e8e8e8;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__connect-title {
    margin: 0 0 46px;
    color: var(--color-brand);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option-label {
    position: absolute;
    top: 54px;
    left: 20px;
    margin: 0;
    color: var(--color-brand);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option-label--b {
    position: static;
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option {
    display: grid;
    align-items: start;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-2,
  #shopify-section-{{ section.id }} .heating-product-kit__option--b {
    grid-template-columns: 1fr auto 1fr auto 1fr;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-2 .heating-product-kit__step--1 {
    grid-column: 1;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-2 .heating-product-kit__arrow--a1 {
    grid-column: 3;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-2 .heating-product-kit__step--2 {
    grid-column: 5;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-3 {
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: auto auto auto;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-3 .heating-product-kit__step--1 {
    grid-column: 1;
    grid-row: 1;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-3 .heating-product-kit__arrow--a1 {
    grid-column: 2;
    grid-row: 1;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-3 .heating-product-kit__step--2 {
    grid-column: 3;
    grid-row: 1;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-3 .heating-product-kit__arrow--a2 {
    grid-column: 3;
    grid-row: 2;
    justify-self: center;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-3 .heating-product-kit__step--3 {
    grid-column: 3;
    grid-row: 3;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 {
    grid-template-columns: 1fr auto 1fr auto 1fr;
    grid-template-rows: auto 28px auto;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__step--1 {
    grid-column: 1;
    grid-row: 1;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__arrow--a1 {
    grid-column: 2;
    grid-row: 1;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__step--2 {
    grid-column: 3;
    grid-row: 1;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__arrow--a2 {
    grid-column: 4;
    grid-row: 1;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__step--3 {
    grid-column: 5;
    grid-row: 1;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__arrow--a3 {
    grid-column: 5;
    grid-row: 2;
    justify-self: center;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__step--4 {
    grid-column: 1;
    grid-row: 3;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__arrow--a4 {
    grid-column: 3;
    grid-row: 3;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__step--5 {
    grid-column: 5;
    grid-row: 3;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__step {
    min-width: 0;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__step-image {
    width: 72px;
    height: 72px;
    display: block;
    object-fit: cover;
    margin: 0 auto 10px;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__step-label {
    margin: 0;
    color: #575757;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__arrow {
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand);
    line-height: 0;
    align-self: start;
    justify-self: center;
    margin-top: 27px;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__arrow svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__arrow .heating-product-kit__arrow-svg {
    display: none;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__arrow--a .heating-product-kit__arrow-svg--right {
    display: block;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-3 .heating-product-kit__arrow--a2 .heating-product-kit__arrow-svg--right,
  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__arrow--a3 .heating-product-kit__arrow-svg--right,
  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__arrow--a4 .heating-product-kit__arrow-svg--right {
    display: none;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__option--count-3 .heating-product-kit__arrow--a2 .heating-product-kit__arrow-svg--down,
  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__arrow--a3 .heating-product-kit__arrow-svg--down,
  #shopify-section-{{ section.id }} .heating-product-kit__option--count-5 .heating-product-kit__arrow--a4 .heating-product-kit__arrow-svg--left {
    display: block;
  }

  #shopify-section-{{ section.id }} .heating-product-kit__mobile-pagination {
    display: none;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heating-product-kit__inner {
      width: 100%;
      padding: 26px 20px 36px;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__header {
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__heading {
      margin-bottom: 16px;
      font-size: 24px;
      line-height: 1.12;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__subheading {
      font-size: 16px;
      line-height: 1.35;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__mobile {
      display: block;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__mobile .swiper-slide {
      height: auto;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__card-main {
      padding: 20px;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__card-title {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__card-description {
      min-height: 0;
      margin-bottom: 20px;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__media {
      height: 265px;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__connect {
      position: relative;
      padding: 22px 18px 26px;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__step-image {
      width: 72px;
      height: 72px;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__option-label {
      top: 56px;
      left: 18px;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__mobile-pagination {
      position: static;
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 22px;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__mobile-pagination .swiper-pagination-bullet {
      width: 8px;
      height: 8px;
      margin: 0;
      background: #d0d0d0;
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .heating-product-kit__mobile-pagination .swiper-pagination-bullet-active {
      background: var(--color-brand);
    }
  }
{% endstyle %}

<section class="heating-product-kit" data-heating-product-kit>
  <div class="heating-product-kit__inner">
    <div class="heating-product-kit__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="heating-product-kit__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <h3 class="heating-product-kit__subheading">{{ section.settings.subheading }}</h3>
      {%- endif -%}
    </div>

    <div class="heating-product-kit__desktop">
      {%- for block in section.blocks -%}
        {%- render 'heating-product-kit-card', block: block, mobile: false, include_attributes: true -%}
      {%- endfor -%}
    </div>

    <div class="heating-product-kit__mobile swiper" data-heating-product-kit-swiper>
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            {%- render 'heating-product-kit-card', block: block, mobile: true, include_attributes: false -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="heating-product-kit__mobile-pagination swiper-pagination"></div>
    </div>
  </div>
</section>

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script>
  (() => {
    const sectionId = 'shopify-section-{{ section.id }}';

    const init = (attempt = 0) => {
      const section = document.getElementById(sectionId);
      if (!section || typeof window.Swiper === 'undefined') {
        if (attempt < 20) {
          window.setTimeout(() => init(attempt + 1), 100);
        }
        return;
      }

      const slider = section.querySelector('[data-heating-product-kit-swiper]');
      if (!slider || slider.swiper) {
        return;
      }

      new window.Swiper(slider, {
        slidesPerView: 1,
        spaceBetween: 18,
        watchOverflow: true,
        pagination: {
          el: section.querySelector('.heating-product-kit__mobile-pagination'),
          clickable: true
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        init();
      }
    });
  })();
</script>

