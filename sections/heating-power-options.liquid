      "default": "heat",
      "info": "Available: connection, heat, runtime"
    },
    {
      "type": "text",
      "id": "selling_icon_3",
      "label": "ProductH runtime icon",
      "default": "runtime",
      "info": "Available: connection, heat, runtime"
    },
    {
      "type": "header",
      "content": "ProductH runtime tooltip"
    },
    {
      "type": "text",
      "id": "runtime_jacket_high",
      "label": "ProductH jacket high",
      "default": "3h"
    },
    {
      "type": "text",
      "id": "runtime_jacket_medium",
      "label": "ProductH jacket medium",
      "default": "5h"
    },
    {
      "type": "text",
      "id": "runtime_jacket_low",
      "label": "ProductH jacket low",
      "default": "8h"
    },
    {
      "type": "text",
      "id": "runtime_pants_high",
