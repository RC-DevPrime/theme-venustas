{% style %}
  #shopify-section-{{ section.id }} .heating-power-options {
    width: 100%;
    overflow: hidden;
    background: #f5f5f5;
    font-family: 'Montserrat', sans-serif;
    color:var(--venustas-black);
  }

  #shopify-section-{{ section.id }} .heating-power-options__inner {
    width: min(100% - 40px, 1340px);
    margin-left: auto;
    margin-right: auto;
    padding: 56px 0 56px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-power-options__header {
    max-width: 1000px;
    margin: 0 auto 56px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-power-options__eyebrow {
    margin: 0 0 16px;
    color: var(--color-brand);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__heading {
    margin: 0 0 24px;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .heating-power-options__description {
    margin: 0;
    color: #696969;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__layout {
    display: flex;
    align-items: stretch;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .heating-power-options__column {
    flex: 1 1 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__feature-card,
  #shopify-section-{{ section.id }} .heating-power-options__product-card {
    height: 100%;
    padding: 32px;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    background: #fff;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-power-options__card-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 32px;
  }

  #shopify-section-{{ section.id }} .heating-power-options__card-heading--product {
    align-items: flex-start;
    margin-bottom: 32px;
  }

  #shopify-section-{{ section.id }} .heating-power-options__card-icon {
    width: 53px;
    height: 53px;
    flex: 0 0 53px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(185, 50, 5, 0.08);
    color: var(--color-brand);
  }

  #shopify-section-{{ section.id }} .heating-power-options__card-icon svg {
    width: 36px;
    height: 36px;
    display: block;
  }

  #shopify-section-{{ section.id }} .heating-power-options__card-title {
    margin: 0;
    font-size: 24px;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__card-kicker {
    margin: 5px 0 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__feature-media {
    margin-bottom: 32px;
    overflow: hidden;
    border-radius: 6px;
    background: #f0f0f0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__feature-image {
    width: 100%;
    height: 280px;
    display: block;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .heating-power-options__feature-copy {
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} .heating-power-options__feature-subtitle {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__feature-description {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__feature-description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .heating-power-options__tag-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__tag-icon {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    color: var(--color-brand);
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__tag-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .heating-power-options__flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: start;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .heating-power-options__flow-item {
    display: grid;
    grid-template-rows: 72px auto;
    align-items: start;
    min-width: 0;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-power-options__flow-image {
    width: 72px;
    height: 72px;
    display: block;
    object-fit: cover;
    margin: 0 auto 10px;
  }

  #shopify-section-{{ section.id }} .heating-power-options__flow-label {
    margin: 8px 0 0;
    color: #515151;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
  }
  #shopify-section-{{ section.id }} .heating-power-options__flow-arrow svg{
    width:18px;
    height:18px;
  }
  #shopify-section-{{ section.id }} .heating-power-options__flow-arrow {
    color: var(--color-brand);
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    margin-top: 29px;
  }

  #shopify-section-{{ section.id }} .heating-power-options__scenes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 24px;
    padding-bottom: 32px;
    border-bottom: 1px solid #E5E7EB;
  }

  #shopify-section-{{ section.id }} .heating-power-options__scene-image {
    width: 100%;
    height: 120px;
    display: block;
    object-fit: cover;
    margin-bottom: 12px;
    border-radius: 4px;
    background: #f0f0f0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__scene-title {
    margin: 0 0 4px;
    color:#111827;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .heating-power-options__scene-text {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__product-panel {
    padding: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__option-heading {
    margin: 0 0 16px;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .heating-power-options__option-heading span {
    color: var(--color-brand);
  }
  #shopify-section-{{ section.id }} .heating-power-options__product-box-wrapper {
    border: 1px solid #e4e4e4;
    padding: 16px;
    border-radius: 8px;
  }
  #shopify-section-{{ section.id }} .heating-power-options__product-box {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 16px;
    margin-bottom:16px;
  }
  #shopify-section-{{ section.id }} .heating-power-options__product-info{
    height:160px;
    padding:10px 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__product-media {
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .heating-power-options__product-image {
    width: 160px;
    height: 160px;
    display: block;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .heating-power-options__product-line {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .heating-power-options__product-title {
    margin: 0 0 4px;
    font-size: 18px;
    color:#111827;
    font-weight: 700;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__product-subtitle {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__product-price {
    margin: 0;
    color: var(--color-brand);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .heating-power-options__selling-list {
    display: grid;
    gap: 12px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .heating-power-options__selling-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__selling-item span {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    color: var(--color-brand);
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__selling-item svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .heating-power-options__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 37px;
    padding: 10px 18px;
    border-radius: 4px;
    background: var(--color-brand);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-power-options__legal {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 24px 0 0;
    color: #515151;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__legal span {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    color: #515151;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .heating-power-options__legal svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media only screen and (max-width: 980px) {
    #shopify-section-{{ section.id }} .heating-power-options__inner {
      width: 100%;
      padding: 40px 20px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__header {
      margin-bottom: 32px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__eyebrow {
      margin-bottom: 8px;
      font-size: 18px;
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .heating-power-options__heading {
      margin-bottom: 16px;
      font-size: 24px;
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .heating-power-options__description {
      font-size: 16px;
      line-height: 1.35;
    }

    #shopify-section-{{ section.id }} .heating-power-options__layout {
      flex-direction: column;
      gap: 14px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__feature-card,
    #shopify-section-{{ section.id }} .heating-power-options__product-card {
      padding: 32px 16px;
      border-radius: 12px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__card-heading {
      gap: 10px;
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__card-icon {
      width: 40px;
      height: 40px;
      flex-basis: 40px;
    }
    #shopify-section-{{ section.id }} .heating-power-options__flow-label{
      margin-top:10px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__card-icon svg {
      width: 28px;
      height: 28px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__card-title {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__feature-media {
      margin-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__tag-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__flow-image {
      width: 72px;
      height: 72px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__flow-arrow {
      line-height: 1;
      margin-top: 29px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__scenes {
      gap: 6px;
      margin-bottom: 24px;
      padding-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__scene-image {
      margin-bottom: 7px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__scene-title {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__scene-text {
      font-size: 10px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__option-heading {
      margin-bottom: 20px;
      font-size: 16px;
    }
    #shopify-section-{{ section.id }} .heating-power-options__product-box-wrapper{
      border-width:0px;
      padding:0 0 20px;
    }
    #shopify-section-{{ section.id }} .heating-power-options__product-media{
      height:140px;
    }
    #shopify-section-{{ section.id }} .heating-power-options__product-box {
      height:140px;
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 12px;
      padding: 0px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__product-image {
      width: 100px;
      height: 100px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__product-title {
      font-size: 16px;
    }
    #shopify-section-{{ section.id }} .heating-power-options__product-title 

    #shopify-section-{{ section.id }} .heating-power-options__product-info {
      height:140px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__selling-list {
      gap: 7px;
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__cta {
      min-height: 38px;
    }

    #shopify-section-{{ section.id }} .heating-power-options__legal {
      margin-top: 14px;
    }
  }
{% endstyle %}

<section class="heating-power-options">
  <div class="heating-power-options__inner">
    <div class="heating-power-options__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="heating-power-options__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="heating-power-options__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="heating-power-options__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="heating-power-options__layout">
      <div class="heating-power-options__column">
        {%- render 'heating-power-feature-card', section_settings: section.settings -%}
      </div>
      <div class="heating-power-options__column">
        {%- render 'heating-power-product-card', section_settings: section.settings -%}
      </div>
    </div>
  </div>
</section>

