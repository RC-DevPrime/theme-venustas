{% style %}
  #shopify-section-{{ section.id }} .motorheating-challenge {
    width: 100%;
    background: #F0F0F0;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__inner {
    width: min(100% - 40px, 1200px);
    margin: 0 auto;
    padding: 118px 0;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__eyebrow {
    margin: 0 0 8px;
    color: var(--color-brand);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__title {
    margin: 0;
    max-width: 620px;
    color: var(--venustas-black);
    font-size: 28px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__description {
    margin: 32px 0 56px;
    max-width: 620px;
    color: var(--venustas-black);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin-bottom: 56px;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__feature {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__icon {
    width: 48px;
    height: 48px;
    color: var(--color-brand);
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__feature-content {
    min-width: 0;
    padding-top: 3px;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__feature-title {
    margin: 0 0 4px;
    color: var(--venustas-black);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__feature-text {
    margin: 0;
    color: var(--venustas-black);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__image-wrap {
    width: 100%;
    aspect-ratio: 1200 / 376;
    overflow: hidden;
    border-radius: 4px;
    background: #dedede;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .motorheating-challenge__image--mobile {
    display: none;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .motorheating-challenge__inner {
      width: 100%;
      padding: 54px 20px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .motorheating-challenge__eyebrow {
      margin-bottom: 8px;
      font-size: 12px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .motorheating-challenge__title {
      max-width: none;
      font-size: 24px;
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .motorheating-challenge__description {
      margin: 16px 0 40px;
      max-width: none;
      font-size: 16px;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .motorheating-challenge__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .motorheating-challenge__feature {
      display: flex;
      min-height: 120px;
      padding: 18px 8px 14px;
      box-sizing: border-box;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 12px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.70);
      text-align: center;
    }

    #shopify-section-{{ section.id }} .motorheating-challenge__feature-content {
      padding-top: 0;
    }

    #shopify-section-{{ section.id }} .motorheating-challenge__feature-title {
      font-size: 16px;
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .motorheating-challenge__feature-text {
      font-size: 16px;
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .motorheating-challenge__image-wrap {
      width: 100%;
      aspect-ratio: 350 / 182;
    }

    #shopify-section-{{ section.id }} .motorheating-challenge__image--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .motorheating-challenge__image--mobile {
      display: block;
    }
  }
{% endstyle %}

<section class="motorheating-challenge">
  <div class="motorheating-challenge__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="motorheating-challenge__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="motorheating-challenge__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="motorheating-challenge__description">{{ section.settings.description }}</div>
    {%- endif -%}

    <div class="motorheating-challenge__features">
      {%- for block in section.blocks -%}
        <div class="motorheating-challenge__feature" {{ block.shopify_attributes }}>
          <div class="motorheating-challenge__icon" aria-hidden="true">
            {%- case forloop.index -%}
              {%- when 1 -%}
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M19.18 9.18C19.6446 8.71262 20.2175 8.36728 20.8477 8.17468C21.478 7.98207 22.1461 7.94817 22.7926 8.07598C23.4391 8.20379 24.044 8.48935 24.5535 8.90729C25.0631 9.32522 25.4614 9.86257 25.7133 10.4716C25.9651 11.0806 26.0625 11.7424 25.9969 12.3981C25.9313 13.0539 25.7048 13.6832 25.3373 14.2303C24.9699 14.7774 24.4729 15.2252 23.8907 15.5339C23.3085 15.8427 22.659 16.0028 22 16H4M25.18 38.82C25.6446 39.2874 26.2175 39.6327 26.8477 39.8253C27.478 40.0179 28.1461 40.0518 28.7926 39.924C29.4391 39.7962 30.044 39.5106 30.5535 39.0927C31.0631 38.6748 31.4614 38.1374 31.7133 37.5284C31.9651 36.9194 32.0625 36.2576 31.9969 35.6019C31.9313 34.9461 31.7048 34.3167 31.3373 33.7697C30.9699 33.2226 30.4729 32.7748 29.8907 32.4661C29.3085 32.1573 28.659 31.9972 28 32H4M35.46 15.46C36.0417 14.8798 36.7574 14.4518 37.5439 14.214C38.3303 13.9762 39.1632 13.9359 39.969 14.0966C40.7747 14.2573 41.5284 14.614 42.1635 15.1353C42.7985 15.6566 43.2953 16.3264 43.61 17.0854C43.9246 17.8444 44.0473 18.6692 43.9673 19.4869C43.8873 20.3046 43.607 21.09 43.1512 21.7736C42.6955 22.4572 42.0783 23.018 41.3542 23.4063C40.6302 23.7946 39.8216 23.9985 39 24H4" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- when 2 -%}
                <svg viewBox="0 0 43 43" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M21.3 9.29999V21.3L29.3 25.3M41.3 21.3C41.3 32.3457 32.3457 41.3 21.3 41.3C10.2544 41.3 1.30005 32.3457 1.30005 21.3C1.30005 10.2543 10.2544 1.29999 21.3 1.29999C32.3457 1.29999 41.3 10.2543 41.3 21.3Z" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- when 3 -%}
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M40.0001 35.16C42.1026 34.2392 43.8243 32.6231 44.8762 30.5831C45.9282 28.543 46.2463 26.2032 45.7773 23.9564C45.3082 21.7095 44.0805 19.6924 42.3002 18.2437C40.5199 16.7949 38.2954 16.0027 36.0001 16H33.4801C32.8461 13.545 31.6378 11.2759 29.9547 9.37961C28.2716 7.48331 26.1619 6.01416 23.7996 5.09325C21.4373 4.17234 18.8899 3.82604 16.3674 4.08289C13.845 4.33975 11.4197 5.1924 9.29146 6.57057C7.16322 7.94874 5.39299 9.81297 4.12668 12.0096C2.86036 14.2062 2.13421 16.6724 2.00809 19.2047C1.88197 21.7371 2.35948 24.2631 3.40127 26.5747C4.44307 28.8863 6.0193 30.9172 8.00007 32.5M16.0001 32H16.0201M16.0001 40H16.0201M24.0001 36H24.0201M24.0001 44H24.0201M32.0001 32H32.0201M32.0001 40H32.0201" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- when 4 -%}
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M32 32C32 32 29 28 24 28C19 28 16 32 16 32M18 18H18.02M30 18H30.02M44 24C44 35.0457 35.0457 44 24 44C12.9543 44 4 35.0457 4 24C4 12.9543 12.9543 4 24 4C35.0457 4 44 12.9543 44 24Z" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            {%- endcase -%}
          </div>

          <div class="motorheating-challenge__feature-content">
            {%- if block.settings.heading != blank -%}
              <h3 class="motorheating-challenge__feature-title">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="motorheating-challenge__feature-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="motorheating-challenge__image-wrap">
      {%- if section.settings.image_desktop != blank -%}
        {{
          section.settings.image_desktop
          | image_url: width: 2400
          | image_tag:
            class: 'motorheating-challenge__image motorheating-challenge__image--desktop',
            loading: 'lazy',
            widths: '720,960,1200,1440,1800,2400',
            sizes: '(max-width: 767px) 0px, min(100vw - 40px, 1200px)',
            alt: section.settings.image_desktop.alt | default: section.settings.title
        }}
      {%- endif -%}

      {%- if section.settings.image_mobile != blank -%}
        {{
          section.settings.image_mobile
          | image_url: width: 900
          | image_tag:
            class: 'motorheating-challenge__image motorheating-challenge__image--mobile',
            loading: 'lazy',
            widths: '350,500,700,900',
            sizes: '(max-width: 767px) calc(100vw - 40px), 0px',
            alt: section.settings.image_mobile.alt | default: section.settings.title
        }}
      {%- elsif section.settings.image_desktop != blank -%}
        {{
          section.settings.image_desktop
          | image_url: width: 900
          | image_tag:
            class: 'motorheating-challenge__image motorheating-challenge__image--mobile',
            loading: 'lazy',
            widths: '350,500,700,900',
            sizes: '(max-width: 767px) calc(100vw - 40px), 0px',
            alt: section.settings.image_desktop.alt | default: section.settings.title
        }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Motorheating Challenge",
  "tag": "section",
  "class": "motorheating-challenge-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE CHALLENGE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "COLD SHOULDN'T END THE RIDE"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Motorcycle riding creates a unique cold-weather challenge that ordinary clothing can't solve.</p>"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    }
  ],
  "blocks": [
    {
      "type": "challenge",
      "name": "Challenge",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Wind Chill"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "High-speed wind steals body heat"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Motorheating Challenge",
      "blocks": [
        {
          "type": "challenge",
          "settings": {
            "heading": "Wind Chill",
            "text": "High-speed wind steals body heat"
          }
        },
        {
          "type": "challenge",
          "settings": {
            "heading": "Long Exposure",
            "text": "Hours in the saddle lead to heat loss."
          }
        },
        {
          "type": "challenge",
          "settings": {
            "heading": "Changing Weather",
            "text": "Temperatures can drop fast and unexpectedly."
          }
        },
        {
          "type": "challenge",
          "settings": {
            "heading": "Cold Zones",
            "text": "Some areas get cold faster than others."
          }
        }
      ]
    }
  ]
}
{% endschema %}
