{% style %}
    .product-centered-image-slider-section-v2{
        background-color: #1C1C1C;
    }
    .product-centered-image-slider-section-v2 .centered-image-item{
        width:100%;
        height:100%;
        position:relative;
        overflow:hidden;
        border-radius:8px;
    }
    .product-centered-image-slider-section-v2 .centered-image-item img{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    
    
    .product-centered-image-slider-section-v2 .float-nav button{
        background: #595959;
        position:unset;
        transform: unset;
    }
    .product-centered-image-slider-section-v2 .float-nav button:hover{
        background: #B93205;
    }
    .product-centered-image-slider-section-v2 .float-nav button i{
        color: #B93205;
    }
    .product-centered-image-slider-section-v2 .float-nav button:hover i{
        color: #FFF;
    }
    .product-centered-image-slider-section-v2 .pagination-navigations{
        position:relative;
    }
    .product-centered-image-slider-section-v2 .pagination-navigations .float-nav{
        position:unset;
        transform: unset;
        max-width:unset;
    }
    .product-centered-image-slider-section-v2 .swiper-pagination{
        background-color: unset;
        padding: 15px 0.6rem;
        border-radius: 50px;
        display: flex;
        margin: 0;
        position:unset;
        width: fit-content;
    }
    .product-centered-image-slider-section-v2 .swiper-pagination .swiper-pagination-bullet{
        background: #595959;
        opacity:1;
        margin:0px 4px;
        width:12px;
        height:6px;
        border-radius:4px;
    }
    .product-centered-image-slider-section-v2 .swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active{
        background: #B93205;
        width:55px;
    }
    .product-centered-image-slider-section-v2 .centered-iamge-content-container{
        width:100%;
        height:100%;
        position:absolute;
        top:0;
        left:0;
        display:flex;
        align-items:center;
    }


    /* initial state (hidden + slightly down) */
    .product-centered-image-slider-section-v2 .centered-iamge-content-container .inner-section{
        opacity: 0;
        transform: translateY(50px);
        transition: opacity .45s ease, transform .45s ease;
        transition-delay:0.5s;
        pointer-events: none; /* optional */
    }

    /* entering/visible state */
    .product-centered-image-slider-section-v2 .swiper-slide.is-content-in .centered-iamge-content-container .inner-section{
        opacity: 1;
        transform: translateY(0px);
    }

    /* exiting state (fade out) */
    .product-centered-image-slider-section-v2 .swiper-slide.is-content-out .centered-iamge-content-container .inner-section{
        opacity: 0;
        transform: translateY(50px);
        transition: opacity .35s ease 0.2s, transform .45s ease 0.7s;
    }

    
    .product-centered-image-slider-section-v2 .centered-image-slider .swiper-slide.swiper-slide-active .centered-iamge-content-container .entrance-animation{
        opacity: 0;
        transform: translateY(50px);
        transition: opacity .45s ease, transform .45s ease;
    }
    .product-centered-image-slider-section-v2.animate .centered-image-slider .swiper-slide.swiper-slide-active .centered-iamge-content-container .entrance-animation{
        opacity: 1;
        transform: translateY(0px);
    }

{% endstyle %}
<div class=" 
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}>

    <div class="container section-content pb-0">
        <div class="col-lg-9 col-md-9 col-sm-12 mx-auto">
            <h2 class="pp-bold title-sm f-white text-center pb-lg-4 pb-md-4 pb-sm-3"  data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="100" data-aos-duration="500">
                {{ section.settings.heading }}
            </h2>

            {% if section.settings.description != blank %}
            <div class="pp-regular pretitle f-white text-center pb-2"  data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="150" data-aos-duration="500">
                <span class="pretitle d-lg-block d-md-block d-sm-none">
                    {{ section.settings.description }}
                </span>
                <span class="body d-lg-none d-md-none d-sm-block">
                    {{ section.settings.description }}
                </span>
            </div>
            {% endif %}
            
        </div>
    </div>
    <div class="section-content px-0 pt-lg-5 pt-md-5 pt-sm-4">
        <div class="centered-image-slider position-relative">
            <div class="swiper-wrapper">
                {% for block in section.blocks %}
                    <div class="swiper-slide">
                        <div class="centered-image-item">
                            <img
                                src="{{ block.settings.image | img_url: '400x400' | image_url: 'format:auto' }}"
                                srcset="
                                    {{ block.settings.image | img_url: '400x400' | image_url: 'format:auto' }} 400w,
                                    {{ block.settings.image | img_url: '800x800' | image_url: 'format:auto' }} 800w,
                                    {{ block.settings.image | img_url: '1200x1200' | image_url: 'format:auto' }} 1200w,
                                    {{ block.settings.image | img_url: '1400x1400' | image_url: 'format:auto' }} 1400w"
                                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                                width="100%"
                                height="100%"
                                alt="{{ block.settings.image.alt | escape }}"
                                loading="lazy"
                                decoding="async"
                            />
                            <div class="centered-iamge-content-container">
                                <div class="overflow-hidden">
                                    <div class="inner-section">
                                        <div class="entrance-animation">
                                            <div class="d-lg-block d-md-block d-sm-none">
                                                <div class="col-lg-7 col-md-7 col-sm-12 mx-auto">
                                                    <div class="content-heading pp-bold pretitle-xl f-white text-center">
                                                        {{ block.settings.heading }}
                                                    </div>
                                                    <div class="content-description pp-regular body-lg f-white text-center">
                                                        {{ block.settings.description }}
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="d-lg-none d-md-none d-sm-block">
                                                <div class="col-11 mx-auto">
                                                    <div class="content-heading pp-bold body-xl f-white text-center l-h-normal">
                                                        {{ block.settings.heading }}
                                                    </div>
                                                    <div class="content-description pp-regular body-sm f-white text-center l-h-normal">
                                                        {{ block.settings.description }}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>    
                {% endfor %}  
            </div>
            <div class="pagination-navigations mt-lg-5 mt-md-5 mt-sm-4">
                <div class="float-nav d-flex align-items-center justify-content-center gap-lg-4 gap-md-4 gap-sm-2">
                    <button type="button" class="owl-prev" aria-label="Previous slide" disabled>
                        <i class="fa-solid fa-chevron-left f-white"></i>
                    </button>
                    <div class="swiper-pagination"></div>
                    <button type="button" class="owl-next" aria-label="Next slide" disabled>
                        <i class="fa-solid fa-chevron-right f-white"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% schema %}
{
    "class": "product-centered-image-slider-section-v2 overflow-hidden section-animation",
    "name": "Centered Image Slider V2",
    "limit": 1,
    "templates": ["product"],
    "settings": [
        {
            "type": "checkbox",
            "id": "enabled_section_child_scroll",
            "label": "Enabled Section Child Scroll"
        },
        {
            "type": "text",
            "id": "section_scroll_nav",
            "label": "Section Scroll Nav",
            "info": "Need to Enabled first Section Scroll"
        },
        {
            "type": "text",
            "id": "nav_title",
            "label": "Navigation Title"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Fight the cold easily"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>In the cold winter, VENUSTAS is your best partner! It heats up quickly and stays warm during outdoor activities, making it perfect for daily commuting or casual outings.</p>"
        } 
    ],
    "blocks": [
        {
            "type": "image",
            "name": "Image",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading",
                    "default": "Outdoor Workers"
                },
                {
                    "type": "textarea",
                    "id": "description",
                    "label": "Description",
                    "default": "City cornerstones, guardians in the snow. Construction workers, delivery people, police officers, night doctors… They use sweat to fight the cold and perseverance to protect us."
                } 
            ]
        }
    ],
    "presets": [
        {
            "name": "Centered Image Slider V2"
        }
    ]
}
{% endschema %}