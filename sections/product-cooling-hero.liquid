{%- comment -%}
  Product Cooling Hero — "OUR FIRST COOLING VEST"
  Sky-blue gradient hero with a centered (ideally transparent-PNG) person image
  that blends into the gradient. Feature hotspots dock to the left/right column;
  each draws an elbow leader line (horizontal run + diagonal) via SVG to an
  anchor point you place on the model's body. On mobile the hotspots reflow into
  a simple stacked icon+text list below the image (leader lines hidden).
  Cooling-vest only (no preset) so it can't be added to other pages.
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: linear-gradient(180deg, {{ section.settings.bg_gradient_top }} 0%, {{ section.settings.bg_gradient_bottom }} 100%);
    --ch-accent: {{ section.settings.accent_color }};
    --ch-heading: {{ section.settings.heading_color }};
    --ch-line: {{ section.settings.line_color }};
  }
  #shopify-section-{{ section.id }} .container {
    padding-left: 40px;
    padding-right: 40px;
  }
  #shopify-section-{{ section.id }} .ch { padding: 64px 0 40px; }
  #shopify-section-{{ section.id }} .ch__head { text-align: center; }
  #shopify-section-{{ section.id }} .ch__heading {
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 800;
    color: var(--ch-heading);
    text-transform: uppercase;
    line-height: 1.15;
    margin: 0 0 10px;
  }
  #shopify-section-{{ section.id }} .ch__heading-accent { color: var(--ch-accent); }
  #shopify-section-{{ section.id }} .ch__subheading {
    font-size: clamp(13px, 1.4vw, 17px);
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ch-heading);
    margin: 0 0 14px;
  }
  #shopify-section-{{ section.id }} .ch__rule {
    width: 46px;
    height: 3px;
    border: 0;
    border-radius: 3px;
    background: var(--ch-heading);
    opacity: .55;
    margin: 0 auto 14px;
  }
  #shopify-section-{{ section.id }} .ch__caption {
    font-size: clamp(13px, 1.3vw, 16px);
    color: {{ section.settings.heading_color }};
    opacity: .78;
    margin: 0 auto 8px;
  }

  /* ---- Stage: image + docked hotspots + SVG leader lines (desktop) ---- */
  #shopify-section-{{ section.id }} .ch__stage {
    position: relative;
    max-width: 1180px;
    margin: 8px auto 0;
  }
  #shopify-section-{{ section.id }} .ch__image {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: {{ section.settings.image_max_width }}px;
    margin: 0 auto;
  }
  /* Transparent-PNG friendly: no card, no border, no background — blends in */
  #shopify-section-{{ section.id }} .ch__image img {
    display: block;
    width: 100%;
    height: auto;
    max-height: {{ section.settings.image_max_height }}px;
    object-fit: contain;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .ch__image .ch__placeholder {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 3 / 4;
    margin: 0 auto;
    border: 1.5px dashed rgba(1,19,47,0.22);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.heading_color }};
    opacity: .55;
    font-size: 14px;
  }

  /* SVG leader-line layer spanning the whole stage */
  #shopify-section-{{ section.id }} .ch__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    overflow: visible;
  }
  #shopify-section-{{ section.id }} .ch__lines path {
    fill: none;
    stroke: var(--ch-line);
    stroke-width: 1.5;
  }
  #shopify-section-{{ section.id }} .ch__lines circle { fill: var(--ch-line); }

  /* Hotspot cards docked to a side column */
  #shopify-section-{{ section.id }} .ch__hotspot {
    position: absolute;
    z-index: 3;
    width: clamp(180px, 18vw, 230px);
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .ch__hotspot--right {
    transform: translateY(-50%);
    flex-direction: row;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .ch__hotspot--left {
    transform: translateY(-50%);
    flex-direction: row-reverse;
    text-align: right;
  }
  /* Icon: raw artwork, no ring / no background (art already includes its circle) */
  #shopify-section-{{ section.id }} .ch__icon {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .ch__icon img,
  #shopify-section-{{ section.id }} .ch__icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .ch__text { flex: 1 1 auto; }
  #shopify-section-{{ section.id }} .ch__title {
    font-size: 17px;
    font-weight: 700;
    color: var(--ch-heading);
    line-height: 1.25;
    margin: 0 0 4px;
  }
  #shopify-section-{{ section.id }} .ch__desc {
    font-size: 13px;
    color: {{ section.settings.heading_color }};
    opacity: .78;
    line-height: 1.45;
    margin: 0;
  }

  /* ---- Mobile: drop absolute positioning, stack under the image ---- */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .container { padding-left: 20px; padding-right: 20px; }
    #shopify-section-{{ section.id }} .ch { padding: 44px 0 32px; }
    #shopify-section-{{ section.id }} .ch__stage { max-width: 460px; }
    #shopify-section-{{ section.id }} .ch__lines { display: none; }
    #shopify-section-{{ section.id }} .ch__hotspots {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-top: 26px;
    }
    #shopify-section-{{ section.id }} .ch__hotspot {
      position: static !important;
      transform: none !important;
      width: 100%;
      flex-direction: row !important;
      text-align: left !important;
      left: auto; right: auto; top: auto;
    }
  }
{% endstyle %}

<div class="ch">
  <div class="container">
    <div class="ch__head">
      {% if section.settings.heading != blank or section.settings.heading_accent != blank %}
        <h2 class="ch__heading">
          {{ section.settings.heading }}
          {% if section.settings.heading_accent != blank %}<span class="ch__heading-accent">{{ section.settings.heading_accent }}</span>{% endif %}
        </h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="ch__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.show_rule %}<hr class="ch__rule">{% endif %}
      {% if section.settings.caption != blank %}
        <p class="ch__caption">{{ section.settings.caption }}</p>
      {% endif %}
    </div>

    <div class="ch__stage">
      <div class="ch__image">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 1120 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {% else %}
          <div class="ch__placeholder">Center product image (transparent PNG)</div>
        {% endif %}
      </div>

      {%- comment -%}
        Leader lines. Each hotspot docks at column x = 8% (left) / 92% (right),
        at height y%. The line runs horizontally toward the model, then elbows
        diagonally to the anchor point (anchor_x / anchor_y). Coordinates are
        percentages of the stage box, drawn in a 0–100 viewBox (non-uniform
        scale is fine for straight segments).
      {%- endcomment -%}
      <svg class="ch__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {% for block in section.blocks %}
          {% assign ax = block.settings.anchor_x %}
          {% assign ay = block.settings.anchor_y %}
          
          {%- comment -%} MODIFIED: Adjusted icon_x and elbow_x for the left side to prevent overlapping text {%- endcomment -%}
          {% if block.settings.side == 'left' %}
            {% assign icon_x = 31 %}
            {% assign elbow_x = 42 %}
          {% else %}
            {% assign icon_x = 85 %}
            {% assign elbow_x = 74 %}
          {% endif %}
          
          <path d="M {{ icon_x }} {{ block.settings.y }} L {{ elbow_x }} {{ block.settings.y }} L {{ ax }} {{ ay }}"
                vector-effect="non-scaling-stroke"></path>
          <circle cx="{{ ax }}" cy="{{ ay }}" r="0.5"></circle>
        {% endfor %}
      </svg>

      <div class="ch__hotspots">
        {% for block in section.blocks %}
          {% if block.settings.side == 'left' %}
            {% assign dock_x = 8 %}
          {% else %}
            {% assign dock_x = 92 %}
          {% endif %}
          <div class="ch__hotspot ch__hotspot--{{ block.settings.side }}"
               style="left: {{ dock_x }}%; top: {{ block.settings.y }}%;"
               {{ block.shopify_attributes }}>
            <span class="ch__icon">
              {% if block.settings.icon != blank %}
                <img src="{{ block.settings.icon | image_url: width: 120 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </span>
            <div class="ch__text">
              {% if block.settings.title != blank %}<p class="ch__title">{{ block.settings.title }}</p>{% endif %}
              {% if block.settings.description != blank %}<p class="ch__desc">{{ block.settings.description }}</p>{% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cooling Hero",
  "class": "product-cooling-hero-section",
  "templates": ["product"],
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "enabled_section_child_scroll", "label": "Enable scroll nav anchor", "default": false },
    { "type": "text", "id": "section_scroll_nav", "label": "Scroll Nav Group" },
    { "type": "text", "id": "nav_title", "label": "Nav Title" },
    { "type": "color", "id": "bg_gradient_top", "label": "Background Gradient Top", "default": "#7FB5EC" },
    { "type": "color", "id": "bg_gradient_bottom", "label": "Background Gradient Bottom", "default": "#DCE9F6" },
    { "type": "color", "id": "heading_color", "label": "Heading / Text Color", "default": "#01132F" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#1C80FE" },
    { "type": "color", "id": "line_color", "label": "Leader Line Color", "default": "#4A5D75" },
    { "type": "text", "id": "heading", "label": "Heading (dark part)", "default": "OUR FIRST" },
    { "type": "text", "id": "heading_accent", "label": "Heading (accent part)", "default": "COOLING VEST" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "BUILT FOR THE OTHER EXTREME." },
    { "type": "checkbox", "id": "show_rule", "label": "Show divider rule", "default": true },
    { "type": "text", "id": "caption", "label": "Caption", "default": "A new way to take on summer heat." },
    { "type": "header", "content": "Center Image" },
    { "type": "image_picker", "id": "image", "label": "Person / product image", "info": "Use a transparent-background PNG so it blends into the gradient." },
    { "type": "range", "id": "image_max_width", "label": "Image max width", "min": 320, "max": 900, "step": 20, "unit": "px", "default": 620 },
    { "type": "range", "id": "image_max_height", "label": "Image max height", "min": 260, "max": 760, "step": 20, "unit": "px", "default": 520 }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "Upload the circular icon artwork as-is (no extra ring is added)." },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "description", "label": "Description" },
        {
          "type": "select", "id": "side", "label": "Dock side (desktop)",
          "options": [
            { "value": "left", "label": "Left column" },
            { "value": "right", "label": "Right column" }
          ], "default": "right"
        },
        { "type": "range", "id": "y", "label": "Icon vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 40 },
        { "type": "header", "content": "Leader line anchor (point on the model)" },
        { "type": "range", "id": "anchor_x", "label": "Anchor horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "anchor_y", "label": "Anchor vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 45 }
      ]
    }
  ]
}
{% endschema %}