{% paginate search.results by 250 %}
  <script>
    window.SearchData = window.SearchData || { products: [], pages: [], articles: [], collections: [] };

    {% for item in search.results %}
      {% case item.object_type %}

        {% when 'product' %}
          {% capture product_html %}{% render 'search-product-item', product: item, badge_detail: true %}{% endcapture %}
          window.SearchData.products.push({
            title: {{ item.title | json }},
            url: {{ item.url | json }},
            price: {{ item.price | json }},
            created_at: {{ item.published_at | date: "%Y-%m-%d" | json }},
            html: {{ product_html | strip | replace: "\n", " " | json }}
          });

        {% when 'page' %}
          {% capture page_html %}{% render 'search-page-item', item: item %}{% endcapture %}
          window.SearchData.pages.push({
            title: {{ item.title | json }},
            url: {{ item.url | json }},
            html: {{ page_html | strip | replace: "\n", " " | json }}
          });

        {% when 'article' %}
          {% capture article_html %}{% render 'search-article-item', item: item %}{% endcapture %}
          window.SearchData.articles.push({
            title: {{ item.title | json }},
            url: {{ item.url | json }},
            html: {{ article_html | strip | replace: "\n", " " | json }}
          });

        {% when 'collection' %}
          {% capture collection_html %}{% render 'search-collection-item', collection: item %}{% endcapture %}
          window.SearchData.collections.push({
            title: {{ item.title | json }},
            url: {{ item.url | json }},
            html: {{ collection_html | strip | replace: "\n", " " | json }}
          });

      {% endcase %}
    {% endfor %}
  </script>

  {% if paginate.next %}
    <button id="search-next-btn" data-next-url="{{ paginate.next.url }}" style="display:none;">Next</button>
  {% endif %}
{% endpaginate %}

<script>
  // ===========================
  // SETTINGS
  // ===========================
  const productPerPage = 8;
  const articlePerPage = 8;
  const pagePerPage = 8;
  const collectionPerPage = 8;

  // Use Liquid term safely
  const SEARCH_TERM = {{ search.terms | json }};

  // ===========================
  // STATE
  // ===========================
  window.SearchData = window.SearchData || { products: [], pages: [], articles: [], collections: [] };

  let productIndex = 0;
  let articleIndex = 0;
  let pageIndex = 0;
  let collectionIndex = 0;

  let isAutoLoading = false;

  // ===========================
  // LOAD ALL PAGINATE PAGES (Liquid-driven)
  // ===========================
  async function loadNextPage() {
    const nextBtn = document.getElementById('search-next-btn');
    if (!nextBtn || !nextBtn.dataset.nextUrl) return;

    try {
      const response = await fetch(nextBtn.dataset.nextUrl, { credentials: 'same-origin' });
      const html = await response.text();

      const doc = new DOMParser().parseFromString(html, 'text/html');

      // Execute scripts that push into window.SearchData (products/pages/articles)
      doc.querySelectorAll('script').forEach(script => {
        const code = script.textContent || '';
        if (code.includes('window.SearchData') && (code.includes('.products.push') || code.includes('.pages.push') || code.includes('.articles.push'))) {
          try { eval(code); } catch (e) { console.error('eval error:', e); }
        }
      });

      // Update next URL and recurse
      const newNextBtn = doc.querySelector('#search-next-btn');
      if (newNextBtn && newNextBtn.dataset.nextUrl) {
        nextBtn.dataset.nextUrl = newNextBtn.dataset.nextUrl;
        await loadNextPage();
      } else {
        nextBtn.removeAttribute('data-next-url');
      }
    } catch (err) {
      console.error('Error loading next page:', err);
    }
  }

  // ===========================
  // FETCH COLLECTIONS (Suggest API)
  // ===========================
    async function fetchCollectionsSuggest(term) {
        if (!term) return;

        try {
            const res = await fetch(
            `/search/suggest.json?q=${encodeURIComponent(term)}&resources[type]=collection&resources[limit]=50`,
            { headers: { Accept: 'application/json' } }
            );

            if (!res.ok) throw new Error(res.status);

            const data = await res.json();
            const collections = data?.resources?.results?.collections || [];

            window.SearchData = window.SearchData || { products: [], pages: [], articles: [], collections: [] };

            window.SearchData.collections = collections.map(c => ({
            title: c.title,
            url: c.url,
            html: `
                <div class="col-12 search-item">
                    <div class="search-page-item">
                                        
                        <a href="${c.url}" class="pp-semibold f-black">
                            <span class="body-xl d-lg-block d-md-block d-sm-none">
                                ${escapeHtml(c.title)}
                            </span>
                            <span class="body d-lg-none d-md-none d-sm-block">
                                ${escapeHtml(c.title)}
                            </span>
                        </a>

                    </div>
                </div>
            `
            }));

            // toggle empty state
            const empty = document.getElementById('collection-empty');
            const footer = document.getElementById('collection-collection-footer');
            const container = document.getElementById('collection-results-container');
            const btn = document.getElementById('collection-load-more');

            if (collections.length === 0) {
                // show empty message
                if (empty) empty.style.display = '';

                // hide footer + button
                if (footer) footer.style.display = 'none';
                if (btn) btn.style.display = 'none';

                // clear results
                if (container) container.innerHTML = '';
            } else {
                // hide empty message
                if (empty) empty.style.display = 'none';

                // show footer (button visibility handled by pagination logic)
                if (footer) footer.style.removeProperty('display');
                if (btn) btn.style.removeProperty('display');
            }

            // update counts
            renderCountTab();

        } catch (e) {
            console.error('Collection suggest fetch error:', e);
        }
    }

    function escapeHtml(str) {
        return String(str || '').replace(/[&<>"']/g, (m) => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[m]));
    }


  // ===========================
  // UI HELPERS
  // ===========================
  function getActiveTabType() {
    const active = document.querySelector('.tab-search .tab-item.active');
    return active ? active.dataset.item : 'product';
  }

  function getActiveContainerAndButton() {
    const type = getActiveTabType();
    if (type === 'product') return { container: document.getElementById('search-results-container'), btn: document.getElementById('load-more') };
    if (type === 'article') return { container: document.getElementById('article-results-container'), btn: document.getElementById('article-load-more') };
    if (type === 'page') return { container: document.getElementById('page-results-container'), btn: document.getElementById('page-load-more') };
    if (type === 'collection') return { container: document.getElementById('collection-results-container'), btn: document.getElementById('collection-load-more') };
    return { container: null, btn: null };
  }

  function renderCountTab() {
    const productCountEl = document.querySelector('.tab-search .tab-item[data-item="product"] .content-count');
    const pageCountEl = document.querySelector('.tab-search .tab-item[data-item="page"] .content-count');
    const articleCountEl = document.querySelector('.tab-search .tab-item[data-item="article"] .content-count');
    const collectionCountEl = document.querySelector('.tab-search .tab-item[data-item="collection"] .content-count');

    const productFinal = document.querySelector('.product-count-text .final-count');
    const pageFinal = document.querySelector('.page-count-text .final-count');
    const articleFinal = document.querySelector('.article-count-text .final-count');
    const collectionFinal = document.querySelector('.collection-count-text .final-count');

    if (productCountEl) productCountEl.textContent = window.SearchData.products.length;
    if (pageCountEl) pageCountEl.textContent = window.SearchData.pages.length;
    if (articleCountEl) articleCountEl.textContent = window.SearchData.articles.length;
    if (collectionCountEl) collectionCountEl.textContent = window.SearchData.collections.length;

    if (productFinal) productFinal.textContent = window.SearchData.products.length;
    if (pageFinal) pageFinal.textContent = window.SearchData.pages.length;
    if (articleFinal) articleFinal.textContent = window.SearchData.articles.length;
    if (collectionFinal) collectionFinal.textContent = window.SearchData.collections.length;
  }
    function updateTopResultCount() {
        const total =
            (window.SearchData?.products?.length || 0) +
            (window.SearchData?.pages?.length || 0) +
            (window.SearchData?.articles?.length || 0) +
            (window.SearchData?.collections?.length || 0);

        const totalEl = document.getElementById('search-total-count');
        if (totalEl) totalEl.textContent = total;
    }

function updateSearchPageTitle() {
  const total =
    (window.SearchData?.products?.length || 0) +
    (window.SearchData?.pages?.length || 0) +
    (window.SearchData?.articles?.length || 0) +
    (window.SearchData?.collections?.length || 0);

  const term = document.getElementById('search-term')?.textContent || SEARCH_TERM || '';

  const baseTitle = 'Venustas® Heated Apparel';
  const plural = total === 1 ? 'result' : 'results';

  document.title = `Search: ${total} ${plural} found for "${term}" – ${baseTitle}`;
}


  // ===========================
  // RENDERERS
  // ===========================
  function renderNextProducts() {
    const container = document.getElementById('search-results-container');
    if (!container) return;

    const total = window.SearchData.products.length;
    const batch = window.SearchData.products.slice(productIndex, productIndex + productPerPage);

    batch.forEach(item => {
      const wrapper = document.createElement('div');
      wrapper.className = 'col-lg-4 col-md-4 col-sm-6 search-item';
      wrapper.innerHTML = item.html;
      container.appendChild(wrapper);
    });

    if (window.applySwatchFallbacks) {
      window.applySwatchFallbacks(container);
    }

    const start = total === 0 ? 0 : (productIndex + 1);
    productIndex += batch.length;
    const end = Math.min(productIndex, total);

    const rangeEl = document.getElementById('search-range');
    if (rangeEl) rangeEl.textContent = `${start}–${end}`;

    const btn = document.getElementById('load-more');
    if (productIndex >= total && btn) btn.style.display = 'none';
  }

  function renderNextArticles() {
    const container = document.getElementById('article-results-container');
    if (!container) return;

    const total = window.SearchData.articles.length;
    const slice = window.SearchData.articles.slice(articleIndex, articleIndex + articlePerPage);

    slice.forEach(item => {
      const div = document.createElement('div');
      div.className = 'col-12 search-item';
      div.innerHTML = item.html;
      container.appendChild(div);
    });

    const start = total === 0 ? 0 : (articleIndex + 1);
    articleIndex += slice.length;
    const end = Math.min(articleIndex, total);

    const rangeEl = document.getElementById('article-range');
    if (rangeEl) rangeEl.textContent = `${start}–${end}`;

    const btn = document.getElementById('article-load-more');
    if (articleIndex >= total && btn) btn.style.display = 'none';
  }

  function renderNextPages() {
    const container = document.getElementById('page-results-container');
    if (!container) return;

    const total = window.SearchData.pages.length;
    const slice = window.SearchData.pages.slice(pageIndex, pageIndex + pagePerPage);

    slice.forEach(item => {
      const div = document.createElement('div');
      div.className = 'col-12 search-item';
      div.innerHTML = item.html;
      container.appendChild(div);
    });

    const start = total === 0 ? 0 : (pageIndex + 1);
    pageIndex += slice.length;
    const end = Math.min(pageIndex, total);

    const rangeEl = document.getElementById('page-range');
    if (rangeEl) rangeEl.textContent = `${start}–${end}`;

    const btn = document.getElementById('page-load-more');
    if (pageIndex >= total && btn) btn.style.display = 'none';
  }

  function renderNextCollections() {
    const container = document.getElementById('collection-results-container');
    if (!container) return;

    const total = window.SearchData.collections.length;
    const slice = window.SearchData.collections.slice(collectionIndex, collectionIndex + collectionPerPage);

    slice.forEach(item => {
      const div = document.createElement('div');
      div.className = 'col-12 search-item';
      div.innerHTML = item.html;
      container.appendChild(div);
    });

    const start = total === 0 ? 0 : (collectionIndex + 1);
    collectionIndex += slice.length;
    const end = Math.min(collectionIndex, total);

    const rangeEl = document.getElementById('collection-range');
    if (rangeEl) rangeEl.textContent = `${start}–${end}`;

    const btn = document.getElementById('collection-load-more');
    if (collectionIndex >= total && btn) btn.style.display = 'none';
  }

  function renderActiveTabBatch() {
    const t = getActiveTabType();
    if (t === 'product') renderNextProducts();
    if (t === 'article') renderNextArticles();
    if (t === 'page') renderNextPages();
    if (t === 'collection') renderNextCollections();
  }

  function resetAndRerenderAll() {
    ['search-results-container','article-results-container','page-results-container','collection-results-container'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = '';
    });

    productIndex = 0;
    articleIndex = 0;
    pageIndex = 0;
    collectionIndex = 0;

    ['load-more','article-load-more','page-load-more','collection-load-more'].forEach(id => {
      const btn = document.getElementById(id);
      if (btn) btn.style.removeProperty('display');
    });

    renderActiveTabBatch();
  }

  // ===========================
  // EVENTS
  // ===========================
  function bindEvents() {
    document.getElementById('load-more')?.addEventListener('click', renderNextProducts);
    document.getElementById('article-load-more')?.addEventListener('click', renderNextArticles);
    document.getElementById('page-load-more')?.addEventListener('click', renderNextPages);
    document.getElementById('collection-load-more')?.addEventListener('click', renderNextCollections);

    // Tabs
    document.querySelectorAll('.tab-search .tab-item').forEach(tab => {
      tab.addEventListener('click', function() {
        const tabType = this.dataset.item;

        document.querySelectorAll('.tab-search .tab-item').forEach(el => el.classList.remove('active'));
        this.classList.add('active');

        document.querySelectorAll('.tab-section').forEach(el => el.style.display = 'none');
        const section = document.querySelector(`.tab-section[data-item="${tabType}"]`);
        if (section) section.style.display = '';

        resetAndRerenderAll();
      });
    });

    // Auto scroll pagination (ACTIVE tab only)
    window.addEventListener('scroll', () => {
      const { container, btn } = getActiveContainerAndButton();
      if (!container || !btn || btn.style.display === 'none') return;
      if (isAutoLoading) return;

      const scrollBottom = window.scrollY + window.innerHeight;
      const containerBottom = container.offsetTop + container.offsetHeight;

      if (scrollBottom >= containerBottom - 500) {
        isAutoLoading = true;
        btn.click();
        setTimeout(() => { isAutoLoading = false; }, 150);
      }
    }, { passive: true });
  }



    function initSearchFilters() {
    const filterForm = document.querySelector('.filter-form.desktop');
    if (!filterForm) return;

    const pillsWrap = document.querySelector('.filter-list-container-tab');
    const counterEl = document.querySelector('.filter-counter-products');
    const clearBtn = document.querySelector('.clear-filter.desktop'); // ✅ it's a div
    const sortSelect = document.getElementById('SearchSortBy');

    // ✅ Update URL in address bar (no reload)
    const updateBrowserUrl = (url) => {
        window.history.replaceState({}, '', url.toString());
    };

    // Build URL based on checked filters
    const buildFilterUrl = () => {
        const url = new URL(window.location.origin + window.location.pathname);

        // keep term + prefix
        url.searchParams.set('q', "{{ search.terms | escape }}");
        url.searchParams.set('options[prefix]', 'last');

        // keep sort
        if (sortSelect?.value) url.searchParams.set('sort_by', sortSelect.value);

        // add checked filters
        filterForm.querySelectorAll('input[type="checkbox"]:checked').forEach(chk => {
        url.searchParams.append(chk.name, chk.value);
        });

        return url;
    };

    // Build "selected filters" pills
    const renderPills = () => {
        if (!pillsWrap) return;

        const checked = Array.from(filterForm.querySelectorAll('input[type="checkbox"]:checked'));

        pillsWrap.innerHTML = '';

        if (counterEl) {
        counterEl.textContent = checked.length ? `${checked.length} Selected` : 'All';
        }

        // hide/show clear
        if (clearBtn) clearBtn.style.display = checked.length ? '' : 'none';

        checked.forEach(chk => {
        const label = filterForm.querySelector(`label[for="${CSS.escape(chk.id)}"]`);
        const valueText =
            label?.querySelector('.value')?.textContent?.trim() ||
            label?.querySelector('.color-text')?.textContent?.trim() ||
            chk.value;

        // ✅ Build URL WITHOUT this filter (so pill can be a link too)
        const urlWithoutThis = new URL(window.location.origin + window.location.pathname);
        urlWithoutThis.searchParams.set('q', "{{ search.terms | escape }}");
        urlWithoutThis.searchParams.set('options[prefix]', 'last');
        if (sortSelect?.value) urlWithoutThis.searchParams.set('sort_by', sortSelect.value);

        checked.forEach(other => {
            if (other === chk) return;
            urlWithoutThis.searchParams.append(other.name, other.value);
        });

        const pill = document.createElement('div');
        pill.className = 'filter-item';
        pill.dataset.id = chk.id;

        // ✅ pill text is now an <a href="..."> (shareable link)
        pill.innerHTML = `
            <a class="pp-regular body filter-pill-link" href="${urlWithoutThis.toString()}">
            ${escapeHtml(valueText)}
            </a>
            <button type="button" class="remove-filter" aria-label="Remove filter">×</button>
        `;

        pillsWrap.appendChild(pill);
        });
    };

    // Fetch filtered products (your view=ajax endpoint)
    const fetchFilteredProducts = async () => {
        const url = buildFilterUrl();

        // ✅ Update URL in the browser (shareable)
        updateBrowserUrl(url);

        try {
        const res = await fetch(url.toString() + '&view=ajax', { credentials: 'same-origin' });
        if (!res.ok) throw new Error(res.status);

        const data = await res.json();

        // Expecting: data.products = [{html,...}] based on your existing code
        if (data?.products) {
            window.SearchData = window.SearchData || { products: [], pages: [], articles: [], collections: [] };
            window.SearchData.products = data.products;

            // reset product container + pagination index and re-render
            const productContainer = document.getElementById('search-results-container');
            if (productContainer) productContainer.innerHTML = '';

            // reset indices
            if (typeof productIndex !== 'undefined') productIndex = 0;
            if (typeof currentIndex !== 'undefined') currentIndex = 0;

            // show load more again
            const loadMoreBtn = document.getElementById('load-more');
            if (loadMoreBtn) loadMoreBtn.style.removeProperty('display');

            // render first batch
            if (typeof renderNextProducts === 'function') renderNextProducts();

            if (window.applySwatchFallbacks) {
                window.applySwatchFallbacks(document.getElementById('search-results-container') || document);
            }

            // update counts
            if (typeof renderCountTab === 'function') renderCountTab();
            if (typeof updateTopResultCount === 'function') updateTopResultCount();
            if (typeof updateSearchPageTitle === 'function') updateSearchPageTitle();
        }
        } catch (e) {
        console.error('Filter fetch error:', e);
        }
    };

    // Sync UI + data
    const applyFilters = async () => {
        renderPills();
        await fetchFilteredProducts();
    };

    // Checkbox changes
    filterForm.addEventListener('change', applyFilters);

    // Remove pill (X button)
    pillsWrap?.addEventListener('click', (e) => {
        const btn = e.target.closest('.remove-filter');
        if (!btn) return;

        const pill = btn.closest('.filter-item');
        if (!pill?.dataset.id) return;

        const chk = filterForm.querySelector(`#${CSS.escape(pill.dataset.id)}`);
        if (chk) chk.checked = false;

        applyFilters();
    });

    // ✅ Optional: clicking the pill link applies state WITHOUT reload
    pillsWrap?.addEventListener('click', (e) => {
        const link = e.target.closest('a.filter-pill-link');
        if (!link) return;

        e.preventDefault();

        // Update URL to link target
        const url = new URL(link.href);
        updateBrowserUrl(url);

        // Sync checkboxes to match the link's params
        syncCheckboxesFromUrl(url, filterForm);

        applyFilters();
    });

    // Clear all
    clearBtn?.addEventListener('click', () => {
        filterForm.querySelectorAll('input[type="checkbox"]').forEach(chk => chk.checked = false);
        applyFilters();
    });

    // If sort changes, re-apply filters
    sortSelect?.addEventListener('change', applyFilters);

    // Initial state
    renderPills();
    }

    // ✅ Sync checkbox UI from URL params
    function syncCheckboxesFromUrl(url, filterForm) {
    filterForm.querySelectorAll('input[type="checkbox"]').forEach(chk => chk.checked = false);

    url.searchParams.forEach((value, key) => {
        if (!key.startsWith('filter.')) return;

        const inputs = filterForm.querySelectorAll(`input[name="${CSS.escape(key)}"]`);
        const match = Array.from(inputs).find(chk => chk.value === value);
        if (match) match.checked = true;
    });
    }

    // helper
    function escapeHtml(str) {
    return String(str || '').replace(/[&<>"']/g, (m) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[m]));
    }

  // ===========================
  // INIT
  // ===========================
  document.addEventListener('DOMContentLoaded', async () => {
    bindEvents();

    // Load all liquid pages AND collections suggest
    await Promise.all([
      loadNextPage(),
      fetchCollectionsSuggest(SEARCH_TERM)
    ]);

    renderCountTab();
     updateTopResultCount();   
  updateSearchPageTitle();  // ✅ updates <title>
    resetAndRerenderAll();
    initSearchFilters();
  });

document.querySelectorAll('.tab-search .tab-item').forEach(tab => {
  tab.addEventListener('click', () => {
    if (window.innerWidth <= 991) {
      tab.scrollIntoView({
        behavior: 'smooth',
        inline: 'center',
        block: 'nearest'
      });
    }
  });
});


</script>



