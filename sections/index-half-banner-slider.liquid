{% style %}
    .half-banner-slider-section{
        content-visibility:auto;
        contain-intrinsic-size: 1px 980px;
    }
    .half-banner-slider-section .half-banner-container .float-nav button{
        background: #F1EADD;
    }
    .half-banner-slider-section .half-banner-container .float-nav button:hover{
        background: #B93205;
    }
    .half-banner-slider-section .half-banner-container .float-nav button i{
        color: #B93205;
    }
    .half-banner-slider-section .half-banner-container .float-nav button:hover i{
        color: #FFF;
    }
    .half-banner-slider-section .swiper-pagination{
        position:absolute;
        bottom: 15px;
        background-color: #505050;
        padding: 15px 0.6rem;
        border-radius: 50px;
        width: fit-content;
        display: flex;
        left: 0;
        right: 0;
        margin: auto;
    }
    .half-banner-slider-section .half-banner-item{
        overflow:hidden;
        border-radius:16px;
        height:100%;
        background-color:#000;
    }
    .half-banner-slider-section .half-banner-item img,
    .half-banner-slider-section .half-banner-item video{
        width:100%;
        height:100%;
        object-fit:contain;
    }
    .half-banner-slider-section .swiper-pagination .swiper-pagination-bullet{
        background: #FFF;
        opacity:1;
        margin:0px 8px;
    }
    .half-banner-slider-section .swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active{
        background: #B93205;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .half-banner-slider-section .swiper-pagination{
            padding: 10px 0.5rem;
            bottom:10px;
        }
        .half-banner-slider-section .swiper-pagination .swiper-pagination-bullet{
            margin:0px 6px;
            width:6px;
            height:6px;
        }
        .half-banner-slider-section .half-banner-item{
            border-radius:8px;
            height: 100%;
            width:100%;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="">
    <div class="container px-0">
        <div class="col-lg-6 col-md-8 col-sm-12 mx-auto">
            <div class="section-heading pp-bold title-sm f-black text-center">
                {{ section.settings.heading }}
            </div>
            <div class="section-description pp-regular body-lg f-black text-center d-lg-block d-md-block d-sm-none">
                {{ section.settings.description }}
            </div>
            <div class="section-description pp-regular body f-black text-center d-lg-none d-md-none d-sm-block">
                {{ section.settings.description }}
            </div>
        </div>
    </div>
    <div class="half-banner-container position-relative pt-lg-4 pt-md-4 pt-sm-4">
        <div class="container section-content pt-0">
            <div class="half-banner-slider position-relative overflow-hidden">
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        <div class="swiper-slide">
                            {% if block.settings.url != blank %}
                            <a href="{{ block.settings.url }}" class="d-flex justify-content-center">
                            {% else %}
                            <div class="d-flex justify-content-center">
                            {% endif %}

                                <div class="half-banner-item">
                                    {% if block.type == 'image' %}
                                        {% if block.settings.background_mobile != blank %}

                                            <picture>
                                                <source
                                                    media="(max-width: 767.98px)"
                                                    srcset="
                                                        {{ block.settings.background_mobile | image_url: width: 360 }} 360w,
                                                        {{ block.settings.background_mobile | image_url: width: 540 }} 540w,
                                                        {{ block.settings.background_mobile | image_url: width: 768 }} 768w,
                                                        {{ block.settings.background_mobile | image_url: width: 900 }} 900w
                                                    "
                                                    sizes="100vw">
                                                <source
                                                    media="(min-width: 768px)"
                                                    srcset="
                                                        {{ block.settings.background | image_url: width: 480 }} 480w,
                                                        {{ block.settings.background | image_url: width: 768 }} 768w,
                                                        {{ block.settings.background | image_url: width: 1024 }} 1024w,
                                                        {{ block.settings.background | image_url: width: 1440 }} 1440w,
                                                        {{ block.settings.background | image_url: width: 1600 }} 1600w
                                                    "
                                                    sizes="100vw">
                                                <img
                                                    src="{{ block.settings.background_mobile | image_url: width: 900 }}"
                                                    width="{{ block.settings.background_mobile.width | default: block.settings.background.width }}"
                                                    height="{{ block.settings.background_mobile.height | default: block.settings.background.height }}"
                                                    alt="{{ block.settings.background_mobile.alt | default: block.settings.background.alt | escape }}"
                                                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                                                    fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                                                    decoding="async"
                                                />
                                            </picture>
                                        {% else %}
                                            <img
                                                src="{{ block.settings.background | image_url: width: 1440 }}"
                                                srcset="
                                                    {{ block.settings.background | image_url: width: 480 }} 480w,
                                                    {{ block.settings.background | image_url: width: 768 }} 768w,
                                                    {{ block.settings.background | image_url: width: 1024 }} 1024w,
                                                    {{ block.settings.background | image_url: width: 1440 }} 1440w,
                                                    {{ block.settings.background | image_url: width: 1600 }} 1600w
                                                "
                                                sizes="100vw"
                                                width="{{ block.settings.background.width }}"
                                                height="{{ block.settings.background.height }}"
                                                alt="{{ block.settings.background.alt | escape }}"
                                                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                                                fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                                                decoding="async"
                                            />
                                        {% endif %}

                                    {% else %}
                                        {% assign v = block.settings.background %}
                                        {% assign poster_img = v.preview_image %}
                                        {% assign poster_url = poster_img | image_url: width: 2000 %}

                                        <video
                                            playsinline
                                            webkit-playsinline
                                            autoplay
                                            loop
                                            muted
                                            preload="auto"
                                            poster="{{ poster_url }}"
                                        >
                                            {% assign mp4 = v.sources | where: 'mime_type', 'video/mp4' | first %}
                                            {% if mp4 %}
                                                <source src="{{ mp4.url }}" type="{{ mp4.mime_type }}">
                                            {% else %}
                                                {%- for s in v.sources -%}
                                                <source src="{{ s.url }}" type="{{ s.mime_type }}">
                                                {%- endfor -%}
                                            {% endif %}

                                            <img
                                                src="{{ poster_img | image_url: width: 1200 }}"
                                                alt="{{ block.settings.alt_text | default: block.settings.heading | default: 'Background video' | escape }}"
                                                loading="lazy"
                                                decoding="async"
                                            >
                                        </video>
                                    {% endif %}
                                </div>
                                
                            {% if block.settings.url != blank %}
                            </a>
                            {% else %}
                            </div>
                            {% endif %}
                        </div>    
                    {% endfor %}  
                </div>
                
                <div class="swiper-pagination"></div>
            </div>
        </div>
        <div class="float-nav d-lg-block d-md-block d-sm-none">
            <button type="button" class="owl-prev" disabled>
                <i class="fa-solid fa-chevron-left f-white"></i>
            </button>
            <button type="button" class="owl-next" disabled>
                <i class="fa-solid fa-chevron-right f-white"></i>
            </button>
        </div>
    </div>
</div>
{% schema %}
{
    "class": "half-banner-slider-section",
    "name": "Half Banner Slider",
    "limit": 1,
    "templates": ["index"],
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Our Tech"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>We use technology to reshape warmth for you</p>"
        }
    ],
    "blocks": [
        {
            "type": "image",
            "name": "Image",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "background",
                    "label": "Background Image"
                },
                {
                    "type": "image_picker",
                    "id": "background_mobile",
                    "label": "Background Image - Mobile"
                },
                {
                    "type": "url",
                    "id": "url",
                    "label": "URL"
                }
            ]
        },
        {
            "type": "video",
            "name": "Video",
            "settings": [
                {
                    "type": "video",
                    "id": "background",
                    "label": "Background Video"
                },
                {
                    "type": "url",
                    "id": "url",
                    "label": "URL"
                }
            ]
        },
    ],
    "presets": [
        {
            "name": "Half Banner Slider"
        }
    ]
}
{% endschema %}
