{%- comment -%}
  Product Feature Tiles
  Image-tile grid for feature highlights, color showcase, use cases.
  Layout:
    - "grid"     : uniform N-column grid (Colors, Use cases)
    - "featured" : 2x2 small tiles + a tall tile spanning both rows on the right
                   (expects 5 tiles; the tall one is the LAST tile)
  Mobile can be a horizontal swipe row (mobile_scroll).
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    --ft-accent: {{ section.settings.accent_color }};
  }
  {% if section.settings.background_image != blank %}
    #shopify-section-{{ section.id }} {
      background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
      background-size: cover;
      background-position: {{ section.settings.background_position }};
      background-repeat: no-repeat;
    }
  {% endif %}
  #shopify-section-{{ section.id }} .container {
    padding-left: 40px;
    padding-right: 40px;
  }
  #shopify-section-{{ section.id }} .ft { padding: 64px 0; }
  #shopify-section-{{ section.id }} .ft__heading {
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    text-align: center;
    margin-bottom: {% if section.settings.subheading == blank %}40px{% else %}8px{% endif %};
    text-transform: {{ section.settings.heading_transform }};
  }
  #shopify-section-{{ section.id }} .ft__subheading {
    text-align: center;
    color: #5a6470;
    font-size: 15px;
    max-width: 720px;
    margin: 0 auto 40px;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .ft__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }
  #shopify-section-{{ section.id }} .ft__tile {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: {% if section.settings.transparent_tiles %}transparent{% else %}#e7edf3{% endif %};
  }
  {% if section.settings.transparent_tiles %}
    #shopify-section-{{ section.id }} .ft__img {
      background: transparent;
    }
    #shopify-section-{{ section.id }} .ft__img img,
    #shopify-section-{{ section.id }} .ft__img svg {
      object-fit: contain;
    }
  {% endif %}
  #shopify-section-{{ section.id }} .ft__img {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: {{ section.settings.tile_ratio }};
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .ft__img img,
  #shopify-section-{{ section.id }} .ft__img svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Overlay caption */
  #shopify-section-{{ section.id }} .ft--overlay .ft__caption {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    padding: 22px 22px 18px;
    {% if section.settings.overlay_scrim %}
    background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.45) 45%, rgba(0,0,0,0) 100%);
    {% endif %}
    color: #fff;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .ft--overlay .ft__title { color: #fff; margin-bottom: 5px; }
  #shopify-section-{{ section.id }} .ft--overlay .ft__subtitle { color: rgba(255,255,255,0.88); }
  /* Below caption */
  #shopify-section-{{ section.id }} .ft--below .ft__caption { padding: 16px 14px 18px; text-align: center; }
  #shopify-section-{{ section.id }} .ft__title {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.3;
    margin: 0 0 4px;
  }
  #shopify-section-{{ section.id }} .ft__subtitle {
    font-size: 13.5px;
    color: #6a7682;
    line-height: 1.5;
    margin: 0;
  }

  /* ---- Featured layout: 2x2 + tall last tile ---- */
  #shopify-section-{{ section.id }} .ft__grid.is-featured {
    grid-template-columns: 1fr 1fr 1fr;
  }
  #shopify-section-{{ section.id }} .ft__grid.is-featured .ft__tile:nth-child(1) { grid-column: 1; grid-row: 1; }
  #shopify-section-{{ section.id }} .ft__grid.is-featured .ft__tile:nth-child(2) { grid-column: 2; grid-row: 1; }
  #shopify-section-{{ section.id }} .ft__grid.is-featured .ft__tile:nth-child(3) { grid-column: 1; grid-row: 2; }
  #shopify-section-{{ section.id }} .ft__grid.is-featured .ft__tile:nth-child(4) { grid-column: 2; grid-row: 2; }
  #shopify-section-{{ section.id }} .ft__grid.is-featured .ft__tile:nth-child(5) { grid-column: 3; grid-row: 1 / span 2; }
  /* the tall tile fills its 2-row cell */
  #shopify-section-{{ section.id }} .ft__grid.is-featured .ft__tile:nth-child(5) .ft__img {
    aspect-ratio: auto;
    height: 100%;
    min-height: 100%;
  }

  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .ft__grid:not(.is-featured) {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .container { padding-left: 20px; padding-right: 20px; }
    #shopify-section-{{ section.id }} .ft { padding: 44px 0; }

    /* Overlay tiles → separated image (top) + text (below) on mobile */
    #shopify-section-{{ section.id }} .ft--overlay .ft__tile { background: #fff; }
    #shopify-section-{{ section.id }} .ft--overlay .ft__caption {
      position: static;
      background: none;
      padding: 14px 16px 18px;
      text-align: left;
    }
    #shopify-section-{{ section.id }} .ft--overlay .ft__title {
      color: {{ section.settings.heading_color }};
      font-size: 16px;
    }
    #shopify-section-{{ section.id }} .ft--overlay .ft__subtitle { color: #6a7682; }

    {% if section.settings.mobile_scroll %}
      /* Horizontal swipe row */
      #shopify-section-{{ section.id }} .ft__grid {
        display: flex;
        grid-template-columns: none;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
        gap: 12px;
        padding-bottom: 6px;
      }
      #shopify-section-{{ section.id }} .ft__grid::-webkit-scrollbar { display: none; }
      #shopify-section-{{ section.id }} .ft__tile {
        flex: 0 0 80%;
        scroll-snap-align: start;
      }
      #shopify-section-{{ section.id }} .ft__grid.is-featured .ft__tile:nth-child(5) .ft__img {
        aspect-ratio: {{ section.settings.tile_ratio }};
        height: auto;
        min-height: 0;
      }
    {% else %}
      #shopify-section-{{ section.id }} .ft__grid {
        grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
        gap: 12px;
      }
      #shopify-section-{{ section.id }} .ft__grid.is-featured .ft__tile:nth-child(n) { grid-column: auto; grid-row: auto; }
      #shopify-section-{{ section.id }} .ft__grid.is-featured .ft__tile:nth-child(5) .ft__img {
        aspect-ratio: {{ section.settings.tile_ratio }};
        height: auto;
        min-height: 0;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ft">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="ft__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="ft__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="ft__grid ft--{{ section.settings.caption_style }}{% if section.settings.layout == 'featured' %} is-featured{% endif %}">
      {% for block in section.blocks %}
        <div class="ft__tile" {{ block.shopify_attributes }}>
          <div class="ft__img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          {% if block.settings.title != blank %}
            <div class="ft__caption">
              <p class="ft__title">{{ block.settings.title }}</p>
              {% if block.settings.subtitle != blank %}<p class="ft__subtitle">{{ block.settings.subtitle }}</p>{% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature Tiles",
  "class": "product-feature-tiles-section",
  "templates": ["product"],
  "settings": [
    { "type": "checkbox", "id": "enabled_section_child_scroll", "label": "Enable scroll nav anchor", "default": false },
    { "type": "text", "id": "section_scroll_nav", "label": "Scroll Nav Group" },
    { "type": "text", "id": "nav_title", "label": "Nav Title" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "image_picker", "id": "background_image", "label": "Background Image", "info": "Optional. Overrides the background color. Used e.g. for the Colors snow backdrop." },
    {
      "type": "select", "id": "background_position", "label": "Background Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ], "default": "center center"
    },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#01132F" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#1C80FE" },
    { "type": "text", "id": "heading", "label": "Section Title", "default": "Details" },
    {
      "type": "select", "id": "heading_transform", "label": "Heading Case",
      "options": [
        { "value": "none", "label": "As typed" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize" }
      ], "default": "uppercase"
    },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "grid", "label": "Uniform grid" },
        { "value": "featured", "label": "Featured (2x2 + tall last tile · needs 5 tiles)" }
      ], "default": "grid"
    },
    {
      "type": "select", "id": "caption_style", "label": "Caption Style",
      "options": [
        { "value": "overlay", "label": "Overlay on image" },
        { "value": "below", "label": "Below image" }
      ], "default": "overlay"
    },
    { "type": "checkbox", "id": "overlay_scrim", "label": "Overlay: dark gradient behind caption", "info": "Only applies to the Overlay caption style. Turn off to remove the dark scrim (text stays white — best on darker images).", "default": true },
    {
      "type": "select", "id": "tile_ratio", "label": "Tile Image Ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 10", "label": "Wide (16:10)" }
      ], "default": "4 / 3"
    },
    { "type": "range", "id": "columns", "label": "Columns (Desktop, grid layout)", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_tablet", "label": "Columns (Tablet, grid layout)", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (Mobile, grid layout)", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "checkbox", "id": "transparent_tiles", "label": "Transparent tiles (show section background through)", "info": "Use with transparent-PNG images + a background image (e.g. Colors on snow).", "default": false },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Mobile: horizontal swipe", "default": false },
    { "type": "range", "id": "gap", "label": "Gap", "min": 6, "max": 40, "step": 2, "unit": "px", "default": 18 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "subtitle", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Tiles",
      "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ]
    }
  ]
}
{% endschema %}
