{%- comment -%}
  Banner Slider (Owl Carousel) - Optimized for LCP / Speed Index
  Key changes:
  - Replaced CSS background images with real <img> so browser can prioritize LCP.
  - Avoided "master" image size; use image_url widths + srcset.
  - First slide uses loading="eager" + fetchpriority="high".
  - Video slides: paint poster first; preload="none"; autoplay only after window load (first slide only).
{%- endcomment -%}

<style>
  #banner-slider-{{ section.id }} .item-wrapper{
    position: relative;
    overflow: hidden;
    /*min-height: 520px;  prevents layout jump; adjust to your design */
  }
  #banner-slider-{{ section.id }} .banner-bg{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  #banner-slider-{{ section.id }} .section-content,
  #banner-slider-{{ section.id }} .video-content-container{
    position: absolute;
    z-index: 1;
    top: 0;
    width: 100%;
    margin: auto;
    left: 0;
    right: 0;
  }
  #banner-slider-{{ section.id }} video.hero-video{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    /* Keep video from blocking first paint */
    opacity: 0;
    transition: opacity .3s ease;
  }
  #banner-slider-{{ section.id }} video.hero-video.is-playing{
    opacity: 1;
  }
</style>
<style>
  {% if section.settings.height_type == 'adapt_image_height' %}
    #banner-slider-{{ section.id }}{
      height: fit-content;
      min-height: 0;
    }

    #banner-slider-{{ section.id }} .banner-swiper,
    #banner-slider-{{ section.id }} .swiper-slide,
    #banner-slider-{{ section.id }} .item,
    #banner-slider-{{ section.id }} .item-wrapper{
      height: auto !important;
      min-height: 0;
    }

    #banner-slider-{{ section.id }} .swiper-wrapper{
      align-items: flex-start;
      min-height: 0;
    }

    #banner-slider-{{ section.id }} .banner-bg{
      position: unset;
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
      z-index: 0;
    }

    #banner-slider-{{ section.id }} .section-content,
    #banner-slider-{{ section.id }} .video-content-container{
      position: absolute;
      inset: 0;
    }
  {% elsif section.settings.height_type == 'custom_banner_height' %}

    #banner-slider-{{ section.id }} {
      height: {{ section.settings.desktop_banner_height }}px;
    }

    @media screen and (max-width: 991px) {
      #banner-slider-{{ section.id }} {
        height: {{ section.settings.tablet_banner_height }}px;
      }
    }

    @media screen and (max-width: 767px) {
      #banner-slider-{{ section.id }} {
        height: {{ section.settings.mobile_banner_height }}px;
      }
    }
  {% endif %}
</style>
<script>
  window.enabled_transparent_banner_slider = {{ section.settings.enabled_transparent_header | json }};
  window.enabled_banner_loop = {{ section.settings.enabled_loop | json }};
</script>

{% javascript %}
  // Header scroll state (throttled)
  (function () {
    let last = 0;
    window.addEventListener('scroll', function () {
      const now = Date.now();
      if (now - last < 100) return;
      last = now;

      const header = document.querySelector('.header');
      if (!header) return;

      if (window.scrollY >= 100) header.classList.add('scrolled');
      else header.classList.remove('scrolled');
    }, { passive: true });
  })();

{% endjavascript %}

