{% assign first_block = section.blocks.first %}
{% if first_block %}
  {% if first_block.type == 'image' %}
    {% assign first_desktop_img = first_block.settings.background_desktop %}
    {% assign first_mobile_img = first_block.settings.background_mobile %}
    {% if first_desktop_img != blank %}
      <link
        rel="preload"
        as="image"
        href="{{ first_desktop_img | image_url: width: 1600 }}"
        imagesrcset="
          {{ first_desktop_img | image_url: width: 960 }} 960w,
          {{ first_desktop_img | image_url: width: 1400 }} 1400w,
          {{ first_desktop_img | image_url: width: 1600 }} 1600w"
        imagesizes="100vw"
        media="(min-width: 992px)"
        fetchpriority="high">
    {% endif %}
    {% if first_mobile_img != blank %}
      <link
        rel="preload"
        as="image"
        href="{{ first_mobile_img | image_url: width: 900 }}"
        imagesrcset="
          {{ first_mobile_img | image_url: width: 480 }} 480w,
          {{ first_mobile_img | image_url: width: 768 }} 768w,
          {{ first_mobile_img | image_url: width: 900 }} 900w"
        imagesizes="100vw"
        media="(max-width: 991.98px)"
        fetchpriority="high">
    {% endif %}
  {% elsif first_block.type == 'video' %}
    {% assign first_desktop_video = first_block.settings.background_desktop %}
    {% assign first_mobile_video = first_block.settings.background_mobile %}
    {% if first_desktop_video != blank and first_desktop_video.preview_image != blank %}
      <link
        rel="preload"
        as="image"
        href="{{ first_desktop_video.preview_image | image_url: width: 1600 }}"
        imagesrcset="
          {{ first_desktop_video.preview_image | image_url: width: 960 }} 960w,
          {{ first_desktop_video.preview_image | image_url: width: 1400 }} 1400w,
          {{ first_desktop_video.preview_image | image_url: width: 1600 }} 1600w"
        imagesizes="100vw"
        media="(min-width: 992px)"
        fetchpriority="high">
    {% endif %}
    {% if first_mobile_video != blank and first_mobile_video.preview_image != blank %}
      <link
        rel="preload"
        as="image"
        href="{{ first_mobile_video.preview_image | image_url: width: 900 }}"
        imagesrcset="
          {{ first_mobile_video.preview_image | image_url: width: 480 }} 480w,
          {{ first_mobile_video.preview_image | image_url: width: 768 }} 768w,
          {{ first_mobile_video.preview_image | image_url: width: 900 }} 900w"
        imagesizes="100vw"
        media="(max-width: 991.98px)"
        fetchpriority="high">
    {% endif %}
  {% endif %}
{% endif %}
<section
  class="banner-slider"
  id="banner-slider-{{ section.id }}"
  data-height-type="{{ section.settings.height_type }}">
  <div class="swiper banner-swiper{% unless section.settings.height_type == 'adapt_image_height' %} h-100{% endunless %}">
    <div class="swiper-wrapper{% unless section.settings.height_type == 'adapt_image_height' %} h-100{% endunless %}">
      {% for block in section.blocks %}
        {% assign is_first_slide = forloop.first %}

        {% if block.type == 'image' %}
          {% assign desktop_img = block.settings.background_desktop %}
          {% assign mobile_img  = block.settings.background_mobile %}

          <div class="swiper-slide item" {{ block.shopify_attributes }}>
            <div class="item-wrapper no-image-overlay">
              {% if desktop_img != blank or mobile_img != blank %}
                <picture>
                  {% if mobile_img != blank %}
                    <source
                      media="(max-width: 991.98px)"
                      srcset="
                        {{ mobile_img | image_url: width: 480 }} 480w,
                        {{ mobile_img | image_url: width: 768 }} 768w,
                        {{ mobile_img | image_url: width: 900 }} 900w"
                      sizes="100vw">
                  {% endif %}
                  {% if desktop_img != blank %}
                    <source
                      media="(min-width: 992px)"
                      srcset="
                        {{ desktop_img | image_url: width: 960 }} 960w,
                        {{ desktop_img | image_url: width: 1400 }} 1400w,
                        {{ desktop_img | image_url: width: 1600 }} 1600w"
                      sizes="100vw">
                  {% endif %}
                  <img
                    class="banner-bg"
                    src="{% if mobile_img != blank %}{{ mobile_img | image_url: width: 900 }}{% else %}{{ desktop_img | image_url: width: 1600 }}{% endif %}"
                    width="{% if mobile_img != blank %}{{ mobile_img.width }}{% else %}{{ desktop_img.width }}{% endif %}"
                    height="{% if mobile_img != blank %}{{ mobile_img.height }}{% else %}{{ desktop_img.height }}{% endif %}"
                    alt="{{ mobile_img.alt | default: desktop_img.alt | default: block.settings.title | default: shop.name | escape }}"
                    loading="{% if is_first_slide %}eager{% else %}lazy{% endif %}"
                    fetchpriority="{% if is_first_slide %}high{% else %}auto{% endif %}"
                    decoding="{% if is_first_slide %}sync{% else %}async{% endif %}"
                  >
                </picture>
              {% endif %}
              {% if block.settings.btn_url != blank %}
                <a
                  href="{{ block.settings.btn_url }}"
                  class="full-slide-link"
                  data-banner-id="{{ block.settings.banner_id | default: 'banner-missing' }}"
                  aria-label="{{ block.settings.btn_text | default: block.settings.title | default: 'Open banner link' | strip_html | escape }}"
                ></a>
              {% endif %}

              <div class="container section-content h-100 d-lg-block d-md-none d-sm-none">
                <div class="desktop-container row justify-content-{{ block.settings.horizontal_alignment }} align-items-{{ block.settings.vertical_alignment }} h-100">
                  <div class="col-lg-5 col-md-5 col-sm-12 custom-w d-flex flex-column align-items-{{ block.settings.text_alignment }} text-{{ block.settings.text_alignment }}">
                    {% if block.settings.subtitle != blank %}
                      <div class="overflow-hidden width-fit-content">
                        <p class="block-subtitle body-xl pp-regular mb-2" style="color: {{ block.settings.subtitle_color }}">
                          {{ block.settings.subtitle | newline_to_br }}
                        </p>
                      </div>
                    {% endif %}
                    {% if block.settings.title != blank %}
                      <div class="overflow-hidden width-fit-content">
                        <div class="block-title {{ block.settings.title_font_size }} pp-bold mb-3" style="color: {{ block.settings.title_color }}">
                          {{ block.settings.title }}
                        </div>
                      </div>
                    {% endif %}
                    {% if block.settings.description != blank %}
                      <div class="overflow-hidden width-fit-content">
                        <p class="block-description body-xl pp-regular mb-4" style="color: {{ block.settings.description_color }}">
                          {{ block.settings.description | newline_to_br }}
                        </p>
                      </div>
                    {% endif %}
                    {% if block.settings.btn_text != blank and block.settings.btn_url != blank %}
                      <div class="overflow-hidden width-fit-content">
                        <a href="{{ block.settings.btn_url }}" class="block-btn btn-hover btn-main btn-no-animation">
                          <span class="pp-regular body-xl l-h-normal px-1">
                            {{ block.settings.btn_text }}
                          </span>
                        </a>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>

              <div class="container section-content h-100 d-lg-none d-md-block d-sm-block">
                <div class="row justify-content-{{ block.settings.horizontal_alignment_mobile }} align-items-{{ block.settings.vertical_alignment_mobile }} h-100 py-5">
                  <div class="col-12 custom-w d-flex flex-column align-items-{{ block.settings.text_alignment_mobile }} text-{{ block.settings.text_alignment_mobile }}">
                    {% if block.settings.subtitle != blank %}
                      <div class="overflow-hidden width-fit-content">
                        <p class="block-subtitle body pp-regular mb-2" style="color: {{ block.settings.subtitle_color }}">
                          {{ block.settings.subtitle | newline_to_br }}
                        </p>
                      </div>
                    {% endif %}
                    {% if block.settings.title != blank %}
                      <div class="overflow-hidden width-fit-content">
                        <div class="block-title {{ block.settings.title_font_size_mobile }} pp-bold mb-3" style="color: {{ block.settings.title_color }}">
                          {{ block.settings.title }}
                        </div>
                      </div>
                    {% endif %}
                    {% if block.settings.description != blank %}
                      <div class="overflow-hidden width-fit-content">
                        <p class="block-description description-item body-sm pp-regular mb-3" style="color: {{ block.settings.description_color }}">
                          {{ block.settings.description | newline_to_br }}
                        </p>
                      </div>
                    {% endif %}
                    {% if block.settings.btn_text != blank and block.settings.btn_url != blank %}
                      <div class="overflow-hidden width-fit-content">
                        <a href="{{ block.settings.btn_url }}" class="block-btn btn-hover btn-main btn-no-animation">
                          <span class="pp-medium body-sm l-h-normal">
                            {{ block.settings.btn_text }}
                          </span>
                        </a>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>

        {% else %}
          {%- comment -%} VIDEO BLOCK {%- endcomment -%}

          <div class="swiper-slide item" {{ block.shopify_attributes }}>
            <!-- DESKTOP -->
            <div class="item-wrapper has-video-overlay d-lg-block d-md-none d-sm-none">
              {% assign v = block.settings.background_desktop %}
              {% if v != blank %}
                {% assign poster_img = v.preview_image %}
                {% assign poster_url = poster_img | image_url: width: 1600 %}
                {% assign mp4 = v.sources | where: 'mime_type', 'video/mp4' | first %}

                {%- if poster_img != blank -%}
                  <!-- Poster image for fast LCP -->
                  <img
                    class="banner-bg"
                    src="{{ poster_img | image_url: width: 1600 }}"
                    srcset="
                      {{ poster_img | image_url: width: 960 }} 960w,
                      {{ poster_img | image_url: width: 1400 }} 1400w,
                      {{ poster_img | image_url: width: 1600 }} 1600w"
                    sizes="100vw"
                    width="{{ poster_img.width }}"
                    height="{{ poster_img.height }}"
                    alt="{{ block.settings.alt_text | default: block.settings.title | default: 'Hero video' | escape }}"
                    loading="{% if is_first_slide %}eager{% else %}lazy{% endif %}"
                    fetchpriority="{% if is_first_slide %}high{% else %}auto{% endif %}"
                    decoding="{% if is_first_slide %}sync{% else %}async{% endif %}"
                  >
                {%- endif -%}

                <!-- Video lazy-loaded to not block LCP -->
                <video
                  class="hero-video"
                  playsinline
                  muted
                  loop
                  preload="none"
                  poster="{{ poster_url }}"
                  data-autoplay="true"
                >
                  {% if mp4 %}
                    <source src="{{ mp4.url }}" type="{{ mp4.mime_type }}">
                  {% else %}
                    {%- for s in v.sources -%}
                      <source src="{{ s.url }}" type="{{ s.mime_type }}">
                    {%- endfor -%}
                  {% endif %}
                  {% comment %} 
                  <!-- Accessibility: captions track -->
                  <track kind="captions"
                        src="/path/to/captions.vtt"
                        srclang="en"
                        label="English"
                        default> {% endcomment %}
                </video>
              {% endif %}



              <div class="video-content-container">
                <div class="container section-content h-100">
                  <div class="desktop-container row justify-content-{{ block.settings.horizontal_alignment }} align-items-{{ block.settings.vertical_alignment }} h-100">
                    <div class="col-lg-5 col-md-5 col-sm-12 custom-w d-flex flex-column align-items-{{ block.settings.text_alignment }} text-{{ block.settings.text_alignment }}">
                      {% if block.settings.subtitle != blank %}
                        <div class="overflow-hidden width-fit-content">
                          <p class="block-subtitle body-xl pp-regular mb-2" style="color: {{ block.settings.subtitle_color }}">
                            {{ block.settings.subtitle | newline_to_br }}
                          </p>
                        </div>
                      {% endif %}

                      {% if block.settings.title != blank %}
                        <div class="overflow-hidden width-fit-content">
                          <div class="block-title {{ block.settings.title_font_size }} pp-bold mb-3" style="color: {{ block.settings.title_color }}">
                            {{ block.settings.title }}
                          </div>
                        </div>
                      {% endif %}

                      {% if block.settings.description != blank %}
                        <div class="overflow-hidden width-fit-content">
                          <p class="block-description body-xl pp-regular mb-4" style="color: {{ block.settings.description_color }}">
                            {{ block.settings.description | newline_to_br }}
                          </p>
                        </div>
                      {% endif %}

                      {% if block.settings.btn_text != blank and block.settings.btn_url != blank %}
                        <div class="overflow-hidden width-fit-content">
                          <a href="{{ block.settings.btn_url }}" class="block-btn btn-hover btn-main btn-no-animation">
                            <span class="pp-regular body-xl l-h-normal px-1">
                              {{ block.settings.btn_text }}
                            </span>
                          </a>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- MOBILE -->
            <div class="item-wrapper has-video-overlay d-lg-none d-md-block d-sm-block video--tag">
            {% assign v = block.settings.background_mobile %}
            {% if v != blank %}
              {% assign poster_img = v.preview_image %}
              {% assign poster_url = poster_img | image_url: width: 900 %}
              {% assign mp4 = v.sources | where: 'mime_type', 'video/mp4' | first %}

              {%- if poster_img != blank -%}
                <!-- Poster image for fast LCP -->
                <img
                  class="banner-bg"
                  src="{{ poster_img | image_url: width: 900 }}"
                  srcset="
                    {{ poster_img | image_url: width: 480 }} 480w,
                    {{ poster_img | image_url: width: 768 }} 768w,
                    {{ poster_img | image_url: width: 900 }} 900w"
                  sizes="100vw"
                  width="{{ poster_img.width }}"
                  height="{{ poster_img.height }}"
                  alt="{{ block.settings.alt_text | default: block.settings.title | default: 'Venustas product video' | escape }}"
                  loading="lazy"
                  fetchpriority="{% if is_first_slide %}low{% else %}auto{% endif %}"
                  decoding="async"
                >
              {%- endif -%}

              <!-- Video lazy-loaded to not block LCP -->
              <video
                class="hero-video"
                playsinline
                muted
                loop
                autoplay
                preload="none"
                poster="{{ poster_url }}"
                data-autoplay="true"
              >
                {% if mp4 %}
                  <source src="{{ mp4.url }}" type="{{ mp4.mime_type }}">
                {% else %}
                  {%- for s in v.sources -%}
                    <source src="{{ s.url }}" type="{{ s.mime_type }}">
                  {%- endfor -%}
                {% endif %}

                {% comment %} <!-- Accessibility: captions track -->
                <track kind="captions"
                      src="/path/to/captions.vtt"
                      srclang="en"
                      label="English"
                      default> {% endcomment %}
              </video>
            {% endif %}



              <div class="video-content-container">
                <div class="container section-content h-100">
                  <div class="row justify-content-{{ block.settings.horizontal_alignment_mobile }} align-items-{{ block.settings.vertical_alignment_mobile }} h-100 py-5">
                    <div class="col-12 custom-w d-flex flex-column align-items-{{ block.settings.text_alignment_mobile }} text-{{ block.settings.text_alignment_mobile }}">
                      {% if block.settings.subtitle != blank %}
                        <div class="overflow-hidden width-fit-content">
                          <p class="block-subtitle body pp-regular mb-2" style="color: {{ block.settings.subtitle_color }}">
                            {{ block.settings.subtitle | newline_to_br }}
                          </p>
                        </div>
                      {% endif %}

                      {% if block.settings.title != blank %}
                        <div class="overflow-hidden width-fit-content">
                          <div class="block-title {{ block.settings.title_font_size_mobile }} pp-bold mb-3" style="color: {{ block.settings.title_color }}">
                            {{ block.settings.title }}
                          </div>
                        </div>
                      {% endif %}

                      {% if block.settings.description != blank %}
                        <div class="overflow-hidden width-fit-content">
                          <p class="block-description description-item body-sm pp-regular mb-3" style="color: {{ block.settings.description_color }}">
                            {{ block.settings.description | newline_to_br }}
                          </p>
                        </div>
                      {% endif %}

                      {% if block.settings.btn_text != blank and block.settings.btn_url != blank %}
                        <div class="overflow-hidden width-fit-content">
                          <a href="{{ block.settings.btn_url }}" class="block-btn btn-hover btn-main btn-no-animation">
                            <span class="pp-medium body-sm l-h-normal">
                              {{ block.settings.btn_text }}
                            </span>
                          </a>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if section.blocks.size > 1 %}
    <div class="float-nav d-lg-block d-md-block d-sm-none ">
        <button type="button" class="owl-prev" aria-label="Previous slide">
          <i class="fa-solid fa-chevron-left f-white" aria-hidden="true"></i>
        </button>
        <div class="owl-dots">
        </div>
        <button type="button" class="owl-next" aria-label="Next slide">
          <i class="fa-solid fa-chevron-right f-white" aria-hidden="true"></i>
        </button>
    </div>
  {% endif %}
</section>
{% if section.settings.enabled_transparent_header %}
<style>

    /* ✅ Keep banner layout stable even BEFORE Owl initializes */
    .banner-slider {
    background: #FFF;
    min-height: 500px; /* fallback so the next module won't jump */
    }

    /* Owl's default CSS sets .owl-carousel { display:none } before init */
    .banner-slider .owl-carousel {
    display: block !important;
    }

    /* Show only the first slide until Owl adds .owl-loaded */
    .banner-slider .owl-carousel:not(.owl-loaded) .item {
    display: none;
    }
    .banner-slider .owl-carousel:not(.owl-loaded) .item:first-child {
    display: block;
    }

    /* Make sure the first fallback slide still fills the banner */
    .banner-slider .owl-carousel:not(.owl-loaded),
    .banner-slider .owl-carousel:not(.owl-loaded) .item,
    .banner-slider .owl-carousel:not(.owl-loaded) .item-wrapper {
    height: 100%;
    }
  .header{
      background:transparent;
      box-shadow: 0 3px 6px 1px #00000000;
  }
  .header .logo img,
  .header .nav-toggle img,
  .header .nav-icons a img{
      -webkit-filter: invert(1); /* For older Safari versions */
      filter: invert(1);
  }
  .header .nav-items a span,
  .header .nav-items a>i{
    color:#fff;
  }
  .header.scrolled,
  .header:hover  {
      background-color: #fff;
      box-shadow: 0 3px 6px 1px #0000001a;
  }
  .header.scrolled .logo img,
  .header.scrolled .nav-icons a img,
  .header.scrolled .nav-toggle img,
  .header:hover .logo img,
  .header:hover .nav-icons a img,
  .header:hover .nav-toggle img{
      -webkit-filter: invert(0); /* For older Safari versions */
      filter: invert(0);
  }
  .header.scrolled .nav-items a span,
  .header.scrolled .nav-items a>i,
  .header:hover .nav-items a span,
  .header:hover .nav-items a>i{
      color:#161616;
  }
  .header.scrolled .nav-items a span .link-tag,
  .header:hover .nav-items a span .link-tag{
      color:#fff;
  }
</style>
{% endif %}
{% style %}
    .banner-slider {
        background: #FFF;
        position: relative;
        height: calc(100vh - var(--headerHeight, 0px));
    }
    .banner-slider .custom-w {
    }
    .banner-slider .btn-hover {
        padding: 14px 26px;
        min-width: unset;
        width:fit-content;
        display:flex;
    }
    .banner-slider .owl-carousel {
        position: relative;
    }
    .banner-slider:not(.v2) .owl-carousel,
    .banner-slider:not(.v2) .owl-stage-outer,
    .banner-slider:not(.v2) .owl-stage,
    .banner-slider:not(.v2) .owl-item,
    .banner-slider:not(.v2) .item,
    .banner-slider:not(.v2) .item-wrapper {
        height: 100%;
    }
    .banner-slider .item-wrapper {
        position: relative;
    }
    .banner-slider .item-wrapper .full-slide-link{
        position:absolute;
        inset:0;
        z-index:1;
        display:block;
    }
    .banner-slider:not(.v2) .item-wrapper.has-video-overlay::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, rgba(0, 0, 0, 0) 0%, rgb(0 0 0 / 35%) 100%);
        z-index: 1;
    }
    .banner-slider:not(.v2) .item-wrapper.no-image-overlay::before {
        content: none !important;
        display: none !important;
    }
    .banner-slider .item-wrapper .container {
        position: relative;
        z-index: 2;
        pointer-events: none;
    }
    .banner-slider .item-wrapper .container a,
    .banner-slider .item-wrapper .container button,
    .banner-slider .item-wrapper .container input,
    .banner-slider .item-wrapper .container [role="button"] {
        pointer-events: auto;
    }
    .banner-slider .banner-tags{
        background: linear-gradient( 130deg, #FE522E 0%, #E11B22 100%);
        border-radius: 8px;
        width: fit-content;
        padding: 8px 14px;
        line-height: 16px;
    }
    .banner-slider .float-nav {
        max-width: 1760px;
        height: 100%;
        top:0;
        left: 50%;
        transform: translate(-50%, 0%);
        pointer-events: none;
    }
    .banner-slider .float-nav button {
        background: #dbdbdb48;
        width: 55px;
        height: 55px;
        font-size: 20px;
        top:50%;
        pointer-events: auto;
    }
    .banner-slider .float-nav .owl-dots{
        position:absolute;
        top:unset;
        bottom:50px;
        pointer-events: auto;
    }
    .banner-slider .float-nav .owl-dots button{
        position:unset;
        width:10px;
        height:10px;
        transform:unset; 
        opacity:1 !important;  
        margin:0;
    }
    .banner-slider .float-nav button:not(:disabled):hover ,
    .banner-slider .float-nav .owl-dots button.swiper-pagination-bullet-active{
        background: #C7370F;
    }
    .banner-slider .owl-dots {
        position: absolute;
        display: flex;
        justify-content: center;
        gap: 20px;
        bottom: 3rem;
        width: 100%;
    }
    .banner-slider .owl-dot {
        width: 12px;
        height: 12px;
    }
    .banner-slider .owl-dot span {
        width: inherit;
        height: inherit;
        border-radius: 50px;
        display: block;
        background: #FFF;
        transition: all .5s ease;
    }
    .banner-slider .owl-dot.active {
        width: 12px;
    }
    .banner-slider .owl-dot.active span {
        background: #c7370f;
    }

    .banner-slider.v2 {
        height: auto !important;
    }
    .banner-slider.v2 .item-wrapper .container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
    .banner-slider.v2 .item {
        cursor: pointer;
    }

    .banner-slider .item-wrapper{
        position:relative;
    }
    .banner-slider .item-wrapper video{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .banner-slider .video-content-container{
        position: absolute;
        top: 0;
        width: 100%;
        height: 100%;
        z-index:4;
    }
    .banner-slider .owl-item .block-subtitle,
    .banner-slider .owl-item .block-title,
    .banner-slider .owl-item .block-description,
    .banner-slider .owl-item .block-btn{
        transform: translateY(10vh);
        transition: all 0.5s linear 0.2s;
    }
    .banner-slider .owl-item.active .block-subtitle,
    .banner-slider .owl-item.active .block-title,
    .banner-slider .owl-item.active .block-description,
    .banner-slider .owl-item.active .block-btn{
        transform: translateY(0);
    }
    
    .slide-diagonal{
        position:relative;
        overflow:hidden;
    }
    .slide-diagonal:before{
        position: absolute;
        content: '';
        display: block;
        width: 200%;
        height: 250%;
        z-index: 2;
        background: linear-gradient(-45deg, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.5) 50%, rgba(255, 255, 255, 0) 60%);
