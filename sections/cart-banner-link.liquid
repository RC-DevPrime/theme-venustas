{% style %}
    .banner-link-slider-section .banner-link-item{
        height:100%;
        width:100%;
        overflow:hidden;
        border-radius:8px;
        position:relative;
    }
    .banner-link-slider-section .banner-link-item img{
        width:100%;
        height:100%;
        object-fit:cover;
        transition: all 0.3s ease;
    }
    .banner-link-slider-section .banner-link-item:hover img{
        transform:scale(1.2);
    }
    .banner-link-slider-section .banner-link-item .bottom-content{
        position:absolute;
        bottom:1rem;
        left:1rem;
    }
    .banner-link-slider-section .banner-link-item .bottom-content .btn-icon{
        width:20px;
        height:20px;
        object-fit:contain;
        position:relative;
        z-index:1;
    }
    
    .banner-link-slider-section .banner-link-slider-container .float-nav button{
        background: #F1EADD;
    }
    .banner-link-slider-section .banner-link-slider-container .float-nav button:hover{
        background: #B93205;
    }
    .banner-link-slider-section .banner-link-slider-container .float-nav button i{
        color: #B93205;
    }
    .banner-link-slider-section .banner-link-slider-container .float-nav button:hover i{
        color: #FFF;
    }

{% endstyle %}
<div class="banner-link-slider-section overflow-hidden  position-relative ">
