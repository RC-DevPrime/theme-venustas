{% schema %}
{
    "name": "Banner Link",
    "limit": 1,
    "templates": ["cart"],
    "settings": [
        {
            "type": "checkbox", 
            "id": "banner_links_display",
            "label": "Banner Links Display",
            "info": "Display only if cart is empty"
        }
    ],
    "blocks": [
        {
            "type": "banner_link",
            "name": "Banner Link",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                }
            ]
        }
    ]
}
{% endschema %}