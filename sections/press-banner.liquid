{% style %}
    .press-banner-section{
        background-color:#000;
        position:relative;
        overflow:hidden;
    }
    .press-banner-section .section-heading{
        display:flex;
        align-items:center;
        gap:10px;
    }
    .press-banner-section .heading-element{
        height:40px;
        width:fit-content;
        object-fit:contain;
    }
    
    .press-banner-section .bg-image{
        width:100%;
        height:100%;
        object-fit:cover;
        transform:scale(1.2);
        transition: all 0.3s ease;
    }
    .press-banner-section .content-container{
        position:absolute;
        top:0;
        left:0;
        width:100%;
        height:100%;
        display: flex;
        align-items: center;
    }
    .press-banner-section.animate .bg-image{
        transform:scale(1);
    }


    .ambassador-banner-main-section .banner-join-section .popup-content{
        max-width: 1000px;
    }
    .ambassador-banner-main-section .banner-join-section .popup-header{
        padding-top:10px;
    }
    .ambassador-banner-main-section .banner-join-section .popup-header .popup-close img{
        width:20px;
        height:20px;
        object-fit:contain;
    }
{% endstyle %}
    <img src="{{ section.settings.background_image | img_url: 'master' }}" width="100%" height="100%" class="bg-image d-lg-block d-md-block d-sm-none">
    <img src="{{ section.settings.background_image_mobile | img_url: 'master' }}" width="100%" height="100%" class="bg-image d-lg-none d-md-none d-sm-block">
    <div class="content-container">
        <div class="container section-content">
            <div class="col-7 d-lg-block d-md-block d-sm-none">
                {% if section.settings.heading != blank %}
                    <h2 class="section-heading pp-semibold f-white title-xl pb-lg-3 pb-md-3 pb-sm-2">
                        {{ section.settings.heading }}
                    </h2>
                {% endif %}
                {% if section.settings.description != blank %}
                    <div class="section-description pp-regular body-xl f-white pb-lg-4 pb-md-4 pb-sm-3">
                        {{ section.settings.description }}
                    </div>
                {% endif %}
                {% if section.settings.btn_label != blank %}
                <div class="btn-join-banner btn-hover btn-main py-2">
                    <span class="f-white pp-regular body-lg">
                        {{ section.settings.btn_label }}
                    </span>
                </div>
                {% endif %}
            </div>

            <div class="col-lg-10 col-md-12 col-sm-12 d-lg-none d-md-none d-sm-block">
                {% if section.settings.heading != blank %}
                    <h2 class="section-heading pp-semibold f-white text-center title-sm pb-3">
                        {{ section.settings.heading }}
                    </h2>
                {% endif %}
                {% if section.settings.description != blank %}
                    <div class="section-description pp-regular body text-center f-white pb-3">
                        {{ section.settings.description }}
                    </div>
                {% endif %}
                {% if section.settings.btn_label != blank %}
                    <div class="d-flex justify-content-center">
                        <div class="btn-join-banner btn-hover btn-main py-2">
                            <span class="f-white pp-regular body">
                                {{ section.settings.btn_label }}
                            </span>
                        </div>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
{% schema %}
    {
        "class": "press-banner-section animate-section",
        "name": "Press Banner",
        "limit": 1,
        "templates": ["page"],
        "settings": [
            {
                "type": "image_picker",
                "id": "background_image",
                "label": "Background Image"
            },
            {
                "type": "image_picker",
                "id": "background_image_mobile",
                "label": "Background Image - Mobile"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Meet Venustas Ambassador"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description",
                "default": "<p>Venustas is delighted to convene a distin-guished and diverse group of individuals fromdifferent backgrounds, and share their uniqueand inspiring life journeys.</p>"
            },
            {
                "type": "text",
                "id": "btn_label",
                "label": "Button Label",
                "default": "Join now"
            },
            {
                "type": "url",
                "id": "btn_link",
                "label": "Button Link"
            }
        ],
        "presets" :[{
            "name" : "Press Banner"
        }]
    }
  {% endschema %} 