{% style %}
    .text-policy-content-section .row{
        --bs-gutter-x: 80px;
    }
    .text-policy-content-section .text-policy-link-menu-list .link-item {
        border-top:1px solid #E5E5E5;
    }
    
    .text-policy-content-section .text-policy-link-menu-list .link-item:first-child{
        border:none;
    }

    .text-policy-content-section .text-policy-link-menu-list .link-item a{
        padding:12px 0px;
        display:block;
    }

    .text-policy-content-section .text-policy-link-menu-list .link-item:hover a{
        text-decoration:underline;
    }

    .text-policy-content-section .text-policy-link-menu-list .link-item a.active{
        color:#B93205;
    }

    .text-policy-content-section .text-policy-link-menu-list .link-item:last-child{
        border-bottom:1px solid #E5E5E5;
    }

    .text-policy-content-section .policy-details{
        background: #F9F6EF;
        border-radius: 10px 10px 10px 10px;
        padding:25px 15px 10px;
        margin-top:15px;
    }

    .text-policy-content-section  .text-policy-content image,
    .text-policy-content-section  .text-policy-content video{
        width:100%;
        height:100%;
    }
    .text-policy-content-section  .text-policy-content p{
        font-size:16px;
        margin-bottom:10px;
    }
    .text-policy-content-section  .text-policy-content a{
        font-size:16px;
        color: #B93205;
    }

    .text-policy-content-section .details-list{
        display:flex;
        flex-direction:column;
    }
    .text-policy-content-section  .details-list .item-detail{
        padding:10px;
        border-bottom: 1px solid #E2DDD1;
        display:flex;
        align-items:center;
        gap:1rem;
    }
    .text-policy-content-section .details-list .item-detail:last-child{
        border-bottom:none;
    }
    .text-policy-content-section .details-list .item-detail .icon-img{
        width:20px;
        height:20px;
        object-fit:contain;
    }
    .text-policy-content-section .sticky-nav{
        position:sticky;
    }

    .text-policy-content-section .nav-hover-toc {
        position: fixed;
        left: 0;
        top: 20vh;
        background: #B93205;
        width: fit-content;
        padding: 13px 20px 13px 15px;
        border-top-right-radius: 50px;
        border-bottom-right-radius: 50px;
        display: flex;
        z-index: 999;
        cursor: pointer;
    }

    .text-policy-content-section .nav-hover-toc img {
        width: 20px;
        height: 20px;
        object-fit: contain;
    }

    /* --- MOBILE TOC NAV WRAPPER --- */
    .text-policy-content-section .mobile-toc-nav {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 100%;
        background-color: transparent;
        z-index: 999999;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.4s ease, visibility 0.4s ease;
    }

    /* overlay fade */
    .text-policy-content-section .mobile-toc-nav .overlay {
        position: fixed;
        z-index: 1;
        height: 100%;
        width: 100%;
        background-color: #000;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    /* side panel */
    .text-policy-content-section .mobile-toc-nav .inner-section {
        background-color: #FFF;
        height: 100%;
        width: 89%;
        position: relative;
        z-index: 2;
        transform: translateX(-100%);
        opacity: 0;
        transition: transform 0.5s ease, opacity 0.5s ease;
    }

    /* open state */
    .text-policy-content-section .mobile-toc-nav.open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .text-policy-content-section .mobile-toc-nav.open .overlay {
        opacity: 0.32;
    }

    .text-policy-content-section .mobile-toc-nav.open .inner-section {
        transform: translateX(0);
        opacity: 1;
    }

    /* close button */
    .text-policy-content-section .btn-close-toc {
        position: absolute;
        top: 0;
        right: -40px;
        cursor: pointer;
        width: 40px;
        height: 40px;
        background: #B93205;
        display: flex;
        align-items: center;
        justify-content: center;
        border-top-right-radius: 50%;
        border-bottom-right-radius: 50%;
    }

    .text-policy-content-section .btn-close-toc img {
        width: 20px;
        height: 20px;
        object-fit: contain;
    }
    
    .text-policy-content-section .text-policy-content ul,
    .text-policy-content-section .text-policy-content ol{
        padding-left:30px;
        margin-bottom:20px;
    }
    .text-policy-content-section .text-policy-content li{
        margin-bottom:8px;
    }
    .text-policy-content-section .text-policy-content table {
        font-family: 'Montserrat';
    }
    .text-policy-content-section .text-policy-content table tr:nth-child(4n+3),
    .text-policy-content-section .text-policy-content table tr:nth-child(4n+4) {
        background-color: #f4f4f4; 
    }

    .text-policy-content-section .text-policy-content table{
        margin-bottom:30px;
    }
    .text-policy-content-section .text-policy-content .powr-form-builder{
        font-family: 'Montserrat';
    }
    .text-policy-content-section .text-policy-content .shipping-section{
        font-family: 'Montserrat';
    }
    .text-policy-content-section .text-policy-content .shipping-section h3,
    .text-policy-content-section .text-policy-content h3{
        font-weight:700;
        margin-bottom:16px;
        font-size:26px;
    }
    .text-policy-content-section .text-policy-content h4{
        font-weight:700;
        margin-bottom:16px;
        font-size:22px;
    }

    .text-policy-content-section .warranty-registration-btn,
    .text-policy-content-section .warranty-claim-btn{
        margin-top:10px;
        margin-bottom:20px;
    }
    .text-policy-content-section .popup-modal .popup-close img{
        width:18px;
        height:18px;
    }
    .text-policy-content-section .popup-modal .popup-header{
        padding: 10px 15px 10px;
    }
    .text-policy-content-section .popup-container{
        padding-top:0px;
        padding-bottom:30px;
    }
    .text-policy-content-section .popup-modal .popup-content{
        max-width: 800px;
    }
    .return-flowchart{
        background: #F9F9F9;
        padding:30px 20px;
        border-radius:8px;
        text-align:center;
    }
    .return-flowchart .flow-cart-container{
        display:flex;
        align-items:center;
        justify-content: space-evenly;
    }
    .return-flowchart .image-icon{
        height:100px;
        object-fit:contain;
        
    }   
    .return-flowchart .img-arrow{
        width:50px;
        object-fit:contain;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
    
        /* .text-policy-content-section .text-policy-link-menu-list .link-item:first-child{
            border-top:1px solid #E5E5E5;
        } */
        .text-policy-content-section .text-policy-content .shipping-section h3{
            margin-top:30px;
        }
        .text-policy-content-section .row{
            --bs-gutter-x: 0px;
        }
        .text-policy-content-section .warranty-registration-btn,
        .text-policy-content-section .warranty-claim-btn{
            margin-top:10px;
            margin-bottom:20px;
            padding:8px 15px !important;
        }
        .text-policy-content-section .text-policy-content .shipping-section h3,
        .text-policy-content-section .text-policy-content h3{
            font-size:20px;
        }
        .text-policy-content-section .text-policy-content h4{
            font-size:18px;
        }
        .text-policy-content-section .text-policy-content p,
        .text-policy-content-section .text-policy-content li,
        .text-policy-content-section .text-policy-content a{
            font-size:14px;
        }
        .text-policy-content-section .popup-modal .popup-close{
            background:unset !important;
        }
        .text-policy-content-section .text-policy-content ul,
        .text-policy-content-section .text-policy-content ol{
            padding-left:20px;
            margin-bottom:10px;
        }
        .return-flowchart .image-icon{
            height:55px;
            
        }   
        .return-flowchart .flow-cart-container{
            justify-content: space-between;
        }
        .return-flowchart .img-arrow{
            width:40px;
            margin-top:-20px;
        }
        .return-flowchart .img-arrow.revise{
            margin-top: 0;
            transform: scaleY(-1) rotate(200deg);
            width: 85px;
            margin-right: 20px;
        }
        .flow-cart-container .flow-item{
            max-width:150px;
            min-width:100px;
        }
    }

{% endstyle %}
