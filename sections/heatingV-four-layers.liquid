{%- style -%}
  #shopify-section-{{ section.id }} .heatingV-four-layers { overflow: hidden; color: #fff; background: #1a1a1a; font-family: var(--font-primary, 'Montserrat', sans-serif); }
  #shopify-section-{{ section.id }} .heatingV-four-layers__inner { width: min(calc(100% - 100px), 1340px); margin: 0 auto; padding: 100px 0; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__intro { display: flex; flex-direction: column; gap: 14px; margin-bottom: 56px; }
  #shopify-section-{{ section.id }} .heatingV-four-layers h2,
  #shopify-section-{{ section.id }} .heatingV-four-layers p { margin: 0; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__title { font-size: 34px; font-weight: 700; line-height: 1.16; letter-spacing: -.952px; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__subtitle { font-size: 16px; line-height: 1.72; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__content { display: flex; align-items: center; gap: 32px; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__diagram { width: 654px; height: 512px; flex: 0 0 654px; overflow: hidden; border-radius: 12px; background: #2a2a2a; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__diagram picture,
  #shopify-section-{{ section.id }} .heatingV-four-layers__diagram img { display: block; width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__diagram img { object-fit: cover; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__placeholder { display: grid; width: 100%; height: 100%; place-items: center; color: #aaa; font-size: 13px; text-align: center; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__notes { display: flex; flex: 1; flex-direction: column; gap: 32px; min-width: 0; font-size: 16px; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__note { display: flex; flex-direction: column; gap: 4px; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__note-title { font-weight: 600; line-height: 1.4; }
  #shopify-section-{{ section.id }} .heatingV-four-layers__note-copy { color: #f5f5f5; line-height: 1.72; }
  @media (max-width: 1199px) { #shopify-section-{{ section.id }} .heatingV-four-layers__inner { width: min(calc(100% - 64px), 1340px); padding: 80px 0; } #shopify-section-{{ section.id }} .heatingV-four-layers__diagram { width: 50%; height: auto; aspect-ratio: 654 / 512; flex-basis: 50%; } }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingV-four-layers__inner { width: 350px; padding: 80px 0; }
    #shopify-section-{{ section.id }} .heatingV-four-layers__intro { gap: 14px; margin-bottom: 56px; }
    #shopify-section-{{ section.id }} .heatingV-four-layers__title { font-size: 28px; line-height: normal; letter-spacing: 0; }
    #shopify-section-{{ section.id }} .heatingV-four-layers__subtitle { font-size: 16px; line-height: 1.72; }
    #shopify-section-{{ section.id }} .heatingV-four-layers__content { flex-direction: column; align-items: stretch; gap: 32px; }
    #shopify-section-{{ section.id }} .heatingV-four-layers__diagram { width: 350px; height: 512px; flex: 0 0 512px; border-radius: 12px; }
    #shopify-section-{{ section.id }} .heatingV-four-layers__notes { gap: 32px; }
  }
{%- endstyle -%}

<section class="heatingV-four-layers">
  <div class="heatingV-four-layers__inner">
    <div class="heatingV-four-layers__intro"><h2 class="heatingV-four-layers__title">Four Layers Between You and the Wind</h2><p class="heatingV-four-layers__subtitle">Heat only helps if it stays in. The shell stops wind, rain and snow on the outside, and the fleece &amp; Graphene lining holds the warmth on the inside.</p></div>
    <div class="heatingV-four-layers__content">
      <div class="heatingV-four-layers__diagram">
        {%- if section.settings.desktop_image != blank -%}<picture>{%- if section.settings.mobile_image != blank -%}<source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}" sizes="350px">{%- endif -%}{{ section.settings.desktop_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '654, 900, 1400', sizes: '(max-width: 767px) 350px, 654px', alt: section.settings.image_alt }}</picture>{%- else -%}<span class="heatingV-four-layers__placeholder">{{ section.settings.image_alt | escape }}</span>{%- endif -%}
      </div>
      <div class="heatingV-four-layers__notes">
        <div class="heatingV-four-layers__note"><h3 class="heatingV-four-layers__note-title">A shell that stops the wind</h3><p class="heatingV-four-layers__note-copy">75D stretch polyester bonded to a TPU membrane and a fleece backing. Wind is what turns cold into dangerous cold, so it stops at the outside.</p></div>
        <div class="heatingV-four-layers__note"><h3 class="heatingV-four-layers__note-title">A lining that spreads the heat</h3><p class="heatingV-four-layers__note-copy">Graphene carries warmth evenly across each zone instead of leaving hot lines and cold gaps.</p></div>
        <div class="heatingV-four-layers__note"><h3 class="heatingV-four-layers__note-title">No gaps at the edges</h3><p class="heatingV-four-layers__note-copy">A fleece-lined stand collar with a chin guard, and a dropped hem that stays over your lower back when you lean forward.</p></div>
        <div class="heatingV-four-layers__note"><h3 class="heatingV-four-layers__note-title">Close to the body</h3><p class="heatingV-four-layers__note-copy">An athletic cut keeps the lining against you, where heat transfers best, and still fits under your shell.</p></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HeatingV Four Layers",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop diagram image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile diagram image" },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Four clothing layers protecting against wind and cold" }
  ],
  "presets": [{ "name": "HeatingV Four Layers" }]
}
{% endschema %}
