{% style %}
    .campaign-banner-landscape-section{
        background-color:#181818;
        position:relative;
        padding-top:100px;
    }
    .campaign-banner-landscape-section .section-heading{
        display:flex;
        flex-direction:column;
        align-items:center;
        justify-content:center;
        gap:10px;
    }
    .campaign-banner-landscape-section .heading-element{
        height:40px;
        width:fit-content;
        object-fit:contain;
    }
    .campaign-banner-landscape-section .content-container{
        position:absolute;
        top:0;
        left:0;
        width:100%;
        height:100%;
        display: flex;
        align-items: center;
    }
    .bg-gap{
        display:block;
        height:100px;
        background-color:#181818;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .campaign-banner-landscape-section{
            padding-top:0px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="campaign-banner-landscape-section 
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}> 
    <img src="{{ section.settings.background_image | img_url: 'master' }}" width="100%" height="100%" class="background-image d-lg-block d-md-block d-sm-none">
    <img src="{{ section.settings.background_image_mobile | img_url: 'master' }}" width="100%" height="100%" class="background-image d-lg-none d-md-none d-sm-block">
    <div class="content-container">
        <div class="container section-content">
            <div class="section-heading">
                <h2 class="section-heading pp-semibold f-white title-sm text-center">
                    {{ section.settings.heading }}
                </h2>
                <div class="section-description pp-regular f-white body-lg text-center col-lg-6 col-md-7 col-sm-12 mx-auto pb-lg-4 pb-md-4 pb-sm-3">
                    {{ section.settings.description }}
                </div>
                <div class="buttons-container d-flex gap-lg-3 gap-md-3 gap-sm-2">
                    <a href="{{ section.settings.btn_link_1 }}" class="btn-hover btn-main py-2">
                        <span class="f-white pp-regular body-lg d-lg-block d-md-block d-sm-none">
                            {{ section.settings.btn_label_1 }}
                        </span>
                        <span class="f-white pp-regular body d-lg-none d-md-none d-sm-block">
                            {{ section.settings.btn_label_1 }}
                        </span>
                    </a>
                    <a href="{{ section.settings.btn_link_2 }}" class="btn-hover btn-white py-2">
                        <span class="f-black pp-regular body-lg d-lg-block d-md-block d-sm-none">
                            {{ section.settings.btn_label_2 }}
                        </span>
                        <span class="f-black pp-regular body d-lg-none d-md-none d-sm-block">
                            {{ section.settings.btn_label_2 }}
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% schema %}
    {
        "name": "Campaign Banner Landscape",
        "templates": ["page"],
        "limit": 1, 
        "settings": [
            {
                "type": "checkbox",
                "id": "enabled_section_child_scroll",
                "label": "Enabled Section Child Scroll"
            },
            {
                "type": "text",
                "id": "section_scroll_nav",
                "label": "Section Scroll Nav",
                "info": "Need to Enabled first Section Scroll"
            },
            {
                "type": "text",
                "id": "nav_title",
                "label": "Navigation Title"
            },
            {
                "type": "image_picker",
                "id": "background_image",
                "label": "Background Image"
            },
            {
                "type": "image_picker",
                "id": "background_image_mobile",
                "label": "Background Image - Mobile"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Warm Gifts, Thoughtfully Chosen"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description",
                "default": "<p>Discover heated apparel that speaks to their style and needs. <br>Whether it’s for a loved one, a friend, or yourself—wrap them in warmth that feels personal, practical, and full of care.</p>"
            },
            {
                "type": "text",
                "id": "btn_label_1",
                "label": "Button Label - 1",
                "default": "Buy Now"
            },
            {
                "type": "url",
                "id": "btn_link_1",
                "label": "Button Link - 1"
            },
            {
                "type": "text",
                "id": "btn_label_2",
                "label": "Button Label - 2",
                "default": "Buy Now"
            },
            {
                "type": "url",
                "id": "btn_link_2",
                "label": "Button Link - 2"
            }
        ],
        "presets" :[{
            "name" : "Campaign Banner Landscape"
        }]
    }
  {% endschema %} 