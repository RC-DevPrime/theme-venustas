{% style %}
  #shopify-section-{{ section.id }} .heating-brand-story {
    position: relative;
    width: 100%;
    height: 400svh;
    background: linear-gradient(180deg, #14161a 42.308%, #531602 100%);
    color: #fff;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .heating-brand-story__stage {
    position: sticky;
    top: 0;
    display: flex;
    width: 100%;
    height: 100svh;
    min-height: 600px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .heating-brand-story__inner {
    position: relative;
    width: min(100% - 40px, 1340px);
    height: 100%;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .heating-brand-story__heading {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(100%, 926px);
    margin: 0;
    color: #fff;
    font-size: 64px;
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
    opacity: var(--story-heading-opacity, 1);
    transform: translate(-50%, calc(-50% + var(--story-heading-y, 0px)));
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .heating-brand-story__heading-accent {
    display: block;
    color: var(--color-brand, #b93205);
    font-size: 96px;
    font-weight: 600;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .heating-brand-story__stats {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    width: 100%;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    opacity: var(--story-stats-opacity, 0);
    transform: translateY(calc(-50% + var(--story-stats-y, 50px)));
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .heating-brand-story__stat {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-brand-story__value {
    margin: 0;
    color: #fff;
    font-size: 40px;
    font-weight: 800;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .heating-brand-story__label {
    width: 142px;
    margin: 0;
    color: #d0d0d0;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.68;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heating-brand-story {
      height: auto;
    }

    #shopify-section-{{ section.id }} .heating-brand-story__stage {
      position: relative;
      top: auto;
      display: block;
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .heating-brand-story__inner {
      display: flex;
      width: 100%;
      height: auto;
      flex-direction: column;
      gap: 118px;
      padding: 80px 20px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .heating-brand-story__heading {
      position: static;
      width: 100%;
      font-size: 32px;
      font-weight: 800;
      line-height: 1.2;
      opacity: 1;
      transform: none;
    }

    #shopify-section-{{ section.id }} .heating-brand-story__heading-accent {
      display: inline;
      font-size: inherit;
      font-weight: inherit;
      line-height: inherit;
    }

    #shopify-section-{{ section.id }} .heating-brand-story__stats {
      position: static;
      display: grid;
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      opacity: 1;
      transform: none;
    }

    #shopify-section-{{ section.id }} .heating-brand-story__stat {
      gap: 6px;
      padding: 16px 0;
    }

    #shopify-section-{{ section.id }} .heating-brand-story__value {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .heating-brand-story__label {
      width: 100%;
      font-size: 12px;
      line-height: 1.4;
    }
  }
{% endstyle %}

<section
  id="HeatingBrandStory-{{ section.id }}"
  class="heating-brand-story"
  data-heating-brand-story
>
  <div class="heating-brand-story__stage">
    <div class="heating-brand-story__inner">
      {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
        <h2 class="heating-brand-story__heading">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- endif -%}
          {%- if section.settings.heading_accent != blank -%}
            <span class="heating-brand-story__heading-accent">{{ section.settings.heading_accent }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      <div class="heating-brand-story__stats" aria-label="Venustas achievements">
        <div class="heating-brand-story__stat">
          <p class="heating-brand-story__value">2M+</p>
          <p class="heating-brand-story__label">Happy Customers</p>
        </div>
        <div class="heating-brand-story__stat">
          <p class="heating-brand-story__value">3M+</p>
          <p class="heating-brand-story__label">Products Sold</p>
        </div>
        <div class="heating-brand-story__stat">
          <p class="heating-brand-story__value">8+</p>
          <p class="heating-brand-story__label">Years Innovation</p>
        </div>
        <div class="heating-brand-story__stat">
          <p class="heating-brand-story__value">30+</p>
          <p class="heating-brand-story__label">Countries</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('HeatingBrandStory-{{ section.id }}');
    if (!section || section.dataset.storyInitialized === 'true') return;

    section.dataset.storyInitialized = 'true';
    const media = window.matchMedia('(max-width: 767px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;

    const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
    const range = (value, start, end) => clamp((value - start) / (end - start));
    const mix = (from, to, amount) => from + (to - from) * amount;

    const render = () => {
      frame = 0;

      if (media.matches) {
        section.style.removeProperty('--story-heading-opacity');
        section.style.removeProperty('--story-heading-y');
        section.style.removeProperty('--story-stats-opacity');
        section.style.removeProperty('--story-stats-y');
        return;
      }

      if (reducedMotion.matches) {
        section.style.setProperty('--story-heading-opacity', '1');
        section.style.setProperty('--story-heading-y', '-190px');
        section.style.setProperty('--story-stats-opacity', '1');
        section.style.setProperty('--story-stats-y', '205px');
        return;
      }

      const rect = section.getBoundingClientRect();
      const distance = Math.max(section.offsetHeight - window.innerHeight, 1);
      const progress = clamp(-rect.top / distance);
      const firstExit = range(progress, 0.2, 0.34);
      const secondEnter = range(progress, 0.27, 0.42);
      const finale = range(progress, 0.6, 0.82);
      const headingOpacity = Math.max(1 - firstExit, range(progress, 0.62, 0.74));
      const headingY = mix(0, -190, finale);
      const statsY = mix(50, 0, secondEnter) + mix(0, 205, finale);

      section.style.setProperty('--story-heading-opacity', headingOpacity.toFixed(3));
      section.style.setProperty('--story-heading-y', `${headingY.toFixed(2)}px`);
      section.style.setProperty('--story-stats-opacity', secondEnter.toFixed(3));
      section.style.setProperty('--story-stats-y', `${statsY.toFixed(2)}px`);
    };

    const requestRender = () => {
      if (!frame) frame = window.requestAnimationFrame(render);
    };

    window.addEventListener('scroll', requestRender, { passive: true });
    window.addEventListener('resize', requestRender, { passive: true });
    media.addEventListener?.('change', requestRender);
    reducedMotion.addEventListener?.('change', requestRender);
    requestRender();
  })();
</script>

{% schema %}
{
  "name": "Heating Brand Story",
  "tag": "section",
  "class": "heating-brand-story-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "ProductH heading",
      "default": "The Expert In"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "ProductH accent heading",
      "default": "Heated Apparel"
    }
  ],
  "presets": [
    {
      "name": "Heating Brand Story"
    }
  ]
}
{% endschema %}
