{% style %}
  #shopify-section-{{ section.id }} .xmas-top-up { display: block; padding: 80px 0; background: #f8f1e6; color: #0b4c20; font-family: var(--font-primary, 'Montserrat', sans-serif); }
  #shopify-section-{{ section.id }} .xmas-top-up__inner { width: min(calc(100% - 40px), 1340px); margin: 0 auto; }
  #shopify-section-{{ section.id }} .xmas-top-up__inner .product-item{background:#fff}
  #shopify-section-{{ section.id }} .xmas-top-up__header { display: flex; flex-direction: column; gap: 16px; margin-bottom: 40px; }
  #shopify-section-{{ section.id }} .xmas-top-up__title { margin: 0; color: inherit; font-size: 40px; font-weight: 800; line-height: 1.2; }
  #shopify-section-{{ section.id }} .xmas-top-up__intro { margin: 0; font-size: 16px; font-weight: 500; line-height: 24px; }
  #shopify-section-{{ section.id }} .xmas-top-up__viewport { padding: 32px 20px; border-top: 4px solid #0b4c20; border-radius: 12px; background: #fffdf9; color: #1a1a1a; }
  #shopify-section-{{ section.id }} .xmas-top-up__track { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  #shopify-section-{{ section.id }} .xmas-top-up__slide { min-width: 0; }
  #shopify-section-{{ section.id }} .xmas-top-up__dots { display: none; }
  #shopify-section-{{ section.id }} .xmas-top-up__footer { margin-top: 40px; text-align: center; }
  #shopify-section-{{ section.id }} .xmas-top-up__button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; max-width: 100%; padding: 16px 40px; border: 1.4px solid currentColor; border-radius: 6px; color: #0b4c20; font-size: 16px; font-weight: 600; line-height: 1.2; text-decoration: none; }
  #shopify-section-{{ section.id }} .xmas-top-up__icon { flex: 0 0 12px; width: 12px; height: 12px; }
  #shopify-section-{{ section.id }} .xmas-top-up__icon svg { display: block; width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .xmas-top-up__button:focus-visible,
  #shopify-section-{{ section.id }} .xmas-top-up__dot:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media (min-width: 768px) and (max-width: 999px) {
    #shopify-section-{{ section.id }} .xmas-top-up__track { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 10px; }
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .xmas-top-up { padding: 32px 0; }
    #shopify-section-{{ section.id }} .xmas-top-up__header { gap: 18px; margin-bottom: 18px; }
    #shopify-section-{{ section.id }} .xmas-top-up__title { font-size: 24px; }
    #shopify-section-{{ section.id }} .xmas-top-up__viewport { padding: 0; border: 0; border-radius: 0; background: transparent; }
    #shopify-section-{{ section.id }} .xmas-top-up__track { display: flex; gap: 0; }
    #shopify-section-{{ section.id }} .xmas-top-up__slide { width: calc((100% - 12px) / 2); margin-right: 12px; }
    #shopify-section-{{ section.id }} .xmas-top-up__dots { display: flex; justify-content: center; margin-top: 8px; }
    #shopify-section-{{ section.id }} .xmas-top-up__dot { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; padding: 0; border: 0; background: transparent; color: #0b4c20; cursor: pointer; }
    #shopify-section-{{ section.id }} .xmas-top-up__dot::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #d9d9d9; }
    #shopify-section-{{ section.id }} .xmas-top-up__dot[aria-current='true']::before { background: #b93205; }
    #shopify-section-{{ section.id }} .xmas-top-up__footer { margin-top: 18px; }
    #shopify-section-{{ section.id }} .xmas-top-up__button { width: 100%; }
  }
{% endstyle %}

{% assign product_count = 0 %}
{% capture product_cards %}
  {% for index in (1..4) %}
    {% assign product_key = 'product_' | append: index %}
    {% assign selected_product = section.settings[product_key] %}
    {% if selected_product != blank %}
      {% assign product_count = product_count | plus: 1 %}
      <div class="xmas-top-up__slide swiper-slide">
        {% render 'product-item', product: selected_product, image_loading: 'lazy', image_sizes: '(max-width: 767px) calc((100vw - 52px) / 2), (max-width: 999px) 50vw, 25vw' %}
      </div>
    {% endif %}
  {% endfor %}
{% endcapture %}
<xmas-top-up class="xmas-top-up"{% if section.settings.title != blank %} aria-labelledby="xmas-top-up-title-{{ section.id }}"{% endif %}>
  <div class="xmas-top-up__inner">
    {% if section.settings.title != blank or section.settings.intro != blank %}
      <header class="xmas-top-up__header">
        {% if section.settings.title != blank %}<h2 class="xmas-top-up__title" id="xmas-top-up-title-{{ section.id }}">{{ section.settings.title | escape }}</h2>{% endif %}
        {% if section.settings.intro != blank %}<p class="xmas-top-up__intro">{{ section.settings.intro | escape }}</p>{% endif %}
      </header>
    {% endif %}
    {% if product_count > 0 %}
      <div class="xmas-top-up__viewport swiper" data-viewport>
        <div class="xmas-top-up__track swiper-wrapper">{{ product_cards }}</div>
      </div>
      {% assign page_count = product_count | plus: 1 | divided_by: 2 %}
      {% if page_count > 1 %}
        <div class="xmas-top-up__dots" aria-label="Product pages">
          {% for page in (1..page_count) %}
            <button class="xmas-top-up__dot" type="button" aria-label="Go to product page {{ page }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-page="{{ forloop.index0 }}"></button>
          {% endfor %}
        </div>
      {% endif %}
    {% elsif request.design_mode %}
      <p>Select products to display.</p>
    {% endif %}
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <div class="xmas-top-up__footer">
        <a class="xmas-top-up__button" href="{{ section.settings.button_link | escape }}">{{ section.settings.button_label | escape }}<span class="xmas-top-up__icon" aria-hidden="true">{% render 'heating-icons', icon: 'chevron-right-16' %}</span></a>
      </div>
    {% endif %}
  </div>
</xmas-top-up>
<script src="{{ 'xmas-top-up.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "xmas Top Up",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Top up to $300" },
    { "type": "text", "id": "intro", "label": "Subtitle", "default": "Gifts that keep them warm." },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "product", "id": "product_3", "label": "Product 3" },
    { "type": "product", "id": "product_4", "label": "Product 4" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Shop all accessories" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "xmas Top Up" }]
}
{% endschema %}
