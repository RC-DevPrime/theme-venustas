{% style %}
  #shopify-section-{{ section.id }} .heatingv-heat-zones {
    width: 100%;
    overflow: hidden;
    background: #14161a;
    color: #fff;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__inner {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 100px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 80px;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__title {
    margin: 0;
    color: #fff;
    font-size: 34px;
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.952px;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__description {
    max-width: 1340px;
    margin: 0;
    color: #d0d0d0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.72;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__grid {
    display: grid;
    grid-template-columns: minmax(0, 691px) minmax(0, 615px);
    gap: 32px;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__item {
    display: flex;
    min-width: 0;
    min-height: 609px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__media {
    position: relative;
    width: 100%;
    height: 452px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(ellipse at center, rgba(255, 0, 0, 0.2) 0%, rgba(236, 13, 13, 0.175) 12.5%, rgba(217, 26, 26, 0.15) 25%, rgba(179, 51, 51, 0.1) 50%, rgba(102, 102, 102, 0) 100%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__item--pants .heatingv-heat-zones__media::before {
    background: radial-gradient(ellipse at center, rgba(255, 0, 0, 0.24) 0%, rgba(236, 13, 13, 0.21) 12.5%, rgba(217, 26, 26, 0.18) 25%, rgba(179, 51, 51, 0.12) 50%, rgba(102, 102, 102, 0) 100%);
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__image {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__copy {
    display: flex;
    width: min(100%, 460px);
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__item-title {
    margin: 0;
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .heatingv-heat-zones__item-text {
    margin: 0;
    color: #d0d0d0;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingv-heat-zones__inner {
      width: 100%;
      padding: 56px 20px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .heatingv-heat-zones__header {
      gap: 12px;
      margin-bottom: 56px;
    }

    #shopify-section-{{ section.id }} .heatingv-heat-zones__title {
      font-size: 24px;
      line-height: 1.3;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heatingv-heat-zones__description {
      font-size: 14px;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .heatingv-heat-zones__grid {
      display: flex;
      flex-direction: column;
      gap: 56px;
    }

    #shopify-section-{{ section.id }} .heatingv-heat-zones__item {
      min-height: 0;
      align-items: flex-start;
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .heatingv-heat-zones__media {
      width: 100%;
      height: 220px;
      border-radius: 8px;
    }

    #shopify-section-{{ section.id }} .heatingv-heat-zones__copy {
      width: 100%;
      gap: 6px;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .heatingv-heat-zones__item-title {
      font-size: 16px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .heatingv-heat-zones__item-text {
      color: #a5aab1;
      font-size: 13px;
      line-height: 1.2;
    }
  }
{% endstyle %}

<section class="heatingv-heat-zones" id="heatingv-heating-zones">
  <div class="heatingv-heat-zones__inner">
    <div class="heatingv-heat-zones__header">
      {%- if section.settings.title != blank -%}
        <h2 class="heatingv-heat-zones__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="heatingv-heat-zones__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="heatingv-heat-zones__grid">
      <div class="heatingv-heat-zones__item">
        <div class="heatingv-heat-zones__media">
          {%- if section.settings.jacket_image != blank -%}
            {{
              section.settings.jacket_image
              | image_url: width: 1400
              | image_tag:
                class: 'heatingv-heat-zones__image',
                loading: 'lazy',
                widths: '350, 700, 900, 1100, 1400',
                sizes: '(max-width: 767px) calc(100vw - 40px), 691px',
                alt: section.settings.jacket_image.alt | default: 'Volcano™ Pro Dual-Battery Heated Vest'
            }}
          {%- endif -%}
        </div>
        <div class="heatingv-heat-zones__copy">
          <h3 class="heatingv-heat-zones__item-title">Volcano™ Pro Dual-Battery Heated Vest for Men • 6 zones</h3>
          <p class="heatingv-heat-zones__item-text">Collar, Chest(L/R), Upper Back(L/R), Lower Back</p>
        </div>
      </div>

      <div class="heatingv-heat-zones__item heatingv-heat-zones__item--pants">
        <div class="heatingv-heat-zones__media">
          {%- if section.settings.pants_image != blank -%}
            {{
              section.settings.pants_image
              | image_url: width: 1300
              | image_tag:
                class: 'heatingv-heat-zones__image',
                loading: 'lazy',
                widths: '350, 700, 900, 1100, 1300',
                sizes: '(max-width: 767px) calc(100vw - 40px), 615px',
                alt: section.settings.pants_image.alt | default: 'Volcano™ Pro Dual-Battery Heated Vest'
            }}
          {%- endif -%}
        </div>
        <div class="heatingv-heat-zones__copy">
          <h3 class="heatingv-heat-zones__item-title">Volcano™ Pro Dual-Battery Heated Vest for Women • 6 zones</h3>
          <p class="heatingv-heat-zones__item-text">Collar, Chest(L/R), Upper Back(L/R), Lower Back</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HeatingV Heat Zones",
  "tag": "section",
  "class": "heatingv-heat-zones-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Largest Heating Area We've Ever Built Into a Vest"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>85% of Your Upper-Body Core, Front and Back. Heat runs from the collar, down both sides of the chest, across the upper back on both sides, and all the way over the lower back — the areas that go cold first once you stop moving, and the areas a smaller panel layout leaves out.</p>"
    },
    {
      "type": "image_picker",
      "id": "jacket_image",
      "label": "Jacket image"
    },
    {
      "type": "image_picker",
      "id": "pants_image",
      "label": "Pants image"
    }
  ],
  "presets": [
    {
      "name": "HeatingV Heat Zones"
    }
  ]
}
{% endschema %}
