{% style %}
    .product-row-layout-section{
        background: #1C1C1C;
    }
    .product-row-layout-section .block-description ul{
        padding:0px 25px;
    }
    .product-row-layout-section .block-description ul li{
        margin-bottom:1rem;
    }
    .product-row-layout-section .row{
        --bs-gutter-x: 70px;
    }
    .row-layout-item:not(:last-child) {
        padding-bottom:80px;
    }

    .reward-custom-row-section .image-container{
        height:450px;
        border-radius:16px;
        overflow:hidden;
    }
    .product-row-layout-section .image-container img{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .product-row-layout-section .row{
            --bs-gutter-x: 0px;
        }
        .product-row-layout-section .block-description ul{
            padding:0px 20px;
        }
        .product-row-layout-section .block-description ul li::marker {
            color: #B93205;
        }
        .row-layout-item:not(:last-child) {
            padding-bottom:30px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content 
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}> 

    {% for block in section.blocks %}
        {% if block.type == 'right_content' %}
            <div class="row-layout-item">
                <div class="row justify-content-center align-items-center">
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <h4 class="block-heading pp-bold title f-white pb-4 text-center d-lg-none d-md-none d-sm-block">
                            {{ block.settings.heading }}
                        </h4>
                        <div class="image-container">
                            <img src="{{ block.settings.image | img_url: 'master' }}" width="100%" height="100%">
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="content-container">
                            <h4 class="block-heading pp-bold title-sm f-white pb-3 d-lg-block d-md-block d-sm-none">
                                {{ block.settings.heading }}
                            </h4>
                            <div class="block-description pp-regular f-white-gray body-xl mt-lg-0 mt-md-0 mt-sm-3">
                                <div class="body-xl d-lg-block d-md-block d-sm-none">
                                    {{ block.settings.description }}
                                </div>
                                <div class="body d-lg-none d-md-none d-sm-block">
                                    {{ block.settings.description }}
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        {% else %}
            <div class="row-layout-item">
                <div class="row justify-content-center align-items-center">
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="col-lg-10 col-md-10 col-sm-12">
                            <div class="content-container">
                                <div class="block-heading pp-bold title-sm f-white pb-lg-3 pb-md-3 pb-sm-2 text-lg-start text-md-start text-sm-center">
                                    <span class="title-sm d-lg-block d-md-block d-sm-none">
                                        {{ block.settings.heading }}
                                    </span>
                                    <span class="title d-lg-none d-md-none d-sm-block">
                                        {{ block.settings.heading }}
                                    </span>
                                </div>
                                <div class="block-description pp-regular f-white-gray text-lg-start text-md-start text-sm-center pb-lg-0 pb-md-0 pb-sm-4">
                                    <span class="body-lg d-lg-block d-md-block d-sm-none">
                                        {{ block.settings.description }}
                                    </span>
                                    <span class="body d-lg-none d-md-none d-sm-block">
                                        {{ block.settings.description }}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="image-container">
                            <img src="{{ block.settings.image | img_url: 'master' }}" width="100%" height="100%">
                        </div>
                    </div>

                </div>
            </div>
        {% endif %}
    {% endfor %}
</div>
{% schema %}
{
    "class": "product-row-layout-section",
    "name": "Row Layout",
    "templates": ["product"],
    "settings": [
        {
            "type": "checkbox",
            "id": "enabled_section_child_scroll",
            "label": "Enabled Section Child Scroll"
        },
        {
            "type": "text",
            "id": "section_scroll_nav",
            "label": "Section Scroll Nav",
            "info": "Need to Enabled first Section Scroll"
        },
        {
            "type": "text",
            "id": "nav_title",
            "label": "Navigation Title"
        },
    ],
    "blocks": [
        {
            "type": "right_content",
            "name": "Right Content",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "richtext",
                    "id": "description",
                    "label": "Description"
                }
            ]   
        },
        {
            "type": "left_content",
            "name": "Left Content",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "richtext",
                    "id": "description",
                    "label": "Description"
                }
            ]   
        }
    ],
    "presets": [
        {
            "name": "Row Layout"
        }
    ]
}
{% endschema %}