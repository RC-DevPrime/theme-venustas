{% style %}
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime { background: #1a1a1a; color: #fff; }
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__inner { width: min(calc(100% - 40px), 1340px); margin: 0 auto; padding: 80px 0; }
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__intro { display: flex; flex-direction: column; gap: 14px; }
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime h2,
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime p { margin: 0; }
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__title { font-family: var(--font-primary, 'Montserrat', sans-serif); font-size: 34px; font-weight: 700; line-height: 1.16; letter-spacing: -.952px; }
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__description { max-width: 1040px; font-family: var(--font-primary, 'Montserrat', sans-serif); font-size: 16px; font-weight: 400; line-height: 1.72; }
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__cards { display: flex; gap: 20px; margin-top: 34px; }
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__card { display: flex; flex: 1 1 0; min-width: 0; height: 88px; align-items: center; justify-content: space-between; padding: 24px 16px; border: 1.4px solid var(--card-color); border-radius: 6px; background: var(--card-bg); }
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__value { color: var(--card-color); font-family: var(--font-primary, 'Montserrat', sans-serif); font-size: 38px; font-weight: 700; line-height: 1.1; white-space: nowrap; }
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__unit { font-size: .645em; }
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__pill { padding: 6px 12px; border-radius: 100px; background: var(--card-color); color: var(--pill-text); font-family: var(--font-primary, 'Montserrat', sans-serif); font-size: 12px; font-weight: 700; line-height: normal; white-space: nowrap; }
  #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__mobile { display: none; }
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__inner { padding: 64px 0; }
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__cards { gap: 14px; }
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__card { padding-inline: 12px; }
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__inner { width: calc(100% - 40px); padding: 60px 0; }
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__intro { gap: 12px; }
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__title { font-size: 28px; line-height: normal; letter-spacing: 0; }
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__description { line-height: normal; }
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__cards { gap: 10px; margin-top: 56px; }
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__card { height: 100px; flex-direction: column; justify-content: center; padding: 0 8px; }
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__desktop { display: none; }
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__mobile { display: inline; }
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__value { font-size: 38px; }
    #shopify-section-{{ section.id }} .heatingV-off-bike-runtime__pill { width: 100%; padding: 6px 8px; text-align: center; }
  }
{% endstyle %}

<section class="heatingV-off-bike-runtime">
  <div class="heatingV-off-bike-runtime__inner">
    <div class="heatingV-off-bike-runtime__intro">
      <h2 class="heatingV-off-bike-runtime__title">{{ section.settings.title | escape }}</h2>
      <p class="heatingV-off-bike-runtime__description">{{ section.settings.description | escape }}</p>
    </div>
    <div class="heatingV-off-bike-runtime__cards">
      {%- for index in (1..3) -%}
        {%- assign color_key = 'card_' | append: index | append: '_color' -%}
        {%- assign bg_key = 'card_' | append: index | append: '_background' -%}
        {%- assign desktop_value_key = 'card_' | append: index | append: '_desktop_value' -%}
        {%- assign mobile_value_key = 'card_' | append: index | append: '_mobile_value' -%}
        {%- assign pill_key = 'card_' | append: index | append: '_pill' -%}
        {%- assign pill_text_key = 'card_' | append: index | append: '_pill_text_color' -%}
        <div class="heatingV-off-bike-runtime__card" style="--card-color: {{ section.settings[color_key] }}; --card-bg: {{ section.settings[bg_key] }}; --pill-text: {{ section.settings[pill_text_key] }};">
          <strong class="heatingV-off-bike-runtime__value"><span class="heatingV-off-bike-runtime__desktop">{{ section.settings[desktop_value_key] }}</span><span class="heatingV-off-bike-runtime__mobile">{{ section.settings[mobile_value_key] }}</span></strong>
          <span class="heatingV-off-bike-runtime__pill">{{ section.settings[pill_key] }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HeatingV Off-bike Runtime",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Six zones, where the cold gets in first" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Collar. Both sides of the chest. Both sides of the upper back. And all the way across the lower back. The largest heating area we've built into a vest." },
    { "type": "header", "content": "Runtime cards" },
    { "type": "color", "id": "card_1_color", "label": "Card 1 color", "default": "#b93205" },
    { "type": "text", "id": "card_1_background", "label": "Card 1 background CSS", "default": "rgba(185, 50, 5, 0.12)" },
    { "type": "text", "id": "card_1_desktop_value", "label": "Card 1 desktop value", "default": "144°F" },
    { "type": "text", "id": "card_1_mobile_value", "label": "Card 1 mobile value", "default": "1.5h" },
    { "type": "text", "id": "card_1_pill", "label": "Card 1 pill", "default": "HIGH" },
    { "type": "color", "id": "card_1_pill_text_color", "label": "Card 1 pill text", "default": "#ffffff" },
    { "type": "color", "id": "card_2_color", "label": "Card 2 color", "default": "#ffffff" },
    { "type": "text", "id": "card_2_background", "label": "Card 2 background CSS", "default": "rgba(255, 255, 255, 0.12)" },
    { "type": "text", "id": "card_2_desktop_value", "label": "Card 2 desktop value", "default": "130°F" },
    { "type": "text", "id": "card_2_mobile_value", "label": "Card 2 mobile value", "default": "2.5h" },
    { "type": "text", "id": "card_2_pill", "label": "Card 2 pill", "default": "MEDIUM" },
    { "type": "color", "id": "card_2_pill_text_color", "label": "Card 2 pill text", "default": "#1a1a1a" },
    { "type": "color", "id": "card_3_color", "label": "Card 3 color", "default": "#0d6efd" },
    { "type": "text", "id": "card_3_background", "label": "Card 3 background CSS", "default": "rgba(0, 109, 255, 0.12)" },
    { "type": "text", "id": "card_3_desktop_value", "label": "Card 3 desktop value", "default": "112°F" },
    { "type": "text", "id": "card_3_mobile_value", "label": "Card 3 mobile value", "default": "4h" },
    { "type": "text", "id": "card_3_pill", "label": "Card 3 pill", "default": "LOW" },
    { "type": "color", "id": "card_3_pill_text_color", "label": "Card 3 pill text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "HeatingV Off-bike Runtime" }]
}
{% endschema %}
