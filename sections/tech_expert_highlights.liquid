      "default": "#e44b10"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width_percent",
      "label": "Desktop content width (%)",
      "min": 70,
      "max": 100,
      "step": 1,
      "default": 90,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "mobile_content_width_percent",
      "label": "Mobile content width (%)",
      "min": 88,
      "max": 100,
      "step": 1,
      "default": 94,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop padding top",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 26,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop padding bottom",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 26,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 10,
      "max": 100,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 10,
      "max": 100,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "grid_gap_x",
      "label": "Desktop item gap X",
      "min": 8,
      "max": 70,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_grid_gap_x",
      "label": "Mobile item gap X",
      "min": 6,
      "max": 40,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
