<button class="back-to-top">
</button>
<footer class="footer">
    <div class="container section-content pb-0">
        <div class="row newsletter-container">
            <div class="col-lg-6 col-md-6 col-sm-12 border-right-divider pb-lg-0 pb-md-0 pb-sm-4">
                <div class="pretitle-lg pp-semibold mb-3 f-white mx-auto pt-lg-0 pt-md-0 pt-sm-0">
                {{ section.settings.newsletter_heading }}
                </div>
                <div class="body pp-light f-white mb-4 mx-auto">
                {{ section.settings.newsletter_description }}
                </div>
                <div class="col-lg-9 col-md-10 col-12 newsletter">
                    {% form 'customer', id: "footer-newsletter", class: 'mb-3' %}
                            <div class="form-wrapper">
                                <input class="pp-light body" type="email" name="contact[email]" autocomplete="off" placeholder="Enter Your Email Here" required>
                                <button type="submit">
                                    <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/arrow-left.png?v=1758129586" class="newsletter-icon" alt="newsletter-icon">
                                </button>
                            </div>
                            <div class="validation-input mt-lg-3 mt-md-3 mt-sm-3">
                            <label for="validation-checkbox" class="validation-checkbox">
                                <div class="pp-light a-f-gray label body-sm">
                                I consent to the 
                                    <a href="/pages/terms-of-service" class="a-f-gray pp-light body-sm text-underline">Terms of Use</a> And <a href="/pages/after-sales-policy?tab=privacy-policy" class="a-f-gray pp-light body-sm text-underline">Privacy Policy</a>
                                </div>
                                <input type="checkbox" id="validation-checkbox" name="validation" value="I consent to the Terms of Use and Privacy Policy" required="">
                                <span class="checkmark"></span>
                            </label>
                            </div>
                            {% if form.posted_successfully? %}
                            <script>
                                document.addEventListener('DOMContentLoaded', function () {
                                // Scroll to form
                                const form = document.querySelector('#footer-newsletter');
                                if (form) {
                                    form.scrollIntoView({ behavior: 'instant' });
                                }

                                // Hide form UI
                                $('#footer-newsletter .form-wrapper').hide();
                                $('#footer-newsletter .validation-input').hide();

                                // 🔥 Remove ?customer_posted=true#footer-newsletter from URL
                                if (window.history.replaceState) {
                                    const cleanUrl = window.location.origin + window.location.pathname;
                                    window.history.replaceState({}, document.title, cleanUrl);
                                }
                                });
                            </script>

                            <p class="nl-status">
                                <span class="pp-bold f-main">Thanks for signing up!</span>
                                Please check your inbox to confirm your subscription
                            </p>

                            {% elsif form.errors %}
                                <script>
                                    document.addEventListener("DOMContentLoaded", function() {
                                        let form = document.querySelector("#footer-newsletter");
                                        if (form) {
                                            form.scrollIntoView({ behavior: "instant" });
                                        }
                                    });
                                </script>
                                <p class="nl-status">
                                    There's a problem submitting your request. Try again.
                                </p>
                            {% else %}
                                <p class="nl-status hidden">
                                    This email was already subscribed to our newsletter.
                                </p>
                            {% endif %}
                            
                    {% endform %}
                </div>
            </div>
