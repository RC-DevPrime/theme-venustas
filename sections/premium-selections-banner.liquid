{% style %}
    .premium-selections-banner-section{
        position:relative;
        overflow:hidden;
    }
    .premium-selections-banner-section .section-heading{
        display:flex;
        align-items:center;
        gap:10px;
    }
    .premium-selections-banner-section .heading-element{
        height:40px;
        width:fit-content;
        object-fit:contain;
    }
    
    .premium-selections-banner-section .bg-image{
        width:100%;
        height:100%;
        object-fit:cover;
        transition: all 0.3s ease;
        scale:1.2;
    }
    
    .premium-selections-banner-section.animate .bg-image{
        scale:1;
    }
    .premium-selections-banner-section .content-container{
        position:absolute;
        top:0;
        left:0;
        width:100%;
        height:100%;
        display: flex;
        align-items: center;
    }


    .ambassador-banner-main-section .banner-join-section .popup-content{
        max-width: 1000px;
    }
    .ambassador-banner-main-section .banner-join-section .popup-header{
        padding-top:10px;
    }
    .ambassador-banner-main-section .banner-join-section .popup-header .popup-close img{
        width:20px;
        height:20px;
        object-fit:contain;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .premium-selections-banner-section .section-heading{
            justify-content: center;
        }
        
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
    <img src="{{ section.settings.background_image | img_url: 'master' }}" width="100%" height="100%" class="bg-image d-lg-block d-md-block d-sm-none">
    <img src="{{ section.settings.background_image_mobile | img_url: 'master' }}" width="100%" height="100%" class="bg-image d-lg-none d-md-none d-sm-block">
    <div class="content-container">
        <div class="container section-content">
            <div class="col-lg-6 col-md-6 col-sm-12 d-lg-block d-md-block d-sm-none">
                {% if section.settings.heading != blank %}
                    <h2 class="section-heading pp-bold f-white title-md pb-lg-3 pb-md-3 pb-sm-2" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="100" data-aos-duration="500">
                        {{ section.settings.heading }}
                    </h2>
                {% endif %}
                {% if section.settings.description != blank %}
                    <div class="section-description pp-regular body-xl f-white pb-lg-4 pb-md-4 pb-sm-3" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="150" data-aos-duration="500">
                        {{ section.settings.description }}
                    </div>
                {% endif %}
                <div class="d-flex align-items-center gap-3"  data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="200" data-aos-duration="500">
                    {% if section.settings.btn_label != blank %}
                    <div class="btn-join-banner btn-hover btn-main py-2">
                        <span class="f-white pp-regular body-lg">
                            {{ section.settings.btn_label }}
                        </span>
                    </div>
                    {% endif %}
                    {% if section.settings.btn_label_2 != blank %}
                    <a class="btn-join-banner btn btn-black py-2">
                        <span class="f-white pp-regular body-lg">
                            {{ section.settings.btn_label_2 }}
                        </span>
                    </a>
                    {% endif %}
                </div>
            </div>

            <div class="col-10 mx-auto d-lg-none d-md-none d-sm-block">
                {% if section.settings.heading != blank %}
                    <h2 class="section-heading pp-bold f-white text-center title pb-3" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="100" data-aos-duration="500">
                        {{ section.settings.heading }}
                    </h2>
                {% endif %}
                {% if section.settings.description != blank %}
                    <div class="section-description pp-regular body text-center f-white pb-3" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="150" data-aos-duration="500">
                        {{ section.settings.description }}
                    </div>
                {% endif %}
                <div class="col-10 mx-auto d-flex align-items-center gap-3" data-aos="fade-up" data-aos-once="true" data-aos-easing="ease" data-aos-delay="200" data-aos-duration="500">
                    {% if section.settings.btn_label != blank %}
                        <div class="d-flex justify-content-center flex-1">
                            <div class="btn-join-banner btn-hover btn-main py-2 w-100">
                                <span class="f-white pp-regular body">
                                    {{ section.settings.btn_label }}
                                </span>
                            </div>
                        </div>
                    {% endif %}
                    {% if section.settings.btn_label_2 != blank %}
                        <a class="d-flex justify-content-center flex-1">
                            <div class="btn-join-banner btn btn-black py-2 px-lg-5 px-md-5 px-sm-3 w-100">
                                <span class="f-white pp-regular body">
                                    {{ section.settings.btn_label_2 }}
                                </span>
                            </div>
                        </a>
                    {% endif %}
                </div>

            </div>
        </div>
    </div>
{% schema %}
    {
        "class": "premium-selections-banner-section animate-section",
        "name": "Premium Selections Banner",
        "limit": 1,
        "templates": ["page"],
        "settings": [
            {
                "type": "image_picker",
                "id": "background_image",
                "label": "Background Image"
            },
            {
                "type": "image_picker",
                "id": "background_image_mobile",
                "label": "Background Image - Mobile"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Welcome To Our Rewards Page"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description",
                "default": "<p>Earn reward points on every purchase. Redeem for discounts on future purchases.</p>"
            },
            {
                "type": "text",
                "id": "btn_label",
                "label": "Button Label",
                "default": "Join now"
            },
            {
                "type": "url",
                "id": "btn_link",
                "label": "Button Link"
            },
            {
                "type": "text",
                "id": "btn_label_2",
                "label": "Button Label",
                "default": "Log in"
            },
            {
                "type": "url",
                "id": "btn_link_2",
                "label": "Button Link"
            }
        ],
        "presets" :[{
            "name" : "Premium Selections Banner"
        }]
    }
  {% endschema %} 