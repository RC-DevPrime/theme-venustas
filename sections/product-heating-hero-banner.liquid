{% style %}
  #shopify-section-{{ section.id }} .product-heating-hero {
    width: 100%;
    overflow: hidden;
    background: #efefef;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__inner {
    width: min(100% - 40px, 1340px);
    margin-left: auto;
    margin-right: auto;
    padding: 40px 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__layout {
    display: flex;
    align-items: center;
    gap: 60px;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__content {
    flex: 0 1 620px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__text {
    display: grid;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__heading {
    margin: 0;
    color: var(--venustas-black);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__description {
    margin: 0;
    color: var(--venustas-black);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 32px;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 228px;
    padding: 20px;
    border-radius: 8px;
    background: #fff;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__card-icon {
    flex: none;
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(185, 50, 5, 0.16);
    color: var(--color-brand);
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__card-icon svg {
    width: 28px;
    height: 28px;
    display: block;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__card-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__card-title {
    margin: 0;
    color: var(--venustas-black);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__card-text {
    margin: 0;
    color: var(--venustas-black);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__media {
    flex: 1 1 660px;
    min-width: 0;
    overflow: hidden;
    border-radius: 6px;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__image {
    width: 100%;
    height: 600px;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .product-heating-hero__image--mobile {
    display: none;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-heating-hero__inner {
      width: 100%;
      padding: 40px 20px;
    }

    #shopify-section-{{ section.id }} .product-heating-hero__layout {
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }

    #shopify-section-{{ section.id }} .product-heating-hero__heading {
      font-size: 24px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .product-heating-hero__description {
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .product-heating-hero__cards {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .product-heating-hero__card {
      flex-direction: row;
      align-items: center;
      min-height: 0;
      padding: 16px 20px;
    }

    #shopify-section-{{ section.id }} .product-heating-hero__card-copy {
      flex: 1;
    }

    #shopify-section-{{ section.id }} .product-heating-hero__content,
    #shopify-section-{{ section.id }} .product-heating-hero__media {
      flex: none;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .product-heating-hero__image {
      height: auto;
      aspect-ratio: 346 / 184;
    }

    #shopify-section-{{ section.id }} .product-heating-hero__image--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .product-heating-hero__image--mobile {
      display: block;
    }
  }
{% endstyle %}

<section class="product-heating-hero">
  <div class="product-heating-hero__inner">
    <div class="product-heating-hero__layout">
      <div class="product-heating-hero__content">
        <div class="product-heating-hero__text">
          {%- if section.settings.heading != blank -%}
            <h2 class="product-heating-hero__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <p class="product-heating-hero__description">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="product-heating-hero__cards">
            {%- for block in section.blocks -%}
              <article class="product-heating-hero__card" {{ block.shopify_attributes }}>
                <div class="product-heating-hero__card-icon" aria-hidden="true">
                  {%- render 'product-heating-icons', icon: block.settings.icon -%}
                </div>

                <div class="product-heating-hero__card-copy">
                  {%- if block.settings.title != blank -%}
                    <h3 class="product-heating-hero__card-title">{{ block.settings.title }}</h3>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <p class="product-heating-hero__card-text">{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.image_desktop != blank or section.settings.image_mobile != blank -%}
        <div class="product-heating-hero__media">
          {%- if section.settings.image_desktop != blank -%}
            {{
              section.settings.image_desktop
              | image_url: width: 1320
              | image_tag:
                class: 'product-heating-hero__image product-heating-hero__image--desktop',
                loading: 'eager',
                widths: '480,640,800,1000,1320',
                sizes: '(max-width: 767px) 0px, calc(min(100vw - 40px, 1340px) - 680px)',
                alt: section.settings.image_desktop.alt | default: section.settings.heading
            }}
          {%- endif -%}

          {%- if section.settings.image_mobile != blank -%}
            {{
              section.settings.image_mobile
              | image_url: width: 720
              | image_tag:
                class: 'product-heating-hero__image product-heating-hero__image--mobile',
                loading: 'eager',
                widths: '350,480,720',
                sizes: '(max-width: 767px) 100vw, 0px',
                alt: section.settings.image_mobile.alt | default: section.settings.heading
            }}
          {%- elsif section.settings.image_desktop != blank -%}
            {{
              section.settings.image_desktop
              | image_url: width: 720
              | image_tag:
                class: 'product-heating-hero__image product-heating-hero__image--mobile',
                loading: 'eager',
                widths: '350,480,720',
                sizes: '(max-width: 767px) 100vw, 0px',
                alt: section.settings.image_desktop.alt | default: section.settings.heading
            }}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ProductH Hero Banner",
  "tag": "section",
  "class": "product-heating-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Extreme Warmth For The Coldest Rides"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Cold weather doesn't just make riding uncomfortable. Wind chill, freezing temperatures, and long exposure can quickly drain your warmth and shorten your riding season. MV11 delivers active warmth where cold hits hardest."
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature card",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name",
          "default": "icon-motorbike",
          "info": "Available: icon-motorbike, icon-snowflake, icon-cloud-snow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Winter Motorcycle Riding"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Stay warm on every cold-weather ride."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ProductH Hero Banner",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "icon": "icon-motorbike",
            "title": "Winter Motorcycle Riding",
            "text": "Stay warm on every cold-weather ride."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "icon": "icon-snowflake",
            "title": "Snowmobile Adventures",
            "text": "Consistent warmth for long hours in the cold."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "icon": "icon-cloud-snow",
            "title": "Extreme Outdoor Work",
            "text": "Built for the harshest conditions and demanding days."
          }
        }
      ]
    }
  ]
}
{% endschema %}
