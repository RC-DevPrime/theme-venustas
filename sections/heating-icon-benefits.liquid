{%- render 'heating-icon-benefits',
  section_id: section.id,
  blocks: section.blocks,
  section_background: section.settings.section_background,
  panel_background: section.settings.panel_background
-%}

{% schema %}
{
  "name": "Heating Icon Benefits",
  "tag": "section",
  "class": "heating-icon-benefits-section",
  "settings": [
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#161615"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "icon-warmth",
          "options": [
            { "value": "icon-warmth", "label": "Warmth" },
            { "value": "icon-protection", "label": "Protection" },
            { "value": "icon-comfort", "label": "Comfort" },
            { "value": "icon-rider", "label": "Rider" },
            { "value": "icon-thermometer", "label": "Thermometer" },
            { "value": "icon-mobility", "label": "Mobility" },
            { "value": "icon-duration", "label": "Duration" },
            { "value": "icon-mountain", "label": "Mountain" },
            { "value": "icon-highway", "label": "Highway" },
            { "value": "icon-urban", "label": "Urban" },
            { "value": "icon-weather", "label": "Weather" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Better Warmth"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Heat stays locked inside while external cold elements stay out."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heating Icon Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "icon-warmth",
            "title": "Better Warmth",
            "text": "Heat stays in, cold stays out."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "icon-protection",
            "title": "Better Protection",
            "text": "Outer layer shields you from impact and road hazards."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "icon-comfort",
            "title": "Better Comfort",
            "text": "Layering regulates temperature and reduces bulk."
          }
        }
      ]
    }
  ]
}
{% endschema %}
