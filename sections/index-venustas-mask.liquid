<section class="venustas-mask">
  <div class="sticky">
    {% if section.settings.select_bg_type == 'video' %}

      {% if section.settings.background_video_mobile != blank %}
        {% assign desktop_poster = section.settings.background_video.preview_image | image_url: width: 2000 %}
        {% assign mobile_poster  = section.settings.background_video_mobile.preview_image | image_url: width: 2000 %}

        {{
          section.settings.background_video | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          poster: desktop_poster,
          class: 'd-lg-block d-md-block d-sm-none'
        }}

        {{
          section.settings.background_video_mobile | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          poster: mobile_poster,
          class: 'd-lg-none d-md-none d-sm-block'
        }}

      {% else %}
        {% assign large_poster = section.settings.background_video.preview_image | image_url: width: 2000 %}

        {{
          section.settings.background_video | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          poster: large_poster
        }}
      {% endif %}

    {% else %}
      <img src="{{ section.settings.background_image | img_url: 'master' }}" class="bg-image d-lg-block d-md-block d-sm-none" width="100%" height="100%">
      <img src="{{ section.settings.background_image_mobile | img_url: 'master' }}" class="bg-image d-lg-none d-md-none d-sm-block" width="100%" height="100%">
    {% endif %}

    <div class="mask d-lg-block d-md-block d-sm-none"></div>
    <div class="mask-m  d-lg-none d-md-none d-sm-block"></div>

    <div class="container section-content h-100">
      <div class="row align-items-center h-100">
        <div class="col-12 overflow-hidden">

          <div class="row d-lg-flex d-md-none d-sm-none">
            <div class="col-lg-8 col-md-8 col-sm-12 mx-auto">
                <div class="fadeup">
                    <div class="title-lg pp-bold text-center mb-2" style="color: {{ section.settings.title_color }}">
                        {{ section.settings.title | newline_to_br }}
                    </div>
                </div>
                <div class="fadeup">
                    <div class="pretitle pp-regular text-center" style="color: {{ section.settings.desc_color }}">
                        {{ section.settings.description | newline_to_br }}
                    </div>
                </div>
            </div>
          </div>

          <div class="row d-lg-none d-md-flex d-sm-flex">
            <div class="col-12 fadeup">
              <div class="pretitle-xl pp-semibold text-center mb-2" style="color: {{ section.settings.title_color }}">
                {{ section.settings.title | newline_to_br }}
              </div>
            </div>
            <div class="col-12 fadeup">
              <div class="body pp-regular text-center mb-4 px-3" style="color: {{ section.settings.desc_color }}">
                {{ section.settings.description | newline_to_br }}
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
    "class": "venustas-mask-section",
    "name": "Venustas Mask",
    "limit": 1,
    "templates": ["index"],
    "settings": [
        {
            "type": "select",
            "id": "select_bg_type",
            "label": "Background Type",
            "options": [
               {
                   "label": "Video",
                   "value": "video"
               },
               {
                   "label": "Image",
                   "value": "image"
               } 
            ],
            "default": "video"
        },
        {
            "type": "video",
            "id": "background_video",
            "label": "Background Video"
        },
        {
            "type": "video",
            "id": "background_video_mobile",
            "label": "Background Video - Mobile"
        },
        {
            "type": "image_picker",
            "id": "background_image",
            "label": "Background Image"
        },
        {
            "type": "image_picker",
            "id": "background_image_mobile",
            "label": "Background Image - Mobile"
        },
        {
            "type": "image_picker",
            "id": "mask",
            "label": "Mask"
        },
        {
            "type": "image_picker",
            "id": "mask_mobile",
            "label": "Mask - Mobile"
        },
        {
            "type": "textarea",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "color",
            "id": "title_color",
            "label": "Title Color",
            "default": "#fff"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description"
        },
        {
            "type": "color",
            "id": "desc_color",
            "label": "Description Color",
            "default": "#fff"
        }
    ],
    "presets": [
        {
            "name": "Venustas Mask"
        }
    ]
}
{% endschema %}