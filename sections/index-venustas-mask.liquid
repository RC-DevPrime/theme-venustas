        padding-bottom: 50px;
        z-index: 3;
    }
    .venustas-mask .container .btn {
        font-weight: 700;
    }
    .venustas-mask .image-container-mask{
        height:400px;
        position:relative;
        border-radius: 20px 20px 20px 20px;
        overflow:hidden;
    }
    .venustas-mask .bg-image{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .venustas-mask .image-container-mask .btn{
      display:none;
      transition: all 0.3s ease
    }
    .venustas-mask .image-container-mask:hover .btn{
      display:block;
      width: fit-content;
    }
    .venustas-mask .image-container-mask img{
      width:100%;
      height:100%;
      object-fit:cover;
      transition: all 0.3s ease;
    }
    .venustas-mask .image-container-mask .content-info{
        position:absolute;
        bottom:0;
        width:100%;
    }
    .venustas-mask .venustas-mask-slider .owl-stage{
        padding-left:0px !important;
    }
    .venustas-mask .container{
        width:100%;
    }


    /* Fade-up base state */
    .venustas-mask .fadeup {
        opacity: 0;
        transform: translate3d(0, 180px, 0);
        transition: opacity 500ms ease, transform 500ms ease;
        will-change: opacity, transform;
    }

    /* Active state */
    .venustas-mask .fadeup.is-in {
        opacity: 1;
        transform: translate3d(0, 0, 0);
    }
    .venustas-mask .fadeup:nth-of-type(2) { transition-delay: 0ms; }
    .venustas-mask .fadeup:nth-of-type(1) { transition-delay: 140ms; }


    /* Optional: respect reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .venustas-mask .fadeup {
            transition: none;
            transform: none;
        }
    }


    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .venustas-mask .sticky .mask-m {
            margin-top:-6px;
        }
      .venustas-mask .venustas-mask-slider .owl-stage{
