{% style %}
/* JMGO MASK --------------------------------------------------------------- */

.venustas-mask {
    position: relative;
    height: 200vh;
}
.venustas-mask .sticky {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    z-index: 1;
}
.venustas-mask .sticky:before{
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    background: rgb(0 0 0 / 45%);
    pointer-events: none;
    z-index: 2;
    opacity:0;
    transition: all 0.3s ease;
}
.venustas-mask .sticky.is-in:before{
    opacity:1;
}
.venustas-mask .sticky video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
}
.venustas-mask .sticky .mask {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://cdn.shopify.com/s/files/1/0474/8365/0202/files/desktop-mask.svg?v=1746518610');
    background-position: center;
    background-repeat: no-repeat;
    background-size: 100%;
    z-index: 2;
    transition: all .5s ease;
}
.venustas-mask .sticky .mask-m {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://cdn.shopify.com/s/files/1/0474/8365/0202/files/mobile-mask.svg?v=1746518610');
    background-position: center;
    background-repeat: no-repeat;
    background-size: 100%;
    z-index: 2;
    transition: all .5s ease;
}
.venustas-mask .sticky .mask::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 20vh;
    background: #fff;
    opacity:0;
}
.venustas-mask .sticky .mask::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 20vh;
    background: #fff;
    opacity:0;
}
.venustas-mask .sticky .mask-m::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 20vh;
    background: #fff;
    display:none;
}
.venustas-mask .sticky .mask-m::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 20vh;
    background: #fff;
    display:none;
}
.venustas-mask .container {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%);
    padding-top: 180px;
    padding-bottom: 50px;
    z-index: 3;
}
.venustas-mask .container .btn {
    font-weight: 700;
}

    /* VENUSTAS MASK --------------------------------------------------------------- */

    .venustas-mask {
