{% style %}
    nav.header.header-hide{
      display:none;
    }
    .product-page-nav-header-section .main-nav-header-section{
        background: {{ section.settings.background_color }};
        padding:12px 0px;
    }
    .product-page-nav-header-section .nav-header-container{
        display:flex;
        align-items: center;
        justify-content: space-between;
    }
    .product-page-nav-header-section .product-info{
        display:flex;
        max-width:650px;
    }
    .product-page-nav-header-section .product-info h5{
        padding-right: 1rem;
        border-right: 1px solid #3B3B3B;
        max-width:600px;
    }
    .product-page-nav-header-section .product-info p{
        padding-left:1rem;
    }
    .product-page-nav-header-section .link-nav{
        display: flex;
        gap:15px;
        align-items: center;
    }
    .product-page-nav-header-section .link-nav .link-nav-item{
        cursor:pointer;
        opacity: .6;
    }
    .product-page-nav-header-section .link-nav .link-nav-item.active{
        opacity: 1;
    }
    .product-page-nav-header-section .nav-content{
        display:flex;
        gap:2rem;
        padding-left:1rem;
    }
    .product-page-nav-header-section .btn.buy-now{
        padding: 8px 2.5rem;
        background: #B93205;
        border-radius: 4px;
        cursor:pointer;
        transition: all .5s ease;
    }
    .product-page-nav-header-section .btn.buy-now:hover{
        color: #FFF;
        background: #161616;
    }
    .product-page-nav-header-section .btn.buy-amazon{
        padding: 8px 10px;
        background: #FFF;
        border-radius: 4px;
        cursor:pointer;
    }
    .product-page-nav-header-section .btn.buy-amazon:hover{
        background: #B93205;
    }
    .product-page-nav-header-section .btn.buy-amazon span{
        color:#000;
    }
    .product-page-nav-header-section .btn.buy-amazon:hover span{
        color:#FFF;
    }
  
    .product-page-nav-header-section .product-header-sticky {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 4; /* Make sure it's above other content */
    }

    .product-page-nav-header-section .custom-select-nav{
      border-radius:6px;
      background:#fff;
      border:1px solid #EEE;
      padding:8px 16px;
      line-height:normal;
      position:relative;
      width:130px;
    }
    .product-page-nav-header-section .custom-select-nav .select-tag{
      display:flex;
      gap:0.5rem;
      align-items: center;
      justify-content: space-between;
    }
    .product-page-nav-header-section .custom-select-nav .select-tag img{
      width:14px;
      height:14px;
      object-fit:contain;
      transition: all 0.3s ease;
    }
    .product-page-nav-header-section .custom-select-nav.active .select-tag img{
      transform:rotate(180deg)
    }
    .product-page-nav-header-section .custom-select-nav .custom-select-list{
      position: absolute;
      top: 35px;
      left: 0;
      background: #fff;
      z-index: 5;
      border-bottom-left-radius:5px;
      border-bottom-right-radius:5px;
      display:none;
      width:100%;
    }
    .product-page-nav-header-section .custom-select-nav.active .custom-select-list{
      display:block;
    }
  
    .product-page-nav-header-section .custom-select-nav .custom-select-list .nav-content .link-nav{
      display:flex;
      flex-direction:column;
      gap:0;
      padding:10px 0px;
      align-items:flex-start;
    }
    .product-page-nav-header-section .custom-select-nav .custom-select-list .nav-content .link-nav .link-nav-item{
      padding:6px 15px;
      color:#000;
      font-size:14px;
    }
    .product-page-nav-header-section .custom-select-nav .custom-select-list .nav-content .link-nav span.active{
      color:#000;
    }
    .product-page-nav-header-section .amazon-icon{
        height:20px;
        width:20px;
        object-fit:contain;
        position: relative;
        z-index: 2;
        mix-blend-mode: multiply;
    }
    .mobile-nav{
        padding:10px 0px;
        border-top: 1px solid #3c3c3c;
    }
  
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .product-page-nav-header-section .link-nav{
            display: flex;
            gap:0;
            align-items: center;
            overflow:hidden;
        }
        .product-page-nav-header-section .main-nav-header-section{
            padding:0;
        }
        .product-page-nav-header-section .selected-nav{
            font-size:12px;
        }
        .product-page-nav-header-section .nav-content{
            padding-left:0px;
        }
        .product-page-nav-header-section .product-info .description{
            display:none;
        }
        .product-page-nav-header-section .nav-content .btn.buy-now{
            padding:8px 16px;
        }
        .product-page-nav-header-section .product-info h5{
            padding-right:0.5rem;
            border:none;
        }
        .product-page-nav-header-section .custom-select-nav .custom-select-list .nav-content .link-nav span{
            font-size:11px;
        }
        .product-page-nav-header-section .custom-select-nav{
            padding:4px 10px;
            width:fit-content;
        }
        .product-page-nav-header-section .btn.buy-now{
            padding: 8px 2.5rem;
            border-radius: 8px 8px 8px 8px;
        }
        .product-page-nav-header-section .btn.buy-amazon{
            padding-top:0px;
            padding-bottom:0px;
        }
        .product-page-nav-header-section .main-nav-header-section .upper-detail{
            background-color:#FFF;
            box-shadow: 0px -3px 6px 1px rgba(56, 56, 56, 0.1);
            position:fixed;
            bottom:0;
            z-index:99999;
        }
        .product-page-nav-header-section .main-nav-header-section .bottom-detail{
            padding-left:0;
            padding-right:0;
        }
        .product-page-nav-header-section .main-nav-header-section .bottom-detail .link-nav{
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: none;
            gap:20px;
        }
        .product-page-nav-header-section .main-nav-header-section .bottom-detail .link-nav .link-nav-item{
            flex: 0 0 auto;
            white-space: nowrap;
            padding:14px 0px;
            position:relative;
        }
        .product-page-nav-header-section .main-nav-header-section .bottom-detail .link-nav .link-nav-item:after{
            content:"";
            display:block;
            position:absolute;
            bottom:0;
            height:2px;
            width:100%;
            background-color:#2a2a2a;
        }   
        .product-page-nav-header-section .main-nav-header-section .bottom-detail .link-nav .link-nav-item:first-child{
            margin-left:20px;
        }
        .product-page-nav-header-section .main-nav-header-section .bottom-detail .link-nav .link-nav-item:last-child{
            margin-right:20px;
        }
        .product-page-nav-header-section .main-nav-header-section .bottom-detail .link-nav .link-nav-item.active:after{
            background-color:#B93205;
        }
        .mobile-nav{
            padding:0px 0px;
        }
        .product-page-nav-header-section .product-variant-selector.popup-modal{
            bottom: 0;
            top: unset;
        }
        .product-page-nav-header-section .product-variant-selector.popup-modal .popup-content{
            margin-bottom: 0;
            border-radius: 0;
        }
        .product-page-nav-header-section .product-variant-selector.popup-modal .popup-container{
            padding-top:15px;

        }
        .product-page-nav-header-section .product-variant-selector.popup-modal .popup-close{
            background:unset;
        }
        .product-page-nav-header-section .product-variant-selector.popup-modal .popup-close svg path{
            stroke-width: 2px;
        }
    }
    
    /* ipad Air */
    @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
        .product-page-nav-header-section .main-nav-header-section{
            padding:0;
        }
        .product-page-nav-header-section .selected-nav{
            font-size:12px;
        }
        .product-page-nav-header-section .nav-content{
            padding-left:0px;
        }
        .product-page-nav-header-section .product-info .description{
            display:none;
        }
        .product-page-nav-header-section .nav-content .btn.buy-now{
            padding:8px 16px;
        }
        .product-page-nav-header-section .product-info h5{
            padding-right:0.5rem;
            border:none;
        }
        .product-page-nav-header-section .custom-select-nav{
            display:block;
        }
    }


    /* PRODUCT VARIANT SELECTOR in NAV */
    .product-variant-selector .product .variants fieldset{
        margin-bottom: 15px;
    }
    .product-variant-selector .variants fieldset{
        margin-bottom:30px;
    }
    .product-variant-selector .variants .variant .variant-name{
        font-family: Montserrat;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #161616;
        line-height: normal;
    }
    .product-variant-selector .variant .nav-variants-selector.color{
        border-radius: 50%;
        border-color: transparent;
        border: none !important;
        margin-right: 8px;
        outline: 1px solid #00000047;
        outline-offset: 2px;
    }
    .product-variant-selector .variant .nav-variants-selector.color.selected{
        outline: 1px solid #161616;
    }
    .product-variant-selector .variant.color-variant .nav-variants-selector{
        border: 1px solid black;
    }
    .product-variant-selector .variant .nav-variants-selector{
        font-family: Montserrat;
        font-weight: 500;
        font-size: 16px;
        border: 1px solid #DEDEDE;
        display: inline-block;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        margin: 0;
    }
    .product-variant-selector  .variant .nav-variants-selector.disabled{
        color: #ccc !important;
    }
    .product-variant-selector  .variant .nav-variants-selector.disabled:before{
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 150%;
        height: 1px;
        background-color: #dedede;
        transform-origin: top right;
        transform: rotate(-38deg);
    }
    .product-variant-selector .variant .nav-variants-selector.color.disabled:before{
        content: "";
        position: absolute;
        top: 20%;
        left: 30%;
        width: 100%;
        height: 2px;
        transform: translate(-50%, -50%) rotate(-45deg);
        background: #d1d1d1;
    }
    
    .product-variant-selector .variant .nav-variants-selector.soldout{
        opacity: .6;
    }
    .product-variant-selector .variant .nav-variants-selector.soldout:before{
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 150%;
        height: 1px;
        background-color: #dedede;
        transform-origin: top right;
        transform: rotate(-38deg);

    }
    .product-variant-selector .variant .nav-variants-selector.color.soldout:before{
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        right:unset;
        width: 100%;
        height: 2px;
        transform: translate(-50%, -50%) rotate(-45deg);
        transform-origin:unset;
        background: #d1d1d1;
    }
    .product-variant-selector .variant .nav-variants-selector.color .color-swatch{
        width: 28px;
        height: 28px;
        border-radius: inherit;
        display: block;
    }
    .product-variant-selector .nav-variants-option input{
        display:none;
    }

    .product-variant-selector .variant.variant-size .nav-variants-selector{
        height: 40px;
        width: fit-content;
        min-width:50px;
        padding: 0;
        text-align: center;
        line-height: 40px;
    }
    .product-variant-selector .variant .nav-variants-selector.default.selected{
        border-color: #000;
        color: #fff;
        background: #000;
    }

    .product-variant-selector .quantity{
        background: #fff;
        border: 1px solid #A0A0A0;
        border-radius: 5px;
        overflow: hidden;
        display: flex;
        width: 100%;
        height: 100%;
    }
    .product-variant-selector .quantity button {
        padding: 6px 15px;
        font-family: Montserrat;
        font-size: 20px;
        font-weight: 600;
        color: #1a1a1a;
        background: none;
    }
    .product-variant-selector .quantity>* {
        border: none;
        outline: none;
        box-shadow: none;
    }
    .product-variant-selector .quantity input {
        font-family: Montserrat;
        font-size: 16px;
        font-weight: 600;
        text-align: center;
        width: 40px;
        padding: 0;
        color: #1a1a1a;
        background: none;
        -moz-appearance: textfield;
    }
    .product-variant-selector .quantity input::-webkit-inner-spin-button,
    .product-variant-selector .quantity input::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .product-variant-selector .product-form{
        width: 100%;
    }
    .product-variant-selector .product-form button{
        width:100%;
        display:flex;
        align-items:center;
        justify-content:center;
    }


