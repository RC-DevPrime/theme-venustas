    @media only screen and (min-width: 0px) {
    }
    @media only screen and (min-width: 375px) {
    }
    @media only screen and (min-width: 390px) {
    }
    @media only screen and (min-width: 414px) {
    }
    @media only screen and (min-width: 428px) {
    }
    @media only screen and (min-width: 480px) {
    }

    /* TABLETS ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 768px) {
    }


    /* LAPTOPS --------------------------------------------------------------------------------- */

    @media only screen and (min-width: 1280px) {
        .product-page-nav-header-section .nav-header-container .nav-column:first-child{
            max-width:450px;
        }
    }
    @media only screen and (min-width: 1366px) {
        .product-page-nav-header-section .nav-header-container .nav-column:first-child{
            max-width:450px;
        }
    }
    @media only screen and (min-width: 1440px) {
        .product-page-nav-header-section .nav-header-container .nav-column:first-child{
            max-width:500px;
        }
    }
    @media only screen and (min-width: 1536px) {
        .product-page-nav-header-section .nav-header-container .nav-column:first-child{
            max-width:500px;
        }
    }
    @media only screen and (min-width: 1600px) {
        .product-page-nav-header-section .nav-header-container .nav-column:first-child{
            max-width:500px;
        }
    }

    /* COMPUTERS --------------------------------------------------------------------------------- */
    @media only screen and (min-width: 1920px) {
        .product-page-nav-header-section .nav-header-container .nav-column:first-child{
            max-width:unset;
        }
    }
    @media only screen and (min-width: 2560px) {
        .product-page-nav-header-section .nav-header-container .nav-column:first-child{
            max-width:unset;
        }

    }
{% endstyle %}
<div class="main-div-header">
    <div class="main-nav-header-section">
        <div class="container section-content py-0 upper-detail py-lg-0 py-md-0 py-sm-1">
            <div class="nav-header-container py-lg-0 py-md-0 py-sm-1">
                <div class="nav-column">
                    <div class="product-info flex-lg-row flex-md-row flex-sm-column">
                        <div class="body-lg pp-bold d-lg-block d-md-block d-sm-none" style="color: {{ section.settings.title_color }}">
                        {% if section.settings.custom_product_title != blank %}
                            {{ section.settings.custom_product_title }}
                        {% else %}
                            {{ product.title | replace: '- Development', '' }}
                        {% endif %}
                        </div>

                    
                        <div class="product-price ">
                            <div class="price d-flex gap-2 align-items-center h-100 ms-lg-3 ms-md-3 ms-sm-0">
                                <span class=" pp-bold price-regular price-item--regular f-main l-h-normal">
                                    <span class="body d-lg-block d-md-block d-sm-none">
                                        {{ product.selected_or_first_available_variant.price | money | prepend: curSym }}
                                    </span>
                                    <span class="body-xl d-lg-none d-md-none d-sm-block">
                                        {{ product.selected_or_first_available_variant.price | money | prepend: curSym }}
                                    </span>
                                </span>
                                {% if product.selected_or_first_available_variant.compare_at_price %}
                                    <span class="body-sm pp-regular product-compare-price price-item--sale f-gray t-d-strike l-h-normal">
                                        {{ product.selected_or_first_available_variant.compare_at_price | money | prepend: curSym }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    
                        <div class="custom-select-nav d-lg-none d-md-none d-sm-none">
                        <div class="select-tag body pp-medium"><span class="selected-nav">Overview</span>
                            <img src="https://cdn.shopify.com/s/files/1/0688/8642/9983/files/arrow-down.png?v=1743449790">
                        </div>
                        <div class="custom-select-list">
                            <div class="nav-content">
                                <div class="link-nav">
                                    {% for block in section.blocks %}
                                        <div class="link-nav-item pp-regular {% if forloop.index == 1 %}active{% endif %}" data-scroll="{{ block.settings.nav_title | handleize }}" style="color: {{ block.settings.nav_color }}">{{ block.settings.nav_title }}</div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>
                </div>
                <div class="nav-column btn-nav d-flex align-items-center gap-lg-5 gap-md-4 gap-sm-0">
                    <div class="nav-content d-lg-block d-md-block d-sm-none pe-lg-4 pe-md-3 pe-sm-0">
                        <div class="link-nav">
                            {% for block in section.blocks %}
                            <div class="link-nav-item pp-semibold {% if forloop.index == 1 %}active{% endif %}" data-scroll="{{ block.settings.nav_title | handleize }}" style="color: {{ block.settings.nav_color }}">{{ block.settings.nav_title }}</div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="btn-container d-flex gap-2">
                        <div class="nav-header-buy-now btn buy-now body f-white pp-medium">
                            <span class="body d-lg-block d-md-block d-sm-none">
                                Add To Cart
                            </span>
                            <span class="body d-lg-none d-md-none d-sm-block">
                                Add To Cart
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="mobile-nav d-lg-none d-md-none d-sm-block ">
        <div class="container section-content py-0 bottom-detail">
            <div class="nav-content">
                <div class="link-nav justify-content-between w-100">
                    {% for block in section.blocks %}
                        <div class="link-nav-item body pp-medium {% if forloop.index == 1 %}active{% endif %}" data-scroll="{{ block.settings.nav_title | handleize }}" style="color: {{ block.settings.nav_color }}">
                            <span class="body d-lg-block d-md-block d-sm-none">
                                {{ block.settings.nav_title }}
                            </span>
                            <span class="body-lg d-lg-none d-md-none d-sm-block">
                                {{ block.settings.nav_title }}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        </div>
    </div>
</div>

<div class="product-variant-selector popup-modal">
    <div class="popup-overlay">
    </div>
    <div class="popup-content"> 
        <div class="popup-header">
            <button class="popup-close" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="23" viewBox="0 0 21 23" fill="none">
                    <path d="M18.3666 2.78979L2.19995 20.0271M2.19995 2.78979L18.3666 20.0271" stroke="#000" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </button>
        </div>
        <div class="popup-container d-flex justify-content-center pb-3">
            <div class="col-lg-11 col-md-11 col-sm-12">
                {% unless product.has_only_default_variant %}
                    {% render 'nav-product-variant', product: product %}
                {% endunless %}

                <div class="product-details nav-product-details">
                    <div class="nav-availability-section">
                        <div class="heading-content">
                            <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1.791 2.253l-.597 3.583A1 1 0 002.18 7h.893a1.5 1.5 0 001.342-.83L5 5l.585 1.17A1.5 1.5 0 006.927 7h1.146a1.5 1.5 0 001.342-.83L10 5l.585 1.17a1.5 1.5 0 001.342.83h1.146a1.5 1.5 0 001.342-.83L15 5l.585 1.17a1.5 1.5 0 001.342.83h.893a1 1 0 00.986-1.164l-.597-3.583A1.5 1.5 0 0016.729 1H3.271a1.5 1.5 0 00-1.48 1.253z" fill="#5C5F62"></path>
                                <path d="M18 9H2v8.5A1.5 1.5 0 003.5 19H7v-7h6v7h3.5a1.5 1.5 0 001.5-1.5V9z" fill="#5C5F62"></path>
                            </svg>
                            <span class="body-lg pp-bold d-lg-block d-md-block d-sm-none">Availability</span>
                            <span class="body pp-bold d-lg-none d-md-none d-sm-block">Availability</span>
                        </div>
                        <div class="nav-inventory-info-app"></div>
                    </div>
                </div>
                
                <div class="d-flex gap-lg-3 gap-md-3 gap-sm-2 mt-lg-5 mt-md-5 mt-sm-3">
                    <div class="quantity-container flex-1">
                        <quantity-input class="quantity">
                            <!-- Minus button with accessible label -->
                            <button type="button" 
                                    name="minus" 
                                    class="less_qty" 
                                    aria-label="Decrease quantity">
                                -
                            </button>

                            <!-- Quantity input with label for accessibility -->
                            <label for="nav-Quantity-nav-{{ product.id }}" class="sr-only">Quantity</label>
                            <input class="qty quantity__input nav-quantity__input"
                                type="number"
                                name="quantity"
                                id="nav-Quantity-nav-{{ product.id }}"
                                min="1"
                                value="1"
                                readonly
                                aria-live="polite"
                            >

                            <!-- Plus button with accessible label -->
                            <button type="button" 
                                    name="plus" 
                                    class="add_qty" 
                                    aria-label="Increase quantity">
                                +
                            </button>
                        </quantity-input>
                    </div>
 
                    <div class="product-form">
                        {% form 'product', product, id: 'header-nav-product-form', class: 'product-atc-form form h-100', novalidate: 'novalidate', data-type: 'add-to-cart-form', action: 'javascript:void(0)' %}
                            <input type="hidden" name="id" id="main-product-id-nav" value="{{ product.selected_or_first_available_variant.id }}">
                            <div class="form-btn h-100">
                                <button type='submit' name="add" class="btn-atc btn-hover btn-main h-100" {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
                                    <span class="body-lg pp-semibold f-white">
                                            Add To Cart
                                    </span>
                                </button>
                            </div>
                        {% endform %}
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var navSection = document.querySelector('.product-page-nav-header-section');
        if (!navSection || navSection.dataset.navInventorySyncReady === 'true') return;

        navSection.dataset.navInventorySyncReady = 'true';

        function getInventorySource() {
            return document.querySelector('.product .availability-section .iia-container')
                || document.querySelector('.product #inventory-info-app .iia-container')
                || document.querySelector('#inventory-info-app .iia-container');
        }

        function syncNavInventoryMarkup() {
            var target = navSection.querySelector('.nav-inventory-info-app');
            var source = getInventorySource();

            if (!target) return;
            if (target.querySelector('.iia-list-item, .iia-details-container, .iia-list')) return;

            if (!source) {
                return;
            }

            var nextMarkup = source.outerHTML;
            if (target.innerHTML === nextMarkup) {
                return;
            }

            target.innerHTML = nextMarkup;

            var mirrored = target.querySelector('.iia-container');
            if (mirrored) {
                mirrored.style.display = 'block';
            }
        }

        syncNavInventoryMarkup();
        window.setTimeout(syncNavInventoryMarkup, 300);
        window.setTimeout(syncNavInventoryMarkup, 1000);

        navSection.addEventListener('click', function (event) {
            if (event.target.closest('.nav-header-buy-now')) {
                window.setTimeout(syncNavInventoryMarkup, 0);
            }
        });
    });
</script>
{% schema %}
    {
        "class": "product-page-nav-header-section",
        "name": "Navigation Header",
        "templates": ["product"],
        "limit": 1, 
        "max_blocks": 6,
        "settings": [
            {
                "type": "color",
                "id": "background_color",
                "label": "Background Color",
                "default":"#2a2a2a"
            },
            {
              "type": "text",
              "id": "custom_product_title",
              "label": "Custom product Title"
            },
            {
                "type": "color",
                "id": "title_color",
                "label": "Title Color",
                "default":"#fff"
            },
        ],
        "blocks": [
            {
              "type": "Navigation",
              "name":"Navigation",
              "settings": [
                  {
                    "type": "text",
                    "id": "nav_title",
                    "label": "Nav Title"
                  },
                    {
                        "type": "color",
                        "id": "nav_color",
                        "label": "Nav Color",
                        "default":"#fff"
                    }
              ]
            }
        ],
        "presets" :[{
            "name" : "Navigation Header"
        }]
    }
  {% endschema %} 
