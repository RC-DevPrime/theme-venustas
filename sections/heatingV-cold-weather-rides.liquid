{%- style -%}
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides { overflow: hidden; color: #fff; background: #1a1a1a; font-family: var(--font-primary, 'Montserrat', sans-serif); }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__inner { width: min(calc(100% - 40px), 1340px); margin: 0 auto; padding: 100px 0; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__intro { display: flex; flex-direction: column; gap: 14px; margin-bottom: 100px; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides h2,
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides p { margin: 0; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__title { font-size: 34px; font-weight: 700; line-height: 1.16; letter-spacing: -.952px; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__subtitle { font-size: 16px; line-height: 1.4; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__rail { display: flex; height: 480px; gap: 18px; align-items: stretch; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card { position: relative; flex: 0 0 162px; min-width: 0; overflow: hidden; border-radius: 12px; cursor: pointer; transition: flex-basis .7s cubic-bezier(.22,1,.36,1); }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card.is-active,
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card:hover { flex-basis: 806px; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__media,
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__media picture,
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__media img { display: block; width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__media img { object-fit: cover; object-position: center; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card.is-active .heatingV-cold-weather-rides__media img { object-position: left center; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__shade { position: absolute; inset: 0; background: linear-gradient(193deg, transparent 45%, rgba(5,6,8,.35) 100%); }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__copy { position: absolute; right: 0; bottom: 0; left: 0; padding: 24px; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__accent { width: 24px; height: 3px; margin-bottom: 12px; border-radius: 2px; background: #b93205; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card-title { font-size: 16px; font-weight: 600; line-height: 1.3; white-space: nowrap; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card-description { margin-top: 8px !important; font-size: 12px; font-style: italic; line-height: 1.45; opacity: .88; }
  #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__mobile-controls { display: none; }
  @media (max-width: 1199px) { #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__inner { padding: 80px 0; } #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__intro { margin-bottom: 64px; } }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__inner { width: 100%; padding: 40px 0; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__intro { width: calc(100% - 40px); margin: 0 auto 28px; gap: 16px; text-align: center; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__title { font-size: 28px; line-height: normal; letter-spacing: 0; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__subtitle { font-size: 16px; line-height: normal; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__viewport { width: 100%; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x mandatory; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__viewport::-webkit-scrollbar { display: none; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__rail { width: max-content; height: 380px; gap: 12px; padding: 0 25px; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card,
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card.is-active,
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card:hover { width: 300px; flex-basis: 300px; height: 380px; scroll-snap-align: center; cursor: default; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__copy { padding: 20px;top:0; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__accent { display: none; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card-title { padding: 12px; border-radius: 6px; background: rgba(255,255,255,.64); color: #1a1a1a; font-size: 14px; line-height: 1.3; text-align: center; white-space: normal; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card-description { margin-top: 0 !important; padding: 0 12px 12px; border-radius: 0 0 6px 6px; background: rgba(255,255,255,.64); color: #1a1a1a; font-size: 14px; font-style: normal; line-height: 1.4; text-align: center; opacity: 1; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__mobile-controls { display: flex; justify-content: center; gap: 10px; margin-top: 20px; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__dot { width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%; background: #7d7d7d; }
    #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__dot.is-active { background: #b93205; }
  }
  @media (max-width: 500px) { #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__viewport { width: min(100%, 350px); margin: 0 auto; } }
  @media (min-width: 768px) and (max-width: 1390px) { #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__rail { height: 420px; } #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card.is-active, #shopify-section-{{ section.id }} .heatingV-cold-weather-rides__card:hover { flex-basis: 60%; } }
{%- endstyle -%}

<section class="heatingV-cold-weather-rides" data-heatingv-rides>
  <div class="heatingV-cold-weather-rides__inner">
    <div class="heatingV-cold-weather-rides__intro"><h2 class="heatingV-cold-weather-rides__title">{{ section.settings.title | escape }}</h2><p class="heatingV-cold-weather-rides__subtitle">{{ section.settings.subtitle | escape }}</p></div>
    <div class="heatingV-cold-weather-rides__viewport">
      <div class="heatingV-cold-weather-rides__rail">
        {%- for block in section.blocks -%}
          <article class="heatingV-cold-weather-rides__card{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            <div class="heatingV-cold-weather-rides__media">
              {%- if block.settings.desktop_image != blank -%}<picture>{%- if block.settings.mobile_image != blank -%}<source media="(max-width: 767px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}" sizes="300px">{%- endif -%}{{ block.settings.desktop_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 800, 1200, 1600', sizes: '(max-width: 767px) 300px, 60vw', alt: block.settings.title }}</picture>{%- endif -%}
              <span class="heatingV-cold-weather-rides__shade" aria-hidden="true"></span>
            </div>
            <div class="heatingV-cold-weather-rides__copy"><div class="heatingV-cold-weather-rides__accent"></div><h3 class="heatingV-cold-weather-rides__card-title">{{ block.settings.title | escape }}</h3><p class="heatingV-cold-weather-rides__card-description">{{ block.settings.description | escape }}</p></div>
          </article>
        {%- endfor -%}
      </div>
    </div>
    <div class="heatingV-cold-weather-rides__mobile-controls" aria-label="Ride stories pagination">
      {%- for block in section.blocks -%}<button class="heatingV-cold-weather-rides__dot{% if forloop.first %} is-active{% endif %}" type="button" aria-label="Go to slide {{ forloop.index }}" data-slide="{{ forloop.index0 }}"></button>{%- endfor -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const init = (root) => {
      const cards = [...root.querySelectorAll('.heatingV-cold-weather-rides__card')];
      const viewport = root.querySelector('.heatingV-cold-weather-rides__viewport');
      const dots = [...root.querySelectorAll('.heatingV-cold-weather-rides__dot')];
      if (!cards.length || !viewport) return;
      let replayTimer;
      let sectionInView = false;

      const stopReplay = () => {
        window.clearTimeout(replayTimer);
        cards.forEach((card) => card.classList.remove('is-active'));
        cards[0]?.classList.add('is-active');
      };

      const replayDesktopAnimation = () => {
        if (!window.matchMedia('(min-width: 768px)').matches) return;
        window.clearTimeout(replayTimer);
        cards.forEach((card) => card.classList.remove('is-active'));
        let index = 0;
        const step = () => {
          cards.forEach((card, cardIndex) => card.classList.toggle('is-active', cardIndex === index));
          index += 1;
          if (index < cards.length) replayTimer = window.setTimeout(step, 720);
          else replayTimer = window.setTimeout(() => cards[0]?.classList.add('is-active'), 720);
        };
        window.requestAnimationFrame(step);
      };

      cards.forEach((card, index) => card.addEventListener('mouseenter', () => { if (window.matchMedia('(min-width: 768px)').matches) { cards.forEach((item) => item.classList.remove('is-active')); card.classList.add('is-active'); } }));
      dots.forEach((dot, index) => dot.addEventListener('click', () => { cards[index]?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' }); }));
      viewport.addEventListener('scroll', () => { if (window.matchMedia('(max-width: 767px)').matches) { const center = viewport.scrollLeft + viewport.clientWidth / 2; let active = 0; cards.forEach((card, index) => { if (Math.abs(card.offsetLeft + card.offsetWidth / 2 - center) < Math.abs(cards[active].offsetLeft + cards[active].offsetWidth / 2 - center)) active = index; }); dots.forEach((dot, index) => dot.classList.toggle('is-active', index === active)); } }, { passive: true });

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.intersectionRatio >= 0.35 && !sectionInView) {
              sectionInView = true;
              replayDesktopAnimation();
            } else if (entry.intersectionRatio < 0.1 && sectionInView) {
              sectionInView = false;
              stopReplay();
            }
          });
        }, { threshold: [0, 0.1, 0.35] });
        observer.observe(viewport);
      } else {
        replayDesktopAnimation();
      }
    };
    document.querySelectorAll('[data-heatingv-rides]').forEach(init);
    document.addEventListener('shopify:section:load', (event) => { const root = event.target.querySelector?.('[data-heatingv-rides]'); if (root) init(root); });
  })();
</script>

{% schema %}
{
  "name": "HeatingV Weather Rides",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Made for the People Who Stay Out Longest" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Year after year, the riders, anglers and crews who stayed out longest told us the same thing: more heat when it really gets cold. Volcano™ is our answer." }
  ],
  "blocks": [{
    "type": "ride",
    "name": "Ride card",
    "settings": [
      { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
      { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
      { "type": "text", "id": "title", "label": "Card title", "default": "ICE FISHING · [-40]°F" },
      { "type": "textarea", "id": "description", "label": "Card description", "default": "After hours on the ice, I could still feel the warmth." }
    ]
  }],
  "presets": [{
    "name": "HeatingV Weather Rides",
    "blocks": [
      { "type": "ride", "settings": { "title": "ICE FISHING · [-40]°F", "description": "After hours on the ice, I could still feel the warmth." } },
      { "type": "ride", "settings": { "title": "SNOWMOBILE · [-30]°F", "description": "Even with the freezing wind, my core stayed warm." } },
      { "type": "ride", "settings": { "title": "WORKING OUTSIDE · [-20]°F", "description": "Cold mornings are part of my job. Staying warm makes all the difference." } },
      { "type": "ride", "settings": { "title": "AURORA WATCH · AROUND -25°F AFTER MIDNIGHT", "description": "Hours beside a tripod, waiting for the sky to light up. You can't leave, and you can't move around to stay warm." } }
    ]
  }]
}
{% endschema %}
