{{ 'special-discount.css' | asset_url | stylesheet_tag }}

<section
  id="sd-special-hero-{{ section.id }}"
  class="sd-sp sd-special-hero"
  style="
    --sd-pad-x: {{ section.settings.content_horizontal_padding | default: 20 }}px;
    --sd-pad-x-mobile: {{ section.settings.mobile_content_horizontal_padding | default: 16 }}px;
    --sd-hero-copy-max: {{ section.settings.hero_copy_max_width }}px;
  "
>
  <div class="sd-special-hero__bg">
    {% if section.settings.background_image != blank %}
      <img
        class="sd-special-hero__bg-img"
        src="{{ section.settings.background_image | image_url: width: 2400 }}"
        srcset="
          {{ section.settings.background_image | image_url: width: 1000 }} 1000w,
          {{ section.settings.background_image | image_url: width: 1600 }} 1600w,
          {{ section.settings.background_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt="{{ section.settings.background_image.alt | default: section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {% else %}
      <div class="sd-special-hero__bg-placeholder" aria-hidden="true"></div>
    {% endif %}
    <div class="sd-special-hero__overlay"></div>
  </div>

  <div class="sd-sp-container sd-special-hero__inner">
    <div class="sd-special-hero__copy">
      {% if section.settings.heading != blank %}
        <h1 class="sd-special-hero__title">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="sd-special-hero__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    width: 100%;
    max-width: none;
    margin-left: 0;
    margin-right: 0;
  }

  #shopify-section-{{ section.id }} > section {
    width: 100%;
    max-width: none;
    margin-left: 0;
    margin-right: 0;
    box-sizing: border-box;
  }

  #sd-special-hero-{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.min_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-bg-x: {{ section.settings.bg_position_x }}%;
    --hero-bg-y: {{ section.settings.bg_position_y }}%;
  }

  #sd-special-hero-{{ section.id }} .sd-special-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #sd-special-hero-{{ section.id }} .sd-special-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-bg-x) var(--hero-bg-y);
    display: block;
  }

  #sd-special-hero-{{ section.id }} .sd-special-hero__bg-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, #2a3a4a 0%, #1a2530 100%);
  }

  #sd-special-hero-{{ section.id }} .sd-special-hero__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--hero-overlay);
    pointer-events: none;
  }

  #sd-special-hero-{{ section.id }} .sd-special-hero__inner.sd-sp-container {
    width: {{ section.settings.content_width_percent | default: 85 }}%;
    max-width: min(1600px, 100%);
    margin-left: auto;
    margin-right: auto;
    position: relative;
    z-index: 1;
    text-align: center;
    padding-block: {{ section.settings.vertical_padding }}px;
  }

  #sd-special-hero-{{ section.id }} .sd-special-hero__copy {
    margin: 0 auto;
    width: 100%;
    max-width: min(100%, var(--sd-hero-copy-max, 900px));
  }

  #sd-special-hero-{{ section.id }} .sd-special-hero__title {
    margin: 0 0 0.65rem;
    font-size: clamp(1.75rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.1;
    color: {{ section.settings.heading_color }};
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  #sd-special-hero-{{ section.id }} .sd-special-hero__subtitle {
    margin: 0;
    font-size: clamp(1rem, 2.2vw, 1.35rem);
    font-weight: 700;
    line-height: 1.35;
    color: {{ section.settings.subheading_color }};
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 749px) {
    #sd-special-hero-{{ section.id }} {
      min-height: {{ section.settings.mobile_min_height }}px;
    }

    #sd-special-hero-{{ section.id }} .sd-special-hero__inner.sd-sp-container {
      width: {{ section.settings.mobile_content_width_percent | default: 100 }}%;
      padding-block: {{ section.settings.mobile_vertical_padding }}px;
    }
  }
</style>

{% schema %}
{
  "name": "SD — Hero",
  "tag": "section",
  "class": "sd-special-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay darkness",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 15,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bg_position_x",
      "label": "Background focus X",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bg_position_y",
      "label": "Background focus Y",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 45,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Min height (desktop)",
      "min": 320,
      "max": 900,
      "step": 20,
      "default": 520,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_min_height",
      "label": "Min height (mobile)",
      "min": 280,
      "max": 720,
      "step": 20,
      "default": 420,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Inner vertical padding (desktop)",
      "min": 24,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_vertical_padding",
      "label": "Inner vertical padding (mobile)",
      "min": 20,
      "max": 80,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Content width"
    },
    {
      "type": "range",
      "id": "content_width_percent",
      "label": "Content width",
      "min": 70,
      "max": 100,
      "step": 1,
      "default": 85,
      "unit": "%",
      "info": "% of the full row (centered); left/right show as empty margin. Max width 1600px."
    },
    {
      "type": "range",
      "id": "mobile_content_width_percent",
      "label": "Content width (mobile)",
      "min": 70,
      "max": 100,
      "step": 1,
      "default": 100,
      "unit": "%",
      "info": "Screens ≤749px. Band width inside the section row (centered)."
    },
    {
      "type": "range",
      "id": "content_horizontal_padding",
      "label": "Desktop horizontal inset",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 20,
      "unit": "px",
      "info": "Extra padding inside the band on screens ≥990px."
    },
    {
      "type": "range",
      "id": "mobile_content_horizontal_padding",
      "label": "Mobile horizontal inset",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 16,
      "unit": "px",
      "info": "Left/right inset on screens ≤749px."
    },
    {
      "type": "range",
      "id": "hero_copy_max_width",
      "label": "Hero text max width",
      "min": 560,
      "max": 1000,
      "step": 20,
      "default": 900,
      "unit": "px",
      "info": "Max width for the headline block (centered inside the band)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Venustas Special Discounts"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "25% Discount Exclusively for You"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    }
  ],
  "presets": [{ "name": "SD — Hero" }]
}
{% endschema %}
