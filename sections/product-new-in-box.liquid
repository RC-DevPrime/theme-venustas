{%- liquid
  assign item_count = 0
  for block in section.blocks
    if block.settings.image != blank or block.settings.title != blank or block.settings.quantity != blank
      assign item_count = item_count | plus: 1
    endif
  endfor
  assign safe_item_count = item_count | at_least: 1
  assign total_gaps = item_count | minus: 1 | at_least: 0 | times: 16
  assign desktop_image_width = 1340 | minus: total_gaps | divided_by: safe_item_count
  assign viewport_spacing = total_gaps | plus: 40
  capture image_sizes
    echo '(max-width: 767px) 200px, (max-width: 1379px) calc((100vw - ' | append: viewport_spacing | append: 'px) / ' | append: safe_item_count | append: '), ' | append: desktop_image_width | append: 'px'
  endcapture
-%}

{% style %}
  #shopify-section-{{ section.id }} .product-new-in-box {
    padding: 80px 0;
    background: #fff;
    color: #1a1a1a;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .product-new-in-box__inner {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .product-new-in-box__heading {
    margin: 0 0 48px;
    color: inherit;
    font-size: 34px;
    font-weight: 700;
    line-height: 1.22;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .product-new-in-box__list {
    display: grid;
    grid-template-columns: repeat({{ safe_item_count }}, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .product-new-in-box__list:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .product-new-in-box__item {
    min-width: 0;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .product-new-in-box__media {
    height: 214.398px;
  }

  #shopify-section-{{ section.id }} .product-new-in-box__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .product-new-in-box__title,
  #shopify-section-{{ section.id }} .product-new-in-box__quantity {
    margin: 0;
    font-size: 14px;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .product-new-in-box__title {
    color: #141414;
    font-weight: 600;
    line-height: 20.25px;
  }

  #shopify-section-{{ section.id }} .product-new-in-box__quantity {
    color: #6b6b6b;
    font-weight: 500;
    line-height: 20px;
  }

  #shopify-section-{{ section.id }} .product-new-in-box__media + .product-new-in-box__title,
  #shopify-section-{{ section.id }} .product-new-in-box__media + .product-new-in-box__quantity {
    margin-top: 14px;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-new-in-box__heading {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .product-new-in-box__list {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(200px, 100%);
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .product-new-in-box__list::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .product-new-in-box__media + .product-new-in-box__title,
    #shopify-section-{{ section.id }} .product-new-in-box__media + .product-new-in-box__quantity {
      margin-top: 26px;
    }

    #shopify-section-{{ section.id }} .product-new-in-box__title + .product-new-in-box__quantity {
      margin-top: 12px;
    }
  }
{% endstyle %}

{%- if section.settings.heading != blank or item_count > 0 -%}
  <section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | strip | remove_first: '#' | escape }}"{% endif %} class="product-new-in-box">
    <div class="product-new-in-box__inner">
      {%- if section.settings.heading != blank -%}<h2 class="product-new-in-box__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if item_count > 0 -%}
        <ul class="product-new-in-box__list" role="list" tabindex="0" aria-label="{{ section.settings.heading | default: 'In the box' | escape }}">
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank or block.settings.title != blank or block.settings.quantity != blank -%}
              <li class="product-new-in-box__item" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <div class="product-new-in-box__media">
                    {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'product-new-in-box__image', loading: 'lazy', widths: '200, 400, 600, 800, 1000, 1340, 1600', sizes: image_sizes }}
                  </div>
                {%- endif -%}
                {%- if block.settings.title != blank -%}<h3 class="product-new-in-box__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
                {%- if block.settings.quantity != blank -%}<p class="product-new-in-box__quantity">{{ block.settings.quantity | escape }}</p>{%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "productN In the Box",
  "tag": "section",
  "class": "product-new-in-box-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In the Box" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Box item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "quantity", "label": "Quantity", "default": "× 1" }
      ]
    }
  ],
  "presets": [
    {
      "name": "productN In the Box",
      "blocks": [
        { "type": "item", "settings": { "title": "Men's Classic Heated Vest", "quantity": "× 1" } },
        { "type": "item", "settings": { "title": "5K Battery (36Wh)", "quantity": "× 1" } },
        { "type": "item", "settings": { "title": "USB-C Charging Cable", "quantity": "× 1" } },
        { "type": "item", "settings": { "title": "Carry Bag", "quantity": "× 1" } },
        { "type": "item", "settings": { "title": "User Manual (English)", "quantity": "× 1" } }
      ]
    }
  ]
}
{% endschema %}
