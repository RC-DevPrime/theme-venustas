{% style %}
    .featured-banner-section .content-description{
        text-align: left;
    }
    .featured-banner-section .content-description p{
        margin: 0;
    }
    .featured-banner-section .featured-image-container{
        height:400px;
        overflow:hidden;
        border-radius:12px;
    }
    .featured-banner-section .featured-image-container img{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .featured-banner-section .row{
        --bs-gutter-x: 80px;
        --bs-gutter-y: 1.5rem;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .featured-banner-section .content-description{
            text-align: center;
        }
        .featured-banner-section .content-description p{
            font-size: 1rem;
            line-height: 1.5;
        }
        .featured-banner-section .featured-image-container{
            height:220px;
            border-radius:6px;
        }
        .featured-banner-section .row{
            --bs-gutter-x: 0px;
            --bs-gutter-y: 1.5rem;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content pb-0">
    <div class="row align-items-center">
        <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="content-text">
                <h2 class="pp-bold f-black title-sm pb-lg-3 pb-md-3 pb-sm-2 text-lg-start text-md-start text-sm-center">
                    {{ section.settings.heading }}
                </h2>
                <div class="content-description pp-regular f-black body-lg">
                    {{  section.settings.description }}
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="featured-image-container">
                <img
                    src="{{ section.settings.image | img_url: '1024x1024' }}"
                    srcset="
                        {{ section.settings.image | img_url: '480x480' }} 480w,
                        {{ section.settings.image | img_url: '768x768' }} 768w,
                        {{ section.settings.image | img_url: '1024x1024' }} 1024w,
                        {{ section.settings.image | img_url: '1600x1600' }} 1600w"
                    sizes="100vw"
                    width="100%"
                    height="100%"
                    alt="{{ section.settings.image.alt | escape }}"
                    decoding="async"
                    fetchpriority="high"
                />
            </div>
        </div>

    </div>
</div>
{% schema %}
{
    "class": "featured-banner-section",
    "name": "Featured Banner",
    "limit": 1,
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Men's Clothing"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Welcome to the World of Venustas Menswear！We are dedicated to creating winter apparel for the modern man that combines both cutting-edge technology and practical functionality. Whether you’re a city commuter, an outdoor adventurer, or someone who pursues a balance of style and comfort in everyday wear, you’ll find your ideal choice here.</p>"
        }
    ],
    "templates": ["collection"],
}
{% endschema %}