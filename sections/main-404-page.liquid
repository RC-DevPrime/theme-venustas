{% style %}
    .main-404-section{

    }
    .main-404-section .featured-image img{
        width:100%;
        height:100%;
        object-fit:contain;
    }
{% endstyle %}
<div class="container section-content">
    <div class="col-lg-7 col-md-8 col-sm-12 mx-auto">
        <div class="featured-image mb-lg-3 mb-md-3 mb-sm-2">
            <img src="{{ section.settings.background_image | img_url: '1400x1400' }}" width="100%" height="100%">
        </div>
        <div class="col-lg-10 col-md-10 col-sm-12 mx-auto">
            <h2 class="pp-bold text-center title-md pb-lg-4 pb-md-4 pb-sm-3">
                {{ section.settings.heading }}
            </h2>
            <div class="pp-regular text-center body-xl pb-lg-4 pb-md-4 pb-sm-3">
                {{ section.settings.description }}
            </div>
            <div class="d-flex align-items-center justify-content-center">
                <a href="/" class="btn-hover btn-main">
                    <span>Back To Homepage</span>
                </a>
            </div>
        </div>
    </div>
</div>
{% schema %}
{
    "class": "main-404-section",
    "name": "Main 404",
    "limit": 1,
    "templates": ["404"],
    "settings": [
        {
            "type": "image_picker",
            "id": "background_image",
            "label": "Background Image"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Page Not Found"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Oops! The page you're looking for may have been moved or updated.</p>"
        }
    ],
    "presets": [
        {
            "name": "Main 404"
        }
    ]
}
{% endschema %}