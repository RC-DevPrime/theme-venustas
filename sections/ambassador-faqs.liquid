{% style %}
    .faqs-section .faqs-inner-section{
        background: #F9F9F9;
        border-radius: 8px 8px 8px 8px;
        padding:2.5rem 1.5rem;
    }
    .faqs-section .loadMoreFaqbtn {
        cursor:pointer;
        width:fit-content;
        margin:auto;
    }
    .faqs-section .loadMoreFaqbtn:hover{
        color: #B93205;
    }
    
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .faqs-section .faqs-inner-section{
            padding: 20px 10px;
        }
        .faqs-section .accordion-button{
            padding:15px 0px 10px;
        }
        .faqs-section .accordion-body{
            padding-left:0px;
            padding-right:15px;
            padding-bottom:1rem;
        }
        .faqs-section .accordion-body,
        .faqs-section .accordion-body a{
            font-size:14px;
        }
    }
{% endstyle %}
<div class="container section-content  
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}>

    <div class="faqs-inner-section">
        <h2 class="pp-bold title-sm text-center pb-lg-5 pb-md-5 pb-sm-3">
            {{ section.settings.heading }}
        </h2>

        <div class="accordion" id="faqAccordion">
        {% for block in section.blocks %}
            {% assign index = forloop.index %}
            <div class="accordion-item ">
            <h2 class="accordion-header" id="heading-{{ section.id }}-{{ index }}">
                <button 
                class="accordion-button {% unless forloop.first %}collapsed{% endunless %} " 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#collapse-{{ section.id }}-{{ index }}" 
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" 
                aria-controls="collapse-{{ section.id }}-{{ index }}">
                    <span class="pp-bold body-lg l-h-normal d-lg-block d-md-block d-sm-none">
                        {{ block.settings.heading }}
                    </span>
                    <span class="pp-semibold body-lg l-h-normal d-lg-none d-md-none d-sm-block">
                        {{ block.settings.heading }}
                    </span>
                </button>
            </h2>
            <div 
                id="collapse-{{ section.id }}-{{ index }}" 
                class="accordion-collapse collapse {% if forloop.first %}show{% endif %}" 
                aria-labelledby="heading-{{ section.id }}-{{ index }}" 
                data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                {{ block.settings.body }}
                </div>
            </div>
            </div>
        {% endfor %}
        </div>


    </div>
</div>
{% schema %}
{
    "class": "faqs-section",
    "name": "FAQs Section",
    "limit": 1,
    "templates": ["page"],
    "settings": [
        {
            "type": "checkbox",
            "id": "enabled_section_child_scroll",
            "label": "Enabled Section Child Scroll"
        },
        {
            "type": "text",
            "id": "section_scroll_nav",
            "label": "Section Scroll Nav",
            "info": "Need to Enabled first Section Scroll"
        },
        {
            "type": "text",
            "id": "nav_title",
            "label": "Navigation Title"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Frequently asked questions"
        }
    ],
    "blocks": [
        {
            "type": "FAQ",
            "name": "FAQ",
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "richtext",
                    "id": "body",
                    "label": "Body"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "FAQs Section"
        }
    ]
}
{% endschema %}