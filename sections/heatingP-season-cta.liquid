{% style %}
  #shopify-section-{{ section.id }} .heatingP-season-cta {
    background:
      linear-gradient(0deg, rgba(185, 50, 5, .5) 0%, rgba(20, 22, 26, .5) 65.529%),
      #14161a;
    color: #fff;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
    padding: 80px 40px 60px;
  }

  #shopify-section-{{ section.id }} .heatingP-season-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 1840px);
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heatingP-season-cta__title,
  #shopify-section-{{ section.id }} .heatingP-season-cta__description,
  #shopify-section-{{ section.id }} .heatingP-season-cta__guarantee {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heatingP-season-cta__title {
    font-size: 34px;
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -.95px;
  }

  #shopify-section-{{ section.id }} .heatingP-season-cta__description {
    max-width: 593px;
    padding-top: 14px;
    padding-bottom: 40px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.72;
  }

  #shopify-section-{{ section.id }} .heatingP-season-cta__buttons {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .heatingP-season-cta__mobile-button {
    display: none;
  }

  #shopify-section-{{ section.id }} .heatingP-button {
    display: inline-flex;
    min-height: 41px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px 14px;
    border: 1px solid var(--color-brand, #b93205);
    border-radius: 6px;
    background: var(--color-brand, #b93205);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    transition: background-color .22s ease, color .22s ease;
  }

  #shopify-section-{{ section.id }} .heatingP-button:hover {
    background: #8f2403;
    color: #fff;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .heatingP-button__icon {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .heatingP-season-cta__button--small {
    width: 196px;
  }

  #shopify-section-{{ section.id }} .heatingP-season-cta__button--wide {
    width: 292px;
  }

  #shopify-section-{{ section.id }} .heatingP-button.heatingP-season-cta__button--small{
    padding:12px 14px 14px;
  }

  #shopify-section-{{ section.id }} .heatingP-season-cta__guarantee {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: center;
    padding-top: 24px;
    color: #a5aab1;
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingP-season-cta {
      padding: 56px 20px 40px;
    }

    #shopify-section-{{ section.id }} .heatingP-season-cta__inner {
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .heatingP-season-cta__title {
      width: 100%;
      font-size: 22px;
      line-height: 1.3;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heatingP-season-cta__description {
      width: 100%;
      padding: 0;
      font-size: 14px;
      line-height: 1.3;
      white-space: pre-line;
    }

    #shopify-section-{{ section.id }} .heatingP-season-cta__buttons {
      display: none;
    }

    #shopify-section-{{ section.id }} .heatingP-season-cta__mobile-button {
      display: block;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .heatingP-season-cta__mobile-button .heatingP-button {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .heatingP-season-cta__guarantee {
      display: flex;
      width: 100%;
      padding-top: 0;
      font-size: 12px;
      line-height: 1.3;
      row-gap: 8px;
    }
  }
{% endstyle %}

<section class="heatingP-season-cta">
  <div class="heatingP-season-cta__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="heatingP-season-cta__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="heatingP-season-cta__description">{{ section.settings.description }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="heatingP-season-cta__buttons">
        {%- for block in section.blocks -%}
          {%- assign button_width_class = 'heatingP-season-cta__button--small' -%}
          {%- if block.settings.button_size == 'wide' -%}
            {%- assign button_width_class = 'heatingP-season-cta__button--wide' -%}
          {%- endif -%}
          <div {{ block.shopify_attributes }}>
            {%- render 'heatingP-button', label: block.settings.label, url: block.settings.link, class: button_width_class -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="heatingP-season-cta__mobile-button">
      {%- render 'heatingP-button', label: section.settings.mobile_button_label, url: section.settings.mobile_button_link -%}
    </div>

    <p class="heatingP-season-cta__guarantee">
      <span>3-Year Warranty on Heating Elements</span>
      <span aria-hidden="true">|</span>
      <span>Free Shipping</span>
      <span aria-hidden="true">|</span>
      <span>30-day Return</span>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "HeatingP CTA",
  "tag": "section",
  "class": "heatingP-season-cta-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Ride further into the season" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Pick a starting point. The system grows from there." },
    { "type": "text", "id": "mobile_button_label", "label": "Mobile button label", "default": "Shop Apex™ Collection" },
    { "type": "url", "id": "mobile_button_link", "label": "Mobile button link" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Apex™ Jacket Liner" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "button_size",
          "label": "Button width",
          "default": "small",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "wide", "label": "Wide" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HeatingP CTA",
      "blocks": [
        { "type": "button", "settings": { "label": "Apex™ Jacket Liner", "button_size": "small" } },
        { "type": "button", "settings": { "label": "Apex™ Jacket + Pants Liner Set", "button_size": "wide" } },
        { "type": "button", "settings": { "label": "Apex™ Pants Liner", "button_size": "small" } }
      ]
    }
  ]
}
{% endschema %}
