                                {% endif %}

                                    <div class="col-lg-6 col-md-6 col-sm-12">
                                    <div class="item-data">
                                        <div class="row">
                                        <div class="col-lg-4 col-md-4 col-sm-6">
                                            <div class="pp-semibold body-lg">
                                                <span class="body-lg d-lg-block d-md-block d-sm-none">
                                                    {{ title }}
                                                </span>
                                                <span class="body-sm d-lg-none d-md-none d-sm-block pp-bold">
                                                {{ title }}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-lg-8 col-md-8 col-sm-6">
                                            <div class="pp-regular body l-h-normal">
                                                <span class="body d-lg-block d-md-block d-sm-none">
                                                    {{ value }}
                                                </span>
                                                <span class="body-sm d-lg-none d-md-none d-sm-block">
                                                    {{ value }}
                                                </span>
                                            </div>
                                        </div>
                                        </div>
                                    </div>
                                    </div>

                                {% if item_modulo == 1 or forloop.last %}
                                </div>
                                </div>
                                {% endif %}
                            {% endfor %}

                            </div>
                        </div>
                    </div>
                {% endunless %}

                {% unless entries.general_title.value == blank %}
                    {% assign count_item = count_item | plus: 1 %}
                    <div class="specification-item">
                        <div class="specification-item-inner-section">
                            <div class="specification-heading pp-bold pretitle text-center pb-lg-5 pb-md-5 pb-sm-4">
                                <span class="pretitle d-lg-block d-md-block d-sm-none">
                                    General
                                </span>
                                <span class="body-lg d-lg-none d-md-none d-sm-block">
                                    General
                                </span>
                            </div>
                            <div class="specification-data">
                            
                            {% assign titles = entries.general_title.value | newline_to_br | split: '<br />' %}
                            {% assign values = entries.general_value.value | newline_to_br | split: '<br />' %}

                            {% for title in titles %}
                                {% assign value = values[forloop.index0] %}
                                {% assign item_modulo = forloop.index0 | modulo: 2 %}
                                
                                {% if item_modulo == 0 %}
                                <div class="specification-data-item">
                                <div class="row specification-data-item-inner">
                                {% endif %}

                                    <div class="col-lg-6 col-md-6 col-sm-12">
                                    <div class="item-data">
                                        <div class="row">
                                        <div class="col-lg-4 col-md-4 col-sm-6">
                                            <div class="pp-semibold body-lg">
                                                <span class="body-lg d-lg-block d-md-block d-sm-none">
                                                    {{ title }}
                                                </span>
                                                <span class="body-sm d-lg-none d-md-none d-sm-block pp-bold">
                                                {{ title }}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-lg-8 col-md-8 col-sm-6">
                                            <div class="pp-regular body l-h-normal">
                                                <span class="body d-lg-block d-md-block d-sm-none">
                                                    {{ value }}
                                                </span>
                                                <span class="body-sm d-lg-none d-md-none d-sm-block">
                                                    {{ value }}
                                                </span>
                                            </div>
                                        </div>
                                        </div>
                                    </div>
                                    </div>

                                {% if item_modulo == 1 or forloop.last %}
                                </div>
                                </div>
                                {% endif %}
                            {% endfor %}

                            </div>
                        </div>
                    </div>
                {% endunless %}
                
                {% if count_item > 1 %}
                    <div class="text-center">
                        <p class="load-full-specs pp-regular text-underline">Load Full Specs ></p>
                    </div>
                {% endif %}

            {% endif %}

        {% endfor %}
        {% endpaginate %}



        </div>
        
    </div>
</div>
{% schema %}
{
    "class": "product-specification-section",
    "name": "Specification",
    "limit": 1,
    "templates": ["product"],
    "settings": [
        {
            "type": "checkbox",
            "id": "enabled_section_child_scroll",
            "label": "Enabled Section Child Scroll"
        },
        {
            "type": "text",
            "id": "section_scroll_nav",
            "label": "Section Scroll Nav",
            "info": "Need to Enabled first Section Scroll"
        },
        {
            "type": "text",
            "id": "nav_title",
            "label": "Navigation Title"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Specifications"
        } 
    ],
    "blocks": [
        {
            "type": "icon",
            "name": "Icon",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "icon",
                    "label": "Icon"
                },
                {
                    "type": "textarea",
                    "id": "heading",
                    "label": "Heading"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Specification"
        }
    ]
}
{% endschema %}
