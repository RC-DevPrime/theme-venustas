<div class="container section-content  
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}>

    <div class="specification-inner-section section-content">
        <h2 class="pp-bold title-sm text-center pb-lg-5 pb-md-5 pb-sm-4">
            {{ section.settings.heading }}
        </h2>

        <div class="specification-icon-list">
            <div class="specification-icon-inner-section mx-auto pb-lg-5 pb-md-5 pb-sm-4">
                <div class="row pb-lg-3 pb-md-3 pb-sm-2">
                    {% for block in section.blocks %}
                        <div class="col-lg-4 col-md-4 col-sm-6"> 
                            <div class="specification-icon-item gap-lg-4 gap-md-4 gap-sm-3">
                                <img
                                    src="{{ block.settings.icon | img_url: '100x100' | image_url: 'format:auto' }}"
                                    srcset="
                                        {{ block.settings.icon | img_url: '50x50' | image_url: 'format:auto' }} 50w,
                                        {{ block.settings.icon | img_url: '100x100' | image_url: 'format:auto' }} 100w,
                                        {{ block.settings.icon | img_url: '200x200' | image_url: 'format:auto' }} 200w"
                                    sizes="50px"
                                    width="100%"
                                    height="100%"
                                    class="specification-icon"
                                    alt="{{ block.settings.icon.alt | escape }}"
                                    loading="lazy"
                                    decoding="async"
                                />

                                <div class="pp-regular body l-h-normal">
                                    <span class="body d-lg-block d-md-block d-sm-none">
                                        {{ block.settings.heading | newline_to_br }}
                                    </span>
                                    <span class="body-sm d-lg-none d-md-none d-sm-block">
                                        {{ block.settings.heading | newline_to_br }}
                                    </span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="specification-metaobjects-list pt-lg-5 pt-md-5 pt-sm-4">
            
        {% assign technical_specifications = metaobjects.technical_specification.values %}
        {% paginate technical_specifications by 250 %}
        {% for entries in technical_specifications %}
            {% assign match_found = false %}
            {% assign count_item = 0 %}
            {% assign entry_product_ids = entries.product.value | map: 'id' %}

            {% if entry_product_ids contains product.id %}
                {% assign match_found = true %}
            {% endif %}

            {% if match_found %}
                
                {% unless entries.heating_element_title.value == blank %}
                    {% assign count_item = count_item | plus: 1 %}
                    <div class="specification-item">
                        <div class="specification-item-inner-section">
                            <div class="specification-heading pp-bold text-center pb-lg-5 pb-md-5 pb-sm-4">
                                <span class="pretitle d-lg-block d-md-block d-sm-none">
                                    Heating Element
                                </span>
                                <span class="body-lg d-lg-none d-md-none d-sm-block">
                                    Heating Element
                                </span>
                            </div>
                            <div class="specification-data">
                            
                            {% assign titles = entries.heating_element_title.value | newline_to_br | split: '<br />' %}
                            {% assign values = entries.heating_element_value.value | newline_to_br | split: '<br />' %}

                            {% for title in titles %}
                                {% assign value = values[forloop.index0] %}
                                {% assign item_modulo = forloop.index0 | modulo: 2 %}
                                
                                {% if item_modulo == 0 %}
                                <div class="specification-data-item">
                                <div class="row specification-data-item-inner">
                                {% endif %}

                                    <div class="col-lg-6 col-md-6 col-sm-12">
                                    <div class="item-data">
                                        <div class="row">
                                        <div class="col-lg-4 col-md-4 col-sm-6">
                                            <div class="pp-semibold body-lg">
                                                <span class="body-lg d-lg-block d-md-block d-sm-none">
                                                    {{ title }}
                                                </span>
                                                <span class="body-sm d-lg-none d-md-none d-sm-block pp-bold">
                                                {{ title }}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-lg-8 col-md-8 col-sm-6">
                                            <div class="pp-regular body l-h-normal">
                                                <span class="body d-lg-block d-md-block d-sm-none">
                                                    {{ value }}
                                                </span>
                                                <span class="body-sm d-lg-none d-md-none d-sm-block">
                                                    {{ value }}
                                                </span>
                                            </div>
                                        </div>
                                        </div>
                                    </div>
                                    </div>

                                {% if item_modulo == 1 or forloop.last %}
                                </div>
                                </div>
                                {% endif %}
                            {% endfor %}

        </div>
                        </div>
