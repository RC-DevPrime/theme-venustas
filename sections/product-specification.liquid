{% style %}
    .product-specification-section .specification-inner-section{
        background-color:#F9F9F9;
        border-radius:46px;
    }
    .product-specification-section .specification-icon-list {
        border-bottom:1px solid #DADADA;
    }
    .product-specification-section .specification-icon-list .specification-icon-item{
        display:flex;
        gap:30px;
        align-items:center;
        justify-content:center;
    }
    .product-specification-section .specification-icon-list .row .col-4:first-child .specification-icon-item{
        justify-content:flex-start;
    }
    .product-specification-section .specification-icon-list .row .col-4:last-child .specification-icon-item{
        justify-content:flex-end;
    }
    .product-specification-section .specification-icon{
        height:40px;
        width:fit-content;
        object-fit:contain;
    }

    .product-specification-section .specification-metaobjects-list {
        display:flex;
        flex-direction:column;
        gap:40px;
    }
    .product-specification-section .specification-metaobjects-list .specification-item{
        background: #F0F0F0;
        border-radius: 8px 8px 8px 8px;
        padding:40px 0px;
    }

    .product-specification-section .specification-icon-inner-section,
    .product-specification-section .specification-item-inner-section{
        padding-left:80px;
        padding-right:80px;
    }

    .product-specification-section .specification-data{
        display:flex;
        flex-direction:column;
        gap:50px;
    }
    .product-specification-section .specification-data .specification-data-item{
        padding-bottom:50px;
        border-bottom:1px solid #B5B5B5;
    }
    .product-specification-section .specification-data .specification-data-item .specification-data-item-inner{
        --bs-gutter-x: 10rem;
        --bs-gutter-y: 1rem;
    }
    .product-specification-section .specification-data .specification-data-item:last-child{
        border-bottom:none;
        padding-bottom:15px;
    }

    .product-specification-section .load-full-specs{
        cursor:pointer;
        width:fit-content;
        margin:auto;
    }
    .product-specification-section .load-full-specs:hover{
        color: #B93205;
    }

    
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .product-specification-section .specification-inner-section{
            border-radius:26px;
        }
        .product-specification-section .specification-icon{
            width:30px;
            height:30px;
        }
        .product-specification-section .specification-icon-inner-section .row{
            --bs-gutter-y: 1rem;
        }
        .product-specification-section .specification-metaobjects-list .specification-item{
            padding:20px 0px;
        }
        .product-specification-section .specification-metaobjects-list{
            gap:20px;
        }
        .product-specification-section .load-full-specs{
            background: #B93205;
            border-radius: 8px 8px 8px 8px;
            padding:10px 20px;
            color:#FFF !important;
        }
        .product-specification-section .specification-data .specification-data-item{
            padding-bottom:1rem;
        }
        .product-specification-section .specification-data{
            gap:16px;
        }
    }

