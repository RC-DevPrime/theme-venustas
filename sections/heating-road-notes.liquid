{% style %}
  #shopify-section-{{ section.id }} .heating-road-notes {
    width: 100%;
    overflow: hidden;
    background: #fff;
    color: var(--venustas-black, #14161a);
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .heating-road-notes__inner {
    width: min(100% - 40px, 1340px);
    margin: 0 auto;
    padding: 0 0 100px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 44px;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__title {
    margin: 0;
    color: var(--venustas-black, #14161a);
    font-size: 34px;
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.952px;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__description {
    margin: 0;
    color: #565b63;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.72;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__card {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__media {
    position: relative;
    width: 100%;
    height: 300px;
    overflow: hidden;
    border-radius: 12px;
    background: #f0f0f0;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__card--accent .heating-road-notes__media {
    background: #d9ff66;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__picture,
  #shopify-section-{{ section.id }} .heating-road-notes__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__image {
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
    color: #6d7278;
    font-size: 12px;
    line-height: 1.6;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__item-title {
    margin: 22px 0 0;
    color: var(--venustas-black, #14161a);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.68;
    letter-spacing: -0.4px;
  }

  #shopify-section-{{ section.id }} .heating-road-notes__item-text {
    max-width: 654px;
    margin: 6px 0 0;
    color: #565b63;
    font-size: 14.5px;
    font-weight: 400;
    line-height: 1.7;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heating-road-notes__inner {
      width: 100%;
      padding: 56px 20px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .heating-road-notes__header {
      gap: 12px;
      margin-bottom: 32px;
    }

    #shopify-section-{{ section.id }} .heating-road-notes__title {
      font-size: 24px;
      line-height: 1.3;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heating-road-notes__description {
      font-size: 14px;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .heating-road-notes__grid {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    #shopify-section-{{ section.id }} .heating-road-notes__card--accent {
      padding-top: 24px;
      border-top: 1px solid #e3e4e0;
    }

    #shopify-section-{{ section.id }} .heating-road-notes__media {
      height: 200px;
      border-radius: 12px;
    }

    #shopify-section-{{ section.id }} .heating-road-notes__placeholder {
      padding: 16px;
    }

    #shopify-section-{{ section.id }} .heating-road-notes__item-title {
      margin-top: 12px;
      font-size: 16px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .heating-road-notes__item-text {
      margin-top: 12px;
      font-size: 13px;
      line-height: 1.2;
    }
  }
{% endstyle %}

{%- liquid
  assign first_mobile_image = section.settings.first_mobile_image | default: section.settings.first_desktop_image
  assign second_mobile_image = section.settings.second_mobile_image | default: section.settings.second_desktop_image
-%}

<section class="heating-road-notes">
  <div class="heating-road-notes__inner">
    <div class="heating-road-notes__header">
      {%- if section.settings.title != blank -%}
        <h2 class="heating-road-notes__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="heating-road-notes__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="heating-road-notes__grid">
      <article class="heating-road-notes__card">
        <div class="heating-road-notes__media">
          {%- if section.settings.first_desktop_image != blank or first_mobile_image != blank -%}
            <picture class="heating-road-notes__picture">
              {%- if first_mobile_image != blank -%}
                <source
                  media="(max-width: 767px)"
                  srcset="{{ first_mobile_image | image_url: width: 350 }} 350w, {{ first_mobile_image | image_url: width: 700 }} 700w"
                  sizes="calc(100vw - 40px)"
                >
              {%- endif -%}
              {%- assign first_image = section.settings.first_desktop_image | default: first_mobile_image -%}
              {{
                first_image
                | image_url: width: 1400
                | image_tag:
                  class: 'heating-road-notes__image',
                  loading: 'lazy',
                  widths: '350, 700, 900, 1100, 1400',
                  sizes: '(max-width: 767px) calc(100vw - 40px), 654px',
                  alt: first_image.alt | default: 'The back pocket turns into a stuff sack'
              }}
            </picture>
          {%- else -%}
            <div class="heating-road-notes__placeholder">后背袋翻转成收纳包 · Reversible stuff sack pocket</div>
          {%- endif -%}
        </div>
        <h3 class="heating-road-notes__item-title">The back pocket turns into a stuff sack</h3>
        <p class="heating-road-notes__item-text">A reversible zipper on the rear pocket. Turn it inside out and the whole liner packs into it, so it goes in a tail bag when the day warms up.</p>
      </article>

      <article class="heating-road-notes__card heating-road-notes__card--accent">
        <div class="heating-road-notes__media">
          {%- if section.settings.second_desktop_image != blank or second_mobile_image != blank -%}
            <picture class="heating-road-notes__picture">
              {%- if second_mobile_image != blank -%}
                <source
                  media="(max-width: 767px)"
                  srcset="{{ second_mobile_image | image_url: width: 350 }} 350w, {{ second_mobile_image | image_url: width: 700 }} 700w"
                  sizes="calc(100vw - 40px)"
                >
              {%- endif -%}
              {%- assign second_image = section.settings.second_desktop_image | default: second_mobile_image -%}
              {{
                second_image
                | image_url: width: 1400
                | image_tag:
                  class: 'heating-road-notes__image',
                  loading: 'lazy',
                  widths: '350, 700, 900, 1100, 1400',
                  sizes: '(max-width: 767px) calc(100vw - 40px), 654px',
                  alt: second_image.alt | default: "A pocket for the cable you're always chasing"
              }}
            </picture>
          {%- else -%}
            <div class="heating-road-notes__placeholder">脚口拉链与内侧收线袋 · Ankle cable stash pocket</div>
          {%- endif -%}
        </div>
        <h3 class="heating-road-notes__item-title">A pocket for the cable you're always chasing</h3>
        <p class="heating-road-notes__item-text">A hook-and-loop pocket inside each ankle, sized for the lead running down to heated socks or insoles. Nothing swinging, nothing snagging on the peg.</p>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Heating Road Notes",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "ProductH title",
      "default": "Two things you'll notice on the road"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "ProductH description",
      "default": "<p>Neither is why you'd buy a heated liner. Both are why you'd keep this one.</p>"
    },
    {
      "type": "header",
      "content": "ProductH stuff sack media"
    },
    {
      "type": "image_picker",
      "id": "first_desktop_image",
      "label": "ProductH desktop image or GIF"
    },
    {
      "type": "image_picker",
      "id": "first_mobile_image",
      "label": "ProductH mobile image or GIF"
    },
    {
      "type": "header",
      "content": "ProductH cable pocket media"
    },
    {
      "type": "image_picker",
      "id": "second_desktop_image",
      "label": "ProductH desktop image or GIF"
    },
    {
      "type": "image_picker",
      "id": "second_mobile_image",
      "label": "ProductH mobile image or GIF"
    }
  ],
  "presets": [
    {
      "name": "Heating Road Notes"
    }
  ]
}
{% endschema %}
