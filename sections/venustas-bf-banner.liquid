<section class="vbf" id="vbf-{{ section.id }}" style="--red:{{ section.settings.bg_color }};--red-dark:{{ section.settings.dark_color }};--amber:{{ section.settings.accent_color }};" aria-label="{{ section.settings.tag | escape }}">
  <div class="vbf__in">
    <div class="vbf__text">
      {%- if section.settings.tag != blank -%}<p class="vbf__tag">{{ section.settings.tag }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="vbf__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.sub_highlight != blank -%}
        <p class="vbf__sub">{{ section.settings.sub_before }} <b>{{ section.settings.sub_highlight }}</b> {{ section.settings.sub_after }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="vbf__ladder">
        {%- for block in section.blocks -%}
          <div class="vbf__tier vbf__tier--{{ forloop.index }}" {{ block.shopify_attributes }}>
            {%- if block.settings.badge != blank -%}<span class="vbf__best">{{ block.settings.badge }}</span>{%- endif -%}
            <div class="vbf__amt">{{ block.settings.amount }}<small>{{ block.settings.suffix }}</small></div>
            <div class="vbf__min">{{ block.settings.minimum }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_timer and section.settings.countdown_end != blank -%}
      <div class="vbf__timer" data-vbf-timer data-end="{{ section.settings.countdown_end | escape }}">
        <span class="vbf__tlabel">{{ section.settings.timer_label }}</span>
        <div class="vbf__boxes">
          <div class="vbf__box"><strong data-vbf-d>00</strong><span>days</span></div>
          <div class="vbf__box"><strong data-vbf-h>00</strong><span>hrs</span></div>
          <div class="vbf__box"><strong data-vbf-m>00</strong><span>min</span></div>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="vbf__bar">
    <div class="vbf__bar-in">
      <span>{{ section.settings.bar_left }}</span>
      <span>{{ section.settings.bar_right }}</span>
    </div>
  </div>
</section>

<style>
#vbf-{{ section.id }}{background:var(--red);color:#fff;box-sizing:border-box;width:100%}
#vbf-{{ section.id }} *{box-sizing:border-box}
#vbf-{{ section.id }} .vbf__in{max-width:1800px;margin:0 auto;padding:clamp(16px,1.8vw,24px) clamp(16px,3vw,44px) 0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.45fr) auto;gap:clamp(16px,2.4vw,40px);align-items:end}
#vbf-{{ section.id }} .vbf__text{align-self:center;padding-bottom:clamp(14px,1.6vw,22px)}
#vbf-{{ section.id }} .vbf__tag{font-size:clamp(13px,1.05vw,16px);font-weight:600;letter-spacing:.08em;color:#F7C1C1;margin:0 0 4px}
#vbf-{{ section.id }} .vbf__title{font-size:clamp(26px,2.9vw,42px);font-weight:700;line-height:1.08;margin:0;color:#fff}
#vbf-{{ section.id }} .vbf__sub{font-size:clamp(16px,1.5vw,22px);font-weight:600;margin:8px 0 0;color:#fff}
#vbf-{{ section.id }} .vbf__sub b{color:var(--amber);font-weight:700}
#vbf-{{ section.id }} .vbf__ladder{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:end}
#vbf-{{ section.id }} .vbf__tier{position:relative;text-align:center;padding:10px 6px 12px;display:flex;flex-direction:column;justify-content:flex-end}
#vbf-{{ section.id }} .vbf__tier--1{background:#FCEBEB;color:#791F1F;min-height:clamp(86px,7.6vw,108px);border-radius:10px 0 0 0}
#vbf-{{ section.id }} .vbf__tier--2{background:#F7C1C1;color:#791F1F;min-height:clamp(100px,9vw,128px)}
#vbf-{{ section.id }} .vbf__tier--3{background:#fff;color:var(--red);min-height:clamp(114px,10.4vw,148px);border-radius:0 10px 0 0}
#vbf-{{ section.id }} .vbf__amt{font-size:clamp(24px,2.9vw,42px);font-weight:700;line-height:1;white-space:nowrap}
#vbf-{{ section.id }} .vbf__amt small{font-size:.58em;font-weight:700;margin-left:.15em}
#vbf-{{ section.id }} .vbf__min{font-size:clamp(13px,1.15vw,17px);font-weight:600;margin-top:5px}
#vbf-{{ section.id }} .vbf__best{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--amber);color:#412402;font-size:clamp(12px,.95vw,14px);font-weight:700;padding:3px 10px;border-radius:5px;white-space:nowrap}
#vbf-{{ section.id }} .vbf__timer{align-self:center;padding-bottom:clamp(14px,1.6vw,22px);text-align:center}
#vbf-{{ section.id }} .vbf__tlabel{display:block;font-size:clamp(13px,1.05vw,16px);font-weight:600;color:#F7C1C1;margin-bottom:6px}
#vbf-{{ section.id }} .vbf__boxes{display:flex;gap:6px}
#vbf-{{ section.id }} .vbf__box{background:var(--red-dark);border-radius:8px;padding:6px 10px;min-width:clamp(52px,4.6vw,66px);text-align:center;color:#fff;line-height:1.1}
#vbf-{{ section.id }} .vbf__box strong{display:block;font-size:clamp(22px,2.1vw,30px);font-weight:700;font-variant-numeric:tabular-nums}
#vbf-{{ section.id }} .vbf__box span{font-size:11px;font-weight:500;color:#F7C1C1}
#vbf-{{ section.id }} .vbf__bar{background:var(--red-dark)}
#vbf-{{ section.id }} .vbf__bar-in{max-width:1800px;margin:0 auto;padding:clamp(9px,.9vw,12px) clamp(16px,3vw,44px);display:flex;justify-content:space-between;gap:6px 24px;flex-wrap:wrap;font-size:clamp(14px,1.2vw,17px);font-weight:600}
#vbf-{{ section.id }} .vbf__bar-in span:last-child{color:#F7C1C1}
@media (max-width:900px){
  #vbf-{{ section.id }} .vbf__in{grid-template-columns:1fr;gap:14px;padding-top:16px}
  #vbf-{{ section.id }} .vbf__text{padding-bottom:0}
  #vbf-{{ section.id }} .vbf__title{font-size:clamp(26px,7vw,34px)}
  #vbf-{{ section.id }} .vbf__tier{padding:10px 4px 12px}
  #vbf-{{ section.id }} .vbf__tier--1{min-height:80px}
  #vbf-{{ section.id }} .vbf__tier--2{min-height:94px}
  #vbf-{{ section.id }} .vbf__tier--3{min-height:108px}
  #vbf-{{ section.id }} .vbf__amt{font-size:clamp(22px,7vw,32px)}
  #vbf-{{ section.id }} .vbf__min{font-size:13px}
  #vbf-{{ section.id }} .vbf__timer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-bottom:14px;order:2}
  #vbf-{{ section.id }} .vbf__tlabel{margin:0}
  #vbf-{{ section.id }} .vbf__ladder{order:1}
  #vbf-{{ section.id }} .vbf__bar-in{flex-direction:column;font-size:14px}
}
</style>

<script>
(function(){
  var root=document.getElementById('vbf-{{ section.id }}');
  if(!root)return;
  var t=root.querySelector('[data-vbf-timer]');
  if(!t)return;
  var end=new Date(t.getAttribute('data-end')).getTime();
  function p(n){return n<10?'0'+n:''+n}
  function tick(){
    var s=Math.floor((end-Date.now())/1000);
    if(isNaN(s)||s<=0){t.style.display='none';return}
    t.querySelector('[data-vbf-d]').textContent=p(Math.floor(s/86400));
    t.querySelector('[data-vbf-h]').textContent=p(Math.floor(s%86400/3600));
    t.querySelector('[data-vbf-m]').textContent=p(Math.floor(s%3600/60));
  }
  tick();
  setInterval(tick,30000);
})();
</script>

{% schema %}
{
  "name": "BF offer banner",
  "tag": "div",
  "class": "vbf-section",
  "limit": 1,
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "tag", "label": "Top label", "default": "BLACK FRIDAY EARLY ACCESS" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Spend more. Save more." },
    { "type": "text", "id": "sub_before", "label": "Subheading, before highlight", "default": "Up to" },
    { "type": "text", "id": "sub_highlight", "label": "Subheading highlight", "default": "40% OFF" },
    { "type": "text", "id": "sub_after", "label": "Subheading, after highlight", "default": "select heated apparel" },
    { "type": "text", "id": "bar_left", "label": "Bottom bar, left", "default": "Up to 40% OFF + extra savings on your order" },
    { "type": "text", "id": "bar_right", "label": "Bottom bar, right", "default": "Auto-applied at checkout" },

    { "type": "header", "content": "Countdown" },
    { "type": "checkbox", "id": "show_timer", "label": "Show countdown", "default": true },
    { "type": "text", "id": "timer_label", "label": "Countdown label", "default": "Ends in" },
    { "type": "text", "id": "countdown_end", "label": "End time", "info": "Format: 2026-11-30T23:59:59-05:00 (include your time zone offset)", "default": "2026-11-30T23:59:59-05:00" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#A32D2D" },
    { "type": "color", "id": "dark_color", "label": "Dark accent (boxes, bottom bar)", "default": "#501313" },
    { "type": "color", "id": "accent_color", "label": "Highlight (40% OFF, badge)", "default": "#EF9F27" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Offer tier",
      "settings": [
        { "type": "text", "id": "amount", "label": "Amount", "default": "$20" },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "OFF" },
        { "type": "text", "id": "minimum", "label": "Minimum order", "default": "orders $100+" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "info": "For example: Best value" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BF offer banner",
      "blocks": [
        { "type": "tier", "settings": { "amount": "$20", "suffix": "OFF", "minimum": "orders $100+" } },
        { "type": "tier", "settings": { "amount": "$50", "suffix": "OFF", "minimum": "orders $200+" } },
        { "type": "tier", "settings": { "amount": "$100", "suffix": "OFF", "minimum": "orders $400+", "badge": "Best value" } }
      ]
    }
  ]
}
{% endschema %}
