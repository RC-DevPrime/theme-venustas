{% style %}
    .product-whats-included-section .included-list .row{
        --bs-gutter-x: 40px;
        --bs-gutter-y: 50px;
    }
    .product-whats-included-section .included-list .included-item .icon-box{
        background: #F9F9F9;
        border-radius: 4px 4px 4px 4px;
        display:flex;
        align-items:center;
        justify-content:center;
        padding:50px;
    }
    .product-whats-included-section .included-list .included-item .include-icon{
        height:95px;
        width:100%;
        object-fit:contain;
    }

    .product-whats-included-section .included-list-slider .included-item .icon-box{
        background: #F9F9F9;
        border-radius: 4px 4px 4px 4px;
        display:flex;
        align-items:center;
        justify-content:center;
        padding:40px 30px;
    }

    .product-whats-included-section .included-list-slider .included-item .include-icon{
        height:50px;
        width:100%;
        object-fit:contain;
    }


