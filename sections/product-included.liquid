<div class="container section-content  
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}>

    <h2 class="pp-bold title-sm text-center pb-lg-5 pb-md-5 pb-sm-3">
        {{ section.settings.heading }}
    </h2>

    <div class="included-list d-lg-block d-md-block d-sm-none">
        <div class="row {% if section.blocks.size <= 3 %}justify-content-center {% endif %}">
            {% for block in section.blocks %}
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <div class="included-item">
                        <div class="icon-box">
                            <img
                                src="{{ block.settings.icon | img_url: '100x100' | image_url: 'format:auto' }}"
                                srcset="
                                    {{ block.settings.icon | img_url: '50x50' | image_url: 'format:auto' }} 50w,
                                    {{ block.settings.icon | img_url: '100x100' | image_url: 'format:auto' }} 100w,
                                    {{ block.settings.icon | img_url: '200x200' | image_url: 'format:auto' }} 200w"
                                sizes="50px"
                                width="100%"
                                height="100%"
                                class="include-icon"
                                alt="{{ block.settings.icon.alt | escape }}"
                                loading="lazy"
                                decoding="async"
                            />

                        </div>
                        <p class="pp-regular body-lg text-center pt-lg-3 pt-md-3 pt-sm-2">
                            {{ block.settings.heading }}
                        </p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="included-list-slider d-lg-none d-md-none d-sm-block position-relative overflow-hidden">
        <div class="swiper-wrapper">
            {% for block in section.blocks %}
                <div class="swiper-slide">
                    <div class="included-item">
                        <div class="icon-box">
                            <img
                                src="{{ block.settings.icon | img_url: '100x100' | image_url: 'format:auto' }}"
                                srcset="
                                    {{ block.settings.icon | img_url: '50x50' | image_url: 'format:auto' }} 50w,
                                    {{ block.settings.icon | img_url: '100x100' | image_url: 'format:auto' }} 100w,
                                    {{ block.settings.icon | img_url: '200x200' | image_url: 'format:auto' }} 200w"
                                sizes="50px"
                                width="100%"
                                height="100%"
                                class="include-icon"
                                alt="{{ block.settings.icon.alt | escape }}"
                                loading="lazy"
                                decoding="async"
                            />

                        </div>
                        <p class="pp-regular body text-center pt-lg-3 pt-md-3 pt-sm-2">
                            {{ block.settings.heading }}
                        </p>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination"></div>
    </div>


</div>
{% schema %}
{
    "class": "product-whats-included-section",
    "name": "What’s Included?",
    "limit": 1,
    "templates": ["product"],
    "settings": [
        {
            "type": "checkbox",
            "id": "enabled_section_child_scroll",
            "label": "Enabled Section Child Scroll"
        },
        {
            "type": "text",
            "id": "section_scroll_nav",
            "label": "Section Scroll Nav",
            "info": "Need to Enabled first Section Scroll"
        },
        {
            "type": "text",
            "id": "nav_title",
            "label": "Navigation Title"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "What’s Included?"
        } 
    ],
    "blocks": [
        {
            "type": "icon",
            "name": "Icon",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "icon",
                    "label": "Icon"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "What’s Included?"
        }
    ]
}
{% endschema %}