    #shopify-section-{{ section.id }} .product-nav-new.is-open .product-nav-new__panel { display: flex; flex-direction: column; position: fixed; top: auto; right: 0; bottom: 0; left: 0; width: auto; height: auto; max-height: 90vh; max-height: 90dvh; margin: 0; padding: 16px 0 0; overflow: hidden; border: 0; border-radius: 12px 12px 0 0; transform: none; z-index: 1111; }
