  #shopify-section-{{ section.id }} .product-nav-new__panel-title { display: -webkit-box; margin: 0; overflow: hidden; color: #1a1a1a; font-size: 18px; font-weight: 600; line-height: normal; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  #shopify-section-{{ section.id }} .product-nav-new__panel-price { display: flex; align-items: center; gap: 6px; margin: 0; line-height: normal; }
