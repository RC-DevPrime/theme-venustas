{% style %}
    .scroll-marquee{
        height: 300vh;
    }

    .scroll-marquee__sticky{
        position: sticky;
        top: var(--headerHeight);
        height: 100vh;
        overflow: hidden;
        display: flex;
        align-items: center;
    }

    .scroll-marquee__track{
        width: 100%;
        overflow: hidden;
    }

    .scroll-marquee__text{
        margin: 0;
        white-space: nowrap;
        width: max-content;
        will-change: transform;

        /* FIXED SIZE (change as you want) */
        font-size: 180px;
        font-weight: 600;
        letter-spacing: 0.02em;

        transform: translate3d(0,0,0);
        position:relative;
        z-index:2;
        padding-right:50px;
    }
    .bg-container{
        position: absolute;
        width: 100%;
        height: 100%;
        left: 0;
        display: flex;
        align-items: flex-end;
        overflow:hidden;
    }
    .bg-container img.bg-image{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .bg-container img.image-element{
        width:100%;
        height:100%;
        position:absolute;
        left:0;
        z-index:2;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .scroll-marquee__sticky{
            align-items: flex-start;
        }
        .scroll-marquee__track{
            padding-top:20px;
        }
        .bg-container img.image-element{
            width:180vw;
            height:fit-content;
        }
        .scroll-marquee{
            height:fit-content;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){

    }


    /* MOBILES ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 0px) {
        .scroll-marquee__sticky{
            height: 50vh;
        }
        .scroll-marquee__text{
            font-size: 80px;
        }
    }
    @media only screen and (min-width: 375px) {
        .scroll-marquee__sticky{
            height: 50vh;
        }
        .scroll-marquee__text{
