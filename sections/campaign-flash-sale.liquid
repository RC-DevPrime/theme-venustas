{% style %}
    .campaign-flash-sale-section{
        background: linear-gradient( 182deg, #2E2A29 0%, #1E1E1E 100%);
    }
    .campaign-flash-sale-section .section-heading{
    }
    .campaign-flash-sale-section .heading-element{
        height:40px;
        width:fit-content;
        object-fit:contain;
    }
    
    .campaign-flash-sale-section .inner-section{
        background-image:url({{ section.settings.background_image | img_url: 'master' }});
        background-size:cover;
        background-position:center;
        padding:40px;
        border-radius: 12px 12px 12px 12px;
    }
    
    .campaign-flash-sale-section .inner-section .row.flash-row{
        --bs-gutter-x: 60px;
    }
    .campaign-flash-sale-section .left-content-container .image-container{
        width:100%;
        height:100%;
    }
    .campaign-flash-sale-section .left-content-container .image-container img{
        width:100%;
        height:100%;
        object-fit:contain;
    }
    .campaign-flash-sale-section .newsletter__message.newsletter__message--success{
      color:#000;
    }


    /* Countdown container */
    .campaign-flash-sale-section .countdown {
        display: flex;
        gap: 2rem;
        text-align: center;
        align-items: center;
    }

    /* Time box */
    .campaign-flash-sale-section .time-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: #FFF;
        padding: 15px 7px 7px;
        width: 85px;
        border-radius: 4px 4px 4px 4px;
        position:relative;
    }
    .campaign-flash-sale-section .time-box:after{
    content:":";    
    position: absolute;
    right: -20%;
    top: 30%;
    color: #000;
    font-weight:500;

    }
    .campaign-flash-sale-section .time-box:last-child:after{
    display:none;
    }
        
    /* Number layout */
    .campaign-flash-sale-section .number {
    --size: 34px;
    display: inline-flex;
    align-items: center;
    gap: 0.15em;
    font-size: var(--size);
    font-weight: 700;
    line-height: 1;
    height: 1em;
    overflow: hidden;
    font-variant-numeric: tabular-nums;
    }

    /* Digit wrapper */
    .campaign-flash-sale-section .digit {
    position: relative;
    width: 1ch;
    height: 1em;
    overflow: hidden;
    }

    /* Each moving digit */
    .campaign-flash-sale-section .digit span {
        position: absolute;
        color: #B93205;
        left: 0;
        right: 0;
        text-align: center;
        transform: translateY(0);
        opacity: 1;
        transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
        will-change: transform, opacity;
        backface-visibility: hidden;
        font-weight: 700 !important;
    }

    /* old number goes up */
    .campaign-flash-sale-section .digit span.to-up {
    transform: translateY(-100%);
    opacity: 0;
    }

    /* new number starts below and rises */
    .campaign-flash-sale-section .digit span.below {
    transform: translateY(100%);
    opacity: 0;
    }
    .campaign-flash-sale-section .digit span.below.rise {
    transform: translateY(0);
    opacity: 1;
    }

    /* Label */
    .campaign-flash-sale-section .label {
    font-size: 16px;
    margin-top: 10px;
    line-height:normal;
    }

    @media (prefers-reduced-motion: reduce) {
    .campaign-flash-sale-section .digit span {
        transition: none;
    }
    }

    .campaign-flash-sale-section .fill-heading{
        background: #B93205;
        padding:6px 30px;
        width:fit-content;
        border-radius:10px;
        position:relative;
    }
    .campaign-flash-sale-section .fill-heading .element-img{
        position: absolute;
        width: 60px;
        right: -11%;
        bottom: -40%;
    }
    .campaign-flash-sale-section .fill-heading span{
        font-size:94px;
        line-height: 105px;
    }
    .campaign-flash-sale-section .outline-heading{
        width:fit-content;
        transform: rotate(353deg) translateY(20%) translateX(2%);
        position: relative;
        z-index: 1;
    }
    .campaign-flash-sale-section .outline-heading span{
        font-size:100px;
        color: #000000;
        -webkit-text-stroke: 1px #ffffff;
    }
    .campaign-flash-sale-section .form-subscription-container .form-container-newsletter{
        display:flex;
        flex-direction:column;
        gap:10px;
        width:80%;
        margin-top:30px;
    }
    .campaign-flash-sale-section .form-subscription-container input{
        flex:1;
        background: #FFF;
        border:none;
        border-radius: 12px 12px 12px 12px;
        padding:15px 15px;
    }
    .campaign-flash-sale-section .form-subscription-container button{
        border:none;
        padding:10px 35px;
        background: #B93205;
        border-radius: 12px 12px 12px 12px;
        transition: all .5s ease;
    }
    .campaign-flash-sale-section .form-subscription-container button:hover{
        background: #161616;
    }

    .campaign-flash-sale-section .limited-time-offer-slider .float-nav button{
        --btn-pos:-65px;
        background: #F2E0BD;
        width:45px;
        height:45px;
    }
    .campaign-flash-sale-section .limited-time-offer-slider .float-nav button:hover{
        background: #B93205;
    }
    .campaign-flash-sale-section .limited-time-offer-slider .float-nav button:hover i{
      color:#FFF;
    }
    .campaign-flash-sale-section .limited-time-offer-slider .swiper-slide{
        height:auto;
    }
    .campaign-flash-sale-section .limited-time-offer-slider .swiper-slide .product-item{
        background-color:#FFF;
        padding:10px;
    }
    .campaign-flash-sale-section .limited-time-offer-slider .float-nav button i{
        font-size:16px;
    }

    
    .campaign-flash-sale-section  .section-heading{
        margin-left:-30px;
    }
    .campaign-flash-sale-section .section-heading span{
        position:relative;
    }
    .campaign-flash-sale-section .section-heading:before{
        content:"";
        display:inline-block;
        height:35px;
        width:35px;
        top:0;
        position:relative;
        background-image:url({{ section.settings.heading_element | img_url: 'master' }});
        background-size:contain;
        background-repeat:no-repeat;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .campaign-flash-sale-section  .section-heading{
            margin-left:-25px;
        }
        .campaign-flash-sale-section .section-heading:before{
            height:30px;
            width:30px;
        }
        .campaign-flash-sale-section .form-subscription-container{
            width:92%;
        }
        .campaign-flash-sale-section .inner-section{
            padding:30px 10px;
        }
        .campaign-flash-sale-section .inner-section .row.flash-row{
            --bs-gutter-x: 0px;
        }
        .campaign-flash-sale-section .countdown{
            justift-content:center;
        }
    }

