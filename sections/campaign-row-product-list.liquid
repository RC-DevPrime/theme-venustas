{% style %}
    .campaign-row-product-list-section{
        background-color:#000;
    }
    .campaign-row-product-list-section .section-heading{
    }
    .campaign-row-product-list-section .heading-element{
        height:40px;
        width:fit-content;
        object-fit:contain;
    }

    .campaign-row-product-list-section .row-product-list-container .row-product-list-row{
        --bs-gutter-y: 50px;
    }
    .campaign-row-product-list-section .row-product-list-container .row-product-item{
        background: #FFFFFF;
        border-radius: 20px 20px 20px 20px;
        overflow: hidden;
    }
    .campaign-row-product-list-section .row-product-list-container .row-product-item .wishlist-button{
        position:absolute;
        top:0px;
        right:0px;
    }
    .campaign-row-product-list-section .row-product-list-container .row-product-item .featured-image img{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .campaign-row-product-list-section .row-product-list-container .row-product-item .row{
        --bs-gutter-x: 1rem;
    }

    .shop-pay-container{
        display:flex;
        align-items: center;
        gap:10px;
    }
    .shop-pay-container .shop-pay-icon{
        height:25px;
        object-fit:contain;
    }

    .buy-now-and-add{
        display:flex;
        height:55px;
    }
    .campaign-row-product-list-section .buy-now-and-add .btn-buy-now{
        background: #B93205;
        border-radius: 16px 0px 0px 16px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .campaign-row-product-list-section .buy-now-and-add .btn-add{
        background: #B93205;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap:10px;
        width:100%;
        transition: all .5s ease;
    }
    .campaign-row-product-list-section .buy-now-and-add .btn-add:hover{
        background:#161616;
    }
    .campaign-row-product-list-section .buy-now-and-add .btn-add button{
        background:unset !important;
        border: none;
        width: 100%;
        align-items: center;
        justify-content: center;
    }
    .campaign-row-product-list-section .buy-now-and-add .btn-add img{
        width:25px;
        height:25px;
        object-fit:contain;
    }
    .campaign-row-product-list-section .learn-more-button{
        border: 1px solid #B93205;
        border-radius: 16px 16px 16px 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap:10px;
    }
    .campaign-row-product-list-section .learn-more-button:hover{
        background-color:#B93205;
    }
    .campaign-row-product-list-section .learn-more-button:hover span{
        color:#FFF;
    }

    .campaign-row-product-list-section  .section-heading{
        margin-left:-30px;
    }
    .campaign-row-product-list-section .section-heading span{
        position:relative;
    }
    .campaign-row-product-list-section .section-heading:before{
        content:"";
        display:inline-block;
        height:35px;
        width:35px;
        top:5px;
        position:relative;
        background-image:url({{ section.settings.heading_element | img_url: 'master' }});
        background-size:contain;
        background-repeat:no-repeat;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .campaign-row-product-list-section  .section-heading{
            margin-left:-25px;
        }
        .campaign-row-product-list-section .section-heading:before{
            height:30px;
            width:30px;
        }

        .campaign-row-product-list-section .row-product-list-container .row-product-list-row{
            --bs-gutter-x: 10px;
        }
        .campaign-row-product-list-section .row-product-list-container .row-product-item{
            border-radius:6px;
            height:100%;
        }
        .campaign-row-product-list-section .row-product-item .product-details{
            padding:10px 10px 15px;
        }
        .campaign-row-product-list-section .row-product-item .featured-image{
            height:120px;
        }

        .campaign-row-product-list-section .row-product-list-container .row{
            --bs-gutter-x: 10px;
        }
        .campaign-row-product-list-section .row-product-list-container .row-product-item .row{
            --bs-gutter-x: 0px;
        }
        .campaign-row-product-list-section .wishlist-button svg{
            width:18px;
            height: 18px;
        }
        .campaign-row-product-list-section .shop-pay-container{
            display: inline;
        }
        .campaign-row-product-list-section .shop-pay-container .shop-pay-icon{
            height:12px;
            margin-top: -2px;
            margin-left: 3px;
        }
        .campaign-row-product-list-section .shop-pay-container p{
            font-size:10px;
        }
        .campaign-row-product-list-section .buy-now-and-add{
            height:30px;
        }
        .campaign-row-product-list-section .buy-now-and-add span,
        .campaign-row-product-list-section .learn-more-button span{
            font-size:10px;
        }
        .campaign-row-product-list-section .buy-now-and-add .btn-add img{
            width:12px;
        }
        .campaign-row-product-list-section .buy-now-and-add .btn-buy-now{
            border-radius:6px;
        }
        .campaign-row-product-list-section .buy-now-and-add .btn-add{
            border-radius:6px;
            gap:6px;
        }

        .campaign-row-product-list-section .learn-more-button{
            border-radius:6px;
            height:30px;
        }

    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content 
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}> 
    
    <div class="pb-lg-5 pb-md-5 pb-sm-4">
        <h2 class="section-heading pp-semibold f-white title-sm text-center">
            {{ section.settings.heading }}
        </h2>
    </div>

    <div class="row-product-list-container">
        <div class="row row-product-list-row">
            {% for block in section.blocks %}
                {% assign is_odd = forloop.index0 | modulo: 2 %}
                {% render 'row-product-item', block: block, is_odd: is_odd %}
            {% endfor %}
        </div>
    </div>

</div>
{% schema %}
    {
        "class": "campaign-row-product-list-section",
        "name": "Campaign Row Product List",
        "templates": ["page"],
        "limit": 1, 
        "settings": [
            {
                "type": "checkbox",
                "id": "enabled_section_child_scroll",
                "label": "Enabled Section Child Scroll"
            },
            {
                "type": "text",
                "id": "section_scroll_nav",
                "label": "Section Scroll Nav",
                "info": "Need to Enabled first Section Scroll"
            },
            {
                "type": "text",
                "id": "nav_title",
                "label": "Navigation Title"
            },
            {
                "type": "image_picker",
                "id": "heading_element",
                "label": "Heading Element"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Add-Ons & Accessories"
            }
        ],
        "blocks": [
            {
                "type": "product",
                "name": "Product",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "featured_image",
                        "label": "Featured Image"
                    },
                    {
                        "type": "product",
                        "id": "product",
                        "label": "Product"
                    }
                ]
            }
        ],
        "presets" :[{
            "name" : "Campaign Row Product List"
        }]
    }
  {% endschema %} 