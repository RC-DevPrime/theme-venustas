{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .container {
    padding-left: 40px;
    padding-right: 40px;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .container {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
  #shopify-section-{{ section.id }} .for-her-ugc {
    padding: 80px 0;
  }
  #shopify-section-{{ section.id }} .for-her-ugc__heading {
    font-size: clamp(22px, 2.6vw, 40px);
    font-weight: 800;
    color: {{ section.settings.accent_color }};
    text-align: center;
    margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .for-her-ugc__subheading {
    text-align: center;
    color: #888;
    font-size: 14px;
    margin-bottom: 40px;
  }
  #shopify-section-{{ section.id }} .for-her-ugc__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .for-her-ugc__item {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 14px;
    position: relative;
    background: #f0f0f0;
  }
  #shopify-section-{{ section.id }} .for-her-ugc__item img,
  #shopify-section-{{ section.id }} .for-her-ugc__item svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  #shopify-section-{{ section.id }} .for-her-ugc__item:hover img {
    transform: scale(1.06);
  }
  #shopify-section-{{ section.id }} .for-her-ugc__item-link {
    position: absolute;
    inset: 0;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .for-her-ugc {
      padding: 50px 0;
    }
    #shopify-section-{{ section.id }} .for-her-ugc__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
{% endstyle %}

<div class="for-her-ugc">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="for-her-ugc__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="for-her-ugc__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="for-her-ugc__grid">
      {% for block in section.blocks %}
        <div class="for-her-ugc__item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | img_url: 'master' }}" alt="Community photo" loading="lazy">
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="for-her-ugc__item-link" aria-label="View post"></a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "For Her - UGC Photo Grid",
  "class": "for-her-ugc-grid-section",
  "templates": ["page"],
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Heading Color",
      "default": "#B93205"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Share your shine moments with us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tag #VenustasSquad for a chance to be featured and win something special."
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [{
    "name": "For Her - UGC Photo Grid",
    "blocks": [
      { "type": "photo" },
      { "type": "photo" },
      { "type": "photo" },
      { "type": "photo" },
      { "type": "photo" },
      { "type": "photo" },
      { "type": "photo" },
      { "type": "photo" }
    ]
  }]
}
{% endschema %}