{% style %}
    .product-video-with-icon-list-section{
        background-color: #1C1C1C;
    }
    .product-video-with-icon-list-section .row{
        --bs-gutter-x: 1rem;
    }
    .product-video-with-icon-list-section .video-container{
        height:100%;
        width:100%;
    }
    .product-video-with-icon-list-section .video-container video{
        height:100%;
        width:100%;
        object-fit:cover;
    }
    .product-video-with-icon-list-section .icon-list-container{
        /* display:flex;
        flex-direction:column; */
        height: 100%;
        /* gap:1rem; */
        --bs-gutter-x: 0.5rem;
        --bs-gutter-y: 0.5rem;
    }
    .icon-list-item{
        background-color: #2C2C2C;
        border-radius: 4px 4px 4px 4px;
        flex:1;
        display: flex;
        align-items: center;
        padding: 1rem 2rem;
        height:100%;
    }
    .icon-list-item img{
        height:66px;
        width:fit-content;
        object-fit:contain;
        margin-right:1.5rem;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .icon-list-item{
            padding: 1rem 10px;
        }
        .icon-list-item img{
            height:40px;
            margin-right:10px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content  
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}>

    <h2 class="pp-bold title-sm f-white text-center pb-lg-5 pb-md-5 pb-sm-4">
        {{ section.settings.heading }}
    </h2>
    <div class="row">
        <div class="col-lg-9 col-md-9 col-sm-12">
            <div class="video-container">
                {% assign poster_1600 = section.settings.video.preview_image | image_url: width: 1600 %}
                {% assign poster_800  = section.settings.video.preview_image | image_url: width: 800 %}
                {% assign poster_400  = section.settings.video.preview_image | image_url: width: 400 %}
                {% assign alt_text = section.settings.video.alt | default: section.settings.video.title %}
                {% assign mp4_source = section.settings.video.sources | where: 'format', 'mp4' | last %}

                <video
                    playsinline
                    autoplay
                    loop
                    muted
                    preload="metadata"
                    poster="{{ poster_1600 }}"
                    data-handle="{{ section.settings.video.id }}"
                    style="width: 100%; height: 100%; object-fit: cover;"
                    >
                    {% if mp4_source %}
                        <source src="{{ mp4_source.url | prepend: 'https:' }}" type="video/mp4">
                    {% endif %}

                    <img
                        src="{{ poster_800 }}"
                        srcset="
                        {{ poster_400 }} 400w,
                        {{ poster_800 }} 800w,
                        {{ poster_1600 }} 1600w
                        "
                        sizes="100vw"
                        alt="{{ alt_text }}"
                        loading="lazy"
                        decoding="async"
                    >
                </video>


            </div>
        </div>
        <div class="col-lg-3 col-md-3 col-sm-12">
            <div class="icon-list-container row mt-lg-0 mt-md-0 mt-sm-1">
                {% for block in section.blocks %}
                    <div class="col-lg-12 col-md-12 col-sm-6">
                        <div class="icon-list-item">
                            <img
                                src="{{ block.settings.icon | img_url: '100x100' | image_url: 'format:auto' }}"
                                srcset="
                                    {{ block.settings.icon | img_url: '50x50' | image_url: 'format:auto' }} 50w,
                                    {{ block.settings.icon | img_url: '100x100' | image_url: 'format:auto' }} 100w,
                                    {{ block.settings.icon | img_url: '200x200' | image_url: 'format:auto' }} 200w"
                                sizes="50px"
                                width="100%"
                                height="100%"
                                alt="{{ block.settings.icon.alt | escape }}"
                                loading="lazy"
                                decoding="async"
                            />

                            <div class="pp-regular pretitle f-white">
                                <span class="pretitle d-lg-block d-md-block d-sm-none">
                                    {{ block.settings.heading }}
                                </span>
                                <span class="body d-lg-none d-md-none d-sm-block">
                                    {{ block.settings.heading }}
                                </span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% schema %}
{
    "class": "product-video-with-icon-list-section",
    "name": "Video With Icon List",
    "limit": 1,
    "templates": ["product"],
    "settings": [
        {
            "type": "checkbox",
            "id": "enabled_section_child_scroll",
            "label": "Enabled Section Child Scroll"
        },
        {
            "type": "text",
            "id": "section_scroll_nav",
            "label": "Section Scroll Nav",
            "info": "Need to Enabled first Section Scroll"
        },
        {
            "type": "text",
            "id": "nav_title",
            "label": "Navigation Title"
        },
        {
            "type": "video",
            "id": "video",
            "label": "Video"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Caringly Tend, Extend Garment Longevity"
        } 
    ],
    "max_blocks": 4,
    "blocks": [
        {
            "type": "icon",
            "name": "Icon",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "icon",
                    "label": "Icon"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Video With Icon List"
        }
    ]
}
{% endschema %}