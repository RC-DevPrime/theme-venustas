{% style %}
    .main-page-section .row {
        --bs-gutter-x: 60px;
    }

    .main-page-section img {
        width: 100%;
        height: 100%;
    }

    .main-page-section .filter-sort-by-container {
        border-radius: 4px 4px 4px 4px;
        border: 1px solid #D9D9D9;
        padding: 6px 15px;
        display: flex;
        align-items: center;
        gap: 8px;
        position: relative;
    }

    .main-page-section .filter-sort-by-container .custom-select {
        display: flex;
        align-items: center;
        width: 160px;
        justify-content: space-between;
        cursor: pointer;
    }

    .main-page-section .filter-sort-by-container .custom-select i {
        font-size: 14px;
    }

    .main-page-section .custom-select-option {
        display: none;
        position: absolute;
        top: 100%;
        right: 0;
        flex-direction: column;
        gap: 0;
        width: 180px;
        border: 1px solid #D9D9D9;
        box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
        z-index: 1;
        background-color: #fff;
    }

    .main-page-section .custom-select-option.show {
        display: flex;
    }

    .main-page-section .custom-select-option span {
        padding: 6px 10px;
        cursor: pointer;
    }

    .main-page-section .custom-select-option span:hover {
        color: #FFF;
        background: #2680EB;

    }


    .main-page-section .list-article-tags {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .main-page-section .list-article-tags .list-article-item {
        padding: 12px 0px;
        border-top: 1px solid #CCCCCC;
        color: #656565;
        transition: color 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
    }

    .main-page-section .list-article-tags .list-article-item.active {
        color: #B93205;
    }

    .main-page-section .list-article-tags .list-article-item:hover {
        color: #B93205;
    }

    .main-page-section .list-article-tags .list-article-item.loading {
        color: #B93205;
        opacity: 0.6;
        transform: translateX(6px);
        pointer-events: none;
    }

    .main-page-section .list-article-tags .list-article-item:last-child {
        border-bottom: 1px solid #CCCCCC;
    }

    .main-page-section .blog-article-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        column-gap: 25px;
        row-gap: 40px;
        padding-bottom: 20px;
        transition: opacity 0.2s ease;
    }

    .main-page-section .blog-article-grid.is-loading {
        opacity: 0.45;
        pointer-events: none;
    }

    .main-page-section #loadMoreBtn {
        width: fit-content;
    }

    .main-page-section .article-item {
        border-radius: 16px;
        box-shadow: 0px 3px 10px 1px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .main-page-section .article-item .article-featured-image {
        height: 300px;
        width: 100%;
        position: relative;
        overflow: hidden;
        display:block;
    }

    .main-page-section .article-item .article-featured-image:hover img {
        transform: scale(1.2) translateY(-10px);
    }

    .main-page-section .article-item .article-featured-image img {
        height: 100%;
        width: 100%;
        object-fit: cover;
        transition: all 0.3s ease;
    }

    .main-page-section .article-item .article-featured-image .article-tag {
        position: absolute;
        left: 1rem;
        top: 1rem;
        background: #B93205;
        border-radius: 4px 4px 4px 4px;
        padding: 4px 15px;
        line-height: normal;
        font-size: 14px;
        color: #FFF;
    }

    .main-page-section .article-item .article-detail {
        padding: 15px 15px 20px;
    }
    .main-page-section .sticky-article-tag{
        position:sticky;
        top:0;
    }


    
    .main-page-section .nav-hover-blog-nav {
        position: fixed;
        left: 0;
        top: 20vh;
        background: #B93205;
        width: fit-content;
        padding: 13px 20px 13px 15px;
        border-top-right-radius: 50px;
        border-bottom-right-radius: 50px;
        display: flex;
        z-index: 999;
        cursor: pointer;
    }

    .main-page-section .nav-hover-blog-nav img {
        width: 20px;
        height: 20px;
        object-fit: contain;
    }

    /* --- MOBILE TOC NAV WRAPPER --- */
    .main-page-section .mobile-blog-list-tags-nav {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 100%;
        background-color: transparent;
        z-index: 999999;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.4s ease, visibility 0.4s ease;
    }

    /* overlay fade */
    .main-page-section .mobile-blog-list-tags-nav .overlay {
        position: fixed;
        z-index: 1;
        height: 100%;
        width: 100%;
        background-color: #000;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    /* side panel */
    .main-page-section .mobile-blog-list-tags-nav .inner-section {
        background-color: #FFF;
        height: 100%;
        width: 89%;
        position: relative;
        z-index: 2;
        transform: translateX(-100%);
        opacity: 0;
        transition: transform 0.5s ease, opacity 0.5s ease;
    }

    /* open state */
    .main-page-section .mobile-blog-list-tags-nav.open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .main-page-section .mobile-blog-list-tags-nav.open .overlay {
        opacity: 0.32;
    }

    .main-page-section .mobile-blog-list-tags-nav.open .inner-section {
        transform: translateX(0);
        opacity: 1;
    }

    /* close button */
    .main-page-section .btn-close-toc {
        position: absolute;
        top: 0;
        right: -40px;
        cursor: pointer;
        width: 40px;
        height: 40px;
        background: #B93205;
        display: flex;
        align-items: center;
        justify-content: center;
        border-top-right-radius: 50%;
        border-bottom-right-radius: 50%;
    }

    .main-page-section .btn-close-toc img {
        width: 20px;
        height: 20px;
        object-fit: contain;
    }

    .main-page-section .mobile-article-tag-container{
        padding:30px 20px;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .main-page-section .article-item {
            border-radius: 8px;
        }
        .main-page-section .filter-sort-by-container .custom-select{
            width:150px;
        }
        .main-page-section .custom-select-option{
            width: 170px;
        }
        .main-page-section .list-article-tags .list-article-item{
            color:#000;
        }
        .main-page-section .list-article-tags .list-article-item.active {
            color: #B93205;
        }
    }

