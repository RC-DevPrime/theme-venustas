<div class="container section-content main-page-section">
    <div class="row">
        <div class="col-lg-3 col-md-3 col-sm-12 d-lg-block d-md-block d-sm-none ">
            <div class="sticky-article-tag"> 
                <div class="pp-bold pretitle f-black pb-4">
                    Blog Tags
                </div>

                <!-- Sidebar Tags (Liquid unique-collector, no active classes from Liquid) -->
                <div class="list-article-tags">
                    <a href="/blogs/{{ blog.handle }}" class="list-article-item">
                        <span class="pp-semibold body-lg">All Posts</span>
                    </a>

                    {% assign rendered_tag_slugs = '|' %}
                    {% for block in section.blocks %}
                        {% assign manual_tag_label = block.settings.tag_label | strip %}
                        {% assign manual_tag_slug = block.settings.tag_slug | handleize %}
                        {% assign manual_slug_token = '|' | append: manual_tag_slug | append: '|' %}

                        {% if manual_tag_label != blank and manual_tag_slug != blank %}
                            {% unless rendered_tag_slugs contains manual_slug_token %}
                                {% assign rendered_tag_slugs = rendered_tag_slugs | append: manual_tag_slug | append: '|' %}
                                <a href="/blogs/{{ blog.handle }}/tagged/{{ manual_tag_slug }}" class="list-article-item" {{ block.shopify_attributes }}>
                                    <span class="pp-semibold body-xl">{{ manual_tag_label }}</span>
                                </a>
                            {% endunless %}
                        {% endif %}
                    {% endfor %}

                    {% for t in blog.all_tags %}
                        {% assign t_handle = t | handleize %}
                        {% assign dynamic_slug_token = '|' | append: t_handle | append: '|' %}

                        {% unless rendered_tag_slugs contains dynamic_slug_token %}
                            {% assign rendered_tag_slugs = rendered_tag_slugs | append: t_handle | append: '|' %}
                            <a href="/blogs/{{ blog.handle }}/tagged/{{ t_handle }}" class="list-article-item">
                                <span class="pp-semibold body-xl">{{ t }}</span>
                            </a>
                        {% endunless %}
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="col-lg-9 col-md-9 col-sm-12">
            <div class="d-flex align-items-center justify-content-end pb-4">
                <div class="filter-sort-by-container">
                    <span class="pp-regular body f-black">Sort By:</span>
                    <div class="custom-select">
                    <span class="pp-bold body f-black">Date Latest First</span>
                    <i class="fa-solid fa-chevron-down f-black"></i>
                    </div>
                    <div class="custom-select-option">
                    <span class="pp-regular body-sm">Date Latest first</span>
                    <span class="pp-regular body-sm">Date Oldest first</span>
                    </div>
                </div>
            </div>

            <div class="main-blog-container">
                {% assign all_articles = blog.articles %}

                <div id="blog-section" class="blog-article-grid">
                    {% paginate all_articles by 999 %}
                    {% for article in all_articles limit: 10 %}
                        {% assign all_tags = '' %}
                        {% for tag in article.tags %}
                            {% assign all_tags = all_tags | append: tag | handleize %}
                            {% unless forloop.last %}
                                {% assign all_tags = all_tags | append: ',' %}
                            {% endunless %}
                        {% endfor %}

                        <div class="article-item" data-tags="{{ all_tags }}">
                            <a href="{{ article.url }}" class="article-featured-image">
                                {% if article.image %}
                                <img src="{{ article.image | img_url: '1400x1400' }}" width="100%" height="100%">
                                {% endif %}

                                {% if article.tags.size > 0 %}
                                <!-- Always FIRST tag in initial render -->
                                <p class="pp-regular article-tag">{{ article.tags.first }}</p>
                                {% endif %}
                            </a>

                            <div class="article-detail">
                                <a href="{{ article.url }}" class="pp-bold pretitle-lg f-black pb-2">
                                    <span class="pretitle d-lg-block d-md-block d-sm-none">{{ article.title }}</span>
                                    <span class="body-xl d-lg-none d-md-none d-sm-block">{{ article.title }}</span>
                                </a>

                                <div class="article-description pp-regular f-white-gray l-h-normal pb-2">
                                    <div class="d-lg-block d-md-block d-sm-none">
                                        <span class="body excerpt-3">
                                            {% if article.excerpt_or_content != blank %}
                                                {{ article.excerpt_or_content }}
                                            {% endif %}
                                        </span>
                                    </div>
                                    <div class="d-lg-none d-md-none d-sm-block">
                                        <span class="body-sm excerpt-3">
                                                {% if article.excerpt_or_content != blank %}
                                                    {{ article.excerpt_or_content }}
                                                {% endif %}
                                        </span>
                                    </div>

                                </div>

                                <div class="article-date-time pp-regular f-main l-h-normal">
                                    <span class="body d-lg-block d-md-block d-sm-none">
                                        {{ article.created_at | date: '%b %d, %Y' }}
                                    </span>
                                    <span class="body-sm d-lg-none d-md-none d-sm-block">
                                        {{ article.created_at | date: '%b %d, %Y' }}
                                    </span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    {% endpaginate %}
                </div>

                <div class="d-flex flex-column justify-content-center align-items-center mt-lg-5 mt-md-5 mt-sm-4">
                    <button id="loadMoreBtn" class="btn-hover btn-main py-2 load-more-btn" style="display:none;">Load More</button>
                    <p id="viewingCounter" class="product-view-count pp-regular body-sm f-gray text-center mt-3">---</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-lg-none d-md-none d-sm-block">
    <div class="nav-hover-blog-nav">
        <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/nav-mobile-icon.png?v=1761784876" width="100%" height="100%">
    </div>
    <div class="mobile-blog-list-tags-nav">
        <div class="overlay"></div>
        <div class="inner-section">
            <div class="btn-close-toc">
                <img src="https://cdn.shopify.com/s/files/1/0457/1099/9709/files/close-nav-mobile.png?v=1761785925" width="100%" height="100%">
            </div>
            <div class="mobile-article-tag-container"> 
                <div class="pp-bold pretitle f-black pb-3">
                    Blog Tags
                </div>

                <!-- Sidebar Tags (Liquid unique-collector, no active classes from Liquid) -->
                <div class="list-article-tags">
                    <a href="/blogs/{{ blog.handle }}" class="list-article-item">
                        <span class="pp-semibold body-xl">All Posts</span>
                    </a>

                    {% assign rendered_tag_slugs = '|' %}
                    {% for block in section.blocks %}
                        {% assign manual_tag_label = block.settings.tag_label | strip %}
                        {% assign manual_tag_slug = block.settings.tag_slug | handleize %}
                        {% assign manual_slug_token = '|' | append: manual_tag_slug | append: '|' %}

                        {% if manual_tag_label != blank and manual_tag_slug != blank %}
                            {% unless rendered_tag_slugs contains manual_slug_token %}
                                {% assign rendered_tag_slugs = rendered_tag_slugs | append: manual_tag_slug | append: '|' %}
                                <a href="/blogs/{{ blog.handle }}/tagged/{{ manual_tag_slug }}" class="list-article-item" {{ block.shopify_attributes }}>
                                    <span class="pp-semibold body-xl">{{ manual_tag_label }}</span>
                                </a>
                            {% endunless %}
                        {% endif %}
                    {% endfor %}

                    {% for t in blog.all_tags %}
                        {% assign t_handle = t | handleize %}
                        {% assign dynamic_slug_token = '|' | append: t_handle | append: '|' %}

                        {% unless rendered_tag_slugs contains dynamic_slug_token %}
                            {% assign rendered_tag_slugs = rendered_tag_slugs | append: t_handle | append: '|' %}
                            <a href="/blogs/{{ blog.handle }}/tagged/{{ t_handle }}" class="list-article-item">
                                <span class="pp-semibold body-xl">{{ t }}</span>
                            </a>
                        {% endunless %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<script id="blog-articles-data" type="application/json">
{% paginate blog.articles by 250 %}
{
  "blogUrl": {{ blog.url | json }},
  "currentTagSlug": {% if current_tags and current_tags.size > 0 %}{{ current_tags.first | handleize | json }}{% else %}""{% endif %},
  "totalItems": {{ paginate.items | json }},
  "currentPage": {{ paginate.current_page | json }},
  "pages": {{ paginate.pages | json }},
  "nextPageUrl": {% if paginate.next %}{{ paginate.next.url | json }}{% else %}null{% endif %},
  "articles": [
      {% for article in blog.articles %}
      {
        "title": {{ article.title | json }},
        "url": {{ article.url | json }},
        "img": {% if article.image %}{{ article.image | img_url: '1400x1400' | json }}{% else %}""{% endif %},
        "excerpt": {% if article.excerpt_or_content != blank %}
          {{ article.excerpt_or_content | strip_html | strip | truncate: 130 | json }}
        {% else %}
          {{ article.content | strip_html | strip | truncate: 130 | json }}
        {% endif %},
        "date": {{ article.created_at | date: '%b %d, %Y' | json }},
        "tags": [
          {% for tag in article.tags %}
            { "label": {{ tag | json }}, "slug": {{ tag | handleize | json }} }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
  ]
}
{% endpaginate %}
</script>



{% schema %}
{
    "class": "main-page-section",
    "name": "Main Blog",
    "limit": 1,
    "blocks": [
        {
            "type": "manual_tag",
            "name": "Manual Tag",
            "settings": [
                {
                    "type": "paragraph",
                    "content": "Manual tags are shown first. Dynamic blog tags are still added automatically, but any dynamic tag with the same slug will be hidden to avoid duplicates."
                },
                {
                    "type": "text",
                    "id": "tag_label",
                    "label": "Tag label"
                },
                {
                    "type": "text",
                    "id": "tag_slug",
                    "label": "Tag slug",
                    "info": "Used in the tag URL: /tagged/your-slug. If the same slug exists in both manual and dynamic tags, the dynamic duplicate is hidden."
                }
            ]
        }
    ],
    "templates": ["blog"],
    "presets": [
        {
            "name": "Main Blog"
        }
    ]
}
{% endschema %}
