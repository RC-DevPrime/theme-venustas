{% style %}
    .logo-slider-section .logo-slider{
        border-top:1px solid #707070;
        border-bottom:1px solid #707070;
        padding:30px 0px;
    }
    .logo-slider-section .logo-slider .swiper-slide{
        width:150px;
    }
    .logo-slider-section .logo-slider .swiper-slide img{
        width:100%;
        height:100px;
        object-fit:contain;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .logo-slider-section .logo-slider .swiper-slide img{
            height: 40px;
        }
        .logo-slider-section .logo-slider .swiper-slide{
            width:80px;
        }
        .logo-slider-section .logo-slider{
            padding: 25px 0px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content pb-0">
    <div class="col-lg-6 col-md-8 col-sm-12 mx-auto pb-lg-5 pb-md-4 pb-sm-4">
        <div class="section-heading pp-bold title-sm f-black text-center">
            {{ section.settings.heading }}
        </div>
        <div class="section-description pp-regular body-lg f-black text-center">
            {{ section.settings.description }}
        </div>
    </div>
</div>
<div class="section-content px-0 pt-0">
    <div class="logo-slider overflow-hidden">
        <div class="swiper-wrapper">
            {% for block in section.blocks %}
                <div class="swiper-slide">
                <div class="logo-item">
                    <img
                    src="{{ block.settings.logo | image_url: width: 300 }}"
                    srcset="
                        {{ block.settings.logo | image_url: width: 150 }} 150w,
                        {{ block.settings.logo | image_url: width: 300 }} 300w,
                        {{ block.settings.logo | image_url: width: 600 }} 600w
                    "
                    sizes="(max-width: 768px) 150px, 300px"
                    width="{{ block.settings.logo.width }}"
                    height="{{ block.settings.logo.height }}"
                    alt="{{ block.settings.logo.alt | escape }}"
                    loading="lazy"
                    decoding="async"
                    >
                </div>
                </div>
            {% endfor %}
            {% for block in section.blocks %}
                <div class="swiper-slide">
                <div class="logo-item">
                    <img
                    src="{{ block.settings.logo | image_url: width: 300 }}"
                    srcset="
                        {{ block.settings.logo | image_url: width: 150 }} 150w,
                        {{ block.settings.logo | image_url: width: 300 }} 300w,
                        {{ block.settings.logo | image_url: width: 600 }} 600w
                    "
                    sizes="(max-width: 768px) 150px, 300px"
                    width="{{ block.settings.logo.width }}"
                    height="{{ block.settings.logo.height }}"
                    alt="{{ block.settings.logo.alt | escape }}"
                    loading="lazy"
                    decoding="async"
                    >
                </div>
                </div>
            {% endfor %}
        </div>

    </div>
</div>
<script>
  var animation_scroll_speed = {{ section.settings.animation_scroll_speed }}
</script>
{% schema %}
{
    "class": "logo-slider-section",
    "name": "Logo Slider",
    "limit": 1,
    "templates": ["index"],
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "As Seen In"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Venustas has earned the trust of businesses worldwide through continuous innovation and building relationships based on mutual trust.</p>"
        },
        {
            "type": "text",
            "id": "animation_scroll_speed",
            "label": "Animation Scroll Speed",
            "default": "1700"
        }
    ],
    "blocks": [
        {
            "type": "logo",
            "name": "Logo",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "logo",
                    "label": "Logo"
                },
            ]
        },
    ],
    "presets": [
        {
            "name": "Logo Slider"
        }
    ]
}
{% endschema %}
