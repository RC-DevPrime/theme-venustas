{% style %}
    .campaign-gift-list-slider-section{
        background-color:#242424;
    }
    .campaign-gift-list-slider-section .section-heading{
        display:flex;
        align-items:center;
        justify-content:center;
        gap:10px;
    }
    .campaign-gift-list-slider-section .heading-element{
        height:40px;
        width:fit-content;
        object-fit:contain;
    }

    .campaign-gift-list-slider-section .image-container{
        width:100%;
        height:650px;
    }
    .campaign-gift-list-slider-section .image-container img{
        width:100%;
        height:100%;
        object-fit:contain;
    }
    .custom-accordion-container .custom-accordion-item:last-child .accordion-label{
        padding-bottom:0;
    }
    .custom-accordion-container .custom-accordion-item .accordion-label{
        display:flex;
        gap:10px;
        align-items:center;
        padding-bottom:30px;
        width:fit-content;
        cursor:pointer;
    }
    .custom-accordion-container .custom-accordion-item .count{
        padding:4px 10px;
        background: #333333;
        border-radius:5px;
        line-height:normal;
    }
    .custom-accordion-container .custom-accordion-item .accordion-label:hover .count{
        background: #B93205;
    }
    .custom-accordion-container .custom-accordion-item.active .count{
        background: #B93205;
    }
    .custom-accordion-container .custom-accordion-item.active .accordion-label{
        padding-bottom:10px;
    }
    .custom-accordion-container .custom-accordion-item .accordion-content{
        padding:0px 20px 30px;
        padding-left:40px;
        display:none;
        
    }
    .custom-accordion-container .custom-accordion-item.active .accordion-content{
        display:block;
    }
    
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .campaign-gift-list-slider-section .image-container{
            height:fit-content;
        }
        .custom-accordion-container .custom-accordion-item .accordion-label{
            padding-bottom:20px;
            gap:8px;
        }
        .custom-accordion-container .custom-accordion-item.active .accordion-label{
            padding-bottom:5px;
        }
        .custom-accordion-container .custom-accordion-item .count{
            padding:2px 8px;
        }
        .custom-accordion-container .custom-accordion-item .accordion-content{
            padding-bottom:20px;
            padding-left:35px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content 
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}> 
    <div class="content-container">
        <h2 class="pp-semibold f-white title-sm text-center pb-lg-3 pb-md-3 pb-sm-2">
            {{ section.settings.heading }}
        </h2>
        <div class="pp-regular body-lg f-white-gray text-center pb-lg-4 pb-md-4 pb-sm-3 d-lg-block d-md-block d-sm-none">
            {{ section.settings.description }}
        </div>
        <div class="pp-regular body f-white-gray text-center pb-lg-4 pb-md-4 pb-sm-3 d-lg-none d-md-none d-sm-block">
            {{ section.settings.description }}
        </div>
    </div>
    <div class="row align-items-center d-lg-flex d-md-flex d-sm-none">
        <div class="col-6">
            <div class="custom-accordion-container">
                {% for block in section.blocks %}
                    <div class="custom-accordion-item {% if forloop.index == 1 %}active{% endif %}">
                        <div class="accordion-label">
                            <span class="count pp-semibold f-white">{{ forloop.index }}</span>
                            <h4 class="pp-semibold pretitle f-white">{{ block.settings.heading }}</h4>
                        </div>
                        <div class="accordion-content pp-regular f-white-gray body-lg">
                            {{ block.settings.description }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="col-6">
            <div class="image-container">
                <img src="{{ section.settings.image | img_url:'master' }}" width="100%" height="100%" class="image">
            </div>
        </div>
    </div>
    <div class="d-lg-none d-md-none d-sm-block">
        <div class="col-12">
            <div class="image-container">
                <img src="{{ section.settings.image_mobile | img_url:'master' }}" width="100%" height="100%" class="image">
            </div>
            <div class="custom-accordion-container">
                {% for block in section.blocks %}
                    <div class="custom-accordion-item {% if forloop.index == 1 %}active{% endif %}">
                        <div class="accordion-label">
                            <span class="count body pp-semibold f-white">{{ forloop.index }}</span>
                            <h4 class="pp-semibold body-xl f-white">{{ block.settings.heading }}</h4>
                        </div>
                        <div class="accordion-content pp-regular f-white-gray body">
                            {{ block.settings.description }}
                        </div>
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>

</div>

{% schema %}
    {
        "class": "campaign-gift-list-slider-section",
        "name": "Campaign Gift List Slider",
        "templates": ["page"],
        "limit": 1, 
        "settings": [
            {
                "type": "checkbox",
                "id": "enabled_section_child_scroll",
                "label": "Enabled Section Child Scroll"
            },
            {
                "type": "text",
                "id": "section_scroll_nav",
                "label": "Section Scroll Nav",
                "info": "Need to Enabled first Section Scroll"
            },
            {
                "type": "text",
                "id": "nav_title",
                "label": "Navigation Title"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Build Your Warmth Gift List Now"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description",
                "default": "<p>Don’t rush to pick gifts. Get  & save on cozy surprises</p>"
            },
            {
                "type": "image_picker",
                "id": "image",
                "label": "Image"
            },
            {
                "type": "image_picker",
                "id": "image_mobile",
                "label": "Image - Mobile"
            }
        ],
        "blocks": [
            {
                "type": "gift",
                "name": "Gift",
                "settings": [
                    {
                        "type": "text",
                        "id": "heading",
                        "label": "Heading",
                    },
                    {
                        "type": "textarea",
                        "id": "description",
                        "label": "Description"
                    }
                ]
            }
        ],
        "presets" :[{
            "name" : "Campaign Gift List Slider"
        }]
    }
  {% endschema %} 