{% style %}
    .collection-list-section .collection-list-container .row{
        --bs-gutter-x: 1rem;
        --bs-gutter-y: 1rem;
    }
    .collection-list-section .collection-image{
        overflow:hidden;
        border-radius:8px;
    }
    .collection-list-section .collection-image img{
        width:100%;
        height:100%;
        object-fit:cover;
        transition: all 0.3s ease;
    }
    .collection-list-section .collection-image img:hover{
        scale:1.1;
    }
{% endstyle %}
<div class="container section-content overflow-hidden pt-3">
    <h2 class="pp-bold f-black title-sm pb-lg-4 pb-md-4 pb-sm-3 text-lg-start text-md-start text-sm-center">
        {{ section.settings.heading }}
    </h2>
    <div class="collection-list-container">
        <div class="row d-lg-flex d-md-flex d-sm-none">
            {% for block in section.blocks %}
                <div class="col">
                    <a href="{{ block.settings.link }}" class="collection-item">
                        <div class="collection-image mb-lg-3 mb-md-3 mb-sm-2">
                            <img
                                src="{{ block.settings.image | img_url: '1024x1024' }}"
                                srcset="
                                    {{ block.settings.image | img_url: '480x480' }} 480w,
                                    {{ block.settings.image | img_url: '768x768' }} 768w,
                                    {{ block.settings.image | img_url: '1024x1024' }} 1024w,
                                    {{ block.settings.image | img_url: '1600x1600' }} 1600w"
                                sizes="100vw"
                                width="100%"
                                height="100%"
                                alt="{{ block.settings.image.alt | escape }}"
                                decoding="async"
                                fetchpriority="high"
                            />

                        </div>
                        <p class="pp-bold body-lg">
                            {{ block.settings.heading }}
                        </p>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="collection-list-slider d-lg-none d-md-none d-sm-block">
        <div class="swiper-wrapper">
            {% for block in section.blocks %}
                <div class="swiper-slide">
                    <a href="{{ block.settings.link }}" class="collection-item">
                        <div class="collection-image mb-lg-3 mb-md-3 mb-sm-2">
                            <img
                                src="{{ block.settings.image | img_url: '1024x1024' }}"
                                srcset="
                                    {{ block.settings.image | img_url: '480x480' }} 480w,
                                    {{ block.settings.image | img_url: '768x768' }} 768w,
                                    {{ block.settings.image | img_url: '1024x1024' }} 1024w,
                                    {{ block.settings.image | img_url: '1600x1600' }} 1600w"
                                sizes="100vw"
                                width="100%"
                                height="100%"
                                alt="{{ block.settings.image.alt | escape }}"
                                decoding="async"
                                fetchpriority="high"
                            />

                        </div>
                        <p class="pp-bold body-lg">
                            {{ block.settings.heading }}
                        </p>
                    </a>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination d-flex align-items-center justify-content-center mt-4"></div>
    </div>
</div>
{% schema %}
{
    "class": "collection-list-section",
    "name": "Collection List",
    "limit": 1,
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Men's Clothing"
        }
    ],
    "blocks": [
        {
            "type": "view_all",
            "name": "View All",
            "limit": 1,
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                }
            ]
        },
        {
            "type": "collection",
            "name": "Collection",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                }
            ]
        }
    ],
    "templates": ["collection"],
}
{% endschema %}