{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .container {
    padding-left: 40px;
    padding-right: 40px;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .container {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
  #shopify-section-{{ section.id }} .for-her-cta {
    padding: 80px 0;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .for-her-cta__heading {
    font-size: clamp(26px, 3vw, 44px);
    font-weight: 800;
    color: {{ section.settings.accent_color }};
    margin-bottom: 16px;
    line-height: 1.15;
  }
  #shopify-section-{{ section.id }} .for-her-cta__desc {
    color: #888;
    font-size: 15px;
    line-height: 1.7;
    max-width: 620px;
    margin: 0 auto 32px;
  }
  #shopify-section-{{ section.id }} .for-her-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px;
  }
  #shopify-section-{{ section.id }} .for-her-cta__btn {
    display: inline-block;
    background: transparent;
    color: {{ section.settings.accent_color }};
    border: 1.5px solid {{ section.settings.accent_color }};
    padding: 11px 30px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  #shopify-section-{{ section.id }} .for-her-cta__btn:hover {
    background: {{ section.settings.accent_color }};
    color: #fff;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .for-her-cta {
      padding: 56px 0;
    }
  }
{% endstyle %}

<div class="for-her-cta">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="for-her-cta__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="for-her-cta__desc">{{ section.settings.description }}</p>
    {% endif %}
    <div class="for-her-cta__buttons">
      {% if section.settings.btn1_label != blank and section.settings.btn1_link != blank %}
        <a href="{{ section.settings.btn1_link }}" class="for-her-cta__btn">{{ section.settings.btn1_label }}</a>
      {% endif %}
      {% if section.settings.btn2_label != blank and section.settings.btn2_link != blank %}
        <a href="{{ section.settings.btn2_link }}" class="for-her-cta__btn">{{ section.settings.btn2_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "For Her - Collaborate CTA",
  "class": "for-her-collaborate-cta-section",
  "templates": ["page"],
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAD4CC"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Heading & Buttons)",
      "default": "#B93205"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Interested in Collaborating with Us?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button 1 Label",
      "default": "Send Us Email"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Button 2 Label",
      "default": "Explore Our UCC Program"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link"
    }
  ],
  "presets": [{ "name": "For Her - Collaborate CTA" }]
}
{% endschema %}