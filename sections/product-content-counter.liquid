{% style %}
    .product-content-counter-section{
        background-color: #1C1C1C;
    }
    .product-content-counter-section .image-container{
        width:100%;
        height:500px;
        border-radius: 8px 8px 8px 8px;
        overflow:hidden;
    }
    .product-content-counter-section .image-container img{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .counter-details-container{
        margin-top:30px;
    }
    .counter-descriptions .item-description{
        display:inline-block;
    }
    .counter-descriptions .item-description:first-child{
        margin-right:40px;
    }
    .counter-descriptions .item-description strong{
        font-weight:600;
        font-size:34px;
        color: #B93205;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .product-content-counter-section .image-container{
            height:260px;
        }
        .counter-descriptions .item-description strong{
            font-size:26px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content 
    {% if section.settings.nav_title != blank %} section-scroll
    {% else %}
      {% if section.settings.enabled_section_child_scroll %} section-scroll
       {% endif -%}
    {% endif %}" 

    {% if section.settings.nav_title != blank %}
        data-scroll="{{ section.settings.nav_title | handleize }}"
    {% endif %} 
    {% if section.settings.enabled_section_child_scroll %}
        data-child-scroll="{{ section.settings.section_scroll_nav | handleize }}"
    {% endif %}>
    
    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="content-container col-lg-11 col-md-11 col-sm-12">
                <h2 class="pp-bold title-sm f-white pb-lg-3 pb-md-3 pb-sm-3 text-lg-start text-md-start text-sm-center">
                    {{ section.settings.heading }}
                </h2>
                <div class="pp-regular f-white-gray text-lg-start text-md-start text-sm-center pb-lg-0 pb-md-0 pb-sm-3">
                    <span class="body-lg d-lg-block d-md-block d-sm-none">
                        {{ section.settings.description }}
                    </span>
                    <span class="body d-lg-none d-md-none d-sm-block">
                        {{ section.settings.description }}
                    </span>
                </div>

                <div class="counter-details-container d-lg-block d-md-block d-sm-none">
                    <div class="counter-item mb-3">
                        <span class="pp-regular f-gray body">
                            {{  section.settings.col_1_label }}
                        </span>
                        <div class="counter-descriptions">
                            {% if section.settings.col_1_description != blank %}
                                <div class="item-description pp-regular pretitle-lg f-white"> 
                                    {{ section.settings.col_1_description }}
                                </div>
                            {% endif %}
                            {% if section.settings.col_1_description_2 != blank %}
                                <div class="item-description pp-regular pretitle-lg f-white"> 
                                    {{ section.settings.col_1_description_2 }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="counter-item">
                        <span class="pp-regular f-gray body">
                            {{  section.settings.col_2_label }}
                        </span>
                        <div class="counter-descriptions">
                            {% if section.settings.col_2_description != blank %}
                                <div class="item-description pp-regular pretitle-lg f-white"> 
                                    {{ section.settings.col_2_description }}
                                </div>
                            {% endif %}
                            {% if section.settings.col_2_description_2 != blank %}
                                <div class="item-description pp-regular pretitle-lg f-white"> 
                                    {{ section.settings.col_2_description_2 }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="counter-item">
                        <span class="pp-regular f-gray body">
                            {{  section.settings.col_3_label }}
                        </span>
                        <div class="counter-descriptions">
                            {% if section.settings.col_3_description != blank %}
                                <div class="item-description pp-regular pretitle-lg f-white"> 
                                    {{ section.settings.col_3_description }}
                                </div>
                            {% endif %}
                            {% if section.settings.col_3_description_2 != blank %}
                                <div class="item-description pp-regular pretitle-lg f-white"> 
                                    {{ section.settings.col_3_description_2 }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="counter-item">
                        <span class="pp-regular f-gray body">
                            {{  section.settings.col_4_label }}
                        </span>
                        <div class="counter-descriptions">
                            {% if section.settings.col_4_description != blank %}
                                <div class="item-description pp-regular pretitle-lg f-white"> 
                                    {{ section.settings.col_4_description }}
                                </div>
                            {% endif %}
                            {% if section.settings.col_4_description_2 != blank %}
                                <div class="item-description pp-regular pretitle-lg f-white"> 
                                    {{ section.settings.col_4_description_2 }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="image-container">
                <img
                    src="{{ section.settings.image | img_url: '400x400' | image_url: 'format:auto' }}"
                    srcset="
                        {{ section.settings.image | img_url: '400x400' | image_url: 'format:auto' }} 400w,
                        {{ section.settings.image | img_url: '800x800' | image_url: 'format:auto' }} 800w,
                        {{ section.settings.image | img_url: '1200x1200' | image_url: 'format:auto' }} 1200w,
                        {{ section.settings.image | img_url: '1400x1400' | image_url: 'format:auto' }} 1400w"
                    sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                    width="100%"
                    height="100%"
                    alt="{{ section.settings.image.alt | escape }}"
                    loading="lazy"
                    decoding="async"
                />

            </div>

            <div class="counter-details-container d-lg-none d-md-none d-sm-block">
                <div class="counter-item mb-3">
                    <span class="pp-regular f-gray body">
                        {{  section.settings.col_1_label }}
                    </span>
                    <div class="counter-descriptions pt-3">
                        {% if section.settings.col_1_description != blank %}
                            <div class="item-description pp-regular body f-white"> 
                                {{ section.settings.col_1_description }}
                            </div>
                        {% endif %}
                        {% if section.settings.col_1_description_2 != blank %}
                            <div class="item-description pp-regular body f-white"> 
                                {{ section.settings.col_1_description_2 }}
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="counter-item">
                    <span class="pp-regular f-gray body">
                        {{  section.settings.col_2_label }}
                    </span>
                    <div class="counter-descriptions pt-3">
                        {% if section.settings.col_2_description != blank %}
                            <div class="item-description pp-regular body f-white"> 
                                {{ section.settings.col_2_description }}
                            </div>
                        {% endif %}
                        {% if section.settings.col_2_description_2 != blank %}
                            <div class="item-description pp-regular body f-white"> 
                                {{ section.settings.col_2_description_2 }}
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="counter-item">
                    <span class="pp-regular f-gray body">
                        {{  section.settings.col_3_label }}
                    </span>
                    <div class="counter-descriptions pt-3">
                        {% if section.settings.col_3_description != blank %}
                            <div class="item-description pp-regular body f-white"> 
                                {{ section.settings.col_3_description }}
                            </div>
                        {% endif %}
                        {% if section.settings.col_3_description_2 != blank %}
                            <div class="item-description pp-regular body f-white"> 
                                {{ section.settings.col_3_description_2 }}
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="counter-item">
                    <span class="pp-regular f-gray body">
                        {{  section.settings.col_4_label }}
                    </span>
                    <div class="counter-descriptions pt-3">
                        {% if section.settings.col_4_description != blank %}
                            <div class="item-description pp-regular body f-white"> 
                                {{ section.settings.col_4_description }}
                            </div>
                        {% endif %}
                        {% if section.settings.col_4_description_2 != blank %}
                            <div class="item-description pp-regular body f-white"> 
                                {{ section.settings.col_4_description_2 }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% schema %}
{
    "class": "product-content-counter-section", 
    "name": "Content Counter",
    "limit": 1,
    "templates": ["product"],
    "settings": [
        {
            "type": "checkbox",
            "id": "enabled_section_child_scroll",
            "label": "Enabled Section Child Scroll"
        },
        {
            "type": "text",
            "id": "section_scroll_nav",
            "label": "Section Scroll Nav",
            "info": "Need to Enabled first Section Scroll"
        },
        {
            "type": "text",
            "id": "nav_title",
            "label": "Navigation Title"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Diverse High-performance Fabric Options"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>We have carefully selected a variety of high-performance fabrics including FELLEX® lightweight thermal material, COOLMAX® moisture-wicking technology, REPREVE® recycled environmental fabric, and BIONIC FINISH® ECO water-repellent finishing technology. These materials cater to different dressing needs ranging from city commuting to outdoor cold weather conditions.</p>"
        },
        {
            "type": "header",
            "content": "Counter List"
        },
        {
            "type": "text",
            "id": "col_1_label",
            "label": "Column - 1 Label",
            "default": "Lining"
        },
        {
            "type": "richtext",
            "id": "col_1_description",
            "label": "Column - 1 Description 1"
        },
        {
            "type": "richtext",
            "id": "col_1_description_2",
            "label": "Column - 1 Description 2"
        },
        {
            "type": "text",
            "id": "col_2_label",
            "label": "Column - 2 Label",
            "default": "Shell"
        },
        {
            "type": "richtext",
            "id": "col_2_description",
            "label": "Column - 2 Description"
        },
        {
            "type": "richtext",
            "id": "col_2_description_2",
            "label": "Column - 2 Description 2"
        },
        {
            "type": "text",
            "id": "col_3_label",
            "label": "Column - 3 Label",
            "default": "Shell"
        },
        {
            "type": "richtext",
            "id": "col_3_description",
            "label": "Column - 3 Description"
        },
        {
            "type": "richtext",
            "id": "col_3_description_2",
            "label": "Column - 3 Description 2"
        },
        {
            "type": "text",
            "id": "col_4_label",
            "label": "Column - 4 Label",
            "default": "Shell"
        },
        {
            "type": "richtext",
            "id": "col_4_description",
            "label": "Column - 4 Description"
        },
        {
            "type": "richtext",
            "id": "col_4_description_2",
            "label": "Column - 4 Description 2"
        },
    ],
    "presets": [
        {
            "name": "Content Counter"
        }
    ]
}
{% endschema %}