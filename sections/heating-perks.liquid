</section>

{% schema %}
{
  "name": "Heating Perks",
  "tag": "section",
  "class": "heating-perks-section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Active Heat"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Heating Perks",
      "blocks": [
        {
          "type": "perk",
          "settings": {
            "heading": "Active Heat",
          }
        },
        {
          "type": "perk",
          "settings": {
            "heading": "Ride Longer",
          }
        },
        {
          "type": "perk",
          "settings": {
            "heading": "Modular System",
          }
        }
      ]
    }
  ]
}
{% endschema %}
