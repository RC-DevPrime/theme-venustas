{% style %}
  #shopify-section-{{ section.id }} .heating-perks {
    width: 100%;
    border-top: 6px solid var(--color-brand);
    color: #fff;
    font-family: 'Montserrat', sans-serif;
    background:#F5F5F5;
    padding-bottom:98px;
  }
  #shopify-section-{{ section.id }} .heating-perks__inner-wrapper {
    width:100%;
    background: var(--venustas-black);
  }
  #shopify-section-{{ section.id }} .heating-perks__inner {
    width: 576px;
    margin:0 auto;
    min-height: 64px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
  }

  #shopify-section-{{ section.id }} .heating-perks__item {
    width:172px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .heating-perks__icon {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    color: var(--color-brand);
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .heating-perks__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .heating-perks__content {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .heating-perks__heading {
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-perks__text {
    margin: 0;
    color: #fff;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heating-perks{
      border-width:4px;
    }
    #shopify-section-{{ section.id }} .heating-perks__inner {
      width: 100%;
      padding: 24px;
      box-sizing: border-box;
      column-gap: 22px;
    }

    #shopify-section-{{ section.id }} .heating-perks__item {
      height: 100%;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 12px;
      padding-top: 12px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .heating-perks__icon {
      width: 28px;
      height: 28px;
      flex: 0 0 28px;
    }

    #shopify-section-{{ section.id }} .heating-perks__content {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .heating-perks__heading {
      margin-bottom: 4px;
      font-size: 12px;
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .heating-perks__text {
      min-height: 2.4em;
      font-size: 10px;
      line-height: 1.2;
    }
  }
{% endstyle %}

