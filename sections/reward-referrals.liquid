{% style %}
    .reward-referrals-section .featured-image{
        position:relative;
    }
    .reward-referrals-section .featured-image:before{
        content: "";
        display: block;
        position: absolute;
        width: 100%;
        height: 100%;
        background-color: #F9F6EF;
        border-radius:37px;
        transform: rotate(350deg);
    }
    .reward-referrals-section .featured-image img{
        position:relative;
        border-radius:37px;
    }

    .reward-referrals-section ul li {
        list-style: none;
        position: relative;
    }
    
    .reward-referrals-section ul li strong{
        font-weight:600;
        color:#B93205;
    }
    .reward-referrals-section ul li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 6px;
        width: 18px;
        height: 18px;               
        background-image: url('https://cdn.shopify.com/s/files/1/0457/1099/9709/files/77838_2x_42e4ad07-4c01-4301-b741-90f563dda560.png?v=1763463541');
        background-size: contain;
        background-repeat: no-repeat;
    }
    .reward-referrals-section ul li {
        padding-left: 28px;
        margin-bottom:10px;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .reward-referrals-section .featured-image:before,
        .reward-referrals-section .featured-image img{
            border-radius:16px;
        }
        .reward-referrals-section ul li::before{
            width:16px;
            height:16px;
        }
        .reward-referrals-section ul li{
            padding-left:24px;
            top: 4px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content">
    <div class="row align-items-center">
        <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="content-description col-lg-10 col-md-10 col-sm-12 mx-auto d-lg-none d-md-none d-sm-block pb-3">
                <h4 class="pp-bold title-sm f-black text-center pb-2">
                    {{ section.settings.heading }}
                </h4>
                <p class="pp-regular body-lg text-center pb-lg-0 pb-md-0 pb-sm-3">
                    {{ section.settings.description }}
                </p>
            </div>
            <div class="featured-image mb-lg-0 mb-md-0 mb-sm-3">
                <img src="{{ section.settings.background_image | img_url: '1400x1400' }}" width="100%" height="100%">
            </div>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="content-description col-lg-10 col-md-10 col-sm-12 ms-auto ">
                <h4 class="pp-bold title-sm f-black pb-3 d-lg-block d-md-block d-sm-none">
                    {{ section.settings.heading }}
                </h4>
                <p class="pp-regular body-lg f-gray d-lg-block d-md-block d-sm-none">
                    {{ section.settings.description }}
                </p>
                <div class="content-list body-lg py-4 d-lg-block d-md-block d-sm-none">
                    {{ section.settings.list_content }}
                </div>
                <div class="content-list body pt-3 d-lg-none d-md-none d-sm-block">
                    {{ section.settings.list_content }}
                </div>
                <p class="pp-regular body-lg f-gray pb-lg-5 pb-md-5 pb-sm-4 d-lg-block d-md-block d-sm-none">
                    {{ section.settings.description_2 }}
                </p>
                <p class="pp-regular body f-gray pb-lg-5 pb-md-5 pb-sm-4 d-lg-none d-md-none d-sm-block">
                    {{ section.settings.description_2 }}
                </p>
                <div class="d-flex align-items-center justify-content-lg-start justify-content-md-start justify-content-sm-center w-100">
                    <a href="javascript:void(0)" class="icon-gift btn-hover btn-main py-2 px-lg-5 px-md-5 px-sm-4">
                        <span class="f-white pp-regular body d-lg-block d-md-block d-sm-none">
                            {{ section.settings.btn_label }}
                        </span>
                        <span class="f-white pp-regular body d-lg-none d-md-none d-sm-block">
                            {{ section.settings.btn_label }}
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% schema %}
    {
        "class": "reward-referrals-section",
        "name": "Reward Referrals",
        "limit": 1,
        "templates": ["page"],
        "settings": [
            {
                "type": "image_picker",
                "id": "background_image", 
                "label": "Background Image"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Referral Rewards"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description",
                "default": "<p>At Venustas, Sharing Happiness Comes With Perks! Invite Your Friends To Join, And You’ll Both Enjoy Exclusive Rewards:</p>"

            },
            {
                "type": "richtext",
                "id": "list_content",
                "label": "List Content"
            },
            {
                "type": "richtext",
                "id": "description_2",
                "label": "Description",
                "default": "<p>*share your unique link, and once they complete their purchase, the rewards will be automatically credited to both of you.</p>"
            },
            {
                "type": "text",
                "id": "btn_label",
                "label": "Button Label",
                "default": "Refer A Friend"
            },
            {
                "type": "url",
                "id": "btn_link",
                "label": "Button Link"
            }
        ],
        "presets" :[{
            "name" : "Reward Referrals"
        }]
    }
  {% endschema %} 