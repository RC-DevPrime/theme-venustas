{% style %}
    .military-banner-section img{
        width:100%;
        height:100%;
    }
{% endstyle %}

  <img
    class="d-lg-none d-md-none d-sm-block"
    src="{{ section.settings.background_image_mobile | image_url: width: 1600 }}"
    srcset="{{ section.settings.background_image_mobile | image_url: width: 800 }} 800w,
            {{ section.settings.background_image_mobile | image_url: width: 1200 }} 1200w,
            {{ section.settings.background_image_mobile | image_url: width: 1600 }} 1600w"
    sizes="100vw"
    alt="{{ section.settings.background_image_mobile.alt | escape }}"
    loading="lazy"
    decoding="async"
    width="100%"
    height="100%">

  <!-- Desktop Image -->
  <img
    class="d-lg-block d-md-block d-sm-none"
    src="{{ section.settings.background_image | image_url: width: 1600 }}"
    srcset="{{ section.settings.background_image | image_url: width: 800 }} 800w,
            {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
            {{ section.settings.background_image | image_url: width: 1600 }} 1600w"
    sizes="100vw"
    alt="{{ section.settings.background_image.alt | escape }}"
    loading="lazy"
    decoding="async"
    width="100%"
    height="100%">
{% schema %}
    {
        "class": "military-banner-section",
        "name": "Military Banner",
        "templates": ["page"],
        "limit": 1, 
        "settings": [
            {
                "type": "image_picker",
                "id": "background_image",
                "label": "Background Image - Desktop"
            },
            {
                "type": "image_picker",
                "id": "background_image_mobile",
                "label": "Background Image - Mobile"
            }
        ],
        "presets" :[{
            "name" : "Military Banner"
        }]
    }
{% endschema %} 