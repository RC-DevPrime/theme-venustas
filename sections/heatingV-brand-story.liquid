{% style %}
  #shopify-section-{{ section.id }} .heatingv-brand-story {
    position: relative;
    width: 100%;
    height: 400svh;
    --ember: #ff4f27;
    background: linear-gradient(180deg, #14161a 42.308%, #531602 100%);
    color: #fff;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__stage {
    position: sticky;
    top: 0;
    display: flex;
    width: 100%;
    height: 100svh;
    min-height: 100svh;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__inner {
    position: relative;
    width: min(100% - 40px, 1340px);
    height: 100%;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__content {
    position: absolute;
    top: 15%;
    left: 50%;
    display: flex;
    width: min(100%, 1120px);
    height: 70%;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    transform: translateX(-50%);
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
    top: var(--story-heading-y, 50%);
    will-change: top, opacity;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__heading {
    position: absolute;
    top: calc(50% + var(--story-heading-y, 0px));
    left: 50%;
    width: min(100%, 1020px);
    margin: 0;
    color: transparent;
    font-size: 86px;
    font-weight: 800;
    line-height: 1.35;
    text-align: center;
    opacity: var(--story-heading-opacity, 0);
    transform: translate(-50%, -50%);
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__heading-layer {
    display: block;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__heading-layer--base {
    color: #a0a1a6;
    opacity: var(--story-base-opacity, 1);
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__heading-layer--gradient {
    position: absolute;
    inset: 0;
    color: transparent;
    opacity: var(--story-gradient-opacity, 0);
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__heading-layer--gradient .heatingv-brand-story__heading-line {
    display: block;
    background: linear-gradient(100deg, var(--story-grad-start, var(--ember)) 0%, var(--story-grad-mid, #ff936c) 52%, var(--story-grad-end, #ffc4ad) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__heading-layer--final {
    position: absolute;
    inset: 0;
    color: transparent;
    opacity: var(--story-final-gradient-opacity, 0);
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__heading-layer--final .heatingv-brand-story__heading-line {
    display: block;
    background: linear-gradient(90deg, #B93205 41.83%, #FFAD4F 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__heading-line {
    font-size:128px;
    display: block;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__stats {
    position: relative;
    display: flex;
    width: min(100%, 1120px);
    flex-direction: column;
    align-items: center;
    gap: 0;
    text-align: center;
    margin-top: auto;
    opacity: var(--story-stats-opacity, 0);
    transform: translateY(var(--story-stats-y, 24px));
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__content .heatingv-brand-story__heading {
    position: relative;
    top: auto;
    left: auto;
    width: min(100vw, 1020px);
    transform: none;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__tagline {
    margin: 0;
    color: #fff;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.45;
    opacity: var(--story-stats-opacity, 0);
    transform: translateY(var(--story-stats-y, 24px));
    transition: opacity .2s ease, transform .2s ease;
    will-change: opacity, transform;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__metrics {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-top: 120px;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__metric-value,
  #shopify-section-{{ section.id }} .heatingv-brand-story__metric-label {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__metric-value {
    color: #fff;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .heatingv-brand-story__metric-label {
    color: rgba(255, 255, 255, .82);
    font-size: 8px;
    font-weight: 400;
    line-height: 1.35;
  }

  /* Keep the second-act copy grouped together while it fades in. */
  #shopify-section-{{ section.id }} .heatingv-brand-story__stats > * {
    flex: 0 0 auto;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingv-brand-story {
      height: auto;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__stage {
      position: relative;
      top: auto;
      display: block;
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__inner {
      display: flex;
      width: 100%;
      height: auto;
      flex-direction: column;
      gap: 0;
      padding: 120px 20px 80px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__content {
      position: static;
      display: flex;
      width: 100%;
      height: auto;
      transform: none;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__copy {
      position: static;
      width: 100%;
      gap: 24px;
      transform: none;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__heading {
      position: static;
      width: 100%;
      font-size: 32px;
      font-weight: 800;
      line-height: 1.2;
      color: #ff8b63;
      opacity: 1;
      transform: none;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__heading-layer--base {
      color: inherit;
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__heading-layer--gradient {
      display: none;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__heading-layer--final {
      display: none;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__heading-line {
      font-size: 52px;
      display: inline;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__stats {
      font-size: 16px;
      position: static;
      display: flex;
      width: 100%;
      flex-direction: column;
      align-items: center;
      gap: 0;
      text-align: center;
      opacity: 1;
      margin-top: 0;
      transform: none;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__tagline {
      max-width: 320px;
      font-size: 16px;
      line-height: 1.4;
      opacity: 1;
      transform: none;
      transition: none;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__metrics {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px 24px;
      margin-top: 138px;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__metric-value {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .heatingv-brand-story__metric-label {
      font-size: 12px;
    }
   
  }
{% endstyle %}

<section
  id="HeatingBrandStory-{{ section.id }}"
  class="heatingv-brand-story"
  data-heatingv-brand-story
>
  <div class="heatingv-brand-story__stage">
    <div class="heatingv-brand-story__inner">
      <div class="heatingv-brand-story__content">
        <div class="heatingv-brand-story__copy">
          {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
            <h2 class="heatingv-brand-story__heading" aria-label="{{ section.settings.heading | append: ' ' | append: section.settings.heading_accent | strip | escape }}">
              <span class="heatingv-brand-story__heading-layer heatingv-brand-story__heading-layer--base">
                {%- if section.settings.heading != blank -%}
                  <span class="heatingv-brand-story__heading-line">{{ section.settings.heading }}</span>
                {%- endif -%}
                {%- if section.settings.heading_accent != blank -%}
                  <span class="heatingv-brand-story__heading-line">{{ section.settings.heading_accent }}</span>
                {%- endif -%}
              </span>
              <span class="heatingv-brand-story__heading-layer heatingv-brand-story__heading-layer--gradient" aria-hidden="true">
                {%- if section.settings.heading != blank -%}
                  <span class="heatingv-brand-story__heading-line">{{ section.settings.heading }}</span>
                {%- endif -%}
                {%- if section.settings.heading_accent != blank -%}
                  <span class="heatingv-brand-story__heading-line">{{ section.settings.heading_accent }}</span>
                {%- endif -%}
              </span>
              <span class="heatingv-brand-story__heading-layer heatingv-brand-story__heading-layer--final" aria-hidden="true">
                {%- if section.settings.heading != blank -%}
                  <span class="heatingv-brand-story__heading-line">{{ section.settings.heading }}</span>
                {%- endif -%}
                {%- if section.settings.heading_accent != blank -%}
                  <span class="heatingv-brand-story__heading-line">{{ section.settings.heading_accent }}</span>
                {%- endif -%}
              </span>
            </h2>
          {%- endif -%}
          <p class="heatingv-brand-story__tagline">Engineered from the ground up for extreme cold.</p>
        </div>

        <div class="heatingv-brand-story__stats" aria-label="Venustas achievements">
          <div class="heatingv-brand-story__metrics">
            <div class="heatingv-brand-story__metric">
              <p class="heatingv-brand-story__metric-value">2M+</p>
              <p class="heatingv-brand-story__metric-label">Happy Customers</p>
            </div>
            <div class="heatingv-brand-story__metric">
              <p class="heatingv-brand-story__metric-value">3M+</p>
              <p class="heatingv-brand-story__metric-label">Products Sold</p>
            </div>
            <div class="heatingv-brand-story__metric">
              <p class="heatingv-brand-story__metric-value">8+</p>
              <p class="heatingv-brand-story__metric-label">Years Innovation</p>
            </div>
            <div class="heatingv-brand-story__metric">
              <p class="heatingv-brand-story__metric-value">30+</p>
              <p class="heatingv-brand-story__metric-label">Countries</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('HeatingBrandStory-{{ section.id }}');
    if (!section || section.dataset.storyInitialized === 'true') return;

    section.dataset.storyInitialized = 'true';
    const media = window.matchMedia('(max-width: 767px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;

    const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
    const range = (value, start, end) => clamp((value - start) / (end - start));
    const mix = (from, to, amount) => from + (to - from) * amount;
    const mixColor = (from, to, amount) => {
      const channel = (index) => Math.round(mix(from[index], to[index], amount));
      return `rgb(${channel(0)}, ${channel(1)}, ${channel(2)})`;
    };

    const render = () => {
      frame = 0;

      if (media.matches) {
        section.style.removeProperty('--story-heading-opacity');
        section.style.removeProperty('--story-heading-y');
        section.style.removeProperty('--story-base-opacity');
        section.style.removeProperty('--story-gradient-opacity');
        section.style.removeProperty('--story-final-gradient-opacity');
        section.style.removeProperty('--story-grad-start');
        section.style.removeProperty('--story-grad-mid');
        section.style.removeProperty('--story-grad-end');
        section.style.removeProperty('--story-stats-opacity');
        section.style.removeProperty('--story-stats-y');
        return;
      }

      if (reducedMotion.matches) {
        section.style.setProperty('--story-heading-opacity', '1');
        section.style.setProperty('--story-heading-y', '21.43%');
        section.style.setProperty('--story-base-opacity', '0');
        section.style.setProperty('--story-gradient-opacity', '1');
        section.style.setProperty('--story-final-gradient-opacity', '1');
        section.style.setProperty('--story-grad-start', 'rgb(255, 79, 39)');
        section.style.setProperty('--story-grad-mid', 'rgb(255, 132, 92)');
        section.style.setProperty('--story-grad-end', 'rgb(255, 193, 170)');
        section.style.setProperty('--story-stats-opacity', '1');
        section.style.setProperty('--story-stats-y', '0px');
        return;
      }

      const rect = section.getBoundingClientRect();
      const distance = Math.max(section.offsetHeight - window.innerHeight, 1);
      const progress = clamp(-rect.top / distance);
      const intro = range(progress, 0.03, 0.18);
      const gradientEnter = range(progress, 0.25, 0.5);
      const gradientDepth = range(progress, 0.38, 0.72);
      const finalGradient = range(progress, 0.58, 0.78);
      const statsEnter = range(progress, 0.2, 0.36);
      const headingY = mix(50, 21.43, intro);
      const statsY = mix(24, 0, statsEnter);
      const gradStart = mixColor([255, 163, 135], [255, 79, 39], gradientDepth);
      const gradMid = mixColor([255, 191, 170], [255, 132, 92], gradientDepth);
      const gradEnd = mixColor([255, 224, 214], [255, 193, 170], gradientDepth);

      section.style.setProperty('--story-heading-opacity', intro.toFixed(3));
      section.style.setProperty('--story-heading-y', `${headingY.toFixed(2)}%`);
      section.style.setProperty('--story-base-opacity', (1 - gradientEnter).toFixed(3));
      section.style.setProperty('--story-gradient-opacity', (gradientEnter * (1 - finalGradient)).toFixed(3));
      section.style.setProperty('--story-final-gradient-opacity', finalGradient.toFixed(3));
      section.style.setProperty('--story-grad-start', gradStart);
      section.style.setProperty('--story-grad-mid', gradMid);
      section.style.setProperty('--story-grad-end', gradEnd);
      section.style.setProperty('--story-stats-opacity', statsEnter.toFixed(3));
      section.style.setProperty('--story-stats-y', `${statsY.toFixed(2)}px`);
    };

    const requestRender = () => {
      if (!frame) frame = window.requestAnimationFrame(render);
    };

    window.addEventListener('scroll', requestRender, { passive: true });
    window.addEventListener('resize', requestRender, { passive: true });
    media.addEventListener?.('change', requestRender);
    reducedMotion.addEventListener?.('change', requestRender);
    requestRender();
  })();
</script>

{% schema %}
{
  "name": "HeatingV Brand Story",
  "tag": "section",
  "class": "heatingv-brand-story-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "ProductH heading",
      "default": "The Expert In"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "ProductH accent heading",
      "default": "Heated Apparel"
    }
  ],
  "presets": [
    {
      "name": "HeatingV Brand Story"
    }
  ]
}
{% endschema %}
