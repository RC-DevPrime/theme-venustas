{% style %}
    .featured-banner-section{
        content-visibility:auto;
        contain-intrinsic-size: 1px 760px;
    }
    .featured-banner-section .featured-inner-section{
        background: #F3F3F3;
        border-radius: 16px 16px 16px 16px;
        height:560px;
        overflow:hidden;
    }
    .featured-banner-section .height-content{
        height:400px;
    }
    .featured-banner-section .flow-images{
        --bs-gutter-x:1rem;
        transform: translateY(-7%);
    }
    .featured-banner-section .flow-images img{
        width:100%;
        height:100%;
        margin:0.5rem 0px;
    }
    .featured-banner-section .flow-images .gap-flow-image img:first-child{
        margin-top:4rem;
    }
    .featured-banner-section .flow-images .col .flo-image-container {
        transition: all 0.8s ease 0.4s;
    }
    .featured-banner-section.animate .flow-images .col:nth-child(odd) .flo-image-container {
        transform: translateY(-8%);
    }
    .featured-banner-section.animate .flow-images .col:nth-child(even) .flo-image-container {
        transform: translateY(8%);
    }
    .featured-banner-section .height-content{
        height: 180px;
        margin-top:-5% !important;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .featured-banner-section .featured-inner-section{
            height:unset;
        }
        .featured-banner-section .vertical-animation-container{
            height: 260px;
            overflow: hidden;
        }
        .featured-banner-section.animate .flow-images .col:nth-child(even) .flo-image-container{
            transform: translateY(0%);
        }
        .featured-banner-section .height-content{
            height: 180px;
            padding: 15px 0px;
            margin-top:0 !important;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="container section-content ">
    <div class="featured-inner-section">
        <div class="row h-100 align-items-center">
            <div class="col-lg-6 col-md-6 col-sm-12 vertical-animation-container">
                <div class="row flow-images">
                    <div class="col">
                        <div class="d-flex flex-column flo-image-container">
                            <img
                                alt="featured-banner-image"
                                src="{{ section.settings.image_1 | image_url: width: 420 }}"
                                srcset="{{ section.settings.image_1 | image_url: width: 320 }} 320w, {{ section.settings.image_1 | image_url: width: 420 }} 420w, {{ section.settings.image_1 | image_url: width: 640 }} 640w"
                                sizes="(max-width: 768px) 25vw, 12vw"
                                loading="lazy"
                                decoding="async">
                            <img
                                alt="featured-banner-image"
                                src="{{ section.settings.image_2 | image_url: width: 420 }}"
                                srcset="{{ section.settings.image_2 | image_url: width: 320 }} 320w, {{ section.settings.image_2 | image_url: width: 420 }} 420w, {{ section.settings.image_2 | image_url: width: 640 }} 640w"
                                sizes="(max-width: 768px) 25vw, 12vw"
                                loading="lazy"
                                decoding="async">
                        </div>
                    </div> 
                    <div class="col">
                        <div class="d-flex flex-column flo-image-container gap-flow-image">
                            <img
                                alt="featured-banner-image"
                                src="{{ section.settings.image_3 | image_url: width: 420 }}"
                                srcset="{{ section.settings.image_3 | image_url: width: 320 }} 320w, {{ section.settings.image_3 | image_url: width: 420 }} 420w, {{ section.settings.image_3 | image_url: width: 640 }} 640w"
                                sizes="(max-width: 768px) 25vw, 12vw"
                                loading="lazy"
                                decoding="async">
                            <img
                                alt="featured-banner-image"
                                src="{{ section.settings.image_4 | image_url: width: 420 }}"
                                srcset="{{ section.settings.image_4 | image_url: width: 320 }} 320w, {{ section.settings.image_4 | image_url: width: 420 }} 420w, {{ section.settings.image_4 | image_url: width: 640 }} 640w"
                                sizes="(max-width: 768px) 25vw, 12vw"
                                loading="lazy"
                                decoding="async">
                        </div>
                    </div> 
                    <div class="col">
                        <div class="d-flex flex-column flo-image-container">
                            <img
                                alt="featured-banner-image"
                                src="{{ section.settings.image_5 | image_url: width: 420 }}"
                                srcset="{{ section.settings.image_5 | image_url: width: 320 }} 320w, {{ section.settings.image_5 | image_url: width: 420 }} 420w, {{ section.settings.image_5 | image_url: width: 640 }} 640w"
                                sizes="(max-width: 768px) 25vw, 12vw"
                                loading="lazy"
                                decoding="async">
                            <img
                                alt="featured-banner-image"
                                src="{{ section.settings.image_6 | image_url: width: 420 }}"
                                srcset="{{ section.settings.image_6 | image_url: width: 320 }} 320w, {{ section.settings.image_6 | image_url: width: 420 }} 420w, {{ section.settings.image_6 | image_url: width: 640 }} 640w"
                                sizes="(max-width: 768px) 25vw, 12vw"
                                loading="lazy"
                                decoding="async">
                        </div>
                    </div> 
                    <div class="col d-lg-block d-md-block d-sm-none">
                        <div class="d-flex flex-column flo-image-container gap-flow-image">
                            <img
                                alt="featured-banner-image"
                                src="{{ section.settings.image_7 | image_url: width: 420 }}"
                                srcset="{{ section.settings.image_7 | image_url: width: 320 }} 320w, {{ section.settings.image_7 | image_url: width: 420 }} 420w, {{ section.settings.image_7 | image_url: width: 640 }} 640w"
                                sizes="12vw"
                                loading="lazy"
                                decoding="async">
                            <img
                                alt="featured-banner-image"
                                src="{{ section.settings.image_8 | image_url: width: 420 }}"
                                srcset="{{ section.settings.image_8 | image_url: width: 320 }} 320w, {{ section.settings.image_8 | image_url: width: 420 }} 420w, {{ section.settings.image_8 | image_url: width: 640 }} 640w"
                                sizes="12vw"
                                loading="lazy"
                                decoding="async">
                        </div>
                    </div> 
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12 h-100">
                <div class="m-auto d-flex flex-column gap-2 height-content justify-content-center h-100" style="width: fit-content;">
                    <div class="section-title pp-bold title-sm text-center">
                        {{ section.settings.heading }}
                    </div>
                    <a href="{{ section.settings.link }}" class="section-btn btn-hover btn-main btn-no-animation mx-auto py-lg-3 py-md-3 py-sm-1 px-lg-4 px-md-4 px-sm-4">
                        <span class="pp-medium body-sm l-h-normal">
                            {{ section.settings.btn_label }}
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% schema %}
