            "id": "image_3",
            "label": "Image - 3"
        },
        {
            "type": "image_picker",
            "id": "image_4",
            "label": "Image - 4"
        },
        {
            "type": "image_picker",
            "id": "image_5",
            "label": "Image - 5"
        },
        {
            "type": "image_picker",
            "id": "image_6",
            "label": "Image - 6"
        },
