{%- style -%}
  #shopify-section-{{ section.id }} .heatingV-riding-position { overflow: hidden; background: #1a1a1a; color: #fff; font-family: var(--font-primary, 'Montserrat', sans-serif); }
  #shopify-section-{{ section.id }} .heatingV-riding-position__inner { width: min(calc(100% - 40px), 1340px); margin: 0 auto; padding: 100px 0; }
  #shopify-section-{{ section.id }} .heatingV-riding-position h2,
  #shopify-section-{{ section.id }} .heatingV-riding-position h3,
  #shopify-section-{{ section.id }} .heatingV-riding-position p { margin: 0; }
  #shopify-section-{{ section.id }} .heatingV-riding-position__title { margin-bottom: 44px !important; font-size: 34px; font-weight: 700; line-height: 1.16; }
  #shopify-section-{{ section.id }} .heatingV-riding-position__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(2, 279px); gap: 18px; }
  #shopify-section-{{ section.id }} .heatingV-riding-position__card { position: relative; min-width: 0; overflow: hidden; border-radius: 16px; background: #2a2a2a; }
  #shopify-section-{{ section.id }} .heatingV-riding-position__card--featured { grid-column: 3; grid-row: 1 / span 2; }
  #shopify-section-{{ section.id }} .heatingV-riding-position__media,
  #shopify-section-{{ section.id }} .heatingV-riding-position__media picture { display: block; width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .heatingV-riding-position__media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: bottom; }
  #shopify-section-{{ section.id }} .heatingV-riding-position__placeholder { display: grid; width: 100%; height: 100%; place-items: center; color: #aaa; background: #333; font-size: 12px; }
  #shopify-section-{{ section.id }} .heatingV-riding-position__copy { position: absolute; right: 0; bottom: 0; left: 0; padding: 20px 22px; background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,.7) 100%); }
  #shopify-section-{{ section.id }} .heatingV-riding-position__card-title { font-size: 20px; font-weight: 600; line-height: 1.25; }
  #shopify-section-{{ section.id }} .heatingV-riding-position__card-description { margin-top: 5px !important; color: rgba(255,255,255,.88); font-size: 16px; line-height: 1.42; }
  @media (max-width: 1199px) { #shopify-section-{{ section.id }} .heatingV-riding-position__inner { padding: 80px 0; } #shopify-section-{{ section.id }} .heatingV-riding-position__grid { grid-template-rows: repeat(2, minmax(220px, 1fr)); } }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingV-riding-position__inner { width: calc(100% - 40px); padding: 56px 0; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__title { margin-bottom: 32px !important; font-size: 28px; line-height: normal; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(3, auto); gap: 24px 16px; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__card { overflow: visible; border-radius: 6px; background: transparent; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__card--featured { grid-column: auto; grid-row: auto; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__card:nth-child(1) { grid-column: 1; grid-row: 1; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__card:nth-child(2) { grid-column: 2; grid-row: 1; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__card:nth-child(3) { grid-column: 2; grid-row: 2; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__card:nth-child(4) { grid-column: 1 / span 2; grid-row: 3; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__card:nth-child(5) { grid-column: 1; grid-row: 2; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__media { height: 230px; border-radius: 6px; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__copy { position: static; padding: 12px 0 0; background: none; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__card-title { font-size: 15px; letter-spacing: -.15px; }
    #shopify-section-{{ section.id }} .heatingV-riding-position__card-description { margin-top: 4px !important; color: #fff; font-size: 13.5px; line-height: 1.68; }
  }
{%- endstyle -%}

<section class="heatingV-riding-position">
  <div class="heatingV-riding-position__inner">
    <h2 class="heatingV-riding-position__title">{{ section.settings.title | escape }}</h2>
    <div class="heatingV-riding-position__grid">
      {%- for block in section.blocks -%}
        <article class="heatingV-riding-position__card{% if block.settings.featured %} heatingV-riding-position__card--featured{% endif %}" {{ block.shopify_attributes }}>
          <div class="heatingV-riding-position__media">
            {%- if block.settings.desktop_image != blank -%}
              <picture>
                {%- if block.settings.mobile_image != blank -%}<source media="(max-width: 767px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}" sizes="100vw">{%- endif -%}
                {{ block.settings.desktop_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 800, 1200, 1600', sizes: '(max-width: 767px) 100vw, 33vw', alt: block.settings.title }}
              </picture>
            {%- else -%}<span class="heatingV-riding-position__placeholder">{{ block.settings.title | escape }}</span>{%- endif -%}
          </div>
          <div class="heatingV-riding-position__copy"><h3 class="heatingV-riding-position__card-title">{{ block.settings.title | escape }}</h3><p class="heatingV-riding-position__card-description">{{ block.settings.description | escape }}</p></div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HeatingV Riding Position",
  "tag": "section",
  "settings": [{ "type": "text", "id": "title", "label": "Section title", "default": "Designed for Gloved Hands" }],
  "blocks": [{
    "type": "feature",
    "name": "Feature card",
    "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Feature description" },
      { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
      { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
      { "type": "checkbox", "id": "featured", "label": "Tall desktop card", "default": false }
    ]
  }],
  "presets": [{
    "name": "HeatingV Riding Position",
    "blocks": [
      { "type": "feature", "settings": { "title": "Button at the side hem", "description": "Where a gloved hand finds it through a shell, with nothing lit up on your front." } },
      { "type": "feature", "settings": { "title": "Hand pockets that warm your hands", "description": "Brushed fleece on the back of the hand, graphene lining on the palm side." } },
      { "type": "feature", "settings": { "title": "Water-resistant chest pocket", "description": "Keeps your phone close to the heat, where its battery lasts longer." } },
      { "type": "feature", "settings": { "title": "Fleece-lined stand collar", "description": "Soft fleece and a chin guard where the cold reaches you first." } },
      { "type": "feature", "settings": { "title": "Twin-zip back pocket", "description": "Wide enough for a spare pair of gloves, opening from either hand.", "featured": true } }
    ]
  }]
}
{% endschema %}
