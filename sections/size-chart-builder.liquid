{% assign default_columns = section.settings.default_columns | at_least: 1 %}
{% assign default_rows = section.settings.default_rows | at_least: 1 %}

<section class="size-chart-builder-section" id="SizeChartBuilder-{{ section.id }}">
  <div class="size-chart-builder__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="size-chart-builder__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="size-chart-builder__description rte">{{ section.settings.description }}</div>
    {% endif %}

    <div class="size-chart-builder__controls">
      <button type="button" class="size-chart-builder__button" data-action="add-column">Add Column</button>
      <button type="button" class="size-chart-builder__button" data-action="add-row">Add Row</button>
      <button type="button" class="size-chart-builder__button size-chart-builder__button--secondary" data-action="toggle-import">Import Existing HTML</button>
      <button type="button" class="size-chart-builder__button size-chart-builder__button--secondary" data-action="generate-html">Generate HTML</button>
      <button type="button" class="size-chart-builder__button size-chart-builder__button--secondary" data-action="copy-html">Copy HTML</button>
      <button type="button" class="size-chart-builder__button size-chart-builder__button--ghost" data-action="reset-table">Reset</button>
    </div>

    <div class="size-chart-builder__import" data-import-panel hidden>
      <label class="size-chart-builder__output-label" for="SizeChartBuilderImport-{{ section.id }}">Paste existing size chart HTML</label>
      <textarea
        id="SizeChartBuilderImport-{{ section.id }}"
        class="size-chart-builder__output-textarea size-chart-builder__output-textarea--import"
        data-import-input
        spellcheck="false"
      ></textarea>
      <div class="size-chart-builder__controls size-chart-builder__controls--import">
        <button type="button" class="size-chart-builder__button size-chart-builder__button--secondary" data-action="import-html">Load Into Builder</button>
      </div>
    </div>

    <div class="size-chart-builder__workspace">
      <div class="size-chart-builder__table-wrap" data-table-wrap></div>

      <div class="size-chart-builder__output">
        <label class="size-chart-builder__output-label" for="SizeChartBuilderOutput-{{ section.id }}">Generated HTML</label>
        <textarea
          id="SizeChartBuilderOutput-{{ section.id }}"
          class="size-chart-builder__output-textarea"
          data-output
          spellcheck="false"
          readonly
        ></textarea>
        <p class="size-chart-builder__hint">Paste this into your size chart metaobject HTML or rich text field.</p>
        <p class="size-chart-builder__status" data-status aria-live="polite"></p>
      </div>
    </div>
  </div>

  <style>
    #SizeChartBuilder-{{ section.id }} {
      padding: 48px 20px;
      background: #f7f3ec;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__inner {
      max-width: 1280px;
      margin: 0 auto;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__heading {
      margin: 0 0 12px;
      color: #171717;
      font-size: clamp(28px, 3vw, 40px);
      line-height: 1.05;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__description {
      max-width: 760px;
      margin-bottom: 24px;
      color: #4b4b4b;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__controls {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 20px;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__button {
      border: 1px solid #171717;
      background: #171717;
      color: #fff;
      padding: 10px 16px;
      cursor: pointer;
      font: inherit;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__button:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__button--secondary {
      background: #fff;
      color: #171717;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__button--ghost {
      background: transparent;
      color: #171717;
      border-color: #b6a48c;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__workspace {
      display: grid;
      grid-template-columns: minmax(0, 1.75fr) minmax(320px, 1fr);
      gap: 24px;
      align-items: start;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__import {
      margin-bottom: 24px;
      background: #fff;
      border: 1px solid #d8cdbd;
      padding: 18px;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__table-wrap,
    #SizeChartBuilder-{{ section.id }} .size-chart-builder__output {
      background: #fff;
      border: 1px solid #d8cdbd;
      padding: 18px;
      overflow: auto;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__table {
      width: 100%;
      border-collapse: collapse;
      min-width: 720px;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__table th,
    #SizeChartBuilder-{{ section.id }} .size-chart-builder__table td {
      border: 1px solid #d8cdbd;
      padding: 12px;
      vertical-align: top;
      background: #fff;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__table th {
      background: #f3ece2;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__cell-group {
      display: grid;
      gap: 8px;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__unit-fields {
      display: grid;
      grid-template-columns: repeat(2, minmax(90px, 1fr));
      gap: 8px;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__field {
      width: 100%;
      border: 1px solid #c8baa7;
      padding: 8px 10px;
      font: inherit;
      color: #171717;
      background: #fff;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__field--small {
      min-width: 0;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__meta {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
      margin-bottom: 8px;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #6c6257;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__remove {
      border: 0;
      background: transparent;
      color: #8b0000;
      cursor: pointer;
      padding: 0;
      font: inherit;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__row-label-cell {
      min-width: 140px;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__output-label {
      display: block;
      margin-bottom: 8px;
      color: #171717;
      font-weight: 600;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__output-textarea {
      width: 100%;
      min-height: 420px;
      border: 1px solid #c8baa7;
      padding: 12px;
      resize: vertical;
      font: 13px/1.5 Consolas, Monaco, monospace;
      color: #171717;
      background: #fcfbf9;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__output-textarea--import {
      min-height: 180px;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__controls--import {
      margin: 12px 0 0;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__hint,
    #SizeChartBuilder-{{ section.id }} .size-chart-builder__status {
      margin: 10px 0 0;
      color: #5b5248;
      font-size: 13px;
    }

    #SizeChartBuilder-{{ section.id }} .size-chart-builder__status:empty {
      display: none;
    }

    @media screen and (max-width: 989px) {
      #SizeChartBuilder-{{ section.id }} .size-chart-builder__workspace {
        grid-template-columns: 1fr;
      }

      #SizeChartBuilder-{{ section.id }} .size-chart-builder__output-textarea {
        min-height: 280px;
      }
    }
  </style>

  <script>
    (() => {
      const section = document.getElementById('SizeChartBuilder-{{ section.id }}');

      if (!section) return;

      const tableWrap = section.querySelector('[data-table-wrap]');
      const output = section.querySelector('[data-output]');
      const status = section.querySelector('[data-status]');
      const importPanel = section.querySelector('[data-import-panel]');
      const importInput = section.querySelector('[data-import-input]');

      const defaultColumnCount = {{ default_columns | json }};
      const defaultRowCount = {{ default_rows | json }};

      const escapeHtml = (value) => {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      };

      const createDefaultColumns = () => {
        const presetLabels = ['Chest', 'Hem', 'Length', 'Sleeve', 'Waist', 'Hip', 'Shoulder', 'Inseam'];
        return Array.from({ length: defaultColumnCount }, (_, columnIndex) => ({
          label: presetLabels[columnIndex] || `Column ${columnIndex + 1}`
        }));
      };

      const createDefaultRows = () => {
        const presetLabels = ['XS', 'S', 'M', 'L', 'XL', '2XL', '3XL', '4XL', '5XL', '6XL', '7XL', '8XL'];
        return Array.from({ length: defaultRowCount }, (_, rowIndex) => ({
          label: presetLabels[rowIndex] || `Size ${rowIndex + 1}`,
          cells: Array.from({ length: defaultColumnCount }, () => ({ value: '' }))
        }));
      };

      const state = {
        columns: createDefaultColumns(),
        rows: createDefaultRows()
      };

      const syncRowCellCounts = () => {
        state.rows = state.rows.map((row) => {
          const cells = row.cells.slice(0, state.columns.length);

          while (cells.length < state.columns.length) {
            cells.push({ value: '' });
          }

          return { ...row, cells };
        });
      };

      const createTableMarkup = () => {
        let headerHtml = '';
        for (let columnIndex = 0; columnIndex < state.columns.length; columnIndex += 1) {
          const column = state.columns[columnIndex];
          headerHtml += `
            <th data-column="${columnIndex}">
              <div class="size-chart-builder__meta">
                <span class="size-chart-builder__label">Column ${columnIndex + 1}</span>
                ${state.columns.length > 1 ? `<button type="button" class="size-chart-builder__remove" data-action="remove-column" data-column="${columnIndex}">Remove</button>` : ''}
              </div>
              <input
                type="text"
                class="size-chart-builder__field"
                data-column-label="${columnIndex}"
                value="${escapeHtml(column.label)}"
                placeholder="Column label"
              >
            </th>
          `;
        }

        let bodyHtml = '';
        for (let rowIndex = 0; rowIndex < state.rows.length; rowIndex += 1) {
          const row = state.rows[rowIndex];
          let cellsHtml = '';

          for (let columnIndex = 0; columnIndex < state.columns.length; columnIndex += 1) {
            const cell = row.cells[columnIndex] || { value: '' };
            cellsHtml += `
              <td>
                <div class="size-chart-builder__cell-group">
                  <input
                    type="text"
                    class="size-chart-builder__field size-chart-builder__field--small"
                    data-cell-value="${rowIndex}-${columnIndex}"
                    value="${escapeHtml(cell.value)}"
                    placeholder="Value"
                  >
                </div>
              </td>
            `;
          }

          bodyHtml += `
            <tr data-row="${rowIndex}">
              <td class="size-chart-builder__row-label-cell">
                <div class="size-chart-builder__meta">
                  <span class="size-chart-builder__label">Size ${rowIndex + 1}</span>
                  ${state.rows.length > 1 ? `<button type="button" class="size-chart-builder__remove" data-action="remove-row" data-row="${rowIndex}">Remove</button>` : ''}
                </div>
                <input
                  type="text"
                  class="size-chart-builder__field"
                  data-row-label="${rowIndex}"
                  value="${escapeHtml(row.label)}"
                  placeholder="Row label"
                >
              </td>
              ${cellsHtml}
            </tr>
          `;
        }

        return `
          <table class="size-chart-builder__table">
            <thead>
              <tr>
                <th>Size</th>
                ${headerHtml}
              </tr>
            </thead>
            <tbody>
              ${bodyHtml}
            </tbody>
          </table>
        `;
      };

      const generateHtml = () => {
        const headHtml = state.columns
          .map((column) => `      <th>${escapeHtml(column.label)}</th>`)
          .join('\n');

        const bodyHtml = state.rows
          .map((row) => {
            const cellHtml = row.cells
              .map((cell) => {
                return `      <td>${escapeHtml(cell.value || '')}</td>`;
              })
              .join('\n');

            return `    <tr>\n      <td>${escapeHtml(row.label)}</td>\n${cellHtml}\n    </tr>`;
          })
          .join('\n');

        output.value = `<div class="size-chart-container">\n  <table class="size-chart-table">\n    <thead>\n      <tr>\n        <th>Size</th>\n${headHtml}\n      </tr>\n    </thead>\n    <tbody>\n${bodyHtml}\n    </tbody>\n  </table>\n</div>`;
        status.textContent = 'HTML generated. You can copy and paste it into your size chart metaobject.';
      };

      const importHtml = () => {
        const source = importInput.value.trim();

        if (!source) {
          status.textContent = 'Paste the existing size chart HTML first.';
          return;
        }

        const parser = new DOMParser();
        const doc = parser.parseFromString(source, 'text/html');
        const table = doc.querySelector('.size-chart-table') || doc.querySelector('table');

        if (!table) {
          status.textContent = 'No table was found in the pasted HTML.';
          return;
        }

        const headerCells = Array.from(table.querySelectorAll('thead th'));
        const bodyRows = Array.from(table.querySelectorAll('tbody tr'));

        if (headerCells.length < 2 || bodyRows.length < 1) {
          status.textContent = 'The table needs at least one size column and one data row.';
          return;
        }

        state.columns = headerCells.slice(1).map((cell, index) => ({
          label: cell.textContent.trim() || `Column ${index + 1}`
        }));

        state.rows = bodyRows.map((row, rowIndex) => {
          const cells = Array.from(row.querySelectorAll('td'));
          const rowLabel = cells[0] ? cells[0].textContent.trim() : `Size ${rowIndex + 1}`;
          const values = cells.slice(1).map((cell) => ({
            value: cell.textContent.trim()
          }));

          while (values.length < state.columns.length) {
            values.push({ value: '' });
          }

          return {
            label: rowLabel,
            cells: values.slice(0, state.columns.length)
          };
        });

        output.value = source;
        render();
        status.textContent = 'Existing HTML loaded into the builder.';
      };

      const render = () => {
        syncRowCellCounts();
        tableWrap.innerHTML = createTableMarkup();
      };

      const reset = () => {
        state.columns = createDefaultColumns();
        state.rows = createDefaultRows();
        output.value = '';
        status.textContent = '';
        render();
      };

      section.addEventListener('input', (event) => {
        if (event.target.matches('[data-column-label]')) {
          const columnIndex = Number(event.target.getAttribute('data-column-label'));
          state.columns[columnIndex].label = event.target.value;
          return;
        }

        if (event.target.matches('[data-row-label]')) {
          const rowIndex = Number(event.target.getAttribute('data-row-label'));
          state.rows[rowIndex].label = event.target.value;
          return;
        }

        if (event.target.matches('[data-cell-value]')) {
          const [rowIndex, columnIndex] = event.target.getAttribute('data-cell-value').split('-').map(Number);
          state.rows[rowIndex].cells[columnIndex].value = event.target.value;
        }
      });

      section.addEventListener('click', async (event) => {
        const button = event.target.closest('[data-action]');
        if (!button) return;

        const action = button.getAttribute('data-action');

        if (action === 'add-column') {
          state.columns.push({ label: `Column ${state.columns.length + 1}` });
          syncRowCellCounts();
          render();
          return;
        }

        if (action === 'add-row') {
          state.rows.push({
            label: `Size ${state.rows.length + 1}`,
            cells: Array.from({ length: state.columns.length }, () => ({ value: '' }))
          });
          render();
          return;
        }

        if (action === 'remove-column' && state.columns.length > 1) {
          const columnIndex = Number(button.getAttribute('data-column'));
          state.columns.splice(columnIndex, 1);
          state.rows = state.rows.map((row) => {
            const cells = row.cells.slice();
            cells.splice(columnIndex, 1);
            return { ...row, cells };
          });
          render();
          status.textContent = 'A column was removed.';
          return;
        }

        if (action === 'remove-row' && state.rows.length > 1) {
          const rowIndex = Number(button.getAttribute('data-row'));
          state.rows.splice(rowIndex, 1);
          render();
          status.textContent = 'A row was removed.';
          return;
        }

        if (action === 'generate-html') {
          generateHtml();
          return;
        }

        if (action === 'toggle-import') {
          importPanel.hidden = !importPanel.hidden;
          status.textContent = importPanel.hidden ? '' : 'Paste an existing table HTML block, then load it into the builder.';
          return;
        }

        if (action === 'import-html') {
          importHtml();
          return;
        }

        if (action === 'copy-html') {
          if (!output.value.trim()) {
            generateHtml();
          }

          try {
            await navigator.clipboard.writeText(output.value);
            status.textContent = 'HTML copied to clipboard.';
          } catch (error) {
            status.textContent = 'Clipboard access was blocked. You can still copy the HTML manually from the textarea.';
          }
          return;
        }

        if (action === 'reset-table') {
          reset();
        }
      });

      render();
    })();
  </script>
</section>

{% schema %}
{
  "name": "Size Chart Builder",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size chart HTML builder"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Build a flexible size chart, generate the HTML, then paste it into your size chart metaobject field.</p>"
    },
    {
      "type": "range",
      "id": "default_columns",
      "label": "Default measurement columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "default_rows",
      "label": "Default size rows",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Size Chart Builder"
    }
  ]
}
{% endschema %}
