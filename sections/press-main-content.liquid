{% style %}

    .main-press-content-section .tab-list-container{
        display:flex;
        justify-content: center;
        margin-top:30px;
    }
    .main-press-content-section .tab-list-container .tab-list-inner-container{
        display:flex;
        border-radius:8px;
        overflow:hidden;
        border: 1px solid #B93205;
    }
    .main-press-content-section .tab-list-container .tab-item{
        padding:8px 35px;
        display:flex;
        gap:5px;
        align-items:center;
        justify-content:center;
        cursor:pointer;
        color:#B93205;
        
    }
    .main-press-content-section .tab-list-container .tab-item.active{
        background: #B93205;
        border-radius:8px;
        overflow:hidden;
    }
    .main-press-content-section .tab-list-container .tab-item.active span{
        color:#FFF;
    }
    .main-press-content-section .tab-list-container .tab-item .tab-flag{
        height:20px;
        width:fit-content;
        object-fit:contain;
    }

    .main-press-content-section .tab-content-list-container{
    }
    
    .main-press-content-section .tab-content-list-container .tab-content-item .row{
        --bs-gutter-x: 1.2rem;
        --bs-gutter-y: 2rem;
    }

    .main-press-content-section .press-item{
        border-radius: 16px 16px 16px 16px;
        border: 1px solid #707070;
        padding:15px;
        padding-bottom:25px;
        display:block;
    }

    .main-press-content-section .press-item .featured-image{
        height:300px;
        width:100%;
        overflow:hidden;
        border-radius:16px;
        position:relative;
    }

    .main-press-content-section .press-item .featured-image .learn-btn{
        position:absolute;
        top:0;
        left:0;
        opacity:0;
        transition: all 0.3s ease 0.1s;
    }
    .main-press-content-section .press-item:hover .featured-image .learn-btn{
        opacity:1;
    }

    .main-press-content-section .press-item .featured-image img{
        width:100%;
        height:100%;
        object-fit:cover;
        transition: all 0.3s ease;
    }
    .main-press-content-section .press-item:hover .featured-image img{
        filter:blur(24px);
    }
    .main-press-content-section .press-item .featured-image:before{
        content:"";
        display:block;
        width:65px;
        height:75px;
        background:white;
        position:absolute;
        top:0;
        right:0;
        z-index:1;
        transition: all 0.3s ease;
        border-radius:16px;
        transform: translate(100% , -100%);
    }
    .main-press-content-section .press-item:hover .featured-image:before{
        transform: translate(0 , 0);
    }

    .main-press-content-section .press-item .featured-image .date-container{
        display:flex;
        gap:10px;
        align-items:center;
        position:absolute;
        bottom:1rem;
        left:1rem;
        background: #1d1d1d94;
        padding:8px 12px;
        border-radius: 8px 8px 8px 8px;
        opacity:0;
        transition: all 0.3s ease 0.1s;
    }
    
    .main-press-content-section .press-item .featured-image .date-container svg{
        width:18px;
        height:18px;
    }

    .main-press-content-section .press-item:hover .featured-image .date-container{
        opacity:1;
    }

    .main-press-content-section .press-item .press-logo .press-logo-container{
        width:40px;
        height:40px;
        border-radius:40px;
        overflow:hidden;
    }


    .main-press-content-section .press-item .outer {
        width: 100%;
        height:100%;
        --r: 17px;
        --w: 65px;
        --h: 75px;
        --o: 11px;
        --ofs: calc(-1 * var(--o));
        --sz: calc(var(--r) + var(--o));
        --img: radial-gradient(circle at left bottom, transparent var(--r), white var(--r));
        border-radius: var(--r);
        background-color: transparent;
        background-image: var(--img), var(--img);
        background-position: calc(106% + var(--ofs)) var(--h), /* vertical edge of notch */ calc(100% - var(--w)) var(--ofs);
        background-size: var(--sz) var(--sz);
        background-repeat: no-repeat;
        position: absolute;
        top: 0;
        opacity:0;
        transform: translate(66px, -70px);
        transition: width 0.3s ease, height 0.3s ease, transform 0.2s ease;
        z-index:1;
    }

    .main-press-content-section .press-item:hover .outer{
        opacity:1;
        transform: translate(0, 0);
    }
    /* small rounded box in the top-right */
    .main-press-content-section .press-item .inner {
        width: var(--w);
        height: var(--h);
        outline: var(--o) solid white;
        border-radius: inherit;
        background: white;

        position: absolute;
        top: 0;
        right: 0;    /* <- move to right */
        left: auto;
        transition: width 0.3s ease, height 0.3s ease 0.1s;
    }
    .main-press-content-section .press-item .inner:before{
        content:"";
        position:absolute;
        background-image: url(https://cdn.shopify.com/s/files/1/0457/1099/9709/files/arrow-up-right.svg?v=1763347796);
        background-size: 22px;
        background-repeat: no-repeat;
        background-position: center;
        height: 100%;
        width: 100%;
        transform: translate(-70px, 70px);
        opacity:0;
        transition: opacity 0.3s ease 0.1s, transform 0.3s ease 0.3s;
    }
    .main-press-content-section .press-item:hover .inner:before {
        transform: translate(0, 0);
        opacity:1;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .main-press-content-section .press-item{
            padding: 10px;
            padding-bottom: 20px;
            border-radius: 10px;
        }
        .main-press-content-section .press-item .press-logo .press-logo-container{
            width:36px;
            height:36px;
            border-radius:36px;
        }
        .main-press-content-section .press-item .outer {
            width: 100%;
            height:100%;
            --r: 15px;
            --w: 45px;
            --h: 55px;
        }
        .main-press-content-section .press-item .featured-image:before{
            width:45px;
            height:55px;
        }
        .main-press-content-section .press-item .inner:before{
            background-size: 18px;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

    /* MOBILES ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 0px) {
        .main-press-content-section .press-item .featured-image{
            height:210px;
        }
    }
    @media only screen and (min-width: 375px) {
        .main-press-content-section .press-item .featured-image{
            height:210px;
        }
    }
    @media only screen and (min-width: 390px) {
        .main-press-content-section .press-item .featured-image{
            height:210px;
        }
    }
    @media only screen and (min-width: 414px) {
        .main-press-content-section .press-item .featured-image{
            height:210px;
        }
    }
    @media only screen and (min-width: 428px) {
        .main-press-content-section .press-item .featured-image{
            height:220px;
        }
    }
    @media only screen and (min-width: 480px) {
        .main-press-content-section .press-item .featured-image{
            height:230px;
        }
    }

    /* TABLETS ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 768px) {
        .main-press-content-section .press-item .featured-image{
            height:260px;
        }
    }


    /* LAPTOPS --------------------------------------------------------------------------------- */

    @media only screen and (min-width: 1280px) {
        .main-press-content-section .press-item .featured-image{
            height:270px;
        }
    }
    @media only screen and (min-width: 1366px) {
        .main-press-content-section .press-item .featured-image{
            height:280px;
        }
    }
    @media only screen and (min-width: 1440px) {
        .main-press-content-section .press-item .featured-image{
            height:280px;
        }
    }
    @media only screen and (min-width: 1536px) {
        .main-press-content-section .press-item .featured-image{
            height:290px;
        }
    }
    @media only screen and (min-width: 1600px) {
        .main-press-content-section .press-item .featured-image{
            height:290px;
        }
    }

    /* COMPUTERS --------------------------------------------------------------------------------- */
    @media only screen and (min-width: 1920px) {
        .main-press-content-section .press-item .featured-image{
            height:300px;
        }
    }
    @media only screen and (min-width: 2560px) {
        .main-press-content-section .press-item .featured-image{
            height:300px;
        }
    }





{% endstyle %}
<div class="container section-content">
    <div class="pp-bold title-sm f-black text-center" data-aos="fade-up" data-aos-easing="ease" data-aos-delay="150" data-aos-duration="500">
        {{ section.settings.heading }}
    </div>
    <div class="tab-list-container" data-aos="fade-up" data-aos-easing="ease" data-aos-delay="200" data-aos-duration="500">
        <div class="tab-list-inner-container">
            <div class="tab-item active" data-tab="media-feature">
                <span class="pp-semibold body-lg">
                    Media Feature
                </span>
            </div>
            <div class="tab-item" data-tab="news">
                <span class="pp-semibold body-lg">
                    News
                </span>
            </div>
        </div>
    </div>
    <div class="tab-content-list-container mt-lg-5 mt-md-5 mt-sm-4">
        <div class="tab-content-item" data-tab="media-feature">
            <div class="row">
                {% assign press_all = shop.metaobjects['press'].values | sort: 'created_at'   %}
                {% assign press_media_feature = press_all | where: '_category', 'Media Feature' %}
                {% for entries in press_media_feature %}
                    <div class="col-lg-4 col-md-4 col-sm-12">
                        {% render 'press-item', entries: entries %}
                    </div>
                {% endfor %}    
            </div>
        </div>
        <div class="tab-content-item" data-tab="news" style="display:none;">
            <div class="row">
                {% assign press_all = shop.metaobjects['press'].values | sort: 'created_at'   %}
                {% assign press_media_feature = press_all | where: '_category', 'News' %}
                {% for entries in press_media_feature %}
                    <div class="col-lg-4 col-md-4 col-sm-12">
                        {% render 'press-item', entries: entries %}
                    </div>
                {% endfor %}    
            </div>


        </div>
    </div>

</div>
{% schema %}
{
    "class": "main-press-content-section",
    "name": "Press Content",
    "limit": 1,
    "templates": ["page"],
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Venustas Newsroom"
        }
    ],
    "presets": [
        {
            "name": "Press Content"
        }
    ]
}
{% endschema %}