{% style %}
    .main-article-section{

    }
    .main-article-section .top-detail{
        background: #F9F6EF;
        padding-bottom:100px;
    }
    
    .main-article-section .sticky-article-tag{
        position:sticky;
        top:0;
    }
    .main-article-section .share-content-corner .social-container{
        display:inline-block;
        width:100%;
    }
    .main-article-section .share-content-corner .social-container a{
        width:fit-content;
    }
    .main-article-section .share-content-corner .social-container .social-icon img{
        width:fit-content;
        height:35px;
        display:inline-block;
        object-fit:contain;
        margin-right:15px;
        margin-bottom:10px;
    }
    .main-article-section .share-content-corner .social-container .social-icon:nth-child(2) img{
        width:30px;
        height:30px;
    }

    .main-article-section .article-tags-container{
        display:flex;
        flex-direction:column;
    }
    .main-article-section .article-tags-container .list-tags-container{
        display: inline-block;
    }

    .main-article-section .article-tags-container .list-tags-container .tags-item{
        padding: 6px 15px;
        color: #FFF;
        background: #B93205;
        border-radius: 4px;
        display: inline;
        align-items: center;
        margin-right: 10px;
        line-height: normal;
    }

    .main-article-section .list-article-tags {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .main-article-section .list-article-tags .list-article-item {
        padding: 12px 0px;
        border-top: 1px solid #CCCCCC;
        color: #656565;
    }

    .main-article-section .list-article-tags .list-article-item.active {
        color: #B93205;
    }

    .main-article-section .list-article-tags .list-article-item:last-child {
        border-bottom: 1px solid #CCCCCC;
    }


    /* MAIN CONTENT */
    
    .main-article-section .main-content{
        
    }
    .main-article-section .main-content .article-content p{
        margin-bottom:15px;
    }
    .main-article-section .main-content .article-content a{
        font-size:16px;
    }
    .main-article-section .main-content .article-content h1{
        font-size:28px;
        margin-bottom:15px;
    }
    .main-article-section .main-content .article-content h2{
        font-size:26px;
        margin-bottom:15px;
    }
    .main-article-section .main-content .article-content h3{
        font-size:24px;
        margin-bottom:15px;
    }
    .main-article-section .main-content .article-content h4{
        font-size:22px;
        margin-bottom:15px;
    }
    .main-article-section .main-content .article-content h5{
        font-size:20px;
        margin-bottom:15px;
    }
    .main-article-section .main-content .article-content h6{
        font-size:18px;
        margin-bottom:15px;
    }
    .main-article-section .main-content .article-content ul{
        padding-left:20px;
        padding-right:20px;
    }

    .main-article-section .main-content .article-content img{
        width:100%;
        height:100%;
        object-fit:contain;
        margin-bottom:15px;
    }
    .main-article-section .main-content .row{
        --bs-gutter-x: 40px;
    }

    .main-article-section .article-featured-image{
        margin-top:-150px;
        margin-bottom: 20px;
    }

    .main-article-section .article-featured-image img{
        width:100%;
        height:100%;
        object-fit:contain;
    }
    .main-article-section .author-corner .author-heading{
        border-bottom: 1px solid #CCCCCC;
    }
    .main-article-section .author-corner .row{
        --bs-gutter-x: 20px;
    }
    .main-article-section .author-corner .author-image{
        height:120px;
        width:100%;
        border-radius: 10px;
        overflow: hidden;
    }
    .main-article-section .author-corner .author-image img{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .main-article-section .author-corner .author-image .author-placeholder{
        width:100%;
        height:100%;
        display:flex;
        align-items:center;
        justify-content:center;
        background: #B93205;
        color:#FFF;
        font-size:42px;
        line-height:1;
        text-transform:uppercase;
    }

    
    .main-article-section .featured-product .featured-product-heading{
        border-bottom: 1px solid #CCCCCC;
    }

    .main-article-section .main-content .nav-article-image{
        height:65px;
        width:100%;
        overflow:hidden;
        border-radius:2px;
    }
    .main-article-section .main-content .bottom-article-nav {
        margin-top:30px;
        border-top: 1px solid #D3D3D3;
        border-bottom: 1px solid #D3D3D3;
    }
    .main-article-section .main-content .bottom-article-nav .row{
        --bs-gutter-x: 20px;
    }
    .main-article-section .main-content .bottom-article-nav .prev-article-btn{
        border-right: 1px solid #D3D3D3;
        padding-top:10px;
        padding-bottom:10px;
    }
    .main-article-section .main-content .bottom-article-nav .next-article-btn{
        padding-top:10px;
        padding-bottom:10px;
    }
    .main-article-section .main-content .bottom-article-nav .prev-article-btn .row,
    .main-article-section .main-content .bottom-article-nav .next-article-btn .row{
        --bs-gutter-x: 10px;
    }
    .main-article-section .main-content .nav-article-image img{
        width:100%;
        height:100%;
        object-fit:cover;
        transition: all 0.3s ease;
    }
    .main-article-section .main-content .nav-article-image:hover img{
        transform:scale(1.2);
    }
    .main-article-section .product-item .product-image .badge.sale-badge span{
        padding:3px 7px;
        font-size:9px;
    }
    .main-article-section .product-item .product-image .badge.sale-badge{
        left:10px;
        top:10px;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .main-article-section .main-content .article-content h2{
            font-size:20px;
        }
        .main-article-section .float-nav button{
            --btn-pos:-10px;
        }
        .main-article-section .float-nav{
            top:160px;
        }
    }

    /* ipad Air */
