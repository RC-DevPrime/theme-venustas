{% style %}
    .support-icon-item{
        display:flex;
        flex-direction:column;
        gap:15px;
        flex:1;
        border-radius:4px;
    }
    .support-icon-item .icon{
        width:40px;
        height:40px;
        object-fit:contain;
        margin:auto;
    }
    .footer-icon-list-slider .block-heading{
        font-size:10px;
    }
    .footer-icon-list-slider .support-icon-item .icon{
        width:30px;
        height:30px;
    }
    .footer-icon-list-slider .swiper-pagination{
        position:unset;
    }
    .footer-icon-list-slider .swiper-pagination .swiper-pagination-bullet{
        width:10px;
        height:4px;
        border-radius:4px;
    }
    .footer-icon-list-slider .swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active{
        width:20px;
        background:#B93205;
    }
{% endstyle %}
<div class="container section-content pb-lg-5 pb-md-4 pb-sm-4 pt-lg-4 pt-md-4 pt-sm-4">
    <div class="d-lg-block d-md-block d-sm-none">
        <div class="row">
            {% for block in section.blocks %}
                <div class="support-icon-item">
                    <img src="{{ block.settings.logo | img_url: 'master' }}" width="100%" height="100%" class="icon" alt="support-icon-{{ block.settings.logo.alt }}">
                    <div class="block-heading pp-regular body-lg f-black text-center">
                        {{ block.settings.heading }}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="footer-icon-list-slider d-lg-none d-md-none d-sm-block ">
        <div class="swiper-wrapper">
            {% for block in section.blocks %}
                <div class="swiper-slide">
                    <div class="support-icon-item">
                        <img src="{{ block.settings.logo | img_url: 'master' }}" width="100%" height="100%" class="icon" alt="support-icon-{{ block.settings.logo.alt }}">
                        <div class="block-heading pp-regular f-black text-center">
                            {{ block.settings.heading }}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination"></div>
    </div>
</div>
{% schema %}
{
    "class": "logo-slider-section position-relative overflow-hidden",
    "name": "Support Icon List",
    "blocks": [
        {
            "type": "logo",
            "name": "Logo",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "logo",
                    "label": "Logo"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading"
                },
            ]
        },
    ],
    "presets": [
        {
            "name": "Support Icon List"
        }
    ]
}
{% endschema %}