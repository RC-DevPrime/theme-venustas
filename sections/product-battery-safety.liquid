{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .product-battery-safety {
    width: 100%;
    color: {{ section.settings.text_color }};
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__container {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 100px;
    width: min(100% - 40px, 1240px);
    max-width: 1240px;
    margin: 160px auto;
    height: 445px;
    min-height: 445px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__copy-top,
  #shopify-section-{{ section.id }} .product-battery-safety__copy-bottom {
    position: relative;
    z-index: 2;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__title {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 28px;
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__title--accent {
    color: var(--color-brand, #B93205);
  }

  #shopify-section-{{ section.id }} .product-battery-safety__safety-title {
    margin: 0 0 32px;
    color: {{ section.settings.accent_color }};
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__certificates {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-bottom: 56px;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__certificate {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__certificate img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 42px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__warranty {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    width: 490px;
    max-width: 100%;
    padding: 22px 24px;
    border: 1px solid #65D6FF;
    border-radius: 8px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__warranty-icon {
    width: 52px;
    height: 52px;
    color: #fff;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__warranty-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__warranty-title {
    margin: 0 0 4px;
    color: #fff;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__description {
    color: rgba(255, 255, 255, 0.86);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__wrapper {
    position: relative;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__image {
    position:absolute;
    top:0;
    width: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__image--mobile {
    display: none;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-battery-safety__container {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      width: 100%;
      height: auto;
      min-height: auto;
      padding: 40px 20px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__copy-top {
      order: 1;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__copy-bottom {
      order: 3;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__title {
      font-size: 24px;
      line-height: 1.18;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__safety-title {
      margin: 0 0 12px;
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__image--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__image--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__certificates {
      justify-content: space-between;
      width: 100%;
      gap: 8px;
      margin-bottom: 20px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__certificate {
      flex: 0 1 auto;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__certificate img {
      max-height: 34px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__warranty {
      grid-template-columns: 46px minmax(0, 1fr);
      gap: 12px;
      width: 100%;
      margin-top: 0;
      padding: 16px;
      border-radius: 8px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__warranty-icon {
      width: 46px;
      height: 46px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__warranty-title {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__description {
      font-size: 14px;
      line-height: 1.35;
    }
  }
{% endstyle %}

<section class="product-battery-safety">
  {% if section.settings.desktop_image != blank or section.settings.mobile_image != blank %}
    <div class="product-battery-safety__wrapper">
      {% if section.settings.desktop_image != blank %}
        {{
          section.settings.desktop_image
          | image_url: width: 1200
          | image_tag:
            class: 'product-battery-safety__image product-battery-safety__image--desktop',
            loading: 'lazy',
            widths: '500, 700, 900, 1200',
            sizes: '(min-width: 1240px) 650px, 52vw',
            alt: section.settings.desktop_image.alt
        }}
      {% endif %}

      {% if section.settings.mobile_image != blank %}
        {{
          section.settings.mobile_image
          | image_url: width: 1000
          | image_tag:
            class: 'product-battery-safety__image product-battery-safety__image--mobile',
            loading: 'lazy',
            widths: '360, 540, 750, 1000',
            sizes: 'calc(100vw - 40px)',
            alt: section.settings.mobile_image.alt
        }}
      {% elsif section.settings.desktop_image != blank %}
        {{
          section.settings.desktop_image
          | image_url: width: 1000
          | image_tag:
            class: 'product-battery-safety__image product-battery-safety__image--mobile',
            loading: 'lazy',
            widths: '360, 540, 750, 1000',
            sizes: 'calc(100vw - 40px)',
            alt: section.settings.desktop_image.alt
        }}
      {% endif %}
    </div>
  {% endif %}
  <div class="product-battery-safety__container">
    <div class="product-battery-safety__copy-top">
      {% if section.settings.title != blank %}
        <h2 class="product-battery-safety__title product-battery-safety__title--accent">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.title_second != blank %}
        <h2 class="product-battery-safety__title">
          {{ section.settings.title_second }}
        </h2>
      {% endif %}
    </div>

    

    <div class="product-battery-safety__copy-bottom">
      {% if section.settings.safety_title != blank %}
        <h3 class="product-battery-safety__safety-title">
          {{ section.settings.safety_title }}
        </h3>
      {% endif %}

      <div class="product-battery-safety__certificates">
        {% for block in section.blocks %}
          {% if block.settings.icon != blank %}
            <div
              class="product-battery-safety__certificate"
              {{ block.shopify_attributes }}
            >
              {{
                block.settings.icon
                | image_url: width: 160
                | image_tag:
                  loading: 'lazy',
                  widths: '60, 90, 120, 160',
                  sizes: '(max-width: 749px) 60px, 72px',
                  alt: block.settings.icon.alt
              }}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.warranty_title != blank or section.settings.description != blank %}
        <div class="product-battery-safety__warranty">
          <span class="product-battery-safety__warranty-icon" aria-hidden="true">
            <svg width="52" height="52" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M26 5.5L44 12.25V25.7C44 37.05 36.35 45.2 26 48C15.65 45.2 8 37.05 8 25.7V12.25L26 5.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M22.4 29.7C22.4 29.7 23.9 27.7 26 27.7C28.1 27.7 29.6 29.7 29.6 29.7M23.2 21.2H23.22M28.8 21.2H28.82M36 24.8C36 30.3228 31.5228 34.8 26 34.8C20.4772 34.8 16 30.3228 16 24.8C16 19.2772 20.4772 14.8 26 14.8C31.5228 14.8 36 19.2772 36 24.8Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <div class="product-battery-safety__warranty-copy">
            {% if section.settings.warranty_title != blank %}
              <h4 class="product-battery-safety__warranty-title">{{ section.settings.warranty_title }}</h4>
            {% endif %}
            {% if section.settings.description != blank %}
              <div class="product-battery-safety__description">
                {{ section.settings.description }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product battery safety",
  "tag": "section",
  "class": "product-battery-safety-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#151A22"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Safety title color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Accent title",
      "default": "TESTED FOR SAFETY."
    },
    {
      "type": "text",
      "id": "title_second",
      "label": "Second title",
      "default": "BUILT TO LAST."
    },
    {
      "type": "text",
      "id": "safety_title",
      "label": "Safety title",
      "default": "7 Safety Certifications"
    },
    {
      "type": "text",
      "id": "warranty_title",
      "label": "Warranty title",
      "default": "1-Year Battery Warranty"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Warranty description",
      "default": "<p>Reliable support for your Venustas heated apparel power system.</p>"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop battery image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile battery image"
    }
  ],
  "blocks": [
    {
      "type": "certificate",
      "name": "Certificate icon",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Certificate icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product battery safety",
      "blocks": [
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        }
      ]
    }
  ]
}
{% endschema %}
