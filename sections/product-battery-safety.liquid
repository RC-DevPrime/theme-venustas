{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .product-battery-safety {
    width: 100%;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .product-battery-safety__container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 1240px;
    min-height: 445px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__content {
    position: relative;
    z-index: 2;
    flex: 0 0 56%;
    max-width: 620px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__title {
    margin: 0 0 20px;
    color: {{ section.settings.text_color }};
    font-size: 28px;
    font-weight: 700;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__safety-title {
    margin: 0 0 18px;
    color: {{ section.settings.accent_color }};
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__description {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 16px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__description p {
    margin: 0 0 10px;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__description p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__certificates {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 28px;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__certificate {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 72px;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__certificate img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 46px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__image-wrapper {
    position: absolute;
    top: 50%;
    right: 0;
    width: 44%;
    transform: translateY(-50%);
    text-align: right;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__image {
    display: block;
    width: 100%;
    height: auto;
    margin-left: auto;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .product-battery-safety__image--mobile {
    display: none;
  }

  @media screen and (max-width: 1279px) {
    #shopify-section-{{ section.id }} .product-battery-safety__container {
      padding-right: 20px;
      padding-left: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .product-battery-safety__container {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: auto;
      padding: 40px 20px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__content {
      display: contents;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__title {
      order: 1;
      margin-bottom: 16px;
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__safety-title {
      order: 2;
      margin-bottom: 20px;
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__image-wrapper {
      position: static;
      order: 3;
      width: 100%;
      margin-bottom: 24px;
      transform: none;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__image {
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__image--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__image--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__description {
      order: 4;
      width: 100%;
      font-size: 16px;
      line-height: 1.6;
      text-align: justify;
      text-align-last: left;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__certificates {
      order: 5;
      justify-content: space-between;
      width: 100%;
      gap: 12px;
      margin-top: 24px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__certificate {
      flex: 1 1 0;
      min-width: 0;
      max-width: 60px;
    }

    #shopify-section-{{ section.id }} .product-battery-safety__certificate img {
      max-height: 40px;
    }
  }
{% endstyle %}

<section class="product-battery-safety">
  <div class="product-battery-safety__container">
    <div class="product-battery-safety__content">
      {% if section.settings.title != blank %}
        <h2 class="product-battery-safety__title">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.safety_title != blank %}
        <h3 class="product-battery-safety__safety-title">
          {{ section.settings.safety_title }}
        </h3>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="product-battery-safety__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="product-battery-safety__certificates">
        {% for block in section.blocks %}
          {% if block.settings.icon != blank %}
            <div
              class="product-battery-safety__certificate"
              {{ block.shopify_attributes }}
            >
              {{
                block.settings.icon
                | image_url: width: 160
                | image_tag:
                  loading: 'lazy',
                  widths: '60, 90, 120, 160',
                  sizes: '(max-width: 749px) 60px, 72px',
                  alt: block.settings.icon.alt
              }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if section.settings.desktop_image != blank or section.settings.mobile_image != blank %}
      <div class="product-battery-safety__image-wrapper">
        {% if section.settings.desktop_image != blank %}
          {{
            section.settings.desktop_image
            | image_url: width: 1200
            | image_tag:
              class: 'product-battery-safety__image product-battery-safety__image--desktop',
              loading: 'lazy',
              widths: '500, 700, 900, 1200',
              sizes: '(min-width: 1240px) 546px, 44vw',
              alt: section.settings.desktop_image.alt
          }}
        {% endif %}

        {% if section.settings.mobile_image != blank %}
          {{
            section.settings.mobile_image
            | image_url: width: 1000
            | image_tag:
              class: 'product-battery-safety__image product-battery-safety__image--mobile',
              loading: 'lazy',
              widths: '360, 540, 750, 1000',
              sizes: 'calc(100vw - 40px)',
              alt: section.settings.mobile_image.alt
          }}
        {% elsif section.settings.desktop_image != blank %}
          {{
            section.settings.desktop_image
            | image_url: width: 1000
            | image_tag:
              class: 'product-battery-safety__image product-battery-safety__image--mobile',
              loading: 'lazy',
              widths: '360, 540, 750, 1000',
              sizes: 'calc(100vw - 40px)',
              alt: section.settings.desktop_image.alt
          }}
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Product battery safety",
  "tag": "section",
  "class": "product-battery-safety-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#151A22"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Safety title color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Advanced Battery Safety"
    },
    {
      "type": "text",
      "id": "safety_title",
      "label": "Safety title",
      "default": "7 Safety Protections"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Built-in protection against overcharging, over-discharging, overcurrent, short circuits, overvoltage, overheating, and power surges.</p>"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop battery image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile battery image"
    }
  ],
  "blocks": [
    {
      "type": "certificate",
      "name": "Certificate icon",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Certificate icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product battery safety",
      "blocks": [
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        },
        {
          "type": "certificate"
        }
      ]
    }
  ]
}
{% endschema %}