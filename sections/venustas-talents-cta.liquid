{% render 'v-talents-base-css', section: section %}
{% render 'v-talents-layout-css', section: section %}

<style>
  #shopify-section-{{ section.id }} .v-talents-cta__header {
    text-align: center;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .v-talents-cta__title {
    font-size: clamp(26px, 2.8vw, 40px);
    font-weight: 700;
    margin: 0 0 12px;
    color: var(--v-brand);
  }

  #shopify-section-{{ section.id }} .v-talents-cta__subtitle {
    font-size: 15px;
    color: #555;
    margin: 0;
    line-height: 1.6;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .v-talents-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>

<div class="v-talents-cta">
  <div class="v-talents-master-container">
    <div class="v-talents-cta__header">
      {%- if section.settings.cta_heading != blank -%}
        <h2 class="v-talents-cta__title">{{ section.settings.cta_heading }}</h2>
      {%- endif -%}
      {%- if section.settings.cta_subheading != blank -%}
        <p class="v-talents-cta__subtitle">{{ section.settings.cta_subheading }}</p>
      {%- endif -%}
    </div>
    <div class="v-talents-cta__actions">
      {% render 'v-talents-powr-buttons', section: section, outline_style: 'brand', use_hero_modals: true %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Talents — CTA",
  "tag": "section",
  "class": "venustas-talents-cta-section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "brand_color", "label": "Brand color", "default": "#B93205" },
    { "type": "range", "id": "container_width_desktop", "min": 70, "max": 100, "step": 5, "unit": "%", "label": "Desktop container width", "default": 90 },
    { "type": "range", "id": "container_width_mobile", "min": 80, "max": 100, "step": 5, "unit": "%", "label": "Mobile container width", "default": 95 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Desktop padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Desktop padding bottom", "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile padding top", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile padding bottom", "default": 32 },
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Heading",
      "default": "Ready to Join the Program?"
    },
    {
      "type": "textarea",
      "id": "cta_subheading",
      "label": "Subheading",
      "default": "Apply today to become a Venustas UGC creator, or claim your rewards if you're already in the program."
    },
    { "type": "header", "content": "Buttons" },
    {
      "type": "paragraph",
      "content": "Buttons open the same POWR popups as Talents Hero. Configure forms in the Hero section."
    },
    {
      "type": "text",
      "id": "hero_btn_apply_label",
      "label": "Apply button label",
      "default": "APPLY NOW"
    },
    {
      "type": "text",
      "id": "hero_btn_rewards_label",
      "label": "Rewards button label",
      "default": "CLAIM REWARDS"
    }
  ],
  "presets": [{ "name": "Talents — CTA", "category": "Venustas Talents" }]
}
{% endschema %}
