{% style %}
  #shopify-section-{{ section.id }} .heatingP-video {
    background: #fff;
    color: var(--venustas-black, #1a1a1a);
    padding: 120px 0 80px;
  }

  #shopify-section-{{ section.id }} .heatingP-video__list {
    display: flex;
    width: min(calc(100% - 40px), 1340px);
    margin: 0 auto;
    gap: 16px;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .heatingP-video__card {
    min-width: 0;
    flex: 1 1 0;
  }

  #shopify-section-{{ section.id }} .heatingP-video__media {
    height: 258px;
    overflow: hidden;
    background: #f1f1f1;
    transition: height .28s ease;
  }

  #shopify-section-{{ section.id }} .heatingP-video__card:hover .heatingP-video__media {
    height: 300px;
  }

  #shopify-section-{{ section.id }} .heatingP-video__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .heatingP-video__copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 20px;
  }

  #shopify-section-{{ section.id }} .heatingP-video__title,
  #shopify-section-{{ section.id }} .heatingP-video__description {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heatingP-video__title {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .heatingP-video__description {
    font-size: 14px;
    line-height: 1.45;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingP-video {
      padding: 40px 0;
    }

    #shopify-section-{{ section.id }} .heatingP-video__list {
      width: calc(100% - 40px);
      margin-left: 20px;
      margin-right: 0;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
    }

    #shopify-section-{{ section.id }} .heatingP-video__list::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .heatingP-video__card {
      width: calc((100vw - 48px) / 1.2);
      flex: 0 0 calc((100vw - 48px) / 1.2);
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .heatingP-video__media {
      height: auto;
      aspect-ratio: 4 / 3;
    }

    #shopify-section-{{ section.id }} .heatingP-video__card:hover .heatingP-video__media {
      height: auto;
    }

    #shopify-section-{{ section.id }} .heatingP-video__copy {
      min-height: 121px;
      gap: 4px;
      padding-top: 20px;
    }

    #shopify-section-{{ section.id }} .heatingP-video__title {
      font-size: 15px;
      font-weight: 600;
      line-height: 1.68;
      letter-spacing: -.15px;
    }

    #shopify-section-{{ section.id }} .heatingP-video__description {
      font-size: 13.5px;
      line-height: 1.68;
    }
  }

  @media only screen and (min-width: 768px) and (max-width: 1280px) {
    #shopify-section-{{ section.id }} .heatingP-video {
      padding-top: 80px;
      padding-bottom: 60px;
    }

    #shopify-section-{{ section.id }} .heatingP-video__list {
      width: calc(100% - 40px);
      overflow-x: auto;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .heatingP-video__list::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .heatingP-video__card {
      width: calc(2.479vw + 371px);
      flex: 0 0 calc(2.479vw + 371px);
    }
  }

  @media only screen and (min-width: 500px) and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heatingP-video__card {
      width: calc(2.479vw + 371px);
      flex-basis: calc(2.479vw + 371px);
    }
  }
{% endstyle %}

<section class="heatingP-video" id="heatingp-videos">
  <div class="heatingP-video__list">
    {%- for block in section.blocks -%}
      <article class="heatingP-video__card" {{ block.shopify_attributes }}>
        <div class="heatingP-video__media">
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: class: 'heatingP-video__video', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
          {%- endif -%}
        </div>
        <div class="heatingP-video__copy">
          {%- if block.settings.title != blank -%}
            <h3 class="heatingP-video__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="heatingP-video__description">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "HeatingP Video",
  "tag": "section",
  "class": "heatingP-video-section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "video_card",
      "name": "Video card",
      "settings": [
        { "type": "video", "id": "video", "label": "MP4 video" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HeatingP Video",
      "blocks": [
        {
          "type": "video_card",
          "settings": {
            "title": "Put to the Test by Riders Who Know Their Gear",
            "description": "An experienced rider wires the Apex™ system into his bike and takes it out on a cold ride: the Y cable install, how the heat holds up at speed, and how the liners fit under full riding gear."
          }
        },
        {
          "type": "video_card",
          "settings": {
            "title": "How to Set Up Your Apex™ System",
            "description": "Connect the Y cable to your bike’s battery once, plug in the liner and press the button. This walkthrough covers the jacket, the pants, and running both on a single lead with the 3-Way cable."
          }
        },
        {
          "type": "video_card",
          "settings": {
            "title": "What Riders Are Saying",
            "description": "Real riders, real cold mornings. Hear from riders about their first rides with Apex™: what they noticed, what surprised them, and what they’d tell a friend."
          }
        }
      ]
    }
  ]
}
{% endschema %}
