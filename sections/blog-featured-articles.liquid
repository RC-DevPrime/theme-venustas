{% style %}
    .blog-featured-articles-section .featured-article-item{
        height:500px;
        border-radius: 16px 16px 16px 16px;
        overflow:hidden;
        position:relative;
        transition: all 0.3s ease;
    }
    .blog-featured-articles-section .featured-article-item:hover img{
        transform: scale(1.2);
    }
    .blog-featured-articles-section .featured-article-item img{
        transition: all 0.3s ease;
    }
    .blog-featured-articles-section .featured-article-item .featured-image-bg{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .blog-featured-articles-section .featured-article-item .article-content{
        position:absolute;
        top:0;
        left:0;
        width:100%;
        height:100%;
        padding:20px;
        display:flex;
        flex-direction:column;
        justify-content: flex-end;
        background: linear-gradient(0deg, rgba(0, 0, 0, 0.67) 0%, rgb(255 255 255 / 0%) 100%);
    }

    .blog-featured-articles-section .float-nav{
        max-width:1150px;
    }
    .blog-featured-articles-section .float-nav button{
        background: #F1EADD;
    }
    .blog-featured-articles-section .float-nav button:hover{
        background: #B93205;
    }
    .blog-featured-articles-section .float-nav button:hover i{
        color: #FFF;
    }
    .blog-featured-articles-section .float-nav button i{
        color: #B93205;
    }
    .blog-featured-articles-section .swiper-pagination{
        margin-top:20px;
    }
    .blog-featured-articles-section .article-tag{
        position: absolute;
        left: 1rem;
        top: 1rem;
        background: #B93205;
        border-radius: 4px 4px 4px 4px;
        padding: 4px 15px;
        line-height: normal;
        font-size: 14px;
        color: #FFF;
        z-index: 1;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .blog-featured-articles-section .featured-article-item{
            border-radius: 0px;
            height:fit-content;
        }
        .blog-featured-articles-section .featured-article-item img{
            height:400px;
        }
        .blog-featured-articles-section .float-nav{
            top:30%;
        }
        .blog-featured-articles-section .float-nav button{
            --btn-pos: 0px;
        }
        .blog-featured-articles-section .featured-article-item .article-content{
            position:relative;
            background:unset;
            padding:10px 0px;
        }
        .blog-featured-articles-section .featured-article-item .article-image-container {
            border-radius: 8px;
            overflow:hidden;
        }
    }

    /* ipad Air */
    @media only screen 
    and (min-device-width : 768px) 
    and (max-device-width : 1024px){
    }

{% endstyle %}
<div class="section-content overflow-hidden">
    <div class="section-heading pp-bold text-center pb-lg-4 pb-md-4 pb-sm-3">
        <span class="pretitle-xl d-lg-block d-md-block d-sm-none">
            {{ section.settings.heading }}
        </span>
        <span class="title-sm d-lg-none d-md-none d-sm-block">
            {{ section.settings.heading }}
        </span>
    </div>

    <div class="featured-article-slider position-relative">
        <div class="swiper-wrapper">
            {% for block in section.blocks %}
                <div class="swiper-slide">
                    {% render 'featured-article-item', article: block.settings.article %}
                </div>
            {% endfor %}
        </div>
        <div class="float-nav d-lg-flex d-md-flex d-sm-flex gap-lg-3 gap-md-3 gap-sm-2">
            <button type="button" class="owl-prev" disabled>
                <i class="fa-solid fa-chevron-left f-white"></i>
            </button>
            <button type="button" class="owl-next" disabled>
                <i class="fa-solid fa-chevron-right f-white"></i>
            </button>
        </div>
        <div class="swiper-pagination"></div>
    </div>
</div>
{% schema %}
    {
        "class": "blog-featured-articles-section",
        "name": "Blog Featured Articles",
        "templates": ["blog","product"],
        "limit": 1, 
        "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Featured Articles"
            },
        ],
        "blocks": [
            {
                "type": "article",
                "name": "Article",
                "settings": [
                    {
                        "type": "article",
                        "id": "article",
                        "label": "Article"
                    }
                ]
            }
        ],
        "presets" :[{
            "name" : "Blog Featured Articles"
        }]
    }
  {% endschema %} 