{% style %}
  #shopify-section-{{ section.id }} .heating-layer-stack {
    width: 100%;
    overflow: hidden;
    background: #1a1a1a;
    color: #fff;
    font-family: 'Montserrat', sans-serif;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__inner {
    width: min(100% - 40px, 1340px);
    margin-left: auto;
    margin-right: auto;
    padding: 80px 0 50px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__header {
    max-width: 760px;
    margin: 0 auto 122px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__heading {
    margin: 0 0 16px;
    color: #fff;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__description {
    margin: 0;
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__body {
    display: grid;
    grid-template-columns: minmax(0, 620px) 636px;
    align-items: center;
    gap: 64px;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__list {
    display: grid;
    row-gap: 32px;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 160px;
    align-items: center;
    gap: 32px;
    min-height: 160px;
    padding: 16px 0;
    border-bottom: 1px solid #2A2A2A;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__item-title {
    margin: 0 0 4px;
    color: #fff;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__item--highlight .heating-layer-stack__item-title,
  #shopify-section-{{ section.id }} .heating-layer-stack__item--highlight .heating-layer-stack__item-subtitle {
    color: var(--color-brand);
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__item-subtitle {
    margin: 0 0 6px;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__item-description {
    max-width: 395px;
    margin: 0;
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__item-media {
    width: 160px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__item-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__feature {
    position: relative;
  }

  #shopify-section-{{ section.id }} .heating-layer-stack__feature-image {
    width: 636px;
    height: 640px;
    display: block;
    border-radius: 24px;
    object-fit: cover;
  }

  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .heating-layer-stack__inner {
      width: 100%;
      padding: 40px 20px 24px;
    }

    #shopify-section-{{ section.id }} .heating-layer-stack__header {
      max-width: none;
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .heating-layer-stack__heading {
      margin-bottom: 14px;
      font-size: 24px;
      line-height: 1.18;
    }

    #shopify-section-{{ section.id }} .heating-layer-stack__description {
      font-size: 16px;
      line-height: 1.35;
    }

    #shopify-section-{{ section.id }} .heating-layer-stack__body {
      display: block;
    }

    #shopify-section-{{ section.id }} .heating-layer-stack__list {
      width: 100%;
      row-gap: 0;
    }

    #shopify-section-{{ section.id }} .heating-layer-stack__item {
      width: 100%;
      grid-template-columns: minmax(0, 1fr) 118px;
      gap: 18px;
      min-height: 118px;
      padding: 16px 0;
    }

    #shopify-section-{{ section.id }} .heating-layer-stack__item-title {
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .heating-layer-stack__item-subtitle {
      margin-bottom: 8px;
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .heating-layer-stack__item-description {
      max-width: none;
      font-size: 14px;
      line-height: 1.18;
    }

    #shopify-section-{{ section.id }} .heating-layer-stack__item-media {
      width: 118px;
      height: 118px;
    }

    #shopify-section-{{ section.id }} .heating-layer-stack__feature {
      display: none;
    }
  }
{% endstyle %}

<section class="heating-layer-stack">
  <div class="heating-layer-stack__inner">
    <div class="heating-layer-stack__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="heating-layer-stack__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="heating-layer-stack__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="heating-layer-stack__body">
      <div class="heating-layer-stack__list">
        {%- for block in section.blocks -%}
          {%- render 'heating-layer-stack-item',
            block: block,
            highlight: block.settings.highlight,
            include_attributes: true
          -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.feature_image != blank -%}
        <div class="heating-layer-stack__feature">
          {{
            section.settings.feature_image
            | image_url: width: 1400
            | image_tag:
              class: 'heating-layer-stack__feature-image',
              loading: 'lazy',
              widths: '480,720,960,1200,1400',
              sizes: '(max-width: 767px) 0px, 636px',
              alt: section.settings.feature_image.alt | default: section.settings.heading
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Heating Layer Stack",
  "tag": "section",
  "class": "heating-layer-stack-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed To Layer Under Riding Gear"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Our heated gear is designed as a mid layer - focused on delivering core warmth. Your outer gear is for protection. Together, they keep you warm, safe, and comfortable on every ride.</p>"
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Feature image"
    }
  ],
  "blocks": [
    {
      "type": "layer",
      "name": "Layer",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Layer name",
          "default": "Base Layer"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Next to skin"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Moisture-wicking technical base layer keeps you dry and comfortable during active riding."
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Use theme color",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heating Layer Stack",
      "blocks": [
        {
          "type": "layer",
          "settings": {
            "title": "Base Layer",
            "subtitle": "Next to skin",
            "description": "Moisture-wicking technical base layer keeps you dry and comfortable during active riding."
          }
        },
        {
          "type": "layer",
          "settings": {
            "title": "Venustas Heated Layer",
            "subtitle": "Core warmth",
            "description": "Built-in heating elements deliver targeted warmth where you need it most.",
            "highlight": true
          }
        },
        {
          "type": "layer",
          "settings": {
            "title": "Protective Riding Gear",
            "subtitle": "Outer protection",
            "description": "Shields you from wind, rain, abrasion, and impact."
          }
        }
      ]
    }
  ]
}
{% endschema %}
