{% style %}
    .reward-icon-list-section{

    }
    .reward-icon-list-section .row{
        --bs-gutter-x: 2rem;
        --bs-gutter-y: 1rem;
    }
    .reward-icon-list-section .reward-icon-item {
        border-radius:16px;
        overflow:hidden;
        background-color:#F9F9F9;
    }
    .reward-icon-list-section .reward-icon-item img{
        width:100px;
        height:100px;
        object-fit:contain;
        margin:auto;
    }


    /* MOBILES ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 0px) {
        .reward-icon-list-section .reward-icon-item img{
            width:60px;
            height:60px;
        }
    }
    @media only screen and (min-width: 375px) {
        .reward-icon-list-section .reward-icon-item img{
            width:60px;
            height:60px;
        }
    }
    @media only screen and (min-width: 390px) {
        .reward-icon-list-section .reward-icon-item img{
            width:60px;
            height:60px;
        }
    }
    @media only screen and (min-width: 414px) {
        .reward-icon-list-section .reward-icon-item img{
            width:60px;
            height:60px;
        }
    }
    @media only screen and (min-width: 428px) {
        .reward-icon-list-section .reward-icon-item img{
            width:60px;
            height:60px;
        }
    }
    @media only screen and (min-width: 480px) {
        .reward-icon-list-section .reward-icon-item img{
            width:60px;
            height:60px;
        }
    }

    /* TABLETS ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 768px) {
        .reward-icon-list-section .reward-icon-item img{
            width:70px;
            height:70px;
        }
    }


    /* LAPTOPS --------------------------------------------------------------------------------- */

    @media only screen and (min-width: 1280px) {
        .reward-icon-list-section .reward-icon-item img{
            width:70px;
            height:70px;
        }
    }
    @media only screen and (min-width: 1366px) {
        .reward-icon-list-section .reward-icon-item img{
            width:70px;
            height:70px;
        }
    }
    @media only screen and (min-width: 1440px) {
        .reward-icon-list-section .reward-icon-item img{
            width:70px;
            height:70px;
        }
    }
    @media only screen and (min-width: 1536px) {
        .reward-icon-list-section .reward-icon-item img{
            width:80px;
            height:80px;
        }
    }
    @media only screen and (min-width: 1600px) {
        .reward-icon-list-section .reward-icon-item img{
            width:80px;
            height:80px;
        }
    }

    /* COMPUTERS --------------------------------------------------------------------------------- */
    @media only screen and (min-width: 1920px) {
        .reward-icon-list-section .reward-icon-item img{
            width:100px;
            height:100px;
        }
    }
    @media only screen and (min-width: 2560px) {
        .reward-icon-list-section .reward-icon-item img{
            width:100px;
            height:100px;
        }
    }


{% endstyle %}
<div class="container section-content">
    <h2 class="pp-bold title-sm text-center pb-lg-5 pb-md-5 pb-sm-4">
        {{ section.settings.heading }}
    </h2>
    <div class="reward-icon-container d-lg-block d-md-block d-sm-none">
        <div class="row justify-content-center">

            {% for block in section.blocks %}
                <div class="col-3">
                    <div class="reward-icon-item py-lg-5 py-md-5 py-sm-4 h-100 px-lg-0 px-md-0 px-sm-3 ">
                        <div class="d-flex align-items-center justify-content-center pb-lg-4 pb-md-4 pb-sm-0">
                            <img src="{{ block.settings.icon | img_url: '1400x1400' }}" width="100%" height="100%">
                        </div>
                        <div class="detail-content col-lg-9 col-md-9 col-sm-12 mx-auto">
                            <h4 class="pp-bold pretitle f-black text-center pb-lg-4 pb-md-4 pb-sm-3">
                                {{ block.settings.heading }}
                            </h4>
                            <p class="pp-regular body-lg f-black text-center">
                                {{ block.settings.description }}
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}

        </div>
    </div>

    <div class="reward-icon-container d-lg-none d-md-none d-sm-block">
        <div class="row justify-content-center">

            {% for block in section.blocks %}
                <div class="col-12">
                    <div class="reward-icon-item py-4 px-4 h-100 d-flex gap-4">
                        <div class="d-flex">
                            <img src="{{ block.settings.icon | img_url: '1400x1400' }}" width="100%" height="100%">
                        </div>
                        <div class="detail-content">
                            <h4 class="pp-bold body-lg f-black text-start pb-2">
                                {{ block.settings.heading }}
                            </h4>
                            <p class="pp-regular body f-black text-start">
                                {{ block.settings.description }}
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}

        </div>
    </div>
</div>
{% schema %}
    {
        "class": "reward-icon-list-section overflow-hidden",
        "name": "Reward Icon List",
        "limit": 1,
        "templates": ["page"],
        "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "How To Get It?"
            },
        ],
        "blocks": [
            {
                "type": "icon",
                "name": "Icon",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "icon",
                        "label": "Icon"
                    },
                    {
                        "type": "text",
                        "id": "heading",
                        "label": "Heading"
                    },
                    {
                        "type": "richtext",
                        "id": "description",
                        "label": "Description"

                    }
                ]
            }
        ],
        "presets" :[{
            "name" : "Reward Icon List"
        }]
    }
  {% endschema %} 