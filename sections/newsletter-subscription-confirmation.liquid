{% style %}
  #shopify-section-{{ section.id }} .newsletter-subscription-confirmation {
    display: flex;
    justify-content: center;
    padding: 72px 20px 76px;
    background: {{ section.settings.background_color }};
    text-align: center;
  }

  #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__content {
    width: min(100%, 680px);
  }

  #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin: 0 auto 24px;
    border: 2px solid {{ section.settings.accent_color }};
    border-radius: 50%;
    color: {{ section.settings.accent_color }};
  }

  #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__check {
    width: 16px;
    height: 9px;
    border-bottom: 2px solid currentColor;
    border-left: 2px solid currentColor;
    transform: translateY(-2px) rotate(-45deg);
  }

  #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__title {
    margin: 0 0 10px;
    color: {{ section.settings.text_color }};
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__message {
    margin: 0 auto;
    color: {{ section.settings.text_color }};
    font-size: 18px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__message p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__button {
    display: inline-block;
    margin-top: 30px;
    padding: 14px 28px;
    border-radius: 5px;
    background: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__button:hover,
  #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__button:focus-visible {
    background: {{ section.settings.button_hover_color }};
  }

  #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__note {
    margin: 40px 0 0;
    color: {{ section.settings.muted_text_color }};
    font-size: 13px;
    line-height: 1.45;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .newsletter-subscription-confirmation {
      padding: 56px 20px 60px;
    }

    #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__title {
      font-size: 30px;
    }

    #shopify-section-{{ section.id }} .newsletter-subscription-confirmation__message {
      font-size: 16px;
    }
  }
{% endstyle %}

<section class="newsletter-subscription-confirmation" aria-labelledby="newsletter-confirmation-title-{{ section.id }}">
  <div class="newsletter-subscription-confirmation__content">
    <div class="newsletter-subscription-confirmation__icon" aria-hidden="true">
      <span class="newsletter-subscription-confirmation__check"></span>
    </div>

    {% if section.settings.heading != blank %}
      <h1 id="newsletter-confirmation-title-{{ section.id }}" class="newsletter-subscription-confirmation__title">
        {{ section.settings.heading | escape }}
      </h1>
    {% endif %}

    {% if section.settings.message != blank %}
      <div class="newsletter-subscription-confirmation__message">
        {{ section.settings.message }}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a class="newsletter-subscription-confirmation__button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}

    {% if section.settings.note != blank %}
      <p class="newsletter-subscription-confirmation__note">{{ section.settings.note | escape }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Email confirmation",
  "class": "newsletter-subscription-confirmation-section",
  "templates": ["page"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You’re staying in the loop!"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>Thanks for letting us know. You’ll continue receiving Venustas news, new arrivals, and offers.<br><br>No purchase needed. We’re happy to have you here.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore What’s New"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "You can unsubscribe anytime using the link in our emails."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Note color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#bd3b0b"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#bd3b0b"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover color",
      "default": "#982e08"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Email confirmation"
    }
  ]
}
{% endschema %}
