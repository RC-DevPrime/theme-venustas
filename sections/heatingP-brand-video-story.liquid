{% style %}
  #shopify-section-{{ section.id }} .heatingP-brand-video-story {
    position: relative;
    height: 500svh;
    --ember: #ff4f27;
    --story-video-bottom: 80px;
    --story-video-height: 258px;
    --story-video-half-height: 129px;
    --story-staus-bottom: 358px;
    --story-video-hover-height: 300px;
    background: linear-gradient(180deg, #14161a 42.308%, #531602 100%);
    color: #fff;
    font-family: var(--font-primary, 'Montserrat', sans-serif);
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__stage {
    position: sticky;
    top: 0;
    display: flex;
    width: 100%;
    height: 100svh;
    min-height: 640px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__inner {
    position: relative;
    width: min(calc(100% - 40px), 1340px);
    height: 100%;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__heading {
    position: absolute;
    top: var(--story-heading-top, 50%);
    left: 50%;
    width: min(100%, 1020px);
    margin: 0;
    color: transparent;
    font-size: 86px;
    font-weight: 800;
    line-height: 1.35;
    text-align: center;
    opacity: var(--story-heading-opacity, 0);
    transform: translate(-50%, var(--story-heading-translate, -50%));
    will-change: opacity, transform;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__heading-layer,
  #shopify-section-{{ section.id }} .heatingP-brand-video-story__heading-line {
    display: block;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__heading-layer--base {
    color: #a0a1a6;
    opacity: var(--story-base-opacity, 1);
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__heading-layer--gradient {
    position: absolute;
    inset: 0;
    opacity: var(--story-gradient-opacity, 0);
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__heading-layer--gradient .heatingP-brand-video-story__heading-line {
    background: linear-gradient(100deg, var(--story-grad-start, var(--ember)) 0%, var(--story-grad-mid, #ff936c) 52%, var(--story-grad-end, #ffc4ad) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__stats {
    position: absolute;
    top: var(--story-stats-top, 68%);
    left: 0;
    display: grid;
    width: 100%;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    opacity: var(--story-stats-opacity, 0);
    transform: translateY(var(--story-stats-y, 80px));
    will-change: opacity, transform;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__stat {
    min-width: 0;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__value,
  #shopify-section-{{ section.id }} .heatingP-brand-video-story__label {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__value {
    font-size: 40px;
    font-weight: 800;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__label {
    margin-top: 4px;
    color: #d0d0d0;
    font-size: 13px;
    line-height: 1.68;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__videos {
    position: absolute;
    top: calc(50% + 100px + var(--story-video-half-height));
    left: 50%;
    display: grid;
    width: min(1340px, calc(100vw - 40px));
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: end;
    opacity: var(--story-videos-opacity, 0);
    transform: translate(-50%, calc(-100% + var(--story-videos-y, 0px)));
    will-change: opacity, transform;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__video-card {
    height: var(--story-video-height);
    overflow: hidden;
    background: rgba(255, 255, 255, .16);
    transition: height .28s ease;
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__video-card--center {
    height: var(--story-video-height);
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__video-card:hover {
    height: var(--story-video-hover-height);
  }

  #shopify-section-{{ section.id }} .heatingP-brand-video-story__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 1280px) and (max-width: 1600px) {
    #shopify-section-{{ section.id }} .heatingP-brand-video-story__heading {
      font-size: 60px;
    }
    #shopify-section-{{ section.id }} .heatingP-brand-video-story{
      --story-video-bottom: 40px;
      --story-staus-bottom: 258px;
      --story-video-height: 258px;
      --story-video-hover-height: 300px;
    }
  }

  @media screen and (min-width: 1281px) {
    #shopify-section-{{ section.id }} .heatingP-brand-video-story__stats {
      bottom: auto;
    }
  }

  @media only screen and (max-width: 1279px) {
    #shopify-section-{{ section.id }} .heatingP-brand-video-story {
      height: auto;
      --story-video-height: 178px;
      --story-video-half-height: 89px;
      --story-video-hover-height: 220px;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__stage {
      position: relative;
      display: block;
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__inner {
      display: flex;
      width: 100%;
      height: auto;
      flex-direction: column;
      gap: 32px;
      padding: 56px 0 72px 20px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__heading {
      position: static;
      width: calc(100% - 20px);
      color: #ff8b63;
      font-size: 32px;
      line-height: 1.2;
      opacity: 1;
      transform: none;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__heading-layer--base {
      color: inherit;
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__heading-layer--gradient {
      display: none;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__heading-line {
      display: inline;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__stats {
      position: static;
      display: grid;
      width: calc(100% - 20px);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 26px 16px;
      opacity: 1;
      transform: none;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__value {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__label {
      font-size: 12px;
      line-height: 1.35;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__videos {
      position: static;
      display: flex;
      width: 100%;
      gap: 6px;
      overflow-x: auto;
      opacity: 1;
      transform: none;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__videos::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__video-card,
    #shopify-section-{{ section.id }} .heatingP-brand-video-story__video-card--center {
      width: 83%;
      height: 240px;
      flex: 0 0 83%;
      scroll-snap-align: start;
      transition: none;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__video-card:hover {
      height: 240px;
      transform: none;
    }
  }

  @media only screen and (min-width: 768px) and (max-width: 1280px) {
    #shopify-section-{{ section.id }} .heatingP-brand-video-story__stats {
      top: auto;
      bottom: var(--story-staus-bottom);
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__videos {
      top: auto;
      bottom: 40px;
      transform: translate(-50%, var(--story-videos-y, 80px));
      display: flex;
      width: calc(100% - 40px);
      gap: 12px;
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__videos::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__video-card,
    #shopify-section-{{ section.id }} .heatingP-brand-video-story__video-card--center {
      width: calc(var(--story-video-height) * 16 / 9);
      height: var(--story-video-height);
      flex: 0 0 calc(var(--story-video-height) * 16 / 9);
      aspect-ratio: 16 / 9;
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__video {
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .heatingP-brand-video-story__video-card:hover {
      height: var(--story-video-height);
      transform: none;
    }
  }
{% endstyle %}

<section id="HeatingPBrandVideoStory-{{ section.id }}" class="heatingP-brand-video-story" data-heatingp-brand-video-story>
  <div class="heatingP-brand-video-story__stage">
    <div class="heatingP-brand-video-story__inner">
      {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
        <h2 class="heatingP-brand-video-story__heading" aria-label="{{ section.settings.heading | append: ' ' | append: section.settings.heading_accent | strip | escape }}">
          <span class="heatingP-brand-video-story__heading-layer heatingP-brand-video-story__heading-layer--base">
            {%- if section.settings.heading != blank -%}<span class="heatingP-brand-video-story__heading-line">{{ section.settings.heading }}</span>{%- endif -%}
            {%- if section.settings.heading_accent != blank -%}<span class="heatingP-brand-video-story__heading-line">{{ section.settings.heading_accent }}</span>{%- endif -%}
          </span>
          <span class="heatingP-brand-video-story__heading-layer heatingP-brand-video-story__heading-layer--gradient" aria-hidden="true">
            {%- if section.settings.heading != blank -%}<span class="heatingP-brand-video-story__heading-line">{{ section.settings.heading }}</span>{%- endif -%}
            {%- if section.settings.heading_accent != blank -%}<span class="heatingP-brand-video-story__heading-line">{{ section.settings.heading_accent }}</span>{%- endif -%}
          </span>
        </h2>
      {%- endif -%}

      <div class="heatingP-brand-video-story__stats" aria-label="Venustas achievements">
        {%- for index in (1..4) -%}
          {%- assign value_key = 'stat_' | append: index | append: '_value' -%}
          {%- assign label_key = 'stat_' | append: index | append: '_label' -%}
          <div class="heatingP-brand-video-story__stat">
            {%- if section.settings[value_key] != blank -%}<p class="heatingP-brand-video-story__value">{{ section.settings[value_key] }}</p>{%- endif -%}
            {%- if section.settings[label_key] != blank -%}<p class="heatingP-brand-video-story__label">{{ section.settings[label_key] }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="heatingP-brand-video-story__videos" aria-label="Brand videos">
        {%- for index in (1..3) -%}
          {%- assign video_key = 'video_' | append: index -%}
          {%- assign video = section.settings[video_key] -%}
          <div class="heatingP-brand-video-story__video-card{% if index == 2 %} heatingP-brand-video-story__video-card--center{% endif %}">
            {%- if video != blank -%}
              {{ video | video_tag: class: 'heatingP-brand-video-story__video', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('HeatingPBrandVideoStory-{{ section.id }}');
    if (!section || section.dataset.storyInitialized === 'true') return;
    section.dataset.storyInitialized = 'true';

    const media = window.matchMedia('(max-width: 767px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const heading = section.querySelector('.heatingP-brand-video-story__heading');
    const styleCache = Object.create(null);
    const metrics = {
      desktop: false,
      distance: 1,
      headingHeight: 0,
      headingTop: 80,
      pageTop: 0,
      viewportHeight: window.innerHeight
    };
    let frame = 0;
    let mobileCleared = false;
    let staticApplied = false;
    const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
    const range = (value, start, end) => clamp((value - start) / (end - start));
    const mix = (from, to, amount) => from + (to - from) * amount;
    const setStyle = (name, value) => {
      if (styleCache[name] === value) return;
      styleCache[name] = value;
      section.style.setProperty(name, value);
    };
    const mixColor = (from, to, amount) => {
      const channel = (index) => Math.round(mix(from[index], to[index], amount));
      return `rgb(${channel(0)}, ${channel(1)}, ${channel(2)})`;
    };
    const getHeadingTop = () => {
      const stickySelectors = [
        '.product-header-sticky',
        '.product-page-nav-header-section .main-nav-header-section',
        '.product-page-nav-header-section',
        '.shopify-section-header-sticky',
        '.sticky-header',
        '.header',
        'header',
        'nav'
      ].join(',');
      const fixedElements = Array.from(document.querySelectorAll(stickySelectors)).filter((element) => {
        if (section.contains(element)) return false;
        const style = window.getComputedStyle(element);
        if (style.position !== 'fixed' && style.position !== 'sticky') return false;

        const rect = element.getBoundingClientRect();
        return rect.top <= 1 && rect.bottom > 0 && rect.height > 20 && rect.height < 160;
      });

      const navBottom = fixedElements.reduce((bottom, element) => {
        const rect = element.getBoundingClientRect();
        return Math.max(bottom, rect.bottom);
      }, 0);

      return Math.max(80, navBottom + 80);
    };

    const refreshMetrics = () => {
      const rect = section.getBoundingClientRect();
      metrics.desktop = window.innerWidth > 1280;
      metrics.viewportHeight = window.innerHeight;
      metrics.distance = Math.max(section.offsetHeight - metrics.viewportHeight, 1);
      metrics.headingHeight = heading?.offsetHeight || 0;
      metrics.headingTop = metrics.desktop ? 80 : getHeadingTop();
      metrics.pageTop = rect.top + (window.pageYOffset || window.scrollY || 0);
    };

    const setStatic = () => {
      setStyle('--story-heading-opacity', '1');
      setStyle('--story-heading-top', `${metrics.desktop ? metrics.viewportHeight / 2 : metrics.headingTop}px`);
      setStyle('--story-heading-translate', metrics.desktop ? '-50%' : '0');
      setStyle('--story-base-opacity', '0');
      setStyle('--story-gradient-opacity', '1');
      setStyle('--story-stats-opacity', '1');
      setStyle('--story-stats-y', '0px');
      setStyle('--story-stats-top', `${metrics.viewportHeight / 2 + metrics.headingHeight / 2 + 48}px`);
      setStyle('--story-videos-opacity', '1');
      setStyle('--story-videos-y', '0px');
    };

    const clearMobile = () => {
      ['--story-heading-opacity', '--story-heading-top', '--story-heading-translate', '--story-base-opacity', '--story-gradient-opacity', '--story-stats-opacity', '--story-stats-y', '--story-stats-top', '--story-videos-opacity', '--story-videos-y', '--story-grad-start', '--story-grad-mid', '--story-grad-end'].forEach((name) => {
        delete styleCache[name];
        section.style.removeProperty(name);
      });
    };

    const render = () => {
      frame = 0;
      if (media.matches) {
        if (!mobileCleared) {
          clearMobile();
          mobileCleared = true;
        }
        return;
      }
      mobileCleared = false;
      if (reducedMotion.matches) {
        if (!staticApplied) {
          setStatic();
          staticApplied = true;
        }
        return;
      }
      staticApplied = false;

      const scrollPosition = window.pageYOffset || window.scrollY || 0;
      const progress = clamp((scrollPosition - metrics.pageTop) / metrics.distance);
      const intro = range(progress, 0.03, 0.16);
      const gradientEnter = range(progress, 0.22, 0.45);
      const gradientDepth = range(progress, 0.36, 0.62);
      const statsEnter = range(progress, 0.58, 0.72);
      const textExit = range(progress, 0.72, 0.84);
      const videosEnter = range(progress, metrics.desktop ? 0.8 : 0.74, metrics.desktop ? 0.94 : 0.9);
      const layoutEnter = range(progress, 0.16, 0.28);
      const centeredTop = metrics.viewportHeight / 2;
      const gradStart = mixColor([255, 163, 135], [255, 79, 39], gradientDepth);
      const gradMid = mixColor([255, 191, 170], [255, 132, 92], gradientDepth);
      const gradEnd = mixColor([255, 224, 214], [255, 193, 170], gradientDepth);

      setStyle('--story-heading-opacity', (intro * (metrics.desktop ? 1 - textExit : 1)).toFixed(3));
      setStyle('--story-heading-top', `${(metrics.desktop ? centeredTop : mix(centeredTop, metrics.headingTop, layoutEnter)).toFixed(2)}px`);
      setStyle('--story-heading-translate', `${metrics.desktop ? -50 : mix(-50, 0, layoutEnter).toFixed(2)}%`);
      setStyle('--story-base-opacity', (1 - gradientEnter).toFixed(3));
      setStyle('--story-gradient-opacity', gradientEnter.toFixed(3));
      setStyle('--story-grad-start', gradStart);
      setStyle('--story-grad-mid', gradMid);
      setStyle('--story-grad-end', gradEnd);
      setStyle('--story-stats-opacity', (statsEnter * (metrics.desktop ? 1 - textExit : 1)).toFixed(3));
      setStyle('--story-stats-y', `${mix(80, 0, statsEnter).toFixed(2)}px`);
      if (metrics.desktop) {
        setStyle('--story-stats-top', `${(centeredTop + metrics.headingHeight / 2 + 48).toFixed(2)}px`);
      } else {
        delete styleCache['--story-stats-top'];
        section.style.removeProperty('--story-stats-top');
      }
      setStyle('--story-videos-opacity', videosEnter.toFixed(3));
      setStyle('--story-videos-y', `${mix(90, 0, videosEnter).toFixed(2)}px`);
    };

    const requestRender = () => {
      if (!frame) frame = window.requestAnimationFrame(render);
    };

    const handleResize = () => {
      refreshMetrics();
      requestRender();
    };

    refreshMetrics();
    window.addEventListener('scroll', requestRender, { passive: true });
    window.addEventListener('resize', handleResize, { passive: true });
    window.visualViewport?.addEventListener('resize', handleResize, { passive: true });
    const resizeObserver = window.ResizeObserver ? new ResizeObserver(handleResize) : null;
    resizeObserver?.observe(section);
    media.addEventListener?.('change', requestRender);
    reducedMotion.addEventListener?.('change', requestRender);
    requestRender();
  })();
</script>

{% schema %}
{
  "name": "HeatingP Story Videos",
  "tag": "section",
  "class": "heatingP-brand-video-story-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Expert In" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Heated Apparel" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "2M+" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Happy Customers" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "3M+" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Products Sold" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value", "default": "8+" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "Years Innovation" },
    { "type": "text", "id": "stat_4_value", "label": "Stat 4 value", "default": "30+" },
    { "type": "text", "id": "stat_4_label", "label": "Stat 4 label", "default": "Countries" },
    { "type": "video", "id": "video_1", "label": "Video 1" },
    { "type": "video", "id": "video_2", "label": "Video 2" },
    { "type": "video", "id": "video_3", "label": "Video 3" }
  ],
  "presets": [
    { "name": "HeatingP Story Videos" }
  ]
}
{% endschema %}
