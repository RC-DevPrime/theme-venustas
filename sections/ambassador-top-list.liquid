{% style %}
    .ambassador-top-list-section{
        background-color:#F9F6EF;
    }
    .ambassador-top-list-section .section-heading{
        display:flex;
        align-items:center;
        justify-content:center;
        gap:10px;
    }
    .ambassador-top-list-section .heading-element{
        height:40px;
        width:fit-content;
        object-fit:contain;
    }
    .ambassador-top-list-section .ambassador-item .ambassador-profile-image{
        border-radius:50%;
        width:100%;
        height:100%;
        overflow:hidden;
        aspect-ratio: 1;
        position:relative;
        display:block;
    }
    .ambassador-top-list-section .ambassador-item .ambassador-profile-image img{
        width:100%;
        height:100%;
        object-fit:cover;
        opacity:0;
    }
    .ambassador-top-list-section .ambassador-item .ambassador-profile-image .img-path{
        opacity:1;
        position:absolute;
        top:0;
        left:0;
        width:100%;
        height:100%;
        object-fit:cover;
        transition: all 0.3s ease;
    }
    .ambassador-top-list-section .ambassador-item .ambassador-profile-image:hover .img-path{
        scale:1.1;
    }
    .ambassador-top-list-section .top-list-container .row{
        --bs-gutter-x: 50px;
    }
    .ambassador-top-list-section .ambassador-flag{
        height:25px;
        width:fit-content;
        object-fit:contain;
        margin-left:5px;
        margin-top:-5px;
    }
    .ambassador-top-list-section .ambassador-role{
        display:flex;
        align-items:center;
        justify-content:center;
        gap:5px;
        margin-top:10px;
    }
    .ambassador-top-list-section .ambassador-role img{
        height:12px;
        width:fit-content;
        object-fit:contain;
    }
    .top-list-slider-container .ambassador-item{
        display:flex;
        flex-direction:column;
        align-items: center;
    }
    .ambassador-top-list-section .swiper-slide-next .ambassador-item,
    .ambassador-top-list-section .swiper-slide-prev .ambassador-item {
        scale:0.8;
        transition: all 0.3s ease;
    }

    .ambassador-top-list-section .float-nav,
    .ambassador-top-list-section .float-nav button{
        position:unset;
        transform:unset;
    }
    .ambassador-top-list-section .swiper-pagination{
        width:fit-content;
        margin:0;
    }
    .ambassador-top-list-section .swiper-pagination .swiper-pagination-bullet{
        height:4px;
        width:8px;
        border-radius:4px;
    }
    .ambassador-top-list-section .swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active{
        width:30px;
        background: #B93205;
    }

