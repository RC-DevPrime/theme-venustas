    "name": "Product Form",
    "settings": [
      {
        "type": "url",
        "id": "payment_url",
        "label": "Payment URL"
      },
      {
        "type": "image_picker",
        "id": "payment_option_desktop",
        "label": "Payment Option (Desktop)"
