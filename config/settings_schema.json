  },
  {
    "name": "Calculator Free Shipping Message",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_calculator_free_shipping",
        "label": "Show Calculator Free Shipping Message?"
      },
      {
        "type": "number",
